# Ignore local build and distribution artifacts
build
dist

# Ignore editor files
.vscode
node_modules

# Git files
.git
.gitignore
.gitattributes

# Docker compose files (not needed in image)
docker-compose*.yml
.dockerignore

# Documentation (not needed in image)
docs/
CHANGELOG.md
INSTALL.md
LICENSE.md
UPGRADE.md
README.md
DEPLOYMENT.md
DOCKER-*.md
DOCKER-*.txt

# Tests (not needed in production)
tests/
phpunit.xml
.phpunit.result.cache

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Build tools
build.xml
phpstan.neon
.php_cs
.php_cs.cache

# Composer (we'll install inside container)
vendor/
composer.phar

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Scripts (not needed in image)
*.sh
Makefile

# Environment files
.env*

# System storage (will be mounted as volume)
storage/
upload/system/storage/

# Images are runtime data (bind-mounted from the host, see .gitignore:39/56),
# not image content — keeping them in the build context uploads gigabytes
# per build and bakes product photos into the image.
upload/image/catalog/
upload/image/cache/

# Exclude nginx cache directories from build context (they can be created at runtime)
docker/nginx/cache/
docker/nginx/cache/**

# Host-side nginx logs (bind-mounted at runtime, never part of the image)
docker/nginx/logs/
docker/nginx/logs/**

# Exclude Let's Encrypt runtime directories from build context
docker/letsencrypt/accounts/
docker/letsencrypt/archive/
docker/letsencrypt/live/
docker/letsencrypt/renewal/
docker/letsencrypt/renewal-hooks/
docker/letsencrypt/www/
docker/letsencrypt/*.log
docker/letsencrypt/*.lock

# Config files (generated by docker/entrypoint.sh at container start;
# they carry DB credentials, so they must never be baked into the image)
upload/config.php
upload/admin/config.php
upload/api/config.php
upload/store-api/config.php

# System files
.DS_Store
Thumbs.db
*.log

# Backups directory
backups/
