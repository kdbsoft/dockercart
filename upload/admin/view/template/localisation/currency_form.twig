{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="pull-right">
            <button type="submit" form="form-currency" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-currency">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="credit-card" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="alert alert-info"><i data-lucide="info" width="16" height="16"></i> {{ text_iso }}</div>
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-title">{{ entry_title }}</label>
                  <input type="text" name="title" value="{{ title }}" placeholder="{{ entry_title }}" id="input-title" class="form-control" />
                  {% if error_title %}
                  <div class="text-danger">{{ error_title }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-code">{{ entry_code }} <span data-toggle="tooltip" title="{{ help_code }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="text" name="code" value="{{ code }}" placeholder="{{ entry_code }}" id="input-code" class="form-control" />
                  {% if error_code %}
                  <div class="text-danger">{{ error_code }}</div>
                  {% endif %}
                </div>
                <div class="row">
                  <div class="col-sm-3">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-symbol-left">{{ entry_symbol_left }}</label>
                      <input type="text" name="symbol_left" value="{{ symbol_left }}" placeholder="{{ entry_symbol_left }}" id="input-symbol-left" class="form-control" />
                    </div>
                  </div>
                  <div class="col-sm-3">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-symbol-right">{{ entry_symbol_right }}</label>
                      <input type="text" name="symbol_right" value="{{ symbol_right }}" placeholder="{{ entry_symbol_right }}" id="input-symbol-right" class="form-control" />
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-sm-3">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-decimal-place">{{ entry_decimal_place }}</label>
                      <input type="text" name="decimal_place" value="{{ decimal_place }}" placeholder="{{ entry_decimal_place }}" id="input-decimal-place" class="form-control" />
                    </div>
                  </div>
                  <div class="col-sm-3">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-value">{{ entry_value }} <span data-toggle="tooltip" title="{{ help_value }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                      <input type="text" name="value" value="{{ value }}" placeholder="{{ entry_value }}" id="input-value" class="form-control" />
                    </div>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
{{ footer }}
