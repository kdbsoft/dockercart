{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-weight-class').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-weight-class">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'title' %}<a href="{{ sort_title }}" class="{{ order|lower }} sortable">{{ column_title }}</a>{% else %}<a href="{{ sort_title }}" class="sortable">{{ column_title }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'unit' %}<a href="{{ sort_unit }}" class="{{ order|lower }} sortable">{{ column_unit }}</a>{% else %}<a href="{{ sort_unit }}" class="sortable">{{ column_unit }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'value' %}<a href="{{ sort_value }}" class="{{ order|lower }} sortable">{{ column_value }}</a>{% else %}<a href="{{ sort_value }}" class="sortable">{{ column_value }}</a>{% endif %}</td>
              <td class="text-right"></td>
            </tr>
          </thead>
          <tbody>
            {% if weight_classes %}
            {% for weight_class in weight_classes %}
            <tr>
              <td class="text-center">{% if weight_class.weight_class_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ weight_class.weight_class_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ weight_class.weight_class_id }}" />
                {% endif %}</td>
              <td class="text-left">{{ weight_class.title }}</td>
              <td class="text-left">{{ weight_class.unit }}</td>
              <td class="text-right">{{ weight_class.value }}</td>
              <td class="text-right"><a href="{{ weight_class.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a></td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="5">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
