{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-length-class" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-length-class">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="ruler" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_title }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="length_class_description[{{ language.language_id }}][title]" value="{{ length_class_description[language.language_id] ? length_class_description[language.language_id].title }}" placeholder="{{ entry_title }}" class="form-control" />
                  </div>
                  {% if error_title[language.language_id] %}
                  <div class="text-danger">{{ error_title[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_unit }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="length_class_description[{{ language.language_id }}][unit]" value="{{ length_class_description[language.language_id] ? length_class_description[language.language_id].unit }}" placeholder="{{ entry_unit }}" class="form-control" />
                  </div>
                  {% if error_unit[language.language_id] %}
                  <div class="text-danger">{{ error_unit[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-value"><span data-toggle="tooltip" title="{{ help_value }}">{{ entry_value }}</span></label>
                  <input type="text" name="value" value="{{ value }}" placeholder="{{ entry_value }}" id="input-value" class="form-control" />
                  {% if error_value %}
                  <div class="text-danger">{{ error_value }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
{{ footer }}
