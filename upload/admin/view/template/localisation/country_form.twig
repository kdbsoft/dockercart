{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-country" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-country">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="globe" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_name }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="country_description[{{ language.language_id }}][name]" value="{{ country_description[language.language_id] ? country_description[language.language_id].name }}" placeholder="{{ entry_name }}" class="form-control" />
                  </div>
                  {% if error_name[language.language_id] %}
                  <div class="text-danger">{{ error_name[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="row">
                  <div class="col-sm-3">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-iso-code-2">{{ entry_iso_code_2 }}</label>
                      <input type="text" name="iso_code_2" value="{{ iso_code_2 }}" placeholder="{{ entry_iso_code_2 }}" id="input-iso-code-2" class="form-control" />
                    </div>
                  </div>
                  <div class="col-sm-3">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-iso-code-3">{{ entry_iso_code_3 }}</label>
                      <input type="text" name="iso_code_3" value="{{ iso_code_3 }}" placeholder="{{ entry_iso_code_3 }}" id="input-iso-code-3" class="form-control" />
                    </div>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label"><span data-toggle="tooltip" data-html="true" title="{{ help_address_format|escape('html') }}">{{ entry_address_format }}</span></label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <textarea name="country_description[{{ language.language_id }}][address_format]" rows="5" placeholder="{{ entry_address_format }}" class="form-control">{{ country_description[language.language_id] ? country_description[language.language_id].address_format }}</textarea>
                  </div>
                  {% endfor %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-phone-format"><span data-toggle="tooltip" data-html="true" title="{{ help_phone_format|escape('html') }}">{{ entry_phone_format }}</span></label>
                  <input type="text" name="phone_format" value="{{ phone_format }}" placeholder="{{ entry_phone_format }}" id="input-phone-format" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_postcode_required }}</label>
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="radio" name="postcode_required" value="1"{% if postcode_required %} checked{% endif %} />
                      {{ text_yes }}
                    </label>
                    <label class="dcx-checkbox-label">
                      <input type="radio" name="postcode_required" value="0"{% if not postcode_required %} checked{% endif %} />
                      {{ text_no }}
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
{{ footer }}
