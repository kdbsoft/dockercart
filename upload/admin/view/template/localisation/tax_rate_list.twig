{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn--icon"><i data-lucide="plus" width="16" height="16"></i></a>
            <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="confirm('{{ text_confirm }}') ? $('#form-tax-rate').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i></button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-tax-rate">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'tr.name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'tr.rate' %}<a href="{{ sort_rate }}" class="{{ order|lower }} sortable">{{ column_rate }}</a>{% else %}<a href="{{ sort_rate }}" class="sortable">{{ column_rate }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'tr.type' %}<a href="{{ sort_type }}" class="{{ order|lower }} sortable">{{ column_type }}</a>{% else %}<a href="{{ sort_type }}" class="sortable">{{ column_type }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'gz.name' %}<a href="{{ sort_geo_zone }}" class="{{ order|lower }} sortable">{{ column_geo_zone }}</a>{% else %}<a href="{{ sort_geo_zone }}" class="sortable">{{ column_geo_zone }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'tr.date_added' %}<a href="{{ sort_date_added }}" class="{{ order|lower }} sortable">{{ column_date_added }}</a>{% else %}<a href="{{ sort_date_added }}" class="sortable">{{ column_date_added }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'tr.date_modified' %}<a href="{{ sort_date_modified }}" class="{{ order|lower }} sortable">{{ column_date_modified }}</a>{% else %}<a href="{{ sort_date_modified }}" class="sortable">{{ column_date_modified }}</a>{% endif %}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
            {% if tax_rates %}
            {% for tax_rate in tax_rates %}
            <tr>
              <td class="text-center">{% if tax_rate.tax_rate_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ tax_rate.tax_rate_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ tax_rate.tax_rate_id }}" />
                {% endif %}</td>
              <td class="text-left">{{ tax_rate.name }}</td>
              <td class="text-right">{{ tax_rate.rate }}</td>
              <td class="text-left">{{ tax_rate.type }}</td>
              <td class="text-left">{{ tax_rate.geo_zone }}</td>
              <td class="text-left">{{ tax_rate.date_added }}</td>
              <td class="text-left">{{ tax_rate.date_modified }}</td>
              <td class="text-right"><a href="{{ tax_rate.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a></td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="8">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
