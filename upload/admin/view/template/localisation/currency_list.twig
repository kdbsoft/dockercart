{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ refresh }}" class="btn btn-warning"><i data-lucide="refresh-cw" width="16" height="16"></i> {{ button_currency }}</a>
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-currency').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-currency">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'title' %}<a href="{{ sort_title }}" class="{{ order|lower }} sortable">{{ column_title }}</a>{% else %}<a href="{{ sort_title }}" class="sortable">{{ column_title }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'code' %}<a href="{{ sort_code }}" class="{{ order|lower }} sortable">{{ column_code }}</a>{% else %}<a href="{{ sort_code }}" class="sortable">{{ column_code }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'value' %}<a href="{{ sort_value }}" class="{{ order|lower }} sortable">{{ column_value }}</a>{% else %}<a href="{{ sort_value }}" class="sortable">{{ column_value }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'date_modified' %}<a href="{{ sort_date_modified }}" class="{{ order|lower }} sortable">{{ column_date_modified }}</a>{% else %}<a href="{{ sort_date_modified }}" class="sortable">{{ column_date_modified }}</a>{% endif %}</td>
            </tr>
          </thead>
          <tbody>
            {% if currencies %}
            {% for currency in currencies %}
            <tr data-href="{{ currency.edit }}">
              <td class="text-center">{% if currency.currency_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ currency.currency_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ currency.currency_id }}" />
                {% endif %}</td>
              <td class="text-left"><a href="{{ currency.edit }}" class="row-title-link">{{ currency.title }}</a></td>
              <td class="text-left">{{ currency.code }}</td>
              <td class="text-right">{{ currency.value }}</td>
              <td class="text-left">{{ currency.date_modified }}</td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="5">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
