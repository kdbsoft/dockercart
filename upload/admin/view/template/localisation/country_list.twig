{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn--icon"><i data-lucide="plus" width="16" height="16"></i></a>
            <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="confirm('{{ text_confirm }}') ? $('#form-country').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i></button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div id="filter-country" class="filter-bar">
      <div class="panel panel-default">
        <div class="panel-body">
          <div class="filter-field">
            <label for="input-filter-name">{{ entry_name }}</label>
            <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-filter-name" class="form-control" />
          </div>
          <div class="filter-actions">
            <button type="button" id="button-filter" class="btn btn-default"><i data-lucide="funnel" width="14" height="14"></i> {{ button_filter }}</button>
          </div>
        </div>
      </div>
    </div>
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-country">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'iso_code_2' %}<a href="{{ sort_iso_code_2 }}" class="{{ order|lower }} sortable">{{ column_iso_code_2 }}</a>{% else %}<a href="{{ sort_iso_code_2 }}" class="sortable">{{ column_iso_code_2 }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'iso_code_3' %}<a href="{{ sort_iso_code_3 }}" class="{{ order|lower }} sortable">{{ column_iso_code_3 }}</a>{% else %}<a href="{{ sort_iso_code_3 }}" class="sortable">{{ column_iso_code_3 }}</a>{% endif %}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
            {% if countries %}
            {% for country in countries %}
            <tr>
              <td class="text-center">{% if country.country_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ country.country_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ country.country_id }}" />
                {% endif %}</td>
              <td class="text-left">{{ country.name }}</td>
              <td class="text-left">{{ country.iso_code_2 }}</td>
              <td class="text-left">{{ country.iso_code_3 }}</td>
              <td class="text-right"><a href="{{ country.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a></td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="5">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	location = 'index.php?route=localisation/country&user_token={{ user_token }}' + url;
});
//--></script>
<script type="text/javascript"><!--
$('#filter-country input, #filter-country select').on('keypress', function(e) {
	if (e.which == 13) { $('#button-filter').trigger('click'); }
});
//--></script>
{{ footer }}
