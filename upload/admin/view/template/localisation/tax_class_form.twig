{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-tax-class" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-tax-class">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="receipt" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_tax_class }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_title }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="tax_class_description[{{ language.language_id }}][title]" value="{{ tax_class_description[language.language_id] ? tax_class_description[language.language_id].title }}" placeholder="{{ entry_title }}" class="form-control" />
                  </div>
                  {% if error_title[language.language_id] %}
                  <div class="text-danger">{{ error_title[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_description }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="tax_class_description[{{ language.language_id }}][description]" value="{{ tax_class_description[language.language_id] ? tax_class_description[language.language_id].description }}" placeholder="{{ entry_description }}" class="form-control" />
                  </div>
                  {% if error_description[language.language_id] %}
                  <div class="text-danger">{{ error_description[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
              </div>
              <div class="dcx-field" style="margin-top:12px;">
                <label class="dcx-label">{{ text_tax_rate }}</label>
                <div id="tax-rule">
                  {% set tax_rule_row = 0 %}
                  {% for tax_rule in tax_rules %}
                  <div class="dc-promo-card" id="tax-rule-row{{ tax_rule_row }}">
                    <div class="dc-promo-card__actions">
                      <button type="button" onclick="$('#tax-rule-row{{ tax_rule_row }}').remove();" class="dc-promo-card__remove" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                    </div>
                    <div class="dc-promo-card__grid">
                      <div class="dc-promo-card__field">
                        <label>{{ entry_rate }}</label>
                        <select name="tax_rule[{{ tax_rule_row }}][tax_rate_id]" class="form-control">
                          {% for tax_rate in tax_rates %}
                          {% if tax_rate.tax_rate_id == tax_rule.tax_rate_id %}
                          <option value="{{ tax_rate.tax_rate_id }}" selected="selected">{{ tax_rate.name }}</option>
                          {% else %}
                          <option value="{{ tax_rate.tax_rate_id }}">{{ tax_rate.name }}</option>
                          {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                      <div class="dc-promo-card__field">
                        <label>{{ entry_based }}</label>
                        <select name="tax_rule[{{ tax_rule_row }}][based]" class="form-control">
                          {% if tax_rule.based == 'shipping' %}
                          <option value="shipping" selected="selected">{{ text_shipping }}</option>
                          {% else %}
                          <option value="shipping">{{ text_shipping }}</option>
                          {% endif %}
                          {% if tax_rule.based == 'payment' %}
                          <option value="payment" selected="selected">{{ text_payment }}</option>
                          {% else %}
                          <option value="payment">{{ text_payment }}</option>
                          {% endif %}
                          {% if tax_rule.based == 'store' %}
                          <option value="store" selected="selected">{{ text_store }}</option>
                          {% else %}
                          <option value="store">{{ text_store }}</option>
                          {% endif %}
                        </select>
                      </div>
                      <div class="dc-promo-card__field">
                        <label>{{ entry_priority }}</label>
                        <input type="text" name="tax_rule[{{ tax_rule_row }}][priority]" value="{{ tax_rule.priority }}" placeholder="{{ entry_priority }}" class="form-control" />
                      </div>
                    </div>
                  </div>
                  {% set tax_rule_row = tax_rule_row + 1 %}
                  {% endfor %}
                </div>
                <button type="button" onclick="addRule();" class="btn btn-primary btn-sm"><i data-lucide="circle-plus" width="14" height="14"></i> {{ button_rule_add }}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
  var tax_rule_row = {{ tax_rule_row }};

  function addRule() {
    html  = '<div class="dc-promo-card" id="tax-rule-row' + tax_rule_row + '">';
    html += '  <div class="dc-promo-card__actions">';
    html += '    <button type="button" onclick="$(\'#tax-rule-row' + tax_rule_row + '\').remove();" class="dc-promo-card__remove" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>';
    html += '  </div>';
    html += '  <div class="dc-promo-card__grid">';
    html += '    <div class="dc-promo-card__field">';
    html += '      <label>{{ entry_rate }}</label>';
    html += '      <select name="tax_rule[' + tax_rule_row + '][tax_rate_id]" class="form-control">';
    {% for tax_rate in tax_rates %}
    html += '        <option value="{{ tax_rate.tax_rate_id }}">{{ tax_rate.name|escape('js') }}</option>';
    {% endfor %}
    html += '      </select>';
    html += '    </div>';
    html += '    <div class="dc-promo-card__field">';
    html += '      <label>{{ entry_based }}</label>';
    html += '      <select name="tax_rule[' + tax_rule_row + '][based]" class="form-control">';
    html += '        <option value="shipping">{{ text_shipping }}</option>';
    html += '        <option value="payment">{{ text_payment }}</option>';
    html += '        <option value="store">{{ text_store }}</option>';
    html += '      </select>';
    html += '    </div>';
    html += '    <div class="dc-promo-card__field">';
    html += '      <label>{{ entry_priority }}</label>';
    html += '      <input type="text" name="tax_rule[' + tax_rule_row + '][priority]" value="" placeholder="{{ entry_priority }}" class="form-control" />';
    html += '    </div>';
    html += '  </div>';
    html += '</div>';

    $('#tax-rule').append(html);
    lucide.createIcons();

    tax_rule_row++;
  }
  //--></script>
</div>
{{ footer }}
