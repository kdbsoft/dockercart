{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-geo-zone" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-geo-zone">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="map" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_name }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="geo_zone_description[{{ language.language_id }}][name]" value="{{ geo_zone_description[language.language_id] ? geo_zone_description[language.language_id].name }}" placeholder="{{ entry_name }}" class="form-control" />
                  </div>
                  {% if error_name[language.language_id] %}
                  <div class="text-danger">{{ error_name[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_description }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="geo_zone_description[{{ language.language_id }}][description]" value="{{ geo_zone_description[language.language_id] ? geo_zone_description[language.language_id].description }}" placeholder="{{ entry_description }}" class="form-control" />
                  </div>
                  {% if error_description[language.language_id] %}
                  <div class="text-danger">{{ error_description[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
              </div>
                <div class="dcx-field" style="margin-top:12px;">
                <label class="dcx-label">{{ text_geo_zone }}</label>
                <div id="zone-to-geo-zone">
                  {% set zone_to_geo_zone_row = 0 %}
                  {% for zone_to_geo_zone in zone_to_geo_zones %}
                  <div class="dc-promo-card" id="zone-to-geo-zone-row{{ zone_to_geo_zone_row }}">
                    <div class="dc-promo-card__actions">
                      <button type="button" onclick="$('#zone-to-geo-zone-row{{ zone_to_geo_zone_row }}').remove();" class="dc-promo-card__remove" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                    </div>
                    <div class="dc-promo-card__grid">
                      <div class="dc-promo-card__field">
                        <label>{{ entry_country }}</label>
                        <select name="zone_to_geo_zone[{{ zone_to_geo_zone_row }}][country_id]" class="form-control" data-index="{{ zone_to_geo_zone_row }}" data-zone-id="{{ zone_to_geo_zone.zone_id }}">
                          {% for country in countries %}
                          {% if country.country_id == zone_to_geo_zone.country_id %}
                          <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
                          {% else %}
                          <option value="{{ country.country_id }}">{{ country.name }}</option>
                          {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                      <div class="dc-promo-card__field">
                        <label>{{ entry_zone }}</label>
                        <select name="zone_to_geo_zone[{{ zone_to_geo_zone_row }}][zone_id]" class="form-control">
                          <option value="0">{{ text_all_zones }}</option>
                          {% for zone_id,zone in zones[zone_to_geo_zone.country_id] %}
                          {% if zone_id == zone_to_geo_zone.zone_id %}
                          <option value="{{ zone_id }}" selected="selected">{{ zone }}</option>
                          {% else %}
                          <option value="{{ zone_id }}">{{ zone }}</option>
                          {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                  </div>
                  {% set zone_to_geo_zone_row = zone_to_geo_zone_row + 1 %}
                  {% endfor %}
                </div>
                <button type="button" id="button-geo-zone" class="btn btn-primary btn-sm"><i data-lucide="circle-plus" width="14" height="14"></i> {{ button_geo_zone_add }}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
  var zone_to_geo_zone_row = {{ zone_to_geo_zone_row }};

  $('#button-geo-zone').on('click', function() {
    html  = '<div class="dc-promo-card" id="zone-to-geo-zone-row' + zone_to_geo_zone_row + '">';
    html += '  <div class="dc-promo-card__actions">';
    html += '    <button type="button" onclick="$(\'#zone-to-geo-zone-row' + zone_to_geo_zone_row + '\').remove();" class="dc-promo-card__remove" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>';
    html += '  </div>';
    html += '  <div class="dc-promo-card__grid">';
    html += '    <div class="dc-promo-card__field">';
    html += '      <label>{{ entry_country }}</label>';
    html += '      <select name="zone_to_geo_zone[' + zone_to_geo_zone_row + '][country_id]" class="form-control" data-index="' + zone_to_geo_zone_row + '">';
    {% for country in countries %}
    html += '        <option value="{{ country.country_id }}">{{ country.name|escape('js') }}</option>';
    {% endfor %}
    html += '      </select>';
    html += '    </div>';
    html += '    <div class="dc-promo-card__field">';
    html += '      <label>{{ entry_zone }}</label>';
    html += '      <select name="zone_to_geo_zone[' + zone_to_geo_zone_row + '][zone_id]" class="form-control">';
    html += '        <option value="0">{{ text_all_zones }}</option>';
    html += '      </select>';
    html += '    </div>';
    html += '  </div>';
    html += '</div>';

    $('#zone-to-geo-zone').append(html);
    lucide.createIcons();

    zone_to_geo_zone_row++;
  });

  $('#zone-to-geo-zone').on('change', 'select[name$=\'[country_id]\']', function() {
    var element = this;

    if (element.value) {
      $.ajax({
        url: 'index.php?route=localisation/country/country&user_token={{ user_token }}&country_id=' + element.value,
        dataType: 'json',
        beforeSend: function() {
          $(element).prop('disabled', true);
          $('button[form=\'form-geo-zone\']').prop('disabled', true);
        },
        complete: function() {
          $(element).prop('disabled', false);
          $('button[form=\'form-geo-zone\']').prop('disabled', false);
        },
        success: function(json) {
          html = '<option value="0">{{ text_all_zones }}</option>';

          if (json['zone'] && json['zone'] != '') {
            for (i = 0; i < json['zone'].length; i++) {
              html += '<option value="' + json['zone'][i]['zone_id'] + '"';

              if (json['zone'][i]['zone_id'] == $(element).attr('data-zone-id')) {
                html += ' selected="selected"';
              }

              html += '>' + json['zone'][i]['name'] + '</option>';
            }
          }

          $('select[name=\'zone_to_geo_zone[' + $(element).attr('data-index') + '][zone_id]\']').html(html);

          $('select[name=\'zone_to_geo_zone[' + $(element).attr('data-index') + '][zone_id]\']').prop('disabled', false);

          $('select[name$=\'[country_id]\']:disabled:first').trigger('change');
        },
        error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      });
    }
  });
  //--></script>
</div>
{{ footer }}
