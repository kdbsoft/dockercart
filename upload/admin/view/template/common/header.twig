<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}
<meta name="description" content="{{ description }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}" />
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
<script type="text/javascript" src="view/javascript/jquery/jquery-3.7.1.min.js"></script>
<script type="text/javascript" src="view/javascript/bootstrap/js/bootstrap.min.js"></script>
<script src="view/javascript/lucide.min.js"></script>
<script src="view/javascript/chart.min.js"></script>
<link href="view/stylesheet/bootstrap.css" type="text/css" rel="stylesheet" />
<script src="view/javascript/jquery/datetimepicker/moment/moment.min.js" type="text/javascript"></script>
<script src="view/javascript/jquery/datetimepicker/moment/moment-with-locales.min.js" type="text/javascript"></script>
<script src="view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.js" type="text/javascript"></script>
<link href="view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.css" type="text/css" rel="stylesheet" media="screen" />
<link type="text/css" href="view/stylesheet/dockercart_tokens.css?v={{ dockercart_version }}" rel="stylesheet" media="screen" />
<link type="text/css" href="view/stylesheet/dockercart_column.css?v={{ dockercart_version }}" rel="stylesheet" media="screen" />
<link type="text/css" href="view/stylesheet/stylesheet.css?v={{ dockercart_version }}" rel="stylesheet" media="screen" />
<link type="text/css" href="view/stylesheet/dockercart_dcx_ui.css?v={{ dockercart_version }}" rel="stylesheet" media="screen" />
{% for style in styles %}
<link type="text/css" href="{{ style.href }}{% if style.href|slice(0,4) != 'http' and style.href|slice(0,2) != '//' %}?v={{ dockercart_version }}{% endif %}" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
<script src="view/javascript/common.js?v={{ dockercart_version }}" type="text/javascript"></script>
<script src="view/javascript/dcx-components.js?v={{ dockercart_version }}" type="text/javascript"></script>
<script src="view/javascript/dc-link-field.js?v={{ dockercart_version }}" type="text/javascript"></script>
<script src="view/javascript/tinymce/tinymce.min.js" type="text/javascript"></script>
{% for script in scripts %}
<script type="text/javascript" src="{{ script }}{% if script|slice(0,4) != 'http' and script|slice(0,2) != '//' %}?v={{ dockercart_version }}{% endif %}"></script>
{% endfor %}
</head>
<body data-user-token="{{ user_token }}" data-error-summary-one="{{ text_error_summary_one|e('html_attr') }}" data-error-summary-many="{{ text_error_summary_many|e('html_attr') }}">
<div id="container">
<header id="header" class="navbar navbar-static-top">
  <div class="container-fluid">
    <div id="header-logo" class="navbar-header"><a href="{{ home }}" class="navbar-brand"><img src="view/image/logo.png" alt="{{ heading_title }}" title="{{ heading_title }}" /></a></div>
    {% if logged %}<a href="#" id="button-menu" class="hidden-md hidden-lg"><i data-lucide="menu" width="20" height="20"></i></a>
    <ul class="nav navbar-nav navbar-right">
      <li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown"><i data-lucide="globe" width="14" height="14" style="vertical-align: middle;"></i> <b>{{ (current_language_code|split('-'))|first|upper }}</b> <i data-lucide="chevron-down" width="12" height="12"></i></a>
        <ul class="dropdown-menu dropdown-menu-right">
          {% for language in languages %}
          <li{% if language.code == current_language_code %} class="active"{% endif %}><a href="{{ language.href }}">{{ language.name }}</a></li>
          {% endfor %}
        </ul>
      </li>
      {% if show_update_bell %}
      <li id="update-notify">
        <a href="{{ update_url }}" class="update-button{% if update_available %} update-available{% endif %}" data-toggle="tooltip" title="{% if update_available %}{{ text_update_available }}: {{ update_remote_version }}{% else %}{{ text_system_update }}{% endif %}">
          <i data-lucide="download" width="16" height="16"></i>
          <span class="hidden-xs hidden-sm hidden-md">{{ text_system_update }}</span>
          {% if update_available %}
          <span class="label label-danger update-badge">{{ update_remote_version }}</span>
          {% endif %}
        </a>
      </li>
      {% endif %}
      <li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown"><img src="{{ image }}" alt="{{ firstname }} {{ lastname }}" title="{{ username }}" id="user-profile" class="img-circle" />{{ firstname }} {{ lastname }} <i data-lucide="chevron-down" width="12" height="12"></i></a>
        <ul class="dropdown-menu dropdown-menu-right">
          <li><a href="{{ profile }}"><i data-lucide="circle-user" width="16" height="16"></i> {{ text_profile }}</a></li>
          <li role="separator" class="divider"></li>
          <li class="dropdown-header">{{ text_store }}</li>
          {% for store in stores %}
          <li><a href="{{ store.href }}" target="_blank">{{ store.name }}</a></li>
          {% endfor %}
          <li role="separator" class="divider"></li>
          <li class="dropdown-header">{{ text_help }}</li>
          <li><a href="https://dockercart.net" target="_blank"><i data-lucide="package" width="16" height="16"></i> {{ text_homepage }}</a></li>
          <li><a href="https://dockercart.net/docs" target="_blank"><i data-lucide="file-text" width="16" height="16"></i> {{ text_documentation }}</a></li>
          <li><a href="https://dockercart.net" target="_blank"><i data-lucide="message-circle" width="16" height="16"></i> {{ text_support }}</a></li>
        </ul>
      </li>
      <li><a href="{{ logout }}"><i data-lucide="log-out" width="16" height="16"></i> <span class="hidden-xs hidden-sm hidden-md">{{ text_logout }}</span></a></li>
    </ul>
    <div class="admin-search-wrap">
      <div class="admin-search-box">
        <input type="text" class="admin-search-input" placeholder="{{ text_search_placeholder }}" autocomplete="off" data-suggest-url="{{ admin_search_suggest_url }}" data-search-url="{{ admin_search_url }}">
        <i data-lucide="search" class="admin-search-icon" width="16" height="16"></i>
      </div>
      <ul class="admin-search-dropdown"></ul>
    </div>
    {% endif %} </div>
</header>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
  if (window.lucide && typeof window.lucide.createIcons === 'function') {
    window.lucide.createIcons();
  }

  // Admin search autocomplete
  var searchInput = document.querySelector('.admin-search-input');
  var dropdown = document.querySelector('.admin-search-dropdown');
  var suggestTimer = null;
  var userToken = document.body.dataset.userToken;

  if (searchInput && dropdown && searchInput.dataset.suggestUrl) {
    searchInput.addEventListener('input', function() {
      clearTimeout(suggestTimer);
      var query = this.value.trim();

      if (query.length < 2) {
        dropdown.style.display = 'none';
        return;
      }

      suggestTimer = setTimeout(function() {
        var url = searchInput.dataset.suggestUrl + '&search=' + encodeURIComponent(query);

        fetch(url)
          .then(function(response) { return response.json(); })
          .then(function(data) {
            dropdown.innerHTML = '';

            if (data.length === 0) {
              dropdown.style.display = 'none';
              return;
            }

            var grouped = {};
            data.forEach(function(item) {
              if (!grouped[item.type]) {
                grouped[item.type] = [];
              }
              grouped[item.type].push(item);
            });

            for (var type in grouped) {
              var header = document.createElement('li');
              header.className = 'admin-search-group-header';
              header.textContent = grouped[type][0].type_label;
              dropdown.appendChild(header);

              grouped[type].forEach(function(item) {
                var li = document.createElement('li');
                var a = document.createElement('a');
                a.href = item.href;

                var content = '<div class="admin-search-item">';
                if (item.image) {
                  content += '<img src="' + item.image + '" alt="" class="admin-search-item-image">';
                } else {
                  content += '<div class="admin-search-item-icon"><i data-lucide="' + getLucideIcon(item.type) + '"></i></div>';
                }
                content += '<div class="admin-search-item-info">';
                content += '<div class="admin-search-item-name">' + escapeHtml(item.name) + '</div>';
                if (item.subtitle) {
                  content += '<div class="admin-search-item-subtitle">' + escapeHtml(item.subtitle) + '</div>';
                }
                content += '</div>';
                content += '</div>';

                a.innerHTML = content;
                li.appendChild(a);
                dropdown.appendChild(li);
              });
            }

            var divider = document.createElement('li');
            divider.className = 'admin-search-divider';
            dropdown.appendChild(divider);

            var viewAll = document.createElement('li');
            var viewAllLink = document.createElement('a');
            viewAllLink.href = 'index.php?route=common/admin_search&user_token=' + userToken + '&search=' + encodeURIComponent(query);
            viewAllLink.className = 'admin-search-view-all';
            viewAllLink.innerHTML = '<i data-lucide="search" width="18" height="18"></i> {{ text_view_all_results|default('View all results') }}';
            viewAll.appendChild(viewAllLink);
            dropdown.appendChild(viewAll);

            dropdown.style.display = 'block';

            if (window.lucide && typeof window.lucide.createIcons === 'function') {
              window.lucide.createIcons({ nodes: [dropdown] });
            }
          })
          .catch(function(error) {
            console.error('Search error:', error);
            dropdown.style.display = 'none';
          });
      }, 300);
    });

    searchInput.addEventListener('blur', function() {
      setTimeout(function() {
        dropdown.style.display = 'none';
      }, 200);
    });

    searchInput.addEventListener('focus', function() {
      if (this.value.trim().length >= 2 && dropdown.innerHTML) {
        dropdown.style.display = 'block';
      }
    });

    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        dropdown.style.display = 'none';
      } else if (e.key === 'Enter') {
        e.preventDefault();
        var query = this.value.trim();
        if (query) {
          window.location.href = 'index.php?route=common/admin_search&user_token=' + userToken + '&search=' + encodeURIComponent(query);
        }
      }
    });
  }

  function getLucideIcon(type) {
    var icons = {
      'product': 'tag',
      'category': 'folder',
      'manufacturer': 'factory',
      'information': 'file-text',
      'order': 'shopping-cart',
      'customer': 'user'
    };
    return icons[type] || 'circle';
  }

  function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var sidebar = document.getElementById('column-left');
  var toggle = document.getElementById('sidebar-toggle');
  if (!sidebar || !toggle) return;

  var collapsed = localStorage.getItem('dc-sidebar-collapsed') === '1';
  if (collapsed) sidebar.classList.add('collapsed');

  toggle.addEventListener('click', function() {
    sidebar.classList.toggle('collapsed');
    localStorage.setItem('dc-sidebar-collapsed', sidebar.classList.contains('collapsed') ? '1' : '0');
    closeFlyout();
  });

  /* ── Flyout menu for collapsed sidebar ── */
  var flyout = null;

  function closeFlyout() {
    if (flyout) {
      flyout.classList.remove('active');
      flyout = null;
    }
    document.removeEventListener('click', onDocClick);
  }

  function onDocClick(e) {
    if (flyout && !flyout.contains(e.target) && !e.target.closest('#column-left')) {
      closeFlyout();
    }
  }

  sidebar.addEventListener('click', function(e) {
    if (!sidebar.classList.contains('collapsed')) return;

    var link = e.target.closest('#menu > li > a');
    if (!link) return;

    var li = link.closest('li');
    var subMenu = li.querySelector('ul');
    if (!subMenu) return;

    e.preventDefault();
    e.stopPropagation();

    closeFlyout();

    flyout = document.createElement('div');
    flyout.className = 'dc-flyout active';

    var header = document.createElement('div');
    header.className = 'dc-flyout__header';
    var icon = link.querySelector('svg[data-lucide], i[data-lucide]');
    if (icon) header.appendChild(icon.cloneNode(true));
    var titleText = link.getAttribute('title') || link.textContent.trim();
    var span = document.createElement('span');
    span.textContent = titleText;
    header.appendChild(span);
    flyout.appendChild(header);

    var items = document.createElement('div');
    items.className = 'dc-flyout__items';

    var subLinks = subMenu.querySelectorAll(':scope > li');
    for (var i = 0; i < subLinks.length; i++) {
      var subLi = subLinks[i];
      var subA = subLi.querySelector(':scope > a');
      if (!subA) continue;

      var hasChildren = subLi.querySelector(':scope > ul');
      var item = document.createElement('a');
      item.className = 'dc-flyout__item';
      if (subLi.classList.contains('active')) item.className += ' active';

      if (hasChildren) {
        item.href = '#';
        item.className += ' dc-flyout__item--expandable';

        var subList = document.createElement('div');
        subList.className = 'dc-flyout__sub';
        var deepLinks = hasChildren.querySelectorAll(':scope > li > a');
        for (var j = 0; j < deepLinks.length; j++) {
          var deepItem = document.createElement('a');
          deepItem.className = 'dc-flyout__item dc-flyout__item--sub';
          deepItem.href = deepLinks[j].getAttribute('href') || '#';
          if (deepLinks[j].parentElement.classList.contains('active')) {
            deepItem.className += ' active';
          }
          deepItem.textContent = deepLinks[j].textContent.trim();
          subList.appendChild(deepItem);
        }

        var itemIcon = subA.querySelector('svg[data-lucide], i[data-lucide]');
        if (itemIcon) {
          item.appendChild(itemIcon.cloneNode(true));
        }
        var label = document.createElement('span');
        label.textContent = subA.textContent.trim().replace(/\s*$/, '');
        item.appendChild(label);
        var arrow = document.createElement('i');
        arrow.setAttribute('data-lucide', 'chevron-right');
        arrow.className = 'dc-flyout__arrow';
        item.appendChild(arrow);
        items.appendChild(item);
        items.appendChild(subList);

        item.addEventListener('click', (function(el, sub) {
          return function(ev) {
            ev.preventDefault();
            ev.stopPropagation();
            el.classList.toggle('dc-flyout__item--open');
            sub.classList.toggle('dc-flyout__sub--open');
          };
        })(item, subList));
      } else {
        item.href = subA.getAttribute('href') || '#';
        var itemIcon2 = subA.querySelector('svg[data-lucide], i[data-lucide]');
        if (itemIcon2) {
          item.appendChild(itemIcon2.cloneNode(true));
        }
        var label2 = document.createElement('span');
        label2.textContent = subA.textContent.trim();
        item.appendChild(label2);
        items.appendChild(item);
      }
    }
    flyout.appendChild(items);

    document.body.appendChild(flyout);
    if (window.lucide) lucide.createIcons({ nodes: [flyout] });

    setTimeout(function() {
      document.addEventListener('click', onDocClick);
    }, 0);
  });
});
</script>
