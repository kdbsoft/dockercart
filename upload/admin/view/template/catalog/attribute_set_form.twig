{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-attribute-set" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if entity_name %}
                {{ entity_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-attribute-set">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="layers-3" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_panel_attribute_set_title }}</div>
                  <div class="dcx-panel-subtitle">{{ text_panel_attribute_set_subtitle }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field required">
                    <label class="dcx-label">{{ entry_name }}</label>
                    {% for language in languages %}
                    <div class="dc-attr-row__value">
                      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>
                      <input type="text" name="attribute_set_description[{{ language.language_id }}][name]" value="{{ (attribute_set_description[language.language_id] ? attribute_set_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" class="form-control" />
                    </div>
                    {% if error_name[language.language_id] %}
                    <div class="text-danger">{{ error_name[language.language_id] }}</div>
                    {% endif %}
                    {% endfor %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                    <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="status" id="input-status" class="form-control">
                      {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="dcx-panel" style="margin-top: 16px;">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="hash" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_panel_attributes_title }} <span data-toggle="tooltip" title="{{ text_help_attributes }}"><i data-lucide="circle-question-mark" width="16" height="16" class="text-muted"></i></span></div>
                  <div class="dcx-panel-subtitle">{{ text_panel_attributes_subtitle }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div id="set-attributes-container">
                  {% set attribute_row = 0 %}
                  {% for set_attribute in attribute_set_attributes %}
                  <div class="dc-attr-row" id="set-attribute-row{{ attribute_row }}">
                    <div class="dc-attr-row__name" style="flex:1 1 auto;">
                      <input type="text" name="attribute_set_attribute[{{ attribute_row }}][name]" value="{{ set_attribute.name|e('html_attr') }}" placeholder="{{ entry_attribute }}" class="form-control" style="width:100%;"/>
                      <input type="hidden" name="attribute_set_attribute[{{ attribute_row }}][attribute_id]" value="{{ set_attribute.attribute_id }}"/>
                      <div class="dc-set-attr-group text-muted" style="margin-top:3px;font-size:11px;min-height:13px;">{{ set_attribute.attribute_group }}</div>
                    </div>
                    <button type="button" onclick="$('#set-attribute-row{{ attribute_row }}').remove();" class="btn btn-link btn-remove-attr" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                  </div>
                  {% set attribute_row = attribute_row + 1 %}
                  {% endfor %}
                </div>
                <button type="button" onclick="addSetAttribute();" class="btn btn-primary btn-sm" style="margin-top:8px;">
                  <i data-lucide="circle-plus" width="14" height="14"></i> {{ button_attribute_add }}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script type="text/javascript"><!--
  var attribute_row = {{ attribute_row }};

  function addSetAttribute() {
	  var html = '<div class="dc-attr-row" id="set-attribute-row' + attribute_row + '">';
	  html += '  <div class="dc-attr-row__name" style="flex:1 1 auto;">';
	  html += '      <input type="text" name="attribute_set_attribute[' + attribute_row + '][name]" value="" placeholder="{{ entry_attribute }}" class="form-control" style="width:100%;"/>';
	  html += '      <input type="hidden" name="attribute_set_attribute[' + attribute_row + '][attribute_id]" value=""/>';
	  html += '      <div class="dc-set-attr-group text-muted" style="margin-top:3px;font-size:11px;min-height:13px;"></div>';
	  html += '  </div>';
	  html += '  <button type="button" onclick="$(\'#set-attribute-row' + attribute_row + '\').remove();" class="btn btn-link btn-remove-attr" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>';
	  html += '</div>';

	  $('#set-attributes-container').append(html);
	  lucide.createIcons();

	  setAttributeAutocomplete(attribute_row);

	  attribute_row++;
  }

  function setAttributeAutocomplete(attribute_row) {
	  $('input[name=\'attribute_set_attribute[' + attribute_row + '][name]\']').autocomplete({
		  'source': function(request, response) {
			  $.ajax({
				  url: 'index.php?route=catalog/attribute_set/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
				  dataType: 'json',
				  success: function(json) {
					  response($.map(json, function(item) {
						  return {
							  category: item.attribute_group,
							  label: item.name,
							  value: item.attribute_id
						  }
					  }));
				  }
			  });
		  },
		  'select': function(item) {
			  var $row = $('input[name=\'attribute_set_attribute[' + attribute_row + '][name]\']').closest('.dc-attr-row');
			  $('input[name=\'attribute_set_attribute[' + attribute_row + '][name]\']').val(item['label']);
			  $('input[name=\'attribute_set_attribute[' + attribute_row + '][attribute_id]\']').val(item['value']);
			  $row.find('.dc-set-attr-group').text(item['category'] || '');
		  }
	  });
  }

  $('#set-attributes-container .dc-attr-row').each(function(index, element) {
	  setAttributeAutocomplete(index);
  });
//--></script>

{{ footer }}
