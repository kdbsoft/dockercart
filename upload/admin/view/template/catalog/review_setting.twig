{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <button type="submit" form="form-review-setting" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-review-setting">
      <div class="row">
        <div class="col-md-12">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ heading_title }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field">
                    <label class="dcx-label">
                      <input type="hidden" name="config_review_images_enabled" value="0" />
                      <input type="checkbox" name="config_review_images_enabled" value="1" {% if config_review_images_enabled %}checked="checked"{% endif %} /> {{ entry_images_enabled }}
                    </label>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-max-images">{{ entry_max_images }}</label>
                    <input type="number" name="config_review_max_images" value="{{ config_review_max_images }}" min="1" max="10" id="input-max-images" class="form-control" style="max-width: 120px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label">
                      <input type="hidden" name="config_review_video_enabled" value="0" />
                      <input type="checkbox" name="config_review_video_enabled" value="1" {% if config_review_video_enabled %}checked="checked"{% endif %} /> {{ entry_video_enabled }}
                    </label>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label">
                      <input type="hidden" name="config_review_auto_approve" value="0" />
                      <input type="checkbox" name="config_review_auto_approve" value="1" {% if config_review_auto_approve %}checked="checked"{% endif %} /> {{ entry_auto_approve }}
                    </label>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label">
                      <input type="hidden" name="config_review_verify_purchase" value="0" />
                      <input type="checkbox" name="config_review_verify_purchase" value="1" {% if config_review_verify_purchase %}checked="checked"{% endif %} /> {{ entry_verify_purchase }}
                    </label>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label">
                      <input type="hidden" name="config_review_show_distribution" value="0" />
                      <input type="checkbox" name="config_review_show_distribution" value="1" {% if config_review_show_distribution %}checked="checked"{% endif %} /> {{ entry_show_distribution }}
                    </label>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label">
                      <input type="hidden" name="config_review_honeypot" value="0" />
                      <input type="checkbox" name="config_review_honeypot" value="1" {% if config_review_honeypot %}checked="checked"{% endif %} /> {{ entry_honeypot }}
                    </label>
                  </div>
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-per-page">{{ entry_per_page }}</label>
                    <input type="number" name="config_review_per_page" value="{{ config_review_per_page }}" min="1" max="100" id="input-per-page" class="form-control" style="max-width: 120px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-image-max-size">{{ entry_image_max_size }}</label>
                    <input type="number" name="config_review_image_max_size" value="{{ config_review_image_max_size }}" min="1024" id="input-image-max-size" class="form-control" style="max-width: 180px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-video-max-size">{{ entry_video_max_size }}</label>
                    <input type="number" name="config_review_video_max_size" value="{{ config_review_video_max_size }}" min="1024" id="input-video-max-size" class="form-control" style="max-width: 180px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-image-dimension">{{ entry_image_dimension }}</label>
                    <input type="number" name="config_review_image_dimension" value="{{ config_review_image_dimension }}" min="0" id="input-image-dimension" class="form-control" style="max-width: 120px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-rate-limit-count">{{ entry_rate_limit_count }}</label>
                    <input type="number" name="config_review_rate_limit_count" value="{{ config_review_rate_limit_count }}" min="0" id="input-rate-limit-count" class="form-control" style="max-width: 120px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-rate-limit-minutes">{{ entry_rate_limit_minutes }}</label>
                    <input type="number" name="config_review_rate_limit_minutes" value="{{ config_review_rate_limit_minutes }}" min="1" id="input-rate-limit-minutes" class="form-control" style="max-width: 120px;" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>

    <div class="dcx-shell" style="margin-top: 16px;">
      <div class="dcx-panel">
        <div class="dcx-panel-head">
          <div class="dcx-panel-head__icon"><i data-lucide="list-checks" width="18" height="18"></i></div>
          <div class="dcx-panel-head__actions">
            <a href="{{ add_group }}" class="btn btn-primary"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_group }}</a>
          </div>
          <div>
            <div class="dcx-panel-title">{{ heading_groups }}</div>
          </div>
        </div>
        <div class="dcx-panel-body">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_group }}</td>
                <td class="text-center">{{ column_default }}</td>
                <td class="text-center">{{ column_criteria }}</td>
                <td class="text-right"></td>
              </tr>
            </thead>
            <tbody>
            {% if groups %}
            {% for group in groups %}
              <tr>
                <td class="text-left">
                  {{ group.name }}
                  {% if group.is_default %}<span class="label label-success">{{ text_default }}</span>{% endif %}
                </td>
                <td class="text-center">
                  {% if not group.is_default %}
                  <button type="button" class="btn btn-default btn--icon btn-set-default" data-group-id="{{ group.criteria_group_id }}" title="{{ button_set_default }}"><i data-lucide="star" width="14" height="14"></i></button>
                  {% else %}
                  <i data-lucide="star" width="14" height="14" class="text-success"></i>
                  {% endif %}
                </td>
                <td class="text-center">{{ group.criteria_count }}</td>
                <td class="text-right">
                  <a href="{{ group.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a>
                  {% if not group.is_default %}
                  <button type="button" class="btn btn-danger btn--icon btn-delete-group" data-group-id="{{ group.criteria_group_id }}" title="{{ button_delete }}"><i data-lucide="trash-2" width="14" height="14"></i></button>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
            {% else %}
              <tr><td class="text-center" colspan="4">{{ text_no_results }}</td></tr>
            {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$(document).on('click', '.btn-set-default', function() {
	var groupId = $(this).data('group-id');
	$.ajax({
		url: 'index.php?route=catalog/review_setting/groupDefault&user_token={{ user_token }}&criteria_group_id=' + groupId,
		dataType: 'json',
		success: function(json) {
			if (json['success']) { location.reload(); }
			if (json['error']) { alert(json['error']); }
		}
	});
});

$(document).on('click', '.btn-delete-group', function() {
	var groupId = $(this).data('group-id');
	if (!confirm('{{ text_confirm_group }}')) return;
	$.ajax({
		url: 'index.php?route=catalog/review_setting/groupDelete&user_token={{ user_token }}&criteria_group_id=' + groupId,
		dataType: 'json',
		success: function(json) {
			if (json['success']) { location.reload(); }
			if (json['error']) { alert(json['error']); }
		}
	});
});
//--></script>
{{ footer }}
