{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-review-setting" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ heading_title }}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-review-setting">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="image" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_panel_media }}</div>
                <div class="dcx-panel-subtitle">{{ text_settings_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-checkbox-group">
                  <label class="dcx-checkbox-label">
                    <input type="hidden" name="config_review_images_enabled" value="0" />
                    <input type="checkbox" name="config_review_images_enabled" value="1" {% if config_review_images_enabled %}checked="checked"{% endif %} /> {{ entry_images_enabled }}
                  </label>
                  <label class="dcx-checkbox-label">
                    <input type="hidden" name="config_review_video_enabled" value="0" />
                    <input type="checkbox" name="config_review_video_enabled" value="1" {% if config_review_video_enabled %}checked="checked"{% endif %} /> {{ entry_video_enabled }}
                  </label>
                </div>
              </div>
              <div class="dcx-fields dcx-fields--row">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-max-images">{{ entry_max_images }}</label>
                  <input type="number" name="config_review_max_images" value="{{ config_review_max_images }}" min="1" max="10" id="input-max-images" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-image-max-size">{{ entry_image_max_size }}</label>
                  <input type="number" name="config_review_image_max_size" value="{{ config_review_image_max_size }}" min="1024" id="input-image-max-size" class="form-control" />
                </div>
              </div>
              <div class="dcx-fields dcx-fields--row">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-image-dimension">{{ entry_image_dimension }}</label>
                  <input type="number" name="config_review_image_dimension" value="{{ config_review_image_dimension }}" min="0" id="input-image-dimension" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-video-max-size">{{ entry_video_max_size }}</label>
                  <input type="number" name="config_review_video_max_size" value="{{ config_review_video_max_size }}" min="1024" id="input-video-max-size" class="form-control" />
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="shield-check" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_panel_moderation }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-checkbox-group">
                  <label class="dcx-checkbox-label">
                    <input type="hidden" name="config_review_auto_approve" value="0" />
                    <input type="checkbox" name="config_review_auto_approve" value="1" {% if config_review_auto_approve %}checked="checked"{% endif %} /> {{ entry_auto_approve }}
                  </label>
                  <label class="dcx-checkbox-label">
                    <input type="hidden" name="config_review_verify_purchase" value="0" />
                    <input type="checkbox" name="config_review_verify_purchase" value="1" {% if config_review_verify_purchase %}checked="checked"{% endif %} /> {{ entry_verify_purchase }}
                  </label>
                  <label class="dcx-checkbox-label">
                    <input type="hidden" name="config_review_honeypot" value="0" />
                    <input type="checkbox" name="config_review_honeypot" value="1" {% if config_review_honeypot %}checked="checked"{% endif %} /> {{ entry_honeypot }}
                  </label>
                </div>
              </div>
              <div class="dcx-fields dcx-fields--row">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-rate-limit-count">{{ entry_rate_limit_count }}</label>
                  <input type="number" name="config_review_rate_limit_count" value="{{ config_review_rate_limit_count }}" min="0" id="input-rate-limit-count" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-rate-limit-minutes">{{ entry_rate_limit_minutes }}</label>
                  <input type="number" name="config_review_rate_limit_minutes" value="{{ config_review_rate_limit_minutes }}" min="1" id="input-rate-limit-minutes" class="form-control" />
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="layout-grid" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_panel_display }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-checkbox-group">
                  <label class="dcx-checkbox-label">
                    <input type="hidden" name="config_review_show_distribution" value="0" />
                    <input type="checkbox" name="config_review_show_distribution" value="1" {% if config_review_show_distribution %}checked="checked"{% endif %} /> {{ entry_show_distribution }}
                  </label>
                </div>
              </div>
              <div class="dcx-fields dcx-fields--row">
                <div class="dcx-field dcx-field--half">
                  <label class="dcx-label" for="input-per-page">{{ entry_per_page }}</label>
                  <input type="number" name="config_review_per_page" value="{{ config_review_per_page }}" min="1" max="100" id="input-per-page" class="form-control" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="list-checks" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ heading_groups }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <p class="text-muted" style="font-size: 12px; line-height: 1.5; margin-bottom: 12px;">{{ text_groups_subtitle }}</p>
            <a href="{{ add_group }}" class="btn btn-primary btn-block"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_group }}</a>
            <div class="dcx-group-list">
              {% if groups %}
              {% for group in groups %}
              <div class="dcx-group-card{% if group.is_default %} is-default{% endif %}">
                <div class="dcx-group-card__head">
                  <div class="dcx-group-card__title">
                    <span class="dcx-group-card__name">{{ group.name }}</span>
                    {% if group.is_default %}<span class="dcx-group-card__badge">{{ text_default }}</span>{% endif %}
                  </div>
                  {% if not group.is_default %}
                  <button type="button" class="btn btn-default btn--icon btn-set-default" data-group-id="{{ group.criteria_group_id }}" data-toggle="tooltip" title="{{ button_set_default }}"><i data-lucide="star" width="14" height="14"></i></button>
                  {% else %}
                  <span class="dcx-group-card__star" data-toggle="tooltip" title="{{ text_default }}"><i data-lucide="star" width="14" height="14"></i></span>
                  {% endif %}
                </div>
                <div class="dcx-group-card__foot">
                  <span class="dcx-group-card__count" data-toggle="tooltip" title="{{ column_criteria }}"><i data-lucide="list-checks" width="13" height="13"></i> {{ group.criteria_count }}</span>
                  <div class="dcx-sidebar-card__actions">
                    <a href="{{ group.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a>
                    {% if not group.is_default %}
                    <button type="button" class="btn btn-danger btn--icon btn-delete-group" data-group-id="{{ group.criteria_group_id }}" data-toggle="tooltip" title="{{ button_delete }}"><i data-lucide="trash-2" width="14" height="14"></i></button>
                    {% endif %}
                  </div>
                </div>
              </div>
              {% endfor %}
              {% else %}
              <div class="dcx-group-empty">{{ text_no_results }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$(document).on('click', '.btn-set-default', function() {
	var groupId = $(this).data('group-id');
	$.ajax({
		url: 'index.php?route=catalog/review_setting/groupDefault&user_token={{ user_token }}&criteria_group_id=' + groupId,
		dataType: 'json',
		success: function(json) {
			if (json['success']) { location.reload(); }
			if (json['error']) { alert(json['error']); }
		}
	});
});

$(document).on('click', '.btn-delete-group', function() {
	var groupId = $(this).data('group-id');
	if (!confirm('{{ text_confirm_group }}')) return;
	$.ajax({
		url: 'index.php?route=catalog/review_setting/groupDelete&user_token={{ user_token }}&criteria_group_id=' + groupId,
		dataType: 'json',
		success: function(json) {
			if (json['success']) { location.reload(); }
			if (json['error']) { alert(json['error']); }
		}
	});
});
//--></script>
{{ footer }}
