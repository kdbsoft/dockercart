{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-3 col-lg-6 col-xl-offset-3 col-xl-6">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if entity_name %}
                {{ entity_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_option }}
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-option" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-3 col-lg-6 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-option">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-3 col-lg-6 col-xl-offset-3 col-xl-6">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="package" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_form }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field required">
                    <label class="dcx-label">{{ entry_name }}</label>
                    {% for language in languages %}
                    <div class="dc-attr-row__value">
                      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                      <input type="text" name="option_description[{{ language.language_id }}][name]" value="{{ (option_description[language.language_id] ? option_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" class="form-control" />
                    </div>
                    {% if error_name[language.language_id] %}
                    <div class="text-danger">{{ error_name[language.language_id] }}</div>
                    {% endif %}
                    {% endfor %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-type">{{ entry_type }}</label>
                    <select name="type" id="input-type" class="form-control">
                      <optgroup label="{{ text_choose }}">
                    {% if type == 'select' %}
                      <option value="select" selected="selected">{{ text_select }}</option>
                    {% else %}
                      <option value="select">{{ text_select }}</option>
                    {% endif %}
                    {% if type == 'radio' %}
                      <option value="radio" selected="selected">{{ text_radio }}</option>
                    {% else %}
                      <option value="radio">{{ text_radio }}</option>
                    {% endif %}
                    {% if type == 'checkbox' %}
                      <option value="checkbox" selected="selected">{{ text_checkbox }}</option>
                    {% else %}
                      <option value="checkbox">{{ text_checkbox }}</option>
                    {% endif %}
                    {% if type == 'color' %}
                      <option value="color" selected="selected">{{ text_color }}</option>
                    {% else %}
                      <option value="color">{{ text_color }}</option>
                    {% endif %}
                    </optgroup>
                      <optgroup label="{{ text_input }}">
                    {% if type == 'text' %}
                      <option value="text" selected="selected">{{ text_text }}</option>
                    {% else %}
                      <option value="text">{{ text_text }}</option>
                    {% endif %}
                    {% if type == 'textarea' %}
                      <option value="textarea" selected="selected">{{ text_textarea }}</option>
                    {% else %}
                      <option value="textarea">{{ text_textarea }}</option>
                    {% endif %}
                    </optgroup>
                      <optgroup label="{{ text_file }}">
                    {% if type == 'file' %}
                      <option value="file" selected="selected">{{ text_file }}</option>
                    {% else %}
                      <option value="file">{{ text_file }}</option>
                    {% endif %}
                    </optgroup>
                      <optgroup label="{{ text_date }}">
                    {% if type == 'date' %}
                      <option value="date" selected="selected">{{ text_date }}</option>
                    {% else %}
                      <option value="date">{{ text_date }}</option>
                    {% endif %}
                    {% if type == 'time' %}
                      <option value="time" selected="selected">{{ text_time }}</option>
                    {% else %}
                      <option value="time">{{ text_time }}</option>
                    {% endif %}
                    {% if type == 'datetime' %}
                      <option value="datetime" selected="selected">{{ text_datetime }}</option>
                    {% else %}
                      <option value="datetime">{{ text_datetime }}</option>
                    {% endif %}
                    </optgroup>
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                    <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="status" id="input-status" class="form-control">
                      {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {% set option_value_row = 0 %}
      <div class="row form-row--spaced" id="option-values-row"{% if type not in ['select', 'radio', 'checkbox', 'image', 'color'] and option_values|length == 0 %} style="display:none"{% endif %}>
        <div class="col-md-12 col-sm-12 col-lg-offset-3 col-lg-6 col-xl-offset-3 col-xl-6">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="list" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_value }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dc-opt-cards" id="option-values-cards">
                  {% for option_value in option_values %}
                  <div class="dc-opt-card" id="option-value-row{{ option_value_row }}">
                    <div class="dc-opt-card__header">
                      <span class="dc-opt-card__handle" title="{{ text_drag_to_reorder|default('Drag to reorder') }}">
                        <i data-lucide="grip-vertical" width="14" height="14" class="slide-drag-handle"></i>
                      </span>
                      <span class="dc-opt-card__title">
                        {{ option_value.option_value_description[admin_language_id] ? option_value.option_value_description[admin_language_id].name : '' }}
                      </span>
                      <button type="button" onclick="$('#option-value-row{{ option_value_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-xs dc-opt-card__remove"><i data-lucide="circle-minus" width="14" height="14"></i></button>
                    </div>
                    <div class="dc-opt-card__body">
                      <input type="hidden" name="option_value[{{ option_value_row }}][option_value_id]" value="{{ option_value.option_value_id }}" />
                      <div class="dc-opt-card__field">
                        <div class="dc-opt-card__languages" style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
                        {% for language in languages %}
                          <div class="dc-opt-card__lang-row">
                            <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                            <input type="text" name="option_value[{{ option_value_row }}][option_value_description][{{ language.language_id }}][name]" value="{{ (option_value.option_value_description[language.language_id] ? option_value.option_value_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_option_value }}" class="form-control" />
                          </div>
                        {% endfor %}
                        {% for language in languages %}
                          {% if error_option_value[option_value_row][language.language_id] %}
                          <div class="text-danger">{{ error_option_value[option_value_row][language.language_id] }}</div>
                          {% endif %}
                        {% endfor %}
                        </div>
                      </div>
                      {% if type == 'color' %}
                      <div class="dc-opt-card__field dc-color-col">
                        <label>{{ entry_color }}</label>
                        <input type="color" name="option_value[{{ option_value_row }}][color_code]" value="{{ option_value.color_code }}" class="form-control" style="width:50px;height:34px;padding:2px;cursor:pointer;" />
                      </div>
                      {% endif %}
                    </div>
                  </div>
                  {% set option_value_row = option_value_row + 1 %}
                  {% endfor %}
                </div>
                <div class="dc-opt-actions">
                  <button type="button" onclick="addOptionValue();" data-toggle="tooltip" title="{{ button_option_value_add }}" class="btn btn-primary btn-sm"><i data-lucide="circle-plus" width="16" height="16"></i> {{ button_option_value_add }}</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript" src="view/javascript/sortablejs/Sortable.min.js"></script>
<script type="text/javascript"><!--
$('select[name=\'type\']').on('change', function() {
	var showValues = this.value == 'select' || this.value == 'radio' || this.value == 'checkbox' || this.value == 'image' || this.value == 'color';
	var showColor = this.value == 'color';

	$('#option-values-row').toggle(showValues);
	$('.dc-color-col').toggle(showColor);
});

$('select[name=\'type\']').trigger('change');

var option_value_row = {{ option_value_row }};

function addOptionValue() {
	var currentType = $('select[name="type"]').val();
	html  = '<div class="dc-opt-card" id="option-value-row' + option_value_row + '">';
	html += '  <div class="dc-opt-card__header">';
	html += '    <span class="dc-opt-card__handle"><i data-lucide="grip-vertical" width="14" height="14" class="slide-drag-handle"></i></span>';
	html += '    <span class="dc-opt-card__title">{{ entry_option_value }}</span>';
	html += '    <button type="button" class="btn btn-danger btn-xs dc-opt-card__remove" onclick="$(\'#option-value-row' + option_value_row + '\').remove();">';
	html += '      <i data-lucide="circle-minus" width="14" height="14"></i></button>';
	html += '  </div>';
	html += '  <div class="dc-opt-card__body">';
	html += '    <input type="hidden" name="option_value[' + option_value_row + '][option_value_id]" value="" />';
	html += '    <div class="dc-opt-card__field">';
	html += '      <div class="dc-opt-card__languages" style="flex: 1; display: flex; flex-direction: column; gap: 6px;">';
	{% for language in languages %}
	html += '        <div class="dc-opt-card__lang-row">';
	html += '          <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>';
	html += '          <input type="text" name="option_value[' + option_value_row + '][option_value_description][{{ language.language_id }}][name]" value="" placeholder="{{ entry_option_value }}" class="form-control" />';
	html += '        </div>';
	{% endfor %}
	html += '      </div>';
	html += '    </div>';
	if (currentType === 'color') {
		html += '    <div class="dc-opt-card__field dc-color-col">';
		html += '      <label>{{ entry_color }}</label>';
		html += '      <input type="color" name="option_value[' + option_value_row + '][color_code]" value="" class="form-control" style="width:50px;height:34px;padding:2px;cursor:pointer;" />';
		html += '    </div>';
	}
	html += '  </div>';
	html += '</div>';

	$('#option-values-cards').append(html);
	lucide.createIcons();
	initSortable();

	option_value_row++;
}

function initSortable() {
	var el = document.getElementById('option-values-cards');
	if (el && typeof Sortable !== 'undefined') {
		Sortable.create(el, {
			animation: 150,
			filter: '.dc-opt-card__remove, input, select, textarea, button',
			preventOnFilter: false,
			ghostClass: 'dc-opt-ghost',
			chosenClass: 'dc-opt-chosen'
		});
	}
}

function updateOptionValueSortOrders() {
	$('#option-values-cards .dc-opt-card').each(function(i) {
		$(this).find('input[name$=\'[sort_order]\']').val(i);
	});
}

$(document).ready(function() {
	initSortable();
	$('#form-option').on('submit', function() {
		updateOptionValueSortOrders();
	});
});
//--></script>
{{ footer }}
