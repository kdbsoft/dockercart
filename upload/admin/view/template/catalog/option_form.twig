{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-option" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <h1 class="page-header__title">{{ text_form }}</h1>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-option">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="sliders" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_form }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <ul class="nav nav-tabs" id="language">
                  {% for language in languages %}
                  <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                  {% endfor %}
                </ul>
                <div class="tab-content">
                  {% for language in languages %}
                  <div class="tab-pane" id="language{{ language.language_id }}">
                    <div class="dcx-fields">
                      <div class="dcx-field required">
                        <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                        <input type="text" name="option_description[{{ language.language_id }}][name]" value="{{ (option_description[language.language_id] ? option_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                        {% if error_name[language.language_id] %}
                        <div class="text-danger">{{ error_name[language.language_id] }}</div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="settings" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_settings_card }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-type">{{ entry_type }}</label>
                <select name="type" id="input-type" class="form-control">
                  <optgroup label="{{ text_choose }}">
                {% if type == 'select' %}
                  <option value="select" selected="selected">{{ text_select }}</option>
                {% else %}
                  <option value="select">{{ text_select }}</option>
                {% endif %}
                {% if type == 'radio' %}
                  <option value="radio" selected="selected">{{ text_radio }}</option>
                {% else %}
                  <option value="radio">{{ text_radio }}</option>
                {% endif %}
                {% if type == 'checkbox' %}
                  <option value="checkbox" selected="selected">{{ text_checkbox }}</option>
                {% else %}
                  <option value="checkbox">{{ text_checkbox }}</option>
                {% endif %}
                {% if type == 'color' %}
                  <option value="color" selected="selected">{{ text_color }}</option>
                {% else %}
                  <option value="color">{{ text_color }}</option>
                {% endif %}
                </optgroup>
                  <optgroup label="{{ text_input }}">
                {% if type == 'text' %}
                  <option value="text" selected="selected">{{ text_text }}</option>
                {% else %}
                  <option value="text">{{ text_text }}</option>
                {% endif %}
                {% if type == 'textarea' %}
                  <option value="textarea" selected="selected">{{ text_textarea }}</option>
                {% else %}
                  <option value="textarea">{{ text_textarea }}</option>
                {% endif %}
                </optgroup>
                  <optgroup label="{{ text_file }}">
                {% if type == 'file' %}
                  <option value="file" selected="selected">{{ text_file }}</option>
                {% else %}
                  <option value="file">{{ text_file }}</option>
                {% endif %}
                </optgroup>
                  <optgroup label="{{ text_date }}">
                {% if type == 'date' %}
                  <option value="date" selected="selected">{{ text_date }}</option>
                {% else %}
                  <option value="date">{{ text_date }}</option>
                {% endif %}
                {% if type == 'time' %}
                  <option value="time" selected="selected">{{ text_time }}</option>
                {% else %}
                  <option value="time">{{ text_time }}</option>
                {% endif %}
                {% if type == 'datetime' %}
                  <option value="datetime" selected="selected">{{ text_datetime }}</option>
                {% else %}
                  <option value="datetime">{{ text_datetime }}</option>
                {% endif %}
                </optgroup>
                </select>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
                <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="list" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_value }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <table id="option-value" class="table table-bordered table-striped table-hover">
                  <thead>
                    <tr>
                      <td class="text-left required">{{ entry_option_value }}</td>
                      <td class="text-center dc-color-col">{{ entry_color }}</td>
                      <td class="text-right">{{ entry_sort_order }}</td>
                      <td></td>
                    </tr>
                  </thead>
                  <tbody>

                  {% set option_value_row = 0 %}
                  {% for option_value in option_values %}
                  <tr id="option-value-row{{ option_value_row }}">
                      <td class="text-center"><input type="hidden" name="option_value[{{ option_value_row }}][option_value_id]" value="{{ option_value.option_value_id }}" />
                      <div class="attribute-texts">
                      {% for language in languages %}
                      <div class="input-group attribute-text-group"><span class="input-group-addon"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span></span>
                        <input type="text" name="option_value[{{ option_value_row }}][option_value_description][{{ language.language_id }}][name]" value="{{ (option_value.option_value_description[language.language_id] ? option_value.option_value_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_option_value }}" class="form-control" />
                      </div>
                      {% endfor %}
                      </div>
                      {% for language in languages %}
                      {% if error_option_value[option_value_row][language.language_id] %}
                      <div class="text-danger">{{ error_option_value[option_value_row][language.language_id] }}</div>
                      {% endif %}
                      {% endfor %}</td>
                    <td class="text-center dc-color-col"><input type="color" name="option_value[{{ option_value_row }}][color_code]" value="{{ option_value.color_code }}" class="form-control" style="width:50px;height:34px;padding:2px;margin:0 auto;cursor:pointer;" /></td>
                    <td class="text-right"><input type="text" name="option_value[{{ option_value_row }}][sort_order]" value="{{ option_value.sort_order }}" class="form-control" /></td>
                    <td class="text-right"><button type="button" onclick="$('#option-value-row{{ option_value_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon"><i data-lucide="minus-circle" width="14" height="14"></i></button></td>
                  </tr>
                  {% set option_value_row = option_value_row + 1 %}
                  {% endfor %}
                    </tbody>

                  <tfoot>
                    <tr>
                      <td colspan="3"></td>
                      <td class="text-right"><button type="button" onclick="addOptionValue();" data-toggle="tooltip" title="{{ button_option_value_add }}" class="btn btn-primary btn--icon"><i data-lucide="plus-circle" width="16" height="16"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('#language a:first').tab('show');
$('select[name=\'type\']').on('change', function() {
	var showValues = this.value == 'select' || this.value == 'radio' || this.value == 'checkbox' || this.value == 'image' || this.value == 'color';
	var showColor = this.value == 'color';

	$('#option-value').toggle(showValues);

	$('.dc-color-col').toggle(showColor);
	$('#option-value tfoot tr td:first').attr('colspan', showColor ? 3 : 2);
});

$('select[name=\'type\']').trigger('change');

var option_value_row = {{ option_value_row }};

function addOptionValue() {
	var currentType = $('select[name="type"]').val();
	html  = '<tr id="option-value-row' + option_value_row + '">';
	html += '  <td class="text-left"><input type="hidden" name="option_value[' + option_value_row + '][option_value_id]" value="" />';
	html += '  <div class="attribute-texts">';
	{% for language in languages %}
	html += '    <div class="input-group attribute-text-group">';
	html += '      <span class="input-group-addon"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span></span><input type="text" name="option_value[' + option_value_row + '][option_value_description][{{ language.language_id }}][name]" value="" placeholder="{{ entry_option_value }}" class="form-control" />';
    html += '    </div>';
	{% endfor %}
	html += '  </div></td>';
	if (currentType === 'color') {
		html += '  <td class="text-center dc-color-col"><input type="color" name="option_value[' + option_value_row + '][color_code]" value="" class="form-control" style="width:50px;height:34px;padding:2px;margin:0 auto;cursor:pointer;" /></td>';
	}
	html += '  <td class="text-right"><input type="text" name="option_value[' + option_value_row + '][sort_order]" value="" placeholder="{{ entry_sort_order }}" class="form-control" /></td>';
	html += '  <td class="text-right"><button type="button" onclick="$(\'#option-value-row' + option_value_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon"><i data-lucide="minus-circle" width="14" height="14"></i></button></td>';
	html += '</tr>';

	$('#option-value tbody').append(html);

	option_value_row++;
}
//--></script>
{{ footer }}
