<div id="dc-variant-axes-section" style="display:none;margin-bottom:20px"></div>
<div id="dc-variant-matrix-section" style="display:none"></div>
<div id="dc-variant-container">
	<div class="text-center"><span class="dc-spinner dc-spinner--lg"></span></div>
</div>
<div id="dc-variant-toasts"></div>

<script type="text/javascript"><!--
var dcVariantRowIdx = 0;
var dcSaveTimers = {};
var dcAxesLoading = {};
var dcCurrentDefaultId = 0;
var dcCurrentAxes = [];

function getDcProductId() {
	var matches = /[&?]product_id=(\d+)/.exec(window.location.href);
	return matches ? matches[1] : '0';
}

function showToast(msg, type, dur) {
	var $container = $('#dc-variant-toasts');
	var cls = type === 'error' ? 'dc-toast-error' : 'dc-toast-success';
	var icon = type === 'error' ? 'circle-alert' : 'circle-check';
	var $toast = $('<div class="dc-toast ' + cls + '"><i data-lucide="' + icon + '"></i> ' + msg + '</div>');
	$container.append($toast);
	lucide.createIcons({ nodes: [$toast[0]] });
	$toast.hide().fadeIn(200);
	if (type !== 'error' || dur) {
		setTimeout(function() {
			$toast.fadeOut(300, function() { $toast.remove(); });
		}, dur || 2500);
	} else {
		$toast.on('click', function() {
			$toast.fadeOut(200, function() { $toast.remove(); });
		});
	}
	var $toasts = $container.children();
	if ($toasts.length > 5) {
		$toasts.first().fadeOut(200, function() { $(this).remove(); });
	}
}

function loadVariantMatrix() {
	var productId = getDcProductId();
	var container = $('#dc-variant-container');

	if (!productId || productId == '0') {
		container.html('<div class="alert alert-info">{{ text_save_product_first|e("js") }}</div>');
		$('#dc-variant-axes-section').hide();
		$('#dc-variant-matrix-section').hide();
		$('#dc-inventory-variants-col').hide();
		$('#dc-pricing-variants-col').hide();
		$('#dc-dimensions-variants-col').hide();
		$('#dc-codes-variants-col').hide();
		return;
	}

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId,
		dataType: 'json',
		beforeSend: function() {
			container.html('<div class="text-center"><span class="dc-spinner dc-spinner--lg"></span></div>');
		},
		success: function(json) {
			container.html('');

			if (json.error) {
				container.html('<div class="alert alert-danger">' + json.error + '</div>');
				$('#dc-inventory-variants-col').hide();
				$('#dc-pricing-variants-col').hide();
				$('#dc-dimensions-variants-col').hide();
				$('#dc-codes-variants-col').hide();
				return;
			}

			dcCurrentDefaultId = json.default_variant_id || 0;
			renderVariantMatrix(productId, json);
			renderAxesSelector(productId, json);
			renderInventoryVariants(json);
			renderPricingVariants(json);
			renderDimensionsVariants(json);
			renderCodesVariants(json);
			renderMediaVariantAssignments(json);

			var axes = json.configurable_options || [];
			dcAxisOptionIds = axes.map(function(a) { return parseInt(a.option_id); });
			if (typeof dcUpdatePricingRanges === 'function') {
				dcUpdatePricingRanges(json);
			}
			if (typeof dcUpdateDimensionsRanges === 'function') {
				dcUpdateDimensionsRanges(json);
			} else if (typeof dcUpdateDimensionsRangesInternal === 'function') {
				dcUpdateDimensionsRangesInternal(json);
			}
		},
		error: function() {
			container.html('<div class="alert alert-danger">{{ text_load_error|e("js") }}</div>');
			$('#dc-inventory-variants-col').hide();
			$('#dc-pricing-variants-col').hide();
			$('#dc-dimensions-variants-col').hide();
			$('#dc-codes-variants-col').hide();
		}
	});
}

function renderAxesSelector(productId, json) {
	var section = $('#dc-variant-axes-section');
	var axes = json.configurable_options || [];

	section.show();

	var html = '<label>{{ entry_configurable_axes|e("js") }}</label>';
	html += '<div class="dc-opt-add-tree" style="display:inline-block; min-width:300px; margin-left:10px;">';
	html += '<div class="dcx-tree-select"';
	html += '     data-url="index.php?route=catalog/option/tree&user_token={{ user_token }}"';
	html += '     data-id-key="option_id"';
	html += '     data-none-text="{{ text_none }}"';
	html += '     data-placeholder="{{ entry_select_option|e("js") }}">';
	html += '  <div class="dcx-tree-select__input-wrap">';
	html += '    <input type="text" class="dcx-tree-select__input form-control input-sm" placeholder="{{ entry_select_option|e("js") }}" tabindex="-1" />';
	html += '    <input type="hidden" name="configurable_option_id" value="" />';
	html += '    <span class="dcx-tree-select__toggle"><i data-lucide="chevron-down" width="16" height="16"></i></span>';
	html += '  </div>';
	html += '  <div class="dcx-tree-select__dropdown">';
	html += '    <div class="dcx-tree-select__search">';
	html += '      <input type="text" class="form-control" placeholder="{{ entry_select_option|e("js") }}" />';
	html += '      <i data-lucide="search" width="14" height="14"></i>';
	html += '    </div>';
	html += '    <div class="dcx-tree-select__list"></div>';
	html += '  </div>';
	html += '</div>';
	html += '</div>';
	html += '<div class="dc-configurable-axes-list" id="dc-configurable-axes-list" style="margin-top:10px">';

	for (var i = 0; i < axes.length; i++) {
		html += '<div class="dc-axe-item" style="display:inline-block;margin-right:8px;margin-bottom:4px;padding:4px 8px;background:#f0f0f0;border-radius:3px" data-option-id="' + axes[i].option_id + '">';
		html += '<i data-lucide="grip-vertical" width="14" height="14"></i> ' + axes[i].name;
		html += ' <span class="text-muted">(' + axes[i].type + ')</span>';
		html += ' <button type="button" class="close" onclick="removeAxe(this, ' + productId + ', ' + axes[i].option_id + ')" style="font-size:16px;line-height:1">&times;</button>';
		html += '</div>';
	}

	html += '</div>';
	if (axes.length >= 3) {
		html += '<p class="text-muted" style="margin-top:6px;font-size:12px"><i data-lucide="info" width="12" height="12"></i> {{ text_max_axes_reached|e("js") }}</p>';
	}

	section.html(html);
	lucide.createIcons();

	if (axes.length >= 3) {
		section.find('.dc-opt-add-tree').hide();
	} else {
		DcxTreeSelect.init();
	}

	var $axisTree = section.find('.dcx-tree-select');
	if ($axisTree.length) {
		var inst = $axisTree.data('dcx-tree-select');
		if (inst && !inst.filterCallback) {
			inst.filterCallback = function(data) {
				var excludeIds = [];
				$('#dc-configurable-axes-list .dc-axe-item').each(function() {
					var id = parseInt($(this).data('option-id'));
					if (id) excludeIds.push(id);
				});
				$('#dc-options-container .dc-option-section:not(.dc-option-axis) input[name$="[option_id]"]').each(function() {
					var id = parseInt($(this).val());
					if (id) excludeIds.push(id);
				});
				return data.filter(function(item) {
					return excludeIds.indexOf(parseInt(item.category_id)) === -1;
				});
			};
		}

		$(document).off('change', '#dc-variant-axes-section input[name="configurable_option_id"]');
		$(document).on('change', '#dc-variant-axes-section input[name="configurable_option_id"]', function() {
			var optionId = parseInt($(this).val());
			if (!optionId || optionId <= 0) return;
			addConfigurableAxe(productId, optionId);
			$(this).val('');
			$axisTree.find('.dcx-tree-select__input').val('');
		});
	}
}

function addConfigurableAxe(productId, optionId) {
	var currentIds = [];
	$('#dc-configurable-axes-list .dc-axe-item').each(function() {
		var id = $(this).data('option-id');
		if (id) currentIds.push(id);
	});

	if (currentIds.indexOf(optionId) >= 0) {
		return;
	}

	if (currentIds.length >= 3) {
		showToast('{{ error_max_axes|e("js") }}', 'error');
		return;
	}

	var conflictSimple = false;
	$('#dc-options-container .dc-option-section:not(.dc-option-axis) input[name$="[option_id]"]').each(function() {
		if (parseInt($(this).val()) === optionId) {
			conflictSimple = true;
			return false;
		}
	});
	if (conflictSimple) {
		showToast('{{ error_axis_conflicts_simple|e("js") }}', 'error');
		return;
	}

	currentIds.push(optionId);

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setAxes&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: productId,
			option_ids: currentIds
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
				return;
			}

			loadVariantMatrix();
		}
	});
}

function removeAxe(btn, productId, optionId) {
	if (!confirm('{{ text_confirm_remove_axis|e("js") }}')) {
		return;
	}

	var currentIds = [];
	$('#dc-configurable-axes-list .dc-axe-item').each(function() {
		var id = $(this).data('option-id');
		if (id && id != optionId) currentIds.push(id);
	});

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setAxes&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: productId,
			option_ids: currentIds
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
				return;
			}

			loadVariantMatrix();
		}
	});
}

function renderVariantMatrix(productId, json) {
	var section = $('#dc-variant-matrix-section');
	var variants = json.variants || [];
	var axes = json.configurable_options || [];
	var isConfigurable = json.is_configurable;

	if (!axes.length) {
		section.html('<p class="text-muted">{{ text_no_axes|e("js") }}</p>').show();
		return;
	}

	dcCurrentAxes = axes;
	section.show();

	var html = '<h4>{{ text_variants|e("js") }} <small id="dc-variant-count">(' + variants.length + ')</small></h4>';
	html += '<div class="row" style="margin-bottom:12px">';
	html += '<div class="col-sm-12">';
	html += '<button type="button" class="btn btn-primary btn-sm" onclick="addVariantRow(' + productId + ')"><i data-lucide="plus"></i> {{ button_add_variant|e("js") }}</button>';
	html += ' <button type="button" class="btn btn-warning btn-sm" onclick="generateVariants(' + productId + ')" title="{{ help_generate|e("js") }}"><i data-lucide="wand-sparkles"></i> {{ button_generate|e("js") }}</button>';
	html += '</div></div>';
	html += '<div class="dc-variant-scroll-wrapper">';
	html += '<table class="table table-bordered table-hover dc-variant-table" id="dc-variant-table">';
	html += '<thead><tr>';

	html += '<th class="dc-col-sku dc-th-sku">{{ column_model|e("js") }}</th>';

	for (var a = 0; a < axes.length; a++) {
		html += '<th class="dc-th-axis">' + axes[a].name + '</th>';
	}

	html += '<th class="dc-th-default text-center">{{ column_default|e("js") }}</th>';
	html += '<th class="dc-th-status text-center">{{ column_status|e("js") }}</th>';
	html += '<th class="dc-th-action text-center"></th>';
	html += '</tr></thead>';
	html += '<tbody id="dc-variant-tbody">';

	for (var v = 0; v < variants.length; v++) {
		html += buildVariantRow(productId, variants[v], axes, json.default_variant_id);
	}

	html += '</tbody>';
	html += '</table>';
	html += '</div>';
	html += '<div class="dc-hscroll" id="dc-hscroll"><div class="dc-hscroll__spacer"></div></div>';

	section.html(html);
	lucide.createIcons();
	bindHScrollProxy();
}

function buildVariantRow(productId, variant, axes, defaultVariantId) {
	dcVariantRowIdx++;
	var rowIdx = dcVariantRowIdx;
	var isDefault = variant.variant_id == defaultVariantId;
	var isActive = variant.status == 1;
	var variantId = variant.variant_id || 0;
	var isNew = variantId === 0;
	var optionValues = {};

	if (variant.values) {
		for (var j = 0; j < variant.values.length; j++) {
			optionValues[variant.values[j].option_id] = variant.values[j].option_value_id;
		}
	}

	var rowClasses = 'dc-state-clean';
	if (isNew) rowClasses += ' dc-new';
	if (!isActive) rowClasses += ' dc-disabled';

	var html = '<tr id="dc-variant-row-' + rowIdx + '" class="' + rowClasses + '" data-variant-id="' + variantId + '" data-row-idx="' + rowIdx + '">';

	html += '<td class="dc-col-sku"><input type="text" class="form-control input-sm dc-variant-model" value="' + (variant.model || '') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:90px"/></td>';

	for (var a = 0; a < axes.length; a++) {
		var axeOptionId = axes[a].option_id;
		html += '<td><select class="form-control input-sm dc-variant-value" data-option-id="' + axeOptionId + '" onchange="onVariantAxisChange(' + rowIdx + ')">';
		html += '<option value="">{{ text_select|e("js") }}</option>';

		for (var k in axes[a].values) {
			var ovId = axes[a].values[k].option_value_id;
			var ovName = axes[a].values[k].name;
			var selected = (optionValues[axeOptionId] == ovId) ? ' selected="selected"' : '';
			html += '<option value="' + ovId + '"' + selected + '>' + ovName + '</option>';
		}

		html += '</select></td>';
	}

	html += '<td class="text-center"><button type="button" class="dc-star-btn' + (isDefault ? ' dc-star-active' : '') + '" onclick="onVariantStarClick(' + rowIdx + ')" title="{{ column_default|e("js") }}"><i data-lucide="star"></i></button></td>';
	html += '<td class="text-center"><label class="dc-toggle"><input type="checkbox" class="dc-variant-status"' + (isActive ? ' checked="checked"' : '') + ' onchange="onVariantStatusChange(' + rowIdx + ')"/><span class="dc-toggle-slider"></span></label></td>';
	html += '<td class="text-center">';
	html += '<button type="button" class="btn btn-danger btn-xs" onclick="deleteVariant(' + rowIdx + ')"><i data-lucide="trash-2"></i></button>';
	html += '</td>';
	html += '</tr>';

	return html;
}

function addVariantRow(productId) {
	var axes = dcCurrentAxes;
	if (!axes || !axes.length) return;

	var rowIdx = ++dcVariantRowIdx;
	var html = '<tr id="dc-variant-row-' + rowIdx + '" class="dc-state-dirty dc-new" data-variant-id="0" data-row-idx="' + rowIdx + '">';

	html += '<td class="dc-col-sku"><input type="text" class="form-control input-sm dc-variant-model" value="" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:90px"/></td>';

	for (var a = 0; a < axes.length; a++) {
		html += '<td><select class="form-control input-sm dc-variant-value" data-option-id="' + axes[a].option_id + '" onchange="onVariantAxisChange(' + rowIdx + ')"><option value="">{{ text_select|e("js") }}</option></select></td>';
	}

	html += '<td class="text-center"><button type="button" class="dc-star-btn" onclick="onVariantStarClick(' + rowIdx + ')" title="{{ column_default|e("js") }}"><i data-lucide="star"></i></button></td>';
	html += '<td class="text-center"><label class="dc-toggle"><input type="checkbox" class="dc-variant-status" checked="checked" onchange="onVariantStatusChange(' + rowIdx + ')"/><span class="dc-toggle-slider"></span></label></td>';
	html += '<td class="text-center">';
	html += '<button type="button" class="btn btn-danger btn-xs" onclick="deleteVariant(' + rowIdx + ')"><i data-lucide="trash-2"></i></button>';
	html += '</td>';
	html += '</tr>';

	$('#dc-variant-tbody').prepend(html);
	lucide.createIcons();
	loadAxesOptionValues(rowIdx, productId);
	updateRowCount();
}

function loadAxesOptionValues(rowIdx, productId) {
	dcAxesLoading[rowIdx] = true;
	$('#dc-variant-row-' + rowIdx + ' .dc-variant-value').first().after('<span class="dc-loading-indicator"><span class="dc-spinner"></span></span>');

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId,
		dataType: 'json',
		success: function(json) {
			dcAxesLoading[rowIdx] = false;
			$('#dc-variant-row-' + rowIdx + ' .dc-loading-indicator').remove();

			if (json.configurable_options) {
				var selects = $('#dc-variant-row-' + rowIdx + ' .dc-variant-value');
				selects.each(function(i) {
					var sel = $(this);
					var axe = json.configurable_options[i];

					if (axe) {
						sel.data('option-id', axe.option_id);
						sel.empty();
						sel.append('<option value="">{{ text_select|e("js") }}</option>');

						for (var k in axe.values) {
							sel.append('<option value="' + axe.values[k].option_value_id + '">' + axe.values[k].name + '</option>');
						}
					}
				});
			}
		},
		error: function() {
			dcAxesLoading[rowIdx] = false;
			$('#dc-variant-row-' + rowIdx + ' .dc-loading-indicator').remove();
		}
	});
}

function onVariantAxisChange(rowIdx) {
	scheduleAutoSave(rowIdx);
}

function onVariantFieldInput(rowIdx) {
	scheduleAutoSave(rowIdx);
}

function onVariantStatusChange(rowIdx) {
	if (dcSaveTimers[rowIdx]) {
		clearTimeout(dcSaveTimers[rowIdx]);
		delete dcSaveTimers[rowIdx];
	}
	saveVariantRow(rowIdx);
}

function onVariantStarClick(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var vid = parseInt(row.data('variant-id')) || 0;

	if (!vid) {
		showToast('{{ text_saving|e("js") }}: {{ text_save_product_first|e("js") }}', 'error');
		return;
	}

	setDefaultVariant(rowIdx);
}

function scheduleAutoSave(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var state = row.data('state');
	if (state === 'saving' || state === 'new-loading') {
		row.data('pending', true);
		return;
	}
	if (dcAxesLoading[rowIdx]) return;

	row.data('state', 'dirty').removeClass('dc-state-clean dc-state-saving dc-state-error dc-state-flash').addClass('dc-state-dirty');

	if (dcSaveTimers[rowIdx]) {
		clearTimeout(dcSaveTimers[rowIdx]);
	}

	dcSaveTimers[rowIdx] = setTimeout(function() {
		delete dcSaveTimers[rowIdx];
		saveVariantRow(rowIdx);
	}, 600);
}

function saveVariantRow(rowIdx, onSuccess) {
	var row = $('#dc-variant-row-' + rowIdx);
	var pid = getDcProductId();
	var vid = parseInt(row.data('variant-id')) || 0;
	var values = [];
	var allSelected = true;

	row.find('.dc-variant-value').each(function() {
		var ovId = $(this).val();
		var oId = $(this).data('option-id') || 0;

		if (!ovId) {
			allSelected = false;
		} else {
			values.push({
				option_id: oId,
				option_value_id: ovId
			});
		}
	});

	if (!allSelected) {
		row.find('.dc-variant-value').each(function() {
			if (!$(this).val()) {
				$(this).addClass('dc-field-error');
				(function(el) {
					setTimeout(function() { el.removeClass('dc-field-error'); }, 2000);
				})($(this));
			}
		});
		return;
	}

	row.data('state', 'saving').removeClass('dc-state-dirty dc-state-error dc-state-flash').addClass('dc-state-saving');

	// The matrix only manages model, axis values and status. Codes, pricing,
	// quantity, weight and image are owned by their dedicated panels and are
	// intentionally not sent — the backend keeps absent fields untouched.
	var data = {
		product_id: pid,
		variant_id: vid,
		model: row.find('.dc-variant-model').val() || '',
		status: row.find('.dc-variant-status').is(':checked') ? 1 : 0,
		values: values
	};

	// Variant specials/discounts are managed in the product form Promotions
	// panel and saved together with the form submit — not here.

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariant&user_token={{ user_token }}',
		type: 'POST',
		data: data,
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				row.data('state', 'error').removeClass('dc-state-saving dc-state-dirty dc-state-flash').addClass('dc-state-error');
				showToast(json.error, 'error');
			} else {
				if (vid === 0 && json.variant_id) {
					row.data('variant-id', json.variant_id);
				}
				row.removeClass('dc-new dc-state-saving dc-state-dirty dc-state-error').addClass('dc-state-flash');
				row.data('state', 'clean');

				if (row.data('pending')) {
					row.data('pending', false);
					showToast('{{ text_saved|e("js") }}', 'success');
					setTimeout(function() {
						row.removeClass('dc-state-flash');
					}, 1500);
					saveVariantRow(rowIdx, onSuccess);
					return;
				}

				showToast('{{ text_saved|e("js") }}', 'success');

				var status = row.find('.dc-variant-status').is(':checked') ? 1 : 0;
				if (status) {
					row.removeClass('dc-disabled');
				} else {
					row.addClass('dc-disabled');
				}

				setTimeout(function() {
					row.removeClass('dc-state-flash');
				}, 1500);

				var newVid = parseInt(row.data('variant-id')) || 0;
				var $invRow = $('#dc-inventory-variants .dc-inv-row[data-variant-id="' + newVid + '"]');
				if ($invRow.length) {
					$invRow.toggleClass('dc-inv-row--off', status === 0);
				}
				var $priceRow = $('#dc-pricing-variants .dc-price-row[data-variant-id="' + newVid + '"]');
				if ($priceRow.length) {
					$priceRow.toggleClass('dc-price-row--off', status === 0);
				}
				var $codeRow = $('#dc-codes-variants .dc-code-row[data-variant-id="' + newVid + '"]');
				if ($codeRow.length) {
					$codeRow.toggleClass('dc-code-row--off', status === 0);
				}
				if (vid === 0 && newVid) {
					loadVariantMatrix();
				}

				if (typeof dcUpdatePricingRanges === 'function' && json.price_range_text !== undefined) {
					dcUpdatePricingRanges(json);
				}
				if (typeof updatePricingHeader === 'function' && json.price_range_text !== undefined) {
					updatePricingHeader(json);
				}
				if (typeof dcUpdateDimensionsRangesInternal === 'function') {
					dcUpdateDimensionsRangesInternal(json);
				} else if (typeof dcUpdateDimensionsRanges === 'function') {
					dcUpdateDimensionsRanges(json);
				}
				if (typeof updateDimensionsHeader === 'function') {
					updateDimensionsHeader(json);
				}

				if (typeof onSuccess === 'function') {
					onSuccess();
				}
			}
		},
		error: function() {
			row.data('state', 'error').removeClass('dc-state-saving dc-state-flash').addClass('dc-state-error');
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function setDefaultVariant(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var vid = parseInt(row.data('variant-id')) || 0;
	if (!vid) return;

	var prevDefault = dcCurrentDefaultId;
	dcCurrentDefaultId = vid;

	$('.dc-star-btn').removeClass('dc-star-active');
	row.find('.dc-star-btn').addClass('dc-star-active');

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setDefault&user_token={{ user_token }}',
		type: 'POST',
		data: {variant_id: vid},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				dcCurrentDefaultId = prevDefault;
				rebuildDefaultStars();
				showToast(json.error, 'error');
			} else {
				showToast('{{ text_saved|e("js") }}', 'success', 1500);
			}
		},
		error: function() {
			dcCurrentDefaultId = prevDefault;
			rebuildDefaultStars();
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function rebuildDefaultStars() {
	$('.dc-star-btn').each(function() {
		var $btn = $(this);
		var $row = $btn.closest('tr');
		var vid = parseInt($row.data('variant-id')) || 0;
		if (vid == dcCurrentDefaultId) {
			$btn.addClass('dc-star-active');
		} else {
			$btn.removeClass('dc-star-active');
		}
	});
}

function deleteVariant(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var vid = parseInt(row.data('variant-id')) || 0;
	var pid = getDcProductId();

	if (!vid) {
		var tmpVid = parseInt(row.data('variant-id')) || 0;
		var $tmpInv = tmpVid ? $('#dc-inventory-variants .dc-inv-row[data-variant-id="' + tmpVid + '"]') : $();
		var $tmpPrice = tmpVid ? $('#dc-pricing-variants .dc-price-row[data-variant-id="' + tmpVid + '"]') : $();
		var $tmpDim = tmpVid ? $('#dc-dimensions-variants .dc-dim-row[data-variant-id="' + tmpVid + '"]') : $();
		row.fadeOut(200, function() {
			$(this).remove();
			updateRowCount();
			if ($tmpInv.length) {
				$tmpInv.remove();
				updateInventoryTotal();
			}
			if ($tmpPrice.length) {
				$tmpPrice.remove();
				updatePricingHeader({variants: $('#dc-pricing-variants .dc-price-row').map(function(){return {};}).get()});
			}
			if ($tmpDim.length) {
				$tmpDim.remove();
				updateDimensionsHeader({variants: $('#dc-dimensions-variants .dc-dim-row').map(function(){return {};}).get()});
			}
		});
		return;
	}

	if (!confirm('{{ text_confirm_delete_variant|e("js") }}')) {
		return;
	}

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/deleteVariant&user_token={{ user_token }}',
		type: 'POST',
		data: {variant_id: vid},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
			} else {
				row.fadeOut(200, function() {
					$(this).remove();
					updateRowCount();
				});

				var $invRow = $('#dc-inventory-variants .dc-inv-row[data-variant-id="' + vid + '"]');
				if ($invRow.length) {
					$invRow.remove();
					updateInventoryTotal();
				}

				var $priceRowDel = $('#dc-pricing-variants .dc-price-row[data-variant-id="' + vid + '"]');
				if ($priceRowDel.length) {
					$priceRowDel.remove();
					updatePricingHeader(json);
				}

				var $dimRowDel = $('#dc-dimensions-variants .dc-dim-row[data-variant-id="' + vid + '"]');
				if ($dimRowDel.length) {
					$dimRowDel.remove();
					updateDimensionsHeader(json);
				}

				if (json.default_variant_id !== undefined) {
					dcCurrentDefaultId = json.default_variant_id;
					rebuildDefaultStars();
				}

				if (typeof dcUpdatePricingRanges === 'function' && json.price_range_text !== undefined) {
					dcUpdatePricingRanges(json);
				}
				if (typeof dcUpdateDimensionsRangesInternal === 'function') {
					dcUpdateDimensionsRangesInternal(json);
				} else if (typeof dcUpdateDimensionsRanges === 'function') {
					dcUpdateDimensionsRanges(json);
				}

				showToast('{{ text_saved|e("js") }}', 'success', 1500);
			}
		},
		error: function() {
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function generateVariants(productId) {
	if (!confirm('{{ text_confirm_generate|e("js") }}')) {
