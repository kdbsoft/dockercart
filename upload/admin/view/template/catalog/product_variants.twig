<div id="dc-variant-axes-section" style="display:none;margin-bottom:20px"></div>
<div id="dc-variant-matrix-section" style="display:none"></div>
<div id="dc-variant-container">
	<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i></div>
</div>
<div id="dc-variant-toasts"></div>

<script type="text/javascript"><!--
var dcVariantRowIdx = 0;
var dcSaveTimers = {};
var dcAxesLoading = {};
var dcCurrentDefaultId = 0;
var dcCurrentAxes = [];

function getDcProductId() {
	var matches = /[&?]product_id=(\d+)/.exec(window.location.href);
	return matches ? matches[1] : '0';
}

function showToast(msg, type, dur) {
	var $container = $('#dc-variant-toasts');
	var cls = type === 'error' ? 'dc-toast-error' : 'dc-toast-success';
	var icon = type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle';
	var $toast = $('<div class="dc-toast ' + cls + '"><i class="fa ' + icon + '"></i> ' + msg + '</div>');
	$container.append($toast);
	$toast.hide().fadeIn(200);
	if (type !== 'error' || dur) {
		setTimeout(function() {
			$toast.fadeOut(300, function() { $toast.remove(); });
		}, dur || 2500);
	} else {
		$toast.on('click', function() {
			$toast.fadeOut(200, function() { $toast.remove(); });
		});
	}
	var $toasts = $container.children();
	if ($toasts.length > 5) {
		$toasts.first().fadeOut(200, function() { $(this).remove(); });
	}
}

function loadVariantMatrix() {
	var productId = getDcProductId();
	var container = $('#dc-variant-container');

	if (!productId || productId == '0') {
		container.html('<div class="alert alert-info">{{ text_save_product_first|e("js") }}</div>');
		$('#dc-variant-axes-section').hide();
		$('#dc-variant-matrix-section').hide();
		return;
	}

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId,
		dataType: 'json',
		beforeSend: function() {
			container.html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
		},
		success: function(json) {
			container.html('');

			if (json.error) {
				container.html('<div class="alert alert-danger">' + json.error + '</div>');
				return;
			}

			dcCurrentDefaultId = json.default_variant_id || 0;
			renderVariantMatrix(productId, json);
			renderAxesSelector(productId, json);

			var axes = json.configurable_options || [];
			dcAxisOptionIds = axes.map(function(a) { return parseInt(a.option_id); });
		},
		error: function() {
			container.html('<div class="alert alert-danger">{{ text_load_error|e("js") }}</div>');
		}
	});
}

function renderAxesSelector(productId, json) {
	var section = $('#dc-variant-axes-section');
	var axes = json.configurable_options || [];

	section.show();

	var html = '<label>{{ entry_configurable_axes|e("js") }}</label>';
	html += '<input type="text" name="configurable_option" value="" placeholder="{{ entry_select_option|e("js") }}" id="input-configurable-option" class="form-control input-sm" style="max-width:350px"/>';
	html += '<div class="dc-configurable-axes-list" id="dc-configurable-axes-list" style="margin-top:10px">';

	for (var i = 0; i < axes.length; i++) {
		html += '<div class="dc-axe-item" style="display:inline-block;margin-right:8px;margin-bottom:4px;padding:4px 8px;background:#f0f0f0;border-radius:3px" data-option-id="' + axes[i].option_id + '">';
		html += '<i class="fa fa-arrows"></i> ' + axes[i].name;
		html += ' <span class="text-muted">(' + axes[i].type + ')</span>';
		html += ' <button type="button" class="close" onclick="removeAxe(this, ' + productId + ', ' + axes[i].option_id + ')" style="font-size:16px;line-height:1">&times;</button>';
		html += '</div>';
	}

	html += '</div>';
	section.html(html);

	$('#input-configurable-option').autocomplete({
		source: function(request, response) {
			$.ajax({
				url: 'index.php?route=catalog/option/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
				dataType: 'json',
				success: function(json) {
					response($.map(json, function(item) {
						return {
							label: item.name,
							value: item.option_id
						};
					}));
				}
			});
		},
		select: function(item) {
			$('#input-configurable-option').val('');
			addConfigurableAxe(productId, item.value);
		}
	});
}

function addConfigurableAxe(productId, optionId) {
	var currentIds = [];
	$('#dc-configurable-axes-list .dc-axe-item').each(function() {
		var id = $(this).data('option-id');
		if (id) currentIds.push(id);
	});

	if (currentIds.indexOf(optionId) >= 0) {
		return;
	}

	var conflictSimple = false;
	$('#dc-options-container .dc-option-section:not(.dc-option-axis) input[name$="[option_id]"]').each(function() {
		if (parseInt($(this).val()) === optionId) {
			conflictSimple = true;
			return false;
		}
	});
	if (conflictSimple) {
		showToast('{{ error_axis_conflicts_simple|e("js") }}', 'error');
		return;
	}

	currentIds.push(optionId);

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setAxes&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: productId,
			option_ids: currentIds
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
				return;
			}

			loadVariantMatrix();
		}
	});
}

function removeAxe(btn, productId, optionId) {
	if (!confirm('{{ text_confirm_remove_axis|e("js") }}')) {
		return;
	}

	var currentIds = [];
	$('#dc-configurable-axes-list .dc-axe-item').each(function() {
		var id = $(this).data('option-id');
		if (id && id != optionId) currentIds.push(id);
	});

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setAxes&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: productId,
			option_ids: currentIds
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
				return;
			}

			loadVariantMatrix();
		}
	});
}

function renderVariantMatrix(productId, json) {
	var section = $('#dc-variant-matrix-section');
	var variants = json.variants || [];
	var axes = json.configurable_options || [];
	var isConfigurable = json.is_configurable;

	if (!axes.length) {
		section.html('<p class="text-muted">{{ text_no_axes|e("js") }}</p>').show();
		return;
	}

	dcCurrentAxes = axes;
	section.show();

	var html = '<h4>{{ text_variants|e("js") }} <small id="dc-variant-count">(' + variants.length + ')</small></h4>';
	html += '<div class="row" style="margin-bottom:12px">';
	html += '<div class="col-sm-12">';
	html += '<button type="button" class="btn btn-primary btn-sm" onclick="addVariantRow(' + productId + ')"><i class="fa fa-plus"></i> {{ button_add_variant|e("js") }}</button>';
	html += ' <button type="button" class="btn btn-warning btn-sm" onclick="generateVariants(' + productId + ')" title="{{ help_generate|e("js") }}"><i class="fa fa-magic"></i> {{ button_generate|e("js") }}</button>';
	html += '</div></div>';
	html += '<div class="dc-variant-scroll-wrapper">';
	html += '<table class="table table-hover dc-variant-table" id="dc-variant-table">';
	html += '<thead><tr>';

	for (var a = 0; a < axes.length; a++) {
		html += '<th>' + axes[a].name + '</th>';
	}

	html += '<th>{{ column_sku|e("js") }}</th>';
	html += '<th>{{ column_price|e("js") }}</th>';
	html += '<th>{{ column_quantity|e("js") }}</th>';
	html += '<th>{{ column_weight|e("js") }}</th>';
	html += '<th>{{ column_image|e("js") }}</th>';
	html += '<th class="text-center">{{ column_default|e("js") }}</th>';
	html += '<th class="text-center">{{ column_status|e("js") }}</th>';
	html += '<th class="text-center">{{ column_action|e("js") }}</th>';
	html += '</tr></thead>';
	html += '<tbody id="dc-variant-tbody">';

	for (var v = 0; v < variants.length; v++) {
		html += buildVariantRow(productId, variants[v], axes, json.default_variant_id);
	}

	html += '</tbody>';
	html += '</table>';
	html += '</div>';

	section.html(html);
}

function buildVariantRow(productId, variant, axes, defaultVariantId) {
	dcVariantRowIdx++;
	var rowIdx = dcVariantRowIdx;
	var isDefault = variant.variant_id == defaultVariantId;
	var isActive = variant.status == 1;
	var image = variant.image || '';
	var thumb = variant.thumb || '{{ placeholder|e("js") }}';
	var variantId = variant.variant_id || 0;
	var isNew = variantId === 0;
	var optionValues = {};
	var cgHasPrices = variant.customer_group_prices && variant.customer_group_prices.length;
	var hasArticles = variant.upc || variant.ean || variant.mpn;
	var hasSpecials = variant.variant_specials && variant.variant_specials.length;
	var articlesVisible = hasArticles;
	var cgVisible = cgHasPrices;
	var specialsVisible = hasSpecials;
	var subrowVisible = articlesVisible || cgVisible || specialsVisible;
	var artBtnClass = articlesVisible ? 'btn-primary' : 'btn-default';
	var cgBtnClass = cgVisible ? 'btn-primary' : 'btn-default';
	var specialBtnClass = specialsVisible ? 'btn-primary' : 'btn-default';

	if (variant.values) {
		for (var j = 0; j < variant.values.length; j++) {
			optionValues[variant.values[j].option_id] = variant.values[j].option_value_id;
		}
	}

	var rowClasses = 'dc-state-clean';
	if (isNew) rowClasses += ' dc-new';
	if (!isActive) rowClasses += ' dc-disabled';

	var html = '<tr id="dc-variant-row-' + rowIdx + '" class="' + rowClasses + '" data-variant-id="' + variantId + '" data-row-idx="' + rowIdx + '">';

	for (var a = 0; a < axes.length; a++) {
		var axeOptionId = axes[a].option_id;
		html += '<td><select class="form-control input-sm dc-variant-value" data-option-id="' + axeOptionId + '" onchange="onVariantAxisChange(' + rowIdx + ')">';
		html += '<option value="">{{ text_select|e("js") }}</option>';

		for (var k in axes[a].values) {
			var ovId = axes[a].values[k].option_value_id;
			var ovName = axes[a].values[k].name;
			var selected = (optionValues[axeOptionId] == ovId) ? ' selected="selected"' : '';
			html += '<option value="' + ovId + '"' + selected + '>' + ovName + '</option>';
		}

		html += '</select></td>';
	}

	html += '<td><div style="display:flex;gap:4px;align-items:center"><input type="text" class="form-control input-sm dc-variant-sku" value="' + (variant.sku || '') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:90px;flex:1"/><button type="button" class="btn ' + artBtnClass + ' btn-xs dc-articles-toggle" onclick="toggleVariantArticles(' + rowIdx + ')" title="{{ entry_variant_articles|e("js") }}"><i class="fa fa-barcode"></i></button></div></td>';
	html += '<td><div style="display:flex;gap:4px;align-items:center"><input type="number" step="0.0001" class="form-control input-sm dc-variant-price" value="' + (variant.price || '0') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:80px;flex:1"/><button type="button" class="btn ' + cgBtnClass + ' btn-xs dc-cg-toggle" onclick="toggleVariantCgPrices(' + rowIdx + ')" title="{{ entry_cg_prices|e("js") }}"><i class="fa fa-users"></i></button><button type="button" class="btn ' + specialBtnClass + ' btn-xs dc-special-toggle" onclick="toggleVariantSpecials(' + rowIdx + ')" title="{{ entry_special|e("js") }}"><i class="fa fa-star"></i></button></div></td>';
	html += '<td><input type="number" step="0.01" class="form-control input-sm dc-variant-qty" value="' + (variant.quantity || '0') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:70px"/></td>';
	html += '<td><input type="number" step="0.001" class="form-control input-sm dc-variant-weight" value="' + (variant.weight || '') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:70px"/></td>';
	html += '<td>';
	html += '<div style="position:relative;width:50px;height:50px;display:inline-block">';
	html += '<a href="" id="dc-variant-thumb-' + rowIdx + '" style="margin:0;display:block" onclick="openVariantImagePicker(' + rowIdx + '); return false">';
	html += '<img src="' + thumb + '" data-placeholder="{{ placeholder|e("js") }}" style="width:50px;height:50px;object-fit:cover;border-radius:4px;border:1px solid #ddd"/>';
	html += '</a>';
	html += '<button type="button" class="dc-img-remove" onclick="clearVariantImage(' + rowIdx + ')" title="{{ button_remove|e("js") }}"><i class="fa fa-times"></i></button>';
	html += '<input type="hidden" class="dc-variant-image" id="dc-variant-input-' + rowIdx + '" value="' + image + '"/>';
	html += '</div>';
	html += '</td>';
	html += '<td class="text-center"><button type="button" class="dc-star-btn' + (isDefault ? ' dc-star-active' : '') + '" onclick="onVariantStarClick(' + rowIdx + ')" title="{{ column_default|e("js") }}"><i class="fa ' + (isDefault ? 'fa-star' : 'fa-star-o') + '"></i></button></td>';
	html += '<td class="text-center"><label class="dc-toggle"><input type="checkbox" class="dc-variant-status"' + (isActive ? ' checked="checked"' : '') + ' onchange="onVariantStatusChange(' + rowIdx + ')"/><span class="dc-toggle-slider"></span></label></td>';
	html += '<td class="text-center">';
	html += '<button type="button" class="btn btn-danger btn-sm" onclick="deleteVariant(' + rowIdx + ')" title="{{ column_action|e("js") }}"><i class="fa fa-trash"></i></button>';
	html += '</td>';
	html += '</tr>';

	html += '<tr id="dc-variant-cg-row-' + rowIdx + '" class="dc-variant-cg-subrow" style="display:' + (subrowVisible ? '' : 'none') + '">';
	html += '<td colspan="' + (axes.length + 8) + '">';
	html += '<div class="dc-cg-inner">';
	html += '<div class="dc-subrow-split">';

	html += '<div class="dc-subrow-section dc-articles-section" id="dc-articles-section-' + rowIdx + '" style="display:' + (articlesVisible ? 'block' : 'none') + '">';
	html += '<div class="dc-subrow-section-label"><i class="fa fa-barcode"></i> {{ entry_variant_articles|e("js") }}</div>';
	html += '<div class="dc-subrow-fields">';
	html += '<label><span>{{ entry_upc|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-upc" value="' + (variant.upc || '') + '" placeholder="UPC" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span>{{ entry_ean|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-ean" value="' + (variant.ean || '') + '" placeholder="EAN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span>{{ entry_mpn|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-mpn" value="' + (variant.mpn || '') + '" placeholder="MPN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '</div>';
	html += '</div>';

	html += '<div class="dc-subrow-section dc-cg-section" id="dc-cg-section-' + rowIdx + '" style="display:' + (cgVisible ? 'block' : 'none') + '">';
	html += '<div class="dc-subrow-section-label"><i class="fa fa-users"></i> {{ entry_cg_prices|e("js") }}</div>';
	html += '<div class="dc-cg-header">';
	html += '<span class="dc-cg-header-group">{{ entry_cg_customer_group|e("js") }}</span>';
	html += '<span class="dc-cg-header-price">{{ entry_cg_group_price|e("js") }}</span>';
	html += '<span class="dc-cg-header-action"></span>';
	html += '</div>';
	html += '<div class="dc-cg-prices" id="dc-cg-prices-' + rowIdx + '">';

	if (variant.customer_group_prices) {
		for (var c = 0; c < variant.customer_group_prices.length; c++) {
			var cg = variant.customer_group_prices[c];
			html += '<div class="dc-cg-row">';
			html += '<select class="form-control input-sm dc-cg-group" onchange="scheduleAutoSave(' + rowIdx + ')">';
			{% for customer_group in customer_groups %}
			html += '<option value="{{ customer_group.customer_group_id }}"' + ({{ customer_group.customer_group_id }} == cg.customer_group_id ? ' selected="selected"' : '') + '>{{ customer_group.name|escape("js") }}</option>';
			{% endfor %}
			html += '</select>';
			html += '<input type="number" step="0.0001" class="form-control input-sm dc-cg-price" value="' + (cg.price || '') + '" placeholder="{{ entry_price|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')"/>';
			html += '<button type="button" class="btn btn-danger btn-xs" onclick="$(this).closest(\'.dc-cg-row\').remove();scheduleAutoSave(' + rowIdx + ')"><i class="fa fa-minus-circle"></i></button>';
			html += '</div>';
		}
	}

	html += '</div>';
	html += '<button type="button" class="btn btn-primary btn-xs dc-cg-add-btn" onclick="addVariantCgPrice(' + rowIdx + ')"><i class="fa fa-plus-circle"></i> {{ button_cg_add|e("js") }}</button>';
	html += '</div>';

	html += '<div class="dc-subrow-section dc-special-section" id="dc-special-section-' + rowIdx + '" style="display:' + (specialsVisible ? 'block' : 'none') + '">';
	html += '<div class="dc-subrow-section-label"><i class="fa fa-star"></i> {{ entry_special|e("js") }}</div>';
	html += '<div class="dc-special-header">';
	html += '<span class="dc-special-header-group">{{ entry_cg_customer_group|e("js") }}</span>';
	html += '<span class="dc-special-header-priority">{{ entry_priority|e("js") }}</span>';
	html += '<span class="dc-special-header-price">{{ entry_price|e("js") }}</span>';
	html += '<span class="dc-special-header-date">{{ entry_date_start|e("js") }}</span>';
	html += '<span class="dc-special-header-date">{{ entry_date_end|e("js") }}</span>';
	html += '<span class="dc-special-header-renew">{{ entry_auto_renew|e("js") }}</span>';
	html += '<span class="dc-special-header-action"></span>';
	html += '</div>';
	html += '<div class="dc-special-prices" id="dc-special-prices-' + rowIdx + '">';

	if (variant.variant_specials) {
		for (var s = 0; s < variant.variant_specials.length; s++) {
			var sp = variant.variant_specials[s];
			html += '<div class="dc-special-row">';
			html += '<select class="form-control input-sm dc-special-group" onchange="scheduleAutoSave(' + rowIdx + ')">';
			{% for customer_group in customer_groups %}
			html += '<option value="{{ customer_group.customer_group_id }}"' + ({{ customer_group.customer_group_id }} == sp.customer_group_id ? ' selected="selected"' : '') + '>{{ customer_group.name|escape("js") }}</option>';
			{% endfor %}
			html += '</select>';
			html += '<input type="number" step="0.0001" class="form-control input-sm dc-special-priority" value="' + (sp.priority || '1') + '" placeholder="{{ entry_priority|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:55px"/>';
			html += '<input type="number" step="0.0001" class="form-control input-sm dc-special-price" value="' + (sp.price || '') + '" placeholder="{{ entry_price|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:100px"/>';
			html += '<input type="date" class="form-control input-sm dc-special-date-start" value="' + (sp.date_start && sp.date_start != '0000-00-00' ? sp.date_start : '') + '" placeholder="{{ entry_date_start|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:120px"/>';
			html += '<input type="date" class="form-control input-sm dc-special-date-end" value="' + (sp.date_end && sp.date_end != '0000-00-00' ? sp.date_end : '') + '" placeholder="{{ entry_date_end|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:120px"/>';
			html += '<input type="checkbox" class="dc-special-auto-renew"' + (sp.auto_renew ? ' checked="checked"' : '') + ' onchange="scheduleAutoSave(' + rowIdx + ')"/>';
			html += '<button type="button" class="btn btn-danger btn-xs" onclick="$(this).closest(\'.dc-special-row\').remove();scheduleAutoSave(' + rowIdx + ')"><i class="fa fa-minus-circle"></i></button>';
			html += '</div>';
		}
	}

	html += '</div>';
	html += '<button type="button" class="btn btn-primary btn-xs dc-special-add-btn" onclick="addVariantSpecialRow(' + rowIdx + ')"><i class="fa fa-plus-circle"></i> {{ button_special_add|e("js") }}</button>';
	html += '</div>';

	html += '</div>';
	html += '</div></td></tr>';

	return html;
}

function addVariantRow(productId) {
	var axes = dcCurrentAxes;
	if (!axes || !axes.length) return;

	var rowIdx = ++dcVariantRowIdx;
	var html = '<tr id="dc-variant-row-' + rowIdx + '" class="dc-state-dirty dc-new" data-variant-id="0" data-row-idx="' + rowIdx + '">';

	for (var a = 0; a < axes.length; a++) {
		html += '<td><select class="form-control input-sm dc-variant-value" data-option-id="' + axes[a].option_id + '" onchange="onVariantAxisChange(' + rowIdx + ')"><option value="">{{ text_select|e("js") }}</option></select></td>';
	}

	html += '<td><div style="display:flex;gap:4px;align-items:center"><input type="text" class="form-control input-sm dc-variant-sku" value="" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:90px;flex:1"/><button type="button" class="btn btn-default btn-xs dc-articles-toggle" onclick="toggleVariantArticles(' + rowIdx + ')" title="{{ entry_variant_articles|e("js") }}"><i class="fa fa-barcode"></i></button></div></td>';
	html += '<td><div style="display:flex;gap:4px;align-items:center"><input type="number" step="0.0001" class="form-control input-sm dc-variant-price" value="0" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:80px;flex:1"/><button type="button" class="btn btn-default btn-xs dc-cg-toggle" onclick="toggleVariantCgPrices(' + rowIdx + ')" title="{{ entry_cg_prices|e("js") }}"><i class="fa fa-users"></i></button></div></td>';
	html += '<td><input type="number" step="0.01" class="form-control input-sm dc-variant-qty" value="0" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:70px"/></td>';
	html += '<td><input type="number" step="0.001" class="form-control input-sm dc-variant-weight" value="" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:70px"/></td>';
	html += '<td>';
	html += '<div style="position:relative;width:50px;height:50px;display:inline-block">';
	html += '<a href="" id="dc-variant-thumb-' + rowIdx + '" style="margin:0;display:block" onclick="openVariantImagePicker(' + rowIdx + '); return false">';
	html += '<img src="{{ placeholder|e("js") }}" data-placeholder="{{ placeholder|e("js") }}" style="width:50px;height:50px;object-fit:cover;border-radius:4px;border:1px solid #ddd"/>';
	html += '</a>';
	html += '<button type="button" class="dc-img-remove" onclick="clearVariantImage(' + rowIdx + ')" title="{{ button_remove|e("js") }}"><i class="fa fa-times"></i></button>';
	html += '<input type="hidden" class="dc-variant-image" id="dc-variant-input-' + rowIdx + '" value=""/>';
	html += '</div>';
	html += '</td>';
	html += '<td class="text-center"><button type="button" class="dc-star-btn" onclick="onVariantStarClick(' + rowIdx + ')" title="{{ column_default|e("js") }}"><i class="fa fa-star-o"></i></button></td>';
	html += '<td class="text-center"><label class="dc-toggle"><input type="checkbox" class="dc-variant-status" checked="checked" onchange="onVariantStatusChange(' + rowIdx + ')"/><span class="dc-toggle-slider"></span></label></td>';
	html += '<td class="text-center">';
	html += '<button type="button" class="btn btn-danger btn-sm" onclick="deleteVariant(' + rowIdx + ')" title="{{ column_action|e("js") }}"><i class="fa fa-trash"></i></button>';
	html += '</td>';
	html += '</tr>';

	html += '<tr id="dc-variant-cg-row-' + rowIdx + '" class="dc-variant-cg-subrow" style="display:none">';
	html += '<td colspan="' + (axes.length + 8) + '">';
	html += '<div class="dc-cg-inner">';
	html += '<div class="dc-subrow-split">';

	html += '<div class="dc-subrow-section dc-articles-section" id="dc-articles-section-' + rowIdx + '" style="display:none">';
	html += '<div class="dc-subrow-section-label"><i class="fa fa-barcode"></i> {{ entry_variant_articles|e("js") }}</div>';
	html += '<div class="dc-subrow-fields">';
	html += '<label><span>{{ entry_upc|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-upc" value="" placeholder="UPC" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span>{{ entry_ean|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-ean" value="" placeholder="EAN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span>{{ entry_mpn|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-mpn" value="" placeholder="MPN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '</div>';
	html += '</div>';

	html += '<div class="dc-subrow-section dc-cg-section" id="dc-cg-section-' + rowIdx + '" style="display:none">';
	html += '<div class="dc-subrow-section-label"><i class="fa fa-users"></i> {{ entry_cg_prices|e("js") }}</div>';
	html += '<div class="dc-cg-header">';
	html += '<span class="dc-cg-header-group">{{ entry_cg_customer_group|e("js") }}</span>';
	html += '<span class="dc-cg-header-price">{{ entry_cg_group_price|e("js") }}</span>';
	html += '<span class="dc-cg-header-action"></span>';
	html += '</div>';
	html += '<div class="dc-cg-prices" id="dc-cg-prices-' + rowIdx + '"></div>';
	html += '<button type="button" class="btn btn-primary btn-xs dc-cg-add-btn" onclick="addVariantCgPrice(' + rowIdx + ')"><i class="fa fa-plus-circle"></i> {{ button_cg_add|e("js") }}</button>';
	html += '</div>';

	html += '</div>';
	html += '</div></td></tr>';

	$('#dc-variant-tbody').prepend(html);
	loadAxesOptionValues(rowIdx, productId);
	updateRowCount();
}

function loadAxesOptionValues(rowIdx, productId) {
	dcAxesLoading[rowIdx] = true;
	$('#dc-variant-row-' + rowIdx + ' .dc-variant-value').first().after('<span class="dc-loading-indicator"><i class="fa fa-spinner fa-spin"></i></span>');

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId,
		dataType: 'json',
		success: function(json) {
			dcAxesLoading[rowIdx] = false;
			$('#dc-variant-row-' + rowIdx + ' .dc-loading-indicator').remove();

			if (json.configurable_options) {
				var selects = $('#dc-variant-row-' + rowIdx + ' .dc-variant-value');
				selects.each(function(i) {
					var sel = $(this);
					var axe = json.configurable_options[i];

					if (axe) {
						sel.data('option-id', axe.option_id);
						sel.empty();
						sel.append('<option value="">{{ text_select|e("js") }}</option>');

						for (var k in axe.values) {
							sel.append('<option value="' + axe.values[k].option_value_id + '">' + axe.values[k].name + '</option>');
						}
					}
				});
			}
		},
		error: function() {
			dcAxesLoading[rowIdx] = false;
			$('#dc-variant-row-' + rowIdx + ' .dc-loading-indicator').remove();
		}
	});
}

function onVariantAxisChange(rowIdx) {
	scheduleAutoSave(rowIdx);
}

function onVariantFieldInput(rowIdx) {
	scheduleAutoSave(rowIdx);
}

function toggleVariantArticles(rowIdx) {
	var section = $('#dc-articles-section-' + rowIdx);
	var btn = $('#dc-variant-row-' + rowIdx).find('.dc-articles-toggle');
	var subrow = $('#dc-variant-cg-row-' + rowIdx);
	section.toggle();
	btn.toggleClass('btn-default btn-primary');
	var sectionVisible = section.css('display') !== 'none';
	var cgVisible = $('#dc-cg-section-' + rowIdx).css('display') !== 'none';
	var specialsVisible = $('#dc-special-section-' + rowIdx).css('display') !== 'none';
	subrow.css('display', (sectionVisible || cgVisible || specialsVisible) ? 'table-row' : 'none');
}

function toggleVariantCgPrices(rowIdx) {
	var section = $('#dc-cg-section-' + rowIdx);
	var btn = $('#dc-variant-row-' + rowIdx).find('.dc-cg-toggle');
	var subrow = $('#dc-variant-cg-row-' + rowIdx);
	section.toggle();
	btn.toggleClass('btn-default btn-primary');
	var cgVisible = section.css('display') !== 'none';
	var articlesVisible = $('#dc-articles-section-' + rowIdx).css('display') !== 'none';
	var specialsVisible = $('#dc-special-section-' + rowIdx).css('display') !== 'none';
	subrow.css('display', (cgVisible || articlesVisible || specialsVisible) ? 'table-row' : 'none');
}

function toggleVariantSpecials(rowIdx) {
	var section = $('#dc-special-section-' + rowIdx);
	var btn = $('#dc-variant-row-' + rowIdx).find('.dc-special-toggle');
	var subrow = $('#dc-variant-cg-row-' + rowIdx);
	section.toggle();
	btn.toggleClass('btn-default btn-primary');
	var specialsVisible = section.css('display') !== 'none';
	var articlesVisible = $('#dc-articles-section-' + rowIdx).css('display') !== 'none';
	var cgVisible = $('#dc-cg-section-' + rowIdx).css('display') !== 'none';
	subrow.css('display', (specialsVisible || articlesVisible || cgVisible) ? 'table-row' : 'none');
}

function addVariantCgPrice(rowIdx) {
	var html = '<div class="dc-cg-row">';
	html += '<select class="form-control input-sm dc-cg-group" onchange="scheduleAutoSave(' + rowIdx + ')">';
	{% for customer_group in customer_groups %}
	html += '<option value="{{ customer_group.customer_group_id }}">{{ customer_group.name|escape("js") }}</option>';
	{% endfor %}
	html += '</select>';
	html += '<input type="number" step="0.0001" class="form-control input-sm dc-cg-price" placeholder="{{ entry_price|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')"/>';
	html += '<button type="button" class="btn btn-danger btn-xs" onclick="$(this).closest(\'.dc-cg-row\').remove();scheduleAutoSave(' + rowIdx + ')"><i class="fa fa-minus-circle"></i></button>';
	html += '</div>';
	$('#dc-cg-prices-' + rowIdx).append(html);
}

function addVariantSpecialRow(rowIdx) {
	var html = '<div class="dc-special-row">';
	html += '<select class="form-control input-sm dc-special-group" onchange="scheduleAutoSave(' + rowIdx + ')">';
	{% for customer_group in customer_groups %}
	html += '<option value="{{ customer_group.customer_group_id }}">{{ customer_group.name|escape("js") }}</option>';
	{% endfor %}
	html += '</select>';
	html += '<input type="number" step="0.0001" class="form-control input-sm dc-special-priority" value="1" placeholder="{{ entry_priority|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:55px"/>';
	html += '<input type="number" step="0.0001" class="form-control input-sm dc-special-price" placeholder="{{ entry_price|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:100px"/>';
	html += '<input type="date" class="form-control input-sm dc-special-date-start" placeholder="{{ entry_date_start|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:120px"/>';
	html += '<input type="date" class="form-control input-sm dc-special-date-end" placeholder="{{ entry_date_end|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')" style="width:120px"/>';
	html += '<input type="checkbox" class="dc-special-auto-renew" onchange="scheduleAutoSave(' + rowIdx + ')"/>';
	html += '<button type="button" class="btn btn-danger btn-xs" onclick="$(this).closest(\'.dc-special-row\').remove();scheduleAutoSave(' + rowIdx + ')"><i class="fa fa-minus-circle"></i></button>';
	html += '</div>';
	$('#dc-special-prices-' + rowIdx).append(html);
}

function onVariantStatusChange(rowIdx) {
	if (dcSaveTimers[rowIdx]) {
		clearTimeout(dcSaveTimers[rowIdx]);
		delete dcSaveTimers[rowIdx];
	}
	saveVariantRow(rowIdx);
}

function onVariantStarClick(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var vid = parseInt(row.data('variant-id')) || 0;

	if (!vid) {
		showToast('{{ text_saving|e("js") }}: {{ text_save_product_first|e("js") }}', 'error');
		return;
	}

	setDefaultVariant(rowIdx);
}

function scheduleAutoSave(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var state = row.data('state');
	if (state === 'saving' || state === 'new-loading') {
		row.data('pending', true);
		return;
	}
	if (dcAxesLoading[rowIdx]) return;

	row.data('state', 'dirty').removeClass('dc-state-clean dc-state-saving dc-state-error dc-state-flash').addClass('dc-state-dirty');

	if (dcSaveTimers[rowIdx]) {
		clearTimeout(dcSaveTimers[rowIdx]);
	}

	dcSaveTimers[rowIdx] = setTimeout(function() {
		delete dcSaveTimers[rowIdx];
		saveVariantRow(rowIdx);
	}, 600);
}

function saveVariantRow(rowIdx, onSuccess) {
	var row = $('#dc-variant-row-' + rowIdx);
	var pid = getDcProductId();
	var vid = parseInt(row.data('variant-id')) || 0;
	var values = [];
	var allSelected = true;

	row.find('.dc-variant-value').each(function() {
		var ovId = $(this).val();
		var oId = $(this).data('option-id') || 0;

		if (!ovId) {
			allSelected = false;
		} else {
			values.push({
				option_id: oId,
				option_value_id: ovId
			});
		}
	});

	if (!allSelected) {
		row.find('.dc-variant-value').each(function() {
			if (!$(this).val()) {
				$(this).addClass('dc-field-error');
				(function(el) {
					setTimeout(function() { el.removeClass('dc-field-error'); }, 2000);
				})($(this));
			}
		});
		return;
	}

	row.data('state', 'saving').removeClass('dc-state-dirty dc-state-error dc-state-flash').addClass('dc-state-saving');

	var cgRow = $('#dc-variant-cg-row-' + rowIdx);
	var data = {
		product_id: pid,
		variant_id: vid,
		sku: row.find('.dc-variant-sku').val() || '',
		upc: cgRow.find('.dc-variant-upc').val() || '',
		ean: cgRow.find('.dc-variant-ean').val() || '',
		mpn: cgRow.find('.dc-variant-mpn').val() || '',
		price: row.find('.dc-variant-price').val() || 0,
		quantity: row.find('.dc-variant-qty').val() || 0,
		subtract: 1,
		weight: row.find('.dc-variant-weight').val() || 0,
		weight_class_id: {{ weight_class_id|e("js") }},
		image: row.find('.dc-variant-image').val() || '',
		sort_order: 0,
		status: row.find('.dc-variant-status').is(':checked') ? 1 : 0,
		values: values
	};

	var cgPrices = [];
	$('#dc-cg-prices-' + rowIdx + ' .dc-cg-row').each(function() {
		var groupId = $(this).find('.dc-cg-group').val();
		var price = $(this).find('.dc-cg-price').val();
		if (groupId && price !== '' && price !== undefined) {
			cgPrices.push({customer_group_id: groupId, price: price});
		}
	});
	data.customer_group_prices = cgPrices;

	var specialPrices = [];
	$('#dc-special-prices-' + rowIdx + ' .dc-special-row').each(function() {
		var groupId = $(this).find('.dc-special-group').val();
		var price = $(this).find('.dc-special-price').val();
		var priority = $(this).find('.dc-special-priority').val();
		var dateStart = $(this).find('.dc-special-date-start').val();
		var dateEnd = $(this).find('.dc-special-date-end').val();
		var autoRenew = $(this).find('.dc-special-auto-renew').is(':checked') ? 1 : 0;
		if (groupId && price !== '' && price !== undefined) {
			specialPrices.push({
				customer_group_id: groupId,
				price: price,
				priority: priority || 1,
				date_start: dateStart || '0000-00-00',
				date_end: dateEnd || '0000-00-00',
				auto_renew: autoRenew
			});
		}
	});
	data.variant_specials = specialPrices;

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariant&user_token={{ user_token }}',
		type: 'POST',
		data: data,
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				row.data('state', 'error').removeClass('dc-state-saving dc-state-dirty dc-state-flash').addClass('dc-state-error');
				showToast(json.error, 'error');
			} else {
				if (vid === 0 && json.variant_id) {
					row.data('variant-id', json.variant_id);
				}
				row.removeClass('dc-new dc-state-saving dc-state-dirty dc-state-error').addClass('dc-state-flash');
				row.data('state', 'clean');

				if (row.data('pending')) {
					row.data('pending', false);
					showToast('{{ text_saved|e("js") }}', 'success');
					setTimeout(function() {
						row.removeClass('dc-state-flash');
					}, 1500);
					saveVariantRow(rowIdx, onSuccess);
					return;
				}

				showToast('{{ text_saved|e("js") }}', 'success');

				var status = row.find('.dc-variant-status').is(':checked') ? 1 : 0;
				if (status) {
					row.removeClass('dc-disabled');
				} else {
					row.addClass('dc-disabled');
				}

				setTimeout(function() {
					row.removeClass('dc-state-flash');
				}, 1500);

				if (typeof onSuccess === 'function') {
					onSuccess();
				}
			}
		},
		error: function() {
			row.data('state', 'error').removeClass('dc-state-saving dc-state-flash').addClass('dc-state-error');
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function setDefaultVariant(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var vid = parseInt(row.data('variant-id')) || 0;
	if (!vid) return;

	var prevDefault = dcCurrentDefaultId;
	dcCurrentDefaultId = vid;

	$('.dc-star-btn').removeClass('dc-star-active').find('i').removeClass('fa-star').addClass('fa-star-o');
	row.find('.dc-star-btn').addClass('dc-star-active').find('i').removeClass('fa-star-o').addClass('fa-star');

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setDefault&user_token={{ user_token }}',
		type: 'POST',
		data: {variant_id: vid},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				dcCurrentDefaultId = prevDefault;
				rebuildDefaultStars();
				showToast(json.error, 'error');
			} else {
				showToast('{{ text_saved|e("js") }}', 'success', 1500);
			}
		},
		error: function() {
			dcCurrentDefaultId = prevDefault;
			rebuildDefaultStars();
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function rebuildDefaultStars() {
	$('.dc-star-btn').each(function() {
		var $btn = $(this);
		var $row = $btn.closest('tr');
		var vid = parseInt($row.data('variant-id')) || 0;
		if (vid == dcCurrentDefaultId) {
			$btn.addClass('dc-star-active').find('i').removeClass('fa-star-o').addClass('fa-star');
		} else {
			$btn.removeClass('dc-star-active').find('i').removeClass('fa-star').addClass('fa-star-o');
		}
	});
}

function deleteVariant(rowIdx) {
	var row = $('#dc-variant-row-' + rowIdx);
	var vid = parseInt(row.data('variant-id')) || 0;
	var pid = getDcProductId();

	if (!vid) {
		row.fadeOut(200, function() {
			$(this).remove();
			updateRowCount();
		});
		return;
	}

	if (!confirm('{{ text_confirm_delete_variant|e("js") }}')) {
		return;
	}

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/deleteVariant&user_token={{ user_token }}',
		type: 'POST',
		data: {variant_id: vid},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
			} else {
				row.fadeOut(200, function() {
					$(this).remove();
					updateRowCount();
				});

				if (json.default_variant_id !== undefined) {
					dcCurrentDefaultId = json.default_variant_id;
					rebuildDefaultStars();
				}

				showToast('{{ text_saved|e("js") }}', 'success', 1500);
			}
		},
		error: function() {
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function generateVariants(productId) {
	if (!confirm('{{ text_confirm_generate|e("js") }}')) {
		return;
	}

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/generate&user_token={{ user_token }}',
		type: 'POST',
		data: {product_id: productId},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
			} else {
				showToast(json.success, 'success');
				loadVariantMatrix();
			}
		},
		error: function() {
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function openVariantImagePicker(rowIdx) {
	var $input = $('#dc-variant-input-' + rowIdx);
	var originalValue = $input.val();

	$('#modal-image').remove();

	$.ajax({
		url: 'index.php?route=common/filemanager&user_token=' + getURLVar('user_token') + '&target=dc-variant-input-' + rowIdx + '&thumb=dc-variant-thumb-' + rowIdx + '&type=image',
		dataType: 'html',
		success: function(html) {
			$('body').append('<div id="modal-image" class="modal">' + html + '</div>');
			$('#modal-image').modal('show');
			$('#modal-image').on('hidden.bs.modal', function() {
				if ($input.val() !== originalValue) {
					scheduleAutoSave(rowIdx);
				}
				$('#modal-image').off('hidden.bs.modal');
			});
		}
	});
}

function clearVariantImage(rowIdx) {
	var $input = $('#dc-variant-input-' + rowIdx);
	var placeholder = '{{ placeholder|e("js") }}';

	if (!$input.val()) {
		return;
	}

	$('#dc-variant-thumb-' + rowIdx).find('img').attr('src', placeholder);
	$input.val('');
	scheduleAutoSave(rowIdx);
}

function updateRowCount() {
	var count = $('#dc-variant-tbody tr').length;
	$('#dc-variant-count').text('(' + count + ')');
}

$(window).on('beforeunload', function() {
	if ($('#dc-variant-tbody').find('tr.dc-state-dirty, tr.dc-state-saving').length) {
		return '{{ text_unsaved_changes|e("js") }}';
	}
});
//--></script>

<style>
