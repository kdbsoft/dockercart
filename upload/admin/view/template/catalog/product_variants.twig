<div id="dc-variant-axes-section" style="display:none;margin-bottom:20px"></div>
<div id="dc-variant-matrix-section" style="display:none"></div>
<div id="dc-variant-container">
	<div class="text-center"><span class="dc-spinner dc-spinner--lg"></span></div>
</div>
<div id="dc-variant-toasts"></div>

<script type="text/javascript"><!--
var dcVariantRowIdx = 0;
var dcSaveTimers = {};
var dcAxesLoading = {};
var dcCurrentDefaultId = 0;
var dcCurrentAxes = [];

function getDcProductId() {
	var matches = /[&?]product_id=(\d+)/.exec(window.location.href);
	return matches ? matches[1] : '0';
}

function showToast(msg, type, dur) {
	var $container = $('#dc-variant-toasts');
	var cls = type === 'error' ? 'dc-toast-error' : 'dc-toast-success';
	var icon = type === 'error' ? 'circle-alert' : 'circle-check';
	var $toast = $('<div class="dc-toast ' + cls + '"><i data-lucide="' + icon + '"></i> ' + msg + '</div>');
	$container.append($toast);
	lucide.createIcons({ nodes: [$toast[0]] });
	$toast.hide().fadeIn(200);
	if (type !== 'error' || dur) {
		setTimeout(function() {
			$toast.fadeOut(300, function() { $toast.remove(); });
		}, dur || 2500);
	} else {
		$toast.on('click', function() {
			$toast.fadeOut(200, function() { $toast.remove(); });
		});
	}
	var $toasts = $container.children();
	if ($toasts.length > 5) {
		$toasts.first().fadeOut(200, function() { $(this).remove(); });
	}
}

function loadVariantMatrix() {
	var productId = getDcProductId();
	var container = $('#dc-variant-container');

	if (!productId || productId == '0') {
		container.html('<div class="alert alert-info">{{ text_save_product_first|e("js") }}</div>');
		$('#dc-variant-axes-section').hide();
		$('#dc-variant-matrix-section').hide();
		return;
	}

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId,
		dataType: 'json',
		beforeSend: function() {
			container.html('<div class="text-center"><span class="dc-spinner dc-spinner--lg"></span></div>');
		},
		success: function(json) {
			container.html('');

			if (json.error) {
				container.html('<div class="alert alert-danger">' + json.error + '</div>');
				return;
			}

			dcCurrentDefaultId = json.default_variant_id || 0;
			renderVariantMatrix(productId, json);
			renderAxesSelector(productId, json);

			var axes = json.configurable_options || [];
			dcAxisOptionIds = axes.map(function(a) { return parseInt(a.option_id); });
		},
		error: function() {
			container.html('<div class="alert alert-danger">{{ text_load_error|e("js") }}</div>');
		}
	});
}

function renderAxesSelector(productId, json) {
	var section = $('#dc-variant-axes-section');
	var axes = json.configurable_options || [];

	section.show();

	var html = '<label>{{ entry_configurable_axes|e("js") }}</label>';
	html += '<div class="dc-opt-add-tree" style="display:inline-block; min-width:300px; margin-left:10px;">';
	html += '<div class="dcx-tree-select"';
	html += '     data-url="index.php?route=catalog/option/tree&user_token={{ user_token }}"';
	html += '     data-id-key="option_id"';
	html += '     data-none-text="{{ text_none }}"';
	html += '     data-placeholder="{{ entry_select_option|e("js") }}">';
	html += '  <div class="dcx-tree-select__input-wrap">';
	html += '    <input type="text" class="dcx-tree-select__input form-control input-sm" placeholder="{{ entry_select_option|e("js") }}" tabindex="-1" />';
	html += '    <input type="hidden" name="configurable_option_id" value="" />';
	html += '    <span class="dcx-tree-select__toggle"><i data-lucide="chevron-down" width="16" height="16"></i></span>';
	html += '  </div>';
	html += '  <div class="dcx-tree-select__dropdown">';
	html += '    <div class="dcx-tree-select__search">';
	html += '      <input type="text" class="form-control" placeholder="{{ entry_select_option|e("js") }}" />';
	html += '      <i data-lucide="search" width="14" height="14"></i>';
	html += '    </div>';
	html += '    <div class="dcx-tree-select__list"></div>';
	html += '  </div>';
	html += '</div>';
	html += '</div>';
	html += '<div class="dc-configurable-axes-list" id="dc-configurable-axes-list" style="margin-top:10px">';

	for (var i = 0; i < axes.length; i++) {
		html += '<div class="dc-axe-item" style="display:inline-block;margin-right:8px;margin-bottom:4px;padding:4px 8px;background:#f0f0f0;border-radius:3px" data-option-id="' + axes[i].option_id + '">';
		html += '<i data-lucide="grip-vertical" width="14" height="14"></i> ' + axes[i].name;
		html += ' <span class="text-muted">(' + axes[i].type + ')</span>';
		html += ' <button type="button" class="close" onclick="removeAxe(this, ' + productId + ', ' + axes[i].option_id + ')" style="font-size:16px;line-height:1">&times;</button>';
		html += '</div>';
	}

	html += '</div>';
	if (axes.length >= 3) {
		html += '<p class="text-muted" style="margin-top:6px;font-size:12px"><i data-lucide="info" width="12" height="12"></i> {{ text_max_axes_reached|e("js") }}</p>';
	}

	section.html(html);
	lucide.createIcons();

	if (axes.length >= 3) {
		section.find('.dc-opt-add-tree').hide();
	} else {
		DcxTreeSelect.init();
	}

	var $axisTree = section.find('.dcx-tree-select');
	if ($axisTree.length) {
		var inst = $axisTree.data('dcx-tree-select');
		if (inst && !inst.filterCallback) {
			inst.filterCallback = function(data) {
				var excludeIds = [];
				$('#dc-configurable-axes-list .dc-axe-item').each(function() {
					var id = parseInt($(this).data('option-id'));
					if (id) excludeIds.push(id);
				});
				$('#dc-options-container .dc-option-section:not(.dc-option-axis) input[name$="[option_id]"]').each(function() {
					var id = parseInt($(this).val());
					if (id) excludeIds.push(id);
				});
				return data.filter(function(item) {
					return excludeIds.indexOf(parseInt(item.category_id)) === -1;
				});
			};
		}

		$(document).off('change', '#dc-variant-axes-section input[name="configurable_option_id"]');
		$(document).on('change', '#dc-variant-axes-section input[name="configurable_option_id"]', function() {
			var optionId = parseInt($(this).val());
			if (!optionId || optionId <= 0) return;
			addConfigurableAxe(productId, optionId);
			$(this).val('');
			$axisTree.find('.dcx-tree-select__input').val('');
		});
	}
}

function addConfigurableAxe(productId, optionId) {
	var currentIds = [];
	$('#dc-configurable-axes-list .dc-axe-item').each(function() {
		var id = $(this).data('option-id');
		if (id) currentIds.push(id);
	});

	if (currentIds.indexOf(optionId) >= 0) {
		return;
	}

	if (currentIds.length >= 3) {
		showToast('{{ error_max_axes|e("js") }}', 'error');
		return;
	}

	var conflictSimple = false;
	$('#dc-options-container .dc-option-section:not(.dc-option-axis) input[name$="[option_id]"]').each(function() {
		if (parseInt($(this).val()) === optionId) {
			conflictSimple = true;
			return false;
		}
	});
	if (conflictSimple) {
		showToast('{{ error_axis_conflicts_simple|e("js") }}', 'error');
		return;
	}

	currentIds.push(optionId);

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setAxes&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: productId,
			option_ids: currentIds
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
				return;
			}

			loadVariantMatrix();
		}
	});
}

function removeAxe(btn, productId, optionId) {
	if (!confirm('{{ text_confirm_remove_axis|e("js") }}')) {
		return;
	}

	var currentIds = [];
	$('#dc-configurable-axes-list .dc-axe-item').each(function() {
		var id = $(this).data('option-id');
		if (id && id != optionId) currentIds.push(id);
	});

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/setAxes&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: productId,
			option_ids: currentIds
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				showToast(json.error, 'error');
				return;
			}

			loadVariantMatrix();
		}
	});
}

function renderVariantMatrix(productId, json) {
	var section = $('#dc-variant-matrix-section');
	var variants = json.variants || [];
	var axes = json.configurable_options || [];
	var isConfigurable = json.is_configurable;

	if (!axes.length) {
		section.html('<p class="text-muted">{{ text_no_axes|e("js") }}</p>').show();
		return;
	}

	dcCurrentAxes = axes;
	section.show();

	var html = '<h4>{{ text_variants|e("js") }} <small id="dc-variant-count">(' + variants.length + ')</small></h4>';
	html += '<div class="row" style="margin-bottom:12px">';
	html += '<div class="col-sm-12">';
	html += '<button type="button" class="btn btn-primary btn-sm" onclick="addVariantRow(' + productId + ')"><i data-lucide="plus"></i> {{ button_add_variant|e("js") }}</button>';
	html += ' <button type="button" class="btn btn-warning btn-sm" onclick="generateVariants(' + productId + ')" title="{{ help_generate|e("js") }}"><i data-lucide="wand-sparkles"></i> {{ button_generate|e("js") }}</button>';
	html += '</div></div>';
	html += '<div class="dc-variant-scroll-wrapper">';
	html += '<table class="table table-bordered table-hover dc-variant-table" id="dc-variant-table">';
	html += '<thead><tr>';

	html += '<th class="dc-col-sku dc-th-sku">{{ column_model|e("js") }}</th>';

	for (var a = 0; a < axes.length; a++) {
		html += '<th class="dc-th-axis">' + axes[a].name + '</th>';
	}

	html += '<th class="dc-th-price">{{ column_price|e("js") }}</th>';
	html += '<th class="dc-th-qty">{{ column_quantity|e("js") }}</th>';
	html += '<th class="dc-th-weight">{{ column_weight|e("js") }}</th>';
	html += '<th class="dc-th-image">{{ column_image|e("js") }}</th>';
	html += '<th class="dc-th-default text-center">{{ column_default|e("js") }}</th>';
	html += '<th class="dc-th-status text-center">{{ column_status|e("js") }}</th>';
	html += '<th class="dc-th-action text-center"></th>';
	html += '</tr></thead>';
	html += '<tbody id="dc-variant-tbody">';

	for (var v = 0; v < variants.length; v++) {
		html += buildVariantRow(productId, variants[v], axes, json.default_variant_id);
	}

	html += '</tbody>';
	html += '</table>';
	html += '</div>';

	section.html(html);
	lucide.createIcons();
}

function buildVariantRow(productId, variant, axes, defaultVariantId) {
	dcVariantRowIdx++;
	var rowIdx = dcVariantRowIdx;
	var isDefault = variant.variant_id == defaultVariantId;
	var isActive = variant.status == 1;
	var image = variant.image || '';
	var thumb = variant.thumb || '{{ placeholder|e("js") }}';
	var variantId = variant.variant_id || 0;
	var isNew = variantId === 0;
	var optionValues = {};
	var cgHasPrices = variant.customer_group_prices && variant.customer_group_prices.length;
	var hasArticles = variant.sku || variant.upc || variant.ean || variant.jan || variant.isbn || variant.mpn;
	var hasSpecials = variant.variant_specials && variant.variant_specials.length;
	var hasDiscounts = variant.variant_discounts && variant.variant_discounts.length;
	var articlesVisible = hasArticles;
	var cgVisible = cgHasPrices;
	var specialsVisible = hasSpecials;
	var discountsVisible = hasDiscounts;
	var subrowVisible = articlesVisible || cgVisible || specialsVisible || discountsVisible;
	var artBtnClass = articlesVisible ? 'btn-primary' : 'btn-default';
	var cgBtnClass = cgVisible ? 'btn-primary' : 'btn-default';
	var specialBtnClass = specialsVisible ? 'btn-primary' : 'btn-default';
	var discountBtnClass = discountsVisible ? 'btn-primary' : 'btn-default';

	if (variant.values) {
		for (var j = 0; j < variant.values.length; j++) {
			optionValues[variant.values[j].option_id] = variant.values[j].option_value_id;
		}
	}

	var rowClasses = 'dc-state-clean';
	if (isNew) rowClasses += ' dc-new';
	if (!isActive) rowClasses += ' dc-disabled';

	var html = '<tr id="dc-variant-row-' + rowIdx + '" class="' + rowClasses + '" data-variant-id="' + variantId + '" data-row-idx="' + rowIdx + '">';

	html += '<td class="dc-col-sku"><div style="display:flex;gap:4px;align-items:center"><input type="text" class="form-control input-sm dc-variant-model" value="' + (variant.model || '') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:90px"/><button type="button" class="btn ' + artBtnClass + ' btn-xs dc-articles-toggle" onclick="toggleVariantArticles(' + rowIdx + ')" title="{{ entry_variant_articles|e("js") }}"><i data-lucide="scan-line"></i></button></div></td>';

	for (var a = 0; a < axes.length; a++) {
		var axeOptionId = axes[a].option_id;
		html += '<td><select class="form-control input-sm dc-variant-value" data-option-id="' + axeOptionId + '" onchange="onVariantAxisChange(' + rowIdx + ')">';
		html += '<option value="">{{ text_select|e("js") }}</option>';

		for (var k in axes[a].values) {
			var ovId = axes[a].values[k].option_value_id;
			var ovName = axes[a].values[k].name;
			var selected = (optionValues[axeOptionId] == ovId) ? ' selected="selected"' : '';
			html += '<option value="' + ovId + '"' + selected + '>' + ovName + '</option>';
		}

		html += '</select></td>';
	}

	html += '<td><div style="display:flex;gap:4px;align-items:center"><input type="number" step="0.0001" class="form-control input-sm dc-variant-price" value="' + (variant.price || '0') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:80px"/><button type="button" class="btn ' + cgBtnClass + ' btn-xs dc-cg-toggle" onclick="toggleVariantCgPrices(' + rowIdx + ')" title="{{ entry_cg_prices|e("js") }}"><i data-lucide="users"></i></button><button type="button" class="btn ' + specialBtnClass + ' btn-xs dc-special-toggle" onclick="toggleVariantSpecials(' + rowIdx + ')" title="{{ entry_special|e("js") }}"><i data-lucide="star"></i></button></div></td>';
	html += '<td><input type="number" step="0.01" class="form-control input-sm dc-variant-qty" value="' + (variant.quantity || '0') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:70px"/></td>';
	html += '<td><input type="number" step="0.001" class="form-control input-sm dc-variant-weight" value="' + (variant.weight || '') + '" oninput="onVariantFieldInput(' + rowIdx + ')" style="min-width:70px"/></td>';
	html += '<td>';
	html += '<div style="position:relative;width:50px;height:50px;display:inline-block">';
	html += '<a href="" id="dc-variant-thumb-' + rowIdx + '" style="margin:0;display:block" onclick="openVariantImagePicker(' + rowIdx + '); return false">';
	html += '<img src="' + thumb + '" data-placeholder="{{ placeholder|e("js") }}" style="width:50px;height:50px;object-fit:cover;border-radius:4px;border:1px solid #ddd"/>';
	html += '</a>';
	html += '<button type="button" class="dc-img-remove" onclick="clearVariantImage(' + rowIdx + ')" title="{{ button_remove|e("js") }}"><i data-lucide="x"></i></button>';
	html += '<input type="hidden" class="dc-variant-image" id="dc-variant-input-' + rowIdx + '" value="' + image + '"/>';
	html += '</div>';
	html += '</td>';
	html += '<td class="text-center"><button type="button" class="dc-star-btn' + (isDefault ? ' dc-star-active' : '') + '" onclick="onVariantStarClick(' + rowIdx + ')" title="{{ column_default|e("js") }}"><i data-lucide="star"></i></button></td>';
	html += '<td class="text-center"><label class="dc-toggle"><input type="checkbox" class="dc-variant-status"' + (isActive ? ' checked="checked"' : '') + ' onchange="onVariantStatusChange(' + rowIdx + ')"/><span class="dc-toggle-slider"></span></label></td>';
	html += '<td class="text-center">';
	html += '<button type="button" class="btn btn-danger btn-sm" onclick="deleteVariant(' + rowIdx + ')"><i data-lucide="trash-2"></i></button>';
	html += '</td>';
	html += '</tr>';

	html += '<tr id="dc-variant-cg-row-' + rowIdx + '" class="dc-variant-cg-subrow" style="display:' + (subrowVisible ? '' : 'none') + '">';
	html += '<td colspan="' + (axes.length + 8) + '">';
	html += '<div class="dc-cg-inner">';

	html += '<div class="dc-subrow-tabs">';
	html += '<button type="button" class="dc-subrow-tab' + (articlesVisible ? ' dc-subrow-tab--active' : '') + '" data-tab="articles" data-row="' + rowIdx + '"><i data-lucide="scan-line"></i> {{ entry_variant_articles|e("js") }} <span class="dc-subrow-tab__badge" style="display:none"></span></button>';
	html += '<button type="button" class="dc-subrow-tab' + (cgVisible ? ' dc-subrow-tab--active' : '') + '" data-tab="cg" data-row="' + rowIdx + '"><i data-lucide="users"></i> {{ entry_cg_prices|e("js") }} <span class="dc-subrow-tab__badge" style="display:none"></span></button>';
	html += '<button type="button" class="dc-subrow-tab' + (specialsVisible ? ' dc-subrow-tab--active' : '') + '" data-tab="specials" data-row="' + rowIdx + '"><i data-lucide="star"></i> {{ entry_special|e("js") }} <span class="dc-subrow-tab__badge" style="display:none"></span></button>';
	html += '<button type="button" class="dc-subrow-tab' + (discountsVisible ? ' dc-subrow-tab--active' : '') + '" data-tab="discounts" data-row="' + rowIdx + '"><i data-lucide="percent"></i> {{ entry_discount|e("js") }} <span class="dc-subrow-tab__badge" style="display:none"></span></button>';
	html += '<button type="button" class="dc-subrow-close" onclick="closeSubrow(' + rowIdx + ')" title="{{ button_close|e("js") }}"><i data-lucide="x"></i></button>';
	html += '</div>';

	html += '<div class="dc-subrow-panel' + (articlesVisible ? ' dc-subrow-panel--active' : '') + '" id="dc-panel-articles-' + rowIdx + '"' + (articlesVisible ? '' : ' style="display:none"') + '>';
	html += '<div class="dc-subrow-fields">';
	html += '<label><span><i data-lucide="package" width="12" height="12"></i> {{ entry_sku|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-sku-article" value="' + (variant.sku || '') + '" placeholder="SKU" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span><i data-lucide="scan-line" width="12" height="12"></i> {{ entry_upc|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-upc" value="' + (variant.upc || '') + '" placeholder="UPC" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span><i data-lucide="hash" width="12" height="12"></i> {{ entry_ean|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-ean" value="' + (variant.ean || '') + '" placeholder="EAN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span><i data-lucide="hash" width="12" height="12"></i> {{ entry_jan|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-jan" value="' + (variant.jan || '') + '" placeholder="JAN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span><i data-lucide="book-open" width="12" height="12"></i> {{ entry_isbn|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-isbn" value="' + (variant.isbn || '') + '" placeholder="ISBN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '<label><span><i data-lucide="tag" width="12" height="12"></i> {{ entry_mpn|e("js") }}</span><input type="text" class="form-control input-sm dc-variant-mpn" value="' + (variant.mpn || '') + '" placeholder="MPN" oninput="onVariantFieldInput(' + rowIdx + ')"/></label>';
	html += '</div>';
	html += '</div>';

	html += '<div class="dc-subrow-panel' + (cgVisible ? ' dc-subrow-panel--active' : '') + '" id="dc-panel-cg-' + rowIdx + '"' + (cgVisible ? '' : ' style="display:none"') + '>';
	html += '<div class="dc-cg-header">';
	html += '<span class="dc-cg-header-group">{{ entry_cg_customer_group|e("js") }}</span>';
	html += '<span class="dc-cg-header-price">{{ entry_cg_group_price|e("js") }}</span>';
	html += '<span class="dc-cg-header-action"></span>';
	html += '</div>';
	html += '<div class="dc-cg-prices" id="dc-cg-prices-' + rowIdx + '">';

	if (variant.customer_group_prices) {
		for (var c = 0; c < variant.customer_group_prices.length; c++) {
			var cg = variant.customer_group_prices[c];
			html += '<div class="dc-cg-row">';
			html += '<select class="form-control input-sm dc-cg-group" onchange="scheduleAutoSave(' + rowIdx + ')">';
			{% for customer_group in customer_groups %}
			html += '<option value="{{ customer_group.customer_group_id }}"' + ({{ customer_group.customer_group_id }} == cg.customer_group_id ? ' selected="selected"' : '') + '>{{ customer_group.name|escape("js") }}</option>';
			{% endfor %}
			html += '</select>';
			html += '<input type="number" step="0.0001" class="form-control input-sm dc-cg-price" value="' + (cg.price || '') + '" placeholder="{{ entry_price|e("js") }}" oninput="scheduleAutoSave(' + rowIdx + ')"/>';
			html += '<button type="button" class="btn btn-danger btn-xs" onclick="$(this).closest(\'.dc-cg-row\').remove();updateSubrowBadges(' + rowIdx + ');scheduleAutoSave(' + rowIdx + ')"><i data-lucide="circle-minus"></i></button>';
			html += '</div>';
		}
	}

	html += '</div>';
	html += '<button type="button" class="btn btn-primary btn-xs dc-cg-add-btn" onclick="addVariantCgPrice(' + rowIdx + ')"><i data-lucide="circle-plus"></i> {{ button_cg_add|e("js") }}</button>';
	html += '</div>';

	html += '<div class="dc-subrow-panel' + (specialsVisible ? ' dc-subrow-panel--active' : '') + '" id="dc-panel-specials-' + rowIdx + '"' + (specialsVisible ? '' : ' style="display:none"') + '>';
	html += '<div class="dc-special-header">';
	html += '<span class="dc-special-header-group">{{ entry_cg_customer_group|e("js") }}</span>';
	html += '<span class="dc-special-header-priority">{{ entry_priority|e("js") }}</span>';
	html += '<span class="dc-special-header-price">{{ entry_price|e("js") }}</span>';
	html += '<span class="dc-special-header-date">{{ entry_date_start|e("js") }}</span>';
	html += '<span class="dc-special-header-date">{{ entry_date_end|e("js") }}</span>';
	html += '<span class="dc-special-header-renew">{{ entry_auto_renew|e("js") }}</span>';
	html += '<span class="dc-special-header-action"></span>';
	html += '</div>';
	html += '<div class="dc-special-prices" id="dc-special-prices-' + rowIdx + '">';

	if (variant.variant_specials) {
		for (var s = 0; s < variant.variant_specials.length; s++) {
			var sp = variant.variant_specials[s];
			html += '<div class="dc-special-row">';
