.dc-variant-table th.dc-th-axis { min-width: 140px; }
.dc-variant-table th.dc-th-sku { min-width: 150px; }
.dc-variant-table th.dc-th-default { min-width: 40px; }
.dc-variant-table th.dc-th-status { min-width: 50px; }
.dc-variant-table th.dc-th-action { min-width: 40px; }
