};

function renderCodesVariants(json) {
	var col = $('#dc-codes-variants-col');
	var container = $('#dc-codes-variants');
	var axes = json.configurable_options || [];
	var variants = json.variants || [];

	if (!axes.length || !variants.length) {
		container.html('');
		col.hide();
		updateCodesHeader(json);
		return;
	}

	var valueNames = {};
	for (var a = 0; a < axes.length; a++) {
		var axisValues = axes[a].values || [];
		for (var k in axisValues) {
			valueNames[axisValues[k].option_value_id] = axisValues[k].name;
		}
	}

	var html = '<div class="dc-price-scroll"><div class="dc-code-table">';
	html += '<div class="dc-code-header">';
	html += '<span class="dc-code-header-name">{{ column_model|e("js") }} / {{ entry_option_value|e("js") }}</span>';
	for (var f = 0; f < dcCodeFields.length; f++) {
		html += '<span class="dc-code-header-field" title="' + dcEscapeHtml(dcCodeFieldLabels[dcCodeFields[f]]) + '">' + dcEscapeHtml(dcCodeFieldLabels[dcCodeFields[f]]) + '</span>';
	}
	html += '</div>';

	for (var v = 0; v < variants.length; v++) {
		var variant = variants[v];
		var labels = [];
		if (variant.values) {
			for (var j = 0; j < variant.values.length; j++) {
				labels.push(valueNames[variant.values[j].option_value_id] || ('#' + variant.values[j].option_value_id));
			}
		}
		var vid = parseInt(variant.variant_id) || 0;
		var model = String(variant.model || '');
		html += '<div class="dc-code-row' + (variant.status == 1 ? '' : ' dc-code-row--off') + '" data-variant-id="' + vid + '">';
		html += '<span class="dc-price-name" title="' + dcEscapeHtml((model ? model + ' — ' : '') + labels.join(' / ')) + '">';
		if (model) {
			html += '<span class="dc-price-model" title="' + dcEscapeHtml(model) + '">' + dcEscapeHtml(model) + '</span>';
		}
		html += '<span class="dc-price-label">' + dcEscapeHtml(labels.join(' / ')) + '</span></span>';
		for (var f2 = 0; f2 < dcCodeFields.length; f2++) {
			var field = dcCodeFields[f2];
			html += '<input type="text" class="form-control input-sm dc-code-' + field + '" value="' + dcEscapeHtml(variant[field] || '') + '" data-variant-id="' + vid + '" data-field="' + field + '" />';
		}
		html += '</div>';
	}

	html += '</div></div>';
	container.html(html);
	col.show();
	updateCodesHeader(json);
}

function updateCodesHeader(json) {
	var count = (json && json.variants) ? json.variants.length : $('#dc-codes-variants .dc-code-row').length;
	$('#dc-codes-badge').text(count || 0);
}

function onCodesInput(input) {
	var $row = $(input).closest('.dc-code-row');
	var vid = $(input).data('variant-id');
	$row.removeClass('dc-code-saving dc-code-error dc-code-flash').addClass('dc-code-dirty');
	if (!vid) return;
	if (dcCodesTimers[vid]) { clearTimeout(dcCodesTimers[vid]); }
	dcCodesTimers[vid] = setTimeout(function() { delete dcCodesTimers[vid]; saveCodesRow(vid); }, 600);
}

function saveCodesRow(variantId) {
	var $row = $('#dc-codes-variants .dc-code-row[data-variant-id="' + variantId + '"]');
	if (!$row.length) return;
	var codes = {};
	for (var i = 0; i < dcCodeFields.length; i++) {
		codes[dcCodeFields[i]] = String($row.find('.dc-code-' + dcCodeFields[i]).val() || '');
	}
	$row.removeClass('dc-code-dirty dc-code-error dc-code-flash').addClass('dc-code-saving');
	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariantCodes&user_token={{ user_token }}',
		type: 'POST',
		data: $.extend({ product_id: getDcProductId(), variant_id: variantId }, codes),
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				$row.removeClass('dc-code-saving dc-code-dirty').addClass('dc-code-error');
				showToast(json.error, 'error');
				return;
			}
			$row.removeClass('dc-code-saving dc-code-dirty dc-code-error').addClass('dc-code-flash');
			showToast('{{ text_saved|e("js") }}', 'success');
			setTimeout(function() { $row.removeClass('dc-code-flash'); }, 1500);
		},
		error: function() {
			$row.removeClass('dc-code-saving dc-code-dirty').addClass('dc-code-error');
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function dcCodesSync(variantId, codes) {
	if (!variantId || !codes) return;
	var $row = $('#dc-codes-variants .dc-code-row[data-variant-id="' + variantId + '"]');
	if (!$row.length) return;
	for (var field in codes) {
		if (!codes.hasOwnProperty(field)) continue;
		var $input = $row.find('.dc-code-' + field);
		if ($input.length && $input[0] !== document.activeElement) {
			$input.val(codes[field]);
		}
	}
}

var dcMediaVariants = null;

function renderMediaVariantAssignments(json) {
	var variants = (json && json.variants) ? json.variants : [];
	var axes = (json && json.configurable_options) ? json.configurable_options : [];

	var valueNames = {};
	for (var a = 0; a < axes.length; a++) {
		var axisValues = axes[a].values || [];
		for (var k in axisValues) {
			valueNames[axisValues[k].option_value_id] = axisValues[k].name;
		}
	}

	dcMediaVariants = { list: variants, names: valueNames };
	decorateMediaCards();
}

function removeMediaVariantSelects() {
	dcMediaVariants = null;
	$('.dc-img-variant').remove();
}

function mediaVariantLabel(variant, valueNames) {
	var labels = [];
	if (variant.values) {
		for (var j = 0; j < variant.values.length; j++) {
			labels.push(valueNames[variant.values[j].option_value_id] || ('#' + variant.values[j].option_value_id));
		}
	}
	return String(variant.model || '') + (labels.length ? ' — ' + labels.join(' / ') : '');
}

function decorateMediaCards() {
	var $cards = $('.product-images .dc-img-card');

	if (!dcMediaVariants || !dcMediaVariants.list || !dcMediaVariants.list.length) {
		$('.dc-img-variant').remove();
		return;
	}

	$cards.each(function() {
		var $card = $(this);

		if ($card.hasClass('dc-img-card--main') || $card.find('.dc-img-variant').length) {
			return;
		}

		var $wrap = $('<div class="dc-img-variant"></div>');
		$wrap.append('<select class="form-control input-sm" title="{{ help_media_variant_assign|e("js") }}"></select>');
		$card.append($wrap);
	});

	var $selects = $cards.find('.dc-img-variant select');
	$selects.each(function() {
		var html = '<option value="0">— {{ entry_variant|e("js") }}</option>';
		for (var i = 0; i < dcMediaVariants.list.length; i++) {
			html += '<option value="' + parseInt(dcMediaVariants.list[i].variant_id) + '">' + dcEscapeHtml(mediaVariantLabel(dcMediaVariants.list[i], dcMediaVariants.names)) + '</option>';
		}
		$(this).html(html);
	});

	// Assign current variant images to matching cards (each card at most once).
	var claimed = {};
	for (var n = 0; n < dcMediaVariants.list.length; n++) {
		var path = String(dcMediaVariants.list[n].image || '');

		if (!path) {
			continue;
		}

		$cards.each(function(c) {
			if (claimed[c]) {
				return;
			}

			var $card = $(this);
			var cardPath = String($card.find('input[id^="input-image"]').val() || '');

			if (cardPath && cardPath === path) {
				var vid = parseInt(dcMediaVariants.list[n].variant_id);
				$card.find('.dc-img-variant select').val(String(vid)).attr('data-prev-vid', vid);
				claimed[c] = true;
				return false;
			}
		});
	}
}

function onMediaVariantSelectChange(select) {
	var $select = $(select);
	var $card = $select.closest('.dc-img-card');
	var newVid = parseInt($select.val()) || 0;
	var prevVid = parseInt($select.attr('data-prev-vid')) || 0;

	// "—" on an unassigned card: nothing changed.
	if (!newVid && !prevVid) {
		return;
	}

	// Clearing keeps writing to the previous owner with an empty image;
	// assigning writes the card image path to the chosen variant.
	var targetVid = newVid ? newVid : prevVid;
	var imagePath = newVid ? String($card.find('input[id^="input-image"]').val() || '') : '';

	// Reassign: reset any other card pointing at the same variant.
	if (newVid) {
		$('.dc-img-variant select').not($select).each(function() {
			if ((parseInt($(this).val()) || 0) === newVid) {
				$(this).val('0').removeAttr('data-prev-vid');
			}
		});
	}

	var restore = function() {
		$select.val(prevVid ? String(prevVid) : '0');
		if (prevVid) {
			$select.attr('data-prev-vid', prevVid);
		} else {
			$select.removeAttr('data-prev-vid');
		}
	};

	$select.prop('disabled', true);
	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariantImage&user_token={{ user_token }}',
		type: 'POST',
		data: { product_id: getDcProductId(), variant_id: targetVid, image: imagePath },
		dataType: 'json',
		success: function(json) {
			$select.prop('disabled', false);
			if (json.error) {
				showToast(json.error, 'error');
				restore();
				return;
			}
			if (newVid) {
				$select.attr('data-prev-vid', newVid);
			} else {
				$select.removeAttr('data-prev-vid');
			}
			showToast('{{ text_saved|e("js") }}', 'success');
		},
		error: function() {
			$select.prop('disabled', false);
			showToast('{{ text_load_error|e("js") }}', 'error');
			restore();
		}
	});
}

function dcPricingSync(variantId, price, cgPrices) {
	if (!variantId) return;
	var $row = $('#dc-pricing-variants .dc-price-row[data-variant-id="' + variantId + '"]');
	if ($row.length) {
		var $base = $row.find('.dc-price-base');
		if ($base.length && $base[0] !== document.activeElement) {
			$base.val(price !== undefined ? price : $base.val()).toggleClass('dc-zero', parseFloat(price) == 0);
		}
		if (cgPrices) {
			for (var cgId in cgPrices) {
				if (!cgPrices.hasOwnProperty(cgId)) continue;
				var $cg = $row.find('.dc-price-cg[data-cg-id="' + cgId + '"]');
				if ($cg.length && $cg[0] !== document.activeElement) {
					$cg.val(cgPrices[cgId]);
					$cg.toggleClass('dc-zero', cgPrices[cgId] !== '' && parseFloat(cgPrices[cgId]) == 0);
				}
			}
		}
	}
}

function onPricingInput(input) {
	var $row = $(input).closest('.dc-price-row');
	var vid = $(input).data('variant-id');
	$row.removeClass('dc-price-saving dc-price-error dc-price-flash').addClass('dc-price-dirty');
	$(input).toggleClass('dc-zero', $(input).val() !== '' && parseFloat(String($(input).val()).replace(',', '.')) == 0);
	if (!vid) return;
	if (dcPriceTimers[vid]) {
		clearTimeout(dcPriceTimers[vid]);
	}
	dcPriceTimers[vid] = setTimeout(function() {
		delete dcPriceTimers[vid];
		savePricingRow(vid);
	}, 600);
}

function savePricingRow(variantId) {
	var $row = $('#dc-pricing-variants .dc-price-row[data-variant-id="' + variantId + '"]');
	if (!$row.length) return;
	var price = $row.find('.dc-price-base').val();
	if (price !== '' && price !== null) {
		price = String(price).replace(',', '.');
	}
	var cgPrices = [];
	$row.find('.dc-price-cg').each(function() {
		var cgId = $(this).data('cg-id');
		var val = $(this).val();
		if (val !== '' && val !== null) {
			val = String(val).replace(',', '.');
		}
		if (cgId && val !== '' && val !== undefined && val !== null) {
			// Only send non-empty; empty means remove override (handled by DELETE then re-insert)
			cgPrices.push({customer_group_id: cgId, price: val});
		} else if (cgId) {
			// empty still needs to be represented as omitted — server will delete; to explicitly clear, don't push
		}
	});
	$row.removeClass('dc-price-dirty dc-price-error dc-price-flash').addClass('dc-price-saving');
	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariantPricing&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: getDcProductId(),
			variant_id: variantId,
			price: price,
			customer_group_prices: cgPrices
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				$row.removeClass('dc-price-saving dc-price-dirty').addClass('dc-price-error');
				showToast(json.error, 'error');
				return;
			}
			$row.removeClass('dc-price-saving dc-price-dirty dc-price-error').addClass('dc-price-flash');
			showToast('{{ text_saved|e("js") }}', 'success');
			setTimeout(function() {
				$row.removeClass('dc-price-flash');
			}, 1500);
			if (typeof dcUpdatePricingRanges === 'function' && json.price_range_text !== undefined) {
				dcUpdatePricingRanges(json);
			}
			updatePricingHeader(json);
		},
		error: function() {
			$row.removeClass('dc-price-saving dc-price-dirty').addClass('dc-price-error');
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function dcInventorySync(variantId, quantity) {
	if (!variantId) return;

	var $input = $('#dc-inventory-variants .dc-inv-qty[data-variant-id="' + variantId + '"]');

	if ($input.length) {
		if ($input[0] !== document.activeElement) {
			$input.val(quantity);
		}
		updateInventoryTotal();
	} else if (typeof updateInventoryTotal === 'function') {
		updateInventoryTotal();
	}
}

function updateInventoryTotal(syncMain) {
	if (syncMain === undefined) syncMain = true;
	var total = 0;
	var count = 0;

	$('#dc-inventory-variants .dc-inv-row').each(function() {
		var $row = $(this);
		var $input = $row.find('.dc-inv-qty');
		var num = parseFloat(String($input.val()).replace(',', '.')) || 0;

		count++;
		$input.toggleClass('dc-zero', num == 0);

		if (!$row.hasClass('dc-inv-row--off')) {
			total += num;
		}
	});

	$('#dc-inv-badge').text(count);
	$('#dc-inv-total').text(count ? '{{ text_variant_qty_total|e("js") }}'.replace('%s', Math.round(total * 100) / 100) : '');
	if (syncMain) {
		var $qtyInput = $('#input-quantity');
		if ($qtyInput.length && $qtyInput.prop('readonly')) {
			var formatted = String(Math.round(total * 100) / 100);
			if (formatted.indexOf('.') !== -1) {
				formatted = formatted.replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
			}
			if (!count) {
				formatted = '0';
			}
			$qtyInput.val(formatted);
		}
	}
}

function onInventoryQtyInput(input) {
	var $row = $(input).closest('.dc-inv-row');
	var vid = $(input).data('variant-id');

	$row.removeClass('dc-inv-saving dc-inv-error dc-inv-flash').addClass('dc-inv-dirty');
	updateInventoryTotal(false);

	if (!vid) return;

	if (dcInvTimers[vid]) {
		clearTimeout(dcInvTimers[vid]);
	}

	dcInvTimers[vid] = setTimeout(function() {
		delete dcInvTimers[vid];
		saveInventoryQty(vid);
	}, 600);
}

function saveInventoryQty(variantId) {
	var $row = $('#dc-inventory-variants .dc-inv-row[data-variant-id="' + variantId + '"]');

	if (!$row.length) return;

	var quantity = $row.find('.dc-inv-qty').val();

	$row.removeClass('dc-inv-dirty dc-inv-error dc-inv-flash').addClass('dc-inv-saving');

	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariantQuantity&user_token={{ user_token }}',
		type: 'POST',
		data: {
			product_id: getDcProductId(),
			variant_id: variantId,
			quantity: quantity
		},
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				$row.removeClass('dc-inv-saving dc-inv-dirty').addClass('dc-inv-error');
				showToast(json.error, 'error');
				return;
			}

			$row.removeClass('dc-inv-saving dc-inv-dirty dc-inv-error').addClass('dc-inv-flash');
			showToast('{{ text_saved|e("js") }}', 'success');
			setTimeout(function() {
				$row.removeClass('dc-inv-flash');
			}, 1500);

			updateInventoryTotal();
		},
		error: function() {
			$row.removeClass('dc-inv-saving dc-inv-dirty').addClass('dc-inv-error');
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function bindHScrollProxy() {
	var proxy = $('#dc-hscroll');
	var wrapper = $('.dc-variant-scroll-wrapper');
	var table = $('#dc-variant-table');

	if (!proxy.length || !wrapper.length || !table.length) return;

	function syncSpacer() {
		proxy.find('.dc-hscroll__spacer').width(table.outerWidth());
		proxy.scrollLeft(wrapper.scrollLeft());
	}

	wrapper.off('scroll.dchscroll').on('scroll.dchscroll', function() {
		if (dcHScrollLock) return;
		dcHScrollLock = true;
		proxy.scrollLeft(wrapper.scrollLeft());
		dcHScrollLock = false;
	});

	proxy.off('scroll.dchscroll').on('scroll.dchscroll', function() {
		if (dcHScrollLock) return;
		dcHScrollLock = true;
		wrapper.scrollLeft(proxy.scrollLeft());
		dcHScrollLock = false;
	});

	if (dcHScrollRO) {
		dcHScrollRO.disconnect();
	}

	if (window.ResizeObserver) {
		dcHScrollRO = new ResizeObserver(syncSpacer);
		dcHScrollRO.observe(table[0]);
	}

	$(window).off('resize.dchscroll').on('resize.dchscroll', syncSpacer);

	syncSpacer();
}

function dcAutoWidth(input, expand) {
	var $input = $(input);

	if (!expand) {
		$input.css('width', '');
		return;
	}

	var value = String($input.val() || $input.attr('placeholder') || '');

	if (!value) {
		$input.css('width', '');
		return;
	}

	var $sizer = $('<span></span>').css({
		position: 'absolute',
		visibility: 'hidden',
		whiteSpace: 'pre',
		fontFamily: $input.css('fontFamily'),
		fontSize: $input.css('fontSize'),
		fontWeight: $input.css('fontWeight'),
		letterSpacing: $input.css('letterSpacing')
	}).appendTo('body').text(value);

	var width = Math.ceil($sizer.width())
		+ (parseFloat($input.css('paddingLeft')) || 0)
		+ (parseFloat($input.css('paddingRight')) || 0)
		+ (parseFloat($input.css('borderLeftWidth')) || 0)
		+ (parseFloat($input.css('borderRightWidth')) || 0)
		+ 2;

	$sizer.remove();

	$input.css('width', Math.max(width, 44) + 'px');
}

var dcAutoWidthSelector = '.dc-variant-model, .dc-inv-qty, .dc-price-base, .dc-price-cg, .dc-dim-length, .dc-dim-width, .dc-dim-height, .dc-dim-weight, .dc-code-sku, .dc-code-upc, .dc-code-ean, .dc-code-jan, .dc-code-isbn, .dc-code-mpn';

$(document).on('focusin input', dcAutoWidthSelector, function() {
	dcAutoWidth(this, true);
});

$(document).on('focusout', dcAutoWidthSelector, function() {
	dcAutoWidth(this, false);
});

$(document).on('input', '.dc-inv-qty', function() {
	onInventoryQtyInput(this);
});

$(document).on('input', '.dc-price-base, .dc-price-cg', function() {
	onPricingInput(this);
});

$(document).on('input', '.dc-dim-length, .dc-dim-width, .dc-dim-height, .dc-dim-weight', function() {
	onDimensionsInput(this);
});

$(document).on('input', '.dc-code-sku, .dc-code-upc, .dc-code-ean, .dc-code-jan, .dc-code-isbn, .dc-code-mpn', function() {
	onCodesInput(this);
});

$(document).on('change', '.dc-img-variant select', function() {
	onMediaVariantSelectChange(this);
});
