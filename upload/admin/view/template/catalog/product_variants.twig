function switchSubrowTab(rowIdx, tab) {
	var $subrow = $('#dc-variant-cg-row-' + rowIdx);
	$subrow.show();
	$subrow.find('.dc-subrow-panel').hide().removeClass('dc-subrow-panel--active');
	$subrow.find('.dc-subrow-tab').removeClass('dc-subrow-tab--active');
	$('#dc-panel-' + tab + '-' + rowIdx).show().addClass('dc-subrow-panel--active');
	$subrow.find('.dc-subrow-tab[data-tab="' + tab + '"]').addClass('dc-subrow-tab--active');
}

$(document).on('click', '.dc-subrow-tab', function() {
	var tab = $(this).data('tab');
	var rowIdx = $(this).data('row');
	switchSubrowTab(rowIdx, tab);
});

function updateSubrowBadges(rowIdx) {
	var $row = $('#dc-variant-row-' + rowIdx);
	var $subrow = $('#dc-variant-cg-row-' + rowIdx);

	var articles = 0;
	$row.find('.dc-variant-sku-article, .dc-variant-upc, .dc-variant-ean, .dc-variant-jan, .dc-variant-isbn, .dc-variant-mpn').each(function() {
		if ($(this).val()) articles++;
	});
	var cgCount = $subrow.find('#dc-cg-prices-' + rowIdx + ' .dc-cg-row').length;
	var specCount = $subrow.find('#dc-special-prices-' + rowIdx + ' .dc-special-row').length;
	var discCount = $subrow.find('#dc-discount-prices-' + rowIdx + ' .dc-special-row').length;

	$row.find('.dc-articles-toggle').toggleClass('btn-primary', articles > 0).toggleClass('btn-default', articles === 0);
	$row.find('.dc-cg-toggle').toggleClass('btn-primary', cgCount > 0).toggleClass('btn-default', cgCount === 0);
	$row.find('.dc-special-toggle').toggleClass('btn-primary', specCount > 0).toggleClass('btn-default', specCount === 0);

	var $tabs = $subrow.find('.dc-subrow-tab');
	$tabs.each(function() {
		var t = $(this).data('tab');
		var count = t === 'articles' ? articles : (t === 'cg' ? cgCount : (t === 'specials' ? specCount : discCount));
		var $badge = $(this).find('.dc-subrow-tab__badge');
		if (count > 0) { $badge.text(count).show(); } else { $badge.hide(); }
	});
}

