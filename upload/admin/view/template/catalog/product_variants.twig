	if (!axes.length || !variants.length) {
		container.html('');
		col.hide();
		updateDimensionsHeader(json);
		if (typeof dcUpdateDimensionsRangesInternal === 'function') {
			dcUpdateDimensionsRangesInternal(json);
		}
		return;
	}

	var valueNames = {};
	for (var a = 0; a < axes.length; a++) {
		var axisValues = axes[a].values || [];
		for (var k in axisValues) {
			valueNames[axisValues[k].option_value_id] = axisValues[k].name;
		}
	}

	var html = '<div class="dc-dim-scroll"><div class="dc-dim-table">';
	html += '<div class="dc-dim-header">';
	html += '<span class="dc-dim-header-name">{{ column_model|e("js") }} / {{ entry_option_value|e("js") }}</span>';
	html += '<span class="dc-dim-header-field">{{ entry_length|e("js") }}</span>';
	html += '<span class="dc-dim-header-field">{{ entry_width|e("js") }}</span>';
	html += '<span class="dc-dim-header-field">{{ entry_height|e("js") }}</span>';
	html += '<span class="dc-dim-header-field">{{ entry_weight|e("js") }}</span>';
	html += '</div>';

	for (var v = 0; v < variants.length; v++) {
		var variant = variants[v];
		var labels = [];
		if (variant.values) {
			for (var j = 0; j < variant.values.length; j++) {
				labels.push(valueNames[variant.values[j].option_value_id] || ('#' + variant.values[j].option_value_id));
			}
		}
		var vid = parseInt(variant.variant_id) || 0;
		// Zero means "not set": render an empty input with a dash placeholder;
		// an empty field is saved back as 0.
		var length = variant.length !== undefined && variant.length !== null && parseFloat(variant.length) != 0 ? String(variant.length) : '';
		var width = variant.width !== undefined && variant.width !== null && parseFloat(variant.width) != 0 ? String(variant.width) : '';
		var height = variant.height !== undefined && variant.height !== null && parseFloat(variant.height) != 0 ? String(variant.height) : '';
		var weight = variant.weight !== undefined && variant.weight !== null && parseFloat(variant.weight) != 0 ? String(variant.weight) : '';
		var model = String(variant.model || '');
		html += '<div class="dc-dim-row' + (variant.status == 1 ? '' : ' dc-dim-row--off') + '" data-variant-id="' + vid + '">';
		html += '<span class="dc-dim-name" title="' + dcEscapeHtml((model ? model + ' — ' : '') + labels.join(' / ')) + '">';
		if (model) {
			html += '<span class="dc-dim-model" title="' + dcEscapeHtml(model) + '">' + dcEscapeHtml(model) + '</span>';
		}
		html += '<span class="dc-dim-label">' + dcEscapeHtml(labels.join(' / ')) + '</span></span>';
		html += '<input type="text" inputmode="decimal" placeholder="-" class="form-control input-sm dc-dim-length" value="' + dcEscapeHtml(length) + '" data-variant-id="' + vid + '" data-field="length" />';
		html += '<input type="text" inputmode="decimal" placeholder="-" class="form-control input-sm dc-dim-width" value="' + dcEscapeHtml(width) + '" data-variant-id="' + vid + '" data-field="width" />';
		html += '<input type="text" inputmode="decimal" placeholder="-" class="form-control input-sm dc-dim-height" value="' + dcEscapeHtml(height) + '" data-variant-id="' + vid + '" data-field="height" />';
		html += '<input type="text" inputmode="decimal" placeholder="-" class="form-control input-sm dc-dim-weight" value="' + dcEscapeHtml(weight) + '" data-variant-id="' + vid + '" data-field="weight" />';
		html += '</div>';
	}

	html += '</div></div>';
	container.html(html);
	col.show();
	updateDimensionsHeader(json);
	if (typeof dcUpdateDimensionsRangesInternal === 'function') {
		dcUpdateDimensionsRangesInternal(json);
	}
}

function updateDimensionsHeader(json) {
	var count = (json && json.variants) ? json.variants.length : $('#dc-dimensions-variants .dc-dim-row').length;
	$('#dc-dim-badge').text(count || 0);
	var rangeText = '';
	if (json && json.dimensions_range_text) {
		rangeText = json.dimensions_range_text;
		if (json.weight_range_text) {
			rangeText += ' / ' + json.weight_range_text;
		}
	} else if (json && json.weight_range_text) {
		rangeText = json.weight_range_text;
	}
	if (rangeText) {
		$('#dc-dim-range').text(rangeText);
	} else {
		$('#dc-dim-range').text(count ? '{{ text_no_variants|e("js") }}' : '');
	}
}

function dcUpdateDimensionsRangesInternal(json) {
	if (!json) return;
	// Update global readonly inputs in Dimensions panel when configurable
	if (typeof json.length_range_text !== 'undefined') {
		var $len = $('#input-length');
		var $wid = $('#input-width');
		var $hei = $('#input-height');
		var $weight = $('#input-weight');
		var textNoVariants = '{{ text_no_variants|e("js") }}';
		if ($len.length) {
			var txt = json.length_range_text ? json.length_range_text : textNoVariants;
			if ($len.prop('readonly')) { $len.val(txt); }
		}
		if ($wid.length) {
			var txt2 = json.width_range_text ? json.width_range_text : textNoVariants;
			if ($wid.prop('readonly')) { $wid.val(txt2); }
		}
		if ($hei.length) {
			var txt3 = json.height_range_text ? json.height_range_text : textNoVariants;
			if ($hei.prop('readonly')) { $hei.val(txt3); }
		}
		if ($weight.length) {
			var txt4 = json.weight_range_text ? json.weight_range_text : textNoVariants;
			if ($weight.prop('readonly')) { $weight.val(txt4); }
		}
	}
}

function dcDimensionsSync(variantId, data) {
	if (!variantId) return;
	var $row = $('#dc-dimensions-variants .dc-dim-row[data-variant-id="' + variantId + '"]');
	if ($row.length) {
		// Zeros arrive as "not set" — show the empty/placeholder state.
		var normalize = function(val) { return (val === undefined || val === null || val === '' || parseFloat(val) == 0) ? '' : String(val); };
		if (data.length !== undefined) {
			var $l = $row.find('.dc-dim-length');
			if ($l.length && $l[0] !== document.activeElement) { $l.val(normalize(data.length)); }
		}
		if (data.width !== undefined) {
			var $w = $row.find('.dc-dim-width');
			if ($w.length && $w[0] !== document.activeElement) { $w.val(normalize(data.width)); }
		}
		if (data.height !== undefined) {
			var $h = $row.find('.dc-dim-height');
			if ($h.length && $h[0] !== document.activeElement) { $h.val(normalize(data.height)); }
		}
		if (data.weight !== undefined) {
			var $wg = $row.find('.dc-dim-weight');
			if ($wg.length && $wg[0] !== document.activeElement) { $wg.val(normalize(data.weight)); }
		}
	}
}

function onDimensionsInput(input) {
	var $row = $(input).closest('.dc-dim-row');
	var vid = $(input).data('variant-id');
	$row.removeClass('dc-dim-saving dc-dim-error dc-dim-flash').addClass('dc-dim-dirty');
	if (!vid) return;
	if (dcDimTimers[vid]) { clearTimeout(dcDimTimers[vid]); }
	dcDimTimers[vid] = setTimeout(function() { delete dcDimTimers[vid]; saveDimensionsRow(vid); }, 600);
}

function saveDimensionsRow(variantId) {
	var $row = $('#dc-dimensions-variants .dc-dim-row[data-variant-id="' + variantId + '"]');
	if (!$row.length) return;
	// Empty input = "not set" and is saved as 0.
	var length = $row.find('.dc-dim-length').val();
	var width = $row.find('.dc-dim-width').val();
	var height = $row.find('.dc-dim-height').val();
	var weight = $row.find('.dc-dim-weight').val();
	if (length === '' || length === null) { length = '0'; } else { length = String(length).replace(',', '.'); }
	if (width === '' || width === null) { width = '0'; } else { width = String(width).replace(',', '.'); }
	if (height === '' || height === null) { height = '0'; } else { height = String(height).replace(',', '.'); }
	if (weight === '' || weight === null) { weight = '0'; } else { weight = String(weight).replace(',', '.'); }
	$row.removeClass('dc-dim-dirty dc-dim-error dc-dim-flash').addClass('dc-dim-saving');
	$.ajax({
		url: 'index.php?route=catalog/product_configurable/saveVariantDimensions&user_token={{ user_token }}',
		type: 'POST',
		data: { product_id: getDcProductId(), variant_id: variantId, length: length, width: width, height: height, weight: weight },
		dataType: 'json',
		success: function(json) {
			if (json.error) {
				$row.removeClass('dc-dim-saving dc-dim-dirty').addClass('dc-dim-error');
				showToast(json.error, 'error');
				return;
			}
			$row.removeClass('dc-dim-saving dc-dim-dirty dc-dim-error').addClass('dc-dim-flash');
			showToast('{{ text_saved|e("js") }}', 'success');
			setTimeout(function() { $row.removeClass('dc-dim-flash'); }, 1500);
			if (typeof dcUpdatePricingRanges === 'function' && json.price_range_text !== undefined) { dcUpdatePricingRanges(json); }
			if (typeof dcUpdateDimensionsRangesInternal === 'function') { dcUpdateDimensionsRangesInternal(json); }
			if (typeof dcUpdateDimensionsRanges === 'function' && json.dimensions_range_text !== undefined) { dcUpdateDimensionsRanges(json); }
			updateDimensionsHeader(json);
			if (typeof updatePricingHeader === 'function' && json.price_range_text !== undefined) { updatePricingHeader(json); }
		},
		error: function() {
			$row.removeClass('dc-dim-saving dc-dim-dirty').addClass('dc-dim-error');
			showToast('{{ text_load_error|e("js") }}', 'error');
		}
	});
}

function dcUpdateDimensionsRanges(json) { return dcUpdateDimensionsRangesInternal(json); }

