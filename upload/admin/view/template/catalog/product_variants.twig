function dcEscapeHtml(text) {
	return $('<span></span>').text(text === undefined || text === null ? '' : String(text)).html();
}

function renderInventoryVariants(json) {
	var col = $('#dc-inventory-variants-col');
	var container = $('#dc-inventory-variants');
	var axes = json.configurable_options || [];
	var variants = json.variants || [];

	if (!axes.length || !variants.length) {
		container.html('');
		col.hide();
		updateInventoryTotal();
		return;
	}

	var valueNames = {};
	for (var a = 0; a < axes.length; a++) {
		var axisValues = axes[a].values || [];
		for (var k in axisValues) {
			valueNames[axisValues[k].option_value_id] = axisValues[k].name;
		}
	}

	var html = '';
	for (var v = 0; v < variants.length; v++) {
		var variant = variants[v];
		var labels = [];
		if (variant.values) {
			for (var j = 0; j < variant.values.length; j++) {
				labels.push(valueNames[variant.values[j].option_value_id] || ('#' + variant.values[j].option_value_id));
			}
		}

		var vid = parseInt(variant.variant_id) || 0;
		var qty = String(variant.quantity || '0');
		var model = String(variant.model || '');

		html += '<div class="dc-inv-row' + (variant.status == 1 ? '' : ' dc-inv-row--off') + '" data-variant-id="' + vid + '">';
		if (model) {
			html += '<span class="dc-inv-model" title="' + dcEscapeHtml(model) + '">' + dcEscapeHtml(model) + '</span>';
		}
		html += '<span class="dc-inv-name" title="' + dcEscapeHtml(labels.join(' / ')) + '">' + dcEscapeHtml(labels.join(' / ')) + '</span>';
		html += '<input type="text" inputmode="decimal" class="form-control input-sm dc-inv-qty' + (parseFloat(qty) == 0 ? ' dc-zero' : '') + '" value="' + dcEscapeHtml(qty) + '" data-variant-id="' + vid + '" />';
		html += '</div>';
	}

	container.html(html);
	col.show();
	updateInventoryTotal();
}

function renderPricingVariants(json) {
	var col = $('#dc-pricing-variants-col');
	var container = $('#dc-pricing-variants');
	var axes = json.configurable_options || [];
	var variants = json.variants || [];

	if (!axes.length || !variants.length) {
		container.html('');
		col.hide();
		updatePricingHeader(json);
		return;
	}

	var valueNames = {};
	for (var a = 0; a < axes.length; a++) {
		var axisValues = axes[a].values || [];
		for (var k in axisValues) {
			valueNames[axisValues[k].option_value_id] = axisValues[k].name;
		}
	}

	var cgMap = {};
	for (var g = 0; g < dcCustomerGroups.length; g++) {
		cgMap[dcCustomerGroups[g].id] = dcCustomerGroups[g].name;
	}

	var hasCg = dcCustomerGroups.length > 0;

	var html = '<div class="dc-price-scroll"><div class="dc-price-table">';
	html += '<div class="dc-price-header">';
	html += '<span class="dc-price-header-name">{{ column_model|e("js") }} / {{ entry_option_value|e("js") }}</span>';
	html += '<span class="dc-price-header-price">{{ column_price|e("js") }}</span>';
	if (hasCg) {
		for (var cg = 0; cg < dcCustomerGroups.length; cg++) {
			html += '<span class="dc-price-header-cg" title="' + dcEscapeHtml(dcCustomerGroups[cg].name) + '">' + dcEscapeHtml(dcCustomerGroups[cg].name) + '</span>';
		}
	}
	html += '</div>';

	for (var v = 0; v < variants.length; v++) {
		var variant = variants[v];
		var labels = [];
		if (variant.values) {
			for (var j = 0; j < variant.values.length; j++) {
				labels.push(valueNames[variant.values[j].option_value_id] || ('#' + variant.values[j].option_value_id));
			}
		}
		var vid = parseInt(variant.variant_id) || 0;
		var price = String(variant.price !== undefined && variant.price !== null ? variant.price : '0');
		var model = String(variant.model || '');
		var cgPrices = {};
		if (variant.customer_group_prices) {
			for (var c = 0; c < variant.customer_group_prices.length; c++) {
				cgPrices[parseInt(variant.customer_group_prices[c].customer_group_id)] = String(variant.customer_group_prices[c].price);
			}
		}
		html += '<div class="dc-price-row' + (variant.status == 1 ? '' : ' dc-price-row--off') + '" data-variant-id="' + vid + '">';
		html += '<span class="dc-price-name" title="' + dcEscapeHtml((model ? model + ' — ' : '') + labels.join(' / ')) + '">';
		if (model) {
			html += '<span class="dc-price-model" title="' + dcEscapeHtml(model) + '">' + dcEscapeHtml(model) + '</span>';
		}
		html += '<span class="dc-price-label">' + dcEscapeHtml(labels.join(' / ')) + '</span></span>';
		html += '<input type="text" inputmode="decimal" class="form-control input-sm dc-price-base' + (parseFloat(price) == 0 ? ' dc-zero' : '') + '" value="' + dcEscapeHtml(price) + '" data-variant-id="' + vid + '" data-field="price" />';
		if (hasCg) {
			for (var cg2 = 0; cg2 < dcCustomerGroups.length; cg2++) {
				var cgId = dcCustomerGroups[cg2].id;
				var cgVal = cgPrices[cgId] !== undefined ? cgPrices[cgId] : '';
				html += '<input type="text" inputmode="decimal" class="form-control input-sm dc-price-cg' + (cgVal !== '' && parseFloat(cgVal) == 0 ? ' dc-zero' : '') + '" value="' + dcEscapeHtml(cgVal) + '" data-variant-id="' + vid + '" data-cg-id="' + cgId + '" placeholder="-" />';
			}
		}
		html += '</div>';
	}

	html += '</div></div>';
	container.html(html);
	col.show();
	updatePricingHeader(json);
}

function updatePricingHeader(json) {
	var count = (json && json.variants) ? json.variants.length : $('#dc-pricing-variants .dc-price-row').length;
	$('#dc-price-badge').text(count || 0);
	var rangeText = '';
	if (json && json.price_range_text) {
		rangeText = json.price_range_text;
	} else if (json && json.price_range && (parseFloat(json.price_range.min) > 0 || parseFloat(json.price_range.max) > 0)) {
		rangeText = String(json.price_range.min) + ' - ' + String(json.price_range.max);
	}
	if (rangeText) {
		$('#dc-price-range').text('{{ text_variant_price_range|e("js") }}'.replace('%s', rangeText));
	} else {
		$('#dc-price-range').text(count ? '{{ text_no_variants|e("js") }}' : '');
	}
}

function renderDimensionsVariants(json) {
	var col = $('#dc-dimensions-variants-col');
