{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="submit" form="form-attribute" formaction="{{ copy }}" class="btn btn-default dc-btn-selection"><i data-lucide="copy" width="16" height="16"></i> {{ button_copy }}</button>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-attribute').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if attributes %}

    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-attribute">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'ad.name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'attribute_group' %}<a href="{{ sort_attribute_group }}" class="{{ order|lower }} sortable">{{ column_attribute_group }}</a>{% else %}<a href="{{ sort_attribute_group }}" class="sortable">{{ column_attribute_group }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'a.sort_order' %}<a href="{{ sort_sort_order }}" class="{{ order|lower }} sortable">{{ column_sort_order }}</a>{% else %}<a href="{{ sort_sort_order }}" class="sortable">{{ column_sort_order }}</a>{% endif %}</td>
              <td class="text-left">{{ column_status }}</td>
            </tr>
          </thead>
          <tbody>
            {% if attributes %}
            {% for attribute in attributes %}
            <tr data-href="{{ attribute.edit }}">
              <td class="text-center">{% if attribute.attribute_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ attribute.attribute_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ attribute.attribute_id }}" />
                {% endif %}</td>
              <td class="text-left">
                <span class="inline-edit" data-attribute-id="{{ attribute.attribute_id }}" data-field="name" data-value="{{ attribute.name_raw }}">{{ attribute.name }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
              </td>
              <td class="text-left">
                <span class="inline-edit" data-attribute-id="{{ attribute.attribute_id }}" data-field="attribute_group_id" data-value="{{ attribute.attribute_group_id_raw }}">{{ attribute.attribute_group }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
              </td>
              <td class="text-right">
                <span class="inline-edit" data-attribute-id="{{ attribute.attribute_id }}" data-field="sort_order" data-value="{{ attribute.sort_order_raw }}">{{ attribute.sort_order }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
              </td>
              <td class="text-left">
                <span class="inline-edit" data-attribute-id="{{ attribute.attribute_id }}" data-field="status" data-value="{{ attribute.status_raw }}">
                  {% if attribute.status %}
                  <span class="label label-success">{{ text_enabled }}</span>
                  {% else %}
                  <span class="label label-danger">{{ text_disabled }}</span>
                  {% endif %}
                  <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                </span>
              </td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="5">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>

    {% else %}

        {% include 'common/empty_state.twig' with {

          icon: 'attribute',

          standalone: true,

          title: text_empty_title,

          description: text_empty_description,

          action_url: add,

          action_text: button_add

        } %}

    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
$('button[form=\'form-attribute\']').on('click', function(e) {
	$('#form-attribute').attr('action', $(this).attr('formaction'));
});
//--></script>
<script type="text/javascript"><!--
var attributeGroups = {{ attribute_groups_json|raw }};

$(document).on('click', '.inline-edit', function(e) {
	if ($(e.target).closest('.inline-edit-icon, input, select').length) return;
	$(this).find('.inline-edit-icon').trigger('click');
});

$(document).on('click', '.inline-edit-icon', function(e) {
	e.stopPropagation();

	var $span = $(this).closest('.inline-edit');
	if ($span.find('input, select').length) return;

	var field = $span.data('field');
	var rawValue = $span.data('value');
	var attributeId = $span.data('attribute-id');

	$span.addClass('editing');
	$span.data('display', $span.html());

	if (field === 'attribute_group_id') {
		var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
		$.each(attributeGroups, function(i, g) {
			$select.append('<option value="' + g.attribute_group_id + '"' + (rawValue == g.attribute_group_id ? ' selected' : '') + '>' + g.name + '</option>');
		});
		$span.html($select);
		$select.focus();

		var saved = false;

		$select.on('change', function() {
			saved = true;
			var newValue = $(this).val();

			$.ajax({
				url: 'index.php?route=catalog/attribute/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { attribute_id: attributeId, field: 'attribute_group_id', value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					$span.removeClass('editing'); $span.html($span.data('display'));
				}
			});
		});

		$select.on('blur', function() {
			if (!saved) {
				$span.removeClass('editing'); $span.html($span.data('display'));
			}
		});
	} else if (field === 'name') {
		$.ajax({
			url: 'index.php?route=catalog/attribute/getName&user_token={{ user_token }}&attribute_id=' + attributeId,
			dataType: 'json',
			success: function(json) {
				if (json['error']) {
					$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
					setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					return;
				}

				var html = '<div class="inline-edit-names" style="white-space:nowrap;">';
				$.each(json.languages, function(i, lang) {
					var val = json.names[lang.language_id] || '';
					html += '<div style="margin-bottom:2px;">';
					html += '<span style="font-weight:bold;font-size:11px;margin-right:4px;">' + lang.name + ':</span>';
					html += '<input type="text" class="form-control input-sm inline-edit-name-input" data-lang-id="' + lang.language_id + '" value="' + val.replace(/"/g, '&quot;') + '" style="width:200px;display:inline-block;">';
					html += '</div>';
				});
				html += '<div style="margin-top:4px;"><button type="button" class="btn btn-primary btn-xs inline-edit-name-save">{{ button_save }}</button> <button type="button" class="btn btn-default btn-xs inline-edit-name-cancel">{{ button_cancel }}</button></div>';
				html += '</div>';

				$span.html(html);
				$span.find('input').first().focus();

				var reverted = false;
				$span.on('click', '.inline-edit-name-cancel', function() {
					reverted = true;
					$span.removeClass('editing'); $span.html($span.data('display'));
				});

				$span.on('click', '.inline-edit-name-save', function() {
					var names = {};
					$span.find('.inline-edit-name-input').each(function() {
						names[$(this).data('lang-id')] = $(this).val();
					});

					$.ajax({
						url: 'index.php?route=catalog/attribute/updateNames&user_token={{ user_token }}',
						type: 'post',
						dataType: 'json',
						data: { attribute_id: attributeId, names: names },
						success: function(res) {
							if (res['error']) {
								$span.append(' <span class="text-danger inline-edit-error">' + res['error'] + '</span>');
								setTimeout(function() { $span.find('.inline-edit-error').remove(); }, 3000);
							} else {
								reverted = true;
								$span.data('value', res['value_html']);
								$span.removeClass('editing'); $span.html(res['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
								lucide.createIcons({ nodes: [$span[0]] });
							}
						},
						error: function() {
							$span.removeClass('editing'); $span.html($span.data('display'));
						}
					});
				});

				$span.find('.inline-edit-name-input').on('keydown', function(e) {
					if (e.which === 27) {
						reverted = true;
						$span.removeClass('editing'); $span.html($span.data('display'));
					}
				});

				$(document).one('click', function(e) {
					if (!$(e.target).closest('.inline-edit-names').length && !reverted) {
						$span.removeClass('editing'); $span.html($span.data('display'));
					}
				});
			},
			error: function() {
				$span.removeClass('editing'); $span.html($span.data('display'));
			}
		});
	} else if (field === 'status') {
		var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
		$select.append('<option value="1"' + (rawValue == 1 ? ' selected' : '') + '>{{ text_enabled }}</option>');
		$select.append('<option value="0"' + (rawValue == 0 ? ' selected' : '') + '>{{ text_disabled }}</option>');
		$span.html($select);
		$select.focus();
		var saved = false;

		$select.on('change', function() {
			saved = true;
			var newValue = $(this).val();

			$.ajax({
				url: 'index.php?route=catalog/attribute/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { attribute_id: attributeId, field: field, value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					$span.removeClass('editing'); $span.html($span.data('display'));
				}
			});
		});

		$select.on('blur', function() {
			if (!saved) {
				$span.removeClass('editing'); $span.html($span.data('display'));
			}
		});
	} else {
		$span.html('<input type="text" class="form-control input-sm inline-edit-input" value="' + rawValue + '">');
		var $input = $span.find('input');
		$input.focus().select();

		function revert() {
			$span.removeClass('editing'); $span.html($span.data('display'));
		}

		function save() {
			var newValue = $input.val();

			$.ajax({
				url: 'index.php?route=catalog/attribute/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { attribute_id: attributeId, field: field, value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					revert();
				}
			});
		}

		$input.on('blur', save);
		$input.on('keydown', function(e) {
			if (e.which === 13) { e.preventDefault(); $input.trigger('blur'); }
			if (e.which === 27) { revert(); }
		});
	}
});
//--></script>
{{ footer }}