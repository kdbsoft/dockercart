{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-category" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if category_name %}
                {{ category_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-category">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
      <div class="dcx-panel">
        <div class="dcx-panel-head">
          <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
          <div>
            <div class="dcx-panel-title">{{ tab_description }}</div>
          </div>
        </div>
        <div class="dcx-panel-body">
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane" id="language{{ language.language_id }}">
              <div class="dcx-fields">
              <div class="dcx-field required">
                <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                <input type="text" name="category_description[{{ language.language_id }}][name]" value="{{ (category_description[language.language_id] ? category_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                {% if error_name[language.language_id] %}
                <div class="text-danger">{{ error_name[language.language_id] }}</div>
                {% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                <textarea name="category_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" data-toggle="tinymce" class="form-control">{{ category_description[language.language_id] ? category_description[language.language_id].description }}</textarea>
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                <input type="text" name="category_description[{{ language.language_id }}][meta_title]" value="{{ (category_description[language.language_id] ? category_description[language.language_id].meta_title)|e('html_attr') }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control" />
                {% if error_meta_title[language.language_id] %}
                <div class="text-danger">{{ error_meta_title[language.language_id] }}</div>
                {% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                <textarea name="category_description[{{ language.language_id }}][meta_description]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ category_description[language.language_id] ? category_description[language.language_id].meta_description }}</textarea>
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                <textarea name="category_description[{{ language.language_id }}][meta_keyword]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ category_description[language.language_id] ? category_description[language.language_id].meta_keyword }}</textarea>
              </div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="dcx-panel" style="margin-top: 16px;">
        <div class="dcx-panel-head">
          <div class="dcx-panel-head__icon"><i data-lucide="image" width="18" height="18"></i></div>
          <div>
            <div class="dcx-panel-title">{{ tab_params_group }}</div>
          </div>
        </div>
        <div class="dcx-panel-body">
          <div class="dcx-fields dcx-fields--row">
          <div class="dcx-field">
            <label class="dcx-label">{{ entry_image }}</label>
            <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
            <input type="hidden" name="image" value="{{ image }}" id="input-image" />
          </div>
          <div class="dcx-field">
            <div style="display:flex;align-items:center;gap:4px;">
              <label class="dcx-label" for="input-icon">{{ entry_icon }}</label>
              <span data-toggle="tooltip" title="{{ help_icon }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
            </div>
            <a href="" id="thumb-icon" data-toggle="image" class="img-thumbnail"><img src="{{ icon_thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
            <input type="hidden" name="icon" value="{{ icon }}" id="input-icon" />
          </div>
          <div class="dcx-field">
            <label class="dcx-label">{{ entry_background_image }}</label>
            <a href="" id="thumb-background" data-toggle="image" class="img-thumbnail"><img src="{{ background_thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
            <input type="hidden" name="background_image" value="{{ background_image }}" id="input-background" />
          </div>
          </div>
          <div class="dcx-banner-section">
            <div class="dcx-banner-section__head">
              <span>{{ text_banner_card }}</span>
            </div>
            <div class="dcx-banner-layout">
              <div class="dcx-banner-layout__preview" id="banner-preview-wrap">
                <a href="" id="thumb-banner" data-toggle="image" class="dcx-banner-layout__thumb">
                  <img src="{{ banner_thumb }}" alt="" data-placeholder="{{ placeholder }}" id="banner-preview-img" />
                </a>
                <input type="hidden" name="banner_image" value="{{ banner_image }}" id="input-banner" />
              </div>
              <div class="dcx-banner-layout__link">
                <div style="display:flex;align-items:center;gap:4px;">
                  <label class="dcx-label">{{ entry_banner_link }}</label>
                  <span data-toggle="tooltip" title="{{ help_banner_image }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </div>
                <div class="dc-link-row">
                  <select class="form-control dc-link-type dc-link-type-select">
                    <option value="custom" {{ banner_link_type == 'custom' or not banner_link_type ? 'selected' : '' }}>{{ text_link_custom }}</option>
                    <option value="product" {{ banner_link_type == 'product' ? 'selected' : '' }}>{{ text_link_product }}</option>
                    <option value="category" {{ banner_link_type == 'category' ? 'selected' : '' }}>{{ text_link_category }}</option>
                    <option value="manufacturer" {{ banner_link_type == 'manufacturer' ? 'selected' : '' }}>{{ text_link_manufacturer }}</option>
                    <option value="information" {{ banner_link_type == 'information' ? 'selected' : '' }}>{{ text_link_information }}</option>
                    <option value="blog" {{ banner_link_type == 'blog' ? 'selected' : '' }}>{{ text_link_blog }}</option>
                  </select>
                  <div class="dc-link-custom{% if banner_link_type is not empty and banner_link_type != 'custom' %} dc-link-hidden-field{% endif %}">
                    <input type="text" class="form-control dc-link-custom-input" value="{{ banner_link }}" placeholder="{{ entry_link }}" />
                  </div>
                  <div class="dc-link-entity{% if not banner_link_type or banner_link_type == 'custom' %} dc-link-hidden-field{% endif %}">
                    <input type="text" class="form-control dc-link-autocomplete" value="{{ banner_link_entity_name }}" placeholder="{{ entry_link_search }}" data-type="{{ banner_link_type }}" data-value="{{ banner_link_value }}" />
                  </div>
                </div>
                <input type="hidden" name="banner_link" value="{{ banner_link }}" class="dc-link-hidden" />
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__checkbox">
                <input type="checkbox" name="top" value="1" {% if top %}checked="checked"{% endif %} id="input-top" />
                <span>{{ entry_top }}</span>
                <span data-toggle="tooltip" title="{{ help_top }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
              </label>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
              <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="folder-tree" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_organization_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-parent">{{ entry_parent }}</label>
              <div class="dcx-tree-select" data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}" data-none-text="{{ text_none }}" data-placeholder="{{ text_quick_find }}">
                <div class="dcx-tree-select__input-wrap">
                  <input type="text" name="path" value="{{ path|e('html_attr') }}" placeholder="{{ entry_parent }}" id="input-parent" class="dcx-tree-select__input form-control" autocomplete="off" />
                  <input type="hidden" name="parent_id" value="{{ parent_id }}" />
                  <span class="dcx-tree-select__toggle"><i data-lucide="chevron-down" width="16" height="16"></i></span>
                </div>
                <div class="dcx-tree-select__dropdown">
                  <div class="dcx-tree-select__search">
                    <input type="text" class="form-control" placeholder="{{ text_quick_find }}" />
                    <i data-lucide="search" width="14" height="14"></i>
                  </div>
                  <div class="dcx-tree-select__list">
                    <div class="dcx-tree-select__item dcx-tree-select__item--none" data-id="0" data-name="{{ text_none }}">
                      <span class="dcx-tree-select__label">{{ text_none }}</span>
                    </div>
                  </div>
                </div>
              </div>
              {% if error_parent %}
              <div class="text-danger">{{ error_parent }}</div>
              {% endif %}
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_store }}</label>
              <div class="dcx-sidebar-card__stores">
                {% for store in stores %}
                <label class="dcx-sidebar-card__store-item">
                  <input type="checkbox" name="category_store[]" value="{{ store.store_id }}" {% if store.store_id in category_store %}checked="checked"{% endif %} />
                  <span>{{ store.name }}</span>
                </label>
                {% endfor %}
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_related }} <span data-toggle="tooltip" title="{{ help_related }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
              <button type="button" class="btn btn-default btn-sm btn-block" id="btn-open-related-category-modal">
                <i data-lucide="folder-tree" width="14" height="14"></i>
                <span id="related-category-count">{% if category_relateds|length > 0 %}{{ category_relateds|length }} {{ text_selected }}{% else %}{{ text_select_related }}{% endif %}</span>
              </button>
              <div id="category-related" class="dcx-tree-select__well">{% for category_related in category_relateds %}
                  <div class="dcx-tree-select__well-item" data-id="{{ category_related.category_id }}"><i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i> <span class="dcx-tree-select__well-label">{{ category_related.name }}</span>
                    <input type="hidden" name="category_related[]" value="{{ category_related.category_id }}" />
                  </div>
                {% endfor %}</div>
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="link" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_seo_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__help"><i data-lucide="info" width="16" height="16"></i> {{ text_keyword }}</div>
            <div class="dcx-sidebar-card__links">
              {% for store in stores %}
                {% if stores|length > 1 %}
                <div class="dcx-sidebar-card__store-label">{{ store.name }}</div>
                {% endif %}
                {% for language in languages %}
                <div class="dcx-sidebar-card__link-item">
                  <label class="dcx-sidebar-card__link-label">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    {{ language.name }}
                  </label>
                  <input type="text" name="category_seo_url[{{ store.store_id }}][{{ language.language_id }}]" value="{% if category_seo_url[store.store_id][language.language_id] %}{{ category_seo_url[store.store_id][language.language_id] }}{% endif %}" placeholder="{{ entry_keyword }}" class="form-control" />
                  {% if error_keyword[store.store_id][language.language_id] %}
                  <div class="text-danger">{{ error_keyword[store.store_id][language.language_id] }}</div>
                  {% endif %}
                </div>
                {% endfor %}
              {% endfor %}
            </div>
            <div class="dcx-seo-preview">
              <span class="dcx-seo-preview__label">{{ text_seo_preview }}</span>
              <span class="dcx-seo-preview__url">yoursite.com/category/</span><span id="seo-url-preview">...</span>
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="columns-2" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_design_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__help"><i data-lucide="info" width="16" height="16"></i> {{ text_layout_info }}</div>
            <div class="dcx-sidebar-card__layouts">
              {% for store in stores %}
              <div class="dcx-sidebar-card__layout-item">
                <label class="dcx-sidebar-card__layout-label">{{ store.name }}</label>
                <select name="category_layout[{{ store.store_id }}]" class="form-control">
                  <option value=""></option>
                  {% for layout in layouts %}
                  {% if category_layout[store.store_id] and category_layout[store.store_id] == layout.layout_id %}
                  <option value="{{ layout.layout_id }}" selected="selected">{{ layout.name }}</option>
                  {% else %}
                  <option value="{{ layout.layout_id }}">{{ layout.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>

      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript" src="view/javascript/tinymce/dc.js"></script>

<div id="related-category-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title"><i data-lucide="folder-tree" width="18" height="18" style="margin-right:8px;"></i>{{ text_select_related }}</h4>
      </div>
      <div class="modal-body">
        <div id="related-category-tree" class="dcx-tree-select"
             data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}"
             data-mode="multi"
             data-none-text="{{ text_none }}"
             data-placeholder="{{ text_quick_find }}">
          <div class="dcx-tree-select__search">
            <input type="text" class="form-control" placeholder="{{ text_quick_find }}" id="related-category-tree-search" />
            <i data-lucide="search" width="14" height="14"></i>
          </div>
          <div class="dcx-tree-select__list" style="max-height:400px;overflow-y:auto;"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
        <button type="button" class="btn btn-primary" id="related-category-confirm"><i data-lucide="check" width="14" height="14"></i> {{ button_continue }}</button>
      </div>
    </div>
  </div>
</div>

  <script type="text/javascript"><!--
$('#language a:first').tab('show');
$('[data-toggle="tooltip"]').tooltip();

$('input[name^="category_seo_url"]').on('input', function() {
	var firstVal = $('input[name^="category_seo_url"]:first').val();
	if (firstVal) {
		$('#seo-url-preview').text(firstVal);
	} else {
		$('#seo-url-preview').text('...');
	}
});

var relatedCategoryTreeInstance = null;

$('#btn-open-related-category-modal').on('click', function() {
  var $tree = $('#related-category-tree');
  relatedCategoryTreeInstance = $tree.data('dcx-tree-select');
  if (!relatedCategoryTreeInstance) {
    DcxTreeSelect.init('#related-category-tree');
    relatedCategoryTreeInstance = $tree.data('dcx-tree-select');
  }

  var currentIds = [];
  $('#category-related .dcx-tree-select__well-item').each(function() {
    currentIds.push($(this).data('id'));
  });
  relatedCategoryTreeInstance.setSelected(currentIds);

  $('#related-category-modal').modal('show');
});

$('#related-category-confirm').on('click', function() {
  if (!relatedCategoryTreeInstance) {
    $('#related-category-modal').modal('hide');
    return;
  }

  var ids = relatedCategoryTreeInstance.getSelectedIds();
  var $well = $('#category-related');
  $well.empty();

  var allItems = relatedCategoryTreeInstance.cache || [];
  for (var i = 0; i < ids.length; i++) {
    for (var j = 0; j < allItems.length; j++) {
      if (String(allItems[j].category_id) === String(ids[i])) {
        var name = allItems[j].path || allItems[j].name;
        $well.append('<div class="dcx-tree-select__well-item" data-id="' + ids[i] + '"><i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i> <span class="dcx-tree-select__well-label">' + name + '</span><input type="hidden" name="category_related[]" value="' + ids[i] + '"/></div>');
        break;
      }
    }
  }

	$well.toggle(ids.length > 0);
	$('#related-category-count').text(ids.length > 0 ? ids.length + ' {{ text_selected }}' : '{{ text_select_related }}');
	lucide.createIcons();
  relatedCategoryTreeInstance.close();
  $('#related-category-modal').modal('hide');
});

$('#related-category-modal').on('hidden.bs.modal', function() {
  if (relatedCategoryTreeInstance) relatedCategoryTreeInstance.close();
});

$(document).on('click', '#category-related .dcx-tree-select__well-remove', function() {
  $(this).closest('.dcx-tree-select__well-item').remove();
  var count = $('#category-related .dcx-tree-select__well-item').length;
  $('#related-category-count').text(count > 0 ? count + ' {{ text_selected }}' : '{{ text_select_related }}');
  $('#category-related').toggle(count > 0);
});

$(document).ready(function() {
  var $bannerPanel = $('#thumb-banner').closest('.dcx-panel-body');
  if ($bannerPanel.length) {
    DcLinkField.init($bannerPanel);
  }
  $('#category-related').toggle($('#category-related .dcx-tree-select__well-item').length > 0);
});
//--></script>
</div>
{{ footer }}
