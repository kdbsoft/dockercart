{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-attribute" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if entity_name %}
                {{ entity_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-attribute">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="tag" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_panel_attribute_title }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <ul class="nav nav-tabs" id="language">
                  {% for language in languages %}
                  <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                  {% endfor %}
                </ul>
                <div class="tab-content">
                  {% for language in languages %}
                  <div class="tab-pane" id="language{{ language.language_id }}">
                    <div class="dcx-fields">
                      <div class="dcx-field required">
                        <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                        <input type="text" name="attribute_description[{{ language.language_id }}][name]" value="{{ (attribute_description[language.language_id] ? attribute_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                        {% if error_name[language.language_id] %}
                        <div class="text-danger">{{ error_name[language.language_id] }}</div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
                <select name="status" id="input-status" class="form-control">
                  {% if status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-attribute-group">{{ entry_attribute_group }}</label>
                <select name="attribute_group_id" id="input-attribute-group" class="form-control">
                  <option value="0">{{ text_none }}</option>
                  {% for attribute_group in attribute_groups %}
                  {% if attribute_group.attribute_group_id == attribute_group_id %}
                  <option value="{{ attribute_group.attribute_group_id }}" selected="selected">{{ attribute_group.name }}</option>
                  {% else %}
                  <option value="{{ attribute_group.attribute_group_id }}">{{ attribute_group.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
                {% if error_attribute_group %}
                <div class="text-danger">{{ error_attribute_group }}</div>
                {% endif %}
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
                <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('#language a:first').tab('show');
//--></script>
{{ footer }}
