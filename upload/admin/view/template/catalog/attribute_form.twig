{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if entity_name %}
                {{ entity_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-attribute" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-attribute">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="tag" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_panel_attribute_title }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field required">
                    <label class="dcx-label">{{ entry_name }}</label>
                    {% for language in languages %}
                    <div class="dc-attr-row__value">
                      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                      <input type="text" name="attribute_description[{{ language.language_id }}][name]" value="{{ (attribute_description[language.language_id] ? attribute_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" class="form-control" />
                    </div>
                    {% if error_name[language.language_id] %}
                    <div class="text-danger">{{ error_name[language.language_id] }}</div>
                    {% endif %}
                    {% endfor %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-attribute-group">{{ entry_attribute_group }}</label>
                    <select name="attribute_group_id" id="input-attribute-group" class="form-control">
                      <option value="0">{{ text_none }}</option>
                      {% for attribute_group in attribute_groups %}
                      {% if attribute_group.attribute_group_id == attribute_group_id %}
                      <option value="{{ attribute_group.attribute_group_id }}" selected="selected">{{ attribute_group.name }}</option>
                      {% else %}
                      <option value="{{ attribute_group.attribute_group_id }}">{{ attribute_group.name }}</option>
                      {% endif %}
                      {% endfor %}
                    </select>
                    {% if error_attribute_group %}
                    <div class="text-danger">{{ error_attribute_group }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                    <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="status" id="input-status" class="form-control">
                      {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

{{ footer }}
