{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="submit" form="form-review" formaction="{{ copy }}" class="btn btn-default dc-btn-selection"><i data-lucide="copy" width="16" height="16"></i> {{ button_copy }}</button>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-review').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
            <a href="{{ review_settings }}" class="btn btn-default"><i data-lucide="settings" width="16" height="16"></i> {{ text_review_setting }}</a>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {{ user_filter }}
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-review">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td style="width: 1px;"></td>
                  <td class="text-left">{% if sort == 'pd.name' %}<a href="{{ sort_product }}" class="{{ order|lower }} sortable">{{ column_product }}</a>{% else %}<a href="{{ sort_product }}" class="sortable">{{ column_product }}</a>{% endif %}</td>
                  <td class="text-left">{% if sort == 'r.author' %}<a href="{{ sort_author }}" class="{{ order|lower }} sortable">{{ column_author }}</a>{% else %}<a href="{{ sort_author }}" class="sortable">{{ column_author }}</a>{% endif %}</td>
                  <td class="text-right">{% if sort == 'r.rating' %}<a href="{{ sort_rating }}" class="{{ order|lower }} sortable">{{ column_rating }}</a>{% else %}<a href="{{ sort_rating }}" class="sortable">{{ column_rating }}</a>{% endif %}</td>
                  <td class="text-left">{{ column_verified }}</td>
                  <td class="text-left">{{ column_media }}</td>
                  <td class="text-left">{{ column_votes }}</td>
                  <td class="text-left">{% if sort == 'r.status' %}<a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a>{% else %}<a href="{{ sort_status }}" class="sortable">{{ column_status }}</a>{% endif %}</td>
                  <td class="text-left">{% if sort == 'r.date_added' %}<a href="{{ sort_date_added }}" class="{{ order|lower }} sortable">{{ column_date_added }}</a>{% else %}<a href="{{ sort_date_added }}" class="sortable">{{ column_date_added }}</a>{% endif %}</td>
                </tr>
              </thead>
              <tbody>
              {% if reviews %}
              {% for review in reviews %}
              <tr class="review-row" data-href="{{ review.edit }}" data-review-id="{{ review.review_id }}">
                <td class="text-center">{% if review.review_id in selected %}
                  <input type="checkbox" name="selected[]" value="{{ review.review_id }}" checked="checked" />
                  {% else %}
                  <input type="checkbox" name="selected[]" value="{{ review.review_id }}" />
                  {% endif %}</td>
                <td class="text-center">
                  <button type="button" class="btn btn-default btn--icon btn-expand-review" data-review-id="{{ review.review_id }}" data-toggle="tooltip" title="{{ text_expand }}"><i data-lucide="chevron-down" width="14" height="14"></i></button>
                </td>
                <td class="text-left"><a href="{{ review.edit }}" class="row-title-link">{{ review.name }}</a></td>
                <td class="text-left">
                  <span class="inline-edit" data-review-id="{{ review.review_id }}" data-field="author" data-value="{{ review.author_raw }}">{{ review.author }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                </td>
                <td class="text-right">
                  <span class="inline-edit" data-review-id="{{ review.review_id }}" data-field="rating" data-value="{{ review.rating_raw }}">{{ review.rating }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                </td>
                <td class="text-left">
                  <span class="inline-edit" data-review-id="{{ review.review_id }}" data-field="verified" data-value="{{ review.verified }}">{% if review.verified %}<span class="text-success">{{ text_verified }}</span>{% else %}<span class="text-muted">{{ text_not_verified }}</span>{% endif %}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                </td>
                <td class="text-center">{% if review.has_media %}<span data-toggle="tooltip" title="{{ text_has_media }}"><i data-lucide="paperclip" width="14" height="14" class="text-muted"></i></span>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                <td class="text-left">
                  <span class="text-nowrap" data-toggle="tooltip" title="{{ text_votes_tooltip }}">
                    <span class="text-success"><i data-lucide="thumbs-up" width="13" height="13"></i> {{ review.likes }}</span>
                    <span class="text-muted">/</span>
                    <span class="text-danger"><i data-lucide="thumbs-down" width="13" height="13"></i> {{ review.dislikes }}</span>
                  </span>
                </td>
                <td class="text-left">
                  <span class="inline-edit" data-review-id="{{ review.review_id }}" data-field="status" data-value="{{ review.status_raw }}">{{ review.status }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                </td>
                <td class="text-left">
                  <span class="inline-edit" data-review-id="{{ review.review_id }}" data-field="date_added" data-value="{{ review.date_added_raw }}">{{ review.date_added }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                </td>
              </tr>
              <tr class="review-expand-row hidden" data-review-id="{{ review.review_id }}">
                <td class="text-center"></td>
                <td colspan="9">
                  <div class="review-expand-content">
                    <div class="review-expand-loading text-muted"><i data-lucide="loader" width="14" height="14" class="dc-spin"></i> {{ text_loading }}</div>
                  </div>
                </td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="10">{{ text_no_results }}</td>
              </tr>
              {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="pagination-wrap">
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	url = 'index.php?route=catalog/review&user_token={{ user_token }}';

	var filter_product = $('input[name=\'filter_product\']').val();

	if (filter_product) {
		url += '&filter_product=' + encodeURIComponent(filter_product);
	}

	var filter_author = $('input[name=\'filter_author\']').val();

	if (filter_author) {
		url += '&filter_author=' + encodeURIComponent(filter_author);
	}

	var filter_status = $('select[name=\'filter_status\']').val();

	if (filter_status !== '') {
		url += '&filter_status=' + encodeURIComponent(filter_status);
	}

	var filter_date_added = $('input[name=\'filter_date_added\']').val();

	if (filter_date_added) {
		url += '&filter_date_added=' + encodeURIComponent(filter_date_added);
	}

	location = url;
});
//--></script>
<script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});
//--></script>
<script type="text/javascript"><!--
$('button[form=\'form-review\']').on('click', function(e) {
	$('#form-review').attr('action', $(this).attr('formaction'));
});
//--></script>
<script type="text/javascript"><!--
$(document).on('click', '.btn-expand-review', function() {
	var reviewId = $(this).data('review-id');
	var $button = $(this);
	var $icon = $button.find('i');
	var $row = $('.review-row[data-review-id="' + reviewId + '"]');
	var $expandRow = $('.review-expand-row[data-review-id="' + reviewId + '"]');

	if ($expandRow.hasClass('hidden')) {
		var $content = $expandRow.find('.review-expand-content');

		if (!$content.data('loaded')) {
			$.ajax({
				url: 'index.php?route=catalog/review/info&user_token={{ user_token }}&review_id=' + reviewId,
				dataType: 'json',
				success: function(json) {
					if (json['error']) {
						$content.html('<div class="text-danger">' + json['error'] + '</div>');
						return;
					}

					var html = '';

					if (json['text']) {
						html += '<div class="review-expand-text">' + json['text'] + '</div>';
					}

					if (json['criteria'] && json['criteria'].length) {
						html += '<div class="review-expand-criteria">';
						$.each(json['criteria'], function(i, item) {
							html += '<span class="label label-default">' + $('<div>').text(item['name']).html() + ': ' + $('<div>').text(item['value']).html() + '</span> ';
						});
						html += '</div>';
					}

					if (json['images'] && json['images'].length) {
						html += '<div class="review-expand-images">';
						$.each(json['images'], function(i, image) {
							html += '<a href="' + image['popup'] + '" target="_blank"><img src="' + image['thumb'] + '" /></a>';
						});
						html += '</div>';
					}

					if (json['video']) {
						html += '<div class="review-expand-video text-muted"><i data-lucide="video" width="14" height="14"></i> ' + $('<div>').text(json['video']).html() + '</div>';
					}

					if (json['likes'] !== undefined && json['dislikes'] !== undefined) {
						html += '<div class="review-expand-votes"><i data-lucide="thumbs-up" width="14" height="14" class="text-success"></i> ' + json['likes'] + ' <i data-lucide="thumbs-down" width="14" height="14" class="text-danger"></i> ' + json['dislikes'] + '</div>';
					}

					if (!html) {
						html = '<div class="text-muted">—</div>';
					}

					$content.html(html).data('loaded', true);
					lucide.createIcons({ nodes: [$content[0]] });
				},
				error: function() {
					$content.html('<div class="text-danger">{{ text_loading_error }}</div>');
				}
			});
		}

		$expandRow.removeClass('hidden');
		$row.addClass('review-row--expanded');
		$icon.attr('data-lucide', 'chevron-up');
		lucide.createIcons({ nodes: [$icon[0]] });
	} else {
		$expandRow.addClass('hidden');
		$row.removeClass('review-row--expanded');
		$icon.attr('data-lucide', 'chevron-down');
		lucide.createIcons({ nodes: [$icon[0]] });
	}
});
//--></script>
<script type="text/javascript"><!--
$(document).on('click', '.inline-edit', function(e) {
	if ($(e.target).closest('.inline-edit-icon, input, select').length) return;
	$(this).find('.inline-edit-icon').trigger('click');
});

$(document).on('click', '.inline-edit-icon', function(e) {
	e.stopPropagation();

	var $span = $(this).closest('.inline-edit');
	if ($span.find('input, select').length) return;

	var field = $span.data('field');
	var rawValue = $span.data('value');
	var reviewId = $span.data('review-id');

	$span.addClass('editing');
	$span.data('display', $span.html());

	if (field === 'status') {
		var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
		$select.append('<option value="1"' + (rawValue == 1 ? ' selected' : '') + '>{{ text_enabled }}</option>');
		$select.append('<option value="0"' + (rawValue == 0 ? ' selected' : '') + '>{{ text_disabled }}</option>');
		$span.html($select);
		$select.focus();

		var saved = false;

		$select.on('change', function() {
			saved = true;
			var newValue = $(this).val();

			$.ajax({
				url: 'index.php?route=catalog/review/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { review_id: reviewId, field: 'status', value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					$span.removeClass('editing'); $span.html($span.data('display'));
				}
			});
		});

		$select.on('blur', function() {
			if (!saved) {
				$span.removeClass('editing'); $span.html($span.data('display'));
			}
		});
	} else if (field === 'verified') {
		var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
		$select.append('<option value="1"' + (rawValue == 1 ? ' selected' : '') + '>{{ text_verified }}</option>');
		$select.append('<option value="0"' + (rawValue == 0 ? ' selected' : '') + '>{{ text_not_verified }}</option>');
		$span.html($select);
		$select.focus();

		var saved = false;

		$select.on('change', function() {
			saved = true;
			var newValue = $(this).val();

			$.ajax({
				url: 'index.php?route=catalog/review/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { review_id: reviewId, field: 'verified', value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					$span.removeClass('editing'); $span.html($span.data('display'));
				}
			});
		});

		$select.on('blur', function() {
			if (!saved) {
				$span.removeClass('editing'); $span.html($span.data('display'));
			}
		});
	} else if (field === 'rating') {
		var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
		for (var i = 1; i <= 5; i++) {
			$select.append('<option value="' + i + '"' + (rawValue == i ? ' selected' : '') + '>' + i + '</option>');
		}
		$span.html($select);
		$select.focus();

		var saved = false;

		$select.on('change', function() {
			saved = true;
			var newValue = $(this).val();

			$.ajax({
				url: 'index.php?route=catalog/review/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { review_id: reviewId, field: 'rating', value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					$span.removeClass('editing'); $span.html($span.data('display'));
				}
			});
		});

		$select.on('blur', function() {
			if (!saved) {
				$span.removeClass('editing'); $span.html($span.data('display'));
			}
		});
	} else {
		var $input;

		if (field === 'date_added') {
			var dateVal = rawValue.substring(0, 10);
			$span.html('<input type="date" class="form-control input-sm" value="' + dateVal + '" style="width:auto;display:inline-block;">');
			$input = $span.find('input');
		} else {
			$span.html('<input type="text" class="form-control input-sm inline-edit-input" value="' + ('' + rawValue).replace(/"/g, '&quot;') + '">');
			$input = $span.find('input');
		}
		$input.focus().select();

		function revert() {
			$span.removeClass('editing'); $span.html($span.data('display'));
		}

		function save() {
			var newValue = $input.val();

			$.ajax({
				url: 'index.php?route=catalog/review/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { review_id: reviewId, field: field, value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.removeClass('editing'); $span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.removeClass('editing'); $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.removeClass('editing'); $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					revert();
				}
			});
		}

		$input.on('blur', save);
		$input.on('keydown', function(e) {
			if (e.which === 13) { e.preventDefault(); $input.trigger('blur'); }
			if (e.which === 27) { revert(); }
		});
	}
});
//--></script>
{{ footer }}
