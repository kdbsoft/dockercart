{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
            <a href="{{ cancel }}" class="page-header__link">
              <span class="page-header__back">
                <i data-lucide="arrow-left" width="20" height="20"></i>
              </span>
              <span class="page-header__title">
                {{ text_form }}
              </span>
            </a>
          <div class="pull-right">
            <button type="submit" form="form-review" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-review">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="message-square" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="review-tabs">
                <li class="active"><a href="#tab-review-main" data-toggle="tab"><i data-lucide="message-square" width="14" height="14"></i> {{ tab_review }}</a></li>
                <li><a href="#tab-review-criteria" data-toggle="tab"><i data-lucide="list-checks" width="14" height="14"></i> {{ tab_criteria }}</a></li>
                <li><a href="#tab-review-media" data-toggle="tab"><i data-lucide="image" width="14" height="14"></i> {{ tab_media }}</a></li>
                <li><a href="#tab-review-status" data-toggle="tab"><i data-lucide="settings" width="14" height="14"></i> {{ tab_status }}</a></li>
              </ul>
              <div class="tab-content">
                <div class="tab-pane active" id="tab-review-main">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-author">{{ entry_author }}</label>
                      <input type="text" name="author" value="{{ author }}" placeholder="{{ entry_author }}" id="input-author" class="form-control" />
                      {% if error_author %}
                      <div class="text-danger">{{ error_author }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-product">{{ entry_product }}</label>
                      <div class="dcx-field-icon-wrap">
                        <input type="text" name="product" value="{{ product }}" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                        <input type="hidden" name="product_id" value="{{ product_id }}" />
                        <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_product }}"><i data-lucide="circle-question-mark" width="16" height="16" class="text-muted"></i></span>
                      </div>
                      {% if error_product %}
                      <div class="text-danger">{{ error_product }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-text">{{ entry_text }}</label>
                      <textarea name="text" cols="60" rows="8" placeholder="{{ entry_text }}" id="input-text" class="form-control">{{ text }}</textarea>
                      {% if error_text %}
                      <div class="text-danger">{{ error_text }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-date-added">{{ entry_date_added }}</label>
                      <div class="input-group datetime">
                        <input type="text" name="date_added" value="{{ date_added }}" placeholder="{{ entry_date_added }}" data-date-format="YYYY-MM-DD HH:mm:ss" id="input-date-added" class="form-control" />
                        <span class="input-group-btn">
                          <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tab-pane" id="tab-review-criteria">
                  <input type="hidden" name="criteria_group_id" value="{{ criteria_group_id }}" />
                  <div class="dcx-fields">
                    {% if criteria %}
                      {% for item in criteria %}
                      <div class="dcx-field">
                        <label class="dcx-label" for="criteria-{{ item.criteria_id }}">
                          {{ item.name }}
                          {% if item.is_required %}<span class="text-danger">*</span>{% endif %}
                        </label>
                        {% if item.type == 'rating' %}
                        <input type="number" name="criteria[{{ item.criteria_id }}]" value="{{ item.value }}" min="1" max="5" step="0.5" id="criteria-{{ item.criteria_id }}" class="form-control" style="max-width: 120px;" />
                        {% else %}
                        <textarea name="criteria[{{ item.criteria_id }}]" rows="3" id="criteria-{{ item.criteria_id }}" class="form-control">{{ item.value }}</textarea>
                        {% endif %}
                      </div>
                      {% endfor %}
                    {% else %}
                    <p class="text-muted">{{ text_no_criteria }}</p>
                    {% endif %}
                  </div>
                </div>
                <div class="tab-pane" id="tab-review-media">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_images }}</label>
                      <div class="dcx-fields dcx-fields--row">
                        {% for i in 0..2 %}
                        <div class="dcx-field">
                          <a href="" id="thumb-review-image-{{ i }}" data-toggle="image" class="img-thumbnail">
                            <img src="{{ review_images[i] is defined and review_images[i].thumb ? review_images[i].thumb : placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" />
                          </a>
                          <input type="hidden" name="review_image[]" value="{{ review_images[i] is defined ? review_images[i].image : '' }}" id="input-review-image-{{ i }}" />
                        </div>
                        {% endfor %}
                      </div>
                      <p class="text-muted" style="margin-top:6px;">{{ help_images }}</p>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_video }}</label>
                      <div class="dcx-field-icon-wrap">
                        <select name="review_video_type" id="input-video-type" class="form-control" style="max-width: 160px; display: inline-block;">
                          <option value="youtube" {% if review_video_type == 'youtube' %}selected="selected"{% endif %}>{{ text_video_youtube }}</option>
                          <option value="mp4" {% if review_video_type == 'mp4' %}selected="selected"{% endif %}>{{ text_video_mp4 }}</option>
                        </select>
                        <input type="text" name="review_video" value="{{ review_video }}" placeholder="{{ entry_video_value }}" id="input-video" class="form-control" style="display: inline-block; width: auto; flex: 1;" />
                      </div>
                      <p class="text-muted" style="margin-top:6px;">{{ help_video }}</p>
                    </div>
                  </div>
                </div>
                <div class="tab-pane" id="tab-review-status">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_rating }}</label>
                      <input type="number" name="rating" value="{{ rating }}" min="0" max="5" step="0.5" id="input-rating" class="form-control" style="max-width: 120px;" />
                      {% if error_rating %}
                      <div class="text-danger">{{ error_rating }}</div>
                      {% endif %}
                      <p class="text-muted" style="margin-top:6px;">{{ help_rating }}</p>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">
                        <input type="checkbox" name="verified" value="1" id="input-verified" {% if verified %}checked="checked"{% endif %} /> {{ entry_verified }}
                      </label>
                      <p class="text-muted" style="margin-top:6px;">{{ help_verified }}</p>
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                      <select name="status" id="input-status" class="form-control">
                        {% if status %}
                        <option value="1" selected="selected">{{ text_enabled }}</option>
                        <option value="0">{{ text_disabled }}</option>
                        {% else %}
                        <option value="1">{{ text_enabled }}</option>
                        <option value="0" selected="selected">{{ text_disabled }}</option>
                        {% endif %}
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('.datetime').datetimepicker({
	language: '{{ datepicker }}',
	pickDate: true,
	pickTime: true
});
//--></script>
  <script type="text/javascript"><!--
$('input[name=\'product\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'product\']').val(item['label']);
		$('input[name=\'product_id\']').val(item['value']);
	}
});
//--></script>
</div>
{{ footer }}
