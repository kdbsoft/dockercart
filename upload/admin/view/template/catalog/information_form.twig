{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-information" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if information_name %}
                {{ information_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-information">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_description }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-title{{ language.language_id }}">{{ entry_title }}</label>
                      <input type="text" name="information_description[{{ language.language_id }}][title]" value="{{ (information_description[language.language_id] ? information_description[language.language_id].title)|e('html_attr') }}" placeholder="{{ entry_title }}" id="input-title{{ language.language_id }}" class="form-control" />
                      {% if error_title[language.language_id] %}
                      <div class="text-danger">{{ error_title[language.language_id] }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                      <textarea name="information_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" data-toggle="tinymce" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].description }}</textarea>
                      {% if error_description[language.language_id] %}
                      <div class="text-danger">{{ error_description[language.language_id] }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                      <input type="text" name="information_description[{{ language.language_id }}][meta_title]" value="{{ (information_description[language.language_id] ? information_description[language.language_id].meta_title)|e('html_attr') }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control" />
                      {% if error_meta_title[language.language_id] %}
                      <div class="text-danger">{{ error_meta_title[language.language_id] }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                      <textarea name="information_description[{{ language.language_id }}][meta_description]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].meta_description }}</textarea>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                      <textarea name="information_description[{{ language.language_id }}][meta_keyword]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].meta_keyword }}</textarea>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <div class="dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="top" value="1" {% if top %}checked="checked"{% endif %} id="input-top" /> {{ entry_top }}
                  <span data-toggle="tooltip" title="{{ help_top }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="bottom" value="1" {% if bottom %}checked="checked"{% endif %} id="input-bottom" /> {{ entry_bottom }}
                  <span data-toggle="tooltip" title="{{ help_bottom }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="full_width" value="1" {% if full_width %}checked="checked"{% endif %} id="input-full-width" /> {{ entry_full_width }}
                  <span data-toggle="tooltip" title="{{ help_full_width }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
              <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_store }}</label>
              <div class="dcx-sidebar-card__stores">
                {% for store in stores %}
                <label class="dcx-sidebar-card__store-item">
                  <input type="checkbox" name="information_store[]" value="{{ store.store_id }}" {% if store.store_id in information_store %}checked="checked"{% endif %} />
                  <span>{{ store.name }}</span>
                </label>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="link" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_seo_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__help"><i data-lucide="info" width="16" height="16"></i> {{ text_keyword }}</div>
            <div class="dcx-sidebar-card__links">
              {% for store in stores %}
                {% if stores|length > 1 %}
                <div class="dcx-sidebar-card__store-label">{{ store.name }}</div>
                {% endif %}
                {% for language in languages %}
                <div class="dcx-sidebar-card__link-item">
                  <label class="dcx-sidebar-card__link-label">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    {{ language.name }}
                  </label>
                  <input type="text" name="information_seo_url[{{ store.store_id }}][{{ language.language_id }}]" value="{% if information_seo_url[store.store_id][language.language_id] %}{{ information_seo_url[store.store_id][language.language_id] }}{% endif %}" placeholder="{{ entry_keyword }}" class="form-control" />
                  {% if error_keyword[store.store_id][language.language_id] %}
                  <div class="text-danger">{{ error_keyword[store.store_id][language.language_id] }}</div>
                  {% endif %}
                </div>
                {% endfor %}
              {% endfor %}
            </div>
            <div class="dcx-seo-preview">
              <span class="dcx-seo-preview__label">{{ text_seo_preview }}</span>
              <span class="dcx-seo-preview__url">yoursite.com/information/</span><span id="seo-url-preview">...</span>
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="columns-2" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_design_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__help"><i data-lucide="info" width="16" height="16"></i> {{ text_layout_info }}</div>
            <div class="dcx-sidebar-card__layouts">
              {% for store in stores %}
              <div class="dcx-sidebar-card__layout-item">
                <label class="dcx-sidebar-card__layout-label">{{ store.name }}</label>
                <select name="information_layout[{{ store.store_id }}]" class="form-control">
                  <option value=""></option>
                  {% for layout in layouts %}
                  {% if information_layout[store.store_id] and information_layout[store.store_id] == layout.layout_id %}
                  <option value="{{ layout.layout_id }}" selected="selected">{{ layout.name }}</option>
                  {% else %}
                  <option value="{{ layout.layout_id }}">{{ layout.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript" src="view/javascript/tinymce/dc.js"></script>
  <script type="text/javascript"><!--
$('#language a:first').tab('show');
$('[data-toggle="tooltip"]').tooltip();

$('input[name^="information_seo_url"]').on('input', function() {
  var firstVal = $('input[name^="information_seo_url"]:first').val();
  if (firstVal) {
    $('#seo-url-preview').text(firstVal);
  } else {
    $('#seo-url-preview').text('...');
  }
});
//--></script>
</div>
{{ footer }}
