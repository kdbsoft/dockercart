{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="submit" form="form-download" formaction="{{ copy }}" class="btn btn-default dc-btn-selection"><i data-lucide="copy" width="16" height="16"></i> {{ button_copy }}</button>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-download').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-download">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-left">{% if sort == 'dd.name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
                  <td class="text-right">{% if sort == 'd.status' %}<a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a>{% else %}<a href="{{ sort_status }}" class="sortable">{{ column_status }}</a>{% endif %}</td>
                  <td class="text-right">{% if sort == 'd.date_added' %}<a href="{{ sort_date_added }}" class="{{ order|lower }} sortable">{{ column_date_added }}</a>{% else %}<a href="{{ sort_date_added }}" class="sortable">{{ column_date_added }}</a>{% endif %}</td>
                  <td class="text-right"></td>
                </tr>
              </thead>
              <tbody>
                {% if downloads %}
                {% for download in downloads %}
                <tr>
                  <td class="text-center">{% if download.download_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ download.download_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ download.download_id }}" />
                    {% endif %}</td>
                  <td class="text-left">
                    <span class="inline-edit" data-download-id="{{ download.download_id }}" data-field="name" data-value="{{ download.name_raw }}">{{ download.name }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                  </td>
                  <td class="text-right">{{ download.status ? text_enabled : text_disabled }}</td>
                  <td class="text-right">{{ download.date_added }}</td>
                  <td class="text-right"><a href="{{ download.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a> <a href="{{ download.copy }}" data-toggle="tooltip" title="{{ button_copy }}" class="btn btn-default btn--icon"><i data-lucide="copy" width="14" height="14"></i></a> <a href="{{ download.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="return confirm('{{ text_confirm }}');"><i data-lucide="trash-2" width="14" height="14"></i></a></td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="7">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="pagination-wrap">
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
  </div>
</div>
<script type="text/javascript"><!--
$('button[form=\'form-download\']').on('click', function(e) {
	$('#form-download').attr('action', $(this).attr('formaction'));
});
//--></script>
<script type="text/javascript"><!--
$(document).on('click', '.inline-edit-icon', function(e) {
	e.stopPropagation();

	var $span = $(this).closest('.inline-edit');
	if ($span.find('input, select').length) return;

	var rawValue = $span.data('value');
	var downloadId = $span.data('download-id');

	$span.data('display', $span.html());

	$.ajax({
		url: 'index.php?route=catalog/download/getName&user_token={{ user_token }}&download_id=' + downloadId,
		dataType: 'json',
		success: function(json) {
			if (json['error']) {
				$span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
				setTimeout(function() { $span.html($span.data('display')); }, 3000);
				return;
			}

			var html = '<div class="inline-edit-names" style="white-space:nowrap;">';
			$.each(json['languages'], function(i, lang) {
				var val = json['names'][lang.language_id] || '';
				html += '<div style="margin-bottom:2px;">';
				html += '<span style="font-weight:bold;font-size:11px;margin-right:4px;">' + lang.name + ':</span>';
				html += '<input type="text" class="form-control input-sm inline-edit-name-input" data-lang-id="' + lang.language_id + '" value="' + val.replace(/"/g, '&quot;') + '" style="width:200px;display:inline-block;">';
				html += '</div>';
			});
			html += '<div style="margin-top:4px;"><button type="button" class="btn btn-primary btn-xs inline-edit-name-save">{{ button_save }}</button></div>';
			html += '</div>';

			$span.html(html);
			$span.find('input').first().focus();

			var reverted = false;

			$span.on('click', '.inline-edit-name-save', function() {
				var names = {};
				$span.find('.inline-edit-name-input').each(function() {
					names[$(this).data('lang-id')] = $(this).val();
				});

				$.ajax({
					url: 'index.php?route=catalog/download/updateNames&user_token={{ user_token }}',
					type: 'post',
					dataType: 'json',
					data: { download_id: downloadId, names: names },
					success: function(res) {
						if (res['error']) {
							$span.append(' <span class="text-danger inline-edit-error">' + res['error'] + '</span>');
							setTimeout(function() { $span.find('.inline-edit-error').remove(); }, 3000);
						} else {
							reverted = true;
							$span.data('value', res['value_html']);
							$span.html(res['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
							lucide.createIcons({ nodes: [$span[0]] });
						}
					},
					error: function() {
						$span.html($span.data('display'));
					}
				});
			});

			$span.find('.inline-edit-name-input').on('keydown', function(e) {
				if (e.which === 27) {
					reverted = true;
					$span.html($span.data('display'));
				}
			});

			$(document).one('click', function(e) {
				if (!$(e.target).closest('.inline-edit-names').length && !reverted) {
					$span.html($span.data('display'));
				}
			});
		},
		error: function() {
			$span.html($span.data('display'));
		}
	});
});
//--></script>
{{ footer }}
