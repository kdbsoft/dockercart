  function bundleAutocomplete(row) {
	  var $input = $('input[name="product_bundle[' + row + '][bundle_products_text]"]');
	  var $idsInput = $('input[name="product_bundle[' + row + '][bundle_product_ids]"]');
	  var $well = $('#bundle-selected-' + row);

	  $input.autocomplete({
		  'source': function(request, response) {
			  $.ajax({
				  url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
				  dataType: 'json',
				  success: function(json) {
					  response($.map(json, function(item) {
						  return {
							  label: item['name'] + ' (' + item['model'] + ')',
							  value: item['product_id'],
							  name: item['name'],
							  price: item['price'] ? item['price'] : ''
						  }
					  }));
				  }
			  });
		  },
		  'select': function(item) {
			  if ($well.find('[data-product-id="' + item.value + '"]').length) {
				  $input.val('');
				  return;
			  }
			  var chipHtml = '<span class="dc-chip" data-product-id="' + item.value + '">' + escapeHtml(item.name) + ' <button type="button" onclick="removeBundleProduct(this, ' + item.value + ')" class="dc-chip__remove"><i data-lucide="x" width="12" height="12"></i></button></span>';
			  $well.append(chipHtml);
			  lucide.createIcons();
			  updateBundleIds(row);
			  $input.val('');
		  }
	  });
  }

  function removeBundleProduct(btn, productId) {
	  $(btn).closest('.dc-chip').remove();
	  var $card = $(btn).closest('.dc-promo-card');
	  var match = $card.attr('id').match(/bundle-row(\d+)/);
	  if (match) {
		  updateBundleIds(match[1]);
	  }
  }

  function updateBundleIds(row) {
	  var ids = [];
	  $('#bundle-selected-' + row + ' .dc-chip').each(function() {
		  ids.push($(this).data('product-id'));
	  });
	  $('input[name="product_bundle[' + row + '][bundle_product_ids]"]').val(ids.join(','));
  }

  function removeBundleCard(cardId, bundleId) {
	  if (bundleId > 0) {
		  if (!confirm('{{ text_bundle_delete_confirm }}')) return;
		  $.post('index.php?route=catalog/product/deleteBundle&user_token={{ user_token }}', { bundle_id: bundleId }, function(json) {
			  $('#' + cardId).remove();
			  if ($('#promo-container .dc-promo-card').length === 0) {
				  $('#promo-empty').show();
			  }
		  }, 'json');
	  } else {
		  $('#' + cardId).remove();
		  if ($('#promo-container .dc-promo-card').length === 0) {
			  $('#promo-empty').show();
		  }
	  }
  }

  $('.bundle-product-input').each(function() {
	  var match = $(this).attr('name').match(/\[(\d+)\]/);
	  if (match) {
		  bundleAutocomplete(match[1]);
	  }
  });

  //--></script>

