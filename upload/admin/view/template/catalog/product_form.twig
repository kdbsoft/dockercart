{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if product_name %}
                {{ product_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-product" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
              <div class="dcx-panel">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_description_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dc-lang-frame">
                  <ul class="nav nav-tabs" id="language">
                    {% for language in languages %}
                      <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                    {% endfor %}
                  </ul>
                  <div class="tab-content">{% for language in languages %}
                      <div class="tab-pane" id="language{{ language.language_id }}">
                        <div class="dcx-fields">
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                            <input type="text" name="product_description[{{ language.language_id }}][name]" value="{{ (product_description[language.language_id] ? product_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control"/>
                            {% if error_name[language.language_id] %}
                              <div class="text-danger">{{ error_name[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                            <textarea name="product_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" data-toggle="tinymce" class="form-control">{{ product_description[language.language_id] ? product_description[language.language_id].description }}</textarea>
                          </div>
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                            <input type="text" name="product_description[{{ language.language_id }}][meta_title]" value="{{ (product_description[language.language_id] ? product_description[language.language_id].meta_title)|e('html_attr') }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control"/>
                            {% if error_meta_title[language.language_id] %}
                              <div class="text-danger">{{ error_meta_title[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                            <textarea name="product_description[{{ language.language_id }}][meta_description]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ product_description[language.language_id] ? product_description[language.language_id].meta_description }}</textarea>
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                            <textarea name="product_description[{{ language.language_id }}][meta_keyword]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ product_description[language.language_id] ? product_description[language.language_id].meta_keyword }}</textarea>
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-tag{{ language.language_id }}">{{ entry_tag }} <span data-toggle="tooltip" title="{{ help_tag }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                            <div class="dc-tag-input">
                              <input type="text" id="input-tag{{ language.language_id }}" class="form-control dc-tag-input__field" placeholder="{{ entry_tag }}"/>
                              <div class="dc-tag-input__tags" id="tag-chips{{ language.language_id }}"></div>
                              <input type="hidden" name="product_description[{{ language.language_id }}][tag]" value="{{ product_description[language.language_id] ? product_description[language.language_id].tag }}"/>
                            </div>
                          </div>
                        </div>
                      </div>
                    {% endfor %}</div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="sliders-vertical" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_identifiers_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="row">
                    <div class="col-sm-3">
                      <div class="dcx-field required">
                        <label class="dcx-label" for="input-model">{{ entry_model }} <span data-toggle="tooltip" title="{{ help_model }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="model" value="{{ model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control"/>
                        {% if error_model %}
                          <div class="text-danger">{{ error_model }}</div>
                        {% endif %}
                      </div>
                    </div>
                    <div class="col-sm-3">
                      <div class="dcx-field">
                        <label class="dcx-label" for="input-sku">{{ entry_sku }} <span data-toggle="tooltip" title="{{ help_sku }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="sku" value="{{ sku }}" placeholder="{{ entry_sku }}" id="input-sku" class="form-control"/>
                      </div>
                    </div>
                  </div>
                  <div class="dc-article-extra" style="display:{% if upc or ean or jan or isbn or mpn %}block{% else %}none{% endif %};">
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-upc">{{ entry_upc }} <span data-toggle="tooltip" title="{{ help_upc }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="upc" value="{{ upc }}" placeholder="{{ entry_upc }}" id="input-upc" class="form-control"/>
                        </div>
                      </div>
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-ean">{{ entry_ean }} <span data-toggle="tooltip" title="{{ help_ean }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="ean" value="{{ ean }}" placeholder="{{ entry_ean }}" id="input-ean" class="form-control"/>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-jan">{{ entry_jan }} <span data-toggle="tooltip" title="{{ help_jan }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="jan" value="{{ jan }}" placeholder="{{ entry_jan }}" id="input-jan" class="form-control"/>
                        </div>
                      </div>
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-isbn">{{ entry_isbn }} <span data-toggle="tooltip" title="{{ help_isbn }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="isbn" value="{{ isbn }}" placeholder="{{ entry_isbn }}" id="input-isbn" class="form-control"/>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-mpn">{{ entry_mpn }} <span data-toggle="tooltip" title="{{ help_mpn }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="mpn" value="{{ mpn }}" placeholder="{{ entry_mpn }}" id="input-mpn" class="form-control"/>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="dcx-field">
                    <div>
                      <button type="button" id="toggle-articles" class="btn btn-default btn-sm"><i data-lucide="toggle-left" width="14" height="14"></i> <span id="toggle-articles-text">{{ button_show_articles }}</span></button>
                    </div>
                  </div>
                  <div class="dcx-field" style="display:none" id="dc-codes-variants-col">
                    <label class="dcx-label dc-price-head"><i data-lucide="scan-line" width="14" height="14"></i> {{ text_variant_codes_title }} <span class="dc-price-badge" id="dc-codes-badge">0</span></label>
                    <div class="dc-price-block" id="dc-codes-variants"></div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="credit-card" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_pricing_title }}</div>
                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dcx-fields">
                    <div class="row">
                      <div class="col-sm-12 col-lg-6 col-xl-3">
                        <div class="dcx-field" id="dc-price-main">
                          <label class="dcx-label" for="input-price">{{ entry_price }}{% if is_configurable %} <span data-toggle="tooltip" title="{{ help_price_range_computed }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>{% endif %}</label>
                          <input type="text" name="price" value="{% if is_configurable %}{% if price_range_text %}{{ price_range_text }}{% else %}{{ text_no_variants }}{% endif %}{% else %}{{ price }}{% endif %}" placeholder="{{ entry_price }}" id="input-price" class="form-control"{% if is_configurable %} readonly="readonly"{% endif %}/>
                          <div class="dcx-checkbox-group">
                            <label class="dcx-checkbox-label">
                              <input type="checkbox" name="call_for_price" value="1" id="input-call-for-price"{% if call_for_price %} checked{% endif %} /> {{ entry_call_for_price }}
                              <span data-toggle="tooltip" title="{{ help_call_for_price }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                            </label>
                          </div>
                        </div>
                      </div>
                      <div class="col-sm-12 col-lg-6 col-xl-4">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-currency">{{ entry_currency }} <span data-toggle="tooltip" title="{{ help_currency }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <select name="currency_id" id="input-currency" class="form-control">
                            <option value="0">{{ text_store_default }}</option>
                            {% for currency in currencies %}
                              {% if currency.currency_id == currency_id %}
                                <option value="{{ currency.currency_id }}" selected="selected">{{ currency.title }} ({{ currency.code }})</option>
                              {% else %}
                                <option value="{{ currency.currency_id }}">{{ currency.title }} ({{ currency.code }})</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="dcx-field" id="dc-cgp-field"{% if is_configurable %} style="display:none"{% endif %}>
                      <label class="dcx-label">{{ entry_customer_group_price }}</label>
                      <div id="dc-cgp-editable">
                        <div id="customer-group-prices">
                          {% set customer_group_price_row = 0 %}
                          {% for product_customer_group_price in product_customer_group_prices %}
                          <div class="dc-cgp-row" id="customer-group-price-row{{ customer_group_price_row }}">
                            <select name="product_customer_group_price[{{ customer_group_price_row }}][customer_group_id]" class="form-control dc-cgp-select">
                              {% for customer_group in customer_groups %}
                                {% if customer_group.customer_group_id == product_customer_group_price.customer_group_id %}
                                  <option value="{{ customer_group.customer_group_id }}" selected="selected">{{ customer_group.name }}</option>
                                {% else %}
                                  <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
                                {% endif %}
                              {% endfor %}
                            </select>
                            <input type="text" name="product_customer_group_price[{{ customer_group_price_row }}][price]" value="{{ product_customer_group_price.price }}" placeholder="{{ entry_price }}" class="form-control dc-cgp-price"/>
                            <button type="button" onclick="$('#customer-group-price-row{{ customer_group_price_row }}').remove();" class="btn btn-link dc-cgp-remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                          </div>
                          {% set customer_group_price_row = customer_group_price_row + 1 %}
                          {% endfor %}
                        </div>
                        <button type="button" onclick="addCustomerGroupPrice();" id="dc-cgp-add-btn" class="btn btn-default btn-sm"><i data-lucide="plus" width="14" height="14"></i> {{ button_customer_group_price_add }}</button>
                      </div>
                    </div>
                    {% if tax_classes %}
                    <div class="row">
                      <div class="col-sm-4">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-tax-class">{{ entry_tax_class }}</label>
                          <select name="tax_class_id" id="input-tax-class" class="form-control">
                            <option value="0">{{ text_none }}</option>
                            {% for tax_class in tax_classes %}
                              {% if tax_class.tax_class_id == tax_class_id %}
                                <option value="{{ tax_class.tax_class_id }}" selected="selected">{{ tax_class.title }}</option>
                              {% else %}
                                <option value="{{ tax_class.tax_class_id }}">{{ tax_class.title }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    {% endif %}
                    <div class="dcx-field" style="display:none" id="dc-pricing-variants-col">
                      <label class="dcx-label dc-price-head"><i data-lucide="tag" width="14" height="14"></i> {{ text_variant_price_title }} <span class="dc-price-badge" id="dc-price-badge">0</span><span class="dc-price-range" id="dc-price-range"></span></label>
                      <div class="dc-price-block" id="dc-pricing-variants"></div>
                    </div>
                    <div class="dc-promo-section dc-promo-section--collapsed" id="dc-promo-section">
                      <div class="dc-promo-section__head">
                        <button type="button" class="dc-promo-section__toggle" id="dc-promo-toggle" aria-expanded="false" aria-controls="dc-promo-section-body">
                          <span class="dc-promo-section__chevron"><i data-lucide="chevron-down" width="14" height="14"></i></span>
                          <span class="dc-promo-section__icon"><i data-lucide="percent" width="14" height="14"></i></span>
                          <span class="dc-promo-section__title">{{ text_panel_promo_title }}</span>
                          <span class="dc-promo-stat dc-promo-stat--active" id="dc-promo-active-count" hidden data-toggle="tooltip" title="{{ text_promo_active_help }}"><i data-lucide="circle-check" width="11" height="11"></i><b class="dc-promo-stat__num">0</b><span class="dc-promo-stat__label">{{ text_promo_active }}</span></span>
                          <span class="dc-promo-stat dc-promo-stat--expired" id="dc-promo-expired-count" hidden data-toggle="tooltip" title="{{ text_promo_expired_help }}"><i data-lucide="triangle-alert" width="11" height="11"></i><b class="dc-promo-stat__num">0</b><span class="dc-promo-stat__label">{{ text_promo_expired }}</span></span>
                          <span class="dc-promo-stat dc-promo-stat--scheduled" id="dc-promo-scheduled-count" hidden data-toggle="tooltip" title="{{ text_promo_scheduled_help }}"><i data-lucide="clock" width="11" height="11"></i><b class="dc-promo-stat__num">0</b><span class="dc-promo-stat__label">{{ text_promo_scheduled }}</span></span>
                          <span data-toggle="tooltip" title="{{ text_panel_promo_subtitle }}"><i data-lucide="circle-question-mark" width="13" height="13" class="text-muted"></i></span>
                        </button>
                        <div class="dc-variant-promo-controls" id="promo-variant-controls" hidden>
                        <button type="button" class="btn btn-default btn-xs dc-variant-expand-all"><i data-lucide="chevron-down" width="12" height="12"></i> {{ text_variant_group_expand_all }}</button>
                        <button type="button" class="btn btn-default btn-xs dc-variant-collapse-all"><i data-lucide="chevron-up" width="12" height="12"></i> {{ text_variant_group_collapse_all }}</button>
                      </div>
                      <div class="dc-promo-add" id="promo-add-wrap">
                          <button type="button" class="btn btn-default btn-sm dc-promo-add-btn" id="promo-add-btn" aria-haspopup="true" aria-expanded="false">
                            <i data-lucide="plus" width="13" height="13"></i> {{ button_add }} <i data-lucide="chevron-down" width="11" height="11"></i>
                          </button>
                          <div class="dc-promo-add-menu" id="promo-add-menu" hidden>
                            <button type="button" data-promo-add="discount"><i data-lucide="percent" width="13" height="13"></i> {{ text_promo_discount }}</button>
                            <button type="button" data-promo-add="special"><i data-lucide="star" width="13" height="13"></i> {{ text_promo_special }}</button>
                            <button type="button" data-promo-add="gift"><i data-lucide="gift" width="13" height="13"></i> {{ text_promo_gift }}</button>
                            <button type="button" data-promo-add="bxgy"><i data-lucide="repeat" width="13" height="13"></i> {{ text_promo_bxgy }}</button>
                            <button type="button" data-promo-add="bundle"><i data-lucide="layers" width="13" height="13"></i> {{ text_promo_bundle }}</button>
                          </div>
                        </div>
                      </div>
                      <div class="dc-promo-section__body" id="dc-promo-section-body">
                        <div id="promo-container">
                          {% for promo in all_promotions %}
                            {% if promo.promo_type == 'discount' %}
                            {% if is_configurable and promo_variants and not promo.variant_id %}
                            <div class="dc-promo-card dc-promo-card--locked" id="discount-row{{ promo.row_index }}">
                            <span class="dc-promo-card__type dc-promo-card__type--discount"><i data-lucide="percent" width="12" height="12"></i> {{ text_promo_discount }}</span>
                              <span class="dc-axis-badge" data-toggle="tooltip" title="{{ text_promo_locked_help|e('html_attr') }}"><i data-lucide="lock" width="10" height="10"></i> {{ text_promo_scope_product }}</span>
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][customer_group_id]" value="{{ promo.customer_group_id }}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][quantity]" value="{{ promo.quantity }}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][priority]" value="{{ promo.priority }}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][price]" value="{{ promo.price }}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][date_start]" value="{{ promo.date_start }}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][date_end]" value="{{ promo.date_end }}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][auto_renew]" value="{% if promo.auto_renew %}1{% else %}0{% endif %}" />
                              <input type="hidden" name="product_discount[{{ promo.row_index }}][date_added]" value="{{ promo.date_added }}" />
                              {% set locked_cg_name = '' %}
                              {% for cg in customer_groups %}{% if cg.customer_group_id == promo.customer_group_id %}{% set locked_cg_name = cg.name %}{% endif %}{% endfor %}
                              <span class="dc-locked-summary">{{ locked_cg_name }} &middot; {{ entry_quantity }}: {{ promo.quantity }} &middot; {{ entry_price }}: {{ promo.price }} &middot; P{{ promo.priority }}{% if promo.date_start %} &middot; {{ promo.date_start }}{% endif %}{% if promo.date_end %} &ndash; {{ promo.date_end }}{% endif %}{% if promo.auto_renew %} &middot; {{ entry_auto_renew }}{% endif %}</span>
                              <div class="dc-promo-card__actions">
                                <button type="button" onclick="removePromoCard('discount-row{{ promo.row_index }}')" class="dc-promo-card__remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                              </div>
                            </div>
                            {% else %}
                          <div class="dc-promo-card" id="discount-row{{ promo.row_index }}">
                          <span class="dc-promo-card__type dc-promo-card__type--discount"><i data-lucide="percent" width="12" height="12"></i> {{ text_promo_discount }}</span>
                            <div class="dc-promo-card__actions">
                              <label class="dc-promo-card__toggle">
                                <input type="checkbox" name="product_discount[{{ promo.row_index }}][auto_renew]" value="1" class="auto-renew-cb" {% if promo.auto_renew %}checked{% endif %} />
                                <span>{{ entry_auto_renew }}</span>
                              </label>
                              <button type="button" onclick="removePromoCard('discount-row{{ promo.row_index }}')" class="dc-promo-card__remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                            </div>
                            <input type="hidden" name="product_discount[{{ promo.row_index }}][date_added]" value="{{ promo.date_added }}" />
                            <div class="dc-promo-card__grid">
                              {% if is_configurable and promo_variants %}
                              <div class="dc-promo-card__field dc-promo-card__field--wide">
                                <label>{{ entry_variant }}</label>
                                <select name="product_discount[{{ promo.row_index }}][variant_id]" class="form-control">
                                  {% for pv in promo_variants %}
                                    {% if promo.variant_id == pv.variant_id %}
                                      <option value="{{ pv.variant_id }}" selected="selected">{{ pv.label }}{{ pv.is_default ? ' ' ~ text_variant_is_default : '' }}</option>
                                    {% else %}
                                      <option value="{{ pv.variant_id }}">{{ pv.label }}{{ pv.is_default ? ' ' ~ text_variant_is_default : '' }}</option>
                                    {% endif %}
                                  {% endfor %}
                                </select>
                              </div>
                              {% endif %}
