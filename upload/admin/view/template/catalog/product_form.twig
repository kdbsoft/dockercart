            <style>
              .dc-promo-card { position: relative; border: 1px solid var(--dc-border); border-radius: var(--dc-radius-lg); padding: 36px 18px 14px; margin-bottom: 10px; background: var(--dc-surface-alt); }
              .dc-promo-card--reward { background: transparent; padding-top: 14px; }
              #rewards-container { max-width: 400px; }
              .dc-promo-card__actions { position: absolute; top: 8px; right: 8px; display: flex; align-items: center; gap: 2px; }
              .dc-promo-card__toggle { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--dc-text-faint); cursor: pointer; padding: 3px 6px; border-radius: var(--dc-radius-sm); transition: all var(--dc-transition-fast); user-select: none; }
              .dc-promo-card__toggle:hover { color: var(--dc-text-muted); background: var(--dc-gray-100); }
              .dc-promo-card__toggle input { margin: 0; width: 13px; height: 13px; cursor: pointer; accent-color: var(--dc-primary); }
              .dc-promo-card__remove { background: none; border: none; color: var(--dc-text-faint); cursor: pointer; padding: 3px 4px; border-radius: var(--dc-radius-sm); display: flex; align-items: center; justify-content: center; transition: color var(--dc-transition-fast), background var(--dc-transition-fast); }
              .dc-promo-card__remove:hover { color: var(--dc-red-500); background: var(--dc-red-50); }
              .dc-promo-card__grid { display: flex; flex-wrap: wrap; gap: 12px; }
              .dc-promo-card__grid--reward { gap: 12px; }
              .dc-promo-card__field { display: flex; flex-direction: column; gap: 4px; flex: 1 1 140px; min-width: 140px; }
              .dc-promo-card__field label { font-size: 12px; font-weight: 500; color: var(--dc-text-muted); line-height: 1.3; }
              .dc-promo-card__field--wide { flex: 2 1 280px; min-width: 250px; }
              .dc-promo-card__field--group { display: flex; flex-direction: column; gap: 4px; }
              .dc-promo-card__group-name { font-size: 13px; font-weight: 500; color: var(--dc-text-dark); padding: 6px 0; }
              .dc-promo-card__grid .form-control { height: 34px; font-size: 13px; }
              .dc-promo-card__field .input-group { max-width: 220px; }
