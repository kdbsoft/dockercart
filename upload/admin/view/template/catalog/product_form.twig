{{ header }}{{ column_left }}
<div id="content">
  <link rel="stylesheet" href="view/stylesheet/dockercart_dcx_ui.css" />
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if product_name %}
                {{ product_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_enabled : text_disabled }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
              <div class="dcx-panel">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_description_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <ul class="nav nav-tabs" id="language">
                    {% for language in languages %}
                      <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                    {% endfor %}
                  </ul>
                  <div class="tab-content">{% for language in languages %}
                      <div class="tab-pane" id="language{{ language.language_id }}">
                        <div class="dcx-fields">
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                            <input type="text" name="product_description[{{ language.language_id }}][name]" value="{{ (product_description[language.language_id] ? product_description[language.language_id].name)|e('html_attr') }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control"/>
                            {% if error_name[language.language_id] %}
                              <div class="text-danger">{{ error_name[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                            <textarea name="product_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" data-toggle="tinymce" class="form-control">{{ product_description[language.language_id] ? product_description[language.language_id].description }}</textarea>
                          </div>
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                            <input type="text" name="product_description[{{ language.language_id }}][meta_title]" value="{{ (product_description[language.language_id] ? product_description[language.language_id].meta_title)|e('html_attr') }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control"/>
                            {% if error_meta_title[language.language_id] %}
                              <div class="text-danger">{{ error_meta_title[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                            <textarea name="product_description[{{ language.language_id }}][meta_description]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ product_description[language.language_id] ? product_description[language.language_id].meta_description }}</textarea>
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                            <textarea name="product_description[{{ language.language_id }}][meta_keyword]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ product_description[language.language_id] ? product_description[language.language_id].meta_keyword }}</textarea>
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-tag{{ language.language_id }}">{{ entry_tag }}</label>
                            <div class="dcx-field-icon-wrap">
                              <input type="text" name="product_description[{{ language.language_id }}][tag]" value="{{ product_description[language.language_id] ? product_description[language.language_id].tag }}" placeholder="{{ entry_tag }}" id="input-tag{{ language.language_id }}" class="form-control"/>
                              <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_tag }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                            </div>
                          </div>
                        </div>
                      </div>
                    {% endfor %}</div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="sliders" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_identifiers_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="row">
                    <div class="col-sm-3">
                      <div class="dcx-field required">
                        <label class="dcx-label" for="input-model">{{ entry_model }}</label>
                        <div class="dcx-field-icon-wrap">
                          <input type="text" name="model" value="{{ model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control"/>
                          <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_model }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                        </div>
                        {% if error_model %}
                          <div class="text-danger">{{ error_model }}</div>
                        {% endif %}
                      </div>
                    </div>
                    <div class="col-sm-3">
                      <div class="dcx-field">
                        <label class="dcx-label" for="input-sku">{{ entry_sku }}</label>
                        <div class="dcx-field-icon-wrap">
                          <input type="text" name="sku" value="{{ sku }}" placeholder="{{ entry_sku }}" id="input-sku" class="form-control"/>
                          <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_sku }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="dc-article-extra" style="display:{% if upc or ean or jan or isbn or mpn %}block{% else %}none{% endif %};">
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-upc">{{ entry_upc }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="upc" value="{{ upc }}" placeholder="{{ entry_upc }}" id="input-upc" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_upc }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-ean">{{ entry_ean }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="ean" value="{{ ean }}" placeholder="{{ entry_ean }}" id="input-ean" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_ean }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-jan">{{ entry_jan }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="jan" value="{{ jan }}" placeholder="{{ entry_jan }}" id="input-jan" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_jan }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-isbn">{{ entry_isbn }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="isbn" value="{{ isbn }}" placeholder="{{ entry_isbn }}" id="input-isbn" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_isbn }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-mpn">{{ entry_mpn }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="mpn" value="{{ mpn }}" placeholder="{{ entry_mpn }}" id="input-mpn" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_mpn }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-location">{{ entry_location }}</label>
                          <input type="text" name="location" value="{{ location }}" placeholder="{{ entry_location }}" id="input-location" class="form-control"/>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="dcx-field">
                    <div>
                      <button type="button" id="toggle-articles" class="btn btn-default btn-sm"><i data-lucide="toggle-left" width="14" height="14"></i> <span id="toggle-articles-text">{{ button_show_articles }}</span></button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="credit-card" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_pricing_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dcx-fields">
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-price">{{ entry_price }}</label>
                          <input type="text" name="price" value="{{ price }}" placeholder="{{ entry_price }}" id="input-price" class="form-control"/>
                          <div class="dcx-checkbox-group">
                            <label class="dcx-checkbox-label">
                              <input type="checkbox" name="call_for_price" value="1" id="input-call-for-price"{% if call_for_price %} checked{% endif %} /> {{ entry_call_for_price }}
                              <span data-toggle="tooltip" title="{{ help_call_for_price }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span>
                            </label>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_customer_group_price }}</label>
                      <div id="customer-group-prices">
                        {% set customer_group_price_row = 0 %}
                        {% for product_customer_group_price in product_customer_group_prices %}
                        <div class="dc-cgp-row" id="customer-group-price-row{{ customer_group_price_row }}">
                          <select name="product_customer_group_price[{{ customer_group_price_row }}][customer_group_id]" class="form-control dc-cgp-select">
                            {% for customer_group in customer_groups %}
                              {% if customer_group.customer_group_id == product_customer_group_price.customer_group_id %}
                                <option value="{{ customer_group.customer_group_id }}" selected="selected">{{ customer_group.name }}</option>
                              {% else %}
                                <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                          <input type="text" name="product_customer_group_price[{{ customer_group_price_row }}][price]" value="{{ product_customer_group_price.price }}" placeholder="{{ entry_price }}" class="form-control dc-cgp-price"/>
                          <button type="button" onclick="$('#customer-group-price-row{{ customer_group_price_row }}').remove();" class="btn btn-link dc-cgp-remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                        </div>
                        {% set customer_group_price_row = customer_group_price_row + 1 %}
                        {% endfor %}
                      </div>
                      <button type="button" onclick="addCustomerGroupPrice();" class="btn btn-default btn-sm"><i data-lucide="plus" width="14" height="14"></i> {{ button_customer_group_price_add }}</button>
                    </div>
                    {% if tax_classes %}
                    <div class="row">
                      <div class="col-sm-4">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-tax-class">{{ entry_tax_class }}</label>
                          <select name="tax_class_id" id="input-tax-class" class="form-control">
                            <option value="0">{{ text_none }}</option>
                            {% for tax_class in tax_classes %}
                              {% if tax_class.tax_class_id == tax_class_id %}
                                <option value="{{ tax_class.tax_class_id }}" selected="selected">{{ tax_class.title }}</option>
                              {% else %}
                                <option value="{{ tax_class.tax_class_id }}">{{ tax_class.title }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    {% endif %}
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="package" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_inventory_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dcx-fields">
                    <div class="row">
                      <div class="col-sm-3">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-quantity">{{ entry_quantity }}</label>
                          <input type="text" name="quantity" value="{{ quantity }}" placeholder="{{ entry_quantity }}" id="input-quantity" class="form-control"/>
                          <div class="dcx-checkbox-group">
                            <label class="dcx-checkbox-label">
                              <input type="checkbox" name="subtract" value="1"{% if subtract %} checked{% endif %} /> {{ entry_subtract }}
                              <span data-toggle="tooltip" title="{{ help_subtract }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span>
                            </label>
                            <label class="dcx-checkbox-label">
                              <input type="checkbox" name="preorder" value="1"{% if preorder %} checked{% endif %} /> {{ entry_preorder }}
                              <span data-toggle="tooltip" title="{{ help_preorder }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span>
                            </label>
                            <label class="dcx-checkbox-label">
                              <input type="checkbox" name="shipping" value="1"{% if shipping %} checked{% endif %} /> {{ entry_shipping }}
                              <span data-toggle="tooltip" title="{{ help_shipping }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span>
                            </label>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-2">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-minimum">{{ entry_minimum }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="minimum" value="{{ minimum }}" placeholder="{{ entry_minimum }}" id="input-minimum" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_minimum }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                      <div class="col-sm-2">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-quantity-step">{{ entry_quantity_step }}</label>
                          <div class="dcx-field-icon-wrap">
                            <input type="text" name="quantity_step" value="{{ quantity_step }}" placeholder="{{ entry_quantity_step }}" id="input-quantity-step" class="form-control"/>
                            <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_quantity_step }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="ruler" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_dimensions_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-length">{{ entry_dimension }}</label>
                      <div class="row{% if is_configurable %} dc-opts-axis-hidden{% endif %}">
                        <div class="col-sm-2">
                          <input type="text" name="length" value="{{ length }}" placeholder="{{ entry_length }}" id="input-length" class="form-control"/>
                        </div>
                        <div class="col-sm-2">
                          <input type="text" name="width" value="{{ width }}" placeholder="{{ entry_width }}" id="input-width" class="form-control"/>
                        </div>
                        <div class="col-sm-2">
                          <input type="text" name="height" value="{{ height }}" placeholder="{{ entry_height }}" id="input-height" class="form-control"/>
                        </div>
                        <div class="col-sm-2">
                          <select name="length_class_id" id="input-length-class" class="form-control">
                            {% for length_class in length_classes %}
                              {% if length_class.length_class_id == length_class_id %}
                                <option value="{{ length_class.length_class_id }}" selected="selected">{{ length_class.title }}</option>
                              {% else %}
                                <option value="{{ length_class.length_class_id }}">{{ length_class.title }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-weight">{{ entry_weight }}</label>
                      <div class="row">
                        <div class="col-sm-2">
                          <input type="text" name="weight" value="{{ weight }}" placeholder="{{ entry_weight }}" id="input-weight" class="form-control"/>
                        </div>
                        <div class="col-sm-2">
                          <select name="weight_class_id" id="input-weight-class" class="form-control">
                            {% for weight_class in weight_classes %}
                              {% if weight_class.weight_class_id == weight_class_id %}
                                <option value="{{ weight_class.weight_class_id }}" selected="selected">{{ weight_class.title }}</option>
                              {% else %}
                                <option value="{{ weight_class.weight_class_id }}">{{ weight_class.title }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="image" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_media_title }}</div>

                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_images }}</label>
                      <div class="product-media-gallery">
                        <div class="dc-img-card dc-img-card--main">
                          <a href="" id="thumb-image" data-toggle="image" class="dc-img-link" style="margin:0;"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                          <input type="hidden" name="image" value="{{ image }}" id="input-image"/>
                        </div>
                        <div class="product-media-thumbs">
                          <ul class="nav nav-tabs" id="language-images">
                            <li class="active"><a href="#tab-image-all" data-toggle="tab"><i data-lucide="globe" width="14" height="14"></i> {{ text_all_languages }}</a></li>
                            {% for language in languages %}
                            <li><a href="#tab-image-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                            {% endfor %}
                          </ul>
                          <div class="tab-content" style="padding-top:12px;">
                            {% set image_row = 0 %}
                            <div class="tab-pane active" id="tab-image-all">
                              <div class="product-images" id="product-images-all">
                                {% for product_image in product_images_global %}
                                <div class="dc-img-card" data-row="{{ image_row }}" title="{{ text_drag_to_reorder }}">
                                  <span class="dc-img-card__handle" title="{{ text_drag_to_reorder }}" aria-hidden="true"><i data-lucide="grip-vertical" width="12" height="12" class="slide-drag-handle"></i></span>
                                  <input type="hidden" name="product_image[{{ image_row }}][image]" value="{{ product_image.image }}" id="input-image{{ image_row }}"/>
                                  <input type="hidden" name="product_image[{{ image_row }}][sort_order]" value="{{ product_image.sort_order }}" class="dc-img-sort-order"/>
                                  <input type="hidden" name="product_image[{{ image_row }}][language_id]" value="{{ product_image.language_id }}"/>
                                  <a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="dc-img-link"><img src="{{ product_image.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" draggable="false"/></a>
                                  <button type="button" onclick="removeImage({{ image_row }});" class="dc-img-remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                                </div>
                                {% set image_row = image_row + 1 %}
                                {% endfor %}
                              </div>
                              {% if product_images_global|length > 0 %}
                              <small class="form-text text-muted" style="display:block; margin-bottom:12px;">{{ text_drag_to_reorder }}</small>
                              {% endif %}
                              <button type="button" onclick="addImage('');" class="btn btn-default" style="margin-top:12px;"><i data-lucide="plus" width="14" height="14"></i> {{ button_image_add }}</button>
                            </div>
                            {% for language in languages %}
                            <div class="tab-pane" id="tab-image-{{ language.language_id }}">
                              <div class="product-images" id="product-images-{{ language.language_id }}">
                                {% set lang_images = product_images_by_lang[language.language_id] is defined ? product_images_by_lang[language.language_id] : [] %}
                                {% for product_image in lang_images %}
                                <div class="dc-img-card" data-row="{{ image_row }}" title="{{ text_drag_to_reorder }}">
                                  <span class="dc-img-card__handle" title="{{ text_drag_to_reorder }}" aria-hidden="true"><i data-lucide="grip-vertical" width="12" height="12" class="slide-drag-handle"></i></span>
                                  <input type="hidden" name="product_image[{{ image_row }}][image]" value="{{ product_image.image }}" id="input-image{{ image_row }}"/>
                                  <input type="hidden" name="product_image[{{ image_row }}][sort_order]" value="{{ product_image.sort_order }}" class="dc-img-sort-order"/>
                                  <input type="hidden" name="product_image[{{ image_row }}][language_id]" value="{{ product_image.language_id }}"/>
                                  <a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="dc-img-link"><img src="{{ product_image.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" draggable="false"/></a>
                                  <button type="button" onclick="removeImage({{ image_row }});" class="dc-img-remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                                </div>
                                {% set image_row = image_row + 1 %}
                                {% endfor %}
                              </div>
                              {% if lang_images|length > 0 %}
                              <small class="form-text text-muted" style="display:block; margin-bottom:12px;">{{ text_drag_to_reorder }}</small>
                              {% endif %}
                              <button type="button" onclick="addImage('{{ language.language_id }}');" class="btn btn-default" style="margin-top:12px;"><i data-lucide="plus" width="14" height="14"></i> {{ button_image_add }}</button>
                            </div>
                            {% endfor %}
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_video }}</label>
                      <div class="dc-video-wrapper" style="max-width:500px;">
                        <div class="input-group" style="margin-bottom:8px;">
                          <span class="input-group-addon"><i data-lucide="youtube" width="14" height="14"></i></span>
                          <input type="text" name="video_youtube" value="{{ video_type == 'youtube' ? video : '' }}" id="input-video-youtube" class="form-control" placeholder="{{ entry_video_youtube_placeholder }}" />
                          <span class="input-group-btn">
                            <button type="button" onclick="clearProductVideo()" class="btn btn-default" title="{{ button_remove }}"><i data-lucide="trash-2" width="14" height="14"></i></button>
                          </span>
                        </div>
                        <div id="video-youtube-preview" style="margin-bottom:8px;{{ video_type == 'youtube' and video ? '' : 'display:none;' }}">
                          <img src="{{ (video_type == 'youtube' and video_youtube_id) ? ('https://img.youtube.com/vi/' ~ video_youtube_id ~ '/hqdefault.jpg') : video_placeholder }}" id="video-youtube-thumb-img" style="max-height:90px;border-radius:4px;" data-placeholder="{{ video_placeholder }}" onerror="this.onerror=null;this.src='{{ video_placeholder }}';" />
                          <div style="font-size:11px;color:#6b7280;margin-top:4px;">{{ text_youtube_video }}</div>
                        </div>
                        <div id="video-mp4-block" style="margin-bottom:8px;{{ video_type == 'mp4' and video ? '' : 'display:none;' }}">
                          <div class="dc-video-card">
                            <a href="" id="thumb-product-video" data-toggle="image" data-type="video" class="dc-video-card__link">
                              <img src="{{ video_thumb }}" data-placeholder="{{ video_placeholder }}" class="dc-video-card__img" />
                              <div class="dc-video-card__overlay"{% if not (video_type == 'mp4' and video) %} style="display:none;"{% endif %}>
                                <i data-lucide="film" class="dc-video-card__icon"></i>
                                <span class="dc-video-card__name">{{ video }}</span>
                              </div>
                            </a>
                            <button type="button" onclick="clearProductVideo()" class="dc-video-card__remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                            <input type="hidden" name="video_mp4" value="{{ video }}" id="input-product-video" />
                          </div>
                        </div>
                        <button type="button" onclick="openVideoFileManager();" class="btn btn-default" id="button-browse-mp4"><i data-lucide="folder-open" width="14" height="14"></i> {{ button_browse_mp4 }}</button>
                        <span class="help-block text-muted">{{ help_video_combined }}</span>
                      </div>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_model_3d }}</label>
                      <div class="dc-video-card">
                        <a href="" id="thumb-model-3d" data-toggle="image" data-type="model_3d" class="dc-video-card__link">
                          <img src="{{ model_3d_thumb }}" data-placeholder="{{ model_3d_placeholder }}" class="dc-video-card__img" />
                          <div class="dc-video-card__overlay"{% if not model_3d %} style="display:none;"{% endif %}>
                            <i data-lucide="box" class="dc-video-card__icon"></i>
                            <span class="dc-video-card__name">{{ model_3d }}</span>
                          </div>
                        </a>
                        <button type="button" onclick="clearModel3d()" class="dc-video-card__remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                        <input type="hidden" name="model_3d" value="{{ model_3d }}" id="input-model-3d" />
                      </div>
                      <div class="help-block text-muted" style="margin-top:8px;">{{ help_model_3d }}</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="list-checks" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_attributes_title }} <span data-toggle="tooltip" title="{{ text_help_attributes }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span></div>
                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div id="attributes-container">
                    {% set attribute_row = 0 %}
                    {% for product_attribute in product_attributes %}
                    <div class="dc-attr-row" id="attribute-row{{ attribute_row }}">
                      <div class="dc-attr-row__name">
                        <input type="text" name="product_attribute[{{ attribute_row }}][name]" value="{{ product_attribute.name|e('html_attr') }}" placeholder="{{ entry_attribute }}" class="form-control"/>
                        <input type="hidden" name="product_attribute[{{ attribute_row }}][attribute_id]" value="{{ product_attribute.attribute_id }}"/>
                      </div>
                      <div class="dc-attr-row__values">
                        {% for language in languages %}
                        <div class="dc-attr-row__value">
                          <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                          <input type="text" name="product_attribute[{{ attribute_row }}][product_attribute_description][{{ language.language_id }}][text]" value="{{ (product_attribute.product_attribute_description[language.language_id] ? product_attribute.product_attribute_description[language.language_id].text)|e('html_attr') }}" placeholder="{{ entry_text }}" class="form-control"/>
                        </div>
                        {% endfor %}
                      </div>
                      <button type="button" onclick="$('#attribute-row{{ attribute_row }}').remove();" class="btn btn-link btn-remove-attr" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>
                    </div>
                    {% set attribute_row = attribute_row + 1 %}
                    {% endfor %}
                  </div>
                  <button type="button" onclick="addAttribute();" class="btn btn-primary btn-sm" style="margin-top:8px;">
                    <i data-lucide="plus-circle" width="14" height="14"></i> {{ button_attribute_add }}
                  </button>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
                <div class="dcx-panel-head">
                  <div class="dcx-panel-head__icon"><i data-lucide="list" width="18" height="18"></i></div>
                  <div>
                    <div class="dcx-panel-title">{{ text_panel_options_title }} <span data-toggle="tooltip" title="{{ text_help_options_mode }}"><i data-lucide="help-circle" width="16" height="16" class="text-muted"></i></span></div>
                  </div>
                </div>
                <div class="dcx-panel-body">
                  <div class="dc-option-mode-selector" style="margin-bottom:15px;padding:10px 15px;background:#f7f7f7;border-radius:4px">
                    <label style="margin:0;font-weight:600">{{ entry_option_mode }}:</label>
                    <span id="dc-option-mode-label" class="label {% if is_configurable %}label-primary{% else %}label-default{% endif %}" style="font-size:13px">
                      <i data-lucide="circle" width="10" height="10"></i> {% if is_configurable %}{{ text_mode_combined }}{% else %}{{ text_mode_simple }}{% endif %}
                    </span>
                    <button type="button" id="dc-toggle-mode-btn" class="btn btn-sm btn-default">
                      {% if is_configurable %}
                        <i data-lucide="arrow-left" width="14" height="14"></i> {{ text_switch_to_simple }}
                      {% else %}
                        {{ text_switch_to_combined }} <i data-lucide="arrow-right" width="14" height="14"></i>
                      {% endif %}
                    </button>
                    <span id="dc-mode-saved" style="color:green;display:none;font-size:12px"><i data-lucide="check" width="14" height="14"></i> {{ text_success_mode }}</span>
                  </div>

                  <div id="dc-variants-section" {% if not is_configurable %}style="display:none"{% endif %}>
                    {% include 'catalog/product_variants.twig' %}
                  </div>

                  <div style="margin-top: 30px">
                    <h4>{{ tab_options }} <small id="dc-option-count">({{ product_options|length }})</small></h4>
                    <div id="dc-options-container">
                      {% set option_row = 0 %}
                      {% set option_value_row = 0 %}
                      {% for product_option in product_options %}
                        <div class="dc-option-section{% if product_option.is_axis %} dc-option-axis{% endif %}" id="option-section{{ option_row }}">
                          <div class="dc-option-section__header">
                            <span class="dc-option-section__title">{{ product_option.name }}</span>
                            <span class="dc-option-section__type">({{ product_option.type }})</span>
                            {% if product_option.is_axis %}<span class="dc-axis-badge" title="{{ entry_axis_lock_warning|e('html_attr') }}"><i data-lucide="lock" width="10" height="10"></i> {{ text_variant|e('html') }}</span>{% endif %}
                            <div class="dc-option-section__controls">
                              <label class="dc-option-section__required">
                                <span>{{ entry_required }}:</span>
                                <select name="product_option[{{ option_row }}][required]" class="form-control input-sm"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                  {% if product_option.required %}
                                    <option value="1" selected="selected">{{ text_yes }}</option>
                                    <option value="0">{{ text_no }}</option>
                                  {% else %}
                                    <option value="1">{{ text_yes }}</option>
                                    <option value="0" selected="selected">{{ text_no }}</option>
                                  {% endif %}
                                </select>
                              </label>
                              {% if not product_option.is_axis %}
                              <button type="button" class="btn btn-danger btn-sm" onclick="dcRemoveOption('{{ option_row }}')">
                                <i data-lucide="trash-2" width="14" height="14"></i> {{ button_remove }}
                              </button>
                              {% endif %}
                            </div>
                          </div>
                          {% if product_option.is_axis %}
                          <div class="dc-axis-info-banner"><i data-lucide="info" width="14" height="14"></i> {{ entry_axis_lock_warning }}</div>
                          {% endif %}
                          {% if error_option[product_option.option_id] is defined %}
                          <div class="alert alert-danger" style="margin:5px 15px"><i data-lucide="alert-circle" width="14" height="14"></i> {{ error_option[product_option.option_id] }}</div>
                          {% endif %}
                          <div class="dc-option-section__body">
                            <input type="hidden" name="product_option[{{ option_row }}][product_option_id]" value="{{ product_option.product_option_id }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][name]" value="{{ product_option.name|e('html_attr') }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][option_id]" value="{{ product_option.option_id }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][type]" value="{{ product_option.type }}"/>
                          {% if product_option.type == 'text' %}
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="col-sm-10">
                                <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" id="input-value{{ option_row }}" class="form-control"/>
                              </div>
                            </div>
                          {% endif %}
                          {% if product_option.type == 'textarea' %}
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="col-sm-10">
                                <textarea name="product_option[{{ option_row }}][value]" rows="5" placeholder="{{ entry_option_value }}" id="input-value{{ option_row }}" class="form-control">{{ product_option.value }}</textarea>
                              </div>
                            </div>
                          {% endif %}
                          {% if product_option.type == 'file' %}
                            <div class="form-group" style="display: none;">
                              <label class="col-sm-2 control-label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="col-sm-10">
                                <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" id="input-value{{ option_row }}" class="form-control"/>
                              </div>
                            </div>
                          {% endif %}
                          {% if product_option.type == 'date' %}
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="col-sm-3">
                                <div class="input-group date">
                                  <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" data-date-format="YYYY-MM-DD" id="input-value{{ option_row }}" class="form-control"/> <span class="input-group-btn">
                <button class="btn btn-default" type="button"><i data-lucide="calendar" width="14" height="14"></i></button>
                              </span></div>
                              </div>
                            </div>
                          {% endif %}
                          {% if product_option.type == 'time' %}
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="col-sm-10">
                                <div class="input-group time">
                                  <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" data-date-format="HH:mm" id="input-value{{ option_row }}" class="form-control"/> <span class="input-group-btn">
                              <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                              </span></div>
                              </div>
                            </div>
                          {% endif %}
                          {% if product_option.type == 'datetime' %}
                            <div class="form-group">
                              <label class="col-sm-2 control-label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="col-sm-10">
                                <div class="input-group datetime">
                                  <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-value{{ option_row }}" class="form-control"/> <span class="input-group-btn">
                              <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                              </span></div>
                              </div>
                            </div>
                          {% endif %}
                          {% if product_option.type == 'select' or product_option.type == 'radio' or product_option.type == 'checkbox' or product_option.type == 'image' or product_option.type == 'color' %}
                            <div class="dc-opt-cards" id="option-value{{ option_row }}">
                              {% for product_option_value in product_option.product_option_value %}
                                <div class="dc-opt-card" id="option-value-row{{ option_value_row }}">
                                  <div class="dc-opt-card__header">
                                    <span class="dc-opt-card__handle" title="{{ text_drag_to_reorder }}" aria-hidden="true"><i data-lucide="grip-vertical" width="14" height="14" class="slide-drag-handle"></i></span>
                                    <span class="dc-opt-card__title">{% for ov in option_values[product_option.option_id]|default([]) %}{% if ov.option_value_id == product_option_value.option_value_id %}{{ ov.name }}{% endif %}{% endfor %}</span>
<span class="dc-opt-card__badges">
                                       {% if product_option_value.is_hit %}<span class="dc-opt-badge dc-opt-badge--hit">{{ entry_hit }}</span>{% endif %}
                                       {% if product_option_value.price != 0 %}
                                        <span class="dc-opt-badge dc-opt-badge--price" data-badge="price">{{ product_option_value.price_prefix }}{{ product_option_value.price }}</span>
                                      {% else %}
                                        <span class="dc-opt-badge dc-opt-badge--price" data-badge="price" style="display:none"></span>
                                      {% endif %}
                                    </span>
                                     <button type="button" class="btn btn-danger btn-xs dc-opt-card__remove"{% if product_option.is_axis %} style="display:none"{% endif %} onclick="$(this).closest('.dc-opt-card').remove();" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="minus-circle" width="14" height="14"></i></button>
                                  </div>
                                  <div class="dc-opt-card__body">
                                    <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][product_option_value_id]" value="{{ product_option_value.product_option_value_id }}"/>
                                    <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][is_hit]" value="0"/>
                                    <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][sort_order]" value="{{ option_value_row }}" class="dc-opt-sort-order"/>
<div class="dc-opt-card__grid">
                                        <div class="dc-opt-card__field">
                                          <label>{{ entry_option_value }}</label>
                                          <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][option_value_id]" class="form-control"{% if product_option.is_axis %} disabled="disabled"{% endif %} onchange="dcUpdateCardTitle(this)">
                                           {% if option_values[product_option.option_id] %}
                                             {% for option_value in option_values[product_option.option_id] %}
                                               <option value="{{ option_value.option_value_id }}"{% if option_value.option_value_id == product_option_value.option_value_id %} selected="selected"{% endif %}>{{ option_value.name }}</option>
                                             {% endfor %}
                                           {% endif %}
                                         </select>
                                       </div>
                                        <div class="dc-opt-card__field{% if product_option.is_axis %} dc-opt-card__field--locked{% endif %}">
                                          <label>{{ entry_price }}</label>
                                         <div class="option-value-prefix-group">
                                           <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][price_prefix]" class="form-control option-value-prefix-select"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                             <option value="+"{% if product_option_value.price_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                             <option value="-"{% if product_option_value.price_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                           </select>
                                           <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][price]" value="{{ product_option_value.price }}" placeholder="{{ entry_price }}" class="form-control option-value-prefix-input"{% if product_option.is_axis %} readonly="readonly" data-axis-price="1"{% endif %} oninput="dcUpdateBadges(this)" />
                                         </div>
                                       </div>
                                       <div class="dc-opt-card__field{% if product_option.is_axis %} dc-opt-card__field--locked{% endif %}">
                                         <label>{{ entry_option_points }}</label>
                                         <div class="option-value-prefix-group">
                                           <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][points_prefix]" class="form-control option-value-prefix-select"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                             <option value="+"{% if product_option_value.points_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                             <option value="-"{% if product_option_value.points_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                           </select>
                                           <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][points]" value="{{ product_option_value.points }}" placeholder="{{ entry_points }}" class="form-control option-value-prefix-input"{% if product_option.is_axis %} readonly="readonly"{% endif %} />
                                         </div>
                                       </div>
                                       <div class="dc-opt-card__field{% if product_option.is_axis %} dc-opt-card__field--locked{% endif %}">
                                         <label>{{ entry_weight }}</label>
                                         <div class="option-value-prefix-group">
                                           <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][weight_prefix]" class="form-control option-value-prefix-select"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                             <option value="+"{% if product_option_value.weight_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                             <option value="-"{% if product_option_value.weight_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                           </select>
                                           <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][weight]" value="{{ product_option_value.weight }}" placeholder="{{ entry_weight }}" class="form-control option-value-prefix-input"{% if product_option.is_axis %} readonly="readonly"{% endif %} />
                                        </div>
                                      </div>
                                    </div>
                                    {% if product_option.type == 'color' %}
                                    <div class="dc-opt-card__hit">
                                      <label class="dc-opt-card__hit-label">
                                        <input type="checkbox" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][is_hit]" value="1"{% if product_option_value.is_hit %} checked{% endif %}{% if product_option.is_axis %} disabled="disabled"{% endif %} onchange="$(this).closest('.dc-opt-card').find('input[name$=\\'[is_hit\\']]').val(this.checked ? 1 : 0);dcUpdateHitBadge(this)"/>
                                        <i data-lucide="star" width="14" height="14"></i> {{ entry_hit }}
                                      </label>
                                    </div>
                                    {% endif %}
                                    <div class="dc-opt-card__cg">
                                      <button type="button" class="btn btn-default btn-xs dc-opt-card__cg-toggle" onclick="event.stopPropagation();$(this).closest('.dc-opt-card__cg').find('.dc-opt-card__cg-body').slideToggle(150);">
                                        <i data-lucide="users" width="14" height="14"></i> {{ entry_option_value_cg_price }}
                                      </button>
                                      <div class="dc-opt-card__cg-body" style="display:{% if product_option_value.customer_group_prices|length > 0 %}block{% else %}none{% endif %}">
                                        <div class="dc-cg-prices" id="option-value-cg{{ option_row }}-{{ option_value_row }}">
                                          {% set cg_row = 0 %}
                                          {% for cg_price in product_option_value.customer_group_prices %}
                                            <div class="dc-opt-card__cg-row">
                                              <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][customer_group_price][{{ cg_row }}][customer_group_id]" class="form-control">
                                                {% for customer_group in customer_groups %}
                                                  <option value="{{ customer_group.customer_group_id }}"{% if customer_group.customer_group_id == cg_price.customer_group_id %} selected="selected"{% endif %}>{{ customer_group.name }}</option>
                                                {% endfor %}
                                              </select>
                                              <div class="option-value-prefix-group">
                                                <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][customer_group_price][{{ cg_row }}][price_prefix]" class="form-control option-value-prefix-select">
                                                  <option value="+"{% if cg_price.price_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                                  <option value="-"{% if cg_price.price_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                                </select>
                                                <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][customer_group_price][{{ cg_row }}][price]" value="{{ cg_price.price }}" placeholder="{{ entry_price }}" class="form-control option-value-prefix-input" />
            </div>
