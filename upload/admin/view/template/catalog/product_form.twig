  function loadOptionSet() {
	  var set_id = $('#dc-option-set-select').val();
	  if (!set_id) return;

	  var $existing = $('#dc-options-container .dc-option-section').not('.dc-option-axis');
	  if ($existing.length && !confirm('{{ text_option_set_replace_confirm|e("js") }}')) {
		  return;
	  }

	  $.ajax({
		  url: 'index.php?route=catalog/option_set/getOptions&user_token={{ user_token }}&option_set_id=' + set_id,
		  dataType: 'json',
		  success: function(json) {
			  if (json['error']) {
				  if (typeof showToast === 'function') showToast(json['error'], 'error');
				  return;
			  }

			  if (!json.length) {
				  if (typeof showToast === 'function') showToast('{{ text_option_set_empty|e("js") }}', 'error');
				  return;
			  }

			  $('#dc-options-container .dc-option-section').not('.dc-option-axis').remove();

			  var added = 0;
			  var skipped = 0;

			  $.each(json, function(i, item) {
				  if (!item || !item.option_id) return;
				  if (dcAxisOptionIds.indexOf(parseInt(item.option_id)) >= 0) {
					  skipped++;
					  return;
				  }

				  dcAddOption({
					  label: item['name'],
					  value: item['option_id'],
					  type: item['type'],
					  option_value: item['option_value']
				  });

				  if (item['type'] === 'select' || item['type'] === 'radio' || item['type'] === 'checkbox' || item['type'] === 'image' || item['type'] === 'color') {
					  addAllOptionValues(option_row - 1);
				  }

				  added++;
			  });

			  if (typeof showToast === 'function') {
				  if (added === 0 && skipped > 0) {
					  showToast('{{ text_option_set_axis_skipped|e("js") }}', 'error');
				  } else if (added > 0) {
					  var msg = '{{ text_option_set_loaded|e("js") }}'.replace('%d', added);
					  if (skipped > 0) {
						  msg += ' {{ text_option_set_skipped|e("js") }}'.replace('%d', skipped);
					  }
					  showToast(msg, 'success');
				  }
			  }
			  lucide.createIcons();
		  }
	  });
  }

  var option_value_row = {{ option_value_row }};

  function dcBuildOptionValueCard(option_row, ovRow, optionValueId, optionValueName, price, price_prefix, points, points_prefix, weight, weight_prefix, isHit) {
	  var html = '';
	  var optionType = $('#option-section' + option_row + ' input[name$="[type]"]').val();
	  html += '<div class="dc-opt-card" id="option-value-row' + ovRow + '">';
