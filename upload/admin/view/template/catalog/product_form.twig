  function addOptionValue(option_row) {
	  var $opts = $('#option-values' + option_row);
	  var firstName = $opts.find('option:first').text() || '';
	  var card = dcBuildOptionValueCard(option_row, option_value_row, '', firstName, '', '0', '+', '0', '+', '0', '+', false);
	  $('#option-value' + option_row).append(card);
	  lucide.createIcons();
	  $('[data-toggle="tooltip"]').tooltip();
	  option_value_row++;
  }

  function addAllOptionValues(option_row) {
	  var $sel = $('#option-values' + option_row);
	  var existing = [];
	  $('#option-value' + option_row + ' .dc-opt-card').each(function() {
		  var v = $(this).find('select[name$="[option_value_id]"]').val();
		  if (v) existing.push(v);
	  });
	  $sel.find('option').each(function() {
		  var ovId = $(this).val();
		  var ovName = $(this).text();
		  if (existing.indexOf(ovId) === -1) {
			  var card = dcBuildOptionValueCard(option_row, option_value_row, ovId, ovName, '', '0', '+', '0', '+', '0', '+', false);
			  $('#option-value' + option_row).append(card);
			  lucide.createIcons();
			  option_value_row++;
		  }
	  });
	  lucide.createIcons();
	  $('[data-toggle="tooltip"]').tooltip();
  }

  function addOptionValueCgPrice(button, option_row, option_value_row) {
	  var cg_row = $(button).closest('.dc-opt-card__cg-body').find('.dc-cg-prices > div').length;

	  var html = '<div class="dc-opt-card__cg-row">';
	  html += '  <select name="product_option[' + option_row + '][product_option_value][' + option_value_row + '][customer_group_price][' + cg_row + '][customer_group_id]" class="form-control">';
    {% for customer_group in customer_groups %}
	  html += '    <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name|escape('js') }}</option>';
    {% endfor %}
	  html += '  </select>';
	  html += '  <div class="option-value-prefix-group">';
	  html += '    <select name="product_option[' + option_row + '][product_option_value][' + option_value_row + '][customer_group_price][' + cg_row + '][price_prefix]" class="form-control option-value-prefix-select">';
	  html += '      <option value="+">+</option>';
	  html += '      <option value="-">-</option>';
	  html += '    </select>';
	  html += '    <input type="text" name="product_option[' + option_row + '][product_option_value][' + option_value_row + '][customer_group_price][' + cg_row + '][price]" value="" placeholder="{{ entry_price|e('js') }}" class="form-control option-value-prefix-input" />';
	  html += '  </div>';
	  html += '  <button type="button" onclick="$(this).closest(\'.dc-opt-card__cg-row\').remove();" class="btn btn-danger btn-xs"><i data-lucide="circle-minus" width="14" height="14"></i></button>';
	  html += '</div>';

	  $(button).closest('.dc-opt-card__cg-body').find('.dc-cg-prices').append(html);
	  lucide.createIcons();
  }

  function dcUpdateHitBadge(cb) {
	  var $card = $(cb).closest('.dc-opt-card');
	  var $badges = $card.find('.dc-opt-card__badges');
	  if (cb.checked) {
		  if (!$badges.find('.dc-opt-badge--hit').length) {
			  $badges.prepend('<span class="dc-opt-badge dc-opt-badge--hit">{{ entry_hit|e("js") }}</span>');
		  }
	  } else {
		  $badges.find('.dc-opt-badge--hit').remove();
	  }
  }

  // Every simple option is a collapsible sub-section of the Options panel.
  // The whole header toggles (like the promo variant groups); the required
  // select and the remove button must not.
  $(document).on('click', '.dc-option-section__header', function(e) {
	  var $toggle = $(this).find('.dc-option-section__toggle');
	  if (!$toggle.length || $(e.target).closest('.dc-option-section__controls').length) {
		  return;
	  }
	  var $section = $(this).closest('.dc-option-section');
	  var collapsed = $section.hasClass('dc-option-section--collapsed');
	  $section.toggleClass('dc-option-section--collapsed', !collapsed);
	  $toggle.attr('aria-expanded', collapsed ? 'true' : 'false');
  });

  var dcPromoVariants = {{ promo_variants|json_encode|raw }};
  var dcIsConfigurable = {{ is_configurable ? 'true' : 'false' }};

  var dcPromoTypeMeta = {
	  discount: { icon: 'percent', label: {{ text_promo_discount|json_encode|raw }} },
	  special: { icon: 'star', label: {{ text_promo_special|json_encode|raw }} },
	  gift: { icon: 'gift', label: {{ text_promo_gift|json_encode|raw }} },
	  bxgy: { icon: 'repeat', label: {{ text_promo_bxgy|json_encode|raw }} },
	  bundle: { icon: 'layers', label: {{ text_promo_bundle|json_encode|raw }} }
  };
  var dcPromoTypeOrder = { discount: 0, special: 1, gift: 2, bxgy: 3, bundle: 4 };
  var dcPromoProductLevelLabel = {{ text_promo_product_level|json_encode|raw }};

  function dcPromoTypeOf($card) {
	  var m = ($card.attr('id') || '').match(/^(discount|special|gift|bxgy|bundle)-row/);
	  return m ? m[1] : '';
  }

  function dcPromoIsGrouped() {
	  return dcIsConfigurable && dcPromoVariants.length > 0;
  }

  function dcExpandPromoSection() {
	  $('#dc-promo-section').removeClass('dc-promo-section--collapsed');
	  $('#dc-promo-toggle').attr('aria-expanded', 'true');
  }

  function dcPromoTypeLabelHtml(type) {
	  var meta = dcPromoTypeMeta[type];
	  if (!meta) return '';
	  return '<span class="dc-promo-card__type dc-promo-card__type--' + type + '"><i data-lucide="' + meta.icon + '" width="12" height="12"></i> ' + $('<i>').text(meta.label).html() + '</span>';
  }

  function dcAddPromoTypeLabels() {
	  $('#promo-container .dc-promo-card').each(function() {
		  var $card = $(this);
		  if ($card.children('.dc-promo-card__type').length) return;
		  var html = dcPromoTypeLabelHtml(dcPromoTypeOf($card));
		  if (html) $card.prepend(html);
	  });
  }

  function dcSortPromoCards($scope) {
	  var $cards = $scope.children('.dc-promo-card');
	  // Skip the DOM move when the order is already correct (moving nodes blurs the focused field)
	  var order = $cards.map(function() {
		  var t = dcPromoTypeOrder[dcPromoTypeOf($(this))];
		  return t === undefined ? 99 : t;
	  }).get();
	  var sorted = true;
	  for (var i = 1; i < order.length; i++) {
		  if (order[i] < order[i - 1]) { sorted = false; break; }
	  }
	  if (sorted) return;
	  $cards.sort(function(a, b) {
		  var ta = dcPromoTypeOrder[dcPromoTypeOf($(a))];
		  var tb = dcPromoTypeOrder[dcPromoTypeOf($(b))];
		  if (ta === undefined) ta = 99;
		  if (tb === undefined) tb = 99;
		  return ta - tb;
	  });
	  $cards.appendTo($scope);
  }

  function dcFocusPromoCard($card) {
	  if (!$card || !$card.length) return;
	  setTimeout(function() {
		  var $field = $card.find('input, select').filter(function() {
			  return $(this).is(':visible') && $(this).attr('type') !== 'hidden';
		  }).first();
		  if ($field.length) $field.trigger('focus');
	  }, 0);
  }

  function dcEnsureProductLevelLabel() {
	  var $container = $('#promo-container');
	  var $label = $container.children('.dc-promo-group-label');
	  var $product = $container.children('.dc-promo-card').filter(function() {
		  var t = dcPromoTypeOf($(this));
		  return t === 'gift' || t === 'bxgy' || t === 'bundle';
	  });
	  if (dcPromoIsGrouped() && $product.length) {
		  if (!$label.length) {
			  $product.first().before('<div class="dc-promo-group-label"><i data-lucide="package" width="14" height="14"></i> ' + $('<i>').text(dcPromoProductLevelLabel).html() + '</div>');
			  lucide.createIcons();
		  }
	  } else if ($label.length) {
		  $label.remove();
	  }
  }

  function dcOrganizePromoCards() {
	  dcAddPromoTypeLabels();
	  if (dcPromoIsGrouped()) {
		  dcBuildVariantGroups();
	  }
	  dcSortPromoCards($('#promo-container'));
  }

  function dcUpdatePromoEmptyState() {
	  var total = $('#promo-container .dc-promo-card').length;
	  var $empty = $('#promo-empty');
	  $('#promo-container').append($empty);
	  $empty.toggle(total === 0 && !dcPromoIsGrouped());
  }

  // Reference date (server side) used to tell running / expired / scheduled promotions apart
  var dcPromoToday = '{{ promo_today }}';

  function dcPromoCardState($card) {
	  var ds = (($card.find('input[name$="[date_start]"]').first().val()) || '').trim();
	  var de = (($card.find('input[name$="[date_end]"]').first().val()) || '').trim();
	  if (ds === '0000-00-00') ds = '';
	  if (de === '0000-00-00') de = '';
	  if (de && de < dcPromoToday) return 'expired';
	  if (ds && ds > dcPromoToday) return 'scheduled';
	  return 'active';
  }

  function dcUpdatePromoStats() {
	  var active = 0, expired = 0, scheduled = 0;
	  $('#promo-container .dc-promo-card').each(function() {
		  var $card = $(this);
		  var state = dcPromoCardState($card);
		  if (state === 'expired') {
			  expired++;
		  } else if (state === 'scheduled') {
			  scheduled++;
		  } else {
			  active++;
		  }
		  $card.toggleClass('dc-promo-card--expired', state === 'expired');
		  if ($card.attr('data-promo-state') !== state) {
			  $card.attr('data-promo-state', state);
			  var $badge = $card.find('.dc-promo-card__state');
			  if (state === 'expired') {
				  if (!$badge.length) {
					  $badge = $('<span class="dc-promo-card__state"><i data-lucide="triangle-alert" width="11" height="11"></i> {{ text_promo_expired_badge|e('js') }}</span>');
					  $card.children('.dc-promo-card__actions').prepend($badge);
					  lucide.createIcons();
				  }
			  } else {
				  $badge.remove();
			  }
		  }
	  });
	  var $active = $('#dc-promo-active-count');
	  $active.find('.dc-promo-stat__num').text(active);
	  $active.prop('hidden', active === 0);
	  var $expired = $('#dc-promo-expired-count');
	  $expired.find('.dc-promo-stat__num').text(expired);
	  $expired.prop('hidden', expired === 0);
	  var $scheduled = $('#dc-promo-scheduled-count');
	  $scheduled.find('.dc-promo-stat__num').text(scheduled);
	  $scheduled.prop('hidden', scheduled === 0);
  }

  function dcRefreshPromoState() {
	  dcAddPromoTypeLabels();
	  dcSortPromoCards($('#promo-container'));
	  var total = $('#promo-container .dc-promo-card').length;
	  $('#promo-variant-controls').prop('hidden', !(dcPromoIsGrouped() && dcPromoVariants.length > 1));
	  if (dcPromoIsGrouped()) {
		  dcUpdateVariantGroupCounts();
	  }
	  dcEnsureProductLevelLabel();
	  dcUpdatePromoStats();
	  dcUpdatePromoEmptyState();
  }

  function dcClosePromoAddMenu() {
	  $('#promo-add-menu').prop('hidden', true);
	  $('#promo-add-btn').attr('aria-expanded', 'false');
  }

  function dcBuildPromoAddMenu() {
	  var $grouped = $('#promo-add-menu [data-promo-add="discount"], #promo-add-menu [data-promo-add="special"]');
	  $grouped.prop('hidden', dcPromoIsGrouped());
  }

  $(document).on('click', '#dc-promo-toggle', function() {
	  var $section = $('#dc-promo-section');
	  $section.toggleClass('dc-promo-section--collapsed');
	  $(this).attr('aria-expanded', $section.hasClass('dc-promo-section--collapsed') ? 'false' : 'true');
  });

  // Reward points live in a collapsible sub-section of the Pricing panel.
  function dcRewardsHasValues() {
	  if ((parseInt($('#input-points').val(), 10) || 0) > 0) {
		  return true;
	  }
	  var has = false;
	  $('#dc-rewards-body input[name^="product_reward"]').each(function() {
		  if ((parseInt($(this).val(), 10) || 0) > 0) {
			  has = true;
			  return false;
		  }
	  });
	  return has;
  }

  function dcSetRewardsExpanded(expanded) {
	  $('#dc-rewards-section').toggleClass('dc-rewards-section--collapsed', !expanded);
	  $('#dc-rewards-toggle').attr('aria-expanded', expanded ? 'true' : 'false');
  }

  $(document).on('click', '#dc-rewards-toggle', function() {
	  dcSetRewardsExpanded($('#dc-rewards-section').hasClass('dc-rewards-section--collapsed'));
  });

  // Products that already use points open the section right away.
  $(document).ready(function() {
	  if (dcRewardsHasValues()) {
		  dcSetRewardsExpanded(true);
	  }
  });

  // Keep the active / expired / scheduled counters in sync while the dates are edited
  $(document).on('change keyup', '#promo-container input[name$="[date_start]"], #promo-container input[name$="[date_end]"]', function() {
	  dcUpdatePromoStats();
  });

  $(document).on('click', '#promo-add-btn', function(e) {
	  e.stopPropagation();
	  if ($('#promo-add-menu').prop('hidden')) {
		  $('#promo-add-menu').prop('hidden', false);
		  $(this).attr('aria-expanded', 'true');
	  } else {
		  dcClosePromoAddMenu();
	  }
  });

  $(document).on('click', '#promo-add-menu [data-promo-add]', function(e) {
	  e.stopPropagation();
	  dcClosePromoAddMenu();
	  addPromoCard($(this).data('promo-add'));
  });

  $(document).on('click', function(e) {
	  if (!$(e.target).closest('#promo-add-wrap').length) {
		  dcClosePromoAddMenu();
	  }
  });

  dcOrganizePromoCards();
  dcBuildPromoAddMenu();
  dcRefreshPromoState();
  lucide.createIcons();

  function removePromoCard(cardId) {
	  var $card = $('#' + cardId);
	  var $group = $card.closest('.dc-variant-promo-group');
	  $card.remove();
	  if ($group.length) {
		  dcUpdateVariantGroupCounts();
	  }
	  dcRefreshPromoState();
  }

  function addPromoCard(type) {
	  dcExpandPromoSection();
	  if (type === 'discount') addDiscount();
	  else if (type === 'special') addSpecial();
	  else if (type === 'gift') addGift();
	  else if (type === 'bxgy') addBxgy();
	  else if (type === 'bundle') addBundle();
	  dcRefreshPromoState();
  }

  function dcPromoVariantFieldHtml(inputName, selectedId) {
    if (!dcIsConfigurable || !dcPromoVariants.length) {
      return '';
    }

    var html = '    <div class="dc-promo-card__field dc-promo-card__field--wide">';
    html += '      <label>{{ entry_variant }}</label>';
    html += '      <select name="' + inputName + '" class="form-control">';

    for (var i = 0; i < dcPromoVariants.length; i++) {
      var vLabel = dcPromoVariants[i].label + (dcPromoVariants[i].is_default ? ' {{ text_variant_is_default|escape('js') }}' : '');
      var sel = (selectedId && parseInt(selectedId) === parseInt(dcPromoVariants[i].variant_id)) ? ' selected="selected"' : '';
      html += '        <option value="' + dcPromoVariants[i].variant_id + '"' + sel + '>' + $('<i>').text(vLabel).html() + '</option>';
    }

    html += '      </select>';
    html += '    </div>';

    return html;
  }

  function dcGetVariantLabel(variantId) {
    for (var i = 0; i < dcPromoVariants.length; i++) {
      if (parseInt(dcPromoVariants[i].variant_id) === parseInt(variantId)) return dcPromoVariants[i].label;
    }
    return '#' + variantId;
  }

  function dcUpdateVariantGroupCounts() {
	  $('#promo-container .dc-variant-promo-group').each(function() {
		  var $group = $(this);
		  var $body = $group.find('.dc-variant-promo-group__body');
		  var n = $body.find('.dc-promo-card').length;
		  var $cnt = $group.find('.dc-variant-promo-group__count').first();
		  $cnt.text(n);
		  $cnt.toggleClass('dc-variant-promo-group__count--zero', n === 0);
		  var $empty = $body.find('.dc-variant-promo-group__empty');
		  if (n === 0 && !$empty.length) {
			  $body.find('.dc-variant-promo-group__add').before('<div class="dc-variant-promo-group__empty">{{ text_variant_group_empty|e('js') }}</div>');
		  } else if (n > 0 && $empty.length) {
			  $empty.remove();
		  }
	  });
  }

  function dcVariantGroupAddHtml(variantId) {
	  return '<div class="dc-variant-promo-group__add">'
		  + '<button type="button" class="btn btn-default btn-xs" onclick="addPromoForVariant(\'discount\',' + variantId + ')"><i data-lucide="percent" width="12" height="12"></i> {{ text_promo_discount|e('js') }}</button>'
		  + '<button type="button" class="btn btn-default btn-xs" onclick="addPromoForVariant(\'special\',' + variantId + ')"><i data-lucide="star" width="12" height="12"></i> {{ text_promo_special|e('js') }}</button>'
		  + '</div>';
  }

  function dcBindVariantGroupEvents() {
	  $(document).off('click.dcVariantGroup').on('click.dcVariantGroup', '#promo-container .dc-variant-promo-group__header', function() {
		  $(this).closest('.dc-variant-promo-group').toggleClass('dc-variant-promo-group--collapsed');
	  });
	  $(document).off('click.dcVariantExpand').on('click.dcVariantExpand', '.dc-variant-expand-all', function() {
		  $('#promo-container .dc-variant-promo-group').removeClass('dc-variant-promo-group--collapsed');
	  });
	  $(document).off('click.dcVariantCollapse').on('click.dcVariantCollapse', '.dc-variant-collapse-all', function() {
		  $('#promo-container .dc-variant-promo-group').addClass('dc-variant-promo-group--collapsed');
	  });
	  $(document).off('change.dcVariantMove').on('change.dcVariantMove', '#promo-container .dc-promo-card select[name$="[variant_id]"]', function() {
		  var $sel = $(this);
		  var $card = $sel.closest('.dc-promo-card');
		  var newVid = parseInt($sel.val()) || 0;
		  var $targetGroup = $('#promo-container .dc-variant-promo-group[data-variant-id="' + newVid + '"]');
		  if (!$targetGroup.length) return;
		  var $targetBody = $targetGroup.find('.dc-variant-promo-group__body');
		  var $targetAdd = $targetBody.find('.dc-variant-promo-group__add');
		  if ($targetAdd.length) $card.insertBefore($targetAdd); else $targetBody.append($card);
		  dcUpdateVariantGroupCounts();
		  dcRefreshPromoState();
