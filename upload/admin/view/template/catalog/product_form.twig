  <script type="text/javascript"><!--
  var attribute_row = {{ attribute_row }};

  function addAttribute() {
	  var html = '<div class="dc-attr-row" id="attribute-row' + attribute_row + '">';
	  html += '  <div class="dc-attr-row__name">';
	  html += '      <input type="text" name="product_attribute[' + attribute_row + '][name]" value="" placeholder="{{ entry_attribute }}" class="form-control"/>';
	  html += '      <input type="hidden" name="product_attribute[' + attribute_row + '][attribute_id]" value=""/>';
	  html += '  </div>';
	  html += '  <div class="dc-attr-row__values">';
    {% for language in languages %}
	  html += '    <div class="dc-attr-row__value">';
	  html += '      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>';
	  html += '      <input type="text" name="product_attribute[' + attribute_row + '][product_attribute_description][{{ language.language_id }}][text]" value="" placeholder="{{ entry_text }}" class="form-control"/>';
	  html += '    </div>';
    {% endfor %}
	  html += '  </div>';
	  html += '  <button type="button" onclick="$(\'#attribute-row' + attribute_row + '\').remove();" class="btn btn-link btn-remove-attr" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>';
	  html += '</div>';

	  $('#attributes-container').append(html);
	  lucide.createIcons();

	  attributeautocomplete(attribute_row);

	  attribute_row++;
  }

  function attributeautocomplete(attribute_row) {
	  $('input[name=\'product_attribute[' + attribute_row + '][name]\']').autocomplete({
		  'source': function(request, response) {
			  $.ajax({
				  url: 'index.php?route=catalog/attribute/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
				  dataType: 'json',
				  success: function(json) {
					  response($.map(json, function(item) {
						  return {
							  category: item.attribute_group,
							  label: item.name,
							  value: item.attribute_id
						  }
					  }));
				  }
			  });
		  },
		  'select': function(item) {
			  $('input[name=\'product_attribute[' + attribute_row + '][name]\']').val(item['label']);
			  $('input[name=\'product_attribute[' + attribute_row + '][attribute_id]\']').val(item['value']);
		  }
	  });
  }

  $('#attributes-container .dc-attr-row').each(function(index, element) {
	  attributeautocomplete(index);
  });
  //--></script>
  <script type="text/javascript"><!--
  var option_row = {{ option_row }};
  var dcOptionMode = {{ is_configurable ? "'combined'" : "'simple'" }};
  var dcAxisOptionIds = {{ axis_option_ids|json_encode|raw }};

  function dcUpdateSpecialNote() {
    var note = $('#dc-special-note-configurable');
    if (dcOptionMode === 'combined') {
      note.show();
    } else {
      note.hide();
    }
  }

  $(document).ready(function() {
    if (dcOptionMode === 'combined') {
      loadVariantMatrix();
    }

    dcUpdateSpecialNote();

    $('#dc-toggle-mode-btn').on('click', function() {
      var newMode = (dcOptionMode === 'simple') ? 'combined' : 'simple';

      if (newMode === 'simple') {
        if (!confirm('{{ text_confirm_switch_to_simple|e("js") }}')) {
          return;
        }
      }

      var productId = getDcProductId();

      if (!productId || productId == '0') {
        alert('{{ text_save_product_first|e("js") }}');
        return;
      }

      $.ajax({
        url: 'index.php?route=catalog/product_configurable/setMode&user_token={{ user_token }}',
        type: 'POST',
        data: {product_id: productId, mode: newMode},
        dataType: 'json',
        success: function(json) {
          if (json.error) {
            alert(json.error);
            return;
          }

          dcOptionMode = newMode;

          var $simpleOptions = $('.dc-option-mode-selector').closest('.dcx-panel-body').find('.row:first');
          var $axes = $('.dc-option-axis', $simpleOptions);

          if (newMode === 'simple') {
            $simpleOptions.removeClass('dc-opts-axis-hidden');
            $axes.find(':input').prop('disabled', false);
            $('#dc-variants-section').hide();
          } else {
            $simpleOptions.addClass('dc-opts-axis-hidden');
            $axes.find(':input').prop('disabled', true);
            $('#dc-variants-section').show();
            loadVariantMatrix();
          }

          $('#dc-mode-saved').fadeIn(200).delay(1500).fadeOut(400);

          var newLabel = newMode === 'combined' ? '{{ text_mode_combined }}' : '{{ text_mode_simple }}';
          var newBtnHtml = newMode === 'combined'
            ? '<i data-lucide="arrow-left" width="14" height="14"></i> {{ text_switch_to_simple }}'
            : '{{ text_switch_to_combined }} <i data-lucide="arrow-right" width="14" height="14"></i>';
          var newSpanClass = newMode === 'combined' ? 'label-primary' : 'label-default';

          $('#dc-toggle-mode-btn').html(newBtnHtml);
          $('#dc-option-mode-label').removeClass('label-primary label-default').addClass(newSpanClass).html('<i data-lucide="circle" width="10" height="10"></i> ' + newLabel);
          lucide.createIcons();
          dcUpdateSpecialNote();
        }
      });
    });

    $('#form-product').on('submit', dcValidateAxisPrices);

    var $optTree = $('.dc-opt-add .dcx-tree-select');
    if ($optTree.length) {
      var setOptFilter = function() {
        var inst = $optTree.data('dcx-tree-select');
        if (!inst || inst.filterCallback) return;
        inst.filterCallback = function(data) {
          var existingIds = [];
          $('#dc-options-container input[name$="[option_id]"]').each(function() {
            var val = parseInt($(this).val());
            if (val) existingIds.push(val);
          });
          return data.filter(function(item) {
            return existingIds.indexOf(parseInt(item.category_id)) === -1;
          });
        };
      };
      setTimeout(setOptFilter, 100);
      $(document).one('click', '.dc-opt-add .dcx-tree-select', function() {
        setOptFilter();
      });
    }

    $('[data-toggle="tooltip"]').tooltip({ container: 'body', html: true });

    $('#product-category').toggle($('#product-category .dcx-tree-select__well-item').length > 0);
    $('#product-download').toggle($('#product-download .dcx-tree-select__well-item').length > 0);
  });

  function dcValidateAxisPrices() {
    if (dcOptionMode !== 'combined') return true;

    $('.dc-option-axis [data-axis-price="1"]').each(function() {
      if (parseFloat($(this).val()) > 0) {
        $(this).val(0);
      }
    });

    return true;
  }

  function dcRemoveOption(option_row) {
	  var $section = $('#option-section' + option_row);
	  if ($section.hasClass('dc-option-axis')) {
		  showToast('{{ error_simple_option_is_axis|e("js") }}', 'error');
		  return;
	  }
	  $section.remove();
	  updateOptionCount();
  }

  function updateOptionCount() {
	  var count = $('#dc-options-container .dc-option-section').length;
	  $('#dc-option-count').text('(' + count + ')');
  }

  $(document).on('change', '.dc-opt-add .dcx-tree-select input[type="hidden"]', function() {
	  var optionId = parseInt($(this).val());
	  if (!optionId || optionId <= 0) return;

	  var $treeSelect = $(this).closest('.dcx-tree-select');

	  if (dcAxisOptionIds.indexOf(optionId) >= 0) {
		  showToast('{{ error_simple_option_is_axis|e("js") }}', 'error');
		  dcResetTreeSelect($treeSelect);
		  return;
	  }

	  var existingIds = [];
	  $('#dc-options-container input[name$="[option_id]"]').each(function() {
		  var val = parseInt($(this).val());
		  if (val) existingIds.push(val);
	  });

	  if (existingIds.indexOf(optionId) >= 0) {
		  showToast('{{ error_option_already_added|e("js") }}', 'error');
		  dcResetTreeSelect($treeSelect);
		  return;
	  }

	  var optionName = $treeSelect.find('.dcx-tree-select__input').val();

	  $.ajax({
		  url: 'index.php?route=catalog/option/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(optionName),
		  dataType: 'json',
		  success: function(json) {
			  var matched = null;
			  for (var i = 0; i < json.length; i++) {
				  if (parseInt(json[i].option_id) === optionId) {
					  matched = json[i];
					  break;
				  }
			  }
			  if (!matched) return;

			  var item = {
				  label: matched.name,
				  value: matched.option_id,
				  type: matched.type,
				  option_value: matched.option_value
			  };

			  dcAddOption(item);
			  dcResetTreeSelect($treeSelect);
		  }
	  });
  });

  function dcResetTreeSelect($treeSelect) {
	  $treeSelect.find('input[type="hidden"]').val('');
	  $treeSelect.find('.dcx-tree-select__input').val('');
  }

  function dcAddOption(item) {
	  var html = '';
	  html += '<div class="dc-option-section" id="option-section' + option_row + '">';
	  html += '  <div class="dc-option-section__header">';
	  html += '    <span class="dc-option-section__title">' + item['label'] + '</span>';
	  html += '    <span class="dc-option-section__type">(' + item['type'] + ')</span>';
	  html += '    <div class="dc-option-section__controls">';
	  html += '      <label class="dc-option-section__required">';
	  html += '        <span>{{ entry_required|e('js') }}:</span>';
	  html += '        <select name="product_option[' + option_row + '][required]" class="form-control input-sm">';
	  html += '          <option value="1">{{ text_yes|e('js') }}</option>';
	  html += '          <option value="0">{{ text_no|e('js') }}</option>';
	  html += '        </select>';
	  html += '      </label>';
	  html += '      <button type="button" class="btn btn-danger btn-sm" onclick="dcRemoveOption(\'' + option_row + '\');">';
	  html += '        <i data-lucide="trash-2" width="14" height="14"></i> {{ button_remove|e('js') }}';
	  html += '      </button>';
	  html += '    </div>';
	  html += '  </div>';
	  html += '  <div class="dc-option-section__body">';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][product_option_id]" value="" />';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][name]" value="' + item['label'] + '" />';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][option_id]" value="' + item['value'] + '" />';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][type]" value="' + item['type'] + '" />';

	  if (item['type'] == 'text') {
		  html += '    <div class="form-group">';
		  html += '      <label class="col-sm-2 control-label" for="input-value' + option_row + '">{{ entry_option_value|e('js') }}</label>';
		  html += '      <div class="col-sm-10"><input type="text" name="product_option[' + option_row + '][value]" value="" placeholder="{{ entry_option_value|e('js') }}" id="input-value' + option_row + '" class="form-control" /></div>';
		  html += '    </div>';
	  }

	  if (item['type'] == 'textarea') {
		  html += '    <div class="form-group">';
		  html += '      <label class="col-sm-2 control-label" for="input-value' + option_row + '">{{ entry_option_value|e('js') }}</label>';
		  html += '      <div class="col-sm-10"><textarea name="product_option[' + option_row + '][value]" rows="5" placeholder="{{ entry_option_value|e('js') }}" id="input-value' + option_row + '" class="form-control"></textarea></div>';
		  html += '    </div>';
	  }

	  if (item['type'] == 'file') {
		  html += '    <div class="form-group" style="display: none;">';
		  html += '      <label class="col-sm-2 control-label" for="input-value' + option_row + '">{{ entry_option_value|e('js') }}</label>';
		  html += '      <div class="col-sm-10"><input type="text" name="product_option[' + option_row + '][value]" value="" placeholder="{{ entry_option_value|e('js') }}" id="input-value' + option_row + '" class="form-control" /></div>';
		  html += '    </div>';
	  }

	  if (item['type'] == 'date') {
		  html += '    <div class="form-group">';
		  html += '      <label class="col-sm-2 control-label" for="input-value' + option_row + '">{{ entry_option_value|e('js') }}</label>';
		  html += '      <div class="col-sm-3"><div class="input-group date"><input type="text" name="product_option[' + option_row + '][value]" value="" placeholder="{{ entry_option_value|e('js') }}" data-date-format="YYYY-MM-DD" id="input-value' + option_row + '" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div></div>';
		  html += '    </div>';
	  }

	  if (item['type'] == 'time') {
		  html += '    <div class="form-group">';
		  html += '      <label class="col-sm-2 control-label" for="input-value' + option_row + '">{{ entry_option_value|e('js') }}</label>';
		  html += '      <div class="col-sm-10"><div class="input-group time"><input type="text" name="product_option[' + option_row + '][value]" value="" placeholder="{{ entry_option_value|e('js') }}" data-date-format="HH:mm" id="input-value' + option_row + '" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div></div>';
		  html += '    </div>';
	  }

	  if (item['type'] == 'datetime') {
		  html += '    <div class="form-group">';
		  html += '      <label class="col-sm-2 control-label" for="input-value' + option_row + '">{{ entry_option_value|e('js') }}</label>';
		  html += '      <div class="col-sm-10"><div class="input-group datetime"><input type="text" name="product_option[' + option_row + '][value]" value="" placeholder="{{ entry_option_value|e('js') }}" data-date-format="YYYY-MM-DD HH:mm" id="input-value' + option_row + '" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div></div>';
		  html += '    </div>';
	  }

	  if (item['type'] == 'select' || item['type'] == 'radio' || item['type'] == 'checkbox' || item['type'] == 'image' || item['type'] == 'color') {
		  html += '    <div class="dc-opt-cards" id="option-value' + option_row + '"></div>';
		  html += '    <div class="dc-opt-actions">';
		  html += '      <button type="button" class="btn btn-primary btn-sm" onclick="addOptionValue(\'' + option_row + '\');"><i data-lucide="plus-circle" width="14" height="14"></i> {{ button_option_value_add|e('js') }}</button>';
		  html += '      <button type="button" class="btn btn-default btn-sm" onclick="addAllOptionValues(\'' + option_row + '\');"><i data-lucide="plus-square" width="14" height="14"></i> {{ button_add_all_values|e('js') }}</button>';
		  html += '    </div>';

		  html += '    <select id="option-values' + option_row + '" style="display: none;">';
		  for (var i = 0; i < item['option_value'].length; i++) {
			  html += '    <option value="' + item['option_value'][i]['option_value_id'] + '">' + item['option_value'][i]['name'] + '</option>';
		  }
		  html += '    </select>';
	  }

	  html += '  </div>';
	  html += '</div>';

	  $('#dc-options-container').append(html);
	  lucide.createIcons();
	  updateOptionCount();

	  $('[data-toggle=\'tooltip\']').tooltip({
		  container: 'body',
		  html: true
	  });

	  $('.date').datetimepicker({
		  language: '{{ datepicker }}',
		  pickTime: false
	  });

	  $('.time').datetimepicker({
		  language: '{{ datepicker }}',
		  pickDate: false
	  });

	  $('.datetime').datetimepicker({
		  language: '{{ datepicker }}',
		  pickDate: true,
		  pickTime: true
	  });

	  option_row++;
  }

  //--></script>
  <script type="text/javascript"><!--
  var option_value_row = {{ option_value_row }};

  function dcBuildOptionValueCard(option_row, ovRow, optionValueId, optionValueName, price, price_prefix, points, points_prefix, weight, weight_prefix, isHit) {
	  var html = '';
	  var optionType = $('#option-section' + option_row + ' input[name$="[type]"]').val();
	  html += '<div class="dc-opt-card" id="option-value-row' + ovRow + '">';
	  html += '  <div class="dc-opt-card__header">';
  html += '    <span class="dc-opt-card__handle" title="{{ text_drag_to_reorder }}" aria-hidden="true"><i data-lucide="grip-vertical" width="14" height="14" class="slide-drag-handle"></i></span>';
	  html += '    <span class="dc-opt-card__title">' + (optionValueName || '') + '</span>';
	  html += '    <span class="dc-opt-card__badges">';
	  if (isHit) {
		  html += '      <span class="dc-opt-badge dc-opt-badge--hit">{{ entry_hit|e('js') }}</span>';
	  }
	  if (parseFloat(price) != 0) {
		  html += '      <span class="dc-opt-badge dc-opt-badge--price" data-badge="price">' + price_prefix + price + '</span>';
	  } else {
		  html += '      <span class="dc-opt-badge dc-opt-badge--price" data-badge="price" style="display:none"></span>';
	  }
	  html += '    </span>';
	  html += '    <button type="button" class="btn btn-danger btn-xs dc-opt-card__remove" onclick="$(this).closest(\'.dc-opt-card\').remove();" data-toggle="tooltip" title="{{ button_remove|e('js') }}"><i data-lucide="minus-circle" width="14" height="14"></i></button>';
	  html += '  </div>';
	  html += '  <div class="dc-opt-card__body">';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][product_option_value_id]" value="" />';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][is_hit]" value="0" />';
	  html += '    <input type="hidden" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][sort_order]" value="' + ovRow + '" class="dc-opt-sort-order" />';
	  html += '    <div class="dc-opt-card__grid">';
	  html += '      <div class="dc-opt-card__field">';
	  html += '        <label>{{ entry_option_value|e('js') }}</label>';
	  html += '        <select name="product_option[' + option_row + '][product_option_value][' + ovRow + '][option_value_id]" class="form-control" onchange="dcUpdateCardTitle(this)">';
	  var optsHtml = $('#option-values' + option_row).html();
	  if (optionValueId) {
		  optsHtml = optsHtml.replace(/value="([^"]*)"/g, function(match, val) {
			  return val == optionValueId ? 'value="' + val + '" selected="selected"' : match;
		  });
	  }
	  html += optsHtml;
	  html += '        </select>';
	  html += '      </div>';
	  html += '      <div class="dc-opt-card__field">';
	  html += '        <label>{{ entry_price|e('js') }}</label>';
	  html += '        <div class="option-value-prefix-group">';
	  html += '          <select name="product_option[' + option_row + '][product_option_value][' + ovRow + '][price_prefix]" class="form-control option-value-prefix-select">';
	  html += '            <option value="+"' + (price_prefix == '+' ? ' selected="selected"' : '') + '>+</option>';
	  html += '            <option value="-"' + (price_prefix == '-' ? ' selected="selected"' : '') + '>-</option>';
	  html += '          </select>';
	  html += '          <input type="text" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][price]" value="' + price + '" placeholder="{{ entry_price|e('js') }}" class="form-control option-value-prefix-input" oninput="dcUpdateBadges(this)" />';
	  html += '        </div>';
	  html += '      </div>';
	  html += '      <div class="dc-opt-card__field">';
	  html += '        <label>{{ entry_option_points|e('js') }}</label>';
	  html += '        <div class="option-value-prefix-group">';
	  html += '          <select name="product_option[' + option_row + '][product_option_value][' + ovRow + '][points_prefix]" class="form-control option-value-prefix-select">';
	  html += '            <option value="+"' + (points_prefix == '+' ? ' selected="selected"' : '') + '>+</option>';
	  html += '            <option value="-"' + (points_prefix == '-' ? ' selected="selected"' : '') + '>-</option>';
	  html += '          </select>';
	  html += '          <input type="text" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][points]" value="' + points + '" placeholder="{{ entry_points|e('js') }}" class="form-control option-value-prefix-input" />';
	  html += '        </div>';
	  html += '      </div>';
	  html += '      <div class="dc-opt-card__field">';
	  html += '        <label>{{ entry_weight|e('js') }}</label>';
	  html += '        <div class="option-value-prefix-group">';
	  html += '          <select name="product_option[' + option_row + '][product_option_value][' + ovRow + '][weight_prefix]" class="form-control option-value-prefix-select">';
	  html += '            <option value="+"' + (weight_prefix == '+' ? ' selected="selected"' : '') + '>+</option>';
	  html += '            <option value="-"' + (weight_prefix == '-' ? ' selected="selected"' : '') + '>-</option>';
	  html += '          </select>';
	  html += '          <input type="text" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][weight]" value="' + weight + '" placeholder="{{ entry_weight|e('js') }}" class="form-control option-value-prefix-input" />';
	  html += '        </div>';
	  html += '      </div>';
	  html += '    </div>';
	  if (optionType === 'color') {
		  html += '    <div class="dc-opt-card__hit">';
		  html += '      <label class="dc-opt-card__hit-label">';
		  html += '        <input type="checkbox" name="product_option[' + option_row + '][product_option_value][' + ovRow + '][is_hit]" value="1" onchange="$(this).closest(\'.dc-opt-card\').find(\'input[name$=\\\'[is_hit\\\']\').val(this.checked ? 1 : 0);dcUpdateHitBadge(this)" />';
		  html += '        <i data-lucide="star" width="14" height="14"></i> {{ entry_hit|e('js') }}';
		  html += '      </label>';
		  html += '    </div>';
	  }
	  html += '    <div class="dc-opt-card__cg">';
	  html += '      <button type="button" class="btn btn-default btn-xs dc-opt-card__cg-toggle" onclick="event.stopPropagation();$(this).closest(\'.dc-opt-card__cg\').find(\'.dc-opt-card__cg-body\').slideToggle(150);">';
	  html += '        <i data-lucide="users" width="14" height="14"></i> {{ entry_option_value_cg_price|e('js') }}';
	  html += '      </button>';
	  html += '      <div class="dc-opt-card__cg-body" style="display:none">';
	  html += '        <div class="dc-cg-prices" id="option-value-cg' + option_row + '-' + ovRow + '"></div>';
	  html += '        <button type="button" class="btn btn-primary btn-xs" style="margin-top:4px;" onclick="addOptionValueCgPrice(this, \'' + option_row + '\', \'' + ovRow + '\');"><i data-lucide="plus-circle" width="14" height="14"></i> {{ button_option_value_cg_price_add|e('js') }}</button>';
	  html += '      </div>';
	  html += '    </div>';
	  html += '  </div>';
	  html += '</div>';

	  return html;
  }

  function addOptionValue(option_row) {
	  var $opts = $('#option-values' + option_row);
	  var firstName = $opts.find('option:first').text() || '';
	  var card = dcBuildOptionValueCard(option_row, option_value_row, '', firstName, '', '0', '+', '0', '+', '0', '+', false);
	  $('#option-value' + option_row).append(card);
	  lucide.createIcons();
	  $('[data-toggle="tooltip"]').tooltip();
	  option_value_row++;
  }

  function addAllOptionValues(option_row) {
	  var $sel = $('#option-values' + option_row);
	  var existing = [];
	  $('#option-value' + option_row + ' .dc-opt-card').each(function() {
		  var v = $(this).find('select[name$="[option_value_id]"]').val();
		  if (v) existing.push(v);
	  });
	  $sel.find('option').each(function() {
		  var ovId = $(this).val();
		  var ovName = $(this).text();
		  if (existing.indexOf(ovId) === -1) {
			  var card = dcBuildOptionValueCard(option_row, option_value_row, ovId, ovName, '', '0', '+', '0', '+', '0', '+', false);
			  $('#option-value' + option_row).append(card);
			  lucide.createIcons();
			  option_value_row++;
		  }
	  });
	  lucide.createIcons();
	  $('[data-toggle="tooltip"]').tooltip();
  }

  //--></script>
  <script type="text/javascript"><!--
  function addOptionValueCgPrice(button, option_row, option_value_row) {
	  var cg_row = $(button).closest('.dc-opt-card__cg-body').find('.dc-cg-prices > div').length;

	  var html = '<div class="dc-opt-card__cg-row">';
	  html += '  <select name="product_option[' + option_row + '][product_option_value][' + option_value_row + '][customer_group_price][' + cg_row + '][customer_group_id]" class="form-control">';
    {% for customer_group in customer_groups %}
	  html += '    <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name|escape('js') }}</option>';
    {% endfor %}
	  html += '  </select>';
	  html += '  <div class="option-value-prefix-group">';
	  html += '    <select name="product_option[' + option_row + '][product_option_value][' + option_value_row + '][customer_group_price][' + cg_row + '][price_prefix]" class="form-control option-value-prefix-select">';
	  html += '      <option value="+">+</option>';
	  html += '      <option value="-">-</option>';
	  html += '    </select>';
	  html += '    <input type="text" name="product_option[' + option_row + '][product_option_value][' + option_value_row + '][customer_group_price][' + cg_row + '][price]" value="" placeholder="{{ entry_price|e('js') }}" class="form-control option-value-prefix-input" />';
	  html += '  </div>';
	  html += '  <button type="button" onclick="$(this).closest(\'.dc-opt-card__cg-row\').remove();" class="btn btn-danger btn-xs"><i data-lucide="minus-circle" width="14" height="14"></i></button>';
	  html += '</div>';

	  $(button).closest('.dc-opt-card__cg-body').find('.dc-cg-prices').append(html);
	  lucide.createIcons();
  }

  //--></script>
  <script type="text/javascript"><!--
  function dcUpdateBadges(el) {
	  var $card = $(el).closest('.dc-opt-card');
	  var qty = $card.find('input[name$="[quantity]"]').val();
	  var price = $card.find('input[name$="[price]"]').not('[name*="customer_group"]').val();
	  var price_prefix = $card.find('select[name$="[price_prefix]"]').not('[name*="customer_group"]').val();

	  var $qtyBadge = $card.find('[data-badge="qty"]');
	  $qtyBadge.text(qty + ' {{ text_qty_short|e('js') }}');
	  $qtyBadge.removeClass('dc-opt-badge--qty-ok dc-opt-badge--qty-zero');
	  $qtyBadge.addClass(parseFloat(qty) > 0 ? 'dc-opt-badge--qty-ok' : 'dc-opt-badge--qty-zero');

	  var $priceBadge = $card.find('[data-badge="price"]');
	  if (parseFloat(price) != 0) {
		  $priceBadge.text(price_prefix + price).show();
	  } else {
		  $priceBadge.hide();
	  }
  }

  function dcUpdateCardTitle(sel) {
	  var name = $(sel).find('option:selected').text();
	  $(sel).closest('.dc-opt-card').find('.dc-opt-card__title').text(name);
  }

  function dcUpdateHitBadge(cb) {
	  var $card = $(cb).closest('.dc-opt-card');
	  var $badges = $card.find('.dc-opt-card__badges');
	  if (cb.checked) {
		  if (!$badges.find('.dc-opt-badge--hit').length) {
			  $badges.prepend('<span class="dc-opt-badge dc-opt-badge--hit">{{ entry_hit|e("js") }}</span>');
		  }
	  } else {
		  $badges.find('.dc-opt-badge--hit').remove();
	  }
  }

  //--></script>
  <script type="text/javascript"><!--
  function removePromoCard(cardId) {
	  var $card = $('#' + cardId);
	  $card.remove();
	  var $container = $('#promo-container');
	  if ($container.find('.dc-promo-card').length === 0) {
		  if ($('#promo-empty').length === 0) {
			  $container.html('<div class="dc-promo-empty" id="promo-empty"><i data-lucide="tag" width="32" height="32" style="opacity:0.25;margin-bottom:6px;"></i><div>{{ text_no_promo }}</div></div>');
			  lucide.createIcons();
		  } else {
			  $('#promo-empty').show();
		  }
	  }
  }

  function addPromoCard(type) {
	  if (type === 'discount') addDiscount();
	  else if (type === 'special') addSpecial();
	  else if (type === 'gift') addGift();
	  else if (type === 'bundle') addBundle();
	  $('#promo-add-dropdown').hide();
  }

  $('#promo-add-btn').on('click', function(e) {
	  e.stopPropagation();
	  $('#promo-add-dropdown').toggle();
  });
  $(document).on('click', function() { $('#promo-add-dropdown').hide(); });

  var discount_row = {{ discount_row }};

  function addDiscount() {
	  $('#promo-empty').hide();
	  var html = '<div class="dc-promo-card" id="discount-row' + discount_row + '">';
	  html += '  <div class="dc-promo-card__actions">';
	  html += '    <label class="dc-promo-card__toggle"><input type="checkbox" name="product_discount[' + discount_row + '][auto_renew]" value="1" class="auto-renew-cb" /><span>{{ entry_auto_renew }}</span></label>';
	  html += '    <button type="button" onclick="removePromoCard(\'discount-row' + discount_row + '\')" class="dc-promo-card__remove" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>';
	  html += '  </div>';
	  html += '  <span class="dc-promo-badge dc-promo-badge--discount">{{ text_promo_discount }}</span>';
	  html += '  <div class="dc-promo-card__grid">';
	  html += '    <div class="dc-promo-card__field">';
	  html += '      <label>{{ entry_customer_group }}</label>';
	  html += '      <select name="product_discount[' + discount_row + '][customer_group_id]" class="form-control">';
    {% for customer_group in customer_groups %}
	  html += '        <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name|escape('js') }}</option>';
    {% endfor %}
	  html += '      </select>';
	  html += '    </div>';
	  html += '    <div class="dc-promo-card__field">';
	  html += '      <label>{{ entry_quantity }}</label>';
	  html += '      <input type="text" name="product_discount[' + discount_row + '][quantity]" value="" placeholder="{{ entry_quantity }}" class="form-control" />';
	  html += '    </div>';
	  html += '    <div class="dc-promo-card__field">';
	  html += '      <label>{{ entry_priority }}</label>';
	  html += '      <input type="text" name="product_discount[' + discount_row + '][priority]" value="" placeholder="{{ entry_priority }}" class="form-control" />';
	  html += '    </div>';
	  html += '    <div class="dc-promo-card__field">';
	  html += '      <label>{{ entry_price }}</label>';
	  html += '      <input type="text" name="product_discount[' + discount_row + '][price]" value="" placeholder="{{ entry_price }}" class="form-control" />';
	  html += '    </div>';
	  html += '    <div class="dc-promo-card__field">';
	  html += '      <label>{{ entry_date_start }}</label>';
	  html += '      <div class="input-group date"><input type="text" name="product_discount[' + discount_row + '][date_start]" value="" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div>';
	  html += '    </div>';
