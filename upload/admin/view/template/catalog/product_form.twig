<div id="category-tree-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title"><i data-lucide="folder-tree" width="18" height="18" style="margin-right:8px;"></i>{{ text_select_category }}</h4>
      </div>
      <div class="modal-body">
        <div id="category-modal-tree" class="dcx-tree-select"
             data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}"
             data-mode="multi"
             data-none-text="{{ text_none }}"
             data-placeholder="{{ text_quick_find }}">
          <div class="dcx-tree-select__search">
            <input type="text" class="form-control" placeholder="{{ text_quick_find }}" id="category-tree-search" />
            <i data-lucide="search" width="14" height="14"></i>
          </div>
          <div class="dcx-tree-select__list" style="max-height:400px;overflow-y:auto;"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
        <button type="button" class="btn btn-primary" id="category-tree-confirm"><i data-lucide="check" width="14" height="14"></i> {{ button_continue }}</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
var categoryTreeInstance = null;

$('#btn-open-category-modal').on('click', function() {
  var $tree = $('#category-modal-tree');
  categoryTreeInstance = $tree.data('dcx-tree-select');
  if (!categoryTreeInstance) {
    DcxTreeSelect.init('#category-modal-tree');
    categoryTreeInstance = $tree.data('dcx-tree-select');
  }

  var currentIds = [];
  $('#product-category .dcx-tree-select__well-item').each(function() {
    currentIds.push($(this).data('id'));
  });
  categoryTreeInstance.setSelected(currentIds);

  $('#category-tree-modal').modal('show');
});

$('#category-tree-confirm').on('click', function() {
  if (!categoryTreeInstance) {
    $('#category-tree-modal').modal('hide');
    return;
  }

  var ids = categoryTreeInstance.getSelectedIds();
  var $well = $('#product-category');
  $well.empty();

  var allItems = categoryTreeInstance.cache || [];
  for (var i = 0; i < ids.length; i++) {
    for (var j = 0; j < allItems.length; j++) {
      if (String(allItems[j].category_id) === String(ids[i])) {
        var name = allItems[j].path || allItems[j].name;
        $well.append('<div class="dcx-tree-select__well-item" data-id="' + ids[i] + '"><i data-lucide="minus-circle" width="14" height="14" class="dcx-tree-select__well-remove"></i> <span class="dcx-tree-select__well-label">' + name + '</span><input type="hidden" name="product_category[]" value="' + ids[i] + '"/></div>');
        break;
      }
    }
  }

  $well.toggle(ids.length > 0);
  $('#category-modal-count').text(ids.length > 0 ? ids.length + ' {{ entry_category }}' : '{{ button_select_category }}');
  lucide.createIcons();
  categoryTreeInstance.close();
  $('#category-tree-modal').modal('hide');
});

$('#category-tree-modal').on('hidden.bs.modal', function() {
  if (categoryTreeInstance) categoryTreeInstance.close();
});

$(document).on('click', '#product-category .dcx-tree-select__well-remove', function() {
  $(this).closest('.dcx-tree-select__well-item').remove();
  var count = $('#product-category .dcx-tree-select__well-item').length;
  $('#category-modal-count').text(count > 0 ? count + ' {{ entry_category }}' : '{{ button_select_category }}');
  $('#product-category').toggle(count > 0);
});

function escapeHtml(text) {
  if (!text) return '';
  var div = document.createElement('div');
  div.appendChild(document.createTextNode(text));
  return div.innerHTML;
}
//--></script>

