  <script type="text/javascript"><!--
  var image_row = {{ image_row }};

  function addImage(language_id) {
    var $container = language_id === ''
      ? $('#product-images-all')
      : $('#product-images-' + language_id);
    var html = '<div class="dc-img-card" data-row="' + image_row + '" title="{{ text_drag_to_reorder }}">';
    html += '<span class="dc-img-card__handle" title="{{ text_drag_to_reorder }}" aria-hidden="true"><i data-lucide="grip-vertical" width="12" height="12" class="slide-drag-handle"></i></span>';
    html += '<input type="hidden" name="product_image[' + image_row + '][image]" value="" id="input-image' + image_row + '"/>';
    html += '<input type="hidden" name="product_image[' + image_row + '][sort_order]" value="0" class="dc-img-sort-order"/>';
    html += '<input type="hidden" name="product_image[' + image_row + '][language_id]" value="' + language_id + '"/>';
    html += '<a href="" id="thumb-image' + image_row + '" data-toggle="image" class="dc-img-link"><img src="{{ placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" draggable="false"/></a>';
    html += '<button type="button" onclick="removeImage(' + image_row + ');" class="dc-img-remove"><i data-lucide="x" width="14" height="14"></i></button>';
    html += '</div>';
    $container.append(html);
    lucide.createIcons();
    image_row++;
  }

  function removeImage(row) {
    var $card = $('.product-images .dc-img-card[data-row="' + row + '"]');
    $card.remove();
  }

  function updateImageSortOrders() {
    $('.product-images').each(function() {
      $(this).find('.dc-img-card').each(function(i) {
        $(this).find('.dc-img-sort-order').val(i);
      });
    });
  }

  if (typeof Sortable !== 'undefined') {
    $('.product-images').each(function() {
      Sortable.create(this, {
        animation: 150,
        filter: '.dc-img-remove, input',
        ghostClass: 'dc-img-ghost',
        chosenClass: 'dc-img-chosen',
        onEnd: function() {
          updateImageSortOrders();
        }
      });
    });

    $('.dc-opt-cards').each(function() {
      Sortable.create(this, {
        animation: 150,
        filter: '.dc-opt-card__remove, input, select, textarea, button, .dc-img-link',
        preventOnFilter: false,
        ghostClass: 'dc-opt-ghost',
        chosenClass: 'dc-opt-chosen',
        onEnd: function() {
          updateOptionValueSortOrders();
        }
      });
    });
  }

  function updateOptionValueSortOrders() {
    $('.dc-opt-cards').each(function() {
      $(this).find('.dc-opt-card').each(function(i) {
        $(this).find('.dc-opt-sort-order').val(i);
      });
    });
  }

  function clearProductVideo() {
    $('#input-video-youtube').val('');
    $('#video-youtube-preview').hide();
    var $card = $('#video-mp4-block').find('.dc-video-card');
    $card.find('.dc-video-card__img').attr('src', $card.find('.dc-video-card__img').attr('data-placeholder'));
    $card.find('.dc-video-card__overlay').hide();
    $('#input-product-video').val('');
    $('#video-mp4-block').hide();
  }

  function clearModel3d() {
    var $card = $('#thumb-model-3d').closest('.dc-video-card');
    $card.find('.dc-video-card__img').attr('src', $card.find('.dc-video-card__img').attr('data-placeholder'));
    $card.find('.dc-video-card__overlay').hide();
    $('#input-model-3d').val('');
  }

  function openVideoFileManager() {
    $('#modal-image').remove();
    $.ajax({
      url: 'index.php?route=common/filemanager&user_token=' + getURLVar('user_token')
           + '&target=input-product-video&thumb=thumb-product-video&type=video',
      dataType: 'html',
      beforeSend: function() {
        $('#button-browse-mp4').prop('disabled', true);
      },
      complete: function() {
        $('#button-browse-mp4').prop('disabled', false);
      },
      success: function(html) {
        $('body').append('<div id="modal-image" class="modal">' + html + '</div>');
        $('#modal-image').modal('show');
      }
    });
  }

  function dcExtractYouTubeId(value) {
    value = (value || '').trim();
    if (/^[A-Za-z0-9_-]{11}$/.test(value)) {
      return value;
    }
    var patterns = [
      /(?:youtube\.com|youtu\.be|youtube-nocookie\.com)\/(?:watch\?v=|embed\/|shorts\/)?([A-Za-z0-9_-]{11})/,
      /^([A-Za-z0-9_-]{11})$/
    ];
    for (var i = 0; i < patterns.length; i++) {
      var m = value.match(patterns[i]);
      if (m) {
        return m[1];
      }
    }
    return '';
  }

  $(document).on('input', '#input-video-youtube', function() {
    var val = $(this).val().trim();
    if (val) {
      var ytId = dcExtractYouTubeId(val);
      $('#video-mp4-block').hide();
      $('#input-product-video').val('');
      $('#video-mp4-block').find('.dc-video-card__img').attr('src', $('#video-mp4-block').find('.dc-video-card__img').attr('data-placeholder'));
      $('#video-mp4-block').find('.dc-video-card__overlay').hide();
      $('#video-youtube-preview').show();
      if (ytId) {
        $('#video-youtube-thumb-img').attr('src', 'https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg');
      } else {
        $('#video-youtube-thumb-img').attr('src', $('#video-youtube-thumb-img').attr('data-placeholder') || '');
      }
    } else {
      $('#video-youtube-preview').hide();
    }
  });

  $(document).on('hidden.bs.modal', '#modal-image', function() {
    var mp4Val = $('#input-product-video').val();
    if (mp4Val) {
      $('#video-youtube-preview').hide();
      $('#input-video-youtube').val('');
      $('#video-mp4-block').show();
      $('#video-mp4-block').find('.dc-video-card__overlay').show();
      $('#video-mp4-block').find('.dc-video-card__name').text(mp4Val);
    }
    var modelVal = $('#input-model-3d').val();
    if (modelVal) {
      $('#thumb-model-3d').closest('.dc-video-card').find('.dc-video-card__overlay').show();
      $('#thumb-model-3d').closest('.dc-video-card').find('.dc-video-card__name').text(modelVal);
    }
  });

