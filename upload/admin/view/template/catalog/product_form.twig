  function dcBuildVariantGroups() {
	  if (!dcPromoIsGrouped()) return;
	  var $container = $('#promo-container');
	  var $cards = $container.find('.dc-promo-card').filter(function() {
		  var t = dcPromoTypeOf($(this));
		  return t === 'discount' || t === 'special';
	  });

	  var groups = {};
	  var lockedCards = [];
	  var $newGroups = $();
	  $cards.each(function() {
		  var $card = $(this);
		  if ($card.hasClass('dc-promo-card--locked')) { lockedCards.push($card); return; }
		  var $sel = $card.find('select[name$="[variant_id]"]');
		  var vid = $sel.length ? (parseInt($sel.val()) || 0) : 0;
		  if (vid === 0 && $sel.length && dcPromoVariants.length) {
			  vid = parseInt(dcPromoVariants[0].variant_id);
			  $sel.val(vid);
		  }
		  var key = String(vid);
		  if (!groups[key]) groups[key] = [];
		  groups[key].push($card);
	  });

	  // Drop previously built groups (cards are re-parented below; detach keeps handlers)
	  $container.find('.dc-variant-promo-group').detach();

	  if (lockedCards.length) {
		  var $lockedGroup = $('<div class="dc-variant-promo-group dc-variant-promo-group--locked" data-variant-id="0"></div>');
		  var lockedHeader = '<div class="dc-variant-promo-group__header"><span class="dc-variant-promo-group__title"><i data-lucide="lock" width="12" height="12"></i> {{ text_promo_scope_product|e('js') }} <span class="dc-variant-promo-group__count">' + lockedCards.length + '</span></span><span class="dc-variant-promo-group__toggle"><i data-lucide="chevron-down" width="14" height="14"></i></span></div>';
		  $lockedGroup.append(lockedHeader);
		  var $lockedBody = $('<div class="dc-variant-promo-group__body"></div>');
		  lockedCards.forEach(function($c) { $lockedBody.append($c); });
		  $lockedGroup.append($lockedBody);
		  $lockedGroup.addClass('dc-variant-promo-group--collapsed');
		  $newGroups = $newGroups.add($lockedGroup);
	  }

	  dcPromoVariants.forEach(function(v) {
		  var vid = String(v.variant_id);
		  var list = groups[vid] || [];
		  var count = list.length;
		  var $group = $('<div class="dc-variant-promo-group" data-variant-id="' + vid + '"></div>');
		  var labelEsc = $('<span>').text(v.label).html();
		  var isDef = v.is_default ? ' <span class="dc-variant-promo-group__default">{{ text_variant_is_default|e('js') }}</span>' : '';
		  var countClass = count ? '' : ' dc-variant-promo-group__count--zero';
		  var headerHtml = '<div class="dc-variant-promo-group__header"><span class="dc-variant-promo-group__title">' + labelEsc + isDef + ' <span class="dc-variant-promo-group__count' + countClass + '">' + count + '</span></span><span class="dc-variant-promo-group__toggle"><i data-lucide="chevron-down" width="14" height="14"></i></span></div>';
		  $group.append(headerHtml);
		  var $body = $('<div class="dc-variant-promo-group__body"></div>');
		  list.forEach(function($c) { $body.append($c); });
		  if (!count) {
			  $body.append('<div class="dc-variant-promo-group__empty">{{ text_variant_group_empty|e('js') }}</div>');
		  }
		  $body.append(dcVariantGroupAddHtml(v.variant_id));
		  $group.append($body);
		  $group.addClass('dc-variant-promo-group--collapsed');
		  $newGroups = $newGroups.add($group);
	  });

	  Object.keys(groups).forEach(function(k) {
		  var found = dcPromoVariants.some(function(v) { return String(v.variant_id) === k; });
		  if (!found && k !== '0') {
			  var list = groups[k];
			  var count = list.length;
			  var $group = $('<div class="dc-variant-promo-group" data-variant-id="' + k + '"></div>');
			  var headerHtml2 = '<div class="dc-variant-promo-group__header"><span class="dc-variant-promo-group__title">#' + k + ' <span class="dc-variant-promo-group__count">' + count + '</span></span><span class="dc-variant-promo-group__toggle"><i data-lucide="chevron-down" width="14" height="14"></i></span></div>';
			  $group.append(headerHtml2);
			  var $body2 = $('<div class="dc-variant-promo-group__body"></div>');
			  list.forEach(function($c) { $body2.append($c); });
			  $body2.append(dcVariantGroupAddHtml(parseInt(k) || 0));
			  $group.append($body2);
			  $group.addClass('dc-variant-promo-group--collapsed');
			  $newGroups = $newGroups.add($group);
		  }
	  });

	  // Variant groups stay above the product-level cards
	  var $anchor = $container.children('.dc-promo-card').first();
	  $newGroups.each(function() {
		  if ($anchor.length) {
			  $(this).insertBefore($anchor);
		  } else {
			  $container.append(this);
		  }
	  });

	  dcBindVariantGroupEvents();
	  lucide.createIcons();
  }

