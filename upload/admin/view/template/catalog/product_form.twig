                        <a href="javascript:void(0)" onclick="addPromoCard('special');$('#promo-add-dropdown').hide();" style="display:block;padding:8px 14px;font-size:13px;color:var(--dc-text-dark);text-decoration:none;"><span class="dc-promo-badge dc-promo-badge--special" style="margin-right:6px;">{{ text_promo_special }}</span></a>
