                          <div class="input-group date"><input type="text" name="product_bundle[{{ bundle_row }}][date_end]" value="{{ product_bundle.date_end }}" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div>
