  }

  var ids = categoryTreeInstance.getSelectedIds();
  var $well = $('#product-category');
  $well.empty();

  var allItems = categoryTreeInstance.cache || [];
  for (var i = 0; i < ids.length; i++) {
    for (var j = 0; j < allItems.length; j++) {
      if (String(allItems[j].category_id) === String(ids[i])) {
        var name = allItems[j].path || allItems[j].name;
        $well.append('<div class="dcx-tree-select__well-item" data-id="' + ids[i] + '"><i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i> <span class="dcx-tree-select__well-label">' + name + '</span><input type="hidden" name="product_category[]" value="' + ids[i] + '"/></div>');
        break;
      }
    }
