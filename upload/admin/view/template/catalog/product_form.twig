                        <a href="javascript:void(0)" onclick="addPromoCard('bundle');$('#promo-add-dropdown').hide();" style="display:block;padding:8px 14px;font-size:13px;color:var(--dc-text-dark);text-decoration:none;"><span class="dc-promo-badge dc-promo-badge--bundle" style="margin-right:6px;">{{ text_promo_bundle }}</span></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dcx-panel" style="margin-top: 16px;">
