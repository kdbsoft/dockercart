                <div class="dcx-panel-body">
                  <div class="dc-opts-toolbar dc-option-mode-selector">
                    <span class="dc-opts-toolbar__title">{{ tab_options }} <small id="dc-option-count">({{ product_options|length }})</small></span>
                    <span id="dc-option-mode-label" class="label {% if is_configurable %}label-primary{% else %}label-default{% endif %}">
                      <i data-lucide="circle" width="10" height="10"></i> {% if is_configurable %}{{ text_mode_combined }}{% else %}{{ text_mode_simple }}{% endif %}
                    </span>
                    <button type="button" id="dc-toggle-mode-btn" class="btn btn-xs btn-default">
                      {% if is_configurable %}
                        <i data-lucide="arrow-left" width="13" height="13"></i> {{ text_switch_to_simple }}
                      {% else %}
                        {{ text_switch_to_combined }} <i data-lucide="arrow-right" width="13" height="13"></i>
                      {% endif %}
                    </button>
                    <span id="dc-mode-saved" class="dc-opts-toolbar__saved" style="display:none"><i data-lucide="check" width="13" height="13"></i> {{ text_success_mode }}</span>
                    <span class="dc-opts-toolbar__spacer"></span>
                    <label for="dc-option-set-select" class="dc-opts-toolbar__label">{{ text_option_set_selector }} <span title="{{ text_help_option_set }}" data-toggle="tooltip"><i data-lucide="circle-question-mark" width="13" height="13" class="text-muted"></i></span></label>
                    <select id="dc-option-set-select" class="form-control input-sm">
                      <option value=""></option>
                      {% for option_set in option_sets %}
                      <option value="{{ option_set.option_set_id }}">{{ option_set.name }} ({{ option_set.option_count }})</option>
                      {% else %}
                      <option value="" disabled="disabled">{{ text_no_option_sets }}</option>
                      {% endfor %}
                    </select>
                    <button type="button" class="btn btn-default btn-sm" onclick="loadOptionSet();">
                      <i data-lucide="download" width="13" height="13"></i> {{ button_option_set_load }}
                    </button>
                  </div>

                  <div id="dc-variants-section" {% if not is_configurable %}style="display:none"{% endif %}>
                    {% if error_default_variant %}
                    <div class="alert alert-danger" id="dc-error-default-variant"><i data-lucide="circle-alert" width="14" height="14"></i> {{ error_default_variant }}</div>
                    {% endif %}
                    {% include 'catalog/product_variants.twig' %}
                  </div>

                  <div class="dc-opts-list">
                    <div id="dc-options-container">
                      {% set option_row = 0 %}
                      {% set option_value_row = 0 %}
                      {% for product_option in product_options %}
                        {% set opt_static = product_option.is_axis and is_configurable %}
                        {% set opt_summary = '' %}
                        {% if product_option.type == 'select' or product_option.type == 'radio' or product_option.type == 'checkbox' or product_option.type == 'image' or product_option.type == 'color' %}
                          {% set opt_names = [] %}
                          {% for product_option_value in product_option.product_option_value %}
                            {% for ov in option_values[product_option.option_id]|default([]) %}{% if ov.option_value_id == product_option_value.option_value_id %}{% set opt_names = opt_names|merge([ov.name]) %}{% endif %}{% endfor %}
                          {% endfor %}
                          {% set opt_summary = opt_names|join(', ') %}
                        {% elseif product_option.value is not empty %}
                          {% set opt_summary = product_option.value %}
                        {% endif %}
                        <div class="dc-option-section{% if product_option.is_axis %} dc-option-axis{% endif %}{% if not opt_static and error_option[product_option.option_id] is not defined %} dc-option-section--collapsed{% endif %}" id="option-section{{ option_row }}">
                          <div class="dc-option-section__header">
                            {% if opt_static %}<span class="dc-option-section__lead">{% else %}<button type="button" class="dc-option-section__toggle" data-option-section="option-section{{ option_row }}" aria-expanded="{% if error_option[product_option.option_id] is defined %}true{% else %}false{% endif %}" aria-controls="option-section{{ option_row }}-body">{% endif %}
                              <span class="dc-option-section__title">{{ product_option.name }}</span>
                              <span class="dc-option-section__type">({{ product_option.type }})</span>
                              {% if product_option.is_axis %}<span class="dc-axis-badge" title="{{ entry_axis_lock_warning|e('html_attr') }}"><i data-lucide="lock" width="10" height="10"></i> {{ text_variant|e('html') }}</span>{% endif %}
                              {% if opt_summary %}<span class="dc-option-section__values">{{ opt_summary }}</span>{% endif %}
                            {% if opt_static %}</span>{% else %}</button>{% endif %}
                            <div class="dc-option-section__controls">
                              <label class="dc-option-section__required">
                                <span>{{ entry_required }}:</span>
                                <select name="product_option[{{ option_row }}][required]" class="form-control input-sm"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                  {% if product_option.required %}
                                    <option value="1" selected="selected">{{ text_yes }}</option>
                                    <option value="0">{{ text_no }}</option>
                                  {% else %}
                                    <option value="1">{{ text_yes }}</option>
                                    <option value="0" selected="selected">{{ text_no }}</option>
                                  {% endif %}
                                </select>
                              </label>
                              {% if not product_option.is_axis %}
                              <button type="button" class="btn btn-danger btn-xs dc-option-section__remove" onclick="dcRemoveOption('{{ option_row }}')" data-toggle="tooltip" title="{{ button_remove }}">
                                <i data-lucide="trash-2" width="13" height="13"></i>
                              </button>
                              {% endif %}
                            </div>
                            {% if not opt_static %}<span class="dc-option-section__chevron" aria-hidden="true"><i data-lucide="chevron-down" width="14" height="14"></i></span>{% endif %}
                          </div>
                          {% if error_option[product_option.option_id] is defined %}
                          <div class="alert alert-danger dc-option-section__error"><i data-lucide="circle-alert" width="14" height="14"></i> {{ error_option[product_option.option_id] }}</div>
                          {% endif %}
                          {% if opt_static %}
                          <div style="display:none">
                            <input type="hidden" name="product_option[{{ option_row }}][product_option_id]" value="{{ product_option.product_option_id }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][name]" value="{{ product_option.name|e('html_attr') }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][option_id]" value="{{ product_option.option_id }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][type]" value="{{ product_option.type }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][required]" value="{{ product_option.required }}"/>
                            {% if product_option.type == 'select' or product_option.type == 'radio' or product_option.type == 'checkbox' or product_option.type == 'image' or product_option.type == 'color' %}
                              {% for product_option_value in product_option.product_option_value %}
                                <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][product_option_value_id]" value="{{ product_option_value.product_option_value_id }}"/>
                                <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][option_value_id]" value="{{ product_option_value.option_value_id }}"/>
                                <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][sort_order]" value="{{ option_value_row }}"/>
                                {% set option_value_row = option_value_row + 1 %}
                              {% endfor %}
                            {% else %}
                              <input type="hidden" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}"/>
                            {% endif %}
                          </div>
                          {% else %}
                          {% if product_option.is_axis %}
                          <div class="dc-axis-info-banner"><i data-lucide="info" width="14" height="14"></i> {{ entry_axis_lock_warning }}</div>
                          {% endif %}
                          <div class="dc-option-section__body" id="option-section{{ option_row }}-body">
                            <input type="hidden" name="product_option[{{ option_row }}][product_option_id]" value="{{ product_option.product_option_id }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][name]" value="{{ product_option.name|e('html_attr') }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][option_id]" value="{{ product_option.option_id }}"/>
                            <input type="hidden" name="product_option[{{ option_row }}][type]" value="{{ product_option.type }}"/>
                            {% if product_option.type == 'text' %}
                            <div class="dc-opt-field">
                              <label class="dc-opt-field__label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" id="input-value{{ option_row }}" class="form-control"/>
                            </div>
                            {% endif %}
                            {% if product_option.type == 'textarea' %}
                            <div class="dc-opt-field">
                              <label class="dc-opt-field__label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <textarea name="product_option[{{ option_row }}][value]" rows="3" placeholder="{{ entry_option_value }}" id="input-value{{ option_row }}" class="form-control">{{ product_option.value }}</textarea>
                            </div>
                            {% endif %}
                            {% if product_option.type == 'file' %}
                            <div class="dc-opt-field" style="display:none">
                              <label class="dc-opt-field__label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" id="input-value{{ option_row }}" class="form-control"/>
                            </div>
                            {% endif %}
                            {% if product_option.type == 'date' %}
                            <div class="dc-opt-field">
                              <label class="dc-opt-field__label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="input-group date">
                                <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" data-date-format="YYYY-MM-DD" id="input-value{{ option_row }}" class="form-control"/>
                                <span class="input-group-btn"><button class="btn btn-default" type="button"><i data-lucide="calendar" width="14" height="14"></i></button></span>
                              </div>
                            </div>
                            {% endif %}
                            {% if product_option.type == 'time' %}
                            <div class="dc-opt-field">
                              <label class="dc-opt-field__label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="input-group time">
                                <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" data-date-format="HH:mm" id="input-value{{ option_row }}" class="form-control"/>
                                <span class="input-group-btn"><button class="btn btn-default" type="button"><i data-lucide="calendar" width="14" height="14"></i></button></span>
                              </div>
                            </div>
                            {% endif %}
                            {% if product_option.type == 'datetime' %}
                            <div class="dc-opt-field">
                              <label class="dc-opt-field__label" for="input-value{{ option_row }}">{{ entry_option_value }}</label>
                              <div class="input-group datetime">
                                <input type="text" name="product_option[{{ option_row }}][value]" value="{{ product_option.value }}" placeholder="{{ entry_option_value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-value{{ option_row }}" class="form-control"/>
                                <span class="input-group-btn"><button class="btn btn-default" type="button"><i data-lucide="calendar" width="14" height="14"></i></button></span>
                              </div>
                            </div>
                            {% endif %}
                            {% if product_option.type == 'select' or product_option.type == 'radio' or product_option.type == 'checkbox' or product_option.type == 'image' or product_option.type == 'color' %}
                            <div class="dc-opt-cards" id="option-value{{ option_row }}">
                              {% for product_option_value in product_option.product_option_value %}
                                <div class="dc-opt-card" id="option-value-row{{ option_value_row }}">
                                  <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][product_option_value_id]" value="{{ product_option_value.product_option_value_id }}"/>
                                  <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][is_hit]" value="0"/>
                                  <input type="hidden" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][sort_order]" value="{{ option_value_row }}" class="dc-opt-sort-order"/>
                                  <span class="dc-opt-card__handle" title="{{ text_drag_to_reorder }}" aria-hidden="true"><i data-lucide="grip-vertical" width="14" height="14" class="slide-drag-handle"></i></span>
                                  <div class="dc-opt-card__field dc-opt-card__field--value">
                                    <label>{{ entry_option_value }}</label>
                                    <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][option_value_id]" class="form-control"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                      {% if option_values[product_option.option_id] %}
                                        {% for option_value in option_values[product_option.option_id] %}
                                          <option value="{{ option_value.option_value_id }}"{% if option_value.option_value_id == product_option_value.option_value_id %} selected="selected"{% endif %}>{{ option_value.name }}</option>
                                        {% endfor %}
                                      {% endif %}
                                    </select>
                                  </div>
                                  <div class="dc-opt-card__field{% if product_option.is_axis %} dc-opt-card__field--locked{% endif %}">
                                    <label>{{ entry_price }}</label>
                                    <div class="option-value-prefix-group">
                                      <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][price_prefix]" class="form-control option-value-prefix-select"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                        <option value="+"{% if product_option_value.price_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                        <option value="-"{% if product_option_value.price_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                      </select>
                                      <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][price]" value="{{ product_option_value.price }}" placeholder="{{ entry_price }}" class="form-control option-value-prefix-input"{% if product_option.is_axis %} readonly="readonly" data-axis-price="1"{% endif %} />
                                    </div>
                                  </div>
                                  <div class="dc-opt-card__field{% if product_option.is_axis %} dc-opt-card__field--locked{% endif %}">
                                    <label>{{ entry_option_points }}</label>
                                    <div class="option-value-prefix-group">
                                      <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][points_prefix]" class="form-control option-value-prefix-select"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                        <option value="+"{% if product_option_value.points_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                        <option value="-"{% if product_option_value.points_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                      </select>
                                      <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][points]" value="{{ product_option_value.points }}" placeholder="{{ entry_points }}" class="form-control option-value-prefix-input"{% if product_option.is_axis %} readonly="readonly"{% endif %} />
                                    </div>
                                  </div>
                                  <div class="dc-opt-card__field{% if product_option.is_axis %} dc-opt-card__field--locked{% endif %}">
                                    <label>{{ entry_weight }}</label>
                                    <div class="option-value-prefix-group">
                                      <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][weight_prefix]" class="form-control option-value-prefix-select"{% if product_option.is_axis %} disabled="disabled"{% endif %}>
                                        <option value="+"{% if product_option_value.weight_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                        <option value="-"{% if product_option_value.weight_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                      </select>
                                      <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][weight]" value="{{ product_option_value.weight }}" placeholder="{{ entry_weight }}" class="form-control option-value-prefix-input"{% if product_option.is_axis %} readonly="readonly"{% endif %} />
                                    </div>
                                  </div>
                                  <div class="dc-opt-card__actions">
                                    <span class="dc-opt-card__badges">
                                      {% if product_option_value.is_hit %}<span class="dc-opt-badge dc-opt-badge--hit">{{ entry_hit }}</span>{% endif %}
                                    </span>
                                    {% if product_option.type == 'color' %}
                                    <label class="dc-opt-card__hit-label" title="{{ entry_hit }}">
                                      <input type="checkbox" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][is_hit]" value="1"{% if product_option_value.is_hit %} checked{% endif %}{% if product_option.is_axis %} disabled="disabled"{% endif %} onchange="$(this).closest('.dc-opt-card').find('input[name$=\\'[is_hit\\']]').val(this.checked ? 1 : 0);dcUpdateHitBadge(this)"/>
                                      <i data-lucide="star" width="13" height="13"></i>
                                    </label>
                                    {% endif %}
                                    {% if not product_option.is_axis %}
                                    <button type="button" class="btn btn-default btn-xs dc-opt-card__cg-toggle" data-toggle="tooltip" title="{{ entry_option_value_cg_price }}" onclick="event.stopPropagation();$(this).closest('.dc-opt-card').find('.dc-opt-card__cg-body').slideToggle(150);">
                                      <i data-lucide="users" width="13" height="13"></i>
                                    </button>
                                    {% endif %}
                                    <button type="button" class="btn btn-danger btn-xs dc-opt-card__remove"{% if product_option.is_axis %} style="display:none"{% endif %} onclick="$(this).closest('.dc-opt-card').remove();" data-toggle="tooltip" title="{{ button_remove }}"><i data-lucide="circle-minus" width="14" height="14"></i></button>
                                  </div>
                                  <div class="dc-opt-card__cg-body" style="display:{% if product_option_value.customer_group_prices|length > 0 %}block{% else %}none{% endif %}">
                                    <div class="dc-cg-prices" id="option-value-cg{{ option_row }}-{{ option_value_row }}">
                                      {% set cg_row = 0 %}
                                      {% for cg_price in product_option_value.customer_group_prices %}
                                        <div class="dc-opt-card__cg-row">
                                          <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][customer_group_price][{{ cg_row }}][customer_group_id]" class="form-control">
                                            {% for customer_group in customer_groups %}
                                              <option value="{{ customer_group.customer_group_id }}"{% if customer_group.customer_group_id == cg_price.customer_group_id %} selected="selected"{% endif %}>{{ customer_group.name }}</option>
                                            {% endfor %}
                                          </select>
                                          <div class="option-value-prefix-group">
                                            <select name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][customer_group_price][{{ cg_row }}][price_prefix]" class="form-control option-value-prefix-select">
                                              <option value="+"{% if cg_price.price_prefix == '+' %} selected="selected"{% endif %}>+</option>
                                              <option value="-"{% if cg_price.price_prefix == '-' %} selected="selected"{% endif %}>-</option>
                                            </select>
                                            <input type="text" name="product_option[{{ option_row }}][product_option_value][{{ option_value_row }}][customer_group_price][{{ cg_row }}][price]" value="{{ cg_price.price }}" placeholder="{{ entry_price }}" class="form-control option-value-prefix-input" />
                                          </div>
                                          <button type="button" onclick="$(this).closest('.dc-opt-card__cg-row').remove();" class="btn btn-danger btn-xs"><i data-lucide="circle-minus" width="14" height="14"></i></button>
                                        </div>
                                        {% set cg_row = cg_row + 1 %}
                                      {% endfor %}
                                    </div>
                                    <button type="button" class="btn btn-primary btn-xs" onclick="addOptionValueCgPrice(this, '{{ option_row }}', '{{ option_value_row }}');"><i data-lucide="circle-plus" width="14" height="14"></i> {{ button_option_value_cg_price_add }}</button>
                                  </div>
                                </div>
                                {% set option_value_row = option_value_row + 1 %}
                              {% endfor %}
                            </div>
                            <div class="dc-opt-actions">
                              <button type="button" class="btn btn-default btn-xs" onclick="addOptionValue('{{ option_row }}');"><i data-lucide="circle-plus" width="13" height="13"></i> {{ button_option_value_add }}</button>
                              <button type="button" class="btn btn-default btn-xs" onclick="addAllOptionValues('{{ option_row }}');"><i data-lucide="square-plus" width="13" height="13"></i> {{ button_add_all_values }}</button>
                              <span class="dc-opt-actions__hint">{{ text_drag_to_reorder }}</span>
                            </div>
                            {% endif %}
                            <select id="option-values{{ option_row }}" style="display: none;">
                              {% if option_values[product_option.option_id] %}
                                {% for option_value in option_values[product_option.option_id] %}
                                  <option value="{{ option_value.option_value_id }}">{{ option_value.name }}</option>
                                {% endfor %}
                              {% endif %}
                            </select>
                          </div>
                          {% endif %}
                        </div>
                      {% set option_row = option_row + 1 %}
                    {% endfor %}
                    </div>
                    <div class="dc-opt-add">
                      <span class="dc-opt-add__label"><i data-lucide="circle-plus" width="14" height="14"></i> {{ button_option_add }}</span>
                      <div class="dcx-tree-select dc-opt-add__select"
                           data-url="index.php?route=catalog/option/tree&user_token={{ user_token }}"
                           data-id-key="option_id"
                           data-none-text="{{ text_none }}"
                           data-placeholder="{{ entry_option }}">
                        <div class="dcx-tree-select__input-wrap">
                          <input type="text" class="dcx-tree-select__input form-control" placeholder="{{ entry_option }}" tabindex="-1" />
                          <input type="hidden" name="option_id" value="" />
                          <span class="dcx-tree-select__toggle"><i data-lucide="chevron-down" width="16" height="16"></i></span>
                        </div>
                        <div class="dcx-tree-select__dropdown">
                          <div class="dcx-tree-select__search">
                            <input type="text" class="form-control" placeholder="{{ entry_option }}" />
                            <i data-lucide="search" width="14" height="14"></i>
                          </div>
                          <div class="dcx-tree-select__list"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
        </div>
      </div>

      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="power" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <div class="dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="discontinued" value="1" id="input-discontinued"{% if discontinued %} checked{% endif %} /> {{ entry_discontinued }}
                  <span data-toggle="tooltip" title="{{ help_discontinued }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
              <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-date-available">{{ entry_date_available }}</label>
              <div class="input-group date">
