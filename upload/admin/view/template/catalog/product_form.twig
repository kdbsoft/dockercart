	  html += '  <span class="dc-opt-card__handle" title="{{ text_drag_to_reorder|e('js') }}" aria-hidden="true"><i data-lucide="grip-vertical" width="14" height="14" class="slide-drag-handle"></i></span>';
	  html += '  <div class="dc-opt-card__field dc-opt-card__field--value">';
