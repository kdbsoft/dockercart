<script type="text/javascript"><!--
  // Manufacturer
  $('input[name=\'manufacturer\']').autocomplete({
	  'source': function(request, response) {
		  $.ajax({
			  url: 'index.php?route=catalog/manufacturer/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
			  dataType: 'json',
			  success: function(json) {
				  response($.map(json, function(item) {
					  return {
						  label: item['name'],
						  value: item['manufacturer_id']
					  }
				  }));
			  }
		  });
	  },
	  'select': function(item) {
		  $('input[name=\'manufacturer\']').val(item['label']);
		  $('input[name=\'manufacturer_id\']').val(item['value']);
	  }
  });

  var attribute_row = {{ attribute_row }};

  function addAttribute() {
	  var html = '<div class="dc-attr-row" id="attribute-row' + attribute_row + '">';
	  html += '  <div class="dc-attr-row__name">';
	  html += '      <input type="text" name="product_attribute[' + attribute_row + '][name]" value="" placeholder="{{ entry_attribute }}" class="form-control"/>';
	  html += '      <input type="hidden" name="product_attribute[' + attribute_row + '][attribute_id]" value=""/>';
	  html += '  </div>';
	  html += '  <div class="dc-attr-row__values">';
    {% for language in languages %}
	  html += '    <div class="dc-attr-row__value">';
	  html += '      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>';
	  html += '      <input type="text" name="product_attribute[' + attribute_row + '][product_attribute_description][{{ language.language_id }}][text]" value="" placeholder="{{ entry_text }}" class="form-control"/>';
	  html += '    </div>';
    {% endfor %}
	  html += '  </div>';
	  html += '  <button type="button" onclick="$(\'#attribute-row' + attribute_row + '\').remove();" class="btn btn-link btn-remove-attr" title="{{ button_remove }}"><i data-lucide="x" width="14" height="14"></i></button>';
	  html += '</div>';

	  $('#attributes-container').append(html);
	  lucide.createIcons();

	  attributeautocomplete(attribute_row);

	  attribute_row++;
  }

  function attributeautocomplete(attribute_row) {
	  $('input[name=\'product_attribute[' + attribute_row + '][name]\']').autocomplete({
		  'source': function(request, response) {
			  $.ajax({
				  url: 'index.php?route=catalog/attribute/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
				  dataType: 'json',
				  success: function(json) {
					  response($.map(json, function(item) {
						  return {
							  category: item.attribute_group,
							  label: item.name,
							  value: item.attribute_id
						  }
					  }));
				  }
			  });
		  },
		  'select': function(item) {
			  $('input[name=\'product_attribute[' + attribute_row + '][name]\']').val(item['label']);
			  $('input[name=\'product_attribute[' + attribute_row + '][attribute_id]\']').val(item['value']);
		  }
	  });
  }

  $('#attributes-container .dc-attr-row').each(function(index, element) {
	  attributeautocomplete(index);
  });

  function loadAttributeSet() {
	  var set_id = $('#dc-attribute-set-select').val();
	  if (!set_id) return;

	  var $existing = $('#attributes-container .dc-attr-row');
	  if ($existing.length && !confirm('{{ text_attribute_set_replace_confirm|e("js") }}')) {
		  return;
	  }

	  $.ajax({
		  url: 'index.php?route=catalog/attribute_set/getAttributes&user_token={{ user_token }}&attribute_set_id=' + set_id,
		  dataType: 'json',
		  success: function(json) {
			  if (json['error']) {
				  if (typeof showToast === 'function') showToast(json['error'], 'error');
				  return;
			  }

			  if (!json.length) {
				  if (typeof showToast === 'function') showToast('{{ text_attribute_set_empty|e("js") }}', 'error');
				  return;
			  }

			  $('#attributes-container .dc-attr-row').remove();

			  var added = 0;

			  $.each(json, function(i, item) {
				  if (!item || !item.attribute_id) return;

				  addAttribute();
				  var row = attribute_row - 1;
				  $('input[name=\'product_attribute[' + row + '][name]\']').val(item['name']);
				  $('input[name=\'product_attribute[' + row + '][attribute_id]\']').val(item['attribute_id']);
				  added++;
			  });

			  if (typeof showToast === 'function') {
				  showToast('{{ text_attribute_set_loaded|e("js") }}'.replace('%d', added), 'success');
			  }
			  lucide.createIcons();
		  }
	  });
  }

  var option_row = {{ option_row }};
  var dcOptionMode = {{ is_configurable ? "'combined'" : "'simple'" }};
  var dcAxisOptionIds = {{ axis_option_ids|json_encode|raw }};

  function dcUpdatePricingMode(show) {
    var $priceInput = $('#input-price');
    var $qtyInput = $('#input-quantity');
    var textNoVariants = '{{ text_no_variants|e("js") }}';
    if (show) {
      $priceInput.prop('readonly', true).attr('data-toggle', 'tooltip').attr('title', '{{ help_price_range_computed|e("js") }}');
      $qtyInput.prop('readonly', true).attr('data-toggle', 'tooltip').attr('title', '{{ help_quantity_computed|e("js") }}');
      $('#dc-cgp-field').hide();
      $priceInput.closest('#dc-price-main').find('label').find('[data-toggle="tooltip"]').tooltip({container:'body',html:true});
    } else {
      $priceInput.prop('readonly', false).removeAttr('data-toggle').removeAttr('title');
      $qtyInput.prop('readonly', false).removeAttr('data-toggle').removeAttr('title');
      $('#dc-cgp-field').show();
      $('#dc-pricing-variants-col').hide();
      $('#dc-inventory-variants-col').hide();
      $('#dc-dimensions-variants-col').hide();
      $('#dc-codes-variants-col').hide();
      if (typeof removeMediaVariantSelects === 'function') {
        removeMediaVariantSelects();
      }
    }
    dcUpdateDimensionsMode(show);
    // refresh tooltip
    $('[data-toggle="tooltip"]').tooltip({container:'body',html:true});
  }

  function dcUpdateDimensionsMode(show) {
    var textNoVariants = '{{ text_no_variants|e("js") }}';
    var $length = $('#input-length');
    var $width = $('#input-width');
    var $height = $('#input-height');
    var $weight = $('#input-weight');
    if (show) {
      $length.prop('readonly', true).attr('data-toggle', 'tooltip').attr('title', '{{ help_dimension_range_computed|e("js") }}');
      $width.prop('readonly', true).attr('data-toggle', 'tooltip').attr('title', '{{ help_dimension_range_computed|e("js") }}');
      $height.prop('readonly', true).attr('data-toggle', 'tooltip').attr('title', '{{ help_dimension_range_computed|e("js") }}');
      $weight.prop('readonly', true).attr('data-toggle', 'tooltip').attr('title', '{{ help_weight_range_computed|e("js") }}');
    } else {
      // restore editable state (values will be whatever was before switching; keep user-editable)
      // We do not restore original product values here — simple mode reload will be done via page reload or manual edit
      $length.prop('readonly', false).removeAttr('data-toggle').removeAttr('title');
      $width.prop('readonly', false).removeAttr('data-toggle').removeAttr('title');
      $height.prop('readonly', false).removeAttr('data-toggle').removeAttr('title');
      $weight.prop('readonly', false).removeAttr('data-toggle').removeAttr('title');
    }
  }

  function dcUpdatePricingRanges(json) {
    if (!json) return;
    var $priceInput = $('#input-price');
    if (typeof json.price_range_text !== 'undefined') {
      var txt = json.price_range_text ? json.price_range_text : '{{ text_no_variants|e("js") }}';
      // Only overwrite when in combined mode; in simple mode keep user price
      if (dcOptionMode === 'combined') {
        $priceInput.val(txt);
      }
    }
    $('[data-toggle="tooltip"]').tooltip({container:'body',html:true});
  }

  function dcUpdateDimensionsRanges(json) {
    if (!json) return;
    var textNoVariants = '{{ text_no_variants|e("js") }}';
    if (typeof json.length_range_text !== 'undefined' && dcOptionMode === 'combined') {
      $('#input-length').val(json.length_range_text ? json.length_range_text : textNoVariants);
    }
    if (typeof json.width_range_text !== 'undefined' && dcOptionMode === 'combined') {
      $('#input-width').val(json.width_range_text ? json.width_range_text : textNoVariants);
    }
    if (typeof json.height_range_text !== 'undefined' && dcOptionMode === 'combined') {
      $('#input-height').val(json.height_range_text ? json.height_range_text : textNoVariants);
    }
    if (typeof json.weight_range_text !== 'undefined' && dcOptionMode === 'combined') {
      $('#input-weight').val(json.weight_range_text ? json.weight_range_text : textNoVariants);
    }
    $('[data-toggle="tooltip"]').tooltip({container:'body',html:true});
  }

  function dcUpdateSpecialNote() {
    var notes = [
      '#dc-note-warehouse-inventory'
    ];
    var show = (dcOptionMode === 'combined');
    $.each(notes, function(i, selector) {
      $(selector).toggle(show);
    });
    // Simple mode keeps the hint below the inventory row; combined mode moves
    // it into the banner above the variant stock matrix.
    $('#dc-wh-hint-simple').toggle(!show);
    dcUpdatePricingMode(show);
  }

  $(document).ready(function() {
    if (dcOptionMode === 'combined') {
      loadVariantMatrix();
    }

    dcUpdateSpecialNote();

    $('#dc-toggle-mode-btn').on('click', function() {
      var newMode = (dcOptionMode === 'simple') ? 'combined' : 'simple';

      if (newMode === 'simple') {
        if (!confirm('{{ text_confirm_switch_to_simple|e("js") }}')) {
          return;
        }
      }

      var productId = getDcProductId();

      if (!productId || productId == '0') {
        alert('{{ text_save_product_first|e("js") }}');
        return;
      }

      $.ajax({
        url: 'index.php?route=catalog/product_configurable/setMode&user_token={{ user_token }}',
        type: 'POST',
        data: {product_id: productId, mode: newMode},
        dataType: 'json',
        success: function(json) {
          if (json.error) {
            alert(json.error);
            return;
          }

          dcOptionMode = newMode;

          var $simpleOptions = $('.dc-option-mode-selector').closest('.dcx-panel-body').find('.row:first');
          var $axes = $('.dc-option-axis', $simpleOptions);

          if (newMode === 'simple') {
            $simpleOptions.removeClass('dc-opts-axis-hidden');
            $axes.find(':input').prop('disabled', false);
            $('#dc-variants-section').hide();
          } else {
            $simpleOptions.addClass('dc-opts-axis-hidden');
            $axes.find(':input').prop('disabled', true);
            $('#dc-variants-section').show();
            loadVariantMatrix();
          }

          $('#dc-mode-saved').fadeIn(200).delay(1500).fadeOut(400);

          var newLabel = newMode === 'combined' ? '{{ text_mode_combined }}' : '{{ text_mode_simple }}';
          var newBtnHtml = newMode === 'combined'
            ? '<i data-lucide="arrow-left" width="14" height="14"></i> {{ text_switch_to_simple }}'
            : '{{ text_switch_to_combined }} <i data-lucide="arrow-right" width="14" height="14"></i>';
          var newSpanClass = newMode === 'combined' ? 'label-primary' : 'label-default';

          $('#dc-toggle-mode-btn').html(newBtnHtml);
          $('#dc-option-mode-label').removeClass('label-primary label-default').addClass(newSpanClass).html('<i data-lucide="circle" width="10" height="10"></i> ' + newLabel);
          lucide.createIcons();
          dcUpdateSpecialNote();
          if (typeof json.price_range_text !== 'undefined') {
            dcUpdatePricingRanges(json);
          } else if (newMode === 'combined') {
            // Fallback: refresh pricing from matrix endpoint
            $.getJSON('index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId, function(mj) {
              if (mj && typeof mj.price_range_text !== 'undefined') dcUpdatePricingRanges(mj);
            });
          }
          if (typeof json.weight_range_text !== 'undefined' || typeof json.length_range_text !== 'undefined') {
            dcUpdateDimensionsRanges(json);
          } else if (newMode === 'combined') {
            $.getJSON('index.php?route=catalog/product_configurable/getMatrix&user_token={{ user_token }}&product_id=' + productId, function(mj) {
              if (mj && typeof mj.weight_range_text !== 'undefined') dcUpdateDimensionsRanges(mj);
            });
          }
        }
      });
    });

    $('#form-product').on('submit', dcValidateAxisPrices);

    var $optTree = $('.dc-opt-add .dcx-tree-select');
    if ($optTree.length) {
      var setOptFilter = function() {
        var inst = $optTree.data('dcx-tree-select');
        if (!inst || inst.filterCallback) return;
        inst.filterCallback = function(data) {
          var existingIds = [];
          $('#dc-options-container input[name$="[option_id]"]').each(function() {
            var val = parseInt($(this).val());
            if (val) existingIds.push(val);
          });
          return data.filter(function(item) {
            return existingIds.indexOf(parseInt(item.category_id)) === -1;
          });
        };
      };
      setTimeout(setOptFilter, 100);
      $(document).one('click', '.dc-opt-add .dcx-tree-select', function() {
        setOptFilter();
      });
    }

    $('[data-toggle="tooltip"]').tooltip({ container: 'body', html: true });

    $('#product-category').toggle($('#product-category .dcx-tree-select__well-item').length > 0);
    $('#product-download').toggle($('#product-download .dcx-tree-select__well-item').length > 0);
    $('#product-related').toggle($('#product-related .dcx-picker__well-item').length > 0);
    $('#product-related-category').toggle($('#product-related-category .dcx-tree-select__well-item').length > 0);
    $('#product-upsell').toggle($('#product-upsell .dcx-picker__well-item').length > 0);
    $('#product-accessory').toggle($('#product-accessory .dcx-picker__well-item').length > 0);
    $('#product-fbt').toggle($('#product-fbt .dcx-picker__well-item').length > 0);
    $('#product-similar').toggle($('#product-similar .dcx-picker__well-item').length > 0);
  });

  function dcValidateAxisPrices() {
    if (dcOptionMode !== 'combined') return true;

    $('.dc-option-axis [data-axis-price="1"]').each(function() {
      if (parseFloat($(this).val()) > 0) {
        $(this).val(0);
      }
    });

    return true;
  }

  function dcRemoveOption(option_row) {
	  var $section = $('#option-section' + option_row);
	  if ($section.hasClass('dc-option-axis')) {
		  showToast('{{ error_simple_option_is_axis|e("js") }}', 'error');
		  return;
	  }
	  $section.remove();
	  updateOptionCount();
  }

  function updateOptionCount() {
	  var count = $('#dc-options-container .dc-option-section').length;
	  $('#dc-option-count').text('(' + count + ')');
  }

  $(document).on('change', '.dc-opt-add .dcx-tree-select input[type="hidden"]', function() {
	  var optionId = parseInt($(this).val());
	  if (!optionId || optionId <= 0) return;

	  var $treeSelect = $(this).closest('.dcx-tree-select');

	  if (dcAxisOptionIds.indexOf(optionId) >= 0) {
		  showToast('{{ error_simple_option_is_axis|e("js") }}', 'error');
		  dcResetTreeSelect($treeSelect);
		  return;
	  }

	  var existingIds = [];
	  $('#dc-options-container input[name$="[option_id]"]').each(function() {
		  var val = parseInt($(this).val());
		  if (val) existingIds.push(val);
	  });

	  if (existingIds.indexOf(optionId) >= 0) {
		  showToast('{{ error_option_already_added|e("js") }}', 'error');
		  dcResetTreeSelect($treeSelect);
		  return;
	  }

	  var optionName = $treeSelect.find('.dcx-tree-select__input').val();

	  $.ajax({
		  url: 'index.php?route=catalog/option/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(optionName),
		  dataType: 'json',
		  success: function(json) {
			  var matched = null;
			  for (var i = 0; i < json.length; i++) {
				  if (parseInt(json[i].option_id) === optionId) {
					  matched = json[i];
					  break;
				  }
			  }
			  if (!matched) return;

			  var item = {
				  label: matched.name,
				  value: matched.option_id,
				  type: matched.type,
				  option_value: matched.option_value
			  };

			  dcAddOption(item);
			  dcResetTreeSelect($treeSelect);
		  }
	  });
  });

  function dcResetTreeSelect($treeSelect) {
	  $treeSelect.find('input[type="hidden"]').val('');
	  $treeSelect.find('.dcx-tree-select__input').val('');
  }

