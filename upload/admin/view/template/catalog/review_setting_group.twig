{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="pull-right">
            <button type="submit" form="form-group" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ text_form }}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-group">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="list-checks" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ entry_group_name }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label">{{ entry_group_name }}</label>
                    {% for language in languages %}
                    <div class="dc-attr-row__value">
                      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                      <input type="text" name="group_name[{{ language.language_id }}]" value="{{ group_names[language.language_id] }}" placeholder="{{ entry_group_name }}" class="form-control" />
                    </div>
                    {% endfor %}
                  </div>
                  <div class="dcx-field">
                    <div class="dcx-checkbox-group">
                      <label class="dcx-checkbox-label">
                        <input type="hidden" name="is_default" value="0" />
                        <input type="checkbox" name="is_default" value="1" {% if is_default %}checked="checked"{% endif %} /> {{ entry_is_default }}
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="dcx-panel" style="margin-top: 16px;">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="star" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ heading_criteria }}</div>
                </div>
                <div class="dcx-panel-head__actions">
                  <button type="button" class="btn btn-default" id="button-add-criteria"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_criteria }}</button>
                </div>
              </div>
              <div class="dcx-panel-body">
                {% if not criteria_rows %}
                <p class="text-muted criteria-empty-hint" style="font-size: 13px; margin-bottom: 12px;">{{ text_no_criteria }}</p>
                {% endif %}
                <div class="dc-criteria-list" id="criteria-list">
                  {% set cidx = 0 %}
                  {% for row in criteria_rows %}
                  <div class="dc-criteria-card" id="criteria-row{{ cidx }}">
                    <div class="dc-criteria-card__header">
                      <span class="dc-criteria-card__title">{{ row.names[admin_language_id] is defined and row.names[admin_language_id].name ? row.names[admin_language_id].name : entry_criteria_name }}</span>
                      <button type="button" class="btn btn-danger btn-xs btn-remove-criteria" data-toggle="tooltip" title="{{ button_delete }}"><i data-lucide="circle-minus" width="14" height="14"></i></button>
                    </div>
                    <div class="dc-criteria-card__body">
                      <input type="hidden" name="criteria_id[{{ cidx }}]" value="{{ row.criteria_id }}" />
                      <div class="dc-criteria-card__meta">
                        <div class="dc-criteria-card__type">
                          <label>{{ column_type }}</label>
                          <select name="criteria_type[{{ cidx }}]" class="form-control">
                            <option value="text" {% if row.type == 'text' %}selected="selected"{% endif %}>{{ text_type_text }}</option>
                            <option value="rating" {% if row.type == 'rating' %}selected="selected"{% endif %}>{{ text_type_rating }}</option>
                          </select>
                        </div>
                        <div class="dc-criteria-card__required">
                          <label class="dcx-checkbox-label" style="display: flex; align-items: center; gap: 6px; font-size: 12px; white-space: nowrap;"><input type="checkbox" name="criteria_required[{{ cidx }}]" value="1" {% if row.is_required %}checked="checked"{% endif %} /> {{ column_required }}</label>
                        </div>
                      </div>
                      <ul class="nav nav-tabs">
                        {% for language in languages %}
                        <li><a href="#criteria-{{ cidx }}-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span></a></li>
                        {% endfor %}
                      </ul>
                      <div class="tab-content dc-criteria-card__tabs">
                        {% for language in languages %}
                        <div class="tab-pane" id="criteria-{{ cidx }}-{{ language.language_id }}">
                          <div class="dcx-field">
                            <label class="dcx-label">{{ entry_criteria_name }}</label>
                            <input type="text" name="criteria_name[{{ cidx }}][{{ language.language_id }}]" value="{{ row.names[language.language_id].name }}" placeholder="{{ entry_criteria_name }}" class="form-control" />
                          </div>
                          <div class="dcx-field" style="margin-top: 8px;">
                            <label class="dcx-label">{{ entry_criteria_help }}</label>
                            <input type="text" name="criteria_help[{{ cidx }}][{{ language.language_id }}]" value="{{ row.names[language.language_id].help }}" placeholder="{{ entry_criteria_help }}" class="form-control" />
                          </div>
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                  {% set cidx = cidx + 1 %}
                  {% endfor %}
                </div>
                <div class="dcx-fields" style="margin-top: 12px;">
                  <button type="button" class="btn btn-primary btn-sm" onclick="addCriteria();"><i data-lucide="circle-plus" width="16" height="16"></i> {{ button_add_criteria }}</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script type="text/javascript"><!--
var criteria_row = {{ criteria_rows|length }};

function addCriteria() {
	var html = '';
	html += '<div class="dc-criteria-card" id="criteria-row' + criteria_row + '">';
	html += '  <div class="dc-criteria-card__header">';
	html += '    <span class="dc-criteria-card__title">{{ entry_criteria_name }}</span>';
	html += '    <button type="button" class="btn btn-danger btn-xs btn-remove-criteria"><i data-lucide="circle-minus" width="14" height="14"></i></button>';
	html += '  </div>';
	html += '  <div class="dc-criteria-card__body">';
	html += '    <input type="hidden" name="criteria_id[' + criteria_row + ']" value="0" />';
	html += '    <div class="dc-criteria-card__meta">';
	html += '      <div class="dc-criteria-card__type"><label>{{ column_type }}</label>';
	html += '        <select name="criteria_type[' + criteria_row + ']" class="form-control">';
	html += '          <option value="text">{{ text_type_text }}</option>';
	html += '          <option value="rating">{{ text_type_rating }}</option>';
	html += '        </select></div>';
	html += '      <div class="dc-criteria-card__required"><label class="dcx-checkbox-label" style="display:flex; align-items:center; gap:6px; font-size:12px; white-space:nowrap;"><input type="checkbox" name="criteria_required[' + criteria_row + ']" value="1" /> {{ column_required }}</label></div>';
	html += '    </div>';
	html += '    <ul class="nav nav-tabs">';
	{% for language in languages %}
	html += '      <li><a href="#criteria-' + criteria_row + '-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span></a></li>';
	{% endfor %}
	html += '    </ul>';
	html += '    <div class="tab-content dc-criteria-card__tabs">';
	{% for language in languages %}
	html += '      <div class="tab-pane" id="criteria-' + criteria_row + '-{{ language.language_id }}">';
	html += '        <div class="dcx-field"><label class="dcx-label">{{ entry_criteria_name }}</label>';
	html += '          <input type="text" name="criteria_name[' + criteria_row + '][{{ language.language_id }}]" placeholder="{{ entry_criteria_name }}" class="form-control" /></div>';
	html += '        <div class="dcx-field" style="margin-top:8px;"><label class="dcx-label">{{ entry_criteria_help }}</label>';
	html += '          <input type="text" name="criteria_help[' + criteria_row + '][{{ language.language_id }}]" placeholder="{{ entry_criteria_help }}" class="form-control" /></div>';
	html += '      </div>';
	{% endfor %}
	html += '    </div>';
	html += '  </div>';
	html += '</div>';

	$('#criteria-list').append(html);
	$('#criteria-row' + criteria_row + ' .nav-tabs a:first').tab('show');
	$('.criteria-empty-hint').hide();
	lucide.createIcons();
	criteria_row++;
}

$(document).on('click', '.btn-remove-criteria', function() {
	$(this).closest('.dc-criteria-card').remove();
});

$(function() {
	$('#button-add-criteria').on('click', addCriteria);
	$('#criteria-list .dc-criteria-card').each(function() {
		$(this).find('.nav-tabs a:first').tab('show');
	});
});
//--></script>
{{ footer }}
