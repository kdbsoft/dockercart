{{ header }}
<link rel="stylesheet" href="view/stylesheet/dockercart_dcx_ui.css" />
{% if text_min is not defined %}
{% set text_min = 'Min' %}
{% endif %}
{% if text_max is not defined %}
{% set text_max = 'Max' %}
{% endif %}
<style>
small.text-muted svg { vertical-align: middle; }
</style>
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn--icon"><i data-lucide="plus" width="16" height="16"></i></a>
            <button type="submit" form="form-product" formaction="{{ copy }}" data-toggle="tooltip" title="{{ button_copy }}" class="btn btn-default btn--icon"><i data-lucide="copy" width="16" height="16"></i></button>
            <button type="button" form="form-product" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="confirm('{{ text_confirm }}') ? $('#form-product').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i></button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="check-circle" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div id="filter-product" class="filter-bar">
      <div class="panel panel-default">
        <div class="panel-body">
          <div class="filter-field">
            <label>{{ entry_name }}</label>
            <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
          </div>
          <div class="filter-field">
            <label>{{ entry_model }}</label>
            <input type="text" name="filter_model" value="{{ filter_model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control" />
          </div>
          <div class="filter-field">
            <label>{{ entry_sku }}</label>
            <input type="text" name="filter_sku" value="{{ filter_sku }}" placeholder="{{ entry_sku }}" id="input-sku" class="form-control" />
          </div>
          <div class="filter-field">
            <label>{{ entry_price }}</label>
            <input type="text" name="filter_price" value="{{ filter_price }}" placeholder="{{ entry_price }}" id="input-price" class="form-control" />
          </div>
          <div class="filter-field filter-field-quantity">
            <label>{{ entry_quantity }}</label>
            <div class="filter-quantity-range">
              <input type="text" name="filter_quantity_min" value="{{ filter_quantity_min }}" placeholder="{{ text_min }}" id="input-quantity-min" class="form-control" />
              <input type="text" name="filter_quantity_max" value="{{ filter_quantity_max }}" placeholder="{{ text_max }}" id="input-quantity-max" class="form-control" />
            </div>
          </div>
          <div class="filter-field">
            <label>{{ entry_status }}</label>
            <select name="filter_status" id="input-status" class="form-control">
              <option value=""></option>
              {% if filter_status == '1' %}
              <option value="1" selected="selected">{{ text_enabled }}</option>
              {% else %}
              <option value="1">{{ text_enabled }}</option>
              {% endif %}
              {% if filter_status == '0' %}
              <option value="0" selected="selected">{{ text_disabled }}</option>
              {% else %}
              <option value="0">{{ text_disabled }}</option>
              {% endif %}
            </select>
          </div>
          <div class="filter-field">
            <label>{{ entry_manufacturer }}</label>
            <input type="text" name="filter_manufacturer" value="{{ filter_manufacturer }}" placeholder="{{ entry_manufacturer }}" id="input-manufacturer" class="form-control" />
          </div>
          <div class="filter-field">
            <label>{{ entry_category }}</label>
            <div class="dcx-tree-select"
                 data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}"
                 data-none-text="{{ text_none }}"
                 data-placeholder="{{ entry_category }}">
              <div class="dcx-tree-select__input-wrap">
                <input type="text" name="filter_category" value="{{ filter_category }}" placeholder="{{ entry_category }}" class="dcx-tree-select__input form-control" autocomplete="off" />
                <input type="hidden" name="filter_category_id" value="{{ filter_category_id }}" />
                <span class="dcx-tree-select__toggle">
                  <i data-lucide="chevron-down" width="16" height="16"></i>
                </span>
              </div>
              <div class="dcx-tree-select__dropdown">
                <div class="dcx-tree-select__search">
                  <input type="text" class="form-control" placeholder="{{ text_quick_find }}" />
                  <i data-lucide="search" width="14" height="14"></i>
                </div>
                <div class="dcx-tree-select__list">
                  <div class="dcx-tree-select__item dcx-tree-select__item--none" data-id="0" data-name="{{ text_none }}">
                    <span class="dcx-tree-select__label">{{ text_none }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="filter-actions">
            <button type="button" id="button-filter" class="btn btn-default"><i data-lucide="filter" width="14" height="14"></i> {{ button_filter }}</button>
          </div>
          {% if text_filter_hint %}
          <div class="filter-field" style="width:100%;flex-basis:100%;">
            <small class="text-muted" style="display:inline-flex;align-items:center;gap:4px;"><i data-lucide="info" width="14" height="14"></i> {{ text_filter_hint }}</small>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-product">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                      <td class="text-left">{% if sort == 'pd.name' %} <a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a> {% else %} <a href="{{ sort_name }}" class="sortable">{{ column_name }}</a> {% endif %}</td>
                      <td class="text-left">{% if sort == 'p.model' %} <a href="{{ sort_model }}" class="{{ order|lower }} sortable">{{ column_model }}</a> {% else %} <a href="{{ sort_model }}" class="sortable">{{ column_model }}</a> {% endif %}</td>
                      <td class="text-left">{{ column_category }}</td>
                      <td class="text-right">{% if sort == 'p.price' %} <a href="{{ sort_price }}" class="{{ order|lower }} sortable">{{ column_price }}</a> {% else %} <a href="{{ sort_price }}" class="sortable">{{ column_price }}</a> {% endif %}</td>
                      <td class="text-right">{% if sort == 'p.quantity' %} <a href="{{ sort_quantity }}" class="{{ order|lower }} sortable">{{ column_quantity }}</a> {% else %} <a href="{{ sort_quantity }}" class="sortable">{{ column_quantity }}</a> {% endif %}</td>
                      <td class="text-left">{% if sort == 'p.status' %} <a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a> {% else %} <a href="{{ sort_status }}" class="sortable">{{ column_status }}</a> {% endif %}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>

                  {% if products %}
                  {% for product in products %}
                  <tr>
                    <td class="text-center">{% if product.product_id in selected %}
                      <input type="checkbox" name="selected[]" value="{{ product.product_id }}" checked="checked" />
                      {% else %}
                      <input type="checkbox" name="selected[]" value="{{ product.product_id }}" />
                      {% endif %}</td>
                    <td class="text-left" style="white-space:nowrap;">
                      <input type="hidden" id="input-image-{{ product.product_id }}" value="{{ product.image_path }}" /><a href="javascript:void(0);" class="product-image-edit" id="thumb-image-{{ product.product_id }}" data-product-id="{{ product.product_id }}" style="display:inline-block;vertical-align:middle;margin-right:8px;">{% if product.image %} <img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" /> {% else %} <span class="img-thumbnail list"><i data-lucide="camera" width="24" height="24"></i></span> {% endif %}</a>
                      <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="name" data-value="{{ product.name_raw }}">
                        {{ product.name }}
                        <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                      </span>
                    </td>
                    <td class="text-left">
                      <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="model" data-value="{{ product.model_raw }}">
                        {{ product.model }}
                        <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                      </span>
                    </td>
                    <td class="text-left">
                      <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="categories" data-value="{{ product.categories_raw }}">
                        {{ product.categories }}
                        <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                      </span>
                    </td>
                    <td class="text-right">
                      {% if product.special %}
                        <span style="text-decoration: line-through;">
                          <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="price" data-value="{{ product.price_raw }}">{{ product.price }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                        </span><br/>
                        <div class="text-danger">{{ product.special }}</div>
                      {% else %}
                        <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="price" data-value="{{ product.price_raw }}">{{ product.price }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                      {% endif %}
                    </td>
                    <td class="text-right">
                      {% if product.has_options %}
                        {% set qty_val = product.option_qty_sum %}
                        <span title="{{ text_options }}: {{ product.option_values_count }}">
                          {% if qty_val <= 0 %}
                            <span style="color:#e74c3c;font-weight:600;">{{ product.quantity }}</span>
                          {% elseif qty_val <= 5 %}
                            <span style="color:#e67e22;font-weight:600;">{{ product.quantity }}</span>
                          {% else %}
                            <span style="color:#27ae60;font-weight:600;">{{ product.quantity }}</span>
                          {% endif %}
                          <small style="color:#6c757d;font-size:11px;"> ({{ product.option_values_count }} {{ text_variant }})</small>
                        </span>
                      {% else %}
                        <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="quantity" data-value="{{ product.quantity_raw }}">
                          {% if product.quantity <= 0 %}
                            <span style="color:#e74c3c;font-weight:600;">{{ product.quantity }}</span>
                          {% elseif product.quantity <= 5 %}
                            <span style="color:#e67e22;font-weight:600;">{{ product.quantity }}</span>
                          {% else %}
                            <span style="color:#27ae60;font-weight:600;">{{ product.quantity }}</span>
                          {% endif %}
                          <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                        </span>
                      {% endif %}
                    </td>
                    <td class="text-left">
                      <span class="inline-edit" data-product-id="{{ product.product_id }}" data-field="status" data-value="{{ product.status_raw }}">
                        {% if product.status_raw %}
                        <span class="page-header__badge page-header__badge--active">{{ text_enabled }}</span>
                        {% else %}
                        <span class="page-header__badge page-header__badge--inactive">{{ text_disabled }}</span>
                        {% endif %}
                        <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                      </span>
                    </td>
                    <td class="text-right"><a href="{{ product.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a> <a href="{{ product.copy }}" data-toggle="tooltip" title="{{ button_copy }}" class="btn btn-default btn--icon"><i data-lucide="copy" width="14" height="14"></i></a> <a href="{{ product.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="return confirm('{{ text_confirm }}');"><i data-lucide="trash-2" width="14" height="14"></i></a></td>
                  </tr>
                  {% endfor %}
                  {% else %}
                  <tr>
                    <td class="text-center" colspan="8">{{ text_no_results }}</td>
                  </tr>
                  {% endif %}
                    </tbody>

                </table>
              </div>
            </form>
            <div class="pagination-wrap">
              <div class="row">
                <div class="col-sm-6 text-left">{{ pagination }}</div>
                <div class="col-sm-6 text-right">{{ results }}</div>
              </div>
            </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_model = $('input[name=\'filter_model\']').val();

	if (filter_model) {
		url += '&filter_model=' + encodeURIComponent(filter_model);
	}

	var filter_sku = $('input[name=\'filter_sku\']').val();

	if (filter_sku) {
		url += '&filter_sku=' + encodeURIComponent(filter_sku);
	}

	var filter_price = $('input[name=\'filter_price\']').val();

	if (filter_price) {
		url += '&filter_price=' + encodeURIComponent(filter_price);
	}

	var filter_quantity_min = $('input[name=\'filter_quantity_min\']').val();

	if (filter_quantity_min) {
		url += '&filter_quantity_min=' + encodeURIComponent(filter_quantity_min);
	}

	var filter_quantity_max = $('input[name=\'filter_quantity_max\']').val();

	if (filter_quantity_max) {
		url += '&filter_quantity_max=' + encodeURIComponent(filter_quantity_max);
	}

	var filter_status = $('select[name=\'filter_status\']').val();

	if (filter_status !== '') {
		url += '&filter_status=' + encodeURIComponent(filter_status);
	}

	var filter_manufacturer = $('input[name=\'filter_manufacturer\']').val();

	if (filter_manufacturer) {
		url += '&filter_manufacturer=' + encodeURIComponent(filter_manufacturer);
	}

	var filter_category = $('input[name=\'filter_category\']').val();

	if (filter_category) {
		url += '&filter_category=' + encodeURIComponent(filter_category);
	}

	var filter_category_id = $('input[name=\'filter_category_id\']').val();

	if (filter_category_id && filter_category_id !== '0') {
		url += '&filter_category_id=' + encodeURIComponent(filter_category_id);
	}

	location = 'index.php?route=catalog/product&user_token={{ user_token }}' + url;
});
//--></script>
  <script type="text/javascript"><!--
$('#filter-product input, #filter-product select').on('keypress', function(e) {
	if (e.which == 13) {
		$('#button-filter').trigger('click');
	}
});
//--></script>
  <script type="text/javascript"><!--
// IE and Edge fix!
$('button[form=\'form-product\']').on('click', function(e) {
	$('#form-product').attr('action', $(this).attr('formaction'));
});

$('input[name=\'filter_name\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_name\']').val(item['label']);
	}
});

$('input[name=\'filter_model\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_model=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['model'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_model\']').val(item['label']);
	}
});

$('input[name=\'filter_manufacturer\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/manufacturer/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['manufacturer_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_manufacturer\']').val(item['label']);
	}
});
//--></script>
<script type="text/javascript"><!--
$(document).on('click', '.inline-edit-icon', function(e) {
	e.stopPropagation();

	var $span = $(this).closest('.inline-edit');
	if ($span.find('input, select').length) return;

	var field = $span.data('field');
	var rawValue = $span.data('value');

	$span.data('display', $span.html());

	if (field === 'status') {
		var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
		$select.append('<option value="1"' + (rawValue == 1 ? ' selected' : '') + '>{{ text_enabled }}</option>');
		$select.append('<option value="0"' + (rawValue == 0 ? ' selected' : '') + '>{{ text_disabled }}</option>');
		$span.html($select);
		$select.focus();

		var saved = false;

		$select.on('change', function() {
			saved = true;
			var productId = $span.data('product-id');
			var newValue = $(this).val();

			$.ajax({
				url: 'index.php?route=catalog/product/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { product_id: productId, field: 'status', value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					$span.html($span.data('display'));
				}
			});
		});

		$select.on('blur', function() {
			if (!saved) {
				$span.html($span.data('display'));
			}
		});
	} else if (field === 'name') {
		var productId = $span.data('product-id');

		$.ajax({
			url: 'index.php?route=catalog/product/getName&user_token={{ user_token }}&product_id=' + productId,
			dataType: 'json',
			success: function(json) {
				if (json['error']) {
					$span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
					setTimeout(function() { $span.html($span.data('display')); }, 3000);
					return;
				}

				var html = '<div class="inline-edit-names" style="white-space:nowrap;">';
				$.each(json['languages'], function(i, lang) {
					var val = json['names'][lang.language_id] || '';
					html += '<div style="margin-bottom:2px;">';
					html += '<span style="font-weight:bold;font-size:11px;margin-right:4px;">' + lang.name + ':</span>';
					html += '<input type="text" class="form-control input-sm inline-edit-name-input" data-lang-id="' + lang.language_id + '" value="' + val.replace(/"/g, '&quot;') + '" style="width:200px;display:inline-block;">';
					html += '</div>';
				});
				html += '<div style="margin-top:4px;"><button type="button" class="btn btn-primary btn-xs inline-edit-name-save">{{ button_save }}</button></div>';
				html += '</div>';

				$span.html(html);
				$span.find('input').first().focus();

				var reverted = false;

				$span.on('click', '.inline-edit-name-save', function() {
					var names = {};
					$span.find('.inline-edit-name-input').each(function() {
						names[$(this).data('lang-id')] = $(this).val();
					});

					$.ajax({
						url: 'index.php?route=catalog/product/updateNames&user_token={{ user_token }}',
						type: 'post',
						dataType: 'json',
						data: { product_id: productId, names: names },
						success: function(res) {
							if (res['error']) {
								$span.append(' <span class="text-danger inline-edit-error">' + res['error'] + '</span>');
								setTimeout(function() { $span.find('.inline-edit-error').remove(); }, 3000);
							} else {
								reverted = true;
								$span.data('value', res['value_html']);
								$span.html(res['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
								lucide.createIcons({ nodes: [$span[0]] });
							}
						},
						error: function() {
							$span.html($span.data('display'));
						}
					});
				});

				$span.find('.inline-edit-name-input').on('keydown', function(e) {
					if (e.which === 27) {
						reverted = true;
						$span.html($span.data('display'));
					}
				});

				$(document).one('click', function(e) {
					if (!$(e.target).closest('.inline-edit-names').length && !reverted) {
						$span.html($span.data('display'));
					}
				});
			},
			error: function() {
				$span.html($span.data('display'));
			}
		});
	} else if (field === 'categories') {
		editProductId = $span.data('product-id');
		var categoryIds = rawValue ? String(rawValue).split(',') : [];

		var $treeSelect = $('#category-tree-modal .dcx-tree-select');
		var treeInstance = $treeSelect.data('dcx-tree-select');

		if (!treeInstance) {
			DcxTreeSelect.init('#category-tree-modal .dcx-tree-select');
			treeInstance = $treeSelect.data('dcx-tree-select');
		}

		if (treeInstance) {
			treeInstance.setSelected(categoryIds);
		}

		$('#category-tree-modal').modal('show');
	} else {
		var currentDisplay = $span.clone().children('.inline-edit-icon').remove().children('.page-header__badge').remove().end().text().trim();

		$span.html('<input type="text" class="form-control input-sm inline-edit-input" value="' + rawValue + '">');
		var $input = $span.find('input');
		$input.focus().select();

		function revert() {
			$span.html($span.data('display'));
		}

		function save() {
			var newValue = $input.val();
			var productId = $span.data('product-id');

			$.ajax({
				url: 'index.php?route=catalog/product/updateField&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: { product_id: productId, field: field, value: newValue },
				success: function(json) {
					if (json['error']) {
						$span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
						setTimeout(function() { $span.html($span.data('display')); }, 3000);
					} else {
						$span.data('value', newValue);
						$span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
						lucide.createIcons({ nodes: [$span[0]] });
					}
				},
				error: function() {
					revert();
				}
			});
		}

		$input.on('blur', save);
		$input.on('keydown', function(e) {
			if (e.which === 13) { e.preventDefault(); $input.trigger('blur'); }
			if (e.which === 27) { revert(); }
		});
	}
});

$(document).on('click', '.product-image-edit', function(e) {
	e.preventDefault();

	var $link = $(this);
	var productId = $link.data('product-id');

	$('#modal-image').remove();

	$.ajax({
		url: 'index.php?route=common/filemanager&user_token={{ user_token }}',
		dataType: 'html',
		success: function(html) {
			$('body').append('<div id="modal-image" class="modal">' + html + '</div>');

			$('#modal-image').on('click', 'a.thumbnail', function(e) {
				e.preventDefault();

				var imagePath = $(this).closest('.filemanager-item').find('input[name^=\'path\']').val();
				var thumbSrc = $(this).find('img').attr('src');

				var $img = $link.find('img');
				if ($img.length) {
					$img.attr('src', thumbSrc);
				} else {
					$link.html('<img src="' + thumbSrc + '" alt="" class="img-thumbnail" />');
				}

				$.ajax({
					url: 'index.php?route=catalog/product/updateImage&user_token={{ user_token }}',
					type: 'post',
					dataType: 'json',
					data: { product_id: productId, image: imagePath }
				});

				$('#modal-image').modal('hide');
			});

			$('#modal-image').modal('show');
		}
	});
});
//--></script>

<!-- Category Tree Modal -->
<div id="category-tree-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title"><i data-lucide="folder-tree" width="18" height="18" style="margin-right:8px;"></i>{{ text_select_category }}</h4>
      </div>
      <div class="modal-body">
        <div class="dcx-tree-select"
             data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}"
             data-mode="multi"
             data-none-text="{{ text_none }}"
             data-placeholder="{{ text_filter }}">
          <div class="dcx-tree-select__search">
            <input type="text" class="form-control" placeholder="{{ text_filter }}" id="category-tree-search" />
            <i data-lucide="search" width="14" height="14"></i>
          </div>
          <div class="dcx-tree-select__list" style="max-height:400px"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
        <button type="button" class="btn btn-primary" id="category-tree-confirm">{{ button_continue }}</button>
      </div>
    </div>
  </div>
</div>
<!-- /Category Tree Modal -->

<script type="text/javascript"><!--
var editProductId = null;

$(document).on('click', '#category-tree-confirm', function() {
	var $treeSelect = $('#category-tree-modal .dcx-tree-select');
	var treeInstance = $treeSelect.data('dcx-tree-select');

	if (!treeInstance || !editProductId) {
		$('#category-tree-modal').modal('hide');
		return;
	}

	var categoryIds = Object.keys(treeInstance.selectedItems);
	var currentProductId = editProductId;

	$.ajax({
		url: 'index.php?route=catalog/product/updateField&user_token={{ user_token }}',
		type: 'post',
		dataType: 'json',
		data: { product_id: currentProductId, field: 'categories', value: categoryIds.join(',') },
		success: function(json) {
			if (json['error']) {
				alert(json['error']);
			} else {
				var $span = $('.inline-edit[data-product-id="' + currentProductId + '"][data-field="categories"]');
				$span.data('value', categoryIds.join(','));
				$span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
				lucide.createIcons({ nodes: [$span[0]] });
			}
		},
		error: function() {
			alert('Error');
		}
	});

	editProductId = null;
	$('#category-tree-modal').modal('hide');
});
//--></script>
