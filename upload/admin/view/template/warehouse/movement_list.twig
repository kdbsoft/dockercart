{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <button type="submit" form="form-movement" class="btn btn-primary"><i data-lucide="arrow-right-left" width="16" height="16"></i> {{ text_add }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="dcx-shell">
      <div class="dcx-panel">
        <div class="dcx-panel-head">
          <div class="dcx-panel-head__icon"><i data-lucide="arrow-right-left" width="18" height="18"></i></div>
          <div><div class="dcx-panel-title">{{ text_add_movement }}</div></div>
        </div>
        <div class="dcx-panel-body">
          <form action="{{ add }}" method="post" enctype="multipart/form-data" id="form-movement">
            <div class="dcx-fields">
              <div class="dcx-field required">
                <label class="dcx-label" for="input-warehouse">{{ entry_warehouse }}</label>
                <select name="warehouse_id" id="input-warehouse" class="form-control">
                  <option value="0">--</option>
                  {% for warehouse in warehouses %}
                  <option value="{{ warehouse.warehouse_id }}">{{ warehouse.name }}</option>
                  {% endfor %}
                </select>
                {% if error_warehouse %}<div class="text-danger">{{ error_warehouse }}</div>{% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-type">{{ entry_type }}</label>
                <select name="type" id="input-type" class="form-control">
                  {% for key, label in types %}
                  <option value="{{ key }}">{{ label }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-product">{{ entry_product }}</label>
                <input type="text" name="product" id="input-product" value="" placeholder="{{ entry_product_id }}" class="form-control" />
                <input type="hidden" name="product_id" id="input-product-id" value="" />
                <input type="hidden" name="variant_id" id="input-variant-id" value="0" />
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-quantity">{{ entry_quantity }}</label>
                <input type="number" name="quantity" id="input-quantity" value="" class="form-control" style="max-width:160px;" min="0" step="any" />
                {% if error_quantity %}<div class="text-danger">{{ error_quantity }}</div>{% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-reference">{{ entry_reference }}</label>
                <input type="text" name="reference" id="input-reference" value="" class="form-control" />
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-comment">{{ entry_comment }}</label>
                <input type="text" name="comment" id="input-comment" value="" class="form-control" />
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="dcx-shell">
      <div class="dcx-panel dcx-panel--flush">
        <div class="dcx-panel-body">
          <form class="form-inline dcx-filter" method="get">
            <input type="hidden" name="route" value="warehouse/movement" />
            <input type="hidden" name="user_token" value="{{ user_token }}" />
            {% for key, value in filter %}
            {% if key starts with 'filter_' %}<input type="hidden" name="{{ key }}" value="{{ value }}" />{% endif %}
            {% endfor %}
            <div class="form-group">
              <label class="control-label">{{ entry_warehouse }}</label>
              <select name="filter_warehouse_id" class="form-control">
                <option value="">--</option>
                {% for warehouse in warehouses %}
                <option value="{{ warehouse.warehouse_id }}"{% if filter.filter_warehouse_id == warehouse.warehouse_id %} selected="selected"{% endif %}>{{ warehouse.name }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="form-group">
              <label class="control-label">{{ entry_type }}</label>
              <select name="filter_type" class="form-control">
                <option value="">--</option>
                {% for key, label in types %}
                <option value="{{ key }}"{% if filter.filter_type == key %} selected="selected"{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="form-group">
              <label class="control-label">{{ entry_order_id }}</label>
              <input type="text" name="filter_order_id" value="{{ filter.filter_order_id }}" class="form-control" style="width:100px;" />
            </div>
            <button type="submit" class="btn btn-default">{{ button_filter }}</button>
          </form>
        </div>
      </div>
    </div>

    {% if movements %}
    <div class="table-responsive">
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <td>{{ column_date }}</td>
            <td>{{ column_warehouse }}</td>
            <td>{{ column_product }}</td>
            <td>{{ column_type }}</td>
            <td class="text-right">{{ column_quantity }}</td>
            <td>{{ column_reference }}</td>
            <td>{{ column_comment }}</td>
          </tr>
        </thead>
        <tbody>
          {% for movement in movements %}
          <tr>
            <td>{{ movement.date }}</td>
            <td>{{ movement.warehouse }}</td>
            <td>{{ movement.product_model }}{% if movement.variant_sku %} / {{ movement.variant_sku }}{% endif %}
              <a href="{{ stock_map_url }}&product_id={{ movement.product_id }}&variant_id={{ movement.variant_id }}&warehouse_id={{ movement.warehouse_id }}" class="btn btn-xs btn-default" data-toggle="tooltip" title="{{ text_stock_map }}"><i data-lucide="list" width="12" height="12"></i></a>
            </td>
            <td><span class="label label-default">{{ movement.type }}</span></td>
            <td class="text-right {% if movement.quantity > 0 %}text-success{% else %}text-danger{% endif %}">{{ movement.quantity }}</td>
            <td>{{ movement.reference }}</td>
            <td>{{ movement.comment }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
    {% else %}
    <div class="text-muted text-center" style="padding:40px;">{{ text_no_results }}</div>
    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
var userToken = '{{ user_token }}';
$('#input-product').autocomplete({
	source: function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token=' + userToken + '&filter_name=' + encodeURIComponent(request.term),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return { label: item['name'] + ' (' + item['model'] + ')', value: item['product_id'], model: item['model'] };
				}));
			}
		});
	},
	select: function(item) {
		$('#input-product').val(item['label']);
		$('#input-product-id').val(item['value']);
		$('#input-variant-id').val(0);
		return false;
	}
});
//--></script>
{{ footer }}