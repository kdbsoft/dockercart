{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-warehouse').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if warehouses %}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-warehouse">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left"><a href="{{ sort_name }}" class="sortable">{{ column_name }}</a></td>
              <td class="text-left"><a href="{{ sort_type }}" class="sortable">{{ column_type }}</a></td>
              <td class="text-right"><a href="{{ sort_priority }}" class="sortable">{{ column_priority }}</a></td>
              <td class="text-left"><a href="{{ sort_default }}" class="{{ order|lower }} sortable">{{ column_default }}</a></td>
              <td class="text-left"><a href="{{ sort_status }}" class="sortable">{{ column_status }}</a></td>
            </tr>
          </thead>
          <tbody>
            {% for warehouse in warehouses %}
            <tr data-href="{{ warehouse.edit }}">
              <td class="text-center">{% if warehouse.warehouse_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ warehouse.warehouse_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ warehouse.warehouse_id }}" />
                {% endif %}</td>
              <td class="text-left">{{ warehouse.name }}</td>
              <td class="text-left">
                {% if warehouse.type == 'physical' %}<span class="label label-info">{{ warehouse.type }}</span>
                {% elseif warehouse.type == 'dropship' %}<span class="label label-warning">{{ warehouse.type }}</span>
                {% else %}<span class="label label-default">{{ warehouse.type }}</span>{% endif %}
              </td>
              <td class="text-right">{{ warehouse.priority }}</td>
              <td class="text-left">{% if warehouse.is_default %}<span class="label label-success">{{ text_default }}</span>{% endif %}</td>
              <td class="text-left">
                {% if warehouse.status %}
                <span class="label label-success">{{ text_enabled }}</span>
                {% else %}
                <span class="label label-danger">{{ text_disabled }}</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
    {% else %}
      {% include 'common/empty_state.twig' with { icon: 'warehouse', standalone: true } %}
    {% endif %}
  </div>
</div>
{{ footer }}