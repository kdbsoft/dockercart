{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-api" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-api">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs">
                <li class="active"><a href="#tab-general" data-toggle="tab"><i data-lucide="file-text" width="14" height="14"></i> {{ tab_general }}</a></li>
                <li><a href="#tab-ip" data-toggle="tab"><i data-lucide="shield" width="14" height="14"></i> {{ tab_ip }}</a></li>
                <li><a href="#tab-session" data-toggle="tab"><i data-lucide="desktop" width="14" height="14"></i> {{ tab_session }}</a></li>
              </ul>
              <div class="tab-content">
                <div class="tab-pane active" id="tab-general">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-username">{{ entry_username }}</label>
                      <input type="text" name="username" value="{{ username }}" placeholder="{{ entry_username }}" id="input-username" class="form-control" />
                      {% if error_username %}
                      <div class="text-danger">{{ error_username }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-key">{{ entry_key }}</label>
                      <textarea name="key" placeholder="{% if api_id %}{{ help_key }}{% else %}{{ entry_key }}{% endif %}" rows="5" id="input-key" class="form-control">{{ key }}</textarea>
                      <div style="margin-top: 8px;">
                        <button type="button" id="button-generate" class="btn btn-primary"><i data-lucide="refresh-cw" width="14" height="14"></i> {{ button_generate }}</button>
                      </div>
                      {% if api_id and help_key %}
                      <p class="help-block" style="margin-top:5px;color:#737373;"><i data-lucide="info" width="14" height="14"></i> {{ help_key }}</p>
                      {% endif %}
                      {% if error_key %}
                      <div class="text-danger">{{ error_key }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                      <select name="status" id="input-status" class="form-control">
                        {% if status %}
                        <option value="0">{{ text_disabled }}</option>
                        <option value="1" selected="selected">{{ text_enabled }}</option>
                        {% else %}
                        <option value="0" selected="selected">{{ text_disabled }}</option>
                        <option value="1">{{ text_enabled }}</option>
                        {% endif %}
                      </select>
                    </div>
                  </div>
                </div>
                <div class="tab-pane" id="tab-ip">
                  <div class="alert alert-info"><i data-lucide="info" width="16" height="16"></i> {{ text_ip }}</div>
                  <div id="ip-list">
                    {% set ip_row = 0 %}
                    {% for api_ip in api_ips %}
                    <div class="dc-api-ip-item" id="ip-row{{ ip_row }}">
                      <div class="dc-api-ip-item__field">
                        <input type="text" name="api_ip[]" value="{{ api_ip.ip }}" placeholder="{{ entry_ip }}" class="form-control" />
                      </div>
                      <button type="button" onclick="$('#ip-row{{ ip_row }}').remove()" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon"><i data-lucide="minus-circle" width="16" height="16"></i></button>
                    </div>
                    {% set ip_row = ip_row + 1 %}
                    {% endfor %}
                  </div>
                  <button type="button" onclick="addIp()" class="btn btn-primary btn-sm" style="margin-top:12px;"><i data-lucide="plus-circle" width="14" height="14"></i> {{ button_ip_add }}</button>
                </div>
                <div class="tab-pane" id="tab-session">
                  {% if api_sessions %}
                  <div class="dc-api-session-list">
                    {% for api_session in api_sessions %}
                    <div class="dc-api-session-item">
                      <div class="dc-api-session-item__body">
                        <div class="dc-api-session-item__token">{{ api_session.session_id }}</div>
                        <div class="dc-api-session-item__meta">
                          <span><i data-lucide="globe" width="12" height="12"></i> {{ api_session.ip }}</span>
                          <span><i data-lucide="calendar" width="12" height="12"></i> {{ api_session.date_added }}</span>
                          <span><i data-lucide="clock" width="12" height="12"></i> {{ api_session.date_modified }}</span>
                        </div>
                      </div>
                      <button type="button" value="{{ api_session.api_session_id }}" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon dc-api-session-item__remove"><i data-lucide="minus-circle" width="16" height="16"></i></button>
                    </div>
                    {% endfor %}
                  </div>
                  {% else %}
                  <div class="dc-api-session-empty">
                    <i data-lucide="monitor" width="32" height="32"></i>
                    <p>{{ text_no_results }}</p>
                  </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('#button-generate').on('click', function() {
	rand = '';

	string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';

	for (i = 0; i < 256; i++) {
		rand += string[Math.floor(Math.random() * (string.length - 1))];
	}

	$('#input-key').val(rand);
});
//--></script>
  <script type="text/javascript"><!--
var ip_row = {{ ip_row }};

function addIp() {
	var html = '<div class="dc-api-ip-item" id="ip-row' + ip_row + '">';
	html += '  <div class="dc-api-ip-item__field">';
	html += '    <input type="text" name="api_ip[]" value="" placeholder="{{ entry_ip }}" class="form-control" />';
	html += '  </div>';
	html += '  <button type="button" onclick="$(\'#ip-row' + ip_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon"><i data-lucide="minus-circle" width="16" height="16"></i></button>';
	html += '</div>';

	$('#ip-list').append(html);

	lucide.createIcons();

	ip_row++;
}
//--></script>
  <script type="text/javascript"><!--
$('#tab-session').on('click', '.dc-api-session-item__remove', function(e) {
	e.preventDefault();

	var node = this;

	$.ajax({
		url: 'index.php?route=user/api/deletesession&user_token={{ user_token }}&api_session_id=' + $(node).val(),
		type: 'post',
		dataType: 'json',
		beforeSend: function() {
			$(node).button('loading');
		},
		complete: function() {
			$(node).button('reset');
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#tab-session').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				lucide.createIcons();
			}

			if (json['success']) {
				$('#tab-session').prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="check-circle" width="16" height="16"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				lucide.createIcons();

				$(node).closest('.dc-api-session-item').remove();
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
<style>
.dc-api-ip-item { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.dc-api-ip-item__field { flex: 1; }
.dc-api-session-list { display: flex; flex-direction: column; gap: 8px; }
.dc-api-session-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--dc-border-soft);
  border-radius: var(--dc-radius-lg);
  background: var(--dc-surface);
  transition: border-color .15s;
}
.dc-api-session-item:hover { border-color: var(--dc-border); }
.dc-api-session-item__body { flex: 1; min-width: 0; }
.dc-api-session-item__token { font-size: 13px; font-weight: 600; color: var(--dc-text-dark); font-family: monospace; word-break: break-all; }
.dc-api-session-item__meta { display: flex; align-items: center; gap: 12px; margin-top: 4px; font-size: 12px; color: var(--dc-text-muted); flex-wrap: wrap; }
.dc-api-session-item__meta span { display: inline-flex; align-items: center; gap: 4px; }
.dc-api-session-item__remove { flex-shrink: 0; }
.dc-api-session-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 32px 16px;
  color: var(--dc-text-muted);
  text-align: center;
}
.dc-api-session-empty p { margin: 0; font-size: 13px; }
</style>
</div>
{{ footer }}
