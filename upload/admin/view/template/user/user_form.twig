{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-user" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-user">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-username">{{ entry_username }}</label>
                  <input type="text" name="username" value="{{ username }}" placeholder="{{ entry_username }}" id="input-username" class="form-control" />
                  {% if error_username %}
                  <div class="text-danger">{{ error_username }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-user-group">{{ entry_user_group }}</label>
                  <select name="user_group_id" id="input-user-group" class="form-control">
                    {% for user_group in user_groups %}
                    {% if user_group.user_group_id == user_group_id %}
                    <option value="{{ user_group.user_group_id }}" selected="selected">{{ user_group.name }}</option>
                    {% else %}
                    <option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-firstname">{{ entry_firstname }}</label>
                    <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control" />
                    {% if error_firstname %}
                    <div class="text-danger">{{ error_firstname }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-lastname">{{ entry_lastname }}</label>
                    <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control" />
                    {% if error_lastname %}
                    <div class="text-danger">{{ error_lastname }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-email">{{ entry_email }}</label>
                  <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                  {% if error_email %}
                  <div class="text-danger">{{ error_email }}</div>
                  {% endif %}
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-password">{{ entry_password }}</label>
                    <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control" autocomplete="off" />
                    {% if error_password %}
                    <div class="text-danger">{{ error_password }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-confirm">{{ entry_confirm }}</label>
                    <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" id="input-confirm" class="form-control" autocomplete="off" />
                    {% if error_confirm %}
                    <div class="text-danger">{{ error_confirm }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_image }}</label>
                  <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="image" value="{{ image }}" id="input-image" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-shell">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="power" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
                <select name="status" id="input-status" class="form-control">
                  {% if status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>

    {% if api_can_view %}
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="key-round" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_api_keys }}</div>
                <div class="dcx-panel-subtitle">{{ text_api_keys_help }}</div>
              </div>
              {% if api_can_edit %}
              <div class="dcx-panel-head__actions">
                <button type="button" class="btn btn-primary btn-sm" id="button-api-key-new"><i data-lucide="plus" width="14" height="14"></i> {{ button_api_key_add }}</button>
              </div>
              {% endif %}
            </div>
            <div class="dcx-panel-body">
              {% if api_new_token %}
              <div class="alert alert-warning">
                <h4><i data-lucide="key-round" width="16" height="16"></i> {{ text_api_token_once }}</h4>
                <p>{{ text_api_token_help }}</p>
                <div class="input-group" style="max-width: 720px;">
                  <input type="text" id="input-new-token" class="form-control" value="{{ api_new_token }}" readonly="readonly" spellcheck="false" onclick="this.select();" />
                  <span class="input-group-btn">
                    <button type="button" class="btn btn-default" id="button-copy-token"><i data-lucide="copy" width="14" height="14"></i> {{ button_api_key_copy }}</button>
                  </span>
                </div>
                <p class="text-muted" style="margin-top:10px;">
                  <code>curl -H "Authorization: Bearer {{ api_new_token }}" {{ api_base_url }}/products</code>
                </p>
              </div>
              {% endif %}

              {% if api_can_edit %}
              <form action="{{ api_create_action }}" method="post" id="form-api-key-create" style="display:none;">
                <div class="dcx-fields">
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 240px;">
                      <label class="dcx-label" for="input-api-name">{{ entry_api_key_name }}</label>
                      <input type="text" name="name" id="input-api-name" class="form-control" maxlength="128" placeholder="{{ entry_api_key_name }}" />
                    </div>
                    <div class="dcx-field" style="flex:1 1 320px;">
                      <label class="dcx-label" for="input-api-comment">{{ entry_api_key_comment }}</label>
                      <input type="text" name="comment" id="input-api-comment" class="form-control" placeholder="{{ entry_api_key_comment }}" />
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 200px;">
                      <label class="dcx-label" for="input-api-expires">{{ entry_api_key_expires }}</label>
                      <input type="date" name="expires_at" id="input-api-expires" class="form-control" />
                      <div class="dcx-field-help">{{ help_api_key_expires }}</div>
                    </div>
                    <div class="dcx-field" style="flex:1 1 160px;">
                      <label class="dcx-label" for="input-api-rate-limit">{{ entry_api_key_rate_limit }}</label>
                      <input type="number" min="0" name="rate_limit" id="input-api-rate-limit" class="form-control" />
                      <div class="dcx-field-help">{{ help_api_key_rate_limit }}</div>
                    </div>
                    <div class="dcx-field" style="flex:1 1 260px;">
                      <label class="dcx-label" for="input-api-ip">{{ entry_api_key_ip_allowlist }}</label>
                      <input type="text" name="ip_allowlist" id="input-api-ip" class="form-control" placeholder="203.0.113.10" />
                      <div class="dcx-field-help">{{ help_api_key_ip_allowlist }}</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <button type="submit" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_api_key_create }}</button>
                  </div>
                </div>
              </form>
              {% endif %}

              {% if api_keys is not empty %}
              <div class="table-responsive">
                <table class="table table-bordered table-hover dcx-table">
                  <thead>
                    <tr>
                      <th>{{ column_api_name }}</th>
                      <th>{{ column_api_prefix }}</th>
                      <th>{{ column_api_status }}</th>
                      <th>{{ column_api_expires }}</th>
                      <th>{{ column_api_last_used }}</th>
                      <th class="text-right">{{ column_api_requests }}</th>
                      {% if api_can_edit %}<th class="text-right">{{ column_api_action }}</th>{% endif %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for key in api_keys %}
                    <tr>
                      <td>
                        <strong>{{ key.name }}</strong>
                        {% if key.comment %}<div class="text-muted small">{{ key.comment }}</div>{% endif %}
                      </td>
                      <td><code>{{ key.prefix }}…</code></td>
                      <td>
                        {% if key.status_value and not key.is_expired %}
                        <span class="label label-success">{{ key.status }}</span>
                        {% else %}
                        <span class="label label-danger">{{ key.status }}</span>
                        {% endif %}
                        {% if key.is_expired %}<span class="label label-warning">{{ text_api_expired }}</span>{% endif %}
                      </td>
                      <td>{{ key.expires_at ? key.expires_at : text_api_never }}</td>
                      <td>
                        {% if key.last_used_at %}
                        {{ key.last_used_at }}
                        {% else %}
                        <span class="text-muted">{{ text_api_never }}</span>
                        {% endif %}
                      </td>
                      <td class="text-right">
                        {{ key.requests_24h }} / {{ key.requests_total }}
                        {% if key.rate_limit %}<div class="text-muted small">{{ text_api_limit }}: {{ key.rate_limit }}/{{ text_api_minute }}</div>{% endif %}
                      </td>
                      {% if api_can_edit %}
                      <td class="text-right" style="white-space: nowrap;">
                        <a href="{{ key.rotate }}" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{ button_api_key_rotate }}" data-confirm="{{ text_api_key_rotate_confirm }}"><i data-lucide="refresh-cw" width="14" height="14"></i></a>
                        {% if key.status_value %}
                        <a href="{{ key.revoke }}" class="btn btn-warning btn-sm" data-toggle="tooltip" title="{{ button_api_key_revoke }}" data-confirm="{{ text_api_key_revoke_confirm }}"><i data-lucide="ban" width="14" height="14"></i></a>
                        {% else %}
                        <a href="{{ key.enable }}" class="btn btn-success btn-sm" data-toggle="tooltip" title="{{ button_api_key_enable }}"><i data-lucide="circle-check" width="14" height="14"></i></a>
                        {% endif %}
                        <a href="{{ key.delete }}" class="btn btn-danger btn-sm" data-toggle="tooltip" title="{{ button_api_key_delete }}" data-confirm="{{ text_api_key_delete_confirm }}"><i data-lucide="trash-2" width="14" height="14"></i></a>
                      </td>
                      {% endif %}
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              {% else %}
              <p class="text-muted">{{ text_api_keys_empty }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
(function () {
	var toggle = document.getElementById('button-api-key-new');
	var form = document.getElementById('form-api-key-create');

	if (toggle && form) {
		toggle.addEventListener('click', function () {
			if (form.style.display === 'none') {
				form.style.display = 'block';

				var input = document.getElementById('input-api-name');

				if (input) {
					input.focus();
				}
			} else {
				form.style.display = 'none';
			}
		});
	}

	var copyButton = document.getElementById('button-copy-token');

	if (copyButton) {
		copyButton.addEventListener('click', function () {
			var input = document.getElementById('input-new-token');
			input.select();
			document.execCommand('copy');
			copyButton.classList.add('btn-success');
		});
	}

	document.querySelectorAll('[data-confirm]').forEach(function (element) {
		element.addEventListener('click', function (event) {
			if (!confirm(element.getAttribute('data-confirm'))) {
				event.preventDefault();
			}
		});
	});
})();
//--></script>
{{ footer }}
