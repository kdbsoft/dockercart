{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="pull-right">
            <button type="submit" form="form-user-group" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-user-group">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="users" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
                <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-name">{{ entry_name }}</label>
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_access }}</label>
                  <div class="dcx-picker__well">
                    {% for permission in permissions %}
                    <label class="dcx-picker__well-item">
                      <input type="checkbox" name="permission[access][]" value="{{ permission.route }}" {% if permission.route in access %}checked="checked"{% endif %} />
                      <span>{{ permission.name }}{% if permission.title %} — {{ permission.title }}{% endif %}</span>
                    </label>
                    {% endfor %}
                  </div>
                  <div style="margin-top:6px;">
                    <button type="button" onclick="$(this).closest('.dcx-field').find(':checkbox').prop('checked', true);" class="btn btn-default btn-xs"><i data-lucide="square-check" width="12" height="12"></i> {{ text_select_all }}</button>
                    <button type="button" onclick="$(this).closest('.dcx-field').find(':checkbox').prop('checked', false);" class="btn btn-default btn-xs"><i data-lucide="square" width="12" height="12"></i> {{ text_unselect_all }}</button>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_modify }}</label>
                  <div class="dcx-picker__well">
                    {% for permission in permissions %}
                    <label class="dcx-picker__well-item">
                      <input type="checkbox" name="permission[modify][]" value="{{ permission.route }}" {% if permission.route in modify %}checked="checked"{% endif %} />
                      <span>{{ permission.name }}{% if permission.title %} — {{ permission.title }}{% endif %}</span>
                    </label>
                    {% endfor %}
                  </div>
                  <div style="margin-top:6px;">
                    <button type="button" onclick="$(this).closest('.dcx-field').find(':checkbox').prop('checked', true);" class="btn btn-default btn-xs"><i data-lucide="square-check" width="12" height="12"></i> {{ text_select_all }}</button>
                    <button type="button" onclick="$(this).closest('.dcx-field').find(':checkbox').prop('checked', false);" class="btn btn-default btn-xs"><i data-lucide="square" width="12" height="12"></i> {{ text_unselect_all }}</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
{{ footer }}
