<div class="dcx-panel">
  <div class="dcx-panel-head">
    <div class="pull-right">
      <a href="{{ reset }}" class="btn btn-danger btn-xs"><i data-lucide="refresh-cw" width="14" height="14"></i> {{ button_reset }}</a>
    </div>
    <div class="dcx-panel-head__icon"><i data-lucide="funnel" width="14" height="14"></i></div>
    <div>
      <h3 class="dcx-panel-title">{{ heading_title }}</h3>
      <div class="dcx-panel-head__subtitle">{{ text_report_subtitle }}</div>
    </div>
  </div>
  <div class="dcx-panel-body">
    <div class="table-responsive">
      <table class="table table-bordered">
        <thead>
          <tr>
            <td class="text-left">{{ column_name }}</td>
            <td class="text-left">{{ column_model }}</td>
            <td class="text-right">{{ column_viewed }}</td>
            <td class="text-right">{{ column_percent }}</td>
          </tr>
        </thead>
        <tbody>
        
        {% if products %}
        {% for product in products %}
        <tr>
          <td class="text-left">{{ product.name }}</td>
          <td class="text-left">{{ product.model }}</td>
          <td class="text-right">{{ product.viewed }}</td>
          <td class="text-right">{{ product.percent }}</td>
        </tr>
        {% endfor %}
        {% else %}
        <tr>
          <td class="text-center" colspan="4">{{ text_no_results }}</td>
        </tr>
        {% endif %}
        </tbody>
      </table>
    </div>
    <div class="row">
      <div class="col-sm-6 text-left"><div class="pagination-wrap">{{ pagination }}</div></div>
      <div class="col-sm-6 text-right">{{ results }}</div>
    </div>
  </div>
</div>
