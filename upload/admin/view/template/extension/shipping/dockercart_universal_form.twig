{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if status is defined %}
              <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-method" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="truck" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{% if method_id %}{{ text_edit_method }}{% else %}{{ text_add_method }}{% endif %}</div>
                <div class="dcx-panel-subtitle">{{ text_method_form_description }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-method">
                <div class="dcx-section" style="margin-top:0;padding-top:0;border-top:0;">
                  <h4><i data-lucide="languages" width="16" height="16"></i> {{ text_name_description }}</h4>
                  <ul class="nav nav-tabs" id="lang-tabs">
                    {% for language in languages %}
                    <li{% if loop.first %} class="active"{% endif %}>
                      <a href="#lang-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a>
                    </li>
                    {% endfor %}
                  </ul>
                  <div class="tab-content">
                    {% for language in languages %}
                    <div class="tab-pane{% if loop.first %} active{% endif %}" id="lang-{{ language.language_id }}">
                      <div class="dcx-fields">
                        <div class="dcx-field{% if error_name[language.language_id] %} has-error{% endif %}">
                          <label class="dcx-label" for="input-name-{{ language.language_id }}">{{ entry_name }} <span class="text-danger">*</span></label>
                          <input type="text" name="method_description[{{ language.language_id }}][name]" value="{{ method_description[language.language_id].name }}" placeholder="{{ entry_name }}" id="input-name-{{ language.language_id }}" class="form-control" />
                          {% if error_name[language.language_id] %}
                          <div class="text-danger">{{ error_name[language.language_id] }}</div>
                          {% endif %}
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-description-{{ language.language_id }}">{{ entry_description }}</label>
                          <textarea name="method_description[{{ language.language_id }}][description]" rows="3" placeholder="{{ entry_description }}" id="input-description-{{ language.language_id }}" class="form-control">{{ method_description[language.language_id].description }}</textarea>
                          <div class="help-block">{{ help_description }}</div>
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-delivery-time-{{ language.language_id }}">{{ entry_delivery_time }}</label>
                          <input type="text" name="method_description[{{ language.language_id }}][delivery_time]" value="{{ method_description[language.language_id].delivery_time }}" placeholder="{{ entry_delivery_time_placeholder }}" id="input-delivery-time-{{ language.language_id }}" class="form-control" style="max-width:300px;" />
                          <div class="help-block">{{ help_delivery_time }}</div>
                        </div>
                      </div>
                    </div>
                    {% endfor %}
                  </div>
                </div>
                <div class="dcx-section">
                  <h4><i data-lucide="banknote" width="16" height="16"></i> {{ text_pricing }}</h4>
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-cost-type">{{ entry_cost_type }}</label>
                      <select name="cost_type" id="input-cost-type" class="form-control" style="max-width:250px;">
                        <option value="fixed"{% if cost_type == 'fixed' %} selected{% endif %}>{{ text_cost_fixed }}</option>
                        <option value="weight"{% if cost_type == 'weight' %} selected{% endif %}>{{ text_cost_weight }}</option>
                      </select>
                    </div>
                    <div class="dcx-field cost-fixed-group{% if error_cost %} has-error{% endif %}">
                      <label class="dcx-label" for="input-cost">{{ entry_cost }}</label>
                      <input type="text" name="cost" value="{{ cost }}" placeholder="0.00" id="input-cost" class="form-control" style="max-width:150px;" />
                      {% if error_cost %}
                      <div class="text-danger">{{ error_cost }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field cost-weight-group" style="display:none;">
                      <label class="dcx-label" for="input-weight-rates">{{ entry_weight_rates }}</label>
                      <textarea name="weight_rates" rows="4" placeholder="{{ entry_weight_rates_placeholder }}" id="input-weight-rates" class="form-control" style="max-width:400px;font-family:monospace;">{{ weight_rates }}</textarea>
                      <div class="help-block">{{ help_weight_rates }} {{ text_example }}: <code style="background:var(--dc-gray-100);padding:2px 6px;border-radius:4px;font-size:11px;">1:5.00,5:10.00,10:15.00</code></div>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-free-shipping">{{ entry_free_shipping_threshold }}</label>
                      <input type="text" name="free_shipping_threshold" value="{{ free_shipping_threshold }}" placeholder="0.00" id="input-free-shipping" class="form-control" style="max-width:150px;" />
                      <div class="help-block">{{ help_free_shipping }}</div>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-tax-class">{{ entry_tax_class }}</label>
                      <select name="tax_class_id" id="input-tax-class" class="form-control" style="max-width:250px;">
                        <option value="0">{{ text_none }}</option>
                        {% for tax_class in tax_classes %}
                        <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                        {% endfor %}
                      </select>
                    </div>
                  </div>
                </div>
                <div class="dcx-section">
                  <h4><i data-lucide="funnel" width="16" height="16"></i> {{ text_conditions }}</h4>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_geo_zone }}</label>
                      <select name="geo_zone_id" class="form-control">
                        <option value="0">{{ text_all_zones }}</option>
                        {% for geo_zone in geo_zones %}
                        <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                        {% endfor %}
                      </select>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_min_total }}</label>
                      <input type="text" name="min_total" value="{{ min_total }}" placeholder="0.00" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_max_total }}</label>
                      <input type="text" name="max_total" value="{{ max_total }}" placeholder="{{ text_unlimited }}" class="form-control" />
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_min_weight }}</label>
                      <input type="text" name="min_weight" value="{{ min_weight }}" placeholder="0" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_max_weight }}</label>
                      <input type="text" name="max_weight" value="{{ max_weight }}" placeholder="{{ text_unlimited }}" class="form-control" />
                    </div>
                  </div>
                </div>
                <div class="dcx-section">
                  <h4><i data-lucide="settings" width="16" height="16"></i> {{ text_status_sorting }}</h4>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                      <select name="status" id="input-status" class="form-control">
                        {% if status %}
                        <option value="1" selected>{{ text_enabled }}</option>
                        <option value="0">{{ text_disabled }}</option>
                        {% else %}
                        <option value="1">{{ text_enabled }}</option>
                        <option value="0" selected>{{ text_disabled }}</option>
                        {% endif %}
                      </select>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                      <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="0" id="input-sort-order" class="form-control" style="max-width:100px;" />
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
$(function() {
  function toggleCostType() {
    var type = $('#input-cost-type').val();
    if (type === 'fixed') {
      $('.cost-fixed-group').show();
      $('.cost-weight-group').hide();
    } else {
      $('.cost-fixed-group').hide();
      $('.cost-weight-group').show();
    }
  }
  $('#input-cost-type').on('change', toggleCostType);
  toggleCostType();
});
</script>
<style>
.dc-condition-row { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:16px; }
@media (max-width: 991px) { .dc-condition-row { grid-template-columns:1fr; } }
</style>
{{ footer }}
