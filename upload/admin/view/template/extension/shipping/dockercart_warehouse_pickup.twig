{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if shipping_dockercart_warehouse_pickup_status is defined %}
              <span class="page-header__badge {{ shipping_dockercart_warehouse_pickup_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ shipping_dockercart_warehouse_pickup_status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-pickup" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-pickup">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="warehouse" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_list }}</div>
                  <div class="dcx-panel-sub">{{ text_configure }}</div>
                </div>
              </div>
              <div class="dcx-panel-body dcx-panel-body--flush">
                {% if pickup_warehouses %}
                <div class="dcx-wh-grid">
                  {% for warehouse in pickup_warehouses %}
                  <div class="dcx-wh-card{% if not warehouse.status %} dcx-wh-card--off{% endif %}">
                    <a href="{{ warehouse.edit }}" class="dcx-wh-card__stretch" aria-label="{{ button_edit }}: {{ warehouse.name }}"></a>
                    <div class="dcx-wh-card__head">
                      <div class="dcx-wh-card__icon"><i data-lucide="warehouse" width="18" height="18"></i></div>
                      <div class="dcx-wh-card__title">
                        <span class="dcx-wh-card__name">{{ warehouse.name }}</span>
                        <span class="dcx-wh-card__badges">
                          <span class="dcx-wh-card__badge {{ warehouse.status ? 'dcx-wh-card__badge--on' : 'dcx-wh-card__badge--off' }}">{{ warehouse.status ? text_enabled : text_disabled }}</span>
                          {% if warehouse.is_default %}
                          <span class="dcx-wh-card__badge dcx-wh-card__badge--accent">{{ text_default }}</span>
                          {% endif %}
                        </span>
                      </div>
                    </div>
                    {% if warehouse.address or warehouse.phone or warehouse.email or warehouse.map_url %}
                    <div class="dcx-wh-card__meta">
                      {% if warehouse.address %}
                      <span class="dcx-wh-card__line"><i data-lucide="map-pin" width="14" height="14"></i><span>{{ warehouse.address }}</span></span>
                      {% endif %}
                      {% if warehouse.phone %}
                      <span class="dcx-wh-card__line"><i data-lucide="phone" width="14" height="14"></i><span>{{ warehouse.phone }}</span></span>
                      {% endif %}
                      {% if warehouse.email %}
                      <span class="dcx-wh-card__line"><i data-lucide="mail" width="14" height="14"></i><span>{{ warehouse.email }}</span></span>
                      {% endif %}
                      {% if warehouse.map_url %}
                      <a class="dcx-wh-card__line dcx-wh-card__line--link" href="{{ warehouse.map_url }}" target="_blank" rel="noopener"><i data-lucide="external-link" width="14" height="14"></i><span>{{ text_map }}</span></a>
                      {% endif %}
                    </div>
                    {% endif %}
                    <div class="dcx-wh-card__attrs">
                      <span class="dcx-wh-card__attr"><i data-lucide="coins" width="13" height="13"></i>{{ warehouse.pickup_cost }}</span>
                      {% if warehouse.prepare_days %}
                      <span class="dcx-wh-card__attr"><i data-lucide="clock" width="13" height="13"></i>{{ entry_prepare_days }}: {{ warehouse.prepare_days }}</span>
                      {% endif %}
                      {% if warehouse.next_pickup %}
                      <span class="dcx-wh-card__attr"><i data-lucide="calendar-clock" width="13" height="13"></i>{{ warehouse.next_pickup }}</span>
                      {% endif %}
                    </div>
                    {% if warehouse.pickup_note %}
                    <div class="dcx-wh-card__note">{{ warehouse.pickup_note }}</div>
                    {% endif %}
                  </div>
                  {% endfor %}
                </div>
                {% else %}
                <div class="dcx-wh-empty">
                  <i data-lucide="package-open" width="28" height="28"></i>
                  <p>{{ text_no_pickup }}</p>
                  <a href="{{ warehouse_link }}">{{ text_go_to_warehouses }}</a>
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
          {# Status #}
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ entry_status }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
                <select name="shipping_dockercart_warehouse_pickup_status" id="input-status" class="form-control">
                  {% if shipping_dockercart_warehouse_pickup_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-tax-class">{{ entry_tax_class }}</label>
                <select name="shipping_dockercart_warehouse_pickup_tax_class_id" id="input-tax-class" class="form-control">
                  <option value="0">{{ text_none }}</option>
                  {% for tax_class in tax_classes %}
                  {% if tax_class.tax_class_id == shipping_dockercart_warehouse_pickup_tax_class_id %}
                  <option value="{{ tax_class.tax_class_id }}" selected="selected">{{ tax_class.title }}</option>
                  {% else %}
                  <option value="{{ tax_class.tax_class_id }}">{{ tax_class.title }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
                <input type="number" name="shipping_dockercart_warehouse_pickup_sort_order" id="input-sort-order" value="{{ shipping_dockercart_warehouse_pickup_sort_order }}" class="form-control" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
{{ footer }}
