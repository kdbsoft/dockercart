{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="pull-right">
            <button type="submit" form="form-pickup" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-pickup">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="package-open" width="18" height="18"></i></div>
                <div><div class="dcx-panel-title">{{ heading_title }}</div></div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="hidden" name="shipping_dockercart_warehouse_pickup_status" value="0" />
                      <input type="checkbox" name="shipping_dockercart_warehouse_pickup_status" value="1"{% if shipping_dockercart_warehouse_pickup_status %} checked="checked"{% endif %}> {{ entry_status }}
                    </label>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                    <input type="number" name="shipping_dockercart_warehouse_pickup_sort_order" id="input-sort-order" value="{{ shipping_dockercart_warehouse_pickup_sort_order }}" class="form-control" style="max-width:160px;" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-tax-class">{{ entry_tax_class }}</label>
                    <select name="shipping_dockercart_warehouse_pickup_tax_class_id" id="input-tax-class" class="form-control">
                      <option value="0">{{ text_none }}</option>
                      {% for tax_class in tax_classes %}
                      {% if tax_class.tax_class_id == shipping_dockercart_warehouse_pickup_tax_class_id %}
                      <option value="{{ tax_class.tax_class_id }}" selected="selected">{{ tax_class.title }}</option>
                      {% else %}
                      <option value="{{ tax_class.tax_class_id }}">{{ tax_class.title }}</option>
                      {% endif %}
                      {% endfor %}
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="warehouse" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_list }}</div>
                  <div class="dcx-panel-sub">{{ text_configure }}</div>
                </div>
              </div>
              <div class="dcx-panel-body dcx-panel-body--flush">
                <table class="table table-bordered">
                  <thead>
                    <tr>
                      <td>{{ entry_warehouse }}</td>
                      <td>{{ entry_city }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% if pickup_warehouses %}
                    {% for warehouse in pickup_warehouses %}
                    <tr>
                      <td><a href="{{ warehouse_link }}">{{ warehouse.name }}</a></td>
                      <td>{{ warehouse.city }}</td>
                    </tr>
                    {% endfor %}
                    {% else %}
                    <tr><td colspan="2">{{ text_no_pickup }}</td></tr>
                    {% endif %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}