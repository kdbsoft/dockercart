{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
  <div class="page-header">


      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-dashboard" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if dashboard_sale_status is defined %}
              <span class="page-header__badge {{ dashboard_sale_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ dashboard_sale_status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
        </div>
      </div>
          {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}

      </div>
</div>
<div class="container-fluid"><form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-dashboard">
    <div class="row">
      <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_edit }}</div>
                <div class="dcx-panel-subtitle">{{ text_edit_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-width">{{ entry_width }}</label>
                  <select name="dashboard_sale_width" id="input-width" class="form-control">
                    {% for column in columns %}
                    {% if column == dashboard_sale_width %}
                    <option value="{{ column }}" selected="selected">{{ column }}</option>
                    {% else %}
                    <option value="{{ column }}">{{ column }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                  <input type="text" name="dashboard_sale_sort_order" value="{{ dashboard_sale_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="dashboard_sale_status" id="input-status" class="form-control">
                    {% if dashboard_sale_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3"></div>
    </div>
    </form>
  </div>
</div>
{{ footer }}
