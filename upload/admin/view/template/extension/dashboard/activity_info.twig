<div class="panel panel-default">
  <div class="dcx-panel-heading">
    <div class="dcx-panel-heading__icon"><i data-lucide="calendar"></i></div>
    <div>
      <h3 class="dcx-panel-title">{{ heading_title }}</h3>
      <div class="dcx-panel-heading__subtitle">{{ text_activity_subtitle }}</div>
    </div>
    <a href="{{ view_all }}" class="btn btn-default btn-xs pull-right" style="margin-left: 10px;">{{ text_view_all }}</a>
  </div>
  <ul class="list-group">
    {% if activities %}
    {% for activity in activities %}
    <li class="list-group-item">{{ activity.comment }}<br />
      <small class="text-muted"><i data-lucide="clock"></i> {{ activity.date_added }}</small></li>
    {% endfor %}
    {% else %}
    <li class="list-group-item text-center">{{ text_no_results }}</li>
    {% endif %}
  </ul>
</div>