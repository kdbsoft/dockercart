{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-dockercart-search" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ heading_title }}
              <span class="page-header__badge {{ module_dockercart_search_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ module_dockercart_search_status ? text_enabled : text_disabled }}
              </span>
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-success alert-dismissible"><i data-lucide="check-circle" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-dockercart-search">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_general }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }} <span data-toggle="tooltip" title="{{ help_status }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <select name="module_dockercart_search_status" id="input-status" class="form-control">
                    {% if module_dockercart_search_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-min-chars">{{ entry_min_chars }} <span data-toggle="tooltip" title="{{ help_min_chars }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="number" name="module_dockercart_search_min_chars" value="{{ module_dockercart_search_min_chars }}" id="input-min-chars" class="form-control" style="max-width:120px;" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-results-limit">{{ entry_results_limit }} <span data-toggle="tooltip" title="{{ help_results_limit }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="number" name="module_dockercart_search_results_limit" value="{{ module_dockercart_search_results_limit }}" id="input-results-limit" class="form-control" style="max-width:120px;" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-query-mappings">{{ entry_query_mappings }} <span data-toggle="tooltip" title="{{ help_query_mappings }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <textarea name="module_dockercart_search_query_mappings" id="input-query-mappings" rows="8" class="form-control">{{ module_dockercart_search_query_mappings }}</textarea>
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="plug" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_connection }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-host">{{ entry_host }} <span data-toggle="tooltip" title="{{ help_host }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="text" name="module_dockercart_search_host" value="{{ module_dockercart_search_host }}" id="input-host" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-port">{{ entry_port }} <span data-toggle="tooltip" title="{{ help_port }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="number" name="module_dockercart_search_port" value="{{ module_dockercart_search_port }}" id="input-port" class="form-control" style="max-width:120px;" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-http-port">{{ entry_http_port }} <span data-toggle="tooltip" title="{{ help_http_port }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="number" name="module_dockercart_search_http_port" value="{{ module_dockercart_search_http_port }}" id="input-http-port" class="form-control" style="max-width:120px;" />
                </div>
                <div class="dcx-field">
                  <button type="button" id="button-test" class="btn btn-success"><i data-lucide="plug" width="14" height="14"></i> {{ button_test_connection }}</button>
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="zap" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_autocomplete }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-autocomplete">{{ entry_autocomplete }} <span data-toggle="tooltip" title="{{ help_autocomplete }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <select name="module_dockercart_search_autocomplete" id="input-autocomplete" class="form-control" style="max-width:200px;">
                    {% if module_dockercart_search_autocomplete %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-autocomplete-limit">{{ entry_autocomplete_limit }} <span data-toggle="tooltip" title="{{ help_autocomplete_limit }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span></label>
                  <input type="number" name="module_dockercart_search_autocomplete_limit" value="{{ module_dockercart_search_autocomplete_limit }}" id="input-autocomplete-limit" class="form-control" style="max-width:120px;" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="refresh-cw" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ tab_indexing }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <div class="alert alert-warning" style="margin-bottom:0;"><i data-lucide="alert-triangle" width="14" height="14"></i> {{ text_reindex_warning }}</div>
            </div>
            <div class="dcx-sidebar-card__field">
              <button type="button" class="btn btn-primary btn-block" id="button-reindex"><i data-lucide="refresh-cw" width="14" height="14"></i> {{ button_reindex }}</button>
              <p class="help-block">{{ help_reindex }}</p>
            </div>
            <div id="reindex-progress" style="display:none;">
              <div class="progress">
                <div class="progress-bar progress-bar-striped active" role="progressbar" style="width: 100%">{{ text_reindexing }}</div>
              </div>
            </div>
            <div id="reindex-result"></div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="info" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ tab_about }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ text_developer }}</label>
              <div style="font-size:13px;color:var(--dc-text-dark);">{{ text_developer_name }}</div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ text_contact }}</label>
              <div style="font-size:13px;"><a href="mailto:support@dockercart.net">support@dockercart.net</a></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
{{ footer }}

<script>
/* <![CDATA[ */
var dcSearchUserToken = '{{ user_token|e("js") }}';
var dcSearchTestConnectionUrl = 'index.php?route=extension/module/dockercart_search/testConnection&user_token=' + encodeURIComponent(dcSearchUserToken);
var dcSearchReindexUrl = 'index.php?route=extension/module/dockercart_search/reindex&user_token=' + encodeURIComponent(dcSearchUserToken);

$('#button-test').on('click', function() {
  var btn = $(this);
  $.ajax({
    url: dcSearchTestConnectionUrl,
    type: 'post',
    dataType: 'json',
    beforeSend: function() {
      btn.prop('disabled', true).html('<i data-lucide="loader" width="14" height="14"></i> {{ button_test_connection|e("js") }}');
      lucide.createIcons();
    },
    complete: function() {
      btn.prop('disabled', false).html('<i data-lucide="plug" width="14" height="14"></i> {{ button_test_connection|e("js") }}');
      lucide.createIcons();
    },
    success: function(json) {
      if (json.success) {
        alert('\u2705 ' + json.message);
      } else {
        alert('\u274C ' + json.message);
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert('{{ text_error_label|e("js") }}: ' + thrownError + "\n" + xhr.statusText + "\n" + xhr.responseText);
    }
  });
});

$('#button-reindex').on('click', function() {
  if (!confirm('{{ text_reindex_confirm|e("js") }}')) {
    return;
  }

  $('#reindex-progress').show();
  $('#reindex-result').html('');

  $.ajax({
    url: dcSearchReindexUrl,
    type: 'post',
    dataType: 'json',
    success: function(json) {
      $('#reindex-progress').hide();

      if (json.success) {
        $('#reindex-result').html('<div class="alert alert-success"><i data-lucide="check-circle" width="14" height="14"></i> ' + json.message + '</div>');
      } else {
        $('#reindex-result').html('<div class="alert alert-danger"><i data-lucide="alert-circle" width="14" height="14"></i> ' + json.message + '</div>');
      }
      lucide.createIcons();
    },
    error: function(xhr, ajaxOptions, thrownError) {
      $('#reindex-progress').hide();
      $('#reindex-result').html('<div class="alert alert-danger">{{ text_error_label|e("js") }}: ' + thrownError + '</div>');
      lucide.createIcons();
    }
  });
});
/* ]]> */
</script>
