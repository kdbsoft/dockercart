{{ header }}{{ column_left }}
<div id="content">
  <script src="view/javascript/lucide.min.js"></script>

  <style>
  .dc-icon-picker-modal { display:none; position:fixed; inset:0; z-index:12000; }
  .dc-icon-picker-backdrop { position:absolute; inset:0; background:rgba(0,0,0,0.45); }
  .dc-icon-picker-panel { position:relative; max-width:860px; margin:6vh auto; background:#fff; border-radius:10px; padding:16px; box-shadow:0 10px 40px rgba(2,6,23,0.28); }
  .dc-icon-picker-header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
  .dc-icon-picker-search { width:100%; max-width:480px; }
  .dc-icon-picker-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(56px,1fr)); gap:8px; max-height:56vh; overflow:auto; padding:6px; }
  .dc-icon-option { display:flex; align-items:center; justify-content:center; border:1px solid var(--dc-border-soft); background:var(--dc-surface); padding:10px; border-radius:var(--dc-radius-md); cursor:pointer; transition: all .15s; }
  .dc-icon-option:hover { background:var(--dc-primary-50); border-color:var(--dc-primary-200); color:var(--dc-primary); }
  .dc-icon-option i { width:20px; height:20px; }

  .dc-icon-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--dc-border-soft);
    border-radius: var(--dc-radius-md);
    background: var(--dc-surface);
    cursor: pointer;
    transition: all .15s;
    flex-shrink: 0;
  }
  .dc-icon-trigger:hover { border-color: var(--dc-primary-300); background: var(--dc-primary-50); }
  .dc-icon-trigger i { width: 18px; height: 18px; color: var(--dc-text-muted); }
  .dc-icon-trigger:hover i { color: var(--dc-primary); }

  .sf-icon-display {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sf-icon-display__preview {
    width: 40px;
    height: 40px;
    border: 1px solid var(--dc-border-soft);
    border-radius: var(--dc-radius-md);
    background: var(--dc-primary-50);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    transition: all .15s;
  }
  .sf-icon-display__preview:hover { border-color: var(--dc-primary-300); }
  .sf-icon-display__preview i { width: 18px; height: 18px; color: var(--dc-primary); }
  .sf-icon-display__name {
    font-size: 12px;
    color: var(--dc-text-muted);
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dc-features-list { display:flex; flex-direction:column; gap:12px; }
  .dc-features-card {
    border: 1px solid var(--dc-border-soft);
    border-radius: var(--dc-radius-lg);
    background: var(--dc-surface);
    overflow: hidden;
    transition: border-color .15s;
  }
  .dc-features-card:hover { border-color: var(--dc-border); }
  .dc-features-card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--dc-gray-50);
    border-bottom: 1px solid var(--dc-border-soft);
  }
  .dc-features-card__head-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--dc-text-dark);
    white-space: nowrap;
  }
  .dc-features-card__sort {
    width: 70px;
    flex-shrink: 0;
  }
  .dc-features-card__sort .form-control { height: 32px; font-size: 13px; text-align: center; }
  .dc-features-card__body { padding: 14px; }
  .dc-features-card__body .nav-tabs { margin-bottom: 12px; }
  .dc-features-card__body .dcx-fields { gap: 10px; }
  .dc-features-card__remove { flex-shrink: 0; margin-left: auto; }

  .sf-widget-list { display: flex; flex-direction: column; gap: 4px; }
  .sf-widget-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border: 1px solid var(--dc-border-soft);
    border-radius: var(--dc-radius-md);
    background: var(--dc-surface);
    transition: all .15s;
  }
  .sf-widget-item:hover { border-color: var(--dc-border); background: var(--dc-gray-50); }
  .sf-widget-item.active {
    border-color: var(--dc-primary);
    background: var(--dc-primary-50);
  }
  .sf-widget-item__link {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    text-decoration: none;
    color: var(--dc-text);
  }
  .sf-widget-item.active .sf-widget-item__link { color: var(--dc-primary); font-weight: 600; }
  .sf-widget-item__icon {
    width: 28px;
    height: 28px;
    border-radius: var(--dc-radius-md);
    background: var(--dc-gray-100);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--dc-text-muted);
  }
  .sf-widget-item.active .sf-widget-item__icon { background: var(--dc-primary-100); color: var(--dc-primary); }
  .sf-widget-item__name { font-size: 13px; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sf-widget-item__delete {
    flex-shrink: 0;
    opacity: 0;
    transition: opacity .15s;
    padding: 2px 6px;
  }
  .sf-widget-item:hover .sf-widget-item__delete { opacity: 1; }
  .sf-widget-empty { padding: 20px; color: var(--dc-text-muted); font-size: 13px; text-align: center; }
  </style>

  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if status is defined %}
              <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
        </div>
        <div class="col-lg-4 col-xl-3">
          <div class="pull-right">
            <button type="submit" form="form-module" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="row">
      <div class="col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      </div>
    </div>
    {% endif %}

    {% if success %}
    <div class="row">
      <div class="col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      </div>
    </div>
    {% endif %}

    <form action="{{ action }}" method="post" id="form-module">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_widget_settings }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control">
                    <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>

                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_name }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="name_translation[{{ language.language_id }}]" value="{{ name_translation[language.language_id] }}" placeholder="{{ entry_name }}" class="form-control" />
                  </div>
                  {% endfor %}
                  {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
                </div>

                <div class="dcx-field">
                  <ul class="nav nav-tabs" role="tablist">
                    {% for language in languages %}
                    <li{% if loop.first %} class="active"{% endif %}><a href="#section-lang-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                    {% endfor %}
                  </ul>
                  <div class="tab-content">
                    {% for language in languages %}
                    <div class="tab-pane{% if loop.first %} active{% endif %}" id="section-lang-{{ language.language_id }}">
                      <div class="dcx-fields">
                        <div class="dcx-field">
                          <label class="dcx-label">{{ entry_section_title }}</label>
                          <input type="text" name="section_title[{{ language.language_id }}]" value="{{ section_title[language.language_id]|default('') }}" placeholder="{{ entry_section_title }}" class="form-control" />
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label">{{ entry_section_subtitle }}</label>
                          <textarea name="section_subtitle[{{ language.language_id }}]" rows="2" placeholder="{{ entry_section_subtitle }}" class="form-control">{{ section_subtitle[language.language_id]|default('') }}</textarea>
                        </div>
                      </div>
                    </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="dcx-shell" style="margin-top: 12px;">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="layout-list" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_features }}</div>
              </div>
              <div class="pull-right">
                <button type="button" id="button-add-feature" class="btn btn-primary btn-sm"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_feature }}</button>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dc-features-list" id="features-list">
                {% set feature_row = 0 %}
                {% for feature in features %}
                <div class="dc-features-card" id="feature-row-{{ feature_row }}">
                  <div class="dc-features-card__head">
                    <input type="hidden" name="features[{{ feature_row }}][icon]" id="feature-icon-{{ feature_row }}" value="{{ feature.icon|default('truck') }}" />
                    <div class="sf-icon-display">
                      <div class="sf-icon-display__preview dc-icon-picker-button" data-target="#feature-icon-{{ feature_row }}" title="{{ feature.icon|default('truck') }}">
                        <i data-lucide="{{ feature.icon|default('truck') }}"></i>
                      </div>
                      <span class="sf-icon-display__name dc-icon-label">{{ feature.icon|default('truck') }}</span>
                    </div>
                    <span class="dc-features-card__head-label">{{ entry_sort_order }}</span>
                    <div class="dc-features-card__sort">
                      <input type="number" name="features[{{ feature_row }}][sort_order]" value="{{ feature.sort_order|default(0) }}" class="form-control" />
                    </div>
                    <button type="button" onclick="$('#feature-row-{{ feature_row }}').remove();" class="btn btn-danger btn--icon dc-features-card__remove" title="{{ button_remove }}"><i data-lucide="trash-2" width="14" height="14"></i></button>
                  </div>
                  <div class="dc-features-card__body">
                    <ul class="nav nav-tabs" role="tablist">
                      {% for language in languages %}
                      <li{% if loop.first %} class="active"{% endif %}><a href="#feature-{{ feature_row }}-lang-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content">
                      {% for language in languages %}
                      <div class="tab-pane{% if loop.first %} active{% endif %}" id="feature-{{ feature_row }}-lang-{{ language.language_id }}">
                        <div class="dcx-fields">
                          <div class="dcx-field">
                            <label class="dcx-label">{{ entry_title }}</label>
                            <input type="text" name="features[{{ feature_row }}][title][{{ language.language_id }}]" value="{{ feature.title[language.language_id]|default('') }}" class="form-control" />
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label">{{ entry_text }}</label>
                            <textarea name="features[{{ feature_row }}][text][{{ language.language_id }}]" rows="3" class="form-control">{{ feature.text[language.language_id]|default('') }}</textarea>
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
                {% set feature_row = feature_row + 1 %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-shell">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="layout-list" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_widgets }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              {% if widgets %}
                <div class="sf-widget-list">
                  {% for widget in widgets %}
                  <div class="sf-widget-item{% if widget.active %} active{% endif %}">
                    <a href="{{ widget.href }}" class="sf-widget-item__link">
                      <div class="sf-widget-item__icon"><i data-lucide="{% if widget.active %}check-circle{% else %}circle{% endif %}" width="14" height="14"></i></div>
                      <span class="sf-widget-item__name">{{ widget.name }}</span>
                    </a>
                    {% if widget.delete %}
                    <button type="button" class="sf-widget-item__delete btn btn-danger btn-xs" onclick="if(confirm('{{ button_delete_confirm|default("Delete this widget?") }}')) location='{{ widget.delete }}';" title="{{ button_remove }}"><i data-lucide="trash-2" width="12" height="12"></i></button>
                    {% endif %}
                  </div>
                  {% endfor %}
                </div>
              {% else %}
                <div class="sf-widget-empty">{{ text_no_widgets }}</div>
              {% endif %}
              <div class="dcx-sidebar-card__field" style="margin-top:12px;">
                <a href="{{ new_widget }}" class="btn btn-default btn-sm btn-block"><i data-lucide="plus" width="14" height="14"></i> {{ text_create_widget }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>

<!-- Icon picker modal -->
<div id="dc-icon-picker-modal" class="dc-icon-picker-modal hidden">
  <div class="dc-icon-picker-backdrop"></div>
  <div class="dc-icon-picker-panel" role="dialog" aria-modal="true">
    <div class="dc-icon-picker-header">
      <div style="display:flex;align-items:center;gap:8px;">
        <strong>{{ entry_icon }}</strong>
        <input id="dc-icon-picker-search" class="form-control dc-icon-picker-search" placeholder="{{ entry_search_icons|default('Search icons...') }}" />
      </div>
      <div>
        <button id="dc-icon-picker-close" class="btn btn-default">{{ button_close|default('Close') }}</button>
      </div>
    </div>
    <div id="dc-icon-picker-grid" class="dc-icon-picker-grid">
      {% for icon_option in icon_options %}
      <button type="button" class="dc-icon-option" data-icon="{{ icon_option }}">
        <i data-lucide="{{ icon_option }}"></i>
      </button>
      {% endfor %}
    </div>
  </div>
</div>

<script type="text/javascript">
var feature_row = {{ feature_row }};

function renderLucideIcons() {
  if (window.lucide && typeof window.lucide.createIcons === 'function') {
    window.lucide.createIcons();
  }
}

var __dc_icon_picker_target = null;
var __dc_icon_picker_preview = null;
var __dc_icon_picker_label = null;

$(document).on('click', '.dc-icon-picker-button', function(e) {
  e.preventDefault();
  var $btn = $(this);
  var target = $btn.data('target');
  __dc_icon_picker_target = $(target);
  __dc_icon_picker_preview = $btn.find('i[data-lucide]');
  __dc_icon_picker_label = $btn.closest('.sf-icon-display').find('.dc-icon-label');
  $('#dc-icon-picker-modal').removeClass('hidden').show();
  $('#dc-icon-picker-search').val('');
  $('#dc-icon-picker-grid button').show();
});

$(document).on('click', '#dc-icon-picker-close, #dc-icon-picker-modal .dc-icon-picker-backdrop', function() {
  $('#dc-icon-picker-modal').hide().addClass('hidden');
});

$(document).on('click', '#dc-icon-picker-grid button.dc-icon-option', function(e) {
  var icon = $(this).data('icon');
  if (__dc_icon_picker_target && __dc_icon_picker_target.length) {
    __dc_icon_picker_target.val(icon);
  }
  if (__dc_icon_picker_preview && __dc_icon_picker_preview.length) {
    __dc_icon_picker_preview.attr('data-lucide', icon);
  }
  if (__dc_icon_picker_label && __dc_icon_picker_label.length) {
    __dc_icon_picker_label.text(icon);
  }
  if (__dc_icon_picker_target && __dc_icon_picker_target.attr('id')) {
    var wrapper = $('[data-target="#' + __dc_icon_picker_target.attr('id') + '"]');
    if (wrapper.length) {
      wrapper.attr('title', icon);
      wrapper.find('i[data-lucide]').attr('data-lucide', icon);
    }
  }
  renderLucideIcons();
  $('#dc-icon-picker-modal').hide().addClass('hidden');
});

$(document).on('input', '#dc-icon-picker-search', function() {
  var q = $(this).val().toLowerCase().trim();
  if (q === '') {
    $('#dc-icon-picker-grid button').show();
    return;
  }
  $('#dc-icon-picker-grid button').each(function() {
    var name = $(this).data('icon') || '';
    if (name.indexOf(q) !== -1) $(this).show(); else $(this).hide();
  });
});

$('#button-add-feature').on('click', function() {
  var html = '';
  html += '<div class="dc-features-card" id="feature-row-' + feature_row + '">';
  html += '  <div class="dc-features-card__head">';
  html += '    <input type="hidden" name="features[' + feature_row + '][icon]" id="feature-icon-' + feature_row + '" value="truck" />';
  html += '    <div class="sf-icon-display">';
  html += '      <div class="sf-icon-display__preview dc-icon-picker-button" data-target="#feature-icon-' + feature_row + '" title="truck">';
  html += '        <i data-lucide="truck"></i>';
  html += '      </div>';
  html += '      <span class="sf-icon-display__name dc-icon-label">truck</span>';
  html += '    </div>';
  html += '    <span class="dc-features-card__head-label">{{ entry_sort_order }}</span>';
  html += '    <div class="dc-features-card__sort">';
  html += '      <input type="number" name="features[' + feature_row + '][sort_order]" value="' + feature_row + '" class="form-control" />';
  html += '    </div>';
  html += '    <button type="button" onclick="$(\'#feature-row-' + feature_row + '\').remove();" class="btn btn-danger btn--icon dc-features-card__remove" title="{{ button_remove }}"><i data-lucide="trash-2" width="14" height="14"></i></button>';
  html += '  </div>';
  html += '  <div class="dc-features-card__body">';
  html += '    <ul class="nav nav-tabs" role="tablist">';
  {% for language in languages %}
  html += '      <li{% if loop.first %} class="active"{% endif %}><a href="#feature-' + feature_row + '-lang-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>';
  {% endfor %}
  html += '    </ul>';
  html += '    <div class="tab-content">';
  {% for language in languages %}
  html += '      <div class="tab-pane{% if loop.first %} active{% endif %}" id="feature-' + feature_row + '-lang-{{ language.language_id }}">';
  html += '        <div class="dcx-fields">';
  html += '          <div class="dcx-field">';
  html += '            <label class="dcx-label">{{ entry_title }}</label>';
  html += '            <input type="text" name="features[' + feature_row + '][title][{{ language.language_id }}]" value="" class="form-control" />';
  html += '          </div>';
  html += '          <div class="dcx-field">';
  html += '            <label class="dcx-label">{{ entry_text }}</label>';
  html += '            <textarea name="features[' + feature_row + '][text][{{ language.language_id }}]" rows="3" class="form-control"></textarea>';
  html += '          </div>';
  html += '        </div>';
  html += '      </div>';
  {% endfor %}
  html += '    </div>';
  html += '  </div>';
  html += '</div>';

  $('#features-list').append(html);
  renderLucideIcons();
  feature_row++;
});

$(function() {
  renderLucideIcons();
});
</script>

{{ footer }}
