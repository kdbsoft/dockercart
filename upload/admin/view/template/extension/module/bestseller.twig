{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_edit }}</div>
                <div class="dcx-panel-subtitle">{{ text_edit_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module">
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label">{{ entry_name }}</label>
                    <ul class="nav nav-tabs" style="margin-bottom:10px;">
                      {% for language in languages %}
                      <li{% if loop.first %} class="active"{% endif %}><a href="#name-lang-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content">
                      {% for language in languages %}
                      <div class="tab-pane{% if loop.first %} active{% endif %}" id="name-lang-{{ language.language_id }}">
                        <input type="text" name="name_translation[{{ language.language_id }}]" value="{{ name_translation[language.language_id] }}" placeholder="{{ entry_name }}" class="form-control" />
                      </div>
                      {% endfor %}
                    </div>
                    {% if error_name %}
                    <div class="text-danger">{{ error_name }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-product"><span data-toggle="tooltip" title="{{ help_product }}">{{ entry_product }}</span></label>
                    <input type="text" name="product_name" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                    <div id="bestseller-product" class="well well-sm" style="height: 150px; overflow: auto;">
                      {% for product in products %}
                      <div id="bestseller-product{{ product.product_id }}"><i data-lucide="minus-circle" width="14" height="14"></i> {{ product.name }}
                        <input type="hidden" name="product[]" value="{{ product.product_id }}" />
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-category-filter"><span data-toggle="tooltip" title="{{ help_category_filter }}">{{ entry_category_filter }}</span></label>
                    <select name="category_filter" id="input-category-filter" class="form-control">
                      {% if category_filter %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-limit">{{ entry_limit }}</label>
                    <input type="text" name="limit" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-width">{{ entry_width }}</label>
                    <input type="text" name="width" value="{{ width }}" placeholder="{{ entry_width }}" id="input-width" class="form-control" />
                    {% if error_width %}
                    <div class="text-danger">{{ error_width }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-height">{{ entry_height }}</label>
                    <input type="text" name="height" value="{{ height }}" placeholder="{{ entry_height }}" id="input-height" class="form-control" />
                    {% if error_height %}
                    <div class="text-danger">{{ error_height }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="status" id="input-status" class="form-control">
                      {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('input[name=\'product_name\']').autocomplete({
	source: function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	select: function(item) {
		$('input[name=\'product_name\']').val('');
		
		$('#bestseller-product' + item['value']).remove();
		
		$('#bestseller-product').append('<div id="bestseller-product' + item['value'] + '"><i data-lucide="minus-circle" width="14" height="14"></i> ' + item['label'] + '<input type="hidden" name="product[]" value="' + item['value'] + '" /></div>');
		lucide.createIcons();
	}
});
	
$('#bestseller-product').delegate('i[data-lucide="minus-circle"]', 'click', function() {
	$(this).parent().remove();
});
//--></script></div>
{{ footer }}
