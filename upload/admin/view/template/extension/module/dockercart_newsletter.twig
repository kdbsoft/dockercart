{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">

      <div class="row">
        <div class="col-lg-8 col-xl-offset-1 col-xl-7">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if status is defined %}
              <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
        </div>
        <div class="col-lg-4 col-xl-3">
          <div class="pull-right">
            <button type="submit" form="form-module" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if warning %}
      <div class="row">
        <div class="col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="alert alert-warning alert-dismissible"><i data-lucide="triangle-alert" width="16" height="16"></i> {{ warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>

    <form action="{{ action }}" method="post" id="form-module">
    <div class="row">
      <div class="col-md-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
              <div><div class="dcx-panel-title">{{ text_module_settings }}</div></div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_name }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="name_translation[{{ language.language_id }}]" value="{{ name_translation[language.language_id] }}" placeholder="{{ entry_name }}" class="form-control" />
                  </div>
                  {% endfor %}
                  {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control">
                    <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
          <div class="dcx-panel form-row--spaced">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="languages" width="18" height="18"></i></div>
              <div><div class="dcx-panel-title">{{ text_multilingual_settings }}</div></div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-title-{{ language.language_id }}">{{ entry_title }}</label>
                      <input type="text" name="module_settings[{{ language.language_id }}][title]" value="{{ module_settings[language.language_id].title }}" placeholder="{{ entry_title }}" id="input-title-{{ language.language_id }}" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-subtitle-{{ language.language_id }}">{{ entry_subtitle }}</label>
                      <textarea name="module_settings[{{ language.language_id }}][subtitle]" rows="2" placeholder="{{ entry_subtitle }}" id="input-subtitle-{{ language.language_id }}" class="form-control">{{ module_settings[language.language_id].subtitle }}</textarea>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-placeholder-{{ language.language_id }}">{{ entry_placeholder }}</label>
                      <input type="text" name="module_settings[{{ language.language_id }}][placeholder]" value="{{ module_settings[language.language_id].placeholder }}" placeholder="{{ entry_placeholder }}" id="input-placeholder-{{ language.language_id }}" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-button-text-{{ language.language_id }}">{{ entry_button_text }}</label>
                      <input type="text" name="module_settings[{{ language.language_id }}][button_text]" value="{{ module_settings[language.language_id].button_text }}" placeholder="{{ entry_button_text }}" id="input-button-text-{{ language.language_id }}" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-privacy-text-{{ language.language_id }}">{{ entry_privacy_text }}</label>
                      <textarea name="module_settings[{{ language.language_id }}][privacy_text]" rows="2" placeholder="{{ entry_privacy_text }}" id="input-privacy-text-{{ language.language_id }}" class="form-control">{{ module_settings[language.language_id].privacy_text }}</textarea>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-success-text-{{ language.language_id }}">{{ entry_success_text }}</label>
                      <input type="text" name="module_settings[{{ language.language_id }}][success_text]" value="{{ module_settings[language.language_id].success_text }}" placeholder="{{ entry_success_text }}" id="input-success-text-{{ language.language_id }}" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-already-text-{{ language.language_id }}">{{ entry_already_text }}</label>
                      <input type="text" name="module_settings[{{ language.language_id }}][already_text]" value="{{ module_settings[language.language_id].already_text }}" placeholder="{{ entry_already_text }}" id="input-already-text-{{ language.language_id }}" class="form-control" />
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-shell">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="users" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_subscribers }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label">{{ text_stats_total }}</label>
                <div style="font-size:20px;font-weight:600;color:var(--dc-text-dark);">{{ stats_total }}</div>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label">{{ text_stats_guest }}</label>
                <div style="font-size:20px;font-weight:600;color:var(--dc-text-dark);">{{ stats_guest }}</div>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label">{{ text_stats_customer }}</label>
                <div style="font-size:20px;font-weight:600;color:var(--dc-text-dark);">{{ stats_customer }}</div>
              </div>
              <div class="dcx-sidebar-card__field" style="margin-top:12px;">
                <button type="button" class="btn btn-default btn-sm btn-block" onclick="location='{{ export }}';"><i data-lucide="download" width="14" height="14"></i> {{ button_export }}</button>
                <button type="button" class="btn btn-default btn-sm btn-block" style="margin-top:8px;" onclick="$('#import-modal').modal('show');"><i data-lucide="upload" width="14" height="14"></i> {{ button_import }}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>

    <div class="row">
      <div class="col-md-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell form-row--spaced">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="users" width="18" height="18"></i></div>
              <div><div class="dcx-panel-title">{{ text_subscribers }}</div></div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ filter_action }}" method="get" style="margin-bottom:15px;display:flex;gap:8px;flex-wrap:wrap;">
                <input type="hidden" name="route" value="extension/module/dockercart_newsletter" />
                <input type="hidden" name="user_token" value="{{ user_token }}" />
                <div class="dcx-field" style="flex:1;min-width:200px;">
                  <input type="text" id="input-filter-email" name="filter_email" value="{{ filter_email }}" placeholder="{{ entry_filter_email }}" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary"><i data-lucide="search" width="14" height="14"></i> {{ button_filter }}</button>
                <a href="{{ filter_action }}" class="btn btn-default">{{ button_clear }}</a>
              </form>

              {% if subscribers %}
              <div class="dc-newsletter-list">
                {% for subscriber in subscribers %}
                <div class="dc-newsletter-item">
                  <div class="dc-newsletter-item__icon">
                    {% if subscriber.subscriber_type == 'customer' %}
                    <i data-lucide="user" width="16" height="16"></i>
                    {% else %}
                    <i data-lucide="user-plus" width="16" height="16"></i>
                    {% endif %}
                  </div>
                  <div class="dc-newsletter-item__body">
                    <div class="dc-newsletter-item__email">{{ subscriber.email }}</div>
                    <div class="dc-newsletter-item__meta">
                      {% if subscriber.subscriber_type == 'customer' %}
                      <span class="label label-info">{{ text_registered_customer }}</span>
                      {% else %}
                      <span class="label label-default">{{ text_guest_subscriber }}</span>
                      {% endif %}
                      <span class="dc-newsletter-item__source">{{ subscriber.source }}</span>
                      <span class="dc-newsletter-item__date">{{ subscriber.date_added }}</span>
                    </div>
                  </div>
                  <div class="dc-newsletter-item__actions">
                    {% if subscriber.status %}
                    <span class="label label-success">{{ text_enabled }}</span>
                    {% else %}
                    <span class="label label-danger">{{ text_disabled }}</span>
                    {% endif %}
                    <a href="{{ subscriber.delete }}" class="btn btn-danger btn-xs" onclick="return confirm('{{ button_delete }}?');" title="{{ button_delete }}"><i data-lucide="trash-2" width="12" height="12"></i></a>
                  </div>
                </div>
                {% endfor %}
              </div>
              {% else %}
              <div class="dc-newsletter-empty">
                <i data-lucide="inbox" width="32" height="32"></i>
                <p>{{ text_no_results }}</p>
              </div>
              {% endif %}

              <div class="pagination-wrap">
                <div class="row">
                  <div class="col-sm-6 text-left">{{ pagination }}</div>
                  <div class="col-sm-6 text-right">{{ results }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
<div id="import-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title"><i data-lucide="upload" width="18" height="18" style="margin-right:8px;"></i>{{ heading_import }}</h4>
      </div>
      <div class="modal-body">
        <form id="form-import" enctype="multipart/form-data">
          <div class="dcx-fields">
            <div class="dcx-field">
              <label class="dcx-label">{{ text_select_file }}</label>
              <input type="file" name="file" class="form-control" accept=".csv" />
            </div>
          </div>
          <div class="alert alert-info" style="margin-top:12px;">
            <i data-lucide="info" width="16" height="16" style="vertical-align:middle;margin-right:4px;"></i> {{ text_import_format }}
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
        <button type="button" class="btn btn-primary" id="button-import"><i data-lucide="upload" width="14" height="14"></i> {{ button_import }}</button>
      </div>
    </div>
  </div>
</div>
<style>
.dc-newsletter-list { display: flex; flex-direction: column; gap: 8px; }
.dc-newsletter-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--dc-border-soft);
  border-radius: var(--dc-radius-lg);
  background: var(--dc-surface);
  transition: border-color .15s;
}
.dc-newsletter-item:hover { border-color: var(--dc-border); }
.dc-newsletter-item__icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: var(--dc-radius-md);
  background: var(--dc-gray-100);
  color: var(--dc-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-newsletter-item__body { flex: 1; min-width: 0; }
.dc-newsletter-item__email { font-size: 13px; font-weight: 600; color: var(--dc-text-dark); }
.dc-newsletter-item__meta { display: flex; align-items: center; gap: 8px; margin-top: 4px; font-size: 12px; color: var(--dc-text-muted); flex-wrap: wrap; }
.dc-newsletter-item__source { }
.dc-newsletter-item__date { }
.dc-newsletter-item__actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.dc-newsletter-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 32px 16px;
  color: var(--dc-text-muted);
  text-align: center;
}
.dc-newsletter-empty p { margin: 0; font-size: 13px; }
</style>
<script type="text/javascript"><!--
$('#language a:first').tab('show');
$('#button-import').on('click', function() {
  var formData = new FormData($('#form-import')[0]);
  $.ajax({
    url: '{{ import }}',
    type: 'post',
    data: formData,
    dataType: 'json',
    cache: false,
    contentType: false,
    processData: false,
    beforeSend: function() {
      $('#button-import').prop('disabled', true);
    },
    complete: function() {
      $('#button-import').prop('disabled', false);
    },
    success: function(json) {
      $('.alert-dismissible').remove();
      if (json.error) {
        $('#content > .container-fluid').first().prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json.error + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        lucide.createIcons();
      }
      if (json.success) {
        $('#content > .container-fluid').first().prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json.success + '</div>');
        lucide.createIcons();
        $('#import-modal').modal('hide');
        setTimeout(function() { location.reload(); }, 900);
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
});
//--></script>
{{ footer }}