{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">

      <div class="row">
        <div class="col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if author %}
                {{ text_edit }}: {{ author }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
        <div class="col-lg-4 col-xl-3">
          <div class="pull-right">
            <button type="submit" form="form-comment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
        </div>
      </div>
      </div>
        </div>

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-comment">
    <div class="row">
      <div class="col-md-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="message-square" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-author">{{ entry_author }}</label>
                  <input type="text" name="author" value="{{ author }}" placeholder="{{ entry_author }}" id="input-author" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-email">{{ entry_email }}</label>
                  <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-text">{{ entry_text }}</label>
                  <textarea name="text" rows="5" placeholder="{{ entry_text }}" id="input-text" class="form-control">{{ text }}</textarea>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-rating">{{ entry_rating }}</label>
                  <select name="rating" id="input-rating" class="form-control">
                    <option value="1" {% if rating == 1 %}selected="selected"{% endif %}>1</option>
                    <option value="2" {% if rating == 2 %}selected="selected"{% endif %}>2</option>
                    <option value="3" {% if rating == 3 %}selected="selected"{% endif %}>3</option>
                    <option value="4" {% if rating == 4 %}selected="selected"{% endif %}>4</option>
                    <option value="5" {% if rating == 5 %}selected="selected"{% endif %}>5</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('[data-toggle="tooltip"]').tooltip();
//--></script>
</div>
{{ footer }}