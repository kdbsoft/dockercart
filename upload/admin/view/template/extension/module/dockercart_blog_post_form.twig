{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">

      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if post_name %}
                {{ post_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-post" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-post">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_description }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-title{{ language.language_id }}">{{ entry_title }}</label>
                      <input type="text" name="post_description[{{ language.language_id }}][title]" value="{{ (post_description[language.language_id] ? post_description[language.language_id].title)|e('html_attr') }}" placeholder="{{ entry_title }}" id="input-title{{ language.language_id }}" class="form-control" />
                      {% if error_title[language.language_id] %}
                      <div class="text-danger">{{ error_title[language.language_id] }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-excerpt{{ language.language_id }}">{{ entry_excerpt }}</label>
                      <textarea name="post_description[{{ language.language_id }}][excerpt]" rows="3" placeholder="{{ entry_excerpt }}" id="input-excerpt{{ language.language_id }}" class="form-control">{{ post_description[language.language_id] ? post_description[language.language_id].excerpt }}</textarea>
                    </div>
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-content{{ language.language_id }}">{{ entry_content }}</label>
                      <textarea name="post_description[{{ language.language_id }}][content]" placeholder="{{ entry_content }}" id="input-content{{ language.language_id }}" data-toggle="tinymce" class="form-control">{{ post_description[language.language_id] ? post_description[language.language_id].content }}</textarea>
                      {% if error_content[language.language_id] %}
                      <div class="text-danger">{{ error_content[language.language_id] }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                      <input type="text" name="post_description[{{ language.language_id }}][meta_title]" value="{{ (post_description[language.language_id] ? post_description[language.language_id].meta_title)|e('html_attr') }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control" />
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                      <textarea name="post_description[{{ language.language_id }}][meta_description]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ post_description[language.language_id] ? post_description[language.language_id].meta_description }}</textarea>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                      <textarea name="post_description[{{ language.language_id }}][meta_keyword]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ post_description[language.language_id] ? post_description[language.language_id].meta_keyword }}</textarea>
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-tag{{ language.language_id }}">{{ entry_tags }}</label>
                      <div class="dc-tag-input">
                        <input type="text" id="input-tag{{ language.language_id }}" class="form-control dc-tag-input__field" placeholder="{{ entry_tags }}" />
                        <div class="dc-tag-input__tags" id="tag-chips{{ language.language_id }}"></div>
                        <input type="hidden" name="post_description[{{ language.language_id }}][tags]" value="{{ post_description[language.language_id] ? post_description[language.language_id].tags }}" />
                        <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_tags }}"><i data-lucide="circle-question-mark" width="16" height="16" class="text-muted"></i></span>
                      </div>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="image" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_media_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_image }}</label>
                  <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="image" value="{{ image }}" id="input-image" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_background_image }}</label>
                  <a href="" id="thumb-background" data-toggle="image" class="img-thumbnail"><img src="{{ background_thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="background_image" value="{{ background_image }}" id="input-background" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <div class="dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="featured" value="1" {% if featured %}checked="checked"{% endif %} id="input-featured" /> {{ entry_featured }}
                </label>
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="allow_comments" value="1" {% if allow_comments %}checked="checked"{% endif %} id="input-allow-comments" /> {{ entry_allow_comments }}
                </label>
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
              <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-date-published">{{ entry_date_published }}</label>
              <div class="input-group datetime">
                <input type="text" name="date_published" value="{{ date_published }}" placeholder="{{ entry_date_published }}" data-date-format="YYYY-MM-DD HH:mm:ss" id="input-date-published" class="form-control" />
                <span class="input-group-btn">
                  <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                </span>
              </div>
              <span class="help-block">{{ help_date_published }}</span>
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="folder-tree" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_organization_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_category }}</label>
              <div class="dcx-tree-select"
                   data-url="index.php?route=extension/module/dockercart_blog_category/tree&user_token={{ user_token }}"
                   data-none-text="{{ text_none }}"
                   data-placeholder="{{ text_quick_find }}">
                <div class="dcx-tree-select__input-wrap">
                  <input type="text" name="category_path" value="{{ category_path }}" placeholder="{{ entry_category }}" class="dcx-tree-select__input form-control" autocomplete="off" />
                  <input type="hidden" name="category_id" value="{{ category_id }}" />
                  <span class="dcx-tree-select__toggle"><i data-lucide="chevron-down" width="16" height="16"></i></span>
                </div>
                <div class="dcx-tree-select__dropdown">
                  <div class="dcx-tree-select__search">
                    <input type="text" class="form-control" placeholder="{{ text_quick_find }}" />
                    <i data-lucide="search" width="14" height="14"></i>
                  </div>
                  <div class="dcx-tree-select__list">
                    <div class="dcx-tree-select__item dcx-tree-select__item--none" data-id="0" data-name="{{ text_none }}">
                      <span class="dcx-tree-select__label">{{ text_none }}</span>
                    </div>
                  </div>
                </div>
              </div>
              {% if error_category %}
              <div class="text-danger">{{ error_category }}</div>
              {% endif %}
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-author">{{ entry_author }}</label>
              <select name="author_id" id="input-author" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for author in authors %}
                {% if author.author_id == author_id %}
                <option value="{{ author.author_id }}" selected="selected">{{ author.name }}</option>
                {% else %}
                <option value="{{ author.author_id }}">{{ author.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
              {% if error_author %}
              <div class="text-danger">{{ error_author }}</div>
              {% endif %}
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_store }}</label>
              <div class="dcx-sidebar-card__stores">
                {% for store in stores %}
                <label class="dcx-sidebar-card__store-item">
                  <input type="checkbox" name="post_store[]" value="{{ store.store_id }}" {% if store.store_id in post_store %}checked="checked"{% endif %} />
                  <span>{{ store.name }}</span>
                </label>
                {% endfor %}
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-product">{{ entry_related_product }}
                <span data-toggle="tooltip" title="{{ help_related_product }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
              </label>
              <input type="text" name="product" value="" placeholder="{{ entry_related_product }}" id="input-product" class="form-control" />
              <div id="product-related" class="dcx-picker__well" style="height: 150px; overflow: auto; margin-top: 6px;">
                {% for product_recommendation in product_recommendations %}
                <div class="dcx-picker__well-item" data-id="{{ product_recommendation.product_id }}">
                  <i data-lucide="circle-minus" width="14" height="14" class="dcx-picker__well-remove"></i>
                  <span class="dcx-picker__well-label">{{ product_recommendation.name }}</span>
                  <input type="hidden" name="post_product[]" value="{{ product_recommendation.product_id }}" />
                </div>
                {% endfor %}
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_related_category }}
                <span data-toggle="tooltip" title="{{ help_related_category }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
              </label>
              <button type="button" class="btn btn-default btn-sm btn-block" id="btn-open-related-category-modal" style="text-align:left;">
                <i data-lucide="folder-tree" width="14" height="14" style="margin-right:6px;"></i>
                <span id="related-category-modal-count">{% if product_category_recommendations|length > 0 %}{{ product_category_recommendations|length }} {{ button_select_category }}{% else %}{{ button_select_category }}{% endif %}</span>
              </button>
              <div id="post-product-category" class="dcx-tree-select__well" style="height: 150px; overflow: auto; margin-top: 6px;">
                {% for product_category_recommendation in product_category_recommendations %}
                <div class="dcx-tree-select__well-item" data-id="{{ product_category_recommendation.category_id }}">
                  <i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i>
                  <span class="dcx-tree-select__well-label">{{ product_category_recommendation.name }}</span>
                  <input type="hidden" name="post_product_category[]" value="{{ product_category_recommendation.category_id }}" />
                </div>
                {% endfor %}
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-manufacturer">{{ entry_related_manufacturer }}
                <span data-toggle="tooltip" title="{{ help_related_manufacturer }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
              </label>
              <input type="text" name="manufacturer" value="" placeholder="{{ entry_related_manufacturer }}" id="input-manufacturer" class="form-control" />
              <div id="manufacturer-related" class="dcx-picker__well" style="height: 150px; overflow: auto; margin-top: 6px;">
                {% for manufacturer_recommendation in manufacturer_recommendations %}
                <div class="dcx-picker__well-item" data-id="{{ manufacturer_recommendation.manufacturer_id }}">
                  <i data-lucide="circle-minus" width="14" height="14" class="dcx-picker__well-remove"></i>
                  <span class="dcx-picker__well-label">{{ manufacturer_recommendation.name }}</span>
                  <input type="hidden" name="post_manufacturer[]" value="{{ manufacturer_recommendation.manufacturer_id }}" />
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="link" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_seo_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__help"><i data-lucide="info" width="16" height="16"></i> {{ text_keyword }}</div>
            <div class="dcx-sidebar-card__links">
              {% for store in stores %}
                {% if stores|length > 1 %}
                <div class="dcx-sidebar-card__store-label">{{ store.name }}</div>
                {% endif %}
                {% for language in languages %}
                <div class="dcx-sidebar-card__link-item">
                  <label class="dcx-sidebar-card__link-label">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    {{ language.name }}
                  </label>
                  <input type="text" name="post_seo_url[{{ store.store_id }}][{{ language.language_id }}]" value="{% if post_seo_url[store.store_id][language.language_id] %}{{ post_seo_url[store.store_id][language.language_id] }}{% endif %}" placeholder="{{ entry_keyword }}" class="form-control" />
                </div>
                {% endfor %}
              {% endfor %}
            </div>
            <div class="dcx-seo-preview">
              <span class="dcx-seo-preview__label">{{ text_seo_preview }}</span>
              <span class="dcx-seo-preview__url">yoursite.com/blog/</span><span id="seo-url-preview">...</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <div id="related-category-tree-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title"><i data-lucide="folder-tree" width="18" height="18" style="margin-right:8px;"></i>{{ text_select_category }}</h4>
        </div>
        <div class="modal-body">
          <div id="related-category-tree" class="dcx-tree-select"
               data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}"
               data-mode="multi"
               data-none-text="{{ text_none }}"
               data-placeholder="{{ text_quick_find }}">
            <div class="dcx-tree-select__search">
              <input type="text" class="form-control" placeholder="{{ text_quick_find }}" id="related-category-tree-search" />
              <i data-lucide="search" width="14" height="14"></i>
            </div>
            <div class="dcx-tree-select__list" style="max-height:400px;overflow-y:auto;"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
          <button type="button" class="btn btn-primary" id="related-category-tree-confirm">
            <i data-lucide="check" width="14" height="14"></i> {{ button_continue }}
          </button>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript" src="view/javascript/tinymce/dc.js"></script>
  <script type="text/javascript"><!--
$('#language a:first').tab('show');
$('[data-toggle="tooltip"]').tooltip();

$('.datetime').datetimepicker({
	language: '{{ datepicker }}',
	pickDate: true,
	pickTime: true
});

// Hide empty wells
$('#product-related').toggle($('#product-related .dcx-picker__well-item').length > 0);
$('#post-product-category').toggle($('#post-product-category .dcx-tree-select__well-item').length > 0);
$('#manufacturer-related').toggle($('#manufacturer-related .dcx-picker__well-item').length > 0);

// Tag chip input
function dcTagSyncHidden($field) {
	var $wrap = $field.closest('.dc-tag-input');
	var tags = [];
	$wrap.find('.dc-tag-chip').each(function() {
		tags.push($(this).data('tag'));
	});
	$wrap.find('input[type="hidden"]').val(tags.join(','));
}

function escapeHtml(str) {
	return $('<span>').text(str).html();
}

function dcTagAddChip($field, value) {
	value = value.replace(/[,;]\s*$/, '').trim();
	if (!value) return false;
	var $wrap = $field.closest('.dc-tag-input');
	var $tags = $wrap.find('.dc-tag-input__tags');
	var exists = false;
	$tags.find('.dc-tag-chip').each(function() {
		if ($(this).data('tag').toLowerCase() === value.toLowerCase()) {
			exists = true;
			return false;
		}
	});
	if (exists) return false;
	var chip = '<span class="dc-tag-chip" data-tag="' + value.replace(/"/g, '&quot;') + '">' +
		escapeHtml(value) +
		' <button type="button" class="dc-tag-chip__remove"><i data-lucide="x" width="12" height="12"></i></button></span>';
	$tags.append(chip);
	lucide.createIcons({ nodes: [$tags[0]] });
	dcTagSyncHidden($field);
	return true;
}

{% for language in languages %}
(function() {
	var $input = $('#input-tag{{ language.language_id }}');
	var $wrap = $input.closest('.dc-tag-input');
	var val = $input.closest('.dc-tag-input').find('input[type="hidden"]').val();
	if (val) {
		var parts = val.split(',');
		for (var i = 0; i < parts.length; i++) {
			var t = parts[i].trim();
			if (t) dcTagAddChip($input, t);
		}
	}
	$input.on('keydown', function(e) {
		if (e.key === 'Enter' || e.key === ',') {
			e.preventDefault();
			if (dcTagAddChip($input, $input.val())) { $input.val(''); }
		}
		if (e.key === 'Backspace' && !$input.val()) {
			var $chips = $wrap.find('.dc-tag-chip');
			if ($chips.length) { $chips.last().remove(); dcTagSyncHidden($input); }
		}
	});
	$input.on('blur', function() {
		var v = $input.val();
		if (v.trim()) { if (dcTagAddChip($input, v)) { $input.val(''); } }
	});
	$wrap.on('click', '.dc-tag-chip__remove', function() {
		$(this).closest('.dc-tag-chip').remove();
		dcTagSyncHidden($input);
	});
})();
{% endfor %}

// Recommended autocomplete
$('input[name=\'product\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'product\']').val('');
		if ($('#product-related .dcx-picker__well-item[data-id="' + item['value'] + '"]').length) return;
		$('#product-related').append('<div class="dcx-picker__well-item" data-id="' + item['value'] + '"><i data-lucide="circle-minus" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">' + item['label'] + '</span><input type="hidden" name="post_product[]" value="' + item['value'] + '" /></div>');
		$('#product-related').toggle(true);
		lucide.createIcons();
	}
});

$('input[name=\'manufacturer\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/manufacturer/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['manufacturer_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'manufacturer\']').val('');
		if ($('#manufacturer-related .dcx-picker__well-item[data-id="' + item['value'] + '"]').length) return;
		$('#manufacturer-related').append('<div class="dcx-picker__well-item" data-id="' + item['value'] + '"><i data-lucide="circle-minus" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">' + item['label'] + '</span><input type="hidden" name="post_manufacturer[]" value="' + item['value'] + '" /></div>');
		$('#manufacturer-related').toggle(true);
		lucide.createIcons();
	}
});

$(document).on('click', '.dcx-picker__well-remove', function() {
	var $well = $(this).closest('.dcx-picker__well');
	$(this).closest('.dcx-picker__well-item').remove();
	$well.toggle($well.find('.dcx-picker__well-item').length > 0);
});

// Related category modal
var relatedCategoryTreeInstance = null;

$('#btn-open-related-category-modal').on('click', function() {
	var $tree = $('#related-category-tree');
	relatedCategoryTreeInstance = $tree.data('dcx-tree-select');
	if (!relatedCategoryTreeInstance) {
		DcxTreeSelect.init('#related-category-tree');
		relatedCategoryTreeInstance = $tree.data('dcx-tree-select');
	}

	var currentIds = [];
	$('#post-product-category .dcx-tree-select__well-item').each(function() {
		currentIds.push($(this).data('id'));
	});
	relatedCategoryTreeInstance.setSelected(currentIds);

	$('#related-category-tree-modal').modal('show');
});

$('#related-category-tree-confirm').on('click', function() {
	if (!relatedCategoryTreeInstance) {
		$('#related-category-tree-modal').modal('hide');
		return;
	}

	var ids = relatedCategoryTreeInstance.getSelectedIds();
	var $well = $('#post-product-category');
	$well.empty();

	var allItems = relatedCategoryTreeInstance.cache || [];
	for (var i = 0; i < ids.length; i++) {
		for (var j = 0; j < allItems.length; j++) {
			if (String(allItems[j].category_id) === String(ids[i])) {
				var name = allItems[j].path || allItems[j].name;
				$well.append('<div class="dcx-tree-select__well-item" data-id="' + ids[i] + '">'
					+ '<i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i> '
					+ '<span class="dcx-tree-select__well-label">' + name + '</span>'
					+ '<input type="hidden" name="post_product_category[]" value="' + ids[i] + '"/></div>');
				break;
			}
		}
	}

	$('#related-category-modal-count').text(ids.length > 0 ? ids.length + ' {{ entry_category }}' : '{{ button_select_category }}');
	$well.toggle(ids.length > 0);
	lucide.createIcons();
	relatedCategoryTreeInstance.close();
	$('#related-category-tree-modal').modal('hide');
});

$(document).on('click', '#post-product-category .dcx-tree-select__well-remove', function() {
	$(this).closest('.dcx-tree-select__well-item').remove();
	var count = $('#post-product-category .dcx-tree-select__well-item').length;
	$('#related-category-modal-count').text(count > 0 ? count + ' {{ entry_category }}' : '{{ button_select_category }}');
	$('#post-product-category').toggle(count > 0);
});

$('input[name^="post_seo_url"]').on('input', function() {
	var firstVal = $('input[name^="post_seo_url"]:first').val();
	if (firstVal) {
		$('#seo-url-preview').text(firstVal);
	} else {
		$('#seo-url-preview').text('...');
	}
});
//--></script>
