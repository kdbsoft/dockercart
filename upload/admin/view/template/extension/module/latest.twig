{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if status is defined %}
              <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-module" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_form }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field required">
                    <label class="dcx-label">{{ entry_name }}</label>
                    {% for language in languages %}
                    <div class="dc-attr-row__value">
                      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>
                      <input type="text" name="name_translation[{{ language.language_id }}]" value="{{ name_translation[language.language_id] }}" placeholder="{{ entry_name }}" class="form-control" />
                    </div>
                    {% endfor %}
                    {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-product">{{ entry_product }} <span data-toggle="tooltip" title="{{ help_product }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                    <input type="text" name="product_name" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                    <div id="latest-product" class="well well-sm" style="height: 150px; overflow: auto;">
                      {% for product in products %}
                      <div id="latest-product{{ product.product_id }}"><i data-lucide="circle-minus" width="14" height="14"></i> {{ product.name }}
                        <input type="hidden" name="product[]" value="{{ product.product_id }}" />
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-category-filter">{{ entry_category_filter }} <span data-toggle="tooltip" title="{{ help_category_filter }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                    <select name="category_filter" id="input-category-filter" class="form-control">
                      {% if category_filter %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-limit">{{ entry_limit }}</label>
                    <input type="text" name="limit" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" />
                  </div>
                  <div style="display:flex;gap:12px">
                    <div class="dcx-field" style="flex:1">
                      <label class="dcx-label" for="input-width">{{ entry_width }}</label>
                      <input type="text" name="width" value="{{ width }}" placeholder="{{ entry_width }}" id="input-width" class="form-control" />
                      {% if error_width %}
                      <div class="text-danger">{{ error_width }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field" style="flex:1">
                      <label class="dcx-label" for="input-height">{{ entry_height }}</label>
                      <input type="text" name="height" value="{{ height }}" placeholder="{{ entry_height }}" id="input-height" class="form-control" />
                      {% if error_height %}
                      <div class="text-danger">{{ error_height }}</div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="status" id="input-status" class="form-control">
                      {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('input[name=\'product_name\']').autocomplete({
	source: function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	select: function(item) {
		$('input[name=\'product_name\']').val('');

		$('#latest-product' + item['value']).remove();

		$('#latest-product').append('<div id="latest-product' + item['value'] + '"><i data-lucide="circle-minus" width="14" height="14"></i> ' + item['label'] + '<input type="hidden" name="product[]" value="' + item['value'] + '" /></div>');
		lucide.createIcons();
	}
});

$('#latest-product').delegate('i[data-lucide="circle-minus"]', 'click', function() {
	$(this).parent().remove();
});
//--></script>
{{ footer }}
