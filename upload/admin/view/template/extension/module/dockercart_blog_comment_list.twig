{{ header }}
{{ column_left }}
<div id="content">
  <link rel="stylesheet" href="view/stylesheet/dockercart_dcx_ui.css" />
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <button type="button" data-toggle="tooltip" title="{{ button_approve }}" class="btn btn-success btn--icon" onclick="$('#form-comment').attr('action', '{{ approve }}'); $('#form-comment').submit();"><i data-lucide="check" width="16" height="16"></i></button>
            <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="confirm('{{ text_confirm }}') ? ($('#form-comment').attr('action', '{{ delete }}'), $('#form-comment').submit()) : false;"><i data-lucide="trash-2" width="16" height="16"></i></button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="check-circle" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-comment">
          <div id="filter-comment" class="filter-bar">
            <div class="panel panel-default">
              <div class="panel-body">
                <div class="filter-field">
                  <label>{{ entry_post }}</label>
                  <input type="text" name="filter_post" value="{{ filter_post }}" placeholder="{{ entry_post }}" id="input-filter-post" class="form-control" />
                </div>
                <div class="filter-field">
                  <label>{{ entry_author }}</label>
                  <input type="text" name="filter_author" value="{{ filter_author }}" placeholder="{{ entry_author }}" id="input-filter-author" class="form-control" />
                </div>
                <div class="filter-field">
                  <label>{{ entry_email }}</label>
                  <input type="text" name="filter_email" value="{{ filter_email }}" placeholder="{{ entry_email }}" id="input-filter-email" class="form-control" />
                </div>
                <div class="filter-field">
                  <label>{{ entry_status }}</label>
                  <select name="filter_status" id="input-filter-status" class="form-control">
                    <option value="">{{ text_all }}</option>
                    <option value="1" {% if filter_status == '1' %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if filter_status == '0' %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
                <div class="filter-actions">
                  <button type="button" id="button-filter" class="btn btn-default"><i data-lucide="filter" width="14" height="14"></i> {{ button_filter }}</button>
                </div>
              </div>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-left">{{ column_post }}</td>
                  <td class="text-left">{{ column_author }}</td>
                  <td class="text-center">{{ column_rating }}</td>
                  <td class="text-left">{{ column_status }}</td>
                  <td class="text-left">{{ column_date_added }}</td>
                  <td class="text-right">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if comments %}
                {% for comment in comments %}
                <tr>
                  <td class="text-center">
                    <input type="checkbox" name="selected[]" value="{{ comment.comment_id }}" />
                  </td>
                  <td class="text-left">{{ comment.post_name }}</td>
                  <td class="text-left">{{ comment.author }}</td>
                  <td class="text-center">{{ comment.rating }}</td>
                  <td class="text-left">{{ comment.status }}</td>
                  <td class="text-left">{{ comment.date_added }}</td>
                  <td class="text-right">
                    <a href="{{ comment.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a>
                  </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="7">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="pagination-wrap">
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
  </div>
</div>
<script type="text/javascript">
$('#button-filter').on('click', function() {
  var url = '{{ filter_url }}';

  var filter_post = $('input[name=\'filter_post\']').val();
  var filter_author = $('input[name=\'filter_author\']').val();
  var filter_email = $('input[name=\'filter_email\']').val();
  var filter_status = $('select[name=\'filter_status\']').val();
  var filter_text = $('input[name=\'filter_text\']').val();

  if (filter_post) {
    url += '&filter_post=' + encodeURIComponent(filter_post);
  }
  if (filter_author) {
    url += '&filter_author=' + encodeURIComponent(filter_author);
  }
  if (filter_email) {
    url += '&filter_email=' + encodeURIComponent(filter_email);
  }
  if (filter_status) {
    url += '&filter_status=' + encodeURIComponent(filter_status);
  }
  if (filter_text) {
    url += '&filter_text=' + encodeURIComponent(filter_text);
  }

  location = url;
});
</script>
<script type="text/javascript"><!--
$('#filter-comment input, #filter-comment select').on('keypress', function(e) {
	if (e.which == 13) {
		$('#button-filter').trigger('click');
	}
});
//--></script>
{{ footer }}
