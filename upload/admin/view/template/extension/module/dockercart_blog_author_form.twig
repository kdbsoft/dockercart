{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">

      <div class="row">
        <div class="col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-author" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if name %}
                {{ name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-author">
    <div class="row">
      <div class="col-md-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="user" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ entry_name }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-name">{{ entry_name }}</label>
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-email">{{ entry_email }}</label>
                  <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                  {% if error_email %}
                  <div class="text-danger">{{ error_email }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_image }}</label>
                  <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="image" value="{{ image }}" id="input-image" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-bio">{{ entry_bio }}</label>
                  <textarea name="bio" rows="5" placeholder="{{ entry_bio }}" id="input-bio" class="form-control">{{ bio }}</textarea>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                  <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('[data-toggle="tooltip"]').tooltip();
//--></script>
</div>
{{ footer }}