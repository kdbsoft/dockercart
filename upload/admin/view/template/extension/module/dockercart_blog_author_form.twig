{{ header }}{{ column_left }}
<div id="content">
<div class="page-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <a href="{{ cancel }}" class="page-header__link">
          <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
          <span class="page-header__title">
            {% if name %}
              {{ name }}
              <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ status ? text_active : text_inactive }}
              </span>
            {% else %}
              {{ text_form }}
            {% endif %}
          </span>
        </a>
        <div class="pull-right">
          <button type="submit" form="form-author" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
          <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
        </div>
      </div>
    </div>
    {% if error_warning %}
    <div class="row">
      <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
<div class="container-fluid">
  <div class="row">
    <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
      <div class="dcx-shell">
        <div class="dcx-panel">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="user" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ text_form }}</div>
              <div class="dcx-panel-subtitle">{{ text_form_subtitle }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-author">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-name">{{ entry_name }} <span class="text-danger">*</span></label>
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-email">{{ entry_email }} <span class="text-danger">*</span></label>
                  <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                  {% if error_email %}
                  <div class="text-danger">{{ error_email }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_image }}</label>
                  <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="image" value="{{ image }}" id="input-image" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-bio">{{ entry_bio }}</label>
                  <textarea name="bio" rows="5" placeholder="{{ entry_bio }}" id="input-bio" class="form-control">{{ bio }}</textarea>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control" style="max-width:200px;">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                  <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" style="max-width:100px;" />
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
{{ footer }}