{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
  <div class="page-header">


      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if status is defined %}
              <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
        </div>
          {% if error_warning %}
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
  </div>
</div>
<div class="container-fluid"><div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_edit }}</div>
                <div class="dcx-panel-subtitle">{{ text_edit_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module">
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label">{{ entry_name }}</label>
                    <ul class="nav nav-tabs" style="margin-bottom:10px;">
                      {% for language in languages %}
                      <li{% if loop.first %} class="active"{% endif %}><a href="#name-lang-{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content">
                      {% for language in languages %}
                      <div class="tab-pane{% if loop.first %} active{% endif %}" id="name-lang-{{ language.language_id }}">
                        <input type="text" name="name_translation[{{ language.language_id }}]" value="{{ name_translation[language.language_id] }}" placeholder="{{ entry_name }}" class="form-control" />
                      </div>
                      {% endfor %}
                    </div>
                    {% if error_name %}
                    <div class="text-danger">{{ error_name }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-max-depth"><span data-toggle="tooltip" title="{{ help_max_depth }}">{{ entry_max_depth }}</span></label>
                    <input type="number" name="max_depth" value="{{ max_depth }}" min="0" placeholder="{{ entry_max_depth }}" id="input-max-depth" class="form-control" />
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-show-product-count">{{ entry_show_product_count }}</label>
                    <select name="show_product_count" id="input-show-product-count" class="form-control">
                      {% if show_product_count %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="status" id="input-status" class="form-control">
                      {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
