{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-module" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_edit }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="module_category_status" id="input-status" class="form-control">
                      {% if module_category_status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-category">{{ entry_categories }} <span data-toggle="tooltip" title="{{ help_categories }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                    <input type="text" name="category" value="" placeholder="{{ entry_categories }}" id="input-category" class="form-control" />
                    <div id="module-category-categories" class="well well-sm" style="height: 150px; overflow: auto;">
                      {% for category in categories %}
                      <div id="module-category-categories{{ category.category_id }}"><i data-lucide="circle-minus" width="14" height="14"></i> {{ category.name }}
                        <input type="hidden" name="module_category_categories[]" value="{{ category.category_id }}" />
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('input[name=\'category\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['category_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'category\']').val('');

		$('#module-category-categories' + item['value']).remove();

		$('#module-category-categories').append('<div id="module-category-categories' + item['value'] + '"><i data-lucide="circle-minus" width="14" height="14"></i> ' + item['label'] + '<input type="hidden" name="module_category_categories[]" value="' + item['value'] + '" /></div>');
		lucide.createIcons();
	}
});

$('#module-category-categories').delegate('i[data-lucide="circle-minus"]', 'click', function() {
	$(this).parent().remove();
});
//--></script>
{{ footer }}
