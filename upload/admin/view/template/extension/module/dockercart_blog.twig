{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-dockercart-blog" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ heading_title }}
              <span class="page-header__badge {{ blog_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ blog_status ? text_active : text_inactive }}
              </span>
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-dockercart-blog">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="sliders-horizontal" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_general }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-posts-per-page">{{ entry_posts_per_page }}</label>
                  <input type="text" name="module_dockercart_blog_posts_per_page" value="{{ module_dockercart_blog_posts_per_page }}" placeholder="{{ entry_posts_per_page }}" id="input-posts-per-page" class="form-control" style="max-width:120px;" />
                  <span class="help-block">{{ help_posts_per_page }}</span>
                  {% if error_posts_per_page %}
                  <div class="text-danger">{{ error_posts_per_page }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="monitor" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_display }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="checkbox" name="module_dockercart_blog_show_author" value="1"{% if module_dockercart_blog_show_author %} checked{% endif %} /> {{ entry_show_author }}
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="checkbox" name="module_dockercart_blog_show_date" value="1"{% if module_dockercart_blog_show_date %} checked{% endif %} /> {{ entry_show_date }}
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="checkbox" name="module_dockercart_blog_show_views" value="1"{% if module_dockercart_blog_show_views %} checked{% endif %} /> {{ entry_show_views }}
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-latest-limit">{{ entry_latest_limit }}</label>
                  <input type="text" name="module_dockercart_blog_latest_limit" value="{{ module_dockercart_blog_latest_limit }}" placeholder="{{ entry_latest_limit }}" id="input-latest-limit" class="form-control" style="max-width:120px;" />
                  <span class="help-block">{{ help_latest_limit }}</span>
                  {% if error_latest_limit %}
                  <div class="text-danger">{{ error_latest_limit }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="message-square" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_comments }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="checkbox" name="module_dockercart_blog_allow_comments" value="1"{% if module_dockercart_blog_allow_comments %} checked{% endif %} /> {{ entry_allow_comments }}
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="checkbox" name="module_dockercart_blog_moderate_comments" value="1"{% if module_dockercart_blog_moderate_comments %} checked{% endif %} /> {{ entry_moderate_comments }}
                      <span data-toggle="tooltip" title="{{ help_moderate_comments }}"><i data-lucide="help-circle" width="14" height="14" class="text-muted"></i></span>
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-captcha">{{ entry_captcha }}</label>
                  <select name="module_dockercart_blog_captcha" id="input-captcha" class="form-control" style="max-width:200px;">
                    {% if module_dockercart_blog_captcha %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-sidebar-status">{{ entry_status }}</label>
              <select name="module_dockercart_blog_status" id="input-sidebar-status" class="form-control" style="max-width:200px;">
                {% if module_dockercart_blog_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
        </div>

        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="link" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_quick_links_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <a href="{{ link_posts }}" class="btn btn-default btn-sm btn-block"><i data-lucide="file-text" width="14" height="14"></i> {{ text_manage_posts }}</a>
            </div>
            <div class="dcx-sidebar-card__field">
              <a href="{{ link_categories }}" class="btn btn-default btn-sm btn-block"><i data-lucide="folder" width="14" height="14"></i> {{ text_manage_categories }}</a>
            </div>
            <div class="dcx-sidebar-card__field">
              <a href="{{ link_authors }}" class="btn btn-default btn-sm btn-block"><i data-lucide="user" width="14" height="14"></i> {{ text_manage_authors }}</a>
            </div>
            <div class="dcx-sidebar-card__field">
              <a href="{{ link_comments }}" class="btn btn-default btn-sm btn-block"><i data-lucide="message-square" width="14" height="14"></i> {{ text_manage_comments }}</a>
            </div>
          </div>
        </div>

        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="info" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_about_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ text_module_label }}</label>
              <div style="font-size:13px;color:var(--dc-text-dark);">{{ heading_title }}</div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ text_developer_label }}</label>
              <div style="font-size:13px;color:var(--dc-text-dark);">DockerCart Official</div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ text_contact_label }}</label>
              <div style="font-size:13px;"><a href="mailto:support@dockercart.net">support@dockercart.net</a></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<script type="text/javascript">
$(document).ready(function() {
  $('[data-toggle="tooltip"]').tooltip();
});
</script>
{{ footer }}
