{{ header }}{{ column_left }}
<div id="content">
<div class="page-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-8 col-xl-offset-1 col-xl-7">
        <a href="{{ cancel }}" class="page-header__link">
          <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
          <span class="page-header__title">
            {{ heading_title }}
            <span class="page-header__badge page-header__badge--active">{{ text_active }}</span>
          </span>
        </a>
      </div>
      <div class="col-lg-4 col-xl-3">
        <div class="pull-right">
          <button type="submit" form="form-dockercart-checkout" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
          <button type="button" class="btn btn-success" id="button-apply"><i data-lucide="check" width="16" height="16"></i> {{ button_apply }}</button>
          <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
        </div>
      </div>
    </div>
    {% if error_warning %}
    <div class="row">
      <div class="col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      </div>
    </div>
    {% endif %}
    {% if success %}
    <div class="row">
      <div class="col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>

<div class="container-fluid">
  <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-dockercart-checkout">
  <div class="row">
    <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
      <div class="dcx-shell">

        <!-- BLOCKS -->
        <div class="dcx-panel" id="panel-blocks">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="columns-2" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ tab_blocks }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <div class="dcx-section" style="margin-top:0;padding-top:0;border-top:0;">
              <h4><i data-lucide="columns-2" width="16" height="16"></i> {{ text_blocks_title|default('Manage Checkout Blocks') }}</h4>
              <div class="dc-blocks-container">
                <div class="dc-blocks-header">
                  <div class="dc-block-col-name">{{ column_block_name|default('Block Name') }}</div>
                  <div class="dc-block-col-fields">{{ column_block_fields|default('Fields') }}</div>
                  <div class="dc-block-col-enabled">{{ column_block_enabled|default('Enabled') }}</div>
                  <div class="dc-block-col-collapsible">{{ column_block_collapsible|default('Collapsible') }}</div>
                  <div class="dc-block-col-settings">{{ text_settings|default('Settings') }}</div>
                </div>
                <div id="blocks-sortable" class="dc-blocks-list">
                  {% for block in blocks %}
                  <div class="dc-block-item" data-block-id="{{ block.id }}">
                    <div class="dc-block-col-name">
                      <i data-lucide="{{ block.id == 'customer_details' ? 'user' : (block.id == 'shipping_address' ? 'map-pin' : (block.id == 'payment_address' ? 'credit-card' : (block.id == 'payment_method' ? 'dollar-sign' : (block.id == 'customer_order' ? 'shopping-cart' : 'code')))) }}" width="16" height="16"></i>
                      <span>{{ block.name }}</span>
                    </div>
                    <div class="dc-block-col-fields">
                      {% set enabled_fields = 0 %}
                      {% set total_fields = 0 %}
                      {% if block.rows is defined %}
                        {% for row in block.rows %}
                          {% for field in row.fields %}
                            {% set total_fields = total_fields + 1 %}
                            {% if field.visible == 1 %}
                              {% set enabled_fields = enabled_fields + 1 %}
                            {% endif %}
                          {% endfor %}
                        {% endfor %}
                      {% endif %}
                      <span class="badge badge-info">{{ enabled_fields }}/{{ total_fields }}</span>
                    </div>
                    <div class="dc-block-col-enabled">
                      <label class="dc-toggle">
                        <input type="checkbox" name="module_dockercart_checkout_blocks[{{ loop.index0 }}][enabled]" value="1" {% if block.enabled == 1 %}checked{% endif %} class="block-enabled-input">
                        <span class="dc-toggle-slider"></span>
                      </label>
                    </div>
                    <div class="dc-block-col-collapsible">
                      <label class="dc-toggle">
                        <input type="checkbox" name="module_dockercart_checkout_blocks[{{ loop.index0 }}][collapsible]" value="1" {% if block.collapsible == 1 %}checked{% endif %} class="block-collapsible-input">
                        <span class="dc-toggle-slider"></span>
                      </label>
                    </div>
                    <div class="dc-block-col-settings">
                      <button type="button" class="btn btn-sm btn-primary btn-block-settings" data-block-index="{{ loop.index0 }}" data-block-id="{{ block.id }}">
                        <i data-lucide="settings" width="14" height="14"></i> {{ text_configure|default('Configure') }}
                      </button>
                    </div>
                    <input type="hidden" name="module_dockercart_checkout_blocks[{{ loop.index0 }}][id]" value="{{ block.id }}" class="block-id-input">
                    <input type="hidden" name="module_dockercart_checkout_blocks[{{ loop.index0 }}][name]" value="{{ block.name }}" class="block-name-input">
                    <input type="hidden" name="module_dockercart_checkout_blocks[{{ loop.index0 }}][sort_order]" value="{{ loop.index }}" class="sort-order-input">
                    <input type="hidden" name="module_dockercart_checkout_blocks[{{ loop.index0 }}][rows]" value="{{ block.rows|json_encode|e('html') }}" class="block-rows-input">
                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- DESIGN -->
        <div class="dcx-panel" id="panel-design" style="margin-top:16px;">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="paintbrush" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ tab_design }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <div class="dcx-section" style="margin-top:0;padding-top:0;border-top:0;">
              <h4><i data-lucide="paintbrush" width="16" height="16"></i> {{ tab_design }}</h4>
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-theme">{{ entry_theme }} <span data-toggle="tooltip" title="{{ help_theme }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                  <select name="module_dockercart_checkout_theme" id="input-theme" class="form-control" style="max-width:300px;">
                    {% for key, value in theme_options %}
                    <option value="{{ key }}" {% if module_dockercart_checkout_theme == key %}selected{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-custom-css">{{ entry_custom_css }} <span data-toggle="tooltip" title="{{ help_custom_css }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                  <textarea name="module_dockercart_checkout_custom_css" id="input-custom-css" class="form-control" rows="8" placeholder=".dc-checkout { /* your styles */ }" style="font-family:monospace;">{{ module_dockercart_checkout_custom_css }}</textarea>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-custom-js">{{ entry_custom_js }} <span data-toggle="tooltip" title="{{ help_custom_js }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                  <textarea name="module_dockercart_checkout_custom_js" id="input-custom-js" class="form-control" rows="8" placeholder="// Your ES6+ JavaScript" style="font-family:monospace;">{{ module_dockercart_checkout_custom_js }}</textarea>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- METHOD OVERRIDES -->
        <div class="dcx-panel" id="panel-overrides" style="margin-top:16px;">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="pen" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ tab_method_overrides }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <div class="dcx-section" style="margin-top:0;padding-top:0;border-top:0;">
              <h4><i data-lucide="truck" width="16" height="16"></i> {{ text_shipping_methods }}</h4>
              <div class="alert alert-info dc-alert-modern" style="margin-bottom:16px;">
                <i data-lucide="info" width="16" height="16"></i>
                <strong>{{ text_method_overrides }}</strong><br>
                {{ text_method_overrides_help }}
              </div>
              {% if available_shipping_methods %}
              <div class="dc-override-list">
                {% for method_code, method_data in available_shipping_methods %}
                {% set code_safe = method_code|replace({'.': '-'}) %}
                <div class="dc-override-item" id="over-{{ code_safe }}">
                  <div class="dc-override-item__header">
                    <div class="dc-override-item__info">
                      <i data-lucide="truck" width="16" height="16"></i>
                      <div>
                        <div class="dc-override-item__code">{{ method_code }}</div>
                        <div class="dc-override-item__module">{{ text_module }}: {{ method_data.module_title }}</div>
                      </div>
                    </div>
                    <div class="dc-override-item__toggle">
                      <span class="dc-override-status" data-override-status
                        data-on="{{ text_method_status_on }}" data-off="{{ text_method_status_off }}"></span>
                      <label class="dc-toggle-sm" title="{{ text_method_enabled }}">
                        <input type="hidden" name="module_dockercart_checkout_shipping_override[{{ method_code }}][enabled]" value="0">
                        <input type="checkbox" name="module_dockercart_checkout_shipping_override[{{ method_code }}][enabled]" value="1"
                          {% if shipping_overrides[method_code].enabled is defined and shipping_overrides[method_code].enabled %}checked{% endif %}
                          class="method-override-toggle" data-target="over-{{ code_safe }}">
                        <span class="dc-toggle-slider-sm"></span>
                      </label>
                    </div>
                  </div>
                  <div class="dc-override-item__body">
                    <div class="dc-override-item__langs">
                      <ul class="nav nav-tabs dc-override-langtabs">
                        {% for language in languages %}
                        <li{% if loop.first %} class="active"{% endif %}>
                          <a href="javascript:void(0)" data-lang="{{ language.language_id }}" data-toggle="tooltip" title="{{ language.name }}">
                            <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>
                          </a>
                        </li>
                        {% endfor %}
                      </ul>
                    </div>
                    <div class="dc-override-item__field">
                      <label class="dcx-label">{{ text_custom_title }}</label>
                      <div class="dc-override-langcontent">
                        {% for language in languages %}
                        <div class="dc-override-pane{% if loop.first %} active{% endif %}" data-langs="{{ language.language_id }}">
                          <input type="text"
                            name="module_dockercart_checkout_shipping_override[{{ method_code }}][title][{{ language.code }}]"
                            value="{{ shipping_overrides[method_code].title[language.code]|default('') }}"
                            placeholder="{{ method_data.default_title }}"
                            class="form-control override-field">
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                    <div class="dc-override-item__field">
                      <label class="dcx-label">{{ text_custom_description }}</label>
                      <div class="dc-override-langcontent">
                        {% for language in languages %}
                        <div class="dc-override-pane{% if loop.first %} active{% endif %}" data-langs="{{ language.language_id }}">
                          <input type="text"
                            name="module_dockercart_checkout_shipping_override[{{ method_code }}][description][{{ language.code }}]"
                            value="{{ shipping_overrides[method_code].description[language.code]|default('') }}"
                            placeholder="{{ placeholder_optional_description }}"
                            class="form-control override-field">
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                    <div class="dc-override-item__field">
                      <label class="dcx-label">{{ text_address_fields }}</label>
                      <div class="dcx-checkbox-group">
                        {% for key in address_field_order|default(['company','address_1','address_2','city','postcode']) %}
                        {% set label_key = 'text_field_' ~ key %}
                        {% set field_data = shipping_overrides[method_code].fields[key]|default({'visible': 1, 'required': 0}) %}
                        <div class="dc-addr-field-group">
                          <label class="dcx-checkbox-label">
                            <input type="hidden" name="module_dockercart_checkout_shipping_override[{{ method_code }}][fields][{{ key }}][visible]" value="0">
                            <input type="checkbox" name="module_dockercart_checkout_shipping_override[{{ method_code }}][fields][{{ key }}][visible]" value="1" {% if field_data.visible %}checked{% endif %}>
                            {{ attribute(_context, label_key)|default(key|replace({'_': ' '})|title) }}
                          </label>
                          <label class="dcx-checkbox-label dcx-checkbox-label--sm">
                            <input type="hidden" name="module_dockercart_checkout_shipping_override[{{ method_code }}][fields][{{ key }}][required]" value="0">
                            <input type="checkbox" name="module_dockercart_checkout_shipping_override[{{ method_code }}][fields][{{ key }}][required]" value="1" {% if field_data.required %}checked{% endif %}>
                            {{ text_required }}
                          </label>
                        </div>
                        {% endfor %}
                      </div>
                      <div class="help-block">{{ help_shipping_fields }}<br>({{ text_country_region_always_visible|default('Country and Region are always visible') }})</div>
                    </div>
                    <div class="dc-override-item__footer">
                      <button type="button" class="method-override-reset" data-target="over-{{ code_safe }}">
                        <i data-lucide="eraser" width="14" height="14"></i> {{ button_clear_fields }}
                      </button>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
              {% else %}
              <p class="text-muted">{{ text_no_methods_available }}</p>
              {% endif %}
            </div>

            <div class="dcx-section">
              <h4><i data-lucide="credit-card" width="16" height="16"></i> {{ text_payment_methods }}</h4>
              {% if available_payment_methods %}
              <div class="dc-override-list">
                {% for method_code, method_data in available_payment_methods %}
                {% set code_safe = method_code|replace({'.': '-'}) %}
                <div class="dc-override-item" id="over-pay-{{ code_safe }}">
                  <div class="dc-override-item__header">
                    <div class="dc-override-item__info">
                      <i data-lucide="credit-card" width="16" height="16"></i>
                      <div>
                        <div class="dc-override-item__code">{{ method_code }}</div>
                        <div class="dc-override-item__module">{{ text_default_title }}: {{ method_data.default_title }}</div>
                      </div>
                    </div>
                    <div class="dc-override-item__toggle">
                      <span class="dc-override-status" data-override-status
                        data-on="{{ text_method_status_on }}" data-off="{{ text_method_status_off }}"></span>
                      <label class="dc-toggle-sm" title="{{ text_method_enabled }}">
                        <input type="hidden" name="module_dockercart_checkout_payment_override[{{ method_code }}][enabled]" value="0">
                        <input type="checkbox" name="module_dockercart_checkout_payment_override[{{ method_code }}][enabled]" value="1"
                          {% if payment_overrides[method_code].enabled is defined and payment_overrides[method_code].enabled %}checked{% endif %}
                          class="method-override-toggle" data-target="over-pay-{{ code_safe }}">
                        <span class="dc-toggle-slider-sm"></span>
                      </label>
                    </div>
                  </div>
                  <div class="dc-override-item__body">
                    <div class="dc-override-item__langs">
                      <ul class="nav nav-tabs dc-override-langtabs">
                        {% for language in languages %}
                        <li{% if loop.first %} class="active"{% endif %}>
                          <a href="javascript:void(0)" data-lang="{{ language.language_id }}" data-toggle="tooltip" title="{{ language.name }}">
                            <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>
                          </a>
                        </li>
                        {% endfor %}
                      </ul>
                    </div>
                    <div class="dc-override-item__field">
                      <label class="dcx-label">{{ text_custom_title }}</label>
                      <div class="dc-override-langcontent">
                        {% for language in languages %}
                        <div class="dc-override-pane{% if loop.first %} active{% endif %}" data-langs="{{ language.language_id }}">
                          <input type="text"
                            name="module_dockercart_checkout_payment_override[{{ method_code }}][title][{{ language.code }}]"
                            value="{{ payment_overrides[method_code].title[language.code]|default('') }}"
                            placeholder="{{ method_data.default_title }}"
                            class="form-control override-field">
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                    <div class="dc-override-item__field">
                      <label class="dcx-label">{{ text_custom_description }}</label>
                      <div class="dc-override-langcontent">
                        {% for language in languages %}
                        <div class="dc-override-pane{% if loop.first %} active{% endif %}" data-langs="{{ language.language_id }}">
                          <input type="text"
                            name="module_dockercart_checkout_payment_override[{{ method_code }}][description][{{ language.code }}]"
                            value="{{ payment_overrides[method_code].description[language.code]|default('') }}"
                            placeholder="{{ placeholder_optional_description }}"
                            class="form-control override-field">
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                    <div class="dc-override-item__footer">
                      <button type="button" class="method-override-reset" data-target="over-pay-{{ code_safe }}">
                        <i data-lucide="eraser" width="14" height="14"></i> {{ button_clear_fields }}
                      </button>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
              {% else %}
              <p class="text-muted">{{ text_no_methods_available }}</p>
              {% endif %}
            </div>
          </div>
        </div>

      </div>{# /.dcx-shell #}
    </div>{# /.col main #}

    <!-- SIDEBAR -->
    <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
      <div class="dcx-shell">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_sidebar_status }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__help"><i data-lucide="info" width="14" height="14"></i> {{ text_module_always_active }}</div>
          </div>
        </div>

        <div class="dcx-sidebar-card" style="margin-top:16px;">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="settings" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_checkout_settings|default('Checkout Settings') }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-fields">
              <div class="dcx-field dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="hidden" name="module_dockercart_checkout_redirect_standard" value="0">
                  <input type="checkbox" name="module_dockercart_checkout_redirect_standard" value="1" id="input-redirect-standard" {% if module_dockercart_checkout_redirect_standard == 1 %}checked{% endif %}>
                  {{ entry_redirect_standard }}
                  <span data-toggle="tooltip" title="{{ help_redirect_standard }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
              <div class="dcx-field dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="hidden" name="module_dockercart_checkout_show_progress" value="0">
                  <input type="checkbox" name="module_dockercart_checkout_show_progress" value="1" id="input-show-progress" {% if module_dockercart_checkout_show_progress == 1 %}checked{% endif %}>
                  {{ entry_show_progress }}
                  <span data-toggle="tooltip" title="{{ help_show_progress }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
              <div class="dcx-field dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="hidden" name="module_dockercart_checkout_guest_create_account" value="0">
                  <input type="checkbox" name="module_dockercart_checkout_guest_create_account" value="1" id="input-guest-create-account" {% if module_dockercart_checkout_guest_create_account == 1 %}checked{% endif %}>
                  {{ entry_guest_create_account }}
                  <span data-toggle="tooltip" title="{{ help_guest_create_account }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="dcx-sidebar-card" style="margin-top:16px;">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="map-pin" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ entry_default_country|default('Default Location') }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-fields">
              <div class="dcx-field">
                <label class="dcx-label" for="input-default-country">{{ entry_default_country|default('Default Country') }} <span data-toggle="tooltip" title="{{ help_default_country }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <select name="module_dockercart_checkout_default_country_id" id="input-default-country" class="form-control">
                  <option value="">{{ text_select|default('--- None ---') }}</option>
                  {% for country in admin_countries %}
                  <option value="{{ country.country_id }}" {% if module_dockercart_checkout_default_country_id == country.country_id %}selected{% endif %}>{{ country.name }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-default-zone">{{ entry_default_zone|default('Default Region / State') }} <span data-toggle="tooltip" title="{{ text_select_country_first|default('Select a country first, then choose a region') }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <select name="module_dockercart_checkout_default_zone_id" id="input-default-zone" class="form-control">
                  <option value="">{{ text_select|default('--- None ---') }}</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class="dcx-sidebar-card" style="margin-top:16px;">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="sliders-vertical" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ tab_advanced }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-fields">
              <div class="dcx-field">
                <label class="dcx-label" for="input-cache-ttl">{{ entry_cache_ttl }} <span data-toggle="tooltip" title="{{ help_cache_ttl }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <input type="number" name="module_dockercart_checkout_cache_ttl" id="input-cache-ttl" value="{{ module_dockercart_checkout_cache_ttl }}" class="form-control" min="0" max="86400">
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-debug">{{ entry_debug }} <span data-toggle="tooltip" title="{{ help_debug }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <select name="module_dockercart_checkout_debug" id="input-debug" class="form-control">
                  <option value="1" {% if module_dockercart_checkout_debug == 1 %}selected{% endif %}>{{ text_yes }}</option>
                  <option value="0" {% if module_dockercart_checkout_debug == 0 %}selected{% endif %}>{{ text_no }}</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>{# /.dcx-shell #}
    </div>{# /.col sidebar #}
  </div>{# /.row #}
  </form>
</div>{# /.container-fluid #}

<script>
// Apply (save without leaving the page)
document.addEventListener('DOMContentLoaded', function() {
  var applyBtn = document.getElementById('button-apply');
  var form = document.getElementById('form-dockercart-checkout');

  function createAlert(type, html, cls) {
    var container = document.querySelector('.container-fluid');
    if (!container) return;
    var existing = document.querySelector('.' + (cls || 'dc-apply-alert'));
    if (existing) existing.remove();
    var div = document.createElement('div');
    div.className = 'alert alert-' + type + ' alert-dismissible ' + (cls || 'dc-apply-alert');
    div.innerHTML = html + '\n<button type="button" class="close" data-dismiss="alert">&times;</button>';
    container.insertBefore(div, container.firstChild);
    try { if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') lucide.createIcons(); } catch(e) {}
  }

  if (applyBtn && form) {
    applyBtn.addEventListener('click', function(e) {
      applyBtn.disabled = true;
      var fd = new FormData(form);

      fetch(form.action, {
        method: 'POST',
        body: fd,
        credentials: 'same-origin'
      }).then(function(response) {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.text();
      }).then(function() {
        createAlert('success', '<i data-lucide="circle-check"></i> {{ text_success|default("Settings saved") | e('js') }}');
      }).catch(function(err) {
        createAlert('danger', '<i data-lucide="circle-alert"></i> ' + (err.message || 'Save failed'), 'dc-apply-alert-error');
      }).finally(function() {
        applyBtn.disabled = false;
      });
    });
  }
});

// Zone loading for default country
document.addEventListener('DOMContentLoaded', function() {
  var defaultCountrySelect = document.getElementById('input-default-country');
  var defaultZoneSelect = document.getElementById('input-default-zone');
  if (defaultCountrySelect && defaultZoneSelect) {
    defaultCountrySelect.addEventListener('change', function() {
      var countryId = this.value;
      var zoneSelect = defaultZoneSelect;
      zoneSelect.innerHTML = '<option value="">{{ text_select|default('--- None ---') }}</option>';
      if (!countryId) return;
      var xhr = new XMLHttpRequest();
      xhr.open('GET', 'index.php?route=localisation/country/country&country_id=' + countryId + '&user_token={{ user_token }}', true);
      xhr.onload = function() {
        if (xhr.status === 200) {
          try {
            var data = JSON.parse(xhr.responseText);
            if (data.zone) {
              data.zone.forEach(function(zone) {
                var option = document.createElement('option');
                option.value = zone.zone_id;
                option.textContent = zone.name;
                {% if module_dockercart_checkout_default_zone_id %}
                if (zone.zone_id == '{{ module_dockercart_checkout_default_zone_id }}') {
                  option.selected = true;
                }
                {% endif %}
                zoneSelect.appendChild(option);
              });
            }
          } catch(e) {}
        }
      };
      xhr.send();
    });
    if (defaultCountrySelect.value) {
      defaultCountrySelect.dispatchEvent(new Event('change'));
    }
  }
});

// Method Overrides toggle
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.method-override-toggle').forEach(function(checkbox) {
    var item = document.getElementById(checkbox.getAttribute('data-target'));
    function toggleOverride() {
      if (!item) return;
      var on = checkbox.checked;
      item.classList.toggle('dc-override-item--disabled', !on);
      item.classList.toggle('dc-override-item--enabled', on);
      var fields = item.querySelectorAll('.override-field');
      fields.forEach(function(f) { f.disabled = !on; });
      var status = item.querySelector('[data-override-status]');
      if (status) {
        status.textContent = on ? (status.getAttribute('data-on') || '') : (status.getAttribute('data-off') || '');
        status.classList.toggle('dc-override-status--on', on);
        status.classList.toggle('dc-override-status--off', !on);
      }
      var resetBtn = item.querySelector('.method-override-reset');
      if (resetBtn) resetBtn.disabled = !on;
    }
    checkbox.addEventListener('change', toggleOverride);
    toggleOverride();
  });

  document.querySelectorAll('.method-override-reset').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = document.getElementById(btn.getAttribute('data-target'));
      if (!item) return;
      item.querySelectorAll('.override-field').forEach(function(f) {
        if (f.type === 'checkbox' || f.type === 'radio') { f.checked = false; }
        else { f.value = ''; }
      });
      try { if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') lucide.createIcons(); } catch(e) {}
    });
  });

  // Single language switcher toggles both title & description panes together
  document.querySelectorAll('.dc-override-langtabs').forEach(function(tabs) {
    var links = tabs.querySelectorAll('a');
    links.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var lang = link.getAttribute('data-lang');
        var body = tabs.closest('.dc-override-item__body');
        if (!body) return;
        links.forEach(function(l) { l.parentElement.classList.remove('active'); });
        link.parentElement.classList.add('active');
        body.querySelectorAll('.dc-override-pane[data-langs]').forEach(function(pane) {
          pane.classList.toggle('active', pane.getAttribute('data-langs') === lang);
        });
      });
    });
  });
});
</script>

