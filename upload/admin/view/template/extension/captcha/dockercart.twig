{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
  <div class="page-header">


      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-captcha" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if captcha_dockercart_status is defined %}
              <span class="page-header__badge {{ captcha_dockercart_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ captcha_dockercart_status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
        </div>
          {% if error_warning %}
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
  </div>
</div>
<div class="container-fluid"><div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_edit }}</div>
                <div class="dcx-panel-subtitle">{{ text_edit_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-captcha">
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                    <select name="captcha_dockercart_status" id="input-status" class="form-control">
                      {% if captcha_dockercart_status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label">{{ entry_operations }}</label>
                    <div class="checkbox">
                      <label>
                        <input type="checkbox" name="captcha_dockercart_operations[]" value="addition" {{ 'addition' in captcha_dockercart_operations ? 'checked' : '' }} />
                        {{ text_addition }}
                      </label>
                    </div>
                    <div class="checkbox">
                      <label>
                        <input type="checkbox" name="captcha_dockercart_operations[]" value="subtraction" {{ 'subtraction' in captcha_dockercart_operations ? 'checked' : '' }} />
                        {{ text_subtraction }}
                      </label>
                    </div>
                    <div class="checkbox">
                      <label>
                        <input type="checkbox" name="captcha_dockercart_operations[]" value="multiplication" {{ 'multiplication' in captcha_dockercart_operations ? 'checked' : '' }} />
                        {{ text_multiplication }}
                      </label>
                    </div>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-max-number">{{ entry_max_number }}</label>
                    <select name="captcha_dockercart_max_number" id="input-max-number" class="form-control">
                      {% for n in [5, 10, 15, 20, 30, 50] %}
                      <option value="{{ n }}" {% if captcha_dockercart_max_number == n %}selected{% endif %}>{{ n }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
