{{ promotion }}
<fieldset>
  <legend>{{ heading_title }}</legend>
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <td class="text-left">{{ column_name }}</td>
          <td class="text-left">{{ column_status }}</td>
          <td class="text-right">{{ column_sort_order }}</td>
          <td class="text-right"></td>
        </tr>
      </thead>
      <tbody>
        {% if extensions %}
        {% for extension in extensions %}
        <tr>
          <td class="text-left">{{ extension.name }}</td>
          <td class="text-left">{{ extension.status }}</td>
          <td class="text-right">{{ extension.sort_order }}</td>
          <td class="text-right" style="white-space:nowrap;">{% if extension.installed %}
            <a href="{{ extension.edit }}" class="btn btn-primary"><i data-lucide="pencil" width="14" height="14"></i> {{ button_edit }}</a>
            {% else %}
            <button type="button" class="btn btn-primary" disabled="disabled"><i data-lucide="pencil" width="14" height="14"></i> {{ button_edit }}</button>
            {% endif %} <div class="btn-group"><button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown"><i data-lucide="more-vertical" width="16" height="16"></i></button><ul class="dropdown-menu dropdown-menu-right">{% if not extension.installed %}<li><a href="{{ extension.install }}"><i data-lucide="circle-plus" width="14" height="14"></i> {{ button_install }}</a></li>{% else %}<li><a href="{{ extension.uninstall }}"><i data-lucide="circle-minus" width="14" height="14"></i> {{ button_uninstall }}</a></li>{% endif %}</ul></div></td>
        </tr>
        {% endfor %}
        {% else %}
        <tr>
          <td class="text-center" colspan="4">{{ text_no_results }}</td>
        </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</fieldset>
