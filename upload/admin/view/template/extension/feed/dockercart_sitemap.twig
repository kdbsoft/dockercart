{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              <span class="page-header__badge {{ dockercart_sitemap_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ dockercart_sitemap_status ? text_active : text_inactive }}
              </span>
            </span>
          </a>
        </div>
        <div class="col-sm-12 col-lg-4 col-xl-3">
          <div class="pull-right">
            <button type="submit" form="form-dockercart-sitemap" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <button id="button-generate" type="button" data-toggle="tooltip" title="{{ button_generate }}" class="btn btn-success btn--icon"><i data-lucide="refresh-cw" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-dockercart-sitemap">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_section_module_settings }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="dockercart_sitemap_status" id="input-status" class="form-control">
                    {% if dockercart_sitemap_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">{{ text_sitemap_url }}</label>
                  <div class="alert alert-info" style="margin-bottom:0;">
                    <i data-lucide="info" width="14" height="14"></i> <a href="{{ sitemap_url }}" target="_blank">{{ sitemap_url }}</a>
                    {% if last_generated %}
                    <div style="margin-top:6px;font-size:12px;color:#54627a;">Last generated: <strong id="sitemap-last-generated">{{ last_generated }}</strong> — <span id="sitemap-file-count">{{ sitemap_file_count }}</span> files</div>
                    {% else %}
                    <div style="margin-top:6px;font-size:12px;color:#54627a;">Last generated: <strong id="sitemap-last-generated">Never</strong></div>
                    {% endif %}
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-schedule">{{ entry_schedule }}</label>
                  <select name="dockercart_sitemap_schedule" id="input-schedule" class="form-control">
                    {% for value, label in schedule_options %}
                      <option value="{{ value }}" {% if value == dockercart_sitemap_schedule %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                  </select>
                  <p class="help-block">{{ help_schedule }}</p>
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel form-row--spaced">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="list-checks" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_section_content_types }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="dcx-pills">
                <li class="active"><a href="#tab-products" data-toggle="tab"><i data-lucide="package" width="14" height="14"></i> {{ tab_products }}</a></li>
                <li><a href="#tab-categories" data-toggle="tab"><i data-lucide="folder" width="14" height="14"></i> {{ tab_categories }}</a></li>
                <li><a href="#tab-manufacturers" data-toggle="tab"><i data-lucide="factory" width="14" height="14"></i> {{ tab_manufacturers }}</a></li>
                <li><a href="#tab-information" data-toggle="tab"><i data-lucide="file-text" width="14" height="14"></i> {{ tab_information }}</a></li>
              </ul>
              <div class="tab-content">
                <div class="tab-pane active" id="tab-products">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_products }} <span data-toggle="tooltip" title="{{ help_products }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                      <div class="dcx-checkbox-group">
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_products" value="1" {% if dockercart_sitemap_products %}checked="checked"{% endif %} /> {{ text_enabled }}
                        </label>
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_products" value="0" {% if not dockercart_sitemap_products %}checked="checked"{% endif %} /> {{ text_disabled }}
                        </label>
                      </div>
                    </div>
                    <div class="dcx-fields dcx-fields--row">
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_product_priority }} <span data-toggle="tooltip" title="{{ help_priority }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="dockercart_sitemap_product_priority" value="{{ dockercart_sitemap_product_priority }}" placeholder="0.8" class="form-control" />
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_product_changefreq }} <span data-toggle="tooltip" title="{{ help_changefreq }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <select name="dockercart_sitemap_product_changefreq" class="form-control">
                          {% for value, text in changefreq_options %}
                            {% if value == dockercart_sitemap_product_changefreq %}
                              <option value="{{ value }}" selected="selected">{{ text }}</option>
                            {% else %}
                              <option value="{{ value }}">{{ text }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tab-pane" id="tab-categories">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_categories }} <span data-toggle="tooltip" title="{{ help_categories }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                      <div class="dcx-checkbox-group">
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_categories" value="1" {% if dockercart_sitemap_categories %}checked="checked"{% endif %} /> {{ text_enabled }}
                        </label>
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_categories" value="0" {% if not dockercart_sitemap_categories %}checked="checked"{% endif %} /> {{ text_disabled }}
                        </label>
                      </div>
                    </div>
                    <div class="dcx-fields dcx-fields--row">
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_category_priority }} <span data-toggle="tooltip" title="{{ help_priority }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="dockercart_sitemap_category_priority" value="{{ dockercart_sitemap_category_priority }}" placeholder="0.9" class="form-control" />
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_category_changefreq }} <span data-toggle="tooltip" title="{{ help_changefreq }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <select name="dockercart_sitemap_category_changefreq" class="form-control">
                          {% for value, text in changefreq_options %}
                            {% if value == dockercart_sitemap_category_changefreq %}
                              <option value="{{ value }}" selected="selected">{{ text }}</option>
                            {% else %}
                              <option value="{{ value }}">{{ text }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tab-pane" id="tab-manufacturers">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_manufacturers }} <span data-toggle="tooltip" title="{{ help_manufacturers }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                      <div class="dcx-checkbox-group">
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_manufacturers" value="1" {% if dockercart_sitemap_manufacturers %}checked="checked"{% endif %} /> {{ text_enabled }}
                        </label>
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_manufacturers" value="0" {% if not dockercart_sitemap_manufacturers %}checked="checked"{% endif %} /> {{ text_disabled }}
                        </label>
                      </div>
                    </div>
                    <div class="dcx-fields dcx-fields--row">
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_manufacturer_priority }} <span data-toggle="tooltip" title="{{ help_priority }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="dockercart_sitemap_manufacturer_priority" value="{{ dockercart_sitemap_manufacturer_priority }}" placeholder="0.7" class="form-control" />
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_manufacturer_changefreq }} <span data-toggle="tooltip" title="{{ help_changefreq }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <select name="dockercart_sitemap_manufacturer_changefreq" class="form-control">
                          {% for value, text in changefreq_options %}
                            {% if value == dockercart_sitemap_manufacturer_changefreq %}
                              <option value="{{ value }}" selected="selected">{{ text }}</option>
                            {% else %}
                              <option value="{{ value }}">{{ text }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tab-pane" id="tab-information">
                  <div class="dcx-fields">
                    <div class="dcx-field">
                      <label class="dcx-label">{{ entry_information }} <span data-toggle="tooltip" title="{{ help_information }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                      <div class="dcx-checkbox-group">
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_information" value="1" {% if dockercart_sitemap_information %}checked="checked"{% endif %} /> {{ text_enabled }}
                        </label>
                        <label class="dcx-checkbox-label">
                          <input type="radio" name="dockercart_sitemap_information" value="0" {% if not dockercart_sitemap_information %}checked="checked"{% endif %} /> {{ text_disabled }}
                        </label>
                      </div>
                    </div>
                    <div class="dcx-fields dcx-fields--row">
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_information_priority }} <span data-toggle="tooltip" title="{{ help_priority }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="dockercart_sitemap_information_priority" value="{{ dockercart_sitemap_information_priority }}" placeholder="0.5" class="form-control" />
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_information_changefreq }} <span data-toggle="tooltip" title="{{ help_changefreq }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <select name="dockercart_sitemap_information_changefreq" class="form-control">
                          {% for value, text in changefreq_options %}
                            {% if value == dockercart_sitemap_information_changefreq %}
                              <option value="{{ value }}" selected="selected">{{ text }}</option>
                            {% else %}
                              <option value="{{ value }}">{{ text }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-shell">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="gauge" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_section_limits }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label">{{ entry_max_urls }} <span data-toggle="tooltip" title="{{ help_max_urls }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <input type="text" name="dockercart_sitemap_max_urls" value="{{ dockercart_sitemap_max_urls }}" placeholder="50000" class="form-control" />
                <p class="help-block">{{ help_max_urls }}</p>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label">{{ entry_max_file_size_mb }} <span data-toggle="tooltip" title="{{ help_max_file_size_mb }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <input type="text" name="dockercart_sitemap_max_file_size_mb" value="{{ dockercart_sitemap_max_file_size_mb }}" placeholder="50" class="form-control" />
                <p class="help-block">{{ help_max_file_size_mb }}</p>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__checkbox">
                  <input type="hidden" name="dockercart_sitemap_create_gzip" value="0" />
                  <input type="checkbox" name="dockercart_sitemap_create_gzip" value="1" {% if dockercart_sitemap_create_gzip %}checked="checked"{% endif %} />
                  <span>{{ entry_create_gzip }}</span>
                  <span data-toggle="tooltip" title="{{ help_create_gzip }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<script>
/* <![CDATA[ */
(() => {
  const url = '{{ generate_ajax }}';
  const btn = document.getElementById('button-generate');
  if (!btn) return;

  const container = document.querySelector('.container-fluid');
  const lastGeneratedEl = document.getElementById('sitemap-last-generated');
  const fileCountEl = document.getElementById('sitemap-file-count');

  const createAlert = (type, message) => {
    const safe = message || '';
    return `<div class="alert alert-${type} alert-dismissible"><i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" width="16" height="16"></i> ${safe}<button type="button" class="close" data-dismiss="alert">&times;</button></div>`;
  };

  const setBusy = (isBusy) => {
    btn.disabled = isBusy;
    btn.style.opacity = isBusy ? '0.6' : '1';
  };

  btn.addEventListener('click', async (ev) => {
    ev.preventDefault();
    setBusy(true);

    try {
      const resp = await fetch(url.replace(/&amp;/g, '&'), {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        }
      });

      if (!resp.ok) {
        const text = await resp.text();
        const html = createAlert('danger', `Server returned ${resp.status}: ${text}`);
        if (container) container.insertAdjacentHTML('afterbegin', html);
        lucide.createIcons();
        return;
      }

      const json = await resp.json();

      if (json.error) {
        if (container) container.insertAdjacentHTML('afterbegin', createAlert('danger', json.error));
        lucide.createIcons();
      } else if (json.success) {
        if (container) container.insertAdjacentHTML('afterbegin', createAlert('success', json.success));
        lucide.createIcons();
        if (json.last_generated && lastGeneratedEl) lastGeneratedEl.textContent = json.last_generated;
        if (typeof json.file_count !== 'undefined' && fileCountEl) fileCountEl.textContent = json.file_count;
      }
    } catch (err) {
      if (container) container.insertAdjacentHTML('afterbegin', createAlert('danger', 'Unexpected error while generating sitemap.'));
      lucide.createIcons();
      console.error('Sitemap generation error', err);
    } finally {
      setBusy(false);
    }
  });
})();
/* ]]> */
</script>
{{ footer }}
