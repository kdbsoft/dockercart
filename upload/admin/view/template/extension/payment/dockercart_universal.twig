{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if payment_dockercart_universal_status is defined %}
              <span class="page-header__badge {{ payment_dockercart_universal_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ payment_dockercart_universal_status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-payment" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment">
      <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="credit-card" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ heading_title }}</div>
                  <div class="dcx-panel-subtitle">{{ text_module_description }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-stats">
                  <div class="dcx-stat">
                    <div class="dcx-stat__value">{{ payment_methods|length }}</div>
                    <div class="dcx-stat__label">{{ text_total_methods }}</div>
                  </div>
                  <div class="dcx-stat">
                    <div class="dcx-stat__value dcx-stat__value--success">{{ payment_methods|filter(m => m.status == 1)|length }}</div>
                    <div class="dcx-stat__label">{{ text_active_methods }}</div>
                  </div>
                  <div class="dcx-stat">
                    <div class="dcx-stat__value">{{ geo_zones|length }}</div>
                    <div class="dcx-stat__label">{{ text_geo_zones }}</div>
                  </div>
                </div>
                <div class="dcx-panel-section">
                  <div class="dcx-panel-section__head">
                    <h4><i data-lucide="list" width="16" height="16"></i> {{ tab_methods }}</h4>
                    <a href="{{ add }}" class="btn btn-primary btn-xs"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_method }}</a>
                  </div>
                  {% if payment_methods %}
                  <div class="dc-shipping-list">
                    {% for method in payment_methods %}
                    <div class="dc-shipping-item" id="method-row-{{ method.method_id }}">
                      <div class="dc-shipping-item__icon">
                        <i data-lucide="credit-card" width="16" height="16"></i>
                      </div>
                      <div class="dc-shipping-item__body">
                        <div class="dc-shipping-item__name">
                          {{ method.name ? method.name : text_unnamed }}
                          {% if method.status %}
                          <span class="label label-success">{{ text_enabled }}</span>
                          {% else %}
                          <span class="label label-danger">{{ text_disabled }}</span>
                          {% endif %}
                        </div>
                        <div class="dc-shipping-item__meta">
                          <span><i data-lucide="map-pin" width="12" height="12"></i>
                            {% for geo_zone in geo_zones %}
                              {% if geo_zone.geo_zone_id == method.geo_zone_id %}{{ geo_zone.name }}{% endif %}
                            {% else %}{{ text_all_zones }}{% endfor %}
                          </span>
                          <span><i data-lucide="arrow-down-up" width="12" height="12"></i> {{ method.sort_order }}</span>
                        </div>
                        {% if method.description %}
                        <div class="dc-shipping-item__desc">{{ method.description|slice(0, 100) }}{% if method.description|length > 100 %}...{% endif %}</div>
                        {% endif %}
                      </div>
                      <div class="dc-shipping-item__actions">
                        <a href="{{ method.edit }}" class="btn btn-info btn-xs btn--icon" data-toggle="tooltip" title="{{ button_edit }}"><i data-lucide="pencil" width="12" height="12"></i></a>
                        <button type="button" class="btn btn-danger btn-xs btn--icon btn-delete" data-method-id="{{ method.method_id }}" data-toggle="tooltip" title="{{ button_delete }}"><i data-lucide="trash-2" width="12" height="12"></i></button>
                      </div>
                    </div>
                    {% endfor %}
                  </div>
                  {% else %}
                  <div class="dc-shipping-empty">
                    <i data-lucide="credit-card" width="48" height="48"></i>
                    <p>{{ text_no_methods }}</p>
                    <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_method }}</a>
                  </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="settings" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_general_settings }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
                <select name="payment_dockercart_universal_status" id="input-status" class="form-control">
                  {% if payment_dockercart_universal_status %}
                  <option value="1" selected>{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected>{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-order-status">{{ entry_order_status }}</label>
                <select name="payment_dockercart_universal_order_status_id" id="input-order-status" class="form-control">
                  {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_dockercart_universal_order_status_id %}selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
                <div class="help-block">{{ help_order_status }}</div>
              </div>
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-sort-order">{{ entry_sort_order }}</label>
                <input type="text" name="payment_dockercart_universal_sort_order" value="{{ payment_dockercart_universal_sort_order }}" id="input-sort-order" class="form-control" style="max-width:100px;" />
                <div class="help-block">{{ help_sort_order }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script>
$(function() {
  $('.btn-delete').on('click', function() {
    var methodId = $(this).data('method-id');
    if (confirm('{{ text_confirm_delete }}')) {
      $.ajax({
        url: 'index.php?route=extension/payment/dockercart_universal/delete&user_token={{ user_token }}',
        type: 'POST',
        dataType: 'json',
        data: { method_id: methodId },
        success: function(json) {
          if (json.success) {
            $('#method-row-' + methodId).fadeOut(300, function() { $(this).remove(); });
          } else if (json.error) {
            alert(json.error);
          }
        },
        error: function() { alert('{{ error_ajax }}'); }
      });
    }
  });
});
</script>
<style>
.dcx-stats { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
.dcx-stat {
  flex: 1;
  min-width: 110px;
  padding: 14px 16px;
  border: 1px solid var(--dc-border-soft);
  border-radius: var(--dc-radius-lg);
  background: var(--dc-surface);
}
.dcx-stat__value { font-size: 24px; font-weight: 700; color: var(--dc-text-dark); line-height: 1.1; }
.dcx-stat__value--success { color: var(--dc-green-600); }
.dcx-stat__label { font-size: 12px; color: var(--dc-text-muted); margin-top: 4px; }
.dcx-panel-section { margin-top: 4px; }
.dcx-panel-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.dcx-panel-section__head h4 {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--dc-text-dark);
  display: flex;
  align-items: center;
  gap: 6px;
}
.dc-shipping-list { display: flex; flex-direction: column; gap: 8px; }
.dc-shipping-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--dc-border-soft);
  border-radius: var(--dc-radius-lg);
  background: var(--dc-surface);
  transition: border-color .15s;
}
.dc-shipping-item:hover { border-color: var(--dc-border); }
.dc-shipping-item__icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: var(--dc-radius-md);
  background: var(--dc-gray-100);
  color: var(--dc-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-shipping-item__body { flex: 1; min-width: 0; }
.dc-shipping-item__name { font-size: 14px; font-weight: 600; color: var(--dc-text-dark); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.dc-shipping-item__meta { display: flex; align-items: center; gap: 12px; margin-top: 4px; font-size: 12px; color: var(--dc-text-muted); flex-wrap: wrap; }
.dc-shipping-item__meta span { display: inline-flex; align-items: center; gap: 4px; }
.dc-shipping-item__desc { font-size: 12px; color: var(--dc-text-muted); margin-top: 4px; }
.dc-shipping-item__actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.dc-shipping-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 32px 16px;
  color: var(--dc-text-muted);
  text-align: center;
}
.dc-shipping-empty p { margin: 0; font-size: 13px; }
.dc-shipping-item__actions .btn-xs.btn--icon {
  padding: 4px;
  min-width: 26px;
  min-height: 24px;
}
.dc-shipping-item__actions .btn-xs.btn--icon i,
.dc-shipping-item__actions .btn-xs.btn--icon svg {
  width: 12px;
  height: 12px;
}
</style>
{{ footer }}
