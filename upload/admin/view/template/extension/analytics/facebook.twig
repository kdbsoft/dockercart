{{ header }}{{ column_left }}
<div id="content">
  <div class="container-fluid">
  <div class="page-header">


      <div class="row">
        <div class="col-lg-8 col-xl-offset-1 col-xl-7">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              {% if analytics_facebook_status is defined %}
              <span class="page-header__badge {{ analytics_facebook_status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                {{ analytics_facebook_status ? text_active : text_inactive }}
              </span>
              {% endif %}
            </span>
          </a>
        </div>
        <div class="col-lg-4 col-xl-3">
          <div class="pull-right">
            <button type="submit" form="form-analytics" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
  </div>
</div>
<div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-analytics">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="pencil" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_edit }}</div>
                <div class="dcx-panel-subtitle">{{ text_edit_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
                <div class="alert alert-info"><i data-lucide="info" width="16" height="16"></i> {{ text_signup }}
                  <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-code">{{ entry_code }}</label>
                    <textarea name="analytics_facebook_code" rows="5" placeholder="{{ entry_code }}" id="input-code" class="form-control">{{ analytics_facebook_code }}</textarea>
                    {% if error_code %}
                    <div class="text-danger">{{ error_code }}</div>
                    {% endif %}
                  </div>
                </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-shell">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="power" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
                <select name="analytics_facebook_status" id="input-status" class="form-control">
                  {% if analytics_facebook_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
{{ footer }}
