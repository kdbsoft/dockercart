{{ header }}
{{ column_left }}
<div id="content">
  <div class="container-fluid">
    <div class="page-header">

      <div class="row">
        <div class="col-sm-12">
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
        </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i data-lucide="filter" width="16" height="16"></i> {{ text_filter }}</h3>
      </div>
      <div class="panel-body">
        <div class="row">
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="input-date-start">{{ entry_date_start }}</label>
              <input type="date" value="{{ filter_date_start }}" id="input-date-start" class="form-control" />
            </div>
          </div>
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label" for="input-date-end">{{ entry_date_end }}</label>
              <input type="date" value="{{ filter_date_end }}" id="input-date-end" class="form-control" />
            </div>
          </div>
          <div class="col-sm-4">
            <div class="form-group">
              <label class="control-label">&nbsp;</label>
              <button type="button" id="button-filter" class="btn btn-primary btn-block"><i data-lucide="search" width="16" height="16"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row" style="margin-bottom:20px">
      <div class="col-sm-3">
        <div class="panel panel-default">
          <div class="panel-body text-center">
            <div style="font-size:28px;font-weight:700">{{ total_started }}</div>
            <div class="text-muted">{{ text_started }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-default">
          <div class="panel-body text-center">
            <div style="font-size:28px;font-weight:700">{{ conversion_rate }}%</div>
            <div class="text-muted">{{ text_conversion }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-default">
          <div class="panel-body text-center">
            <div style="font-size:28px;font-weight:700">{{ avg_checkout_time }} <small style="font-size:14px">s</small></div>
            <div class="text-muted">{{ text_avg_time }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-default">
          <div class="panel-body text-center">
            <div style="font-size:28px;font-weight:700">{{ top_drop_rate }}%</div>
            <div class="text-muted">{{ text_top_drop }}: {{ top_drop_step }}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i data-lucide="chart-column" width="16" height="16"></i> {{ text_funnel }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover dcx-table">
            <thead>
              <tr>
                <td class="text-left">{{ column_step }}</td>
                <td class="text-right">{{ column_sessions }}</td>
                <td class="text-right">{{ column_drop }}</td>
              </tr>
            </thead>
            <tbody>
              {% for row in funnel %}
              <tr>
                <td class="text-left">{{ row.name }}</td>
                <td class="text-right">{{ row.count }}</td>
                <td class="text-right">
                  {% if row.drop_rate is not null %}
                  <span class="label {% if row.drop_rate > 0 %}label-danger{% else %}label-success{% endif %}">{{ row.drop_rate }}%</span>
                  {% else %}
                  <span class="text-muted">—</span>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <div class="text-muted" style="margin-top:10px">{{ text_abandoned_period }}: <b>{{ abandoned_total }}</b></div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript">
$('#button-filter').on('click', function() {
  var url = '{{ filter_url }}';

  var filter_date_start = $('#input-date-start').val();
  var filter_date_end = $('#input-date-end').val();

  if (filter_date_start) {
    url += '&filter_date_start=' + encodeURIComponent(filter_date_start);
  }
  if (filter_date_end) {
    url += '&filter_date_end=' + encodeURIComponent(filter_date_end);
  }

  location = url;
});
</script>
{{ footer }}
