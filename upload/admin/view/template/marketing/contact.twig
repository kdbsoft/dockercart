{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="pull-right">
            <button type="button" id="button-send" data-loading-text="{{ text_loading }}" data-toggle="tooltip" title="{{ button_send }}" class="btn btn-primary btn--icon" onclick="send('index.php?route=marketing/contact/send&user_token={{ user_token }}');"><i data-lucide="send" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ heading_title }}
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="mail" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_mail_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-store">{{ entry_store }}</label>
                    <select name="store_id" id="input-store" class="form-control">
                      <option value="0">{{ text_default }}</option>
                      {% for store in stores %}
                      <option value="{{ store.store_id }}">{{ store.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-to">{{ entry_to }}</label>
                    <select name="to" id="input-to" class="form-control">
                      <option value="newsletter">{{ text_newsletter }}</option>
                      <option value="customer_all">{{ text_customer_all }}</option>
                      <option value="customer_group">{{ text_customer_group }}</option>
                      <option value="customer">{{ text_customer }}</option>
                      <option value="affiliate_all">{{ text_affiliate_all }}</option>
                      <option value="affiliate">{{ text_affiliate }}</option>
                      <option value="product">{{ text_product }}</option>
                    </select>
                  </div>
                </div>
                <div class="dcx-field to" id="to-customer-group">
                  <label class="dcx-label" for="input-customer-group">{{ entry_customer_group }}</label>
                  <select name="customer_group_id" id="input-customer-group" class="form-control">
                    {% for customer_group in customer_groups %}
                    <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="dcx-field to" id="to-customer">
                  <label class="dcx-label" for="input-customer">
                    <span data-toggle="tooltip" title="{{ help_customer }}">{{ entry_customer }}</span>
                  </label>
                  <input type="text" name="customers" value="" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
                  <div class="dcx-picker__well" style="display:none;"></div>
                </div>
                <div class="dcx-field to" id="to-affiliate">
                  <label class="dcx-label" for="input-affiliate">
                    <span data-toggle="tooltip" title="{{ help_affiliate }}">{{ entry_affiliate }}</span>
                  </label>
                  <input type="text" name="affiliates" value="" placeholder="{{ entry_affiliate }}" id="input-affiliate" class="form-control" />
                  <div class="dcx-picker__well" style="display:none;"></div>
                </div>
                <div class="dcx-field to" id="to-product">
                  <label class="dcx-label" for="input-product">
                    <span data-toggle="tooltip" title="{{ help_product }}">{{ entry_product }}</span>
                  </label>
                  <input type="text" name="products" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                  <div class="dcx-picker__well" style="display:none;"></div>
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-subject">{{ entry_subject }}</label>
                  <input type="text" name="subject" value="" placeholder="{{ entry_subject }}" id="input-subject" class="form-control" />
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-message">{{ entry_message }}</label>
                  <textarea name="message" placeholder="{{ entry_message }}" id="input-message" data-toggle="tinymce" class="form-control"></textarea>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript" src="view/javascript/tinymce/dc.js"></script>
  <script type="text/javascript"><!--
$('select[name=\'to\']').on('change', function() {
  $('.to').hide();
  $('#to-' + this.value.replace('_', '-')).show();
});
$('select[name=\'to\']').trigger('change');
//--></script>
  <script type="text/javascript"><!--
$('input[name=\'customers\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=customer/customer/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return { label: item['name'], value: item['customer_id'] }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'customers\']').val('');
    $('#customer' + item['value']).remove();
    var $well = $('#input-customer').parent().find('.dcx-picker__well');
    $well.show().append('<div class="dcx-picker__well-item" id="customer' + item['value'] + '"><i data-lucide="minus-circle" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">' + item['label'] + '</span><input type="hidden" name="customer[]" value="' + item['value'] + '" /></div>');
    lucide.createIcons();
  }
});
$('#input-customer').parent().find('.dcx-picker__well').delegate('.dcx-picker__well-remove', 'click', function() {
  $(this).parent().remove();
  var $well = $(this).closest('.dcx-picker__well');
  if (!$well.find('.dcx-picker__well-item').length) $well.hide();
});

$('input[name=\'affiliates\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=customer/customer/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request) + '&filter_affiliate=1',
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return { label: item['name'], value: item['customer_id'] }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'affiliates\']').val('');
    $('#affiliate' + item['value']).remove();
    var $well = $('#input-affiliate').parent().find('.dcx-picker__well');
    $well.show().append('<div class="dcx-picker__well-item" id="affiliate' + item['value'] + '"><i data-lucide="minus-circle" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">' + item['label'] + '</span><input type="hidden" name="affiliate[]" value="' + item['value'] + '" /></div>');
    lucide.createIcons();
  }
});
$('#input-affiliate').parent().find('.dcx-picker__well').delegate('.dcx-picker__well-remove', 'click', function() {
  $(this).parent().remove();
  var $well = $(this).closest('.dcx-picker__well');
  if (!$well.find('.dcx-picker__well-item').length) $well.hide();
});

$('input[name=\'products\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return { label: item['name'], value: item['product_id'] }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'products\']').val('');
    $('#product' + item['value']).remove();
    var $well = $('#input-product').parent().find('.dcx-picker__well');
    $well.show().append('<div class="dcx-picker__well-item" id="product' + item['value'] + '"><i data-lucide="minus-circle" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">' + item['label'] + '</span><input type="hidden" name="product[]" value="' + item['value'] + '" /></div>');
    lucide.createIcons();
  }
});
$('#input-product').parent().find('.dcx-picker__well').delegate('.dcx-picker__well-remove', 'click', function() {
  $(this).parent().remove();
  var $well = $(this).closest('.dcx-picker__well');
  if (!$well.find('.dcx-picker__well-item').length) $well.hide();
});

function send(url) {
  $.ajax({
    url: url,
    type: 'post',
    data: $('#content select, #content input, #content textarea'),
    dataType: 'json',
    beforeSend: function() {
      $('#button-send').prop('disabled', true);
      $('#button-send i').replaceWith('<i data-lucide="loader" width="16" height="16" class="lucide-spin"></i>');
      lucide.createIcons({ nodes: [document.getElementById('button-send')] });
    },
    success: function(json) {
      $('.alert-dismissible, .text-danger').remove();

      if (json['error']) {
        if (json['error']['warning']) {
          $('#content > .container-fluid').first().prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> ' + json['error']['warning'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
          lucide.createIcons();
        }
        if (json['error']['email']) {
          $('#content > .container-fluid').first().prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> ' + json['error']['email'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
          lucide.createIcons();
        }
        if (json['error']['subject']) {
          $('input[name=\'subject\']').after('<div class="text-danger">' + json['error']['subject'] + '</div>');
        }
        if (json['error']['message']) {
          $('textarea[name=\'message\']').parent().append('<div class="text-danger">' + json['error']['message'] + '</div>');
        }
      }

      if (json['success']) {
        $('#content > .container-fluid').first().prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="check-circle" width="16" height="16"></i> ' + json['success'] + '</div>');
        lucide.createIcons();
      }

      if (json['next']) {
        send(json['next']);
      } else {
        $('#button-send').prop('disabled', false);
        $('#button-send i').replaceWith('<i data-lucide="send" width="16" height="16"></i>');
        lucide.createIcons({ nodes: [document.getElementById('button-send')] });
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
}
//--></script>
</div>
{{ footer }}
