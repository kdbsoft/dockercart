{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-coupon" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if coupon_id %}
                {{ coupon_name }}
              {% else %}
                {{ text_add }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-coupon">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          {# ── COUPON PANEL ── #}
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="ticket" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_coupon_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_name }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>
                    <input type="text" name="coupon[{{ language.language_id }}][name]" value="{{ coupon[language.language_id] ? coupon[language.language_id].name }}" placeholder="{{ entry_name }}" class="form-control" />
                  </div>
                  {% if error_name[language.language_id] %}
                  <div class="text-danger">{{ error_name[language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-code">
                    <span data-toggle="tooltip" title="{{ help_code }}">{{ entry_code }}</span>
                  </label>
                  <input type="text" name="code" value="{{ code }}" placeholder="{{ entry_code }}" id="input-code" class="form-control" />
                  {% if error_code %}<div class="text-danger">{{ error_code }}</div>{% endif %}
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-type">
                      <span data-toggle="tooltip" title="{{ help_type }}">{{ entry_type }}</span>
                    </label>
                    <select name="type" id="input-type" class="form-control">
                      {% if type == 'P' %}
                      <option value="P" selected="selected">{{ text_percent }}</option>
                      {% else %}
                      <option value="P">{{ text_percent }}</option>
                      {% endif %}
                      {% if type == 'F' %}
                      <option value="F" selected="selected">{{ text_amount }}</option>
                      {% else %}
                      <option value="F">{{ text_amount }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-discount">{{ entry_discount }}</label>
                    <input type="text" name="discount" value="{{ discount }}" placeholder="{{ entry_discount }}" id="input-discount" class="form-control" />
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-total">
                    <span data-toggle="tooltip" title="{{ help_total }}">{{ entry_total }}</span>
                  </label>
                  <input type="text" name="total" value="{{ total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control" />
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-date-start">{{ entry_date_start }}</label>
                    <div class="input-group date">
                      <input type="text" name="date_start" value="{{ date_start }}" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" id="input-date-start" class="form-control" />
                      <span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span>
                    </div>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-date-end">{{ entry_date_end }}</label>
                    <div class="input-group date">
                      <input type="text" name="date_end" value="{{ date_end }}" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" id="input-date-end" class="form-control" />
                      <span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span>
                    </div>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-product">
                    <span data-toggle="tooltip" title="{{ help_product }}">{{ entry_product }}</span>
                  </label>
                  <input type="text" name="product" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                  {% if coupon_product %}
                  <div id="coupon-product" class="dcx-picker__well">{% for coupon_product in coupon_product %}
                    <div class="dcx-picker__well-item" id="coupon-product{{ coupon_product.product_id }}"><i data-lucide="circle-minus" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">{{ coupon_product.name }}</span>
                      <input type="hidden" name="coupon_product[]" value="{{ coupon_product.product_id }}" />
                    </div>
                    {% endfor %}</div>
                  {% else %}
                  <div id="coupon-product" class="dcx-picker__well" style="display:none;"></div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">
                    <span data-toggle="tooltip" title="{{ help_category }}">{{ entry_category }}</span>
                  </label>
                  <button type="button" class="btn btn-default btn-sm btn-block" id="btn-open-category-modal">
                    <i data-lucide="folder-tree" width="14" height="14"></i>
                    <span id="coupon-category-count">{% if coupon_category|length > 0 %}{{ coupon_category|length }} {{ text_select_categories|lower }}{% else %}{{ text_select_categories }}{% endif %}</span>
                  </button>
                  {% if coupon_category %}
                  <div id="coupon-category" class="dcx-tree-select__well">{% for coupon_category in coupon_category %}
                    <div class="dcx-tree-select__well-item" data-id="{{ coupon_category.category_id }}"><i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i> <span class="dcx-tree-select__well-label">{{ coupon_category.name }}</span>
                      <input type="hidden" name="coupon_category[]" value="{{ coupon_category.category_id }}" />
                    </div>
                    {% endfor %}</div>
                  {% else %}
                  <div id="coupon-category" class="dcx-tree-select__well" style="display:none;"></div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          {# ── HISTORY PANEL ── #}
          {% if coupon_id %}
          <div class="dcx-panel" style="margin-top:16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="clock" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_history_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div id="history"></div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
      {# ── SIDEBAR ── #}
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="sliders-horizontal" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_parameters_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <div class="dcx-checkbox-group">
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="logged" value="1" {% if logged %}checked="checked"{% endif %} /> {{ entry_logged }}
                  <span data-toggle="tooltip" title="{{ help_logged }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="shipping" value="1" {% if shipping %}checked="checked"{% endif %} /> {{ entry_shipping }}
                </label>
                <label class="dcx-checkbox-label">
                  <input type="checkbox" name="auto_renew" value="1" {% if auto_renew %}checked="checked"{% endif %} /> {{ entry_auto_renew }}
                  <span data-toggle="tooltip" title="{{ help_auto_renew }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </label>
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-uses-total">
                <span data-toggle="tooltip" title="{{ help_uses_total }}">{{ entry_uses_total }}</span>
              </label>
              <input type="text" name="uses_total" value="{{ uses_total }}" placeholder="{{ entry_uses_total }}" id="input-uses-total" class="form-control" />
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-uses-customer">
                <span data-toggle="tooltip" title="{{ help_uses_customer }}">{{ entry_uses_customer }}</span>
              </label>
              <input type="text" name="uses_customer" value="{{ uses_customer }}" placeholder="{{ entry_uses_customer }}" id="input-uses-customer" class="form-control" />
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  {# ── CATEGORY TREE MODAL ── #}
  <div id="category-tree-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title"><i data-lucide="folder-tree" width="18" height="18" style="margin-right:8px;"></i>{{ entry_category }}</h4>
        </div>
        <div class="modal-body">
          <div id="coupon-category-tree" class="dcx-tree-select"
               data-url="index.php?route=catalog/category/tree&user_token={{ user_token }}"
               data-mode="multi"
               data-none-text="{{ text_none }}"
               data-placeholder="{{ text_quick_find }}">
            <div class="dcx-tree-select__search">
              <input type="text" class="form-control" placeholder="{{ text_quick_find }}" id="coupon-category-tree-search" />
              <i data-lucide="search" width="14" height="14"></i>
            </div>
            <div class="dcx-tree-select__list" style="max-height:400px;overflow-y:auto;"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
          <button type="button" class="btn btn-primary" id="coupon-category-confirm"><i data-lucide="check" width="14" height="14"></i> {{ button_continue }}</button>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('input[name=\'product\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return { label: item['name'], value: item['product_id'] }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'product\']').val('');
    $('#coupon-product' + item['value']).remove();
    $('#coupon-product').show().append('<div class="dcx-picker__well-item" id="coupon-product' + item['value'] + '"><i data-lucide="circle-minus" width="14" height="14" class="dcx-picker__well-remove"></i> <span class="dcx-picker__well-label">' + item['label'] + '</span><input type="hidden" name="coupon_product[]" value="' + item['value'] + '" /></div>');
    lucide.createIcons();
  }
});
$('#coupon-product').delegate('.dcx-picker__well-remove', 'click', function() {
  $(this).parent().remove();
  if (!$('#coupon-product .dcx-picker__well-item').length) $('#coupon-product').hide();
});

var categoryTreeInstance = null;

$('#btn-open-category-modal').on('click', function() {
  var $tree = $('#coupon-category-tree');
  categoryTreeInstance = $tree.data('dcx-tree-select');
  if (!categoryTreeInstance) {
    DcxTreeSelect.init('#coupon-category-tree');
    categoryTreeInstance = $tree.data('dcx-tree-select');
  }
  var currentIds = [];
  $('#coupon-category .dcx-tree-select__well-item').each(function() {
    currentIds.push($(this).data('id'));
  });
  categoryTreeInstance.setSelected(currentIds);
  $('#category-tree-modal').modal('show');
});

$('#coupon-category-confirm').on('click', function() {
  if (!categoryTreeInstance) {
    $('#category-tree-modal').modal('hide');
    return;
  }
  var ids = categoryTreeInstance.getSelectedIds();
  var $well = $('#coupon-category');
  $well.empty();
  var allItems = categoryTreeInstance.cache || [];
  for (var i = 0; i < ids.length; i++) {
    for (var j = 0; j < allItems.length; j++) {
      if (String(allItems[j].category_id) === String(ids[i])) {
        var name = allItems[j].path || allItems[j].name;
        $well.append('<div class="dcx-tree-select__well-item" data-id="' + ids[i] + '"><i data-lucide="circle-minus" width="14" height="14" class="dcx-tree-select__well-remove"></i> <span class="dcx-tree-select__well-label">' + name + '</span><input type="hidden" name="coupon_category[]" value="' + ids[i] + '"/></div>');
        break;
      }
    }
  }
  $well.toggle(ids.length > 0);
  $('#coupon-category-count').text(ids.length > 0 ? ids.length + ' {{ text_select_categories|lower }}' : '{{ text_select_categories }}');
  lucide.createIcons();
  categoryTreeInstance.close();
  $('#category-tree-modal').modal('hide');
});

$('#category-tree-modal').on('hidden.bs.modal', function() {
  if (categoryTreeInstance) categoryTreeInstance.close();
});

$(document).on('click', '#coupon-category .dcx-tree-select__well-remove', function() {
  $(this).closest('.dcx-tree-select__well-item').remove();
  var count = $('#coupon-category .dcx-tree-select__well-item').length;
  $('#coupon-category-count').text(count > 0 ? count + ' {{ text_select_categories|lower }}' : '{{ text_select_categories }}');
  $('#coupon-category').toggle(count > 0);
});
//--></script>
  {% if coupon_id %}
  <script type="text/javascript"><!--
$('#history').delegate('.pagination a', 'click', function(e) {
  e.preventDefault();
  $('#history').load(this.href, function() {
    lucide.createIcons({ nodes: document.getElementById('history') });
  });
});
$('#history').load('index.php?route=marketing/coupon/history&user_token={{ user_token }}&coupon_id={{ coupon_id }}', function() {
  lucide.createIcons({ nodes: document.getElementById('history') });
});
//--></script>
  {% endif %}
  <script type="text/javascript"><!--
$('.date').datetimepicker({ language: '{{ datepicker }}', pickTime: false });
//--></script>
</div>
{{ footer }}
