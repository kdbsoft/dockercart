{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="pull-right">
            <button type="submit" form="form-marketing" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if marketing_id %}
                {{ marketing_name }}
              {% else %}
                {{ text_add }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-marketing">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-2 col-xl-8">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="megaphone" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_campaign_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-name">{{ entry_name }}</label>
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-description">{{ entry_description }}</label>
                  <textarea name="description" rows="5" placeholder="{{ entry_description }}" id="input-description" class="form-control">{{ description }}</textarea>
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-code">
                    <span data-toggle="tooltip" title="{{ help_code }}">{{ entry_code }}</span>
                  </label>
                  <input type="text" name="code" value="{{ code }}" placeholder="{{ entry_code }}" id="input-code" class="form-control" />
                  {% if error_code %}
                  <div class="text-danger">{{ error_code }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label">
                    <span data-toggle="tooltip" title="{{ help_example }}">{{ entry_example }}</span>
                  </label>
                  <input type="text" placeholder="{{ entry_example }}" id="input-example1" class="form-control" readonly />
                  <input type="text" placeholder="{{ entry_example }}" id="input-example2" class="form-control" style="margin-top:8px;" readonly />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('#input-code').on('keyup', function() {
  $('#input-example1').val('{{ store }}?tracking=' + $('#input-code').val());
  $('#input-example2').val('{{ store }}index.php?route=common/home&tracking=' + $('#input-code').val());
});
$('#input-code').trigger('keyup');
//--></script>
</div>
{{ footer }}
