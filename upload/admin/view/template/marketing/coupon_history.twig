{% if histories %}
<div class="coupon-history-list">
  {% for history in histories %}
  <div class="coupon-history-entry">
    <div class="coupon-history-entry__icon">
      <i data-lucide="shopping-bag" width="16" height="16"></i>
    </div>
    <div class="coupon-history-entry__info">
      <div class="coupon-history-entry__title">
        {{ column_order_id }} #{{ history.order_id }} &mdash; {{ history.customer }}
      </div>
      <div class="coupon-history-entry__meta">
        {{ history.amount }} &middot; {{ history.date_added }}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
<div class="row">
  <div class="col-sm-6 text-left">{{ pagination }}</div>
  <div class="col-sm-6 text-right">{{ results }}</div>
</div>
{% else %}
<div class="coupon-history-empty">
  <i data-lucide="inbox" width="32" height="32"></i>
  <p>{{ text_no_results }}</p>
</div>
{% endif %}
