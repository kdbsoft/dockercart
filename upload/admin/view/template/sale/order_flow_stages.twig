{# Order flow stepper — horizontal bar rendered under the page header.
   Expects: flow_enabled, flow_steps, flow_transitions, flow_terminal #}
<div class="order-flow-bar">
  <div class="order-flow-steps">
    {% for step in flow_steps %}
    <div class="of-step of-step--{{ step.state }}">
      <span class="of-step__dot"><i data-lucide="{{ step.state == 'done' ? 'check' : (step.state == 'current' ? 'circle-dot' : '') }}" width="10" height="10"></i></span>
      <span class="of-step__name">{{ step.name }}</span>
    </div>
    {% if not loop.last %}<span class="of-step__connector"></span>{% endif %}
    {% endfor %}
  </div>
  {% if flow_terminal %}
  <div class="order-flow-bar__terminal">
    <i data-lucide="flag" width="13" height="13"></i> {{ text_flow_terminal_state }}
  </div>
  {% endif %}
  {% if flow_transitions %}
  <div class="order-flow-bar__actions">
    {% for transition in flow_transitions %}
    <button type="button" class="btn btn-xs btn--icon {{ transition.terminal ? 'btn-danger' : 'btn-primary' }}" onclick="openFlowTransition({{ transition.order_status_id }}, '{{ transition.name|escape('js') }}', {{ transition.terminal ? 'true' : 'false' }})">
      {{ transition.name }}
    </button>
    {% endfor %}
  </div>
  {% endif %}
</div>
