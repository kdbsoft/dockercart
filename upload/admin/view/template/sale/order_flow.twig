{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="pull-right">
            <button type="submit" form="form-order-flow" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" id="form-order-flow">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-7 col-xl-offset-2 col-xl-7">
        <div class="dcx-shell">

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="workflow" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_flow_steps }}</div>
                <div class="dcx-panel-subtitle">{{ text_flow_steps_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label" for="flow-shipping-status">{{ text_flow_shipping_status }}</label>
                  <select class="form-control" id="flow-shipping-status" name="shipping_status_id" style="max-width:420px">
                    <option value="0">{{ text_none }}</option>
                    {% for status in order_statuses %}
                    <option value="{{ status.order_status_id }}" {% if status.order_status_id == shipping_status_id %}selected{% endif %}>{{ status.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="text-muted" style="font-size:12px;margin-top:4px">{{ text_flow_shipping_status_hint }}</div>
                </div>
              </div>
              <div id="flow-steps">
                {% for step in steps %}
                <div class="flow-step-row" data-status-id="{{ step.order_status_id }}">
                  <input type="hidden" name="step[]" value="{{ step.order_status_id }}" />
                  <button type="button" class="btn btn-default btn-xs btn--icon flow-step-btn" onclick="moveStep(this, -1)" data-toggle="tooltip" title="{{ button_flow_move_up }}"><i data-lucide="chevron-up" width="13" height="13"></i></button>
                  <button type="button" class="btn btn-default btn-xs btn--icon flow-step-btn" onclick="moveStep(this, 1)" data-toggle="tooltip" title="{{ button_flow_move_down }}"><i data-lucide="chevron-down" width="13" height="13"></i></button>
                  <span class="flow-step-name">{{ step.name }}</span>
                  <button type="button" class="btn btn-danger btn-xs btn--icon flow-step-btn" onclick="removeStepRow(this)" data-toggle="tooltip" title="{{ button_flow_remove }}"><i data-lucide="trash-2" width="13" height="13"></i></button>
                </div>
                {% endfor %}
              </div>
              <div class="flow-step-add">
                <select id="flow-new-step" class="form-control">
                  {% for status in available_statuses %}
                  <option value="{{ status.order_status_id }}">{{ status.name }}</option>
                  {% endfor %}
                </select>
                <button type="button" class="btn btn-primary btn-sm" onclick="addStepRow()"><i data-lucide="plus" width="14" height="14"></i> {{ button_flow_add_step }}</button>
              </div>
            </div>
          </div>

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="git-branch" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_flow_transitions }}</div>
                <div class="dcx-panel-subtitle">{{ text_flow_transitions_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div id="flow-transitions">
                {% for transition in transitions %}
                <div class="flow-transition-row">
                  <select name="transition_from[]" class="form-control">
                    {% for status in order_statuses %}
                    <option value="{{ status.order_status_id }}" {% if status.order_status_id == transition.from %}selected{% endif %}>{{ status.name }}</option>
                    {% endfor %}
                  </select>
                  <span class="flow-transition-arrow"><i data-lucide="arrow-right" width="14" height="14"></i></span>
                  <select name="transition_to[]" class="form-control">
                    {% for status in order_statuses %}
                    <option value="{{ status.order_status_id }}" {% if status.order_status_id == transition.to %}selected{% endif %}>{{ status.name }}</option>
                    {% endfor %}
                  </select>
                  <button type="button" class="btn btn-danger btn-xs btn--icon" onclick="removeTransitionRow(this)" data-toggle="tooltip" title="{{ button_flow_remove }}"><i data-lucide="trash-2" width="13" height="13"></i></button>
                </div>
                {% endfor %}
              </div>
              <div class="flow-step-add">
                <button type="button" class="btn btn-primary btn-sm" onclick="addTransitionRow()"><i data-lucide="plus" width="14" height="14"></i> {{ button_flow_add_transition }}</button>
              </div>
            </div>
          </div>

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="star" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_flow_reward_title }}</div>
                <div class="dcx-panel-subtitle">{{ text_flow_reward_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="checkbox" style="margin-top:0">
                  <label>
                    <input type="checkbox" name="reward_auto_award" value="1" {% if reward_auto_award %}checked{% endif %} />
                    {{ text_flow_reward_auto_award }}
                  </label>
                </div>
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="reward_auto_revoke" value="1" {% if reward_auto_revoke %}checked{% endif %} />
                    {{ text_flow_reward_auto_revoke }}
                  </label>
                </div>
                <div class="dcx-field" style="margin-top:10px">
                  <label class="dcx-label" for="reward-delay-days">{{ text_flow_reward_delay_days }}</label>
                  <input type="number" class="form-control" id="reward-delay-days" name="reward_delay_days" value="{{ reward_delay_days }}" min="0" max="365" style="max-width:180px" />
                  <div class="text-muted" style="font-size:12px;margin-top:4px">{{ text_flow_reward_delay_hint }}</div>
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="shopping-cart" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_flow_abandoned_title }}</div>
                <div class="dcx-panel-subtitle">{{ text_flow_abandoned_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="checkbox" style="margin-top:0">
                  <label>
                    <input type="checkbox" name="cart_abandoned_enable" value="1" {% if cart_abandoned_enable %}checked{% endif %} />
                    {{ text_flow_abandoned_enable }}
                  </label>
                </div>
                <div class="dcx-field" style="margin-top:10px">
                  <label class="dcx-label">{{ text_flow_abandoned_waves }}</label>
                  <div class="text-muted" style="font-size:12px;margin-top:4px;margin-bottom:8px">{{ text_flow_abandoned_waves_hint }}</div>
                  <div id="abandoned-waves">
                    {% for wave in cart_abandoned_waves %}
                    <div class="abandoned-wave-row" style="display:flex;gap:10px;align-items:center;margin-bottom:8px">
                      <input type="number" name="cart_abandoned_wave_days[]" value="{{ wave.days }}" min="1" max="365" class="form-control" style="max-width:100px" placeholder="{{ text_flow_abandoned_wave_days_ph }}" />
                      <span class="text-muted" style="font-size:12px">{{ text_flow_abandoned_wave_days_suffix }}</span>
                      <input type="number" name="cart_abandoned_wave_discount[]" value="{{ wave.discount }}" min="0" max="100" class="form-control" style="max-width:100px" placeholder="%" />
                      <span class="text-muted" style="font-size:12px">{{ text_flow_abandoned_wave_discount_suffix }}</span>
                      <button type="button" class="btn btn-danger btn-sm dc-wave-remove" data-toggle="tooltip" title="{{ button_flow_remove }}"><i data-lucide="trash-2" width="14" height="14"></i></button>
                    </div>
                    {% endfor %}
                  </div>
                  <button type="button" class="btn btn-primary btn-sm" id="dc-wave-add"><i data-lucide="plus" width="14" height="14"></i> {{ button_flow_add_wave }}</button>
                </div>
                <div class="dcx-field" style="margin-top:10px">
                  <label class="dcx-label" for="cart-abandoned-retention-days">{{ text_flow_abandoned_retention_days }}</label>
                  <input type="number" class="form-control" id="cart-abandoned-retention-days" name="cart_abandoned_retention_days" value="{{ cart_abandoned_retention_days }}" min="0" max="365" style="max-width:180px" />
                  <div class="text-muted" style="font-size:12px;margin-top:4px">{{ text_flow_abandoned_retention_hint }}</div>
                </div>
              </div>
            </div>
          </div>

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="info" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_flow_rules }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="flow-rules">
                <li>{{ text_flow_rule_forward }}</li>
                <li>{{ text_flow_rule_transitions }}</li>
                <li>{{ text_flow_rule_terminal }}</li>
                <li>{{ text_flow_rule_override }}</li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<select id="flow-status-options" class="form-control" style="display:none">
  {% for status in order_statuses %}
  <option value="{{ status.order_status_id }}">{{ status.name }}</option>
  {% endfor %}
</select>
<script>
function flowStatusOptions(selected) {
	const source = document.getElementById('flow-status-options');
	const select = document.createElement('select');
	select.className = 'form-control';
	Array.from(source.options).forEach(opt => {
		const o = document.createElement('option');
		o.value = opt.value;
		o.textContent = opt.textContent;
		if (String(opt.value) === String(selected)) o.selected = true;
		select.appendChild(o);
	});
	return select;
}

function moveStep(btn, delta) {
	const row = btn.closest('.flow-step-row');
	if (!row) return;
	const container = row.parentElement;
	const rows = Array.from(container.children).filter(el => el.classList.contains('flow-step-row'));
	const index = rows.indexOf(row);
	const target = index + delta;
	if (target < 0 || target >= rows.length) return;
	if (delta < 0) container.insertBefore(row, rows[target]);
	else container.insertBefore(rows[target + 1], row);
}

function removeStepRow(btn) {
	const row = btn.closest('.flow-step-row');
	if (!row || !confirm('{{ text_flow_confirm_remove }}')) return;
	row.remove();
	const used = Array.from(document.querySelectorAll('.flow-step-row')).map(r => r.dataset.statusId);
	const select = document.getElementById('flow-new-step');
	const removedId = row.dataset.statusId;
	if (select && select.querySelector('option[value="' + removedId + '"]') === null) {
		const source = document.getElementById('flow-status-options');
		const src = Array.from(source.options).find(o => o.value === removedId);
		if (src) {
			const opt = document.createElement('option');
			opt.value = src.value;
			opt.textContent = src.textContent;
			select.appendChild(opt);
		}
	}
}

function addStepRow() {
	const select = document.getElementById('flow-new-step');
	if (!select || !select.value) return;
	const container = document.getElementById('flow-steps');
	const source = document.getElementById('flow-status-options');
	const src = Array.from(source.options).find(o => o.value === select.value);
	const name = src ? src.textContent : select.options[select.selectedIndex].textContent;

	const row = document.createElement('div');
	row.className = 'flow-step-row';
	row.dataset.statusId = select.value;
	row.innerHTML =
		'<input type="hidden" name="step[]" value="' + select.value + '" />' +
		'<button type="button" class="btn btn-default btn-xs btn--icon flow-step-btn" onclick="moveStep(this, -1)" data-toggle="tooltip" title="{{ button_flow_move_up }}"><i data-lucide="chevron-up" width="13" height="13"></i></button>' +
		'<button type="button" class="btn btn-default btn-xs btn--icon flow-step-btn" onclick="moveStep(this, 1)" data-toggle="tooltip" title="{{ button_flow_move_down }}"><i data-lucide="chevron-down" width="13" height="13"></i></button>' +
		'<span class="flow-step-name"></span>' +
		'<button type="button" class="btn btn-danger btn-xs btn--icon flow-step-btn" onclick="removeStepRow(this)" data-toggle="tooltip" title="{{ button_flow_remove }}"><i data-lucide="trash-2" width="13" height="13"></i></button>';
	row.querySelector('.flow-step-name').textContent = name;
	container.appendChild(row);
	select.remove(select.selectedIndex);
	lucide.createIcons();
}

function removeTransitionRow(btn) {
	btn.closest('.flow-transition-row').remove();
}

function addTransitionRow() {
	const container = document.getElementById('flow-transitions');
	const row = document.createElement('div');
	row.className = 'flow-transition-row';
	const from = flowStatusOptions('');
	const to = flowStatusOptions('');
	from.name = 'transition_from[]';
	to.name = 'transition_to[]';
	row.appendChild(from);
	const arrow = document.createElement('span');
	arrow.className = 'flow-transition-arrow';
	arrow.innerHTML = '<i data-lucide="arrow-right" width="14" height="14"></i>';
	row.appendChild(arrow);
	row.appendChild(to);
	const removeBtn = document.createElement('button');
	removeBtn.type = 'button';
	removeBtn.className = 'btn btn-danger btn-xs btn--icon';
	removeBtn.title = '{{ button_flow_remove }}';
	removeBtn.innerHTML = '<i data-lucide="trash-2" width="13" height="13"></i>';
	removeBtn.onclick = function () { removeTransitionRow(removeBtn); };
	row.appendChild(removeBtn);
	container.appendChild(row);
	lucide.createIcons();
}

// Reminder waves: add / remove rows
document.addEventListener('click', function (e) {
	if (e.target.closest('#dc-wave-add')) {
		const container = document.getElementById('abandoned-waves');
		if (!container) return;

		const row = document.createElement('div');
		row.className = 'abandoned-wave-row';
		row.style.cssText = 'display:flex;gap:10px;align-items:center;margin-bottom:8px';

		const days = document.createElement('input');
		days.type = 'number';
		days.name = 'cart_abandoned_wave_days[]';
		days.min = 1;
		days.max = 365;
		days.className = 'form-control';
		days.style.maxWidth = '100px';
		days.placeholder = '{{ text_flow_abandoned_wave_days_ph|e('js') }}';

		const daysSuffix = document.createElement('span');
		daysSuffix.className = 'text-muted';
		daysSuffix.style.fontSize = '12px';
		daysSuffix.textContent = '{{ text_flow_abandoned_wave_days_suffix|e('js') }}';

		const discount = document.createElement('input');
		discount.type = 'number';
		discount.name = 'cart_abandoned_wave_discount[]';
		discount.min = 0;
		discount.max = 100;
		discount.className = 'form-control';
		discount.style.maxWidth = '100px';
		discount.placeholder = '%';

		const discountSuffix = document.createElement('span');
		discountSuffix.className = 'text-muted';
		discountSuffix.style.fontSize = '12px';
		discountSuffix.textContent = '{{ text_flow_abandoned_wave_discount_suffix|e('js') }}';

		const removeBtn = document.createElement('button');
		removeBtn.type = 'button';
		removeBtn.className = 'btn btn-danger btn-sm dc-wave-remove';
		removeBtn.title = '{{ button_flow_remove|e('js') }}';
		removeBtn.innerHTML = '<i data-lucide="trash-2" width="14" height="14"></i>';

		row.appendChild(days);
		row.appendChild(daysSuffix);
		row.appendChild(discount);
		row.appendChild(discountSuffix);
		row.appendChild(removeBtn);
		container.appendChild(row);
		lucide.createIcons();
	}

	if (e.target.closest('.dc-wave-remove')) {
		const row = e.target.closest('.abandoned-wave-row');
		if (row) row.remove();
	}
});
</script>
{{ footer }}
