<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{% if orders|length > 1 %}{{ text_invoice }}{% else %}{{ text_invoice }} — {{ orders[0].invoice_no ?: orders[0].order_id }}{% endif %}</title>
  <style>
    @page { size: A4 portrait; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { font-family: Arial, 'DejaVu Sans', Helvetica, sans-serif; font-size: 9pt; color: #1e293b; line-height: 1.5; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    table { width: 100%; max-width: 100%; border-collapse: collapse; table-layout: fixed; }
    .page { width: auto; min-height: auto; padding: 20mm; }
    .accent { height: 2.5px; background: #0f172a; margin: 0 0 18px 0; }
    .doc-head td { vertical-align: top; padding: 0; }
    .brand-logo { max-height: 30px; max-width: 200px; margin-bottom: 8px; display: block; }
    .brand-fallback { font-size: 12pt; font-weight: 700; color: #0f172a; letter-spacing: 0.2px; margin-bottom: 2px; }
    .doc-title { font-size: 17pt; font-weight: 700; color: #0f172a; line-height: 1; letter-spacing: 0.6px; text-transform: uppercase; }
    .doc-number { font-size: 9pt; font-weight: 700; color: #0f172a; margin-top: 4px; }
    .doc-meta { text-align: right; font-size: 7.5pt; color: #64748b; line-height: 1.6; }
    .doc-meta strong { color: #334155; font-weight: 700; }
    .doc-meta .store-name { font-size: 8.5pt; color: #0f172a; font-weight: 700; }
    .section { margin-bottom: 16px; }
    .section h3 { font-size: 7pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.7px; color: #0f172a; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid #e2e8f0; }
    .kv { font-size: 8.5pt; color: #334155; line-height: 1.6; }
    .kv strong { color: #0f172a; }
    .kv .muted { color: #64748b; }
    .addr-grid td { vertical-align: top; padding-right: 18px; width: 50%; }
    .addr-grid td:last-child { padding-right: 0; }
    .addr-grid .addr-name { font-size: 9pt; font-weight: 700; color: #0f172a; margin-bottom: 3px; }
    .addr-grid .addr-lines { font-size: 8.5pt; color: #334155; line-height: 1.6; }
    .addr-grid .addr-lines .muted { color: #64748b; }
    .pay-order { border: 1px solid #e2e8f0; }
    .pay-order-head { background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 7px 10px; }
    .pay-order-head h3 { margin: 0; padding: 0; border: 0; font-size: 7pt; }
    .pay-order-body { padding: 8px 10px; }
    .pay-order-body table td { padding: 3px 8px 3px 0; font-size: 7.5pt; vertical-align: top; line-height: 1.5; }
    .pay-order-body td.label { color: #64748b; white-space: nowrap; width: 132px; text-transform: uppercase; letter-spacing: 0.3px; font-size: 7pt; padding-top: 4px; }
    .pay-order-body td.value { color: #0f172a; font-weight: 400; }
    .pay-order-body td.value strong { font-weight: 700; }
    .items th { background: #0f172a; color: #ffffff; font-weight: 700; font-size: 7pt; text-transform: uppercase; letter-spacing: 0.5px; padding: 8px 9px; text-align: left; }
    .items td { padding: 7px 9px; border-bottom: 1px solid #e2e8f0; font-size: 8.5pt; vertical-align: top; color: #1e293b; }
    .items tr:last-child td { border-bottom-color: #cbd5e1; }
    .items .opt { color: #64748b; font-size: 7.5pt; margin-top: 2px; line-height: 1.4; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .no-wrap { white-space: nowrap; }
    .totals-wrap { margin-top: 10px; }
    .totals { width: 260px; margin-left: auto; }
    .totals td { padding: 4px 9px; font-size: 8.5pt; color: #334155; }
    .totals .grand td { font-weight: 700; font-size: 10pt; color: #0f172a; border-top: 2px solid #0f172a; padding-top: 7px; }
    .due { margin-top: 12px; border: 1.5px solid #0f172a; background: #f8fafc; padding: 10px 14px; width: 260px; margin-left: auto; }
    .due-label { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.6px; color: #64748b; font-weight: 700; }
    .due-amount { font-size: 14pt; font-weight: 700; color: #0f172a; margin-top: 1px; line-height: 1.2; }
    .note { margin-top: 14px; border-left: 2px solid #e2e8f0; padding-left: 10px; }
    .note h3 { border: 0; padding: 0; margin-bottom: 4px; }
    .note p { font-size: 8.5pt; color: #475569; line-height: 1.6; }
    .page-foot { margin-top: 22px; border-top: 1px solid #e2e8f0; padding-top: 10px; text-align: center; color: #94a3b8; font-size: 7pt; line-height: 1.6; }
    .page-foot strong { color: #64748b; font-weight: 700; }
  </style>
</head>
<body>
  {% for order in orders %}
  <div class="page"{% if not loop.last %} style="page-break-after: always;"{% endif %}>
    <table class="doc-head">
      <tr>
        <td>
          {% if order.seller_logo %}<img src="{{ order.seller_logo }}" class="brand-logo" alt="">{% else %}<div class="brand-fallback">{{ order.seller_name ?: order.store_name }}</div>{% endif %}
          {% if order.seller_logo and order.seller_name %}<div style="font-size: 7.5pt; color: #64748b; margin-bottom: 1px;">{{ order.seller_name }}</div>{% endif %}
          <div class="doc-title">{{ text_invoice }}</div>
          {% if order.invoice_no %}<div class="doc-number">№ {{ order.invoice_no }}</div>{% endif %}
        </td>
        <td class="doc-meta">
          <div class="store-name">{{ order.store_name }}</div>
          <div>{{ order.store_url }}</div>
          <div><strong>{{ text_date_added }}:</strong> {{ order.date_added }}</div>
          {% if order.invoice_valid_until %}<div><strong>{{ text_invoice_valid_until }}:</strong> {{ order.invoice_valid_until }}</div>{% endif %}
          <div style="margin-top: 4px; color: #94a3b8;">{{ text_order }}: #{{ order.order_id }}</div>
        </td>
      </tr>
    </table>
    <div class="accent"></div>

    <div class="section">
      <table>
        <tr>
          <td style="vertical-align: top; padding-right: 16px;">
            <h3>{{ text_seller }}</h3>
            <div class="kv">
              <div><strong>{{ order.seller_name }}</strong></div>
              {% if order.seller_address %}<div>{{ order.seller_address }}</div>{% endif %}
              {% if order.seller_telephone %}<div><span class="muted">{{ text_telephone }}:</span> {{ order.seller_telephone }}</div>{% endif %}
              {% if order.seller_email %}<div><span class="muted">{{ text_email }}:</span> {{ order.seller_email }}</div>{% endif %}
              {% for tax in order.seller_tax_numbers %}<div><span class="muted">{{ attribute(text_tax_type, tax.type) is defined ? attribute(text_tax_type, tax.type) : tax.type }}:</span> {{ tax.value }}</div>{% endfor %}
              {% if order.seller_bank_name %}<div><span class="muted">{{ text_bank_name }}:</span> {{ order.seller_bank_name }}</div>{% endif %}
              {% if order.seller_bank_account %}<div><span class="muted">{{ text_bank_account }}:</span> {{ order.seller_bank_account }}</div>{% endif %}
              {% if order.seller_bank_swift %}<div><span class="muted">{{ text_bank_swift }}:</span> {{ order.seller_bank_swift }}</div>{% endif %}
            </div>
          </td>
        </tr>
      </table>
    </div>

    <div class="section">
      <table class="addr-grid">
        <tr>
          <td>
            <h3>{{ text_bill_to }}</h3>
            <div class="addr-name">{{ order.firstname }} {{ order.lastname }}</div>
            <div class="addr-lines">{{ order.payment_address|raw }}</div>
            <div class="addr-lines" style="margin-top: 4px;">{{ order.email }}<br>{{ order.telephone }}</div>
          </td>
          {% if order.shipping_method %}
          <td>
            <h3>{{ text_ship_to }}</h3>
            <div class="addr-lines">{{ order.shipping_address|raw }}</div>
            <div class="kv" style="margin-top: 6px; font-size: 7.5pt;">
              <div><span class="muted">{{ text_payment_method }}:</span> {{ order.payment_method }}</div>
              <div><span class="muted">{{ text_shipping_method }}:</span> {{ order.shipping_method }}</div>
            </div>
          </td>
          {% endif %}
        </tr>
        {% if order.tracking_number %}
        <tr>
          <td colspan="2" style="padding-top: 10px;">
            <h3>{{ text_tracking_number }}</h3>
            <div class="kv">{{ order.tracking_number|replace({'|': ' · '}) }}</div>
          </td>
        </tr>
        {% endif %}
      </table>
    </div>

    <div class="section pay-order">
      <div class="pay-order-head"><h3>{{ text_payment_order }}</h3></div>
      <div class="pay-order-body">
        <table>
          <tr><td class="label">{{ text_payment_order_recipient }}</td><td class="value"><strong>{{ order.payment_order.seller_name }}</strong>{% if order.payment_order.seller_address %}, {{ order.payment_order.seller_address }}{% endif %}{% if order.payment_order.seller_tax_label and order.payment_order.seller_tax_value %}, {{ order.payment_order.seller_tax_label }} {{ order.payment_order.seller_tax_value }}{% endif %}</td></tr>
          <tr><td class="label">{{ text_payment_order_bank }}</td><td class="value">{{ order.payment_order.bank_name }}{% if order.payment_order.bank_swift %} <span class="muted">({{ text_bank_swift }}: {{ order.payment_order.bank_swift }})</span>{% endif %}</td></tr>
          <tr><td class="label">{{ text_payment_order_account }}</td><td class="value">{{ order.payment_order.bank_account }}</td></tr>
          <tr><td class="label">{{ text_payment_order_payer }}</td><td class="value">{{ order.payment_order.payer_company ? order.payment_order.payer_company ~ ', ' : '' }}{{ order.payment_order.payer_name }}</td></tr>
          <tr><td class="label">{{ text_payment_order_purpose }}</td><td class="value">{{ text_payment_purpose|format(order.invoice_no ?: '№ ' ~ order.order_id) }}</td></tr>
          <tr><td class="label">{{ text_payment_order_amount }}</td><td class="value" style="font-weight: 700; font-size: 8.5pt;">{{ order.balance_due }}</td></tr>
        </table>
      </div>
    </div>

    <table class="items">
      <thead>
        <tr>
          <th style="width: 46%;">{{ column_product }}</th>
          <th style="width: 18%;">{{ column_model }}</th>
          <th class="text-right" style="width: 12%;">{{ column_quantity }}</th>
          <th class="text-right" style="width: 12%;">{{ column_price }}</th>
          <th class="text-right" style="width: 12%;">{{ column_total }}</th>
        </tr>
      </thead>
      <tbody>
        {% for product in order.products %}
        <tr>
          <td>{{ product.name }}{% if product.option %}<div class="opt">{{ product.option }}</div>{% endif %}</td>
          <td class="muted" style="color: #64748b; font-size: 8pt;">{{ product.model }}</td>
          <td class="text-right no-wrap">{{ product.quantity }}</td>
          <td class="text-right no-wrap">{{ product.price }}</td>
          <td class="text-right no-wrap" style="font-weight: 700;">{{ product.total }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="totals-wrap">
      <table class="totals">
        {% for total in order.totals %}
        <tr{% if loop.last %} class="grand"{% endif %}>
          <td>{{ total.title }}</td>
          <td class="text-right no-wrap">{{ total.text }}</td>
        </tr>
        {% endfor %}
      </table>
      <div class="due">
        <div class="due-label">{{ text_balance_due }}</div>
        <div class="due-amount no-wrap">{{ order.balance_due }}</div>
      </div>
    </div>

    {% if order.comment %}
    <div class="note">
      <h3>{{ text_comment }}</h3>
      <p>{{ order.comment|nl2br }}</p>
    </div>
    {% endif %}

    <div class="page-foot">
      <div>{{ order.store_name }} · {{ order.store_url }}</div>
      <div>{{ text_print_date }}: {{ "now"|date("Y-m-d H:i:s") }}</div>
    </div>
  </div>
  {% endfor %}
</body>
</html>
