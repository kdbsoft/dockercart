{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">
              {{ heading_title }}
              <span class="page-header__badge page-header__badge--{{ status_badge_class }}">{{ order_status }}</span>
              <span class="page-header__badge {{ payment_status_header_badge_class }}">{{ payment_status_text }}</span>
            </span>
          </a>
          <div class="pull-right" id="header-actions">
            <button type="button" id="btn-edit" class="btn btn-primary hidden-xs" onclick="toggleEditMode()">
              <i data-lucide="pencil" width="16" height="16"></i> {{ button_edit }}
            </button>
            <a href="{{ invoice_url }}" target="_blank" class="btn btn-primary">
              <i data-lucide="file-text" width="16" height="16"></i> {{ button_invoice }}
            </a>
            <a href="{{ print_url }}" target="_blank" class="btn btn-default">
              <i data-lucide="printer" width="16" height="16"></i> {{ button_print }}
            </a>
            <div class="dropdown" style="display:inline-block">
              <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown">
                <i data-lucide="more-vertical" width="16" height="16"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-right">
                <li><a href="#" onclick="event.preventDefault();addReward();return false"><i data-lucide="star" width="14" height="14"></i> {{ button_reward_add }}</a></li>
                <li><a href="#" onclick="event.preventDefault();removeReward();return false"><i data-lucide="star-off" width="14" height="14"></i> {{ button_reward_remove }}</a></li>
                <li class="divider"></li>
                <li><a href="#" onclick="event.preventDefault();addCommission();return false"><i data-lucide="coins" width="14" height="14"></i> {{ button_commission_add }}</a></li>
                <li><a href="#" onclick="event.preventDefault();removeCommission();return false"><i data-lucide="coins-off" width="14" height="14"></i> {{ button_commission_remove }}</a></li>
                <li class="divider"></li>
                <li><a href="#" onclick="event.preventDefault();duplicateOrder();return false"><i data-lucide="copy" width="14" height="14"></i> {{ button_duplicate_order }}</a></li>
                <li class="divider"></li>
                <li><a href="{{ create_return_url }}" target="_blank"><i data-lucide="rotate-ccw" width="14" height="14"></i> {{ button_create_return }}</a></li>
              </ul>
            </div>
            <span id="edit-actions" style="display:none">
              <button type="button" id="btn-save" class="btn btn-primary" onclick="saveChanges()">
                <i data-lucide="save" width="16" height="16"></i> {{ button_save }}
              </button>
              <button type="button" class="btn btn-default" onclick="toggleEditMode()">
                <i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}
              </button>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if flow_enabled %}
  <div class="container-fluid" style="margin-bottom:12px">
    <div class="row">
      <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
        {% include 'sale/order_flow_stages.twig' %}
      </div>
    </div>
  </div>
  {% endif %}

  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">

        {% if success %}
        <div class="alert alert-success alert-dismissible" style="margin-bottom:12px">
          <i data-lucide="circle-check" width="16" height="16" style="vertical-align:-2px"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        {# Edit mode label #}
        <div id="edit-mode-banner" class="alert alert-warning" style="display:none;padding:6px 12px;margin-bottom:12px;font-size:12px">
          <i data-lucide="edit-3" width="14" height="14"></i> {{ text_edit_mode }}. {{ text_edit_hint }}
        </div>

        {# Products Panel #}
        <div class="dcx-shell">
          <div class="dcx-panel" data-panel="order-products">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="package" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_panel_order_contents }}</div>
              </div>
              <a href="#" class="dcx-panel-edit-link" onclick="event.preventDefault(); togglePanelEditMode('order-products');"><i data-lucide="pencil" width="12" height="12"></i> {{ text_edit_order_contents }}</a>
              <div class="dcx-panel-edit-actions">
                <button type="button" class="btn btn-primary btn-xs" onclick="savePanelChanges('order-products')">
                  <i data-lucide="check" width="13" height="13"></i> {{ button_save }}
                </button>
                <button type="button" class="btn btn-default btn-xs" onclick="togglePanelEditMode('order-products')">
                  <i data-lucide="x" width="13" height="13"></i> {{ button_cancel }}
                </button>
              </div>
            </div>
            <div class="dcx-panel-body dcx-panel-body--flush">
              <div class="order-products-list">
              {% if product_count == 0 %}
              <div class="text-muted" style="padding:18px;font-size:13px;text-align:center">{{ text_no_order_products }}</div>
              {% endif %}
              {% for product in products %}
              <div class="order-product-card" data-product-id="{{ product.product_id }}" data-order-product-id="{{ product.order_product_id }}" data-price-raw="{{ product.price_raw|round(4) }}" data-tax-raw="{{ product.tax_raw|round(4) }}" data-discount-original="{{ product.discount_percent|round(1) }}">
                <div class="order-product-card__pos">#{{ loop.index }}</div>
                <div class="order-product-card__thumb">
                  <img src="{{ product.thumb }}" alt="{{ product.name }}">
                </div>
                <div class="order-product-card__info">
                  <div class="order-product-card__name">
                    <a href="{{ product.href }}" target="_blank">{{ product.name }}</a>
                  </div>
                  <div class="order-product-card__meta">
                    <span class="order-product-card__model">{{ product.model }}</span>
                    {% if product.variant_sku %}
                      <span class="order-product-card__option" title="{{ entry_variant_sku }}">· SKU: {{ product.variant_sku }}</span>
                    {% endif %}
                    {% if product.option %}
                      {% for option in product.option %}
                        <span class="order-product-card__option">· {{ option.name }}: {{ option.value }}</span>
                      {% endfor %}
                    {% endif %}
                  </div>
                  {% if product.discount_percent > 0 %}
                  <div class="order-product-card__discount">{{ product.discount_percent|round(1) }}% {{ text_discount }}</div>
                  {% endif %}
                </div>
                <div class="order-product-card__price">
                  <span class="view-only">{{ product.price }}</span>
                  <input type="text" class="form-control edit-only" value="{{ product.price_raw|round(currency_decimal_place) }}" data-field="price" style="display:none">
                </div>
                <div class="order-product-card__mult">&times;</div>
                <div class="order-product-card__qty">
                  <span class="view-only">{{ product.quantity|number_format(currency_decimal_place, '.', '') }}</span>
                  <input type="number" class="form-control edit-only" value="{{ product.quantity }}" min="0" step="any" data-field="quantity" style="display:none">
                </div>
                <div class="order-product-card__disc edit-only" style="display:none" title="{{ entry_discount_percent }}">
                  <input type="number" class="form-control" value="{{ product.discount_percent|round(1) }}" min="0" max="100" step="0.5" data-field="discount">
                </div>
                <div class="order-product-card__total">= {{ product.total }}</div>
                <div class="order-product-card__actions edit-only" style="display:none">
                  <button type="button" class="btn btn-danger btn-xs btn--icon" onclick="removeProduct(this)" data-toggle="tooltip" title="{{ button_remove }}">
                    <i data-lucide="trash-2" width="13" height="13"></i>
                  </button>
                </div>
              </div>
              {% endfor %}
              </div>

              {# Add Product (edit mode) #}
              <div class="edit-only order-add-block" style="display:none">
                <div class="order-add-title"><i data-lucide="plus-circle" width="15" height="15"></i> {{ button_add }} {{ text_panel_order_contents|lower }}</div>
                <div class="dcx-fields">
                  <div class="dcx-field">
                    <label class="dcx-label">{{ text_search_product }}</label>
                    <div class="order-product-search-wrap" id="product-picker" data-currency-code="{{ currency_code }}" data-currency-value="{{ currency_value }}" data-customer-group-id="{{ customer_group_id }}">
                      <div class="order-product-search-inner">
                        <input type="text" id="product-search" class="form-control" placeholder="{{ text_search_product }}" autocomplete="off">
                        <input type="hidden" id="product-id" value="0">
                        <div class="order-product-dropdown" id="product-dropdown"></div>
                      </div>
                      <div id="product-summary" class="order-product-summary" style="display:none"></div>
                      <div id="product-options-container" style="display:none"></div>
                      <div id="product-preview" class="order-product-preview" style="display:none"></div>
                    </div>
                  </div>
                  <div class="dcx-fields--row order-add-block__row">
                    <div class="dcx-field order-add-block__qty">
                      <label class="dcx-label">{{ entry_quantity }}</label>
                      <input type="number" id="product-qty" class="form-control" value="1" min="1">
                    </div>
                    <div class="dcx-field order-add-block__btn">
                      <button type="button" id="product-add-btn" class="btn btn-primary">
                        <i data-lucide="plus" width="14" height="14"></i> {{ button_add }}
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              {# Totals #}
              <div class="order-totals-card" data-decimal-place="{{ currency_decimal_place }}">
                {% for total in totals %}
                {% set label = total.title %}
                {% if total.code == 'sub_total' %}
                  {% set label = label ~ ' (' ~ text_items ~ ': ' ~ total_quantity ~ ')' %}
                {% endif %}
                {% if loop.last %}
                  <div class="order-totals-card__divider"></div>
                {% endif %}
                <div class="order-totals-card__row{% if loop.last %} order-totals-card__row--total{% endif %}" data-total-code="{{ total.code }}"{% if total.code == 'sub_total' %} data-label-base="{{ total.title }}"{% endif %}>
                  <span class="order-totals-card__label">{{ label }}</span>
                  <span class="order-totals-card__line"></span>
                  <span class="order-totals-card__value">{{ total.text }}</span>
                </div>
                {% endfor %}
              </div>

              {# Coupon #}
              <div class="order-coupon-block">
                {% if coupon_applied %}
                <div class="order-coupon-row">
                  <span class="order-coupon-label"><i data-lucide="tag" width="13" height="13"></i> {{ coupon_title }}</span>
                  <button type="button" class="btn btn-default btn-xs" onclick="removeCoupon()">
                    <i data-lucide="x" width="12" height="12"></i> {{ button_coupon_remove }}
                  </button>
                </div>
                {% else %}
                <div class="order-coupon-row">
                  <input type="text" id="coupon-code" class="form-control order-coupon-input" placeholder="{{ entry_coupon }}" autocomplete="off">
                  <button type="button" class="btn btn-default" onclick="applyCoupon()">
                    <i data-lucide="tag" width="12" height="12"></i> {{ button_coupon_apply }}
                  </button>
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        {# Payments Card #}
        <div class="dcx-panel" data-panel="payments">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="credit-card" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ text_payments }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <div id="payments-card">
              {% include 'sale/order_payments.twig' %}
            </div>
          </div>
        </div>

        {# Shipments Card #}
        <div class="dcx-panel" data-panel="shipments">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="truck" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ text_shipments }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <div id="shipments-card">
              {% include 'sale/order_shipments.twig' %}
            </div>
          </div>
        </div>
      </div>

      {# Sidebar #}
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">

        {# Buyer Card (customer + addresses) #}
        <div class="dcx-sidebar-card" data-panel="buyer">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="user" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_buyer }}</h3>
            <a href="#" class="dcx-sidebar-edit-link" onclick="event.preventDefault(); togglePanelEditMode('buyer');"><i data-lucide="pencil" width="12" height="12"></i> {{ text_edit_buyer }}</a>
            <div class="dcx-sidebar-edit-actions">
              <button type="button" class="btn btn-primary btn-xs" onclick="savePanelChanges('buyer')">
                <i data-lucide="check" width="13" height="13"></i> {{ button_save }}
              </button>
              <button type="button" class="btn btn-default btn-xs" onclick="togglePanelEditMode('buyer')">
                <i data-lucide="x" width="13" height="13"></i> {{ button_cancel }}
              </button>
            </div>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_firstname }} / {{ entry_lastname }}</span>
              <span class="dcx-sidebar-card__value view-only">{{ firstname }} {{ lastname }}<a href="#" class="dc-copy-btn" data-copy="{{ firstname }} {{ lastname }}" data-toggle="tooltip" title="{{ text_copy }}" onclick="event.preventDefault(); copyToClipboard(this);"><i data-lucide="copy" width="12" height="12"></i></a></span>
              <div class="edit-only" style="display:none">
                <input type="text" class="form-control" value="{{ firstname }}" data-field="firstname" placeholder="{{ entry_firstname }}" style="width:48%;display:inline-block">
                <input type="text" class="form-control" value="{{ lastname }}" data-field="lastname" placeholder="{{ entry_lastname }}" style="width:48%;display:inline-block">
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_email }}</span>
              <span class="dcx-sidebar-card__value view-only" data-field="email">{{ email }}<a href="#" class="dc-copy-btn" data-copy="{{ email }}" data-toggle="tooltip" title="{{ text_copy }}" onclick="event.preventDefault(); copyToClipboard(this);"><i data-lucide="copy" width="12" height="12"></i></a></span>
              <input type="email" class="form-control edit-only" value="{{ email }}" data-field="email" style="display:none">
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_telephone }}</span>
              <span class="dcx-sidebar-card__value view-only" data-field="telephone">{{ telephone }}<a href="#" class="dc-copy-btn" data-copy="{{ telephone }}" data-toggle="tooltip" title="{{ text_copy }}" onclick="event.preventDefault(); copyToClipboard(this);"><i data-lucide="copy" width="12" height="12"></i></a></span>
              <input type="text" class="form-control edit-only" value="{{ telephone }}" data-field="telephone" style="display:none">
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_tax_number }}</span>
              <span class="dcx-sidebar-card__value view-only" data-field="tax_number">{{ tax_number ?: '—' }}{% if tax_number %}<a href="#" class="dc-copy-btn" data-copy="{{ tax_number }}" data-toggle="tooltip" title="{{ text_copy }}" onclick="event.preventDefault(); copyToClipboard(this);"><i data-lucide="copy" width="12" height="12"></i></a>{% endif %}</span>
              <input type="text" class="form-control edit-only" value="{{ tax_number }}" data-field="tax_number" style="display:none">
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_customer_group }}</span>
              <span class="dcx-sidebar-card__value">{{ customer_group }}</span>
            </div>
            {% if customer_link %}
            <div class="dcx-sidebar-card__field" style="margin-top:4px">
              <a href="{{ customer_link }}" target="_blank" class="btn btn-default btn-xs">
                <i data-lucide="external-link" width="11" height="11"></i> {{ text_view_customer }}
              </a>
            </div>
            {% endif %}

            {# Shipping address first #}
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ text_shipping_address }}</span>
              <span class="dcx-sidebar-card__value view-only">{{ shipping_address|raw }}<a href="#" class="dc-copy-btn" data-copy-html="{{ shipping_address }}" data-toggle="tooltip" title="{{ text_copy }}" onclick="event.preventDefault(); copyToClipboard(this);"><i data-lucide="copy" width="12" height="12"></i></a></span>
              <div class="edit-only" id="edit-shipping-address" style="display:none">
                <input type="text" class="form-control" value="{{ shipping_firstname }}" data-address-field="shipping_firstname" placeholder="{{ entry_firstname }}" style="margin-bottom:3px">
                <input type="text" class="form-control" value="{{ shipping_lastname }}" data-address-field="shipping_lastname" placeholder="{{ entry_lastname }}" style="margin-bottom:3px">
                <input type="text" class="form-control" value="{{ shipping_address_1 }}" data-address-field="shipping_address_1" placeholder="{{ entry_address_1 }}" style="margin-bottom:3px">
                <input type="text" class="form-control" value="{{ shipping_address_2 }}" data-address-field="shipping_address_2" placeholder="{{ entry_address_2 }}" style="margin-bottom:3px">
                <input type="text" class="form-control" value="{{ shipping_city }}" data-address-field="shipping_city" placeholder="{{ entry_city }}" style="margin-bottom:3px">
                <input type="text" class="form-control" value="{{ shipping_postcode }}" data-address-field="shipping_postcode" placeholder="{{ entry_postcode }}" style="margin-bottom:3px">
                <select class="form-control" data-address-field="shipping_country_id" onchange="loadZones(this,'#edit-ship-zone')" style="margin-bottom:3px">
                  {% for country in countries %}
                  <option value="{{ country.country_id }}" {% if country.country_id == shipping_country_id %}selected{% endif %}>{{ country.name }}</option>
                  {% endfor %}
                </select>
                <select class="form-control" id="edit-ship-zone" data-address-field="shipping_zone_id">
                  <option value="0">{{ text_none }}</option>
                </select>
              </div>
            </div>

            {# Payer address — with same-as-shipping badge if they match #}
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ text_payer_address }}</span>
              {% if addresses_match %}
                <span class="dcx-sidebar-card__value">
                  <span class="same-as-badge"><i data-lucide="corner-down-right" width="12" height="12"></i> {{ text_same_as_shipping }}</span>
                </span>
              {% else %}
                <span class="dcx-sidebar-card__value view-only">{{ payment_address|raw }}<a href="#" class="dc-copy-btn" data-copy-html="{{ payment_address }}" data-toggle="tooltip" title="{{ text_copy }}" onclick="event.preventDefault(); copyToClipboard(this);"><i data-lucide="copy" width="12" height="12"></i></a></span>
              {% endif %}
              <div class="edit-only" style="display:none;margin-top:4px">
                <label class="checkbox-inline" style="font-size:12px">
                  <input type="checkbox" id="same-address-cb" {% if addresses_match %}checked{% endif %} onchange="toggleSameAddress()"> {{ text_same_as_shipping }}
                </label>
                <div id="edit-payment-address" style="display:none;margin-top:4px">
                  <input type="text" class="form-control" value="{{ payment_firstname }}" data-address-field="payment_firstname" placeholder="{{ entry_firstname }}" style="margin-bottom:3px">
                  <input type="text" class="form-control" value="{{ payment_lastname }}" data-address-field="payment_lastname" placeholder="{{ entry_lastname }}" style="margin-bottom:3px">
                  <input type="text" class="form-control" value="{{ payment_address_1 }}" data-address-field="payment_address_1" placeholder="{{ entry_address_1 }}" style="margin-bottom:3px">
                  <input type="text" class="form-control" value="{{ payment_address_2 }}" data-address-field="payment_address_2" placeholder="{{ entry_address_2 }}" style="margin-bottom:3px">
                  <input type="text" class="form-control" value="{{ payment_city }}" data-address-field="payment_city" placeholder="{{ entry_city }}" style="margin-bottom:3px">
                  <input type="text" class="form-control" value="{{ payment_postcode }}" data-address-field="payment_postcode" placeholder="{{ entry_postcode }}" style="margin-bottom:3px">
                  <select class="form-control" data-address-field="payment_country_id" onchange="loadZones(this,'#edit-pay-zone')" style="margin-bottom:3px">
                    {% for country in countries %}
                    <option value="{{ country.country_id }}" {% if country.country_id == payment_country_id %}selected{% endif %}>{{ country.name }}</option>
                    {% endfor %}
                  </select>
                  <select class="form-control" id="edit-pay-zone" data-address-field="payment_zone_id">
                    <option value="0">{{ text_none }}</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>

        {# Order Card (status + payment/shipping + tools) #}
        <div class="dcx-sidebar-card" data-panel="order-details">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="shopping-cart" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_order_detail }}</h3>
            <a href="#" class="dcx-sidebar-edit-link" onclick="event.preventDefault(); togglePanelEditMode('order-details');"><i data-lucide="pencil" width="12" height="12"></i> {{ text_edit_order_detail }}</a>
            <div class="dcx-sidebar-edit-actions">
              <button type="button" class="btn btn-primary btn-xs" onclick="savePanelChanges('order-details')">
                <i data-lucide="check" width="13" height="13"></i> {{ button_save }}
              </button>
              <button type="button" class="btn btn-default btn-xs" onclick="togglePanelEditMode('order-details')">
                <i data-lucide="x" width="13" height="13"></i> {{ button_cancel }}
              </button>
            </div>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_date_added }}</span>
              <span class="dcx-sidebar-card__value">{{ date_added }}</span>
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_store }}</span>
              <span class="dcx-sidebar-card__value">{{ store_name }}</span>
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_order_status }}</span>
              <span class="dcx-sidebar-card__value">{{ order_status }}</span>
              <button type="button" class="btn btn-xs btn-default" style="margin-top:4px" onclick="toggleFlowOverride()"><i data-lucide="settings-2" width="12" height="12"></i> {{ text_flow_change_status }}</button>
              <div id="flow-override-block" style="display:none">
                <select class="form-control" id="edit-order-status" style="margin-top:4px">
                  {% for status in order_statuses %}
                  <option value="{{ status.order_status_id }}" {% if status.order_status_id == order_status_id %}selected{% endif %}>{{ status.name }}</option>
                  {% endfor %}
                </select>
                <div style="margin-top:4px">
                  <label class="dcx-sidebar-card__checkbox"><input type="checkbox" id="flow-override-check" checked /> {{ text_flow_override }}</label>
                </div>
                <div style="margin-top:4px">
                  <button type="button" class="btn btn-xs btn-primary" onclick="applyFlowOverride()">{{ button_flow_apply }}</button>
                  <button type="button" class="btn btn-xs btn-default" onclick="toggleFlowOverride()">{{ button_cancel }}</button>
                </div>
              </div>
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ entry_comment }}</span>
              <div class="dcx-sidebar-card__value view-only">{{ comment|nl2br ?: '—' }}</div>
              <textarea class="form-control edit-only" id="edit-comment" style="display:none" rows="2">{{ comment }}</textarea>
            </div>

            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ text_payment_method }}</span>
              <span class="dcx-sidebar-card__value view-only" data-field="payment_method">{{ payment_method }}</span>
              <select class="form-control edit-only" data-field="payment_method" data-code-field="payment_code" style="display:none">
                {% if payment_code %}
                  <option value="{{ payment_method }}" data-code="{{ payment_code }}" selected>{{ payment_method }}</option>
                {% else %}
                  <option value="" selected>&mdash;</option>
                {% endif %}
                {% for code, method in payment_methods %}
                  {% if code != payment_code %}
                    <option value="{{ method.title }}" data-code="{{ code }}">{{ method.title }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <span class="dcx-sidebar-card__label">{{ text_shipping_method }}</span>
              <span class="dcx-sidebar-card__value view-only" data-field="shipping_method">{{ shipping_method }}</span>
              <select class="form-control edit-only" data-field="shipping_method" data-code-field="shipping_code" style="display:none">
                {% if shipping_code %}
                  <option value="{{ shipping_method }}" data-code="{{ shipping_code }}" selected>{{ shipping_method }}</option>
                {% else %}
                  <option value="" selected>&mdash;</option>
                {% endif %}
                {% for code, method in shipping_methods %}
                  {% if code != shipping_code %}
                    <option value="{{ method.title }}" data-code="{{ code }}">{{ method.title }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <div class="dcx-sidebar-card__field-row">
                <span class="dcx-sidebar-card__label">{{ text_reward }}</span>
                <span class="dcx-sidebar-card__value">{{ reward }}</span>
                {% if reward_awarded_text %}
                <span class="dcx-sidebar-card__value" style="font-size:11px;color:#28a745">{{ reward_awarded_text }}</span>
                {% elseif reward_delayed %}
                <span class="dcx-sidebar-card__value" style="font-size:11px;color:#6c757d">{{ text_reward_pending }}</span>
                {% endif %}
                <div class="dcx-sidebar-card__actions">
                  <button type="button" class="btn btn-xs btn-success btn--icon" onclick="addReward()" data-toggle="tooltip" title="{{ button_reward_add }}">
                    <i data-lucide="plus" width="11" height="11"></i>
                  </button>
                  <button type="button" class="btn btn-xs btn-danger btn--icon" onclick="removeReward()" data-toggle="tooltip" title="{{ button_reward_remove }}">
                    <i data-lucide="minus" width="11" height="11"></i>
                  </button>
                </div>
              </div>
            </div>
            {% if affiliate_id %}
            <div class="dcx-sidebar-card__field">
              <div class="dcx-sidebar-card__field-row">
                <span class="dcx-sidebar-card__label">{{ text_affiliate }}</span>
                <span class="dcx-sidebar-card__value">{{ affiliate_firstname }} {{ affiliate_lastname }} ({{ commission }})</span>
                <div class="dcx-sidebar-card__actions">
                  <button type="button" class="btn btn-xs btn-success btn--icon" onclick="addCommission()" data-toggle="tooltip" title="{{ button_commission_add }}">
                    <i data-lucide="plus" width="11" height="11"></i>
                  </button>
                  <button type="button" class="btn btn-xs btn-danger btn--icon" onclick="removeCommission()" data-toggle="tooltip" title="{{ button_commission_remove }}">
                    <i data-lucide="minus" width="11" height="11"></i>
                  </button>
                </div>
              </div>
            </div>
            {% endif %}
            <div class="dcx-sidebar-card__field">
              <div class="order-browser-toggle" onclick="toggleBrowserInfo()">
                <i data-lucide="chevron-right" width="12" height="12" id="browser-chevron"></i>
                <span id="browser-toggle-text" style="font-size:11px">{{ text_show_browser_info }}</span>
              </div>
              <div id="browser-info" style="display:none;margin-top:6px">
                <div class="dcx-sidebar-card__field">
                  <span class="dcx-sidebar-card__label">{{ text_ip }}</span>
                  <span class="dcx-sidebar-card__value">{{ ip }}</span>
                </div>
                <div class="dcx-sidebar-card__field">
                  <span class="dcx-sidebar-card__label">{{ text_user_agent }}</span>
                  <span class="dcx-sidebar-card__value" style="font-size:10px;word-break:break-all;color:#888">{{ user_agent }}</span>
                </div>
                <div class="dcx-sidebar-card__field">
                  <span class="dcx-sidebar-card__label">{{ text_forwarded_ip }}</span>
                  <span class="dcx-sidebar-card__value">{{ forwarded_ip ?: '—' }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {# Timeline #}
        <div class="dcx-sidebar-card" data-panel="timeline">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="clock" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_timeline }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div id="timeline-container" data-order-id="{{ order_id }}">
              <div class="text-center"><i data-lucide="loader" width="18" height="18" class="spin"></i> {{ text_loading }}</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

