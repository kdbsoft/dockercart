let flowTransitionTarget = null;
let flowTransitionTerminal = false;

function openFlowTransition(statusId, name, terminal) {
	flowTransitionTarget = statusId;
	flowTransitionTerminal = terminal;
	const modal = document.getElementById('flow-transition-modal');
	if (!modal) return;
	document.getElementById('flow-transition-title').textContent = name;
	document.getElementById('flow-transition-sub').textContent = '{{ text_flow_transition_to }} ' + name;
	document.getElementById('flow-transition-comment').value = '';
	document.getElementById('flow-transition-notify').checked = true;
	const shipSection = document.getElementById('flow-shipping-section');
	if (shipSection) {
		const isShipping = SHIPPING_STATUS_ID > 0 && statusId === SHIPPING_STATUS_ID;
		shipSection.style.display = isShipping ? '' : 'none';
		if (isShipping) {
			document.getElementById('flow-shipment-tracking').value = '';
			document.querySelectorAll('#flow-shipment-items input[data-shipment-qty]').forEach(inp => {
				inp.value = inp.max;
			});
		}
	}
	modal.style.display = 'flex';
	lucide.createIcons();
}

function closeFlowTransition() {
	const modal = document.getElementById('flow-transition-modal');
	if (modal) modal.style.display = 'none';
}

function confirmFlowTransition() {
	if (!flowTransitionTarget) return;
	if (flowTransitionTerminal && !confirm('{{ text_flow_confirm_terminal }}')) return;
	const comment = document.getElementById('flow-transition-comment').value;
	const notify = document.getElementById('flow-transition-notify').checked;
	const doTransition = (notifyCustomer) => {
		api('index.php?route=sale/order_detail/addHistory&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
			'POST', { order_status_id: flowTransitionTarget, comment: comment, notify: notifyCustomer ? '1' : '0', override: '0' })
			.then(j => {
				if (j.success) {
					closeFlowTransition();
					showAlertAndReload('{{ text_success }}');
				} else if (j.error) {
					showAlert(j.error, 'danger');
				}
			});
	};
	const shipSection = document.getElementById('flow-shipping-section');
	if (shipSection && shipSection.style.display !== 'none') {
		const tracking = document.getElementById('flow-shipment-tracking').value.trim();
		if (!tracking) {
			showAlert('{{ error_tracking_number }}', 'danger');
			return;
		}
		const items = [];
		document.querySelectorAll('#flow-shipment-items input[data-shipment-qty]').forEach(inp => {
			const qty = parseInt(inp.value, 10) || 0;
			if (qty > 0) items.push({ order_product_id: inp.dataset.shipmentQty, quantity: qty });
		});
		if (!items.length) {
			showAlert('{{ error_shipment_items }}', 'danger');
			return;
		}
		api('index.php?route=sale/order_detail/addShipment&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
			'POST', { tracking_number: tracking, comment: '', items: JSON.stringify(items), notify: notify ? '1' : '0' })
			.then(j => {
				if (j.success) {
					if (j.shipments_html) refreshShipmentsCard(j.shipments_html);
					doTransition(false);
				} else if (j.error) {
					showAlert(j.error, 'danger');
				}
			});
	} else {
		doTransition(notify);
	}
}

