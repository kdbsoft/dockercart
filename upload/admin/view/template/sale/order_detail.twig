<script>
const USER_TOKEN = '{{ user_token }}';
const ORDER_ID = {{ order_id }};
let isEditing = false;

function toggleEditMode() {
	if (isEditing) {
		revertAllInputs();
		return;
	}
	isEditing = true;
	document.querySelectorAll('.view-only').forEach(el => el.style.display = 'none');
	document.querySelectorAll('.edit-only').forEach(el => el.style.display = '');
	document.getElementById('btn-edit').style.display = 'none';
	document.getElementById('edit-actions').style.display = '';
	document.getElementById('edit-mode-banner').style.display = '';
}

function toggleSameAddress() {
	const cb = document.getElementById('same-address-cb');
	const el = document.getElementById('edit-payment-address');
	if (el) el.style.display = cb.checked ? 'none' : '';
}

function api(url, method, data) {
	const opts = { method: method || 'POST' };
	if (method !== 'GET') {
		opts.headers = { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' };
		opts.body = data ? new URLSearchParams(data) : undefined;
	}
	return fetch(url, opts).then(function(r) { return r.json(); });
}

function getCurrencyFormat() {
	const row = document.querySelector('.order-totals-card__row[data-total-code="sub_total"] .order-totals-card__value');
	if (!row) return { symbol: '₴', decimals: 2, dec: '.', thou: '' };
	const text = row.textContent.trim();
	const symbol = text.replace(/[\d\s.,\-]+/g, '').trim();
	const hasSpace = /\d\s+\S/.test(text) || /\S\s+\d/.test(text);
	const prefix = text.indexOf(symbol) < text.search(/\d/);
	let dec = '.', thou = '';
	const withoutSymbol = text.replace(symbol, '').trim();
	const lastDot = withoutSymbol.lastIndexOf('.');
	const lastComma = withoutSymbol.lastIndexOf(',');
	if (lastDot > lastComma) { dec = '.'; thou = ','; }
	else if (lastComma > lastDot) { dec = ','; thou = '.'; }
	else { dec = '.'; thou = ''; }
	return { symbol, decimals: 2, dec, thou, prefix, space: hasSpace };
}

let _currencyFmt = null;
function formatCurrency(amount) {
	if (!_currencyFmt) _currencyFmt = getCurrencyFormat();
	const f = _currencyFmt;
	const fixed = Math.abs(amount).toFixed(f.decimals);
	let [intPart, decPart] = fixed.split('.');
	intPart = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, f.thou);
	let result = intPart;
	if (f.decimals > 0 && decPart) result += f.dec + decPart;
	if (f.space) result = ' ' + result;
	if (f.prefix) result = f.symbol + result; else result = result + f.symbol;
	if (amount < 0) result = '-' + result;
	return result;
}

function previewRecalc(card) {
	const opid = card.dataset.orderProductId;
	const priceInput = card.querySelector('input[data-field="price"]');
	const qtyInput = card.querySelector('input[data-field="quantity"]');
	const origPrice = parseFloat(card.dataset.priceRaw) || 0;
	const origTax = parseFloat(card.dataset.taxRaw) || 0;
	const newPrice = priceInput ? (parseFloat(priceInput.value) || 0) : origPrice;
	const newQty = qtyInput ? (parseInt(qtyInput.value, 10) || 0) : 0;
	const taxRate = origPrice > 0 ? origTax / origPrice : 0;

	const productTotal = newPrice * newQty;
	const productTax = productTotal * taxRate;

	const totalEl = card.querySelector('.order-product-card__total');
	if (totalEl) totalEl.textContent = '= ' + formatCurrency(productTotal);

	let allProductTotal = 0;
	let allProductTax = 0;
	document.querySelectorAll('.order-product-card').forEach(c => {
		const p = c === card ? productTotal : (parseFloat(c.dataset.priceRaw) * (parseInt(c.querySelector('input[data-field="quantity"]')?.value || c.querySelector('.order-product-card__qty .view-only')?.textContent || 0, 10)));
		const t = c === card ? productTax : (parseFloat(c.dataset.taxRaw) * (parseInt(c.querySelector('input[data-field="quantity"]')?.value || c.querySelector('.order-product-card__qty .view-only')?.textContent || 0, 10)));
		allProductTotal += p;
		allProductTax += t;
	});

	const container = document.querySelector('.order-totals-card');
	if (!container) return;
	const rows = container.querySelectorAll('.order-totals-card__row');
	let nonDynamic = 0;
	rows.forEach(row => {
		const code = row.dataset.totalCode;
		if (code === 'sub_total') {
			row.querySelector('.order-totals-card__value').textContent = formatCurrency(allProductTotal);
			const cntEl = container.querySelector('.order-total-items-count');
			if (cntEl) {
				let totalQty = 0;
				document.querySelectorAll('.order-product-card').forEach(c => {
					const qi = c.querySelector('input[data-field="quantity"]');
					totalQty += qi ? (parseInt(qi.value, 10) || 0) : 0;
				});
				cntEl.textContent = totalQty;
			}
		} else if (code === 'tax') {
			row.querySelector('.order-totals-card__value').textContent = formatCurrency(allProductTax);
		} else if (code === 'total') {
			row.querySelector('.order-totals-card__value').textContent = formatCurrency(allProductTotal + nonDynamic);
		} else {
			const valEl = row.querySelector('.order-totals-card__value');
			const parsed = parseFloat(valEl.textContent.replace(/[^\d.\-]/g, '').replace(',', '.')) || 0;
			nonDynamic += parsed;
		}
	});
}

function revertAllInputs() {
	document.querySelectorAll('.order-product-card').forEach(card => {
		const priceInput = card.querySelector('input[data-field="price"]');
		const qtyInput = card.querySelector('input[data-field="quantity"]');
		if (priceInput) priceInput.value = priceInput.defaultValue;
		if (qtyInput) qtyInput.value = qtyInput.defaultValue;
		const totalEl = card.querySelector('.order-product-card__total');
		const origTotal = parseFloat(card.dataset.priceRaw) * parseInt(qtyInput?.defaultValue || 0, 10);
		const origTax = parseFloat(card.dataset.taxRaw) * parseInt(qtyInput?.defaultValue || 0, 10);
		if (totalEl) totalEl.textContent = '= ' + formatCurrency(origTotal);
	});
	_currencyFmt = null;
	const container = document.querySelector('.order-totals-card');
	if (container) {
		const rows = container.querySelectorAll('.order-totals-card__row');
		rows.forEach(row => row.dataset.totalOriginalText = '');
	}
	location.reload();
}

function showAlert(msg, type) {
	const c = document.querySelector('#content > .container-fluid');
	c.insertAdjacentHTML('afterbegin',
		'<div class="row"><div class="col-sm-12 col-lg-offset-1 col-lg-10 col-xl-offset-1 col-xl-10"><div class="alert alert-' + (type || 'success') + ' alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' +
		msg + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div></div></div>');
	lucide.createIcons();
	setTimeout(() => { const a = c.querySelector('.alert'); if (a) a.remove(); }, 5000);
}

let recalcTimers = {};

function saveChanges() {
	Object.keys(recalcTimers).forEach(k => clearTimeout(recalcTimers[k]));
	recalcTimers = {};
	const promises = [];
	document.querySelectorAll('.order-product-card').forEach(card => {
		const opid = card.dataset.orderProductId;
		const qtyInput = card.querySelector('input[data-field="quantity"]');
		const priceInput = card.querySelector('input[data-field="price"]');
		if (qtyInput && qtyInput.value !== qtyInput.defaultValue) {
			promises.push(api('index.php?route=sale/order_detail/updateProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
				'POST', { order_product_id: opid, field: 'quantity', value: qtyInput.value }));
		}
		if (priceInput && priceInput.value !== priceInput.defaultValue) {
			promises.push(api('index.php?route=sale/order_detail/updateProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
				'POST', { order_product_id: opid, field: 'price', value: priceInput.value }));
		}
	});
	document.querySelectorAll('.dcx-sidebar-card input[data-field], .dcx-sidebar-card select[data-field]').forEach(input => {
		const viewEl = document.querySelector('.view-only[data-field="' + input.dataset.field + '"]');
		if (viewEl && input.value !== viewEl.textContent.trim()) {
			promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
				'POST', { field: input.dataset.field, value: input.value }));
		}
	});
	const sameCb = document.getElementById('same-address-cb');
	function collectAddr(id) {
		const el = document.getElementById(id);
		if (!el) return null;
		const f = {};
		el.querySelectorAll('[data-address-field]').forEach(e => { f[e.dataset.addressField] = e.value; });
		return Object.keys(f).length ? f : null;
	}
	const shipF = collectAddr('edit-shipping-address');
	if (shipF) promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST', shipF));
	if (!sameCb || !sameCb.checked) {
		const payF = collectAddr('edit-payment-address');
		if (payF) promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST', payF));
	}
	const statusEl = document.getElementById('edit-order-status');
	if (statusEl) {
		const commentEl = document.getElementById('edit-comment');
		promises.push(api('index.php?route=sale/order_detail/addHistory&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
			'POST', { order_status_id: statusEl.value, notify: '0', comment: commentEl ? commentEl.value : '' }));
	}
	Promise.all(promises).then(() => {
		showAlert('{{ text_order_saved }}');
		toggleEditMode();
		location.reload();
	});
}

function removeProduct(btn) {
	const card = btn.closest('.order-product-card');
	if (!confirm('{{ text_confirm }}')) return;
	api('index.php?route=sale/order_detail/removeProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
		'POST', { order_product_id: card.dataset.orderProductId }).then(j => { if (j.success) { card.remove(); location.reload(); } });
}

function addProduct() {
	const pid = document.getElementById('product-id').value;
	const qty = document.getElementById('product-qty').value || 1;
	if (!pid || pid === '0') return;
	api('index.php?route=sale/order_detail/addProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
		'POST', { product_id: pid, quantity: qty }).then(j => { if (j.product) location.reload(); });
}

function loadTimeline(page) {
	page = page || 1;
	const c = document.getElementById('timeline-container');
	api('index.php?route=sale/order_detail/getTimeline&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID + '&page=' + page, 'GET')
		.then(j => {
			if (!j.html) return;
			const tmp = document.createElement('div');
			tmp.innerHTML = j.html;
			if (page === 1) {
				c.innerHTML = tmp.innerHTML;
			} else {
				const loadMoreBtn = c.querySelector('.timeline-load-more');
				if (loadMoreBtn) loadMoreBtn.remove();
				const entries = tmp.querySelectorAll('.timeline-entry');
				const container = c.querySelector('.timeline-entries') || c;
				entries.forEach(e => container.appendChild(e));
				const newLoadMore = tmp.querySelector('.timeline-load-more');
				if (newLoadMore) c.appendChild(newLoadMore);
			}
			lucide.createIcons();
		});
}

function addTimelineNote() {
	const comment = document.getElementById('tl-note-comment').value;
	const notify = document.getElementById('tl-note-notify') ? document.getElementById('tl-note-notify').checked : false;
	if (!comment.trim()) return;
	api('index.php?route=sale/order_detail/addNote&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
		'POST', { comment: comment, notify: notify ? '1' : '0' })
		.then(j => { if (j.success) { document.getElementById('tl-note-comment').value = ''; loadTimeline(1); } });
}

function addTimelineHistory() {
	const statusId = document.getElementById('tl-history-status').value;
	const comment = document.getElementById('tl-history-comment').value;
	const notify = document.getElementById('tl-history-notify') ? document.getElementById('tl-history-notify').checked : false;
	const override = document.getElementById('tl-history-override') ? document.getElementById('tl-history-override').checked : false;
	if (!statusId || statusId === '0') return;
	api('index.php?route=sale/order_detail/addHistory&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
		'POST', { order_status_id: statusId, comment: comment, notify: notify ? '1' : '0', override: override ? '1' : '0' })
		.then(j => { if (j.success) { document.getElementById('tl-history-comment').value = ''; loadTimeline(1); } });
}

function addReward() { api('index.php?route=sale/order_detail/addReward&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST').then(j => { if (j.success) showAlert(j.success); }); }
function removeReward() { api('index.php?route=sale/order_detail/removeReward&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST').then(j => { if (j.success) showAlert(j.success); }); }
function addCommission() { api('index.php?route=sale/order_detail/addCommission&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST').then(j => { if (j.success) showAlert(j.success); }); }
function removeCommission() { api('index.php?route=sale/order_detail/removeCommission&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST').then(j => { if (j.success) showAlert(j.success); }); }

const zonesCache = {};
function loadZones(countrySelect, targetSel) {
	const countryId = countrySelect.value;
	document.querySelector(targetSel).innerHTML = '<option value="0">{{ text_none }}</option>';
	if (!countryId) return;
	if (!zonesCache[countryId]) {
		zonesCache[countryId] = api('index.php?route=localisation/country/country&user_token=' + USER_TOKEN + '&country_id=' + countryId, 'GET').then(j => {
			if (j.zone) {
				zonesCache[countryId] = typeof j.zone === 'string' ? JSON.parse(j.zone) : j.zone;
			}
			return zonesCache[countryId];
		});
	}
	Promise.resolve(zonesCache[countryId]).then(zones => {
		if (zones && zones.length) {
			let h = '<option value="0">{{ text_none }}</option>';
			zones.forEach(z => { h += '<option value="' + z.zone_id + '">' + z.name + '</option>'; });
			document.querySelector(targetSel).innerHTML = h;
		}
	});
}

function toggleBrowserInfo() {
	const el = document.getElementById('browser-info');
	const ch = document.getElementById('browser-chevron');
	const txt = document.getElementById('browser-toggle-text');
	const open = el.style.display !== 'none';
	el.style.display = open ? 'none' : '';
	ch.style.transform = open ? '' : 'rotate(90deg)';
	txt.textContent = open ? '{{ text_show_browser_info }}' : '{{ text_hide_browser_info }}';
}

document.addEventListener('DOMContentLoaded', function() {
	loadTimeline(1);

	const shipCountry = document.querySelector('[data-address-field="shipping_country_id"]');
	if (shipCountry && shipCountry.value) loadZones(shipCountry, '#edit-ship-zone');
	const payCountry = document.querySelector('[data-address-field="payment_country_id"]');
	if (payCountry && payCountry.value) loadZones(payCountry, '#edit-pay-zone');

	document.addEventListener('input', function(e) {
		const input = e.target;
		if (!input.matches('.order-product-card input[data-field="price"], .order-product-card input[data-field="quantity"]')) return;
		const card = input.closest('.order-product-card');
		if (!card) return;
		const opid = card.dataset.orderProductId;
		clearTimeout(recalcTimers[opid]);
		recalcTimers[opid] = setTimeout(() => previewRecalc(card), 300);
	});

	let selectedProductOptions = [];
	const ps = document.getElementById('product-search');
	const pidInput = document.getElementById('product-id');
	const ppriceInput = document.getElementById('product-price');
	const optsContainer = document.getElementById('product-options-container');
	const dropdown = document.getElementById('product-dropdown');

	if (ps && dropdown) {
		let debounce;
		ps.addEventListener('input', function() {
			const input = this;
			clearTimeout(debounce);
			debounce = setTimeout(function() {
				const val = input.value.trim();
				if (val.length < 2) { pidInput.value = '0'; ppriceInput.value = '0'; selectedProductOptions = []; optsContainer.style.display = 'none'; dropdown.style.display = 'none'; dropdown.innerHTML = ''; return; }
				api('index.php?route=catalog/product/autocomplete&user_token=' + USER_TOKEN + '&filter_name=' + encodeURIComponent(val), 'GET').then(function(j) {
					if (!j || !j.length) { dropdown.style.display = 'none'; dropdown.innerHTML = ''; return; }
					dropdown.innerHTML = '';
					j.forEach(function(p) {
						const item = document.createElement('div');
						item.className = 'dcx-picker__item';
						const optBadge = p.option && p.option.length ? '<span class="dcx-picker__opt-badge">' + p.option.length + ' opts</span>' : '';
						item.innerHTML = '<div style="flex:1;min-width:0"><div class="dcx-picker__name">' + p.name + optBadge + '</div><div class="dcx-picker__sub">' + (p.model || '') + '</div></div><div class="dcx-picker__price">' + (p.price || '') + '</div>';
						item.addEventListener('click', function(e) {
							e.stopPropagation();
							pidInput.value = p.product_id;
							ppriceInput.value = p.price || '0';
							ps.value = p.name;
							selectedProductOptions = p.option || [];
							console.log('Selected product: ' + p.name + ' options=', selectedProductOptions);
							renderProductOptions(selectedProductOptions);
							dropdown.style.display = 'none';
							dropdown.innerHTML = '';
						});
						dropdown.appendChild(item);
					});
					dropdown.style.display = 'block';
				}).catch(function(err) { console.error('Product search error:', err); });
			}, 200);
		});

		ps.addEventListener('focus', function() {
			if (dropdown.innerHTML && dropdown.children.length) dropdown.style.display = 'block';
		});

		document.addEventListener('mousedown', function(e) {
			if (!dropdown.contains(e.target) && e.target !== ps) {
				dropdown.style.display = 'none';
			}
		});
	}

	function renderProductOptions(options) {
		console.log('renderProductOptions: ', options);
		if (!options || !options.length) { optsContainer.style.display = 'none'; optsContainer.innerHTML = ''; return; }
		optsContainer.style.display = '';
		optsContainer.innerHTML = '';
		options.forEach(opt => {
			const group = document.createElement('div');
			group.className = 'product-option-group';
			group.dataset.productOptionId = opt.product_option_id;
			group.dataset.optionId = opt.option_id;
			group.dataset.optionType = opt.type;
			group.dataset.optionName = opt.name;

			const reqMark = opt.required ? '<span class="product-option-group__required">*</span>' : '';
			group.innerHTML = '<label class="product-option-group__label">' + opt.name + reqMark + '</label>';

			const valuesDiv = document.createElement('div');
			valuesDiv.className = 'product-option-group__values';

			if (opt.type === 'select' || opt.type === 'radio' || opt.type === 'image' || opt.type === 'color') {
				(opt.product_option_value || []).forEach(v => {
					const pill = document.createElement('label');
					pill.className = 'product-option-pill';
					pill.dataset.povId = v.product_option_value_id;
					pill.dataset.value = v.name;
					pill.innerHTML = '<input type="radio" name="po_' + opt.product_option_id + '" value="' + v.product_option_value_id + '" data-name="' + opt.name + '" data-value="' + v.name + '" data-type="' + opt.type + '">' + v.name;
					if (opt.required) pill.querySelector('input').required = true;
					pill.addEventListener('click', () => {
						valuesDiv.querySelectorAll('.product-option-pill').forEach(p => p.classList.remove('product-option-pill--active'));
						pill.classList.add('product-option-pill--active');
					});
					valuesDiv.appendChild(pill);
				});
			} else if (opt.type === 'checkbox') {
				(opt.product_option_value || []).forEach(v => {
					const lbl = document.createElement('label');
					lbl.className = 'product-option-checkbox';
					lbl.innerHTML = '<input type="checkbox" name="po_' + opt.product_option_id + '[]" value="' + v.product_option_value_id + '" data-name="' + opt.name + '" data-value="' + v.name + '" data-type="' + opt.type + '">' + v.name;
					valuesDiv.appendChild(lbl);
				});
			} else {
				const wrap = document.createElement('div');
				wrap.className = 'product-option-text';
				wrap.innerHTML = '<input type="text" class="form-control" name="po_' + opt.product_option_id + '" placeholder="' + opt.name + '" data-name="' + opt.name + '" data-type="' + opt.type + '">';
				valuesDiv.appendChild(wrap);
			}

			group.appendChild(valuesDiv);
			optsContainer.appendChild(group);
		});
	}
});

function addProduct() {
	const pid = document.getElementById('product-id').value;
	const qty = document.getElementById('product-qty').value || 1;
	if (!pid || pid === '0') return;

	const groups = document.querySelectorAll('#product-options-container .product-option-group');
	console.log('addProduct: groups found=' + groups.length);

	const options = [];
	groups.forEach(group => {
		const productOptionId = group.dataset.productOptionId;
		const optionName = group.dataset.optionName;
		const optionType = group.dataset.optionType;
		const checkedInputs = group.querySelectorAll('input:checked');
		console.log('  group: ' + optionName + ' type=' + optionType + ' checked=' + checkedInputs.length);

		checkedInputs.forEach(input => {
			console.log('    checked: value=' + input.value + ' data-value=' + input.dataset.value);
			options.push({
				product_option_id: productOptionId,
				product_option_value_id: input.value,
				name: input.dataset.name || optionName,
				value: input.dataset.value || input.value,
				type: input.dataset.type || optionType
			});
		});

		if (optionType === 'text' || optionType === 'textarea' || optionType === 'file') {
			const textInput = group.querySelector('input[type="text"], textarea');
			if (textInput && textInput.value.trim()) {
				options.push({
					product_option_id: productOptionId,
					product_option_value_id: 0,
					name: optionName,
					value: textInput.value.trim(),
					type: optionType
				});
			}
		}
	});

	console.log('addProduct: FINAL options=', options);

	const requiredOpts = document.querySelectorAll('#product-options-container .product-option-group');
	const missingRequired = [];
	requiredOpts.forEach(group => {
		const optId = group.dataset.productOptionId;
		const hasSelection = group.querySelector('input:checked, input[type="text"][value]:not([value=""])');
		const isRequired = group.querySelector('.product-option-group__required');
		if (isRequired && !hasSelection) {
			missingRequired.push(group.dataset.optionName);
		}
	});
	if (missingRequired.length) {
		showAlert('Выберите: ' + missingRequired.join(', '), 'warning');
		return;
	}

	const data = { product_id: pid, quantity: qty };
	if (options.length) data.options = JSON.stringify(options);

	console.log('addProduct: pid=' + pid + ' qty=' + qty + ' options=', options);

	api('index.php?route=sale/order_detail/addProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
		'POST', data).then(j => {
			if (j.error) {
				showAlert(j.error, 'danger');
			} else if (j.success) {
				location.reload();
			}
		});
}

function showProductCard(productId, orderProductId) {
	if (!productId) return;
	let overlay = document.getElementById('pcm-overlay');
	if (!overlay) {
		overlay = document.createElement('div');
		overlay.id = 'pcm-overlay';
		overlay.className = 'pcm-overlay';
		document.body.appendChild(overlay);
	}
	overlay.innerHTML = '<div class="pcm-spinner"><div class="spinner"></div></div>';
	overlay.style.display = 'flex';
	overlay.onclick = function(e) { if (!e.target.closest('.pcm-modal')) closeProductCard(); };

	api('index.php?route=sale/order_detail/getProductCard&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID + '&product_id=' + productId + '&order_product_id=' + (orderProductId || 0), 'GET')
		.then(j => {
			if (j.html) {
				overlay.innerHTML = '<div class="pcm-modal">' + j.html + '<button type="button" class="pcm-close" onclick="closeProductCard()"><i data-lucide="x" width="18" height="18"></i></button></div>';
				lucide.createIcons();
			} else {
				closeProductCard();
			}
		});
}

function closeProductCard() {
	const o = document.getElementById('pcm-overlay');
	if (o) o.style.display = 'none';
}

function pcmSwitchImage(thumb) {
	const full = thumb.dataset.full;
	if (!full) return;
	const mainImg = document.getElementById('pcm-main-img');
	if (mainImg) mainImg.innerHTML = '<img src="' + full + '">';
	document.querySelectorAll('.pcm-thumb').forEach(t => t.classList.remove('pcm-thumb--active'));
	thumb.classList.add('pcm-thumb--active');
}

document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeProductCard(); });

document.addEventListener('click', function(e) {
	const link = e.target.closest('.order-product-card__name a, .order-product-card__thumb');
	if (!link) return;
	const card = link.closest('.order-product-card');
	if (!card) return;
	const viewMode = card.closest('.order-products-list');
	if (!viewMode) return;
	if (card.querySelector('.edit-only') && card.querySelector('.edit-only').style.display !== 'none') return;
	e.preventDefault();
	showProductCard(card.dataset.productId, card.dataset.orderProductId);
});
