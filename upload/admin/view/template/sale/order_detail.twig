<script>
const USER_TOKEN = '{{ user_token }}';
const ORDER_ID = {{ order_id }};
const SHIPPING_STATUS_ID = {{ shipping_status_id }};
const EDIT_MODE = {{ edit_mode ? 'true' : 'false' }};
const SHIPPING_ZONE_ID = {{ shipping_zone_id }};
const PAYMENT_ZONE_ID = {{ payment_zone_id }};
let isEditing = false;

function duplicateOrder() {
	api('index.php?route=sale/order_detail/duplicate&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST')
		.then(j => {
			if (j.error) {
				showAlert(j.error, 'danger');
				return;
			}
			if (j.redirect) {
				location.href = j.redirect;
			}
		});
}

function toggleEditMode() {
	if (isEditing) {
		revertAllInputs();
		return;
	}
	isEditing = true;
	document.body.classList.add('dcx-global-editing');
	document.querySelectorAll('.view-only').forEach(el => el.style.display = 'none');
	document.querySelectorAll('.edit-only').forEach(el => el.style.display = '');
	document.getElementById('btn-edit').style.display = 'none';
	document.getElementById('edit-actions').style.display = '';
	document.getElementById('edit-mode-banner').style.display = '';
}

let activePanel = null;

function togglePanelEditMode(panelId) {
	if (isEditing) {
		showAlert('Сначала завершите глобальное редактирование', 'warning');
		return;
	}
	const panel = document.querySelector('[data-panel="' + panelId + '"]');
	if (!panel) return;
	if (activePanel === panelId) {
		location.reload();
		return;
	}
	activePanel = panelId;
	panel.dataset.editing = 'true';
	panel.querySelectorAll('.view-only').forEach(el => el.style.display = 'none');
	panel.querySelectorAll('.edit-only').forEach(el => el.style.display = '');
}

function savePanelChanges(panelId) {
	const panel = document.querySelector('[data-panel="' + panelId + '"]');
	if (!panel) return;
	if (panelId === 'order-products') {
		Object.keys(recalcTimers).forEach(k => clearTimeout(recalcTimers[k]));
		const promises = [];
		const discountValues = [];
		let discountChanged = false;
		panel.querySelectorAll('.order-product-card').forEach(card => {
			const opid = card.dataset.orderProductId;
			const qtyInput = card.querySelector('input[data-field="quantity"]');
			const priceInput = card.querySelector('input[data-field="price"]');
			if (qtyInput && qtyInput.value !== qtyInput.defaultValue) {
				promises.push(api('index.php?route=sale/order_detail/updateProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
					'POST', { order_product_id: opid, field: 'quantity', value: qtyInput.value }));
			}
			if (priceInput && priceInput.value !== priceInput.defaultValue) {
				promises.push(api('index.php?route=sale/order_detail/updateProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
					'POST', { order_product_id: opid, field: 'price', value: priceInput.value }));
			}
			const discInput = card.querySelector('input[data-field="discount"]');
			const origDisc = parseFloat(card.dataset.discountOriginal) || 0;
			const newDisc = discInput ? (parseFloat(discInput.value) || 0) : origDisc;
			discountValues.push(newDisc);
			if (Math.abs(newDisc - origDisc) > 0.001) discountChanged = true;
		});
		Promise.all(promises).then(() => {
			if (!discountChanged) {
				showAlertAndReload('{{ text_order_saved }}');
				return;
			}
			api('index.php?route=sale/order_detail/applyLineDiscounts&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
				'POST', { discount: JSON.stringify(discountValues) }).then(j => {
					if (j.success) {
						showAlertAndReload('{{ text_order_saved }}');
					} else if (j.error) {
						showAlert(j.error, 'danger');
					}
				});
		});
	} else if (panelId === 'buyer') {
		const promises = [];
		panel.querySelectorAll('input[data-field], select[data-field]').forEach(input => {
			const viewEl = panel.querySelector('.view-only[data-field="' + input.dataset.field + '"]');
			const oldVal = viewEl ? viewEl.textContent.trim() : input.defaultValue;
			if (input.value !== oldVal) {
				promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
					'POST', { field: input.dataset.field, value: input.value }));
			}
		});
		function collectAddrChanges(id) {
			const el = panel.querySelector('#' + id);
			if (!el) return [];
			const changes = [];
			el.querySelectorAll('[data-address-field]').forEach(e => {
				if (e.value !== e.defaultValue) {
					changes.push({ field: e.dataset.addressField, value: e.value });
				}
			});
			return changes;
		}
		collectAddrChanges('edit-shipping-address').forEach(f => {
			promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
				'POST', { field: f.field, value: f.value }));
		});
		const sameCb = panel.querySelector('#same-address-cb');
		if (sameCb && sameCb.checked) {
			syncPaymentFromShipping().forEach(f => {
				promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
					'POST', { field: f.field, value: f.value }));
			});
		} else {
			collectAddrChanges('edit-payment-address').forEach(f => {
				promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
					'POST', { field: f.field, value: f.value }));
			});
		}
		Promise.all(promises).then(() => {
			showAlertAndReload('{{ text_order_saved }}');
		});
	} else if (panelId === 'order-details') {
		const promises = [];
		panel.querySelectorAll('input[data-field], select[data-field]').forEach(input => {
			const viewEl = panel.querySelector('.view-only[data-field="' + input.dataset.field + '"]');
			const oldVal = viewEl ? viewEl.textContent.trim() : input.defaultValue;
			if (input.value !== oldVal) {
				promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
					'POST', { field: input.dataset.field, value: input.value }));
				if (input.dataset.codeField) {
					const selectedOption = input.options[input.selectedIndex];
					const newCode = selectedOption ? selectedOption.dataset.code : '';
					const oldCodeEl = panel.querySelector('[data-field="' + input.dataset.codeField + '"]');
					const oldCode = oldCodeEl ? oldCodeEl.textContent.trim() : '';
					if (newCode && newCode !== oldCode) {
						promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
							'POST', { field: input.dataset.codeField, value: newCode }));
					}
				}
			}
		});
		const commentEl = panel.querySelector('#edit-comment');
		if (commentEl && commentEl.value !== commentEl.defaultValue) {
			promises.push(api('index.php?route=sale/order_detail/updateField&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
				'POST', { field: 'comment', value: commentEl.value }));
		}
		Promise.all(promises).then(() => {
			showAlertAndReload('{{ text_order_saved }}');
		});
	}
}

function toggleSameAddress() {
	const cb = document.getElementById('same-address-cb');
	const el = document.getElementById('edit-payment-address');
	if (el) el.style.display = cb.checked ? 'none' : '';
}

let shippingPreviewTimer = null;

function onShippingMethodChange(select) {
	const codeOption = select.options[select.selectedIndex];
	const code = codeOption ? (codeOption.dataset.code || '') : '';
	const shipAddr = document.getElementById('edit-shipping-address');
	const country = shipAddr && shipAddr.querySelector('[data-address-field="shipping_country_id"]') ? shipAddr.querySelector('[data-address-field="shipping_country_id"]').value : '0';
	const zone = shipAddr && shipAddr.querySelector('[data-address-field="shipping_zone_id"]') ? shipAddr.querySelector('[data-address-field="shipping_zone_id"]').value : '0';
	const subTotalEl = document.querySelector('.order-totals-card__row[data-total-code="sub_total"] .order-totals-card__value');
	const subtotal = subTotalEl ? (parseFloat(subTotalEl.textContent.replace(/[^\d.\-]/g, '').replace(',', '.')) || 0) : 0;

	clearTimeout(shippingPreviewTimer);
	shippingPreviewTimer = setTimeout(() => {
		api('index.php?route=sale/order_detail/quoteShipping&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
			'POST', { shipping_code: code, shipping_country_id: country, shipping_zone_id: zone, subtotal: subtotal })
			.then(j => {
				if (!j || !j.available) return;
				applyShippingPreview(j.cost, j.title || '');
			});
	}, 250);
}

function applyShippingPreview(cost, title) {
	const container = document.querySelector('.order-totals-card');
	if (!container) return;
	const shipRow = container.querySelector('.order-totals-card__row[data-total-code="shipping"]');
	const totalRow = container.querySelector('.order-totals-card__row[data-total-code="total"]');
	if (!shipRow || !totalRow) return;
	const parseVal = el => parseFloat(el.textContent.replace(/[^\d.\-]/g, '').replace(',', '.')) || 0;
	const shipValEl = shipRow.querySelector('.order-totals-card__value');
	const totalValEl = totalRow.querySelector('.order-totals-card__value');
	const oldShip = parseVal(shipValEl);
	const oldTotal = parseVal(totalValEl);
	shipValEl.textContent = formatCurrency(cost);
	totalValEl.textContent = formatCurrency(oldTotal - oldShip + cost);
	if (title) {
		const label = shipRow.querySelector('.order-totals-card__label');
		if (label) label.textContent = title;
	}
}

function syncPaymentFromShipping() {
	const changes = [];
	const shipEl = document.getElementById('edit-shipping-address');
	const payEl = document.getElementById('edit-payment-address');
	if (!shipEl || !payEl) return changes;
	const ship = {};
	shipEl.querySelectorAll('[data-address-field]').forEach(e => {
		ship[e.dataset.addressField.replace(/^shipping_/, 'payment_')] = e.value;
	});
	payEl.querySelectorAll('[data-address-field]').forEach(e => {
		const key = e.dataset.addressField;
		const newVal = ship[key];
		if (newVal !== undefined && newVal !== e.value && newVal !== e.defaultValue) {
			changes.push({ field: key, value: newVal });
		}
	});
	return changes;
}

function api(url, method, data) {
	const opts = { method: method || 'POST' };
	if (method !== 'GET') {
		opts.headers = { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' };
		opts.body = data ? new URLSearchParams(data) : undefined;
	}
	return fetch(url, opts).then(function(r) { return r.json(); });
}

function getCurrencyFormat() {
	const container = document.querySelector('.order-totals-card');
	let decimals = 2;
	if (container && container.dataset.decimalPlace !== undefined) {
		const dp = parseInt(container.dataset.decimalPlace, 10);
		if (!isNaN(dp)) decimals = dp;
	}
	const row = document.querySelector('.order-totals-card__row[data-total-code="sub_total"] .order-totals-card__value');
	if (!row) return { symbol: '₴', decimals, dec: '.', thou: '' };
	const text = row.textContent.trim();
	const symbol = text.replace(/[\d\s.,\-]+/g, '').trim();
	const hasSpace = /\d\s+\S/.test(text) || /\S\s+\d/.test(text);
	const prefix = text.indexOf(symbol) < text.search(/\d/);
	let dec = '.', thou = '';
	const withoutSymbol = text.replace(symbol, '').trim();
	const lastDot = withoutSymbol.lastIndexOf('.');
	const lastComma = withoutSymbol.lastIndexOf(',');
	if (lastDot > lastComma) { dec = '.'; thou = ','; }
	else if (lastComma > lastDot) { dec = ','; thou = '.'; }
	else { dec = '.'; thou = ''; }
	return { symbol, decimals, dec, thou, prefix, space: hasSpace };
}

let _currencyFmt = null;
function formatCurrency(amount) {
	if (!_currencyFmt) _currencyFmt = getCurrencyFormat();
	const f = _currencyFmt;
	const fixed = Math.abs(amount).toFixed(f.decimals);
	let [intPart, decPart] = fixed.split('.');
	intPart = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, f.thou);
	let result = intPart;
	if (f.decimals > 0 && decPart) result += f.dec + decPart;
	if (f.space) result = ' ' + result;
	if (f.prefix) result = f.symbol + result; else result = result + f.symbol;
	if (amount < 0) result = '-' + result;
	return result;
}

function previewRecalc(card) {
	const opid = card.dataset.orderProductId;
	const priceInput = card.querySelector('input[data-field="price"]');
	const qtyInput = card.querySelector('input[data-field="quantity"]');
	const discInput = card.querySelector('input[data-field="discount"]');
	const origPrice = parseFloat(card.dataset.priceRaw) || 0;
	const origTax = parseFloat(card.dataset.taxRaw) || 0;
	const origQty = qtyInput ? (parseFloat(qtyInput.defaultValue) || 1) : 1;
	const newPrice = priceInput ? (parseFloat(priceInput.value) || 0) : origPrice;
	const newQty = qtyInput ? (parseFloat(qtyInput.value) || 0) : 0;
	const newDisc = discInput ? ((parseFloat(discInput.value) || 0) / 100) : 0;
	const taxRate = origPrice > 0 ? (origTax / origQty) / origPrice : 0;

	const productTotal = newPrice * newQty * (1 - newDisc);
	const productTax = productTotal * taxRate;

	const totalEl = card.querySelector('.order-product-card__total');
	if (totalEl) totalEl.textContent = '= ' + formatCurrency(productTotal);

	let allProductTotal = 0;
	let allProductTax = 0;
	document.querySelectorAll('.order-product-card').forEach(c => {
		const cDisc = parseFloat(c.querySelector('input[data-field="discount"]')?.value) || 0;
		const factor = 1 - cDisc / 100;
		const p = c === card ? productTotal : (parseFloat(c.dataset.priceRaw) * (parseFloat(c.querySelector('input[data-field="quantity"]')?.value || c.querySelector('.order-product-card__qty .view-only')?.textContent || 0)) * factor);
		const t = c === card ? productTax : (parseFloat(c.dataset.taxRaw) * factor);
		allProductTotal += p;
		allProductTax += t;
	});

	const container = document.querySelector('.order-totals-card');
	if (!container) return;
	const rows = container.querySelectorAll('.order-totals-card__row');
	let nonDynamic = 0;
	rows.forEach(row => {
		const code = row.dataset.totalCode;
		if (code === 'sub_total') {
			row.querySelector('.order-totals-card__value').textContent = formatCurrency(allProductTotal);
			const cntEl = container.querySelector('.order-total-items-count');
			if (cntEl) {
				let totalQty = 0;
				document.querySelectorAll('.order-product-card').forEach(c => {
					const qi = c.querySelector('input[data-field="quantity"]');
					totalQty += qi ? (parseInt(qi.value, 10) || 0) : 0;
				});
				cntEl.textContent = totalQty;
			}
		} else if (code === 'tax') {
			row.querySelector('.order-totals-card__value').textContent = formatCurrency(allProductTax);
		} else if (code === 'total') {
			row.querySelector('.order-totals-card__value').textContent = formatCurrency(allProductTotal + nonDynamic);
		} else {
			const valEl = row.querySelector('.order-totals-card__value');
			const parsed = parseFloat(valEl.textContent.replace(/[^\d.\-]/g, '').replace(',', '.')) || 0;
			nonDynamic += parsed;
		}
	});
}

function revertAllInputs() {
	document.querySelectorAll('.order-product-card').forEach(card => {
		const priceInput = card.querySelector('input[data-field="price"]');
		const qtyInput = card.querySelector('input[data-field="quantity"]');
		const discInput = card.querySelector('input[data-field="discount"]');
		if (priceInput) priceInput.value = priceInput.defaultValue;
		if (qtyInput) qtyInput.value = qtyInput.defaultValue;
		if (discInput) discInput.value = discInput.defaultValue;
		const totalEl = card.querySelector('.order-product-card__total');
		const origTotal = parseFloat(card.dataset.priceRaw) * parseFloat(qtyInput?.defaultValue || 0);
		const origTax = parseFloat(card.dataset.taxRaw) * parseFloat(qtyInput?.defaultValue || 0);
		if (totalEl) totalEl.textContent = '= ' + formatCurrency(origTotal);
	});
	_currencyFmt = null;
	const container = document.querySelector('.order-totals-card');
	if (container) {
		const rows = container.querySelectorAll('.order-totals-card__row');
		rows.forEach(row => row.dataset.totalOriginalText = '');
	}
	location.reload();
}

function showAlert(msg, type) {
	const c = document.querySelector('#content > .container-fluid');
	c.insertAdjacentHTML('afterbegin',
		'<div class="row"><div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10"><div class="alert alert-' + (type || 'success') + ' alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' +
		msg + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div></div></div>');
	lucide.createIcons();
	setTimeout(() => { const a = c.querySelector('.alert'); if (a) a.remove(); }, 5000);
}

function copyToClipboard(btn) {
	const html = btn.getAttribute('data-copy-html');
	let value;
	if (html !== null) {
		const div = document.createElement('div');
		div.innerHTML = html;
		div.querySelectorAll('br').forEach(br => br.replaceWith(document.createTextNode('\n')));
		value = div.textContent || '';
		value = value.replace(/\n{3,}/g, '\n\n').trim();
	} else {
		value = (btn.getAttribute('data-copy') || '').trim();
	}
	if (!value) return;
	const done = () => {
		btn.classList.add('is-copied');
		clearTimeout(btn._dcCopyTimer);
		btn._dcCopyTimer = setTimeout(() => btn.classList.remove('is-copied'), 1500);
	};
	if (navigator.clipboard && window.isSecureContext) {
		navigator.clipboard.writeText(value).then(done, () => fallbackCopy(value, done));
	} else {
		fallbackCopy(value, done);
	}
}

function fallbackCopy(text, done) {
	const ta = document.createElement('textarea');
	ta.value = text;
	ta.style.position = 'fixed';
	ta.style.opacity = '0';
	document.body.appendChild(ta);
	ta.select();
	try { document.execCommand('copy'); done(); } catch (e) {}
	document.body.removeChild(ta);
}

