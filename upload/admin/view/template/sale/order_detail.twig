			'&filter_any=1&filter_name=' + encodeURIComponent(val) +
			'&filter_model=' + encodeURIComponent(val) +
			'&filter_sku=' + encodeURIComponent(val) + '&limit=10';
		if (picker) {
			if (picker.dataset.currencyCode) {
				url += '&currency_code=' + encodeURIComponent(picker.dataset.currencyCode) + '&currency_value=' + encodeURIComponent(picker.dataset.currencyValue || '1');
			}
			if (picker.dataset.customerGroupId) {
				url += '&customer_group_id=' + encodeURIComponent(picker.dataset.customerGroupId);
			}
		}
		return url;
	}

	function hideDropdown() {
		dropdown.style.display = 'none';
		dropdown.innerHTML = '';
		dropdownItems = [];
		dropdownIndex = -1;
	}

	function buildStockBadge(p) {
		const b = document.createElement('span');
		if (p.stock && p.stock.not_tracked) {
			b.className = 'dcx-picker__stock dcx-picker__stock--na';
			b.textContent = '{{ text_stock_not_tracked }}';
		} else if (p.stock && p.stock.total > 0) {
			b.className = 'dcx-picker__stock dcx-picker__stock--in';
			b.textContent = '{{ text_stock_in }}: ' + p.stock.total;
		} else {
			b.className = 'dcx-picker__stock dcx-picker__stock--out';
			b.textContent = '{{ text_stock_out }}';
		}
		return b;
	}

	function renderDropdown(items) {
		dropdown.innerHTML = '';
		dropdownItems = items;
		dropdownIndex = -1;
		if (!items.length) {
			const empty = document.createElement('div');
			empty.className = 'dcx-picker__empty';
			empty.textContent = '{{ text_no_results }}';
			dropdown.appendChild(empty);
		} else {
			items.forEach((p, i) => {
				const item = document.createElement('div');
				item.className = 'dcx-picker__item';
				item.dataset.index = i;

				const thumb = document.createElement('img');
				thumb.className = 'dcx-picker__thumb';
				thumb.src = p.thumb || '';
				thumb.alt = '';

				const info = document.createElement('div');
				info.className = 'dcx-picker__info';
				const nameLine = document.createElement('div');
				nameLine.className = 'dcx-picker__name';
				const nameText = document.createElement('span');
				nameText.textContent = p.name;
				nameLine.appendChild(nameText);
				if (p.option && p.option.length) {
					const b = document.createElement('span');
					b.className = 'dcx-picker__opt-badge';
					b.textContent = p.option.length + ' {{ text_opts }}';
					nameLine.appendChild(b);
				}
				if (p.is_configurable) {
					const b = document.createElement('span');
					b.className = 'dcx-picker__config-badge';
					b.textContent = '{{ text_configurable }}';
					nameLine.appendChild(b);
				}
				const sub = document.createElement('div');
				sub.className = 'dcx-picker__sub';
				sub.textContent = [p.model, p.sku ? 'SKU: ' + p.sku : '', p.manufacturer].filter(Boolean).join(' · ');
				info.appendChild(nameLine);
				info.appendChild(sub);

				const right = document.createElement('div');
				right.className = 'dcx-picker__right';
				const priceEl = document.createElement('div');
				priceEl.className = 'dcx-picker__price';
				if (p.is_configurable && p.price_range_text) {
					priceEl.textContent = '{{ text_price_from }} ' + p.price_range_text.split(' – ')[0];
				} else {
					priceEl.textContent = p.price_text || '';
				}
				right.appendChild(priceEl);
				right.appendChild(buildStockBadge(p));

				item.appendChild(thumb);
				item.appendChild(info);
				item.appendChild(right);
				item.addEventListener('click', function(e) {
					e.stopPropagation();
					selectProduct(p);
				});
				dropdown.appendChild(item);
			});
		}
		dropdown.style.display = 'block';
	}

	function moveDropdown(step) {
		if (!dropdownItems.length) return;
		dropdownIndex = (dropdownIndex + step + dropdownItems.length) % dropdownItems.length;
		dropdown.querySelectorAll('.dcx-picker__item').forEach((el, i) => {
			el.classList.toggle('dcx-picker__item--active', i === dropdownIndex);
			if (i === dropdownIndex) el.scrollIntoView({ block: 'nearest' });
		});
	}

	if (ps && dropdown) {
		let debounce;
		ps.addEventListener('input', function() {
			const input = this;
			clearTimeout(debounce);
			debounce = setTimeout(function() {
				const val = input.value.trim();
				if (val.length < 2) {
					hideDropdown();
					return;
				}
				api(buildSearchUrl(val), 'GET').then(function(j) {
					renderDropdown(j || []);
				}).catch(function(err) { console.error('Product search error:', err); });
			}, 200);
		});

		ps.addEventListener('keydown', function(e) {
			if (e.key === 'ArrowDown') { moveDropdown(1); e.preventDefault(); }
			else if (e.key === 'ArrowUp') { moveDropdown(-1); e.preventDefault(); }
			else if (e.key === 'Enter') {
				if (dropdownItems[dropdownIndex]) {
					selectProduct(dropdownItems[dropdownIndex]);
				}
				e.preventDefault();
			} else if (e.key === 'Escape') {
				hideDropdown();
			}
		});

		ps.addEventListener('focus', function() {
			if (dropdown.innerHTML && dropdown.children.length) dropdown.style.display = 'block';
		});

		document.addEventListener('mousedown', function(e) {
			if (!dropdown.contains(e.target) && e.target !== ps) {
				hideDropdown();
			}
		});
	}

	function selectProduct(p) {
		pidInput.value = p.product_id;
		ps.value = p.name;
		hideDropdown();
		renderProductSummary(p);
		renderProductOptions(p.option || []);
		requestProductPreview();
	}

	function clearProductSelection() {
		pidInput.value = '0';
		ps.value = '';
		summary.style.display = 'none';
		summary.innerHTML = '';
		optsContainer.style.display = 'none';
		optsContainer.innerHTML = '';
		previewBox.style.display = 'none';
		previewBox.innerHTML = '';
		setAddButtonState(true);
	}

	function renderProductSummary(p) {
		summary.innerHTML = '';
		const thumb = document.createElement('img');
		thumb.className = 'order-product-summary__thumb';
		thumb.src = p.thumb || '';
		thumb.alt = '';

		const info = document.createElement('div');
		info.className = 'order-product-summary__info';
		const nameLine = document.createElement('div');
		nameLine.className = 'order-product-summary__name';
		const nameText = document.createElement('span');
		nameText.textContent = p.name;
		nameLine.appendChild(nameText);
		if (p.is_configurable) {
			const b = document.createElement('span');
			b.className = 'dcx-picker__config-badge';
			b.textContent = '{{ text_configurable }}';
			nameLine.appendChild(b);
		}
		const meta = document.createElement('div');
		meta.className = 'order-product-summary__meta';
		meta.textContent = [p.model, p.sku ? 'SKU: ' + p.sku : '', p.manufacturer].filter(Boolean).join(' · ');
		info.appendChild(nameLine);
		info.appendChild(meta);

		const priceEl = document.createElement('div');
		priceEl.className = 'order-product-summary__price' + (p.is_configurable ? ' order-product-summary__price--muted' : '');
		priceEl.textContent = (p.is_configurable && p.price_range_text) ? p.price_range_text : (p.price_text || '');

		const clearBtn = document.createElement('button');
		clearBtn.type = 'button';
		clearBtn.className = 'order-product-summary__clear';
		clearBtn.title = '{{ text_clear }}';
		clearBtn.innerHTML = '<i data-lucide="x" width="14" height="14"></i>';
		clearBtn.addEventListener('click', clearProductSelection);

		summary.appendChild(thumb);
		summary.appendChild(info);
		summary.appendChild(priceEl);
		summary.appendChild(clearBtn);
		summary.style.display = 'flex';
		lucide.createIcons();
	}

	function renderProductOptions(options) {
		if (!options || !options.length) { optsContainer.style.display = 'none'; optsContainer.innerHTML = ''; return; }
		optsContainer.style.display = '';
		optsContainer.innerHTML = '';
		options.forEach(opt => {
			const group = document.createElement('div');
			group.className = 'product-option-group';
			group.dataset.productOptionId = opt.product_option_id;
			group.dataset.optionId = opt.option_id;
			group.dataset.optionType = opt.type;
			group.dataset.optionName = opt.name;

			const reqMark = opt.required ? '<span class="product-option-group__required">*</span>' : '';
			group.innerHTML = '<label class="product-option-group__label">' + opt.name + reqMark + '</label>';

			const valuesDiv = document.createElement('div');
			valuesDiv.className = 'product-option-group__values';

			if (opt.type === 'select' || opt.type === 'radio' || opt.type === 'image' || opt.type === 'color') {
				(opt.product_option_value || []).forEach(v => {
					const pill = document.createElement('label');
					pill.className = 'product-option-pill';
					pill.dataset.povId = v.product_option_value_id;
					pill.dataset.value = v.name;
					const priceSpan = v.price_text ? '<span class="product-option-pill__price">' + v.price_text + '</span>' : '';
					pill.innerHTML = '<input type="radio" name="po_' + opt.product_option_id + '" value="' + v.product_option_value_id + '" data-name="' + opt.name + '" data-value="' + v.name + '" data-type="' + opt.type + '">' + v.name + priceSpan;
					if (opt.required) pill.querySelector('input').required = true;
					pill.addEventListener('click', () => {
						valuesDiv.querySelectorAll('.product-option-pill').forEach(p => p.classList.remove('product-option-pill--active'));
						pill.classList.add('product-option-pill--active');
					});
					valuesDiv.appendChild(pill);
				});
			} else if (opt.type === 'checkbox') {
				(opt.product_option_value || []).forEach(v => {
					const lbl = document.createElement('label');
					lbl.className = 'product-option-checkbox';
					const priceSpan = v.price_text ? '<span class="product-option-checkbox__price">' + v.price_text + '</span>' : '';
					lbl.innerHTML = '<input type="checkbox" name="po_' + opt.product_option_id + '[]" value="' + v.product_option_value_id + '" data-name="' + opt.name + '" data-value="' + v.name + '" data-type="' + opt.type + '">' + v.name + priceSpan;
					valuesDiv.appendChild(lbl);
				});
			} else {
				const wrap = document.createElement('div');
				wrap.className = 'product-option-text';
				wrap.innerHTML = '<input type="text" class="form-control" name="po_' + opt.product_option_id + '" placeholder="' + opt.name + '" data-name="' + opt.name + '" data-type="' + opt.type + '">';
				valuesDiv.appendChild(wrap);
			}

			group.appendChild(valuesDiv);
			optsContainer.appendChild(group);
		});
	}

	optsContainer.addEventListener('change', requestProductPreview);
	if (qtyInput) qtyInput.addEventListener('input', requestProductPreview);
	if (addBtn) addBtn.addEventListener('click', addProduct);

	function collectOptions() {
		const groups = document.querySelectorAll('#product-options-container .product-option-group');
		const options = [];
		groups.forEach(group => {
			const productOptionId = group.dataset.productOptionId;
			const optionName = group.dataset.optionName;
			const optionType = group.dataset.optionType;
			const checkedInputs = group.querySelectorAll('input:checked');

			checkedInputs.forEach(input => {
				options.push({
					product_option_id: productOptionId,
					product_option_value_id: input.value,
					name: input.dataset.name || optionName,
					value: input.dataset.value || input.value,
					type: input.dataset.type || optionType
				});
			});

			if (optionType === 'text' || optionType === 'textarea' || optionType === 'file') {
				const textInput = group.querySelector('input[type="text"], textarea');
				if (textInput && textInput.value.trim()) {
					options.push({
						product_option_id: productOptionId,
						product_option_value_id: 0,
						name: optionName,
						value: textInput.value.trim(),
						type: optionType
					});
				}
			}
		});
		return options;
	}

	function missingRequiredOptions() {
		const missing = [];
		document.querySelectorAll('#product-options-container .product-option-group').forEach(group => {
			const hasSelection = group.querySelector('input:checked, input[type="text"][value]:not([value=""]), textarea:not([value=""])');
			if (group.querySelector('.product-option-group__required') && !hasSelection) {
				missing.push(group.dataset.optionName);
			}
		});
		return missing;
	}

	function setAddButtonState(enabled) {
		if (addBtn) addBtn.disabled = !enabled;
	}

	function renderPreview(j) {
		previewBox.innerHTML = '';
		if (!j) { previewBox.style.display = 'none'; return; }
		previewBox.style.display = '';

		if (j.variant_error || j.error) {
			const row = document.createElement('div');
			row.className = 'order-product-preview__error';
			row.innerHTML = '<i data-lucide="alert-triangle" width="13" height="13"></i><span></span>';
			row.querySelector('span').textContent = j.variant_error || j.error;
			previewBox.appendChild(row);
			setAddButtonState(false);
			lucide.createIcons();
			return;
		}
		if (!j.price) { previewBox.style.display = 'none'; setAddButtonState(true); return; }

		setAddButtonState(true);
		const row = document.createElement('div');
		row.className = 'order-product-preview__row';

		const addPreviewItem = (label, value, className) => {
			const item = document.createElement('span');
			item.className = 'order-product-preview__item';
			const lbl = document.createElement('span');
			lbl.className = 'order-product-preview__label';
			lbl.textContent = label;
			const val = document.createElement('span');
			val.className = 'order-product-preview__value';
			val.textContent = value;
			item.appendChild(lbl);
			item.appendChild(val);
			row.appendChild(item);
		};

		if (j.variant && (j.variant.sku || j.variant.model)) {
			addPreviewItem('{{ text_variant }}: ', j.variant.sku || j.variant.model);
		}

		addPreviewItem('{{ text_unit_price }}: ', j.price);

		if (j.tax && parseFloat(j.tax_raw) > 0) {
			addPreviewItem('{{ text_tax }}: ', j.tax);
		}

		addPreviewItem('{{ text_line_total }}: ', j.total);

		if (j.subtract) {
			const stockItem = document.createElement('span');
			if (j.stock > 0) {
				stockItem.className = 'order-product-preview__stock-ok';
				stockItem.innerHTML = '<i data-lucide="circle-check" width="12" height="12"></i><span></span>';
				stockItem.querySelector('span').textContent = '{{ text_stock_in }}: ' + j.stock;
			} else {
				stockItem.className = 'order-product-preview__stock-warn';
				stockItem.innerHTML = '<i data-lucide="alert-triangle" width="12" height="12"></i><span></span>';
				stockItem.querySelector('span').textContent = '{{ text_stock_out }}';
			}
			row.appendChild(stockItem);
		}

		previewBox.appendChild(row);
		lucide.createIcons();
	}

	function requestProductPreview() {
		const pid = pidInput.value;
		const qty = qtyInput ? (qtyInput.value || 1) : 1;
		if (!pid || pid === '0') {
			previewBox.style.display = 'none';
			previewBox.innerHTML = '';
			setAddButtonState(true);
			return;
		}
		clearTimeout(previewTimer);
		previewTimer = setTimeout(() => {
			const seq = ++previewSeq;
			const data = { product_id: pid, quantity: qty };
			const options = collectOptions();
			if (options.length) data.options = JSON.stringify(options);
			api('index.php?route=sale/order_detail/previewProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID, 'POST', data).then(j => {
				if (seq !== previewSeq) return;
				renderPreview(j);
			}).catch(function() {});
		}, 250);
	}

	function updateTotalsUI(totals, totalQuantity) {
		const container = document.querySelector('.order-totals-card');
		if (!container) return;
		totals.forEach(t => {
			const row = container.querySelector('.order-totals-card__row[data-total-code="' + t.code + '"]');
			if (!row) return;
			const val = row.querySelector('.order-totals-card__value');
			if (val) val.textContent = t.text;
			if (t.code === 'sub_total' && totalQuantity !== undefined) {
				const label = row.querySelector('.order-totals-card__label');
				const base = row.dataset.labelBase;
				if (label && base) label.textContent = base + ' ({{ text_items }}: ' + totalQuantity + ')';
			}
		});
	}

	function appendProductCard(p) {
		const list = document.querySelector('.order-products-list');
		if (!list) return;
		const decimals = getCurrencyDecimals();

		const card = document.createElement('div');
		card.className = 'order-product-card';
		card.dataset.productId = p.product_id;
		card.dataset.orderProductId = p.order_product_id;
		card.dataset.priceRaw = (parseFloat(p.price_raw) || 0).toFixed(4);
		card.dataset.taxRaw = (parseFloat(p.tax_raw) || 0).toFixed(4);
		card.dataset.discountOriginal = '0';

		const editing = document.querySelector('[data-panel="order-products"]')?.dataset.editing === 'true';

		const posDiv = document.createElement('div');
		posDiv.className = 'order-product-card__pos';

		const thumb = document.createElement('div');
		thumb.className = 'order-product-card__thumb';
		const img = document.createElement('img');
		img.src = p.thumb || '';
		img.alt = p.name || '';
		thumb.appendChild(img);

		const info = document.createElement('div');
		info.className = 'order-product-card__info';
		const nameDiv = document.createElement('div');
		nameDiv.className = 'order-product-card__name';
		const link = document.createElement('a');
		link.href = p.href || '#';
		link.target = '_blank';
		link.textContent = p.name;
		nameDiv.appendChild(link);
		info.appendChild(nameDiv);

		const meta = document.createElement('div');
		meta.className = 'order-product-card__meta';
		const modelSpan = document.createElement('span');
		modelSpan.className = 'order-product-card__model';
		modelSpan.textContent = p.model || '';
		meta.appendChild(modelSpan);
		if (p.variant_sku) {
			const skuSpan = document.createElement('span');
			skuSpan.className = 'order-product-card__option';
			skuSpan.textContent = ' · SKU: ' + p.variant_sku;
			meta.appendChild(skuSpan);
		}
		(p.option || []).forEach(o => {
			const optSpan = document.createElement('span');
			optSpan.className = 'order-product-card__option';
			optSpan.textContent = ' · ' + o.name + ': ' + o.value;
			meta.appendChild(optSpan);
		});
		info.appendChild(meta);

		const priceDiv = document.createElement('div');
		priceDiv.className = 'order-product-card__price';
		const priceView = document.createElement('span');
		priceView.className = 'view-only';
		priceView.textContent = p.price;
		priceView.style.display = editing ? 'none' : '';
		const priceInput = document.createElement('input');
		priceInput.type = 'text';
		priceInput.className = 'form-control edit-only';
		priceInput.value = (parseFloat(p.price_raw) || 0).toFixed(decimals);
		priceInput.dataset.field = 'price';
		priceInput.style.display = editing ? '' : 'none';
		priceDiv.appendChild(priceView);
		priceDiv.appendChild(priceInput);

		const multDiv = document.createElement('div');
		multDiv.className = 'order-product-card__mult';
		multDiv.textContent = '×';

		const qtyDiv = document.createElement('div');
		qtyDiv.className = 'order-product-card__qty';
		const qtyView = document.createElement('span');
		qtyView.className = 'view-only';
		qtyView.textContent = (parseFloat(p.quantity) || 0).toFixed(decimals);
		qtyView.style.display = editing ? 'none' : '';
		const qtyInputEl = document.createElement('input');
		qtyInputEl.type = 'number';
		qtyInputEl.className = 'form-control edit-only';
		qtyInputEl.value = p.quantity;
		qtyInputEl.min = '0';
		qtyInputEl.step = 'any';
		qtyInputEl.dataset.field = 'quantity';
		qtyInputEl.style.display = editing ? '' : 'none';
		qtyDiv.appendChild(qtyView);
		qtyDiv.appendChild(qtyInputEl);

		const discDiv = document.createElement('div');
		discDiv.className = 'order-product-card__disc edit-only';
		discDiv.style.display = editing ? '' : 'none';
		discDiv.title = '{{ entry_discount_percent }}';
		const discInput = document.createElement('input');
		discInput.type = 'number';
		discInput.className = 'form-control';
		discInput.value = '0';
		discInput.min = '0';
		discInput.max = '100';
		discInput.step = '0.5';
		discInput.dataset.field = 'discount';
		discDiv.appendChild(discInput);

		const totalDiv = document.createElement('div');
		totalDiv.className = 'order-product-card__total';
		totalDiv.textContent = '= ' + (p.total || '');

		const actionsDiv = document.createElement('div');
		actionsDiv.className = 'order-product-card__actions edit-only';
		actionsDiv.style.display = editing ? '' : 'none';
		const removeBtn = document.createElement('button');
		removeBtn.type = 'button';
		removeBtn.className = 'btn btn-danger btn-xs btn--icon';
		removeBtn.title = '{{ button_remove }}';
		removeBtn.innerHTML = '<i data-lucide="trash-2" width="13" height="13"></i>';
		removeBtn.addEventListener('click', function() { removeProduct(this); });
		actionsDiv.appendChild(removeBtn);

		card.appendChild(posDiv);
		card.appendChild(thumb);
		card.appendChild(info);
		card.appendChild(priceDiv);
		card.appendChild(multDiv);
		card.appendChild(qtyDiv);
		card.appendChild(discDiv);
		card.appendChild(totalDiv);
		card.appendChild(actionsDiv);

		list.appendChild(card);
		renumberProductPositions();
		lucide.createIcons();
	}

	function getCurrencyDecimals() {
		const container = document.querySelector('.order-totals-card');
		if (container && container.dataset.decimalPlace !== undefined) {
			const dp = parseInt(container.dataset.decimalPlace, 10);
			if (!isNaN(dp)) return dp;
		}
		return 2;
	}

function addProduct() {
	const pid = pidInput.value;
	const qty = qtyInput ? (qtyInput.value || 1) : 1;
	if (!pid || pid === '0') return;

	const missing = missingRequiredOptions();
	if (missing.length) {
		showAlert('{{ error_missing_options }} ' + missing.join(', '), 'warning');
		return;
	}

	const data = { product_id: pid, quantity: qty };
	const options = collectOptions();
	if (options.length) data.options = JSON.stringify(options);

	setAddButtonState(false);
	api('index.php?route=sale/order_detail/addProduct&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID,
		'POST', data).then(j => {
			setAddButtonState(true);
			if (j.error) {
				showAlert(j.error, 'danger');
			} else if (j.product) {
				appendProductCard(j.product);
				if (j.totals) updateTotalsUI(j.totals, j.total_quantity);
				clearProductSelection();
				showAlert('{{ text_product_added }}');
			}
		});
}

});

function showProductCard(productId, orderProductId) {
	if (!productId) return;
	let overlay = document.getElementById('pcm-overlay');
	if (!overlay) {
		overlay = document.createElement('div');
		overlay.id = 'pcm-overlay';
		overlay.className = 'pcm-overlay';
		document.body.appendChild(overlay);
	}
	overlay.innerHTML = '<div class="pcm-spinner"><div class="spinner"></div></div>';
	overlay.style.display = 'flex';
	overlay.onclick = function(e) { if (!e.target.closest('.pcm-modal')) closeProductCard(); };

	api('index.php?route=sale/order_detail/getProductCard&user_token=' + USER_TOKEN + '&order_id=' + ORDER_ID + '&product_id=' + productId + '&order_product_id=' + (orderProductId || 0), 'GET')
		.then(j => {
			if (j.html) {
				overlay.innerHTML = '<div class="pcm-modal">' + j.html + '<button type="button" class="pcm-close" onclick="closeProductCard()"><i data-lucide="x" width="18" height="18"></i></button></div>';
				lucide.createIcons();
			} else {
				closeProductCard();
			}
		});
}

function closeProductCard() {
	const o = document.getElementById('pcm-overlay');
	if (o) o.style.display = 'none';
}

function pcmSwitchImage(thumb) {
	const full = thumb.dataset.full;
	if (!full) return;
	const mainImg = document.getElementById('pcm-main-img');
	if (mainImg) mainImg.innerHTML = '<img src="' + full + '">';
	document.querySelectorAll('.pcm-thumb').forEach(t => t.classList.remove('pcm-thumb--active'));
	thumb.classList.add('pcm-thumb--active');
}

document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeProductCard(); });

document.addEventListener('click', function(e) {
	const link = e.target.closest('.order-product-card__name a, .order-product-card__thumb');
	if (!link) return;
	const card = link.closest('.order-product-card');
	if (!card) return;
	const viewMode = card.closest('.order-products-list');
	if (!viewMode) return;
	if (card.querySelector('.edit-only') && card.querySelector('.edit-only').style.display !== 'none') return;
	e.preventDefault();
	showProductCard(card.dataset.productId, card.dataset.orderProductId);
});
</script>

<div id="flow-transition-modal" class="pcm-overlay" style="display:none">
  <div class="pcm-modal" style="max-width:440px">
    <button type="button" class="pcm-close" onclick="closeFlowTransition()"><i data-lucide="x" width="16" height="16"></i></button>
    <div class="pcm-header">
      <div>
        <div class="pcm-name" id="flow-transition-title"></div>
        <div class="pcm-sub" id="flow-transition-sub"></div>
      </div>
    </div>
    <div class="pcm-section">
      <div class="dcx-fields">
        <div class="dcx-field">
          <label class="dcx-label">{{ entry_comment }}</label>
          <textarea class="form-control" id="flow-transition-comment" rows="3" placeholder="{{ text_comment_optional }}"></textarea>
        </div>
        <div class="dcx-field">
          <label class="dcx-sidebar-card__checkbox">
            <input type="checkbox" id="flow-transition-notify" checked /> {{ text_flow_notify_customer }}
          </label>
        </div>
      </div>
    </div>
    <div class="pcm-section" id="flow-shipping-section" style="display:none">
      <div class="pcm-section__title"><i data-lucide="truck" width="13" height="13"></i> {{ text_flow_shipment }}</div>
      <div class="dcx-fields">
        <div class="dcx-field">
          <label class="dcx-label" for="flow-shipment-tracking">{{ entry_tracking_number }}</label>
          <input type="text" class="form-control" id="flow-shipment-tracking" />
          <div class="text-muted" style="font-size:11px;margin-top:3px">{{ entry_tracking_number_hint }}</div>
        </div>
        {% if shipment_products %}
        <div class="dcx-field">
          <label class="dcx-label">{{ text_shipment_items }}</label>
          <div id="flow-shipment-items">
            {% for product in shipment_products %}
            <div class="dcx-shipment-item-row">
              <span class="dcx-shipment-item-row__name">
                {% if product.position %}<span class="dcx-shipment-item__pos">#{{ product.position }}</span>{% endif %}
                {% if product.model %}<span class="dcx-shipment-item__model">{{ product.model }}</span>{% endif %}
                {{ product.name }}
              </span>
              <input type="number" class="form-control" min="0" max="{{ product.remaining }}" value="{{ product.remaining }}" data-shipment-qty="{{ product.order_product_id }}" />
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
    <div class="pcm-section" style="display:flex;gap:8px;justify-content:flex-end;border-top:none;padding-top:0">
      <button type="button" class="btn btn-default" onclick="closeFlowTransition()">{{ button_cancel }}</button>
      <button type="button" class="btn btn-primary" onclick="confirmFlowTransition()">{{ button_flow_apply }}</button>
    </div>
  </div>
</div>
<div id="pcm-overlay" class="pcm-overlay" style="display:none"></div>
{{ footer }}
