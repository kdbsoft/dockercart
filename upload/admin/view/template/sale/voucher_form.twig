{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-9 col-xl-offset-3 col-xl-6">
          <div class="pull-right">
            {% if voucher_id %}
            <button type="button" id="button-send" class="btn btn-default"><i data-lucide="mail" width="16" height="16"></i> {{ button_send }}</button>
            {% endif %}
            <button type="submit" form="form-voucher" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if voucher_id %}
                {{ voucher_name }}
                <span class="page-header__badge {{ status ? 'page-header__badge--active' : 'page-header__badge--inactive' }}">
                  {{ status ? text_active : text_inactive }}
                </span>
              {% else %}
                {{ text_add }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-9 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-voucher">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-9 col-xl-offset-3 col-xl-6">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_details_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-code">
                      <span data-toggle="tooltip" title="{{ help_code }}">{{ entry_code }}</span>
                    </label>
                    <input type="text" name="code" value="{{ code }}" placeholder="{{ entry_code }}" id="input-code" class="form-control" />
                    {% if error_code %}
                    <div class="text-danger">{{ error_code }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-amount">{{ entry_amount }}</label>
                    <input type="text" name="amount" value="{{ amount }}" placeholder="{{ entry_amount }}" id="input-amount" class="form-control" />
                    {% if error_amount %}
                    <div class="text-danger">{{ error_amount }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-from-name">{{ entry_from_name }}</label>
                    <input type="text" name="from_name" value="{{ from_name }}" placeholder="{{ entry_from_name }}" id="input-from-name" class="form-control" />
                    {% if error_from_name %}
                    <div class="text-danger">{{ error_from_name }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-from-email">{{ entry_from_email }}</label>
                    <input type="text" name="from_email" value="{{ from_email }}" placeholder="{{ entry_from_email }}" id="input-from-email" class="form-control" />
                    {% if error_from_email %}
                    <div class="text-danger">{{ error_from_email }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-to-name">{{ entry_to_name }}</label>
                    <input type="text" name="to_name" value="{{ to_name }}" placeholder="{{ entry_to_name }}" id="input-to-name" class="form-control" />
                    {% if error_to_name %}
                    <div class="text-danger">{{ error_to_name }}</div>
                    {% endif %}
                  </div>
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-to-email">{{ entry_to_email }}</label>
                    <input type="text" name="to_email" value="{{ to_email }}" placeholder="{{ entry_to_email }}" id="input-to-email" class="form-control" />
                    {% if error_to_email %}
                    <div class="text-danger">{{ error_to_email }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-theme">{{ entry_theme }}</label>
                  <select name="voucher_theme_id" id="input-theme" class="form-control">
                    {% for voucher_theme in voucher_themes %}
                    {% if voucher_theme.voucher_theme_id == voucher_theme_id %}
                    <option value="{{ voucher_theme.voucher_theme_id }}" selected="selected">{{ voucher_theme.name }}</option>
                    {% else %}
                    <option value="{{ voucher_theme.voucher_theme_id }}">{{ voucher_theme.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-message">{{ entry_message }}</label>
                  <textarea name="message" rows="5" placeholder="{{ entry_message }}" id="input-message" class="form-control">{{ message }}</textarea>
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
          </div>
          {% if voucher_id %}
          <div class="dcx-panel form-row--spaced">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="rotate-ccw-clock" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_history_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div id="history"></div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    </form>
  </div>
  {% if voucher_id %}
  <script type="text/javascript"><!--
$('#button-send').on('click', function() {
	$.ajax({
		url: 'index.php?route=sale/voucher/send&user_token={{ user_token }}',
		type: 'post',
		dataType: 'json',
		data: 'voucher_id={{ voucher_id }}',
		beforeSend: function() {
			$('#button-send').prop('disabled', true);
			$('#button-send i').replaceWith('<i data-lucide="loader" width="16" height="16" class="lucide-spin"></i>');
			lucide.createIcons({ nodes: [document.getElementById('button-send')] });
		},
		complete: function() {
			$('#button-send').prop('disabled', false);
			$('#button-send i').replaceWith('<i data-lucide="mail" width="16" height="16"></i>');
			lucide.createIcons({ nodes: [document.getElementById('button-send')] });
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#content > .container-fluid').first().prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + '</div>');
				lucide.createIcons();
			}

			if (json['success']) {
				$('#content > .container-fluid').first().prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json['success'] + '</div>');
				lucide.createIcons();
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
  <script type="text/javascript"><!--
$('#history').delegate('.pagination a', 'click', function(e) {
	e.preventDefault();

	$('#history').load(this.href, function() {
		lucide.createIcons({ nodes: document.getElementById('history') });
	});
});

$('#history').load('index.php?route=sale/voucher/history&user_token={{ user_token }}&voucher_id={{ voucher_id }}', function() {
	lucide.createIcons({ nodes: document.getElementById('history') });
});
//--></script>
{% endif %}
</div>
{{ footer }}
