{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-return" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ text_form }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-return">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="shopping-cart" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_order }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-field required">
                <label class="dcx-label" for="input-order-id">{{ entry_order_id }}</label>
                <input type="text" name="order_id" value="{{ order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control" />
                {% if error_order_id %}
                <div class="text-danger">{{ error_order_id }}</div>
                {% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-date-ordered">{{ entry_date_ordered }}</label>
                <div class="input-group date">
                  <input type="text" name="date_ordered" value="{{ date_ordered }}" placeholder="{{ entry_date_ordered }}" data-date-format="YYYY-MM-DD" id="input-date-ordered" class="form-control" />
                  <span class="input-group-btn">
                    <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                  </span>
                </div>
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-customer">{{ entry_customer }}</label>
                <input type="text" name="customer" value="{{ customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
                <input type="hidden" name="customer_id" value="{{ customer_id }}" />
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-firstname">{{ entry_firstname }}</label>
                <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control" />
                {% if error_firstname %}
                <div class="text-danger">{{ error_firstname }}</div>
                {% endif %}
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-lastname">{{ entry_lastname }}</label>
                <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control" />
                {% if error_lastname %}
                <div class="text-danger">{{ error_lastname }}</div>
                {% endif %}
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-email">{{ entry_email }}</label>
                <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                {% if error_email %}
                <div class="text-danger">{{ error_email }}</div>
                {% endif %}
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-telephone">{{ entry_telephone }}</label>
                <input type="text" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" />
                {% if error_telephone %}
                <div class="text-danger">{{ error_telephone }}</div>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="package" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_product }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              {% if return_products %}
              <div class="dcx-field">
                <label class="dcx-label">{{ text_return_items }}</label>
                <div id="return-items">
                  {% for rp in return_products %}
                  <div class="return-item-row" data-opid="{{ rp.order_product_id }}" data-price="{{ rp.price }}">
                    <input type="hidden" name="products[{{ loop.index0 }}][order_product_id]" value="{{ rp.order_product_id }}" />
                    <input type="hidden" name="products[{{ loop.index0 }}][product_id]" value="{{ rp.product_id }}" />
                    <input type="hidden" name="products[{{ loop.index0 }}][variant_id]" value="{{ rp.variant_id }}" />
                    <input type="hidden" name="products[{{ loop.index0 }}][name]" value="{{ rp.name }}" />
                    <input type="hidden" name="products[{{ loop.index0 }}][model]" value="{{ rp.model }}" />
                    <input type="hidden" name="products[{{ loop.index0 }}][ordered]" value="{{ rp.ordered }}" />
                    <input type="hidden" name="products[{{ loop.index0 }}][price]" value="{{ rp.price }}" />
                    <label class="return-item-row__check">
                      <input type="checkbox" class="return-item-check" {% if rp.checked %}checked{% endif %} onchange="returnItemChanged(this)" />
                    </label>
                    <span class="return-item-row__name">{{ rp.name }}{% if rp.model %} <span class="text-muted">({{ rp.model }})</span>{% endif %}</span>
                    <input type="number" class="form-control return-item-qty" min="0" max="{{ rp.ordered }}" value="{{ rp.quantity }}" {% if not rp.checked %}disabled{% endif %} onchange="returnItemChanged(this)" oninput="returnItemChanged(this)" />
                    <span class="return-item-row__ordered">/ {{ rp.ordered }}</span>
                  </div>
                  {% endfor %}
                </div>
                {% if error_products %}
                <div class="text-danger">{{ error_products }}</div>
                {% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label">{{ entry_return_type }}</label>
                <div class="return-type-row">
                  {% for t in ['full', 'partial', 'exchange'] %}
                  <label class="dcx-sidebar-card__checkbox">
                    <input type="radio" name="type" value="{{ t }}" {% if type == t %}checked{% endif %} onchange="returnTypeChanged(this)" /> {{ attribute(_context, 'text_type_' ~ t) }}
                  </label>
                  {% endfor %}
                </div>
              </div>
              <div class="dcx-field">
                <label class="dcx-label">{{ text_refund }}</label>
                <label class="dcx-sidebar-card__checkbox">
                  <input type="checkbox" name="refund" value="1" id="input-refund" {% if refund and not refunded %}checked{% endif %} {% if refunded %}disabled{% endif %} onchange="refundChanged(this)" />
                  {{ text_refund_money }}
                </label>
                {% if refunded %}
                <div class="text-muted" style="font-size:12px">{{ text_refunded_already }}</div>
                {% endif %}
                <input type="text" name="amount" value="{{ amount }}" id="input-amount" class="form-control" style="max-width:180px;margin-top:4px" placeholder="{{ entry_refund_amount }}" {% if not refund or refunded %}disabled{% endif %} oninput="refundChanged(this)" />
                {% if error_amount %}
                <div class="text-danger">{{ error_amount }}</div>
                {% endif %}
              </div>
              {% else %}
              <div class="dcx-field required">
                <label class="dcx-label" for="input-product">{{ entry_product }} <span title="{{ help_product }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <input type="text" name="product" value="{{ product }}" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
                <input type="hidden" name="product_id" value="{{ product_id }}" />
                {% if error_product %}
                <div class="text-danger">{{ error_product }}</div>
                {% endif %}
              </div>
              <div class="dcx-field required">
                <label class="dcx-label" for="input-model">{{ entry_model }}</label>
                <input type="text" name="model" value="{{ model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control" />
                {% if error_model %}
                <div class="text-danger">{{ error_model }}</div>
                {% endif %}
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-quantity">{{ entry_quantity }}</label>
                <input type="text" name="quantity" value="{{ quantity }}" placeholder="{{ entry_quantity }}" id="input-quantity" class="form-control" />
              </div>
              {% endif %}
              <div class="dcx-field">
                <label class="dcx-label" for="input-return-reason">{{ entry_return_reason }}</label>
                <select name="return_reason_id" id="input-return-reason" class="form-control">
                  {% for return_reason in return_reasons %}
                  {% if return_reason.return_reason_id == return_reason_id %}
                  <option value="{{ return_reason.return_reason_id }}" selected="selected">{{ return_reason.name }}</option>
                  {% else %}
                  <option value="{{ return_reason.return_reason_id }}">{{ return_reason.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-comment">{{ entry_comment }}</label>
                <textarea name="comment" rows="5" placeholder="{{ entry_comment }}" id="input-comment" class="form-control">{{ comment }}</textarea>
              </div>
            </div>
          </div>
          {% if return_id %}
          <div class="dcx-panel" id="history-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="clock" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_history }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div id="history"></div>
              <hr/>
              <div class="dcx-field">
                <label class="dcx-label" for="input-history-status">{{ entry_return_status }}</label>
                <select name="return_status_id" id="input-history-status" class="form-control">
                  {% for return_status in return_statuses %}
                  {% if return_status.return_status_id == return_status_id %}
                  <option value="{{ return_status.return_status_id }}" selected="selected">{{ return_status.name }}</option>
                  {% else %}
                  <option value="{{ return_status.return_status_id }}">{{ return_status.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-notify">{{ entry_notify }}</label>
                <input type="checkbox" name="notify" value="1" id="input-notify" />
              </div>
              <div class="dcx-field">
                <label class="dcx-label" for="input-history-comment">{{ entry_comment }}</label>
                <textarea name="comment" rows="6" id="input-history-comment" class="form-control"></textarea>
              </div>
              <div class="text-right" style="margin-top: 12px;">
                <button id="button-history" data-loading-text="{{ text_loading }}" class="btn btn-primary"><i data-lucide="circle-plus" width="14" height="14"></i> {{ button_history_add }}</button>
              </div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-cards">
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="refresh-cw" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ entry_return_status }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <select name="return_status_id" id="input-return-status" class="form-control">
                  {% for return_status in return_statuses %}
                  {% if return_status.return_status_id == return_status_id %}
                  <option value="{{ return_status.return_status_id }}" selected="selected">{{ return_status.name }}</option>
                  {% else %}
                  <option value="{{ return_status.return_status_id }}">{{ return_status.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="package" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ entry_return_action }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <select name="return_action_id" id="input-return-action" class="form-control">
                  <option value="0"></option>
                  {% for return_action in return_actions %}
                  {% if return_action.return_action_id == return_action_id %}
                  <option value="{{ return_action.return_action_id }}" selected="selected">{{ return_action.name }}</option>
                  {% else %}
                  <option value="{{ return_action.return_action_id }}">{{ return_action.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>
          <div class="dcx-sidebar-card">
            <div class="dcx-sidebar-card__header">
              <div class="dcx-sidebar-card__header-icon"><i data-lucide="info" width="16" height="16"></i></div>
              <h3 class="dcx-sidebar-card__title">{{ text_product }}</h3>
            </div>
            <div class="dcx-sidebar-card__body">
              <div class="dcx-sidebar-card__field">
                <label class="dcx-sidebar-card__label">{{ entry_opened }}</label>
                <select name="opened" id="input-opened" class="form-control">
                  {% if opened %}
                  <option value="1" selected="selected">{{ text_opened }}</option>
                  <option value="0">{{ text_unopened }}</option>
                  {% else %}
                  <option value="1">{{ text_opened }}</option>
                  <option value="0" selected="selected">{{ text_unopened }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('input[name=\'customer\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=customer/customer/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						category: item['customer_group'],
						label: item['name'],
						value: item['customer_id'],
						firstname: item['firstname'],
						lastname: item['lastname'],
						email: item['email'],
						telephone: item['telephone']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'customer\']').val(item['label']);
		$('input[name=\'customer_id\']').val(item['value']);
		$('input[name=\'firstname\']').val(item['firstname']);
		$('input[name=\'lastname\']').val(item['lastname']);
		$('input[name=\'email\']').val(item['email']);
		$('input[name=\'telephone\']').val(item['telephone']);
	}
});
//--></script>
  <script type="text/javascript"><!--
$('input[name=\'product\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id'],
						model: item['model']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'product\']').val(item['label']);
		$('input[name=\'product_id\']').val(item['value']);
		$('input[name=\'model\']').val(item['model']);
	}
});

$('#history').delegate('.pagination a', 'click', function(e) {
	e.preventDefault();
	$('#history').load(this.href);
});

$('#history').load('index.php?route=sale/return/history&user_token={{ user_token }}&return_id={{ return_id }}');

$('#button-history').on('click', function(e) {
	e.preventDefault();

	$.ajax({
		url: 'index.php?route=sale/return/addhistory&user_token={{ user_token }}&return_id={{ return_id }}',
		type: 'post',
		dataType: 'json',
		data: 'return_status_id=' + encodeURIComponent($('#input-history-status').val()) + '&notify=' + ($('#input-notify').prop('checked') ? 1 : 0) + '&comment=' + encodeURIComponent($('#input-history-comment').val()),
		beforeSend: function() {
			$('#button-history').button('loading');
		},
		complete: function() {
			$('#button-history').button('reset');
		},
		success: function(json) {
			$('#history-panel .alert-dismissible').remove();

			if (json['error']) {
				$('#history-panel').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}

			if (json['success']) {
				$('#history').load('index.php?route=sale/return/history&user_token={{ user_token }}&return_id={{ return_id }}');

				$('#history-panel').prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');

				$('#input-history-comment').val('');
			}

			lucide.createIcons();
		}
	});
});

const PAID_AMOUNT = {{ paid_amount_raw }};

function returnItemChanged() {
	const type = document.querySelector('input[name="type"]:checked');
	if (type && type.value === 'full') {
		document.querySelectorAll('.return-item-row').forEach(row => {
			const check = row.querySelector('.return-item-check');
			const qty = row.querySelector('.return-item-qty');
			if (!check.checked) {
				check.checked = true;
				qty.disabled = false;
				qty.value = qty.max;
			}
		});
	}
	document.querySelectorAll('.return-item-row').forEach(row => {
		const check = row.querySelector('.return-item-check');
		const qty = row.querySelector('.return-item-qty');
		qty.disabled = !check.checked;
		if (!check.checked) qty.value = 0;
	});
	recalcRefund();
}

function returnTypeChanged(input) {
	const type = input.value;
	const refund = document.getElementById('input-refund');
	const amount = document.getElementById('input-amount');

	if (type === 'full') {
		document.querySelectorAll('.return-item-row').forEach(row => {
			const check = row.querySelector('.return-item-check');
			const qty = row.querySelector('.return-item-qty');
			check.checked = true;
			qty.disabled = false;
			qty.value = qty.max;
		});
		if (refund && !refund.disabled) refund.checked = true;
		if (amount) amount.disabled = false;
	} else if (type === 'exchange') {
		if (refund) refund.checked = false;
		if (amount) amount.disabled = true;
	}

	recalcRefund();
}

function refundChanged(input) {
	const amount = document.getElementById('input-amount');

	if (input.id === 'input-refund') {
		amount.disabled = !input.checked;
		if (input.checked) recalcRefund();
	} else {
		recalcRefund();
	}
}

function recalcRefund() {
	const type = document.querySelector('input[name="type"]:checked');
	const refund = document.getElementById('input-refund');
	const amount = document.getElementById('input-amount');
	if (!type || !amount || !refund) return;

	if (type.value === 'exchange') {
		amount.value = '0';
		return;
	}

	if (type.value === 'full' && PAID_AMOUNT > 0) {
		amount.value = PAID_AMOUNT.toFixed(2);
		return;
	}

	let sum = 0;
	document.querySelectorAll('.return-item-row').forEach(row => {
		const check = row.querySelector('.return-item-check');
		const qty = row.querySelector('.return-item-qty');
		if (check && check.checked && qty) {
			sum += (parseFloat(qty.value) || 0) * parseFloat(row.dataset.price || 0);
		}
	});

	amount.value = PAID_AMOUNT > 0 ? Math.min(sum, PAID_AMOUNT).toFixed(2) : sum.toFixed(2);
}
//--></script>
  <script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});
//--></script>
  <style>
.return-item-row { display:flex; align-items:center; gap:8px; padding:6px 8px; border:1px solid var(--dc-border,#e5e7eb); border-radius:8px; margin-bottom:6px; background:var(--dc-surface,#fff); }
.return-item-row__check { flex-shrink:0; margin:0; }
.return-item-row__name { flex:1; min-width:0; font-size:13px; color:#374151; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.return-item-row .return-item-qty { width:76px; flex-shrink:0; }
.return-item-row__ordered { flex-shrink:0; font-size:12px; color:#9ca3af; }
.return-type-row { display:flex; flex-wrap:wrap; gap:12px; }
</style>
</div>
{{ footer }}
