{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <button type="button" id="button-send" class="btn btn-default dc-btn-selection"><i data-lucide="mail" width="16" height="16"></i> {{ button_send }}</button>
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-voucher').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if vouchers %}

    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-voucher">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'v.code' %}<a href="{{ sort_code }}" class="{{ order|lower }} sortable">{{ column_code }}</a>{% else %}<a href="{{ sort_code }}" class="sortable">{{ column_code }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'v.from_name' %}<a href="{{ sort_from }}" class="{{ order|lower }} sortable">{{ column_from }}</a>{% else %}<a href="{{ sort_from }}" class="sortable">{{ column_from }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'v.to_name' %}<a href="{{ sort_to }}" class="{{ order|lower }} sortable">{{ column_to }}</a>{% else %}<a href="{{ sort_to }}" class="sortable">{{ column_to }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'v.amount' %}<a href="{{ sort_amount }}" class="{{ order|lower }} sortable">{{ column_amount }}</a>{% else %}<a href="{{ sort_amount }}" class="sortable">{{ column_amount }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'theme' %}<a href="{{ sort_theme }}" class="{{ order|lower }} sortable">{{ column_theme }}</a>{% else %}<a href="{{ sort_theme }}" class="sortable">{{ column_theme }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'v.status' %}<a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a>{% else %}<a href="{{ sort_status }}" class="sortable">{{ column_status }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'v.date_added' %}<a href="{{ sort_date_added }}" class="{{ order|lower }} sortable">{{ column_date_added }}</a>{% else %}<a href="{{ sort_date_added }}" class="sortable">{{ column_date_added }}</a>{% endif %}</td>
            </tr>
          </thead>
          <tbody>
            {% if vouchers %}
            {% for voucher in vouchers %}
            <tr data-href="{{ voucher.edit }}">
              <td class="text-center">{% if voucher.voucher_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ voucher.voucher_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ voucher.voucher_id }}" />
                {% endif %}</td>
              <td class="text-left"><a href="{{ voucher.edit }}" class="row-title-link">{{ voucher.code }}</a>{% if voucher.order %}<a href="{{ voucher.order }}" data-toggle="tooltip" title="{{ button_order }}" class="dc-row-icon"><i data-lucide="arrow-right" width="13" height="13"></i></a>{% endif %}</td>
              <td class="text-left">{{ voucher.from }}</td>
              <td class="text-left">{{ voucher.to }}</td>
              <td class="text-right">{{ voucher.amount }}</td>
              <td class="text-left">{{ voucher.theme }}</td>
              <td class="text-left">{{ voucher.status }}</td>
              <td class="text-left">{{ voucher.date_added }}</td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="8">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>

    {% else %}

        {% include 'common/empty_state.twig' with {

          icon: 'voucher',

          standalone: true,

          title: text_empty_title,

          description: text_empty_description,

          action_url: add,

          action_text: button_add

        } %}

    {% endif %}
  </div>
</div>
<script type="text/javascript"><!--
$('#button-send').on('click', function() {
	$.ajax({
		url: 'index.php?route=sale/voucher/send&user_token={{ user_token }}',
		type: 'post',
		dataType: 'json',
		data: $('input[name^=\'selected\']:checked'),
		beforeSend: function() {
			$('#button-send').prop('disabled', true);
			$('#button-send i').replaceWith('<i data-lucide="loader" width="16" height="16" class="lucide-spin"></i>');
			lucide.createIcons({ nodes: [document.getElementById('button-send')] });
		},
		complete: function() {
			$('#button-send').prop('disabled', false);
			$('#button-send i').replaceWith('<i data-lucide="mail" width="16" height="16"></i>');
			lucide.createIcons({ nodes: [document.getElementById('button-send')] });
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#content > .container-fluid').first().prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + '</div>');
				lucide.createIcons();
			}

			if (json['success']) {
				$('#content > .container-fluid').first().prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json['success'] + '</div>');
				lucide.createIcons();
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
{{ footer }}
