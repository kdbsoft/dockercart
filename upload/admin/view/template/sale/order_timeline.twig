{% if entries %}
  {% for entry in entries %}
  <div class="timeline-entry" data-history-id="{{ entry.order_history_id }}">
    <div class="timeline-icon {% if entry.order_status_id == 0 %}timeline-icon--note{% else %}timeline-icon--system {% endif %}">
      {% if entry.order_status_id == 0 %}
      <i data-lucide="sticky-note" width="14" height="14"></i>
      {% else %}
      <i data-lucide="refresh-cw" width="14" height="14"></i>
      {% endif %}
    </div>
    <div class="timeline-content">
      <div class="timeline-header">
        <span class="timeline-status">{{ entry.status_name|raw }}</span>
        <span class="timeline-date">{{ entry.date_added }}</span>
      </div>
      {% if entry.comment %}
      <div class="timeline-comment">{{ entry.comment|raw }}</div>
      {% endif %}
      {% if entry.notify %}
      <span class="dcx-badge dcx-badge--info" style="font-size:10px;padding:1px 5px">{{ text_notify }}</span>
      {% endif %}
    </div>
  </div>
  {% endfor %}

  {% if pages > 1 %}
  <div class="timeline-load-more">
    {% if page > 1 %}
    <a onclick="loadTimeline({{ page - 1 }})" class="btn btn-default btn-xs"><i data-lucide="chevron-left" width="12" height="12"></i> {{ text_previous }}</a>
    {% endif %}
    <span style="font-size:12px;color:#999;margin:0 8px">{{ page }} / {{ pages }}</span>
    {% if page < pages %}
    <a onclick="loadTimeline({{ page + 1 }})" class="btn btn-default btn-xs">{{ text_next }} <i data-lucide="chevron-right" width="12" height="12"></i></a>
    {% endif %}
  </div>
  {% endif %}
{% else %}
  <div class="text-center" style="padding:16px;color:#999;font-size:13px">{{ text_no_results }}</div>
{% endif %}

<div class="timeline-note-form">
  <ul class="nav nav-tabs" id="timeline-tabs">
    <li class="active"><a href="#tl-note" data-toggle="tab">{{ text_add_note }}</a></li>
    <li><a href="#tl-history" data-toggle="tab">{{ text_history_add }}</a></li>
  </ul>
  <div class="tab-content" style="padding-top:12px">
    <div class="tab-pane active" id="tl-note">
      <div class="dcx-fields">
        <textarea class="form-control input-sm" id="tl-note-comment" rows="2" placeholder="{{ entry_comment }}"></textarea>
        <div style="display:flex;align-items:center;gap:8px">
          <label style="font-size:12px;font-weight:400;margin:0">
            <input type="checkbox" id="tl-note-notify"> {{ entry_notify }}
          </label>
          <button type="button" class="btn btn-primary btn-xs" onclick="addTimelineNote()">
            <i data-lucide="send" width="12" height="12"></i> {{ button_add }}
          </button>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="tl-history">
      <div class="dcx-fields">
        <select class="form-control input-sm" id="tl-history-status">
          <option value="0">{{ text_select }}</option>
          {% for status in order_statuses %}
          <option value="{{ status.order_status_id }}">{{ status.name }}</option>
          {% endfor %}
        </select>
        <textarea class="form-control input-sm" id="tl-history-comment" rows="2" placeholder="{{ entry_comment }}"></textarea>
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <label style="font-size:12px;font-weight:400;margin:0">
            <input type="checkbox" id="tl-history-notify"> {{ entry_notify }}
          </label>
          <label style="font-size:12px;font-weight:400;margin:0">
            <input type="checkbox" id="tl-history-override"> {{ entry_override }}
          </label>
          <button type="button" class="btn btn-primary btn-xs" onclick="addTimelineHistory()">
            <i data-lucide="send" width="12" height="12"></i> {{ button_add }}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>