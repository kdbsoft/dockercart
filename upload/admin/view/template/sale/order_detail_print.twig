<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{% if orders|length > 1 %}{{ text_print_orders }}{% else %}{{ orders[0].heading_title }} — {{ text_print }}{% endif %}</title>
  <style>
    @page { size: A4 portrait; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { font-family: Arial, 'DejaVu Sans', Helvetica, sans-serif; font-size: 9pt; color: #1e293b; line-height: 1.5; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    table { width: 100%; max-width: 100%; border-collapse: collapse; table-layout: fixed; }
    .page { width: auto; min-height: auto; padding: 20mm; }
    .accent { height: 2.5px; background: #0f172a; margin: 0 0 16px 0; }
    .doc-head td { vertical-align: top; padding: 0; }
    .brand-logo { max-height: 30px; max-width: 200px; margin-bottom: 8px; display: block; }
    .doc-title { font-size: 16pt; font-weight: 700; color: #0f172a; line-height: 1.15; letter-spacing: 0.3px; }
    .doc-sub { font-size: 8.5pt; color: #64748b; margin-top: 3px; }
    .doc-sub strong { color: #334155; font-weight: 700; }
    .doc-meta { text-align: right; font-size: 7.5pt; color: #64748b; line-height: 1.6; }
    .doc-meta strong { color: #334155; font-weight: 700; }
    .doc-meta .store-name { font-size: 8.5pt; color: #0f172a; font-weight: 700; }
    .status-badge { display: inline-block; border: 1px solid #0f172a; color: #0f172a; font-size: 7pt; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; padding: 2px 7px; margin-top: 6px; }
    .section { margin-bottom: 14px; }
    .section h3 { font-size: 7pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.7px; color: #0f172a; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid #e2e8f0; }
    .kv { font-size: 8.5pt; color: #334155; line-height: 1.6; }
    .kv .muted { color: #64748b; }
    .meta-grid td { vertical-align: top; padding-right: 16px; width: 33.33%; }
    .meta-grid td:last-child { padding-right: 0; }
    .meta-grid .person { font-size: 9pt; font-weight: 700; color: #0f172a; margin-bottom: 3px; }
    .meta-grid .addr { font-size: 8.5pt; color: #334155; line-height: 1.6; }
    .items th { background: #0f172a; color: #ffffff; font-weight: 700; font-size: 7pt; text-transform: uppercase; letter-spacing: 0.5px; padding: 8px 9px; text-align: left; white-space: nowrap; }
    .items th.text-right { text-align: right; }
    .items th.text-center { text-align: center; }
    .items td { padding: 7px 9px; border-bottom: 1px solid #e2e8f0; font-size: 8.5pt; vertical-align: top; color: #1e293b; }
    .items tr:last-child td { border-bottom-color: #cbd5e1; }
    .items .opt { color: #64748b; font-size: 7.5pt; margin-top: 2px; line-height: 1.4; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .no-wrap { white-space: nowrap; }
    .totals { width: 260px; margin-left: auto; margin-top: 10px; }
    .totals td { padding: 4px 9px; font-size: 8.5pt; color: #334155; }
    .totals .grand td { font-weight: 700; font-size: 10pt; color: #0f172a; border-top: 2px solid #0f172a; padding-top: 7px; }
    .note { margin-top: 14px; border-left: 2px solid #e2e8f0; padding-left: 10px; }
    .note h3 { border: 0; padding: 0; margin-bottom: 4px; }
    .note p { font-size: 8.5pt; color: #475569; line-height: 1.6; }
    .page-foot { margin-top: 22px; border-top: 1px solid #e2e8f0; padding-top: 10px; text-align: center; color: #94a3b8; font-size: 7pt; line-height: 1.6; }
  </style>
</head>
<body>
  {% for order in orders %}
  <div class="page"{% if not loop.last %} style="page-break-after: always;"{% endif %}>
    <table class="doc-head">
      <tr>
        <td>
          {% if order.seller_logo %}<img src="{{ order.seller_logo }}" class="brand-logo" alt="">{% endif %}
          <div class="doc-title">{{ order.heading_title }}</div>
          {% if order.order_status %}<div class="status-badge">{{ order.order_status }}</div>{% endif %}
          {% if order.invoice_no %}<div class="doc-sub"><strong>{{ text_invoice_no }}</strong> {{ order.invoice_no }}</div>{% endif %}
        </td>
        <td class="doc-meta">
          <div class="store-name">{{ order.store_name }}</div>
          <div>{{ order.store_url }}</div>
          <div><strong>{{ text_date_added }}:</strong> {{ order.date_added }}</div>
          <div style="margin-top: 2px; color: #94a3b8;">{{ text_order_id }} {{ order.order_id }}</div>
        </td>
      </tr>
    </table>
    <div class="accent"></div>

    <div class="section">
      <table class="meta-grid">
        <tr>
          <td>
            <h3>{{ text_customer_detail }}</h3>
            <div class="person">{{ order.firstname }} {{ order.lastname }}</div>
            <div class="kv">{{ order.email }}<br>{{ order.telephone }}</div>
          </td>
          <td>
            <h3>{{ text_payment_address }}</h3>
            <div class="addr">{{ order.payment_address|raw }}</div>
            <div class="kv" style="margin-top: 6px; font-size: 7.5pt;"><span class="muted">{{ text_payment_method }}:</span> {{ order.payment_method }}</div>
          </td>
          {% if order.shipping_method %}
          <td>
            <h3>{{ text_shipping_address }}</h3>
            <div class="addr">{{ order.shipping_address|raw }}</div>
            <div class="kv" style="margin-top: 6px; font-size: 7.5pt;"><span class="muted">{{ text_shipping_method }}:</span> {{ order.shipping_method }}</div>
          </td>
          {% endif %}
        </tr>
        {% if order.tracking_number %}
        <tr>
          <td colspan="3" style="padding-top: 10px;">
            <h3>{{ text_tracking_number }}</h3>
            <div class="kv">{{ order.tracking_number|replace({'|': ' · '}) }}</div>
          </td>
        </tr>
        {% endif %}
      </table>
    </div>

    <table class="items">
      <thead>
        <tr>
          <th style="width: 42%;">{{ column_product }}</th>
          <th style="width: 15%;">{{ column_model }}</th>
          <th class="text-center" style="width: 11%;">{{ column_qty }}</th>
          <th class="text-right" style="width: 16%;">{{ column_price }}</th>
          <th class="text-right" style="width: 16%;">{{ column_total }}</th>
        </tr>
      </thead>
      <tbody>
        {% for product in order.products %}
        <tr>
          <td>{{ product.name }}{% if product.option %}<div class="opt">{{ product.option }}</div>{% endif %}</td>
          <td style="color: #64748b; font-size: 8pt;">{{ product.model }}</td>
          <td class="text-center no-wrap">{{ product.quantity }}</td>
          <td class="text-right no-wrap">{{ product.price }}</td>
          <td class="text-right no-wrap" style="font-weight: 700;">{{ product.total }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <table class="totals">
      {% for total in order.totals %}
      <tr{% if loop.last %} class="grand"{% endif %}>
        <td>{{ total.title }}</td>
        <td class="text-right no-wrap">{{ total.text }}</td>
      </tr>
      {% endfor %}
    </table>

    {% if order.comment %}
    <div class="note">
      <h3>{{ text_comment }}</h3>
      <p>{{ order.comment|nl2br }}</p>
    </div>
    {% endif %}

    <div class="page-foot">
      <div>{{ order.store_name }} · {{ order.store_url }}</div>
      <div>{{ text_print_date }}: {{ print_date }}</div>
    </div>
  </div>
  {% endfor %}
</body>
</html>
