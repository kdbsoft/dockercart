  <script type="text/javascript"><!--
// Order status change
$('.order-status-select').on('change', function() {
	var element = this;
	var orderId = $(element).data('order-id');
	var statusId = $(element).val();
	var notify = $(element).closest('td').find('.order-notify-check').prop('checked') ? 1 : 0;

	$.ajax({
		url: 'index.php?route=sale/order/addHistory&user_token={{ user_token }}&order_id=' + orderId,
		type: 'post',
		dataType: 'json',
		data: 'order_status_id=' + encodeURIComponent(statusId) + '&notify=' + notify + '&comment=',
		beforeSend: function() {
			$(element).prop('disabled', true);
		},
		complete: function() {
			$(element).prop('disabled', false);
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}

			if (json['success']) {
				$('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
  <script type="text/javascript"><!--
// Tracking numbers modal edit
var $trackingModal = null;
var trackingOrderId = 0;

function openTrackingModal(orderId, currentValue) {
	trackingOrderId = orderId;
	var rows = String(currentValue || '').split('|').map(function(v) { return v.trim(); }).filter(Boolean);

	if (!$trackingModal) {
		$('body').append('<div id="tracking-modal" class="modal fade" tabindex="-1" role="dialog"><div class="modal-dialog modal-sm" role="document"><div class="modal-content">' +
			'<div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button><h4 class="modal-title">{{ text_tracking_numbers }}</h4></div>' +
			'<div class="modal-body">' +
			'<div id="tracking-modal-rows"></div>' +
			'<button type="button" class="btn btn-default btn-sm" id="tracking-modal-add"><i data-lucide="plus" width="11" height="11"></i> {{ button_add_tracking }}</button>' +
			'<div class="text-muted" style="font-size:11px;margin-top:6px">{{ text_tracking_max }}</div>' +
			'</div>' +
			'<div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button><button type="button" class="btn btn-primary" id="tracking-modal-save">{{ button_save }}</button></div>' +
			'</div></div></div>');
		$trackingModal = $('#tracking-modal');
		$('#tracking-modal-add').on('click', function() { addTrackingModalRow(''); });
		$('#tracking-modal-save').on('click', saveTrackingModal);
	}

	$('#tracking-modal-rows').empty();
	(rows.length ? rows : ['']).forEach(function(v) { addTrackingModalRow(v); });
	updateTrackingModalButtons();
	$trackingModal.modal('show');
	$('#tracking-modal-rows input').first().focus().select();
}

function addTrackingModalRow(value) {
	var $row = $('<div class="input-group" style="margin-bottom:5px">' +
		'<input type="text" class="form-control input-sm tracking-modal-input" value="' + $('<div>').text(value || '').html() + '">' +
		'<span class="input-group-btn"><button type="button" class="btn btn-default btn-sm tracking-modal-remove" title="{{ button_remove_tracking }}"><i data-lucide="x" width="11" height="11"></i></button></span>' +
		'</div>');
	$row.find('.tracking-modal-remove').on('click', function() {
		$row.remove();
		updateTrackingModalButtons();
	});
	$('#tracking-modal-rows').append($row);
	lucide.createIcons();
	updateTrackingModalButtons();
}

function updateTrackingModalButtons() {
	var count = $('#tracking-modal-rows .tracking-modal-input').length;
	$('#tracking-modal-add').toggle(count < 10);
	$('#tracking-modal-rows .tracking-modal-remove').toggle(count > 1);
}

function getTrackingModalJoined() {
	return $('#tracking-modal-rows .tracking-modal-input').map(function() {
		return $(this).val().trim();
	}).get().filter(Boolean).slice(0, 10).join('|');
}

function saveTrackingModal() {
	var newValue = getTrackingModalJoined();

	$.ajax({
		url: 'index.php?route=sale/order/quickEdit&user_token={{ user_token }}&order_id=' + trackingOrderId,
		type: 'post',
		dataType: 'json',
		data: 'field=tracking_number&value=' + encodeURIComponent(newValue),
		success: function(json) {
			if (json['success']) {
				var display = (json['value_html'] !== undefined ? json['value_html'] : newValue).replace(/\|/g, ' | ');
				$('#tracking-' + trackingOrderId).text(display);
				$('.btn-quick-edit-tracking[data-order-id="' + trackingOrderId + '"]').data('value', newValue);
			}
			$('#tracking-modal').modal('hide');
		},
		error: function() {
			$('#tracking-modal').modal('hide');
		}
	});
}

$(document).on('click', '.btn-quick-edit-tracking', function() {
	openTrackingModal($(this).data('order-id'), $(this).data('value'));
});
//--></script></div>
