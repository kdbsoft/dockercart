  <script type="text/javascript"><!--
$('input[name^=\'selected\']:first').trigger('change');

$('#button-print').on('click', function(e) {
	e.preventDefault();

	var selected = $('input[name^=\'selected\']:checked');

	if (!selected.length) {
		return;
	}

	var orderIds = [];

	selected.each(function() {
		orderIds.push($(this).val());
	});

	window.open('{{ print_url }}&order_id=' + orderIds.join(','), '_blank');
});

$('#button-export-csv').on('click', function(e) {
	e.preventDefault();

	var selected = $('input[name^=\'selected\']:checked');

	if (!selected.length || $(this).prop('disabled')) {
		return;
	}

	var orderIds = [];

	selected.each(function() {
		orderIds.push($(this).val());
	});

	var button = $(this);

	button.prop('disabled', true);
	button.find('i[data-lucide="download"]').hide();
	$('#csv-export-spinner').show();

	window.location.href = '{{ export_url }}&order_id=' + orderIds.join(',');

	function resetExportButton() {
		button.prop('disabled', false);
		button.find('i[data-lucide="download"]').show();
		$('#csv-export-spinner').hide();
	}

	window.setTimeout(resetExportButton, 10000);

	$(window).one('focus', resetExportButton);
});

$('.button-order-delete').on('click', function(e) {
	e.preventDefault();
	
  var element = this;
  var orderId = $(element).data('order-id');
	
	if (confirm('{{ text_confirm }}')) {
		$.ajax({
      url: 'index.php?route=sale/order/deleteOrder&user_token={{ user_token }}&order_id=' + orderId,
			dataType: 'json',
			beforeSend: function() {
        $(element).button('loading');
			},
			complete: function() {
        $(element).button('reset');
			},
			success: function(json) {
				$('.alert-dismissible').remove();
	
				if (json['error']) {
					$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				}
	
				if (json['success']) {
					location = '{{ delete }}';
				}
			},
			error: function(xhr, ajaxOptions, thrownError) {
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});
	}
});
//--></script> 
  <script type="text/javascript"><!--
$('#button-delete').on('click', function(e) {
	e.preventDefault();

	var selected = $('input[name^=\'selected\']:checked');

	if (!selected.length) {
		return;
	}

	if (!confirm('{{ text_confirm_mass_delete }}')) {
		return;
	}

	var element = this;
	var orderIds = [];

	selected.each(function() {
		orderIds.push($(this).val());
	});

	$(element).button('loading');

	var completed = 0;
	var errors = [];

	function deleteNext() {
		if (completed >= orderIds.length) {
			$(element).button('reset');

			if (errors.length) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + errors.join('<br />') + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			} else {
				location = '{{ delete }}';
			}

			return;
		}

		$.ajax({
			url: 'index.php?route=sale/order/deleteOrder&user_token={{ user_token }}&order_id=' + orderIds[completed],
			dataType: 'json',
			success: function(json) {
				if (json['error']) {
					errors.push(json['error']);
				}

				completed++;
				deleteNext();
			},
			error: function(xhr, ajaxOptions, thrownError) {
				errors.push(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);

				completed++;
				deleteNext();
			}
		});
	}

	deleteNext();
});
//--></script> 
