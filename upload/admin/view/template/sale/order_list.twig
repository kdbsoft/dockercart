{{ header }}{{ column_left }}
<div id="content">
  <style>
    .spin { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .ship-progress { height:5px; background:#eee; border-radius:3px; overflow:hidden; margin-top:4px; max-width:120px; }
    .ship-progress__bar { height:100%; background:#22c55e; border-radius:3px; }
  </style>
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            {% if customer_groups|length > 1 %}
            <button type="button" id="button-new-order" class="btn btn-primary" data-toggle="modal" data-target="#new-order-modal"><i data-lucide="plus" width="16" height="16"></i> {{ button_new_order }}</button>
            {% else %}
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_new_order }}</a>
            {% endif %}
            <button type="button" id="button-export-csv" class="btn btn-success dc-btn-selection">
              <i data-lucide="download" width="16" height="16"></i> {{ button_export_csv }}
              <i data-lucide="loader" width="16" height="16" class="spin" id="csv-export-spinner" style="display:none"></i>
            </button>
            <button type="button" id="button-print" class="btn btn-default dc-btn-selection"><i data-lucide="printer" width="16" height="16"></i> {{ button_print_selected }}</button>
            <button type="button" id="button-delete" class="btn btn-danger dc-btn-selection"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">{% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {{ user_filter }}
    <div id="filter-order" class="filter-bar hidden">
      <div class="panel panel-default">
        <div class="panel-body">
          <div class="order-filter-layout">
            <div class="order-filter-fields">
              <div class="filter-field">
                <label for="input-order-id">{{ entry_order_id }}</label>
                <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control" />
              </div>
              <div class="filter-field">
                <label for="input-customer">{{ entry_customer }} <span data-toggle="tooltip" title="{{ help_filter_customer }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
              </div>
              <div class="filter-field">
                <label for="input-order-status">{{ entry_order_status }}</label>
                <select name="filter_order_status_id" id="input-order-status" class="form-control">
                  <option value=""></option>
                  {% if filter_order_status_id == '0' %}
                  <option value="0" selected="selected">{{ text_missing }}</option>
                  {% else %}
                  <option value="0">{{ text_missing }}</option>
                  {% endif %}
                  {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == filter_order_status_id %}
                  <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                  <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              <div class="filter-field">
                <label for="input-payment-status">{{ text_payment_status }}</label>
                <select name="filter_payment_status" id="input-payment-status" class="form-control">
                  <option value=""></option>
                  {% for value, text in payment_statuses %}
                  <option value="{{ value }}" {% if filter_payment_status == value %}selected="selected"{% endif %}>{{ text }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="filter-field">
                <label for="input-shipping-status">{{ text_shipping_status }}</label>
                <select name="filter_shipping_status" id="input-shipping-status" class="form-control">
                  <option value=""></option>
                  {% for value, text in shipping_statuses %}
                  <option value="{{ value }}" {% if filter_shipping_status == value %}selected="selected"{% endif %}>{{ text }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="filter-field">
                <label for="input-total">{{ entry_total }}</label>
                <input type="text" name="filter_total" value="{{ filter_total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control" />
              </div>
              <div class="filter-field">
                <label for="input-date-added">{{ entry_date_added }}</label>
                <div class="filter-field-date date" data-date-format="YYYY-MM-DD">
                  <input type="text" name="filter_date_added" value="{{ filter_date_added }}" placeholder="{{ entry_date_added }}" id="input-date-added" class="form-control" />
                  <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                </div>
              </div>
              <div class="filter-actions">
                <button type="button" id="button-filter" class="btn btn-default"><i data-lucide="funnel" width="14" height="14"></i> {{ button_filter }}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
        {% if orders %}
        <form method="post" action="" enctype="multipart/form-data" id="form-order">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked).trigger('change');" /></td>
                  <td class="text-right">{% if sort == 'o.order_id' %} <a href="{{ sort_order }}" class="{{ order|lower }} sortable">{{ column_order_id }}</a> {% else %} <a href="{{ sort_order }}" class="sortable">{{ column_order_id }}</a> {% endif %}</td>
                  <td class="text-left">{% if sort == 'customer' %} <a href="{{ sort_customer }}" class="{{ order|lower }} sortable">{{ column_customer }}</a> {% else %} <a href="{{ sort_customer }}" class="sortable">{{ column_customer }}</a> {% endif %}</td>
                  <td class="text-left">{% if sort == 'o.date_added' %} <a href="{{ sort_date_added }}" class="{{ order|lower }} sortable">{{ column_date_added }}</a> {% else %} <a href="{{ sort_date_added }}" class="sortable">{{ column_date_added }}</a> {% endif %}</td>
                  <td class="text-left">{% if sort == 'order_status' %} <a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a> {% else %} <a href="{{ sort_status }}" class="sortable">{{ column_status }}</a> {% endif %}</td>
                  <td class="text-left">{{ text_payment_status }}</td>
                  <td class="text-left">{{ column_shipping }}</td>
                  <td class="text-center">{{ column_items }}</td>
                  <td class="text-right">{% if sort == 'o.total' %} <a href="{{ sort_total }}" class="{{ order|lower }} sortable">{{ column_total }}</a> {% else %} <a href="{{ sort_total }}" class="sortable">{{ column_total }}</a> {% endif %}</td>
                </tr>
              </thead>
              <tbody>
              
              {% for order in orders %}
              <tr data-href="{{ order.view }}" data-order-id="{{ order.order_id }}">
                <td class="text-center"> {% if order.order_id in selected %}
                  <input type="checkbox" name="selected[]" value="{{ order.order_id }}" checked="checked" />
                  {% else %}
                  <input type="checkbox" name="selected[]" value="{{ order.order_id }}" />
                  {% endif %}
                  <input type="hidden" name="shipping_code[]" value="{{ order.shipping_code }}" /></td>
                <td class="text-right" style="padding-top:8px;padding-bottom:8px;"><a href="{{ order.view }}" class="row-title-link">{{ order.order_id }}</a>{% if order.invoice_no %}<br><small class="text-muted" style="white-space:nowrap"><span data-toggle="tooltip" title="{{ text_invoice_no }}"><i data-lucide="file-text" width="11" height="11"></i></span> {{ order.invoice_no }}</small>{% endif %}</td>
                <td class="text-left" style="padding-top:8px;padding-bottom:8px;">{{ order.customer }}<br><small class="text-muted">{{ order.customer_type }}</small></td>
                <td class="text-left" style="padding-top:8px;padding-bottom:8px;">{{ order.date_added }}</td>
                <td class="text-left">
                  <a href="#" class="js-order-status" data-order-id="{{ order.order_id }}" data-order-view="{{ order.view }}" data-toggle="tooltip" title="{{ text_list_status_change }}" style="text-decoration:none">
                    <span id="os-badge-{{ order.order_id }}" class="{{ order.order_status_badge_class }}">{{ order.order_status }}</span>
                  </a>
                </td>
                <td class="text-left"><a href="#" class="js-order-payment" data-order-id="{{ order.order_id }}" data-toggle="tooltip" title="{{ text_list_payment_change }}" style="text-decoration:none"><span id="ps-badge-{{ order.order_id }}" class="{{ order.payment_status_badge_class }}">{{ order.payment_status_text }}</span></a>{% if order.payment_method %}<div style="font-size:11px;color:#888;margin-top:2px">{{ order.payment_method }}</div>{% endif %}{% if order.paid_amount %}<div style="font-size:11px;color:#888;margin-top:1px" id="ps-paid-{{ order.order_id }}">{{ order.paid_amount }}</div>{% endif %}</td>
                <td class="text-left" style="font-size:12px;color:#555"><a href="#" class="js-order-shipment" data-order-id="{{ order.order_id }}" data-toggle="tooltip" title="{{ text_list_shipment_change }}" style="text-decoration:none">{% if order.shipping_status %}<span id="ss-badge-{{ order.order_id }}" class="{{ order.shipping_status_badge_class }}" data-toggle="tooltip" title="{{ order.shipping_shipped_quantity }} / {{ order.shipping_ordered_quantity }}">{{ order.shipping_status_text }}</span><div class="ship-progress"><div id="ss-bar-{{ order.order_id }}" class="ship-progress__bar" style="width: {{ order.shipping_progress_percent }}%"></div></div>{% endif %}</a>{{ order.shipping_method }}{% if order.tracking_number %}<div style="font-size:11px;color:#888;margin-top:2px;white-space:nowrap"><i data-lucide="truck" width="11" height="11" style="vertical-align:-1px"></i> {{ order.tracking_number|replace({'|': ' | '}) }}</div>{% endif %}</td>
                <td class="text-center" style="padding-top:8px;padding-bottom:8px;">{{ order.items_count }}</td>
                <td class="text-right">{{ order.total }}</td>
              </tr>
              {% endfor %}
                </tbody>
              
            </table>
          </div>
        </form>
        <div class="pagination-wrap">
          <div class="pagination-wrap__pages">{{ pagination }}</div>
          <div class="pagination-wrap__results">{{ results }}</div>
        </div>
        {% else %}
        {% include 'common/empty_state.twig' with {
          icon: 'order',
          standalone: true,
          title: text_empty_title,
          description: text_empty_description,
          action_url: add,
          action_text: button_add
        } %}
        {% endif %}
  </div>
  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	url = '';

	var filter_order_id = $('input[name=\'filter_order_id\']').val();

	if (filter_order_id) {
		url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
	}

	var filter_customer = $('input[name=\'filter_customer\']').val();

	if (filter_customer) {
		url += '&filter_customer=' + encodeURIComponent(filter_customer);
	}

	var filter_order_status_id = $('select[name=\'filter_order_status_id\']').val();

	if (filter_order_status_id !== '') {
		url += '&filter_order_status_id=' + encodeURIComponent(filter_order_status_id);
	}

	var filter_payment_status = $('select[name=\'filter_payment_status\']').val();

	if (filter_payment_status) {
		url += '&filter_payment_status=' + encodeURIComponent(filter_payment_status);
	}

	var filter_shipping_status = $('select[name=\'filter_shipping_status\']').val();

	if (filter_shipping_status) {
		url += '&filter_shipping_status=' + encodeURIComponent(filter_shipping_status);
	}

	var filter_total = $('input[name=\'filter_total\']').val();

	if (filter_total) {
		url += '&filter_total=' + encodeURIComponent(filter_total);
	}

	var filter_date_added = $('input[name=\'filter_date_added\']').val();

	if (filter_date_added) {
		url += '&filter_date_added=' + encodeURIComponent(filter_date_added);
	}

	location = 'index.php?route=sale/order&user_token={{ user_token }}' + url;
});
//--></script> 
  <script type="text/javascript"><!--
$('#filter-order input, #filter-order select').on('keypress', function(e) {
	if (e.which == 13) { $('#button-filter').trigger('click'); }
});
//--></script> 
  <script type="text/javascript"><!--
$('input[name=\'filter_customer\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=customer/customer/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['customer_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_customer\']').val(item['label']);
	}
});
