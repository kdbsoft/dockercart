  <script type="text/javascript"><!--
function listEsc(s) {
	return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function listAlert(message, type) {
	type = type || 'success';
	$('.alert-dismissible').remove();
	$('#content > .container-fluid').prepend('<div class="alert alert-' + type + ' alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + listEsc(message) + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
	if (window.lucide) { lucide.createIcons(); }
}

function listPaymentBadgeClass(status) {
	if (status === 'paid') { return 'page-header__badge page-header__badge--success'; }
	if (status === 'partial') { return 'page-header__badge page-header__badge--warning page-header__badge--unfilled'; }
	if (status === 'overpaid') { return 'page-header__badge page-header__badge--danger'; }
	return 'page-header__badge page-header__badge--default page-header__badge--unfilled';
}

function listShippingBadgeClass(status) {
	if (status === 'shipped') { return 'page-header__badge page-header__badge--success'; }
	if (status === 'partial') { return 'page-header__badge page-header__badge--warning page-header__badge--unfilled'; }
	return 'page-header__badge page-header__badge--default page-header__badge--unfilled';
}

// ---- Order status modal (flow-aware) ----
var listStatusData = null;
var listStatusOrderView = '';

function listStatusTitleFmt() { return '{{ text_list_status_title|escape('js') }}'; }

function openOrderStatus(orderId, orderView) {
	listStatusData = null;
	listStatusOrderView = orderView || '';
	$('#status-modal-error').hide();
	$('#status-current').text('');
	$('#status-new').html('');
	$('#status-comment').val('');
	$('#status-notify').prop('checked', true);
	$('#status-override').prop('checked', false);
	$('#status-override-wrap').hide();
	$('#status-empty').hide();
	$('#status-refund-hint').hide();
	$('#status-tracking-warn').hide();
	$('#status-apply').prop('disabled', true);

	$.ajax({
		url: 'index.php?route=sale/order/getStatusData&user_token={{ user_token }}&order_id=' + orderId,
		dataType: 'json',
		success: function(json) {
			if (json['error']) { listAlert(json['error'], 'danger'); return; }
			listStatusData = json;
			$('#status-modal-title').text(listStatusTitleFmt().replace('%s', json['order_id']));
			$('#status-current').text(json['current_name']);
			if (json['flow_enabled']) { $('#status-override-wrap').show(); }
			fillStatusSelect(false);
			$('#modal-order-status').modal('show');
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
}

function fillStatusSelect(useAll) {
	if (!listStatusData) { return; }
	var list = useAll ? listStatusData['statuses'] : listStatusData['allowed'];
	var html = '';
	if (!list.length) {
		$('#status-empty').show();
	} else {
		$('#status-empty').hide();
		for (var i = 0; i < list.length; i++) {
			html += '<option value="' + list[i]['order_status_id'] + '">' + listEsc(list[i]['name']) + '</option>';
		}
	}
	$('#status-new').html(html);
	$('#status-apply').prop('disabled', !list.length);
	onStatusSelectChange();
}

function selectedStatusEntry() {
	if (!listStatusData) { return null; }
	var id = parseInt($('#status-new').val(), 10);
	var lists = [listStatusData['allowed'], listStatusData['statuses']];
	for (var l = 0; l < lists.length; l++) {
		for (var i = 0; i < lists[l].length; i++) {
			if (parseInt(lists[l][i]['order_status_id'], 10) === id) { return lists[l][i]; }
		}
	}
	return { order_status_id: id };
}

function onStatusSelectChange() {
	if (!listStatusData) { return; }
	var entry = selectedStatusEntry();
	var targetId = entry ? parseInt(entry['order_status_id'], 10) : 0;
	var isRefund = !!(entry && entry['is_refund']);
	$('#status-refund-hint').toggle(isRefund);
	$('#status-apply').prop('disabled', isRefund || !targetId);
	var needTracking = listStatusData['shipping_status_id'] > 0 && targetId === listStatusData['shipping_status_id'] && !listStatusData['has_tracking'] && !$('#status-override').prop('checked');
	$('#status-tracking-warn').toggle(needTracking);
}

$(document).on('click', '.js-order-status', function(e) {
	e.preventDefault();
	openOrderStatus($(this).data('order-id'), $(this).data('order-view'));
});

$(document).on('change', '#status-override', function() {
	fillStatusSelect($(this).prop('checked'));
});

$(document).on('change', '#status-new', onStatusSelectChange);

$(document).on('click', '#status-refund-link', function(e) {
	e.preventDefault();
	if (listStatusOrderView) { location = listStatusOrderView; }
});

$(document).on('click', '#status-apply', function() {
	if (!listStatusData) { return; }
	var entry = selectedStatusEntry();
	var targetId = entry ? parseInt(entry['order_status_id'], 10) : 0;
	if (!targetId) { return; }
	if (entry && entry['terminal'] && !confirm('{{ text_flow_confirm_terminal|escape('js') }}')) { return; }
	var element = this;
	$.ajax({
		url: 'index.php?route=sale/order/addHistory&user_token={{ user_token }}&order_id=' + listStatusData['order_id'],
		type: 'post',
		dataType: 'json',
