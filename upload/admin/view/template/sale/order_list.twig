{{ header }}{{ column_left }}
<div id="content">
  <style>
    .spin { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  </style>
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_new_order }}</a>
            <button type="button" id="button-export-csv" class="btn btn-success dc-btn-selection">
              <i data-lucide="download" width="16" height="16"></i> {{ button_export_csv }}
              <i data-lucide="loader" width="16" height="16" class="spin" id="csv-export-spinner" style="display:none"></i>
            </button>
            <button type="button" id="button-print" class="btn btn-default dc-btn-selection"><i data-lucide="printer" width="16" height="16"></i> {{ button_print_selected }}</button>
            <button type="button" id="button-delete" class="btn btn-danger dc-btn-selection"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">{% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {{ user_filter }}
    <div id="filter-order" class="filter-bar hidden">
      <div class="panel panel-default">
        <div class="panel-body">
          <div class="order-filter-layout">
            <div class="order-filter-fields">
              <div class="filter-field">
                <label for="input-order-id">{{ entry_order_id }}</label>
                <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control" />
              </div>
              <div class="filter-field">
                <label for="input-customer">{{ entry_customer }}</label>
                <div class="dcx-field-icon-wrap">
                  <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" id="input-customer" class="form-control" />
                  <span class="dcx-field-icon" data-toggle="tooltip" title="{{ help_filter_customer }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                </div>
              </div>
              <div class="filter-field">
                <label for="input-order-status">{{ entry_order_status }}</label>
                <select name="filter_order_status_id" id="input-order-status" class="form-control">
                  <option value=""></option>
                  {% if filter_order_status_id == '0' %}
                  <option value="0" selected="selected">{{ text_missing }}</option>
                  {% else %}
                  <option value="0">{{ text_missing }}</option>
                  {% endif %}
                  {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == filter_order_status_id %}
                  <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                  {% else %}
                  <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
              <div class="filter-field">
                <label for="input-payment-status">{{ text_payment_status }}</label>
                <select name="filter_payment_status" id="input-payment-status" class="form-control">
                  <option value=""></option>
                  {% for value, text in payment_statuses %}
                  <option value="{{ value }}" {% if filter_payment_status == value %}selected="selected"{% endif %}>{{ text }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="filter-field">
                <label for="input-total">{{ entry_total }}</label>
                <input type="text" name="filter_total" value="{{ filter_total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control" />
              </div>
              <div class="filter-field">
                <label for="input-date-added">{{ entry_date_added }}</label>
                <div class="filter-field-date date" data-date-format="YYYY-MM-DD">
                  <input type="text" name="filter_date_added" value="{{ filter_date_added }}" placeholder="{{ entry_date_added }}" id="input-date-added" class="form-control" />
                  <button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button>
                </div>
              </div>
              <div class="filter-actions">
                <button type="button" id="button-filter" class="btn btn-default"><i data-lucide="funnel" width="14" height="14"></i> {{ button_filter }}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
        <form method="post" action="" enctype="multipart/form-data" id="form-order">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked).trigger('change');" /></td>
                  <td class="text-right">{% if sort == 'o.order_id' %} <a href="{{ sort_order }}" class="{{ order|lower }}">{{ column_order_id }}</a> {% else %} <a href="{{ sort_order }}">{{ column_order_id }}</a> {% endif %}</td>
                  <td class="text-left">{% if sort == 'customer' %} <a href="{{ sort_customer }}" class="{{ order|lower }}">{{ column_customer }}</a> {% else %} <a href="{{ sort_customer }}">{{ column_customer }}</a> {% endif %}</td>
                  <td class="text-left">{% if sort == 'o.date_added' %} <a href="{{ sort_date_added }}" class="{{ order|lower }}">{{ column_date_added }}</a> {% else %} <a href="{{ sort_date_added }}">{{ column_date_added }}</a> {% endif %}</td>
                  <td class="text-left">{% if sort == 'order_status' %} <a href="{{ sort_status }}" class="{{ order|lower }}">{{ column_status }}</a> {% else %} <a href="{{ sort_status }}">{{ column_status }}</a> {% endif %}</td>
                  <td class="text-left">{{ text_payment_status }}</td>
                  <td class="text-left">{{ column_shipping }}</td>
                  <td class="text-center">{{ column_items }}</td>
                  <td class="text-right">{% if sort == 'o.total' %} <a href="{{ sort_total }}" class="{{ order|lower }}">{{ column_total }}</a> {% else %} <a href="{{ sort_total }}">{{ column_total }}</a> {% endif %}</td>
                </tr>
              </thead>
              <tbody>
              
              {% if orders %}
              {% for order in orders %}
              <tr data-href="{{ order.view }}">
                <td class="text-center"> {% if order.order_id in selected %}
                  <input type="checkbox" name="selected[]" value="{{ order.order_id }}" checked="checked" />
                  {% else %}
                  <input type="checkbox" name="selected[]" value="{{ order.order_id }}" />
                  {% endif %}
                  <input type="hidden" name="shipping_code[]" value="{{ order.shipping_code }}" /></td>
                <td class="text-right" style="padding-top:8px;padding-bottom:8px;"><a href="{{ order.view }}" class="row-title-link">{{ order.order_id }}</a></td>
                <td class="text-left" style="padding-top:8px;padding-bottom:8px;">{{ order.customer }}<br><small class="text-muted">{{ order.customer_type }}</small></td>
                <td class="text-left" style="padding-top:8px;padding-bottom:8px;">{{ order.date_added }}</td>
                <td class="text-left">
                  <span class="{{ order.order_status_badge_class }}">{{ order.order_status }}</span>
                </td>
                <td class="text-left"><span class="{{ order.payment_status_badge_class }}">{{ order.payment_status_text }}</span>{% if order.payment_method %}<div style="font-size:11px;color:#888;margin-top:2px">{{ order.payment_method }}</div>{% endif %}{% if order.paid_amount %}<div style="font-size:11px;color:#888;margin-top:1px">{{ order.paid_amount }}</div>{% endif %}</td>
                <td class="text-left" style="font-size:12px;color:#555">{{ order.shipping_method }}{% if order.tracking_number %}<div style="font-size:11px;color:#888;margin-top:2px;white-space:nowrap"><i data-lucide="truck" width="11" height="11" style="vertical-align:-1px"></i> {{ order.tracking_number|replace({'|': ' | '}) }}</div>{% endif %}</td>
                <td class="text-center" style="padding-top:8px;padding-bottom:8px;">{{ order.items_count }}</td>
                <td class="text-right">{{ order.total }}</td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="9">{{ text_no_results }}</td>
              </tr>
              {% endif %}
                </tbody>
              
            </table>
          </div>
        </form>
        <div class="pagination-wrap">
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
  </div>
  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	url = '';

	var filter_order_id = $('input[name=\'filter_order_id\']').val();

	if (filter_order_id) {
		url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
	}

	var filter_customer = $('input[name=\'filter_customer\']').val();

	if (filter_customer) {
		url += '&filter_customer=' + encodeURIComponent(filter_customer);
	}

	var filter_order_status_id = $('select[name=\'filter_order_status_id\']').val();

	if (filter_order_status_id !== '') {
		url += '&filter_order_status_id=' + encodeURIComponent(filter_order_status_id);
	}

	var filter_payment_status = $('select[name=\'filter_payment_status\']').val();

	if (filter_payment_status) {
		url += '&filter_payment_status=' + encodeURIComponent(filter_payment_status);
	}

	var filter_total = $('input[name=\'filter_total\']').val();

	if (filter_total) {
		url += '&filter_total=' + encodeURIComponent(filter_total);
	}

	var filter_date_added = $('input[name=\'filter_date_added\']').val();

	if (filter_date_added) {
		url += '&filter_date_added=' + encodeURIComponent(filter_date_added);
	}

	location = 'index.php?route=sale/order&user_token={{ user_token }}' + url;
});
//--></script> 
  <script type="text/javascript"><!--
$('#filter-order input, #filter-order select').on('keypress', function(e) {
	if (e.which == 13) { $('#button-filter').trigger('click'); }
});
//--></script> 
  <script type="text/javascript"><!--
$('input[name=\'filter_customer\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=customer/customer/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['customer_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_customer\']').val(item['label']);
	}
});
//--></script>
  <script type="text/javascript"><!--
$('input[name^=\'selected\']:first').trigger('change');

$('#button-print').on('click', function(e) {
	e.preventDefault();

	var selected = $('input[name^=\'selected\']:checked');

	if (!selected.length) {
		return;
	}

	var orderIds = [];

	selected.each(function() {
		orderIds.push($(this).val());
	});

	window.open('{{ print_url }}&order_id=' + orderIds.join(','), '_blank');
});

$('#button-export-csv').on('click', function(e) {
	e.preventDefault();

	var selected = $('input[name^=\'selected\']:checked');

	if (!selected.length || $(this).prop('disabled')) {
		return;
	}

	var orderIds = [];

	selected.each(function() {
		orderIds.push($(this).val());
	});

	var button = $(this);

	button.prop('disabled', true);
	button.find('i[data-lucide="download"]').hide();
	$('#csv-export-spinner').show();

	window.location.href = '{{ export_url }}&order_id=' + orderIds.join(',');

	function resetExportButton() {
		button.prop('disabled', false);
		button.find('i[data-lucide="download"]').show();
		$('#csv-export-spinner').hide();
	}

	window.setTimeout(resetExportButton, 10000);

	$(window).one('focus', resetExportButton);
});

$('.button-order-delete').on('click', function(e) {
	e.preventDefault();
	
  var element = this;
  var orderId = $(element).data('order-id');
	
	if (confirm('{{ text_confirm }}')) {
		$.ajax({
      url: 'index.php?route=sale/order/deleteOrder&user_token={{ user_token }}&order_id=' + orderId,
			dataType: 'json',
			beforeSend: function() {
        $(element).button('loading');
			},
			complete: function() {
        $(element).button('reset');
			},
			success: function(json) {
				$('.alert-dismissible').remove();
	
				if (json['error']) {
					$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				}
	
				if (json['success']) {
					location = '{{ delete }}';
				}
			},
			error: function(xhr, ajaxOptions, thrownError) {
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});
	}
});
//--></script> 
  <script type="text/javascript"><!--
$('#button-delete').on('click', function(e) {
	e.preventDefault();

	var selected = $('input[name^=\'selected\']:checked');

	if (!selected.length) {
		return;
	}

	if (!confirm('{{ text_confirm_mass_delete }}')) {
		return;
	}

	var element = this;
	var orderIds = [];

	selected.each(function() {
		orderIds.push($(this).val());
	});

	$(element).button('loading');

	var completed = 0;
	var errors = [];

	function deleteNext() {
		if (completed >= orderIds.length) {
			$(element).button('reset');

			if (errors.length) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + errors.join('<br />') + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			} else {
				location = '{{ delete }}';
			}

			return;
		}

		$.ajax({
			url: 'index.php?route=sale/order/deleteOrder&user_token={{ user_token }}&order_id=' + orderIds[completed],
			dataType: 'json',
			success: function(json) {
				if (json['error']) {
					errors.push(json['error']);
				}

				completed++;
				deleteNext();
			},
			error: function(xhr, ajaxOptions, thrownError) {
				errors.push(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);

				completed++;
				deleteNext();
			}
		});
	}

	deleteNext();
});
//--></script> 
