  <script type="text/javascript"><!--
// Order status change
$('.order-status-select').on('change', function() {
	var element = this;
	var orderId = $(element).data('order-id');
	var statusId = $(element).val();
	var notify = $(element).closest('td').find('.order-notify-check').prop('checked') ? 1 : 0;

	$.ajax({
		url: 'index.php?route=sale/order/addHistory&user_token={{ user_token }}&order_id=' + orderId,
		type: 'post',
		dataType: 'json',
		data: 'order_status_id=' + encodeURIComponent(statusId) + '&notify=' + notify + '&comment=',
		beforeSend: function() {
			$(element).prop('disabled', true);
		},
		complete: function() {
			$(element).prop('disabled', false);
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}

			if (json['success']) {
				$('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
</div>
