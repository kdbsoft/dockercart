// ---- Payment modal (same endpoints as the order edit page) ----
var listPaymentOrderId = 0;
var listPaymentDirty = false;

function listPaymentTitleFmt() { return '{{ text_list_payment_title|escape('js') }}'; }

$(document).on('click', '.js-order-payment', function(e) {
	e.preventDefault();
	openOrderPayment($(this).data('order-id'));
});

function openOrderPayment(orderId) {
	listPaymentOrderId = orderId;
	listPaymentDirty = false;
	$('#payment-modal-error').hide();
	$('#payment-summary').html('');
	$('#payment-list').html('');
	$('#payment-amount').val('');
	$('#payment-reference').val('');
	$('#payment-comment').val('');
	$('#refund-amount').val('');
	$('#refund-comment').val('');
	refreshPaymentModal();
	$('#modal-order-payment').modal('show');
}

function refreshPaymentModal() {
	$.ajax({
		url: 'index.php?route=sale/order/getPaymentData&user_token={{ user_token }}&order_id=' + listPaymentOrderId,
		dataType: 'json',
		success: function(json) {
			if (json['error']) { $('#payment-modal-error').text(json['error']).show(); return; }
			$('#payment-modal-error').hide();
			$('#payment-modal-title').text(listPaymentTitleFmt().replace('%s', json['order_id']));
			renderPaymentModal(json);
			updatePaymentRow(json);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
}

function renderPaymentModal(json) {
	var html = '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px">';
	html += '<span class="' + listPaymentBadgeClass(json['payment_status']) + '">' + listEsc(json['payment_status_text']) + '</span>';
	html += '<span class="text-muted" style="font-size:12px">{{ text_payment_paid_of|escape('js') }} ' + listEsc(json['paid_amount']) + ' / ' + listEsc(json['total']) + '</span>';
	html += '<span class="text-muted" style="font-size:12px">{{ text_payment_remaining|escape('js') }}: ' + listEsc(json['remaining']) + '</span>';
	html += '</div>';
	$('#payment-summary').html(html);

	var list = '';
	if (json['payments'] && json['payments'].length) {
		for (var i = 0; i < json['payments'].length; i++) {
			var p = json['payments'][i];
			list += '<div style="display:flex;justify-content:space-between;gap:8px;padding:6px 0;border-top:1px solid #eee;font-size:12px">';
			list += '<span class="' + (p['is_reversal'] ? 'text-danger' : 'text-success') + '">' + (p['is_reversal'] ? '−' : '+') + ' ' + listEsc(p['amount']) + '</span>';
			list += '<span class="text-muted">' + listEsc(p['payment_method']) + (p['reference'] ? ' · ' + listEsc(p['reference']) : '') + ' · ' + listEsc(p['date_added']) + '</span>';
			if (!p['is_reversal']) {
				list += '<button type="button" class="btn btn-xs btn-danger" onclick="listRemovePayment(' + p['order_payment_id'] + ')" title="{{ button_remove_payment|escape('js') }}"><i data-lucide="x" width="11" height="11"></i></button>';
			} else {
				list += '<span></span>';
			}
			list += '</div>';
			if (p['comment']) { list += '<div class="text-muted" style="font-size:11px;margin:-2px 0 4px">' + listEsc(p['comment']) + '</div>'; }
		}
	} else {
		list = '<div class="text-muted" style="font-size:12px">{{ text_no_payments|escape('js') }}</div>';
	}
	$('#payment-list').html(list);

	var methods = '<option value="" data-code="">{{ text_select|escape('js') }}</option>';
	for (var m = 0; m < json['payment_methods'].length; m++) {
		var sel = json['payment_methods'][m]['code'] === json['payment_code'] ? ' selected="selected"' : '';
		methods += '<option value="' + listEsc(json['payment_methods'][m]['title']) + '" data-code="' + listEsc(json['payment_methods'][m]['code']) + '"' + sel + '>' + listEsc(json['payment_methods'][m]['title']) + '</option>';
	}
	$('#list-payment-method').html(methods);
	if (!$('#payment-amount').val() && json['remaining_raw'] > 0) {
		$('#payment-amount').val(parseFloat(json['remaining_raw']).toFixed(2));
	}
	$('#payment-refund-block').toggle(json['paid_amount_raw'] > 0);
	$('#payment-overpaid-block').toggle(json['overpaid_raw'] > 0);
	if (window.lucide) { lucide.createIcons(); }
}

function updatePaymentRow(json) {
	var badge = document.getElementById('ps-badge-' + json['order_id']);
	if (badge) {
		badge.textContent = json['payment_status_text'];
		badge.className = listPaymentBadgeClass(json['payment_status']);
	}
	var paid = document.getElementById('ps-paid-' + json['order_id']);
	if (paid) { paid.textContent = json['paid_amount']; }
}

$(document).on('click', '#payment-add', function() {
	var amount = $('#payment-amount').val();
	if (!amount || parseFloat(amount) <= 0) { $('#payment-modal-error').text('{{ error_payment_amount|escape('js') }}').show(); return; }
	var methodSel = document.getElementById('list-payment-method');
	var methodTitle = methodSel ? methodSel.value : '';
	var methodCode = methodSel && methodSel.selectedIndex >= 0 ? methodSel.options[methodSel.selectedIndex].getAttribute('data-code') : '';
	var element = this;
	$.ajax({
		url: 'index.php?route=sale/order_detail/addPayment&user_token={{ user_token }}&order_id=' + listPaymentOrderId,
		type: 'post',
		dataType: 'json',
		data: 'amount=' + encodeURIComponent(amount) + '&payment_method=' + encodeURIComponent(methodTitle) + '&payment_code=' + encodeURIComponent(methodCode) + '&reference=' + encodeURIComponent($('#payment-reference').val()) + '&comment=' + encodeURIComponent($('#payment-comment').val()),
		beforeSend: function() { $(element).prop('disabled', true); },
		complete: function() { $(element).prop('disabled', false); },
		success: function(json) {
			if (json['error']) { $('#payment-modal-error').text(json['error']).show(); return; }
			$('#payment-modal-error').hide();
			$('#payment-amount').val('');
			$('#payment-reference').val('');
			$('#payment-comment').val('');
			listPaymentDirty = true;
			refreshPaymentModal();
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$(document).on('click', '#refund-add', function() {
	var amount = $('#refund-amount').val();
	if (!amount || parseFloat(amount) <= 0) { $('#payment-modal-error').text('{{ error_refund_amount|escape('js') }}').show(); return; }
	var element = this;
	$.ajax({
		url: 'index.php?route=sale/order_detail/addRefund&user_token={{ user_token }}&order_id=' + listPaymentOrderId,
		type: 'post',
		dataType: 'json',
		data: 'amount=' + encodeURIComponent(amount) + '&comment=' + encodeURIComponent($('#refund-comment').val()),
		beforeSend: function() { $(element).prop('disabled', true); },
		complete: function() { $(element).prop('disabled', false); },
		success: function(json) {
			if (json['error']) { $('#payment-modal-error').text(json['error']).show(); return; }
			$('#payment-modal-error').hide();
			$('#refund-amount').val('');
			$('#refund-comment').val('');
			listPaymentDirty = true;
			refreshPaymentModal();
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

function listRemovePayment(orderPaymentId) {
