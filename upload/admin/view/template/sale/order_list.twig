        <div id="payment-overpaid-block" class="alert alert-warning" style="display:none;margin-top:15px">
          {{ text_payment_overpaid_hint }}
          <div style="margin-top:8px"><button type="button" class="btn btn-xs btn-warning" id="overpayment-remove"><i data-lucide="undo-2" width="12" height="12"></i> {{ button_remove_overpayment }}</button></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-order-shipment" tabindex="-1" role="dialog" aria-labelledby="shipment-modal-title">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="{{ button_cancel }}"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="shipment-modal-title"></h4>
      </div>
      <div class="modal-body">
        <div id="shipment-modal-error" class="alert alert-danger" style="display:none"></div>
        <p class="text-muted" style="font-size:12px">{{ text_list_shipment_hint }}</p>
        <div id="shipment-summary"></div>
        <div id="shipment-list"></div>
        <hr />
        <div class="form-group">
          <label for="shipment-tracking">{{ entry_tracking_number }}</label>
          <input type="text" id="shipment-tracking" class="form-control" />
          <div class="text-muted" style="font-size:11px;margin-top:3px">{{ entry_tracking_number_hint }}</div>
        </div>
        <div class="form-group">
          <label>{{ text_shipment_items }}</label>
          <div id="shipment-items"></div>
        </div>
        <div class="form-group">
          <label for="shipment-comment">{{ entry_comment }}</label>
          <textarea id="shipment-comment" class="form-control" rows="2"></textarea>
        </div>
        <div class="checkbox">
          <label><input type="checkbox" id="shipment-notify" checked="checked" /> {{ entry_notify }}</label>
        </div>
        <button type="button" class="btn btn-success" id="shipment-add"><i data-lucide="plus" width="14" height="14"></i> {{ button_add_shipment }}</button>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
      </div>
    </div>
  </div>
</div>
</div>
{{ footer }}
