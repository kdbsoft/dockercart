// ---- Shipment modal (same endpoints as the order edit page) ----
var listShipmentOrderId = 0;
var listShipmentDirty = false;

function listShipmentTitleFmt() { return '{{ text_list_shipment_title|escape('js') }}'; }

$(document).on('click', '.js-order-shipment', function(e) {
	e.preventDefault();
	openOrderShipment($(this).data('order-id'));
});

function openOrderShipment(orderId) {
	listShipmentOrderId = orderId;
	listShipmentDirty = false;
	$('#shipment-modal-error').hide();
	$('#shipment-summary').html('');
	$('#shipment-list').html('');
	$('#shipment-items').html('');
	$('#shipment-tracking').val('');
	$('#shipment-comment').val('');
	$('#shipment-notify').prop('checked', true);
	refreshShipmentModal();
	$('#modal-order-shipment').modal('show');
}

function refreshShipmentModal() {
	$.ajax({
		url: 'index.php?route=sale/order/getShipmentData&user_token={{ user_token }}&order_id=' + listShipmentOrderId,
		dataType: 'json',
		success: function(json) {
			if (json['error']) { $('#shipment-modal-error').text(json['error']).show(); return; }
			$('#shipment-modal-error').hide();
			$('#shipment-modal-title').text(listShipmentTitleFmt().replace('%s', json['order_id']));
			renderShipmentModal(json);
			updateShipmentRow(json);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
}

function renderShipmentModal(json) {
	var percent = json['ordered_total'] > 0 ? Math.round(Math.min(json['shipped_total'], json['ordered_total']) / json['ordered_total'] * 100) : 0;
	var html = '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px">';
	if (json['shipping_status']) {
		html += '<span class="' + listShippingBadgeClass(json['shipping_status']) + '">' + listEsc(json['shipping_status_text']) + '</span>';
	}
	html += '<span class="text-muted" style="font-size:12px">' + json['shipped_total'] + ' / ' + json['ordered_total'] + ' (' + percent + '%)</span>';
	html += '</div>';
	$('#shipment-summary').html(html);

	var list = '';
	if (json['shipments'] && json['shipments'].length) {
		for (var i = 0; i < json['shipments'].length; i++) {
			var s = json['shipments'][i];
			list += '<div style="padding:6px 0;border-top:1px solid #eee;font-size:12px">';
			list += '<div style="display:flex;justify-content:space-between;gap:8px"><span><i data-lucide="truck" width="12" height="12"></i> ' + listEsc(s['tracking_number']) + '</span>';
			list += '<span class="text-muted">' + listEsc(s['date_added']) + '</span>';
			list += '<button type="button" class="btn btn-xs btn-danger" onclick="listDeleteShipment(' + s['shipment_id'] + ')" title="{{ button_remove_shipment|escape('js') }}"><i data-lucide="x" width="11" height="11"></i></button></div>';
			if (s['items'] && s['items'].length) {
				for (var k = 0; k < s['items'].length; k++) {
					list += '<div class="text-muted" style="font-size:11px">' + listEsc(s['items'][k]['name']) + ' × ' + s['items'][k]['quantity'] + '</div>';
				}
			}
			if (s['comment']) { list += '<div class="text-muted" style="font-size:11px">' + listEsc(s['comment']) + '</div>'; }
			list += '</div>';
		}
	} else {
		list = '<div class="text-muted" style="font-size:12px">{{ text_no_shipments|escape('js') }}</div>';
	}
	$('#shipment-list').html(list);

	var items = '';
	for (var j = 0; j < json['products'].length; j++) {
		var p = json['products'][j];
		items += '<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:4px;font-size:12px">';
		items += '<span>' + listEsc(p['name']) + ' <span class="text-muted">' + p['shipped'] + ' / ' + p['ordered'] + '</span></span>';
		items += '<input type="number" class="form-control" style="width:80px" min="0" max="' + p['remaining'] + '" value="' + p['remaining'] + '" data-opid="' + p['order_product_id'] + '" />';
		items += '</div>';
	}
	$('#shipment-items').html(items);
	if (window.lucide) { lucide.createIcons(); }
}

function updateShipmentRow(json) {
	var percent = json['ordered_total'] > 0 ? Math.round(Math.min(json['shipped_total'], json['ordered_total']) / json['ordered_total'] * 100) : 0;
	var badge = document.getElementById('ss-badge-' + json['order_id']);
	if (badge && json['shipping_status']) {
		badge.textContent = json['shipping_status_text'];
		badge.className = listShippingBadgeClass(json['shipping_status']);
		badge.setAttribute('title', json['shipped_total'] + ' / ' + json['ordered_total']);
	}
	var bar = document.getElementById('ss-bar-' + json['order_id']);
	if (bar) { bar.style.width = percent + '%'; }
}

$(document).on('click', '#shipment-add', function() {
	var tracking = $('#shipment-tracking').val().trim();
	if (!tracking) { $('#shipment-modal-error').text('{{ error_tracking_number|escape('js') }}').show(); return; }
	var items = [];
	$('#shipment-items input[data-opid]').each(function() {
		var qty = parseInt($(this).val(), 10) || 0;
		if (qty > 0) { items.push({ order_product_id: $(this).data('opid'), quantity: qty }); }
	});
	if (!items.length) { $('#shipment-modal-error').text('{{ error_shipment_items|escape('js') }}').show(); return; }
	var element = this;
	$.ajax({
		url: 'index.php?route=sale/order_detail/addShipment&user_token={{ user_token }}&order_id=' + listShipmentOrderId,
		type: 'post',
		dataType: 'json',
		data: 'tracking_number=' + encodeURIComponent(tracking) + '&comment=' + encodeURIComponent($('#shipment-comment').val()) + '&items=' + encodeURIComponent(JSON.stringify(items)) + '&notify=' + ($('#shipment-notify').prop('checked') ? '1' : '0'),
		beforeSend: function() { $(element).prop('disabled', true); },
		complete: function() { $(element).prop('disabled', false); },
		success: function(json) {
			if (json['error']) { $('#shipment-modal-error').text(json['error']).show(); return; }
			$('#shipment-modal-error').hide();
			$('#shipment-tracking').val('');
			$('#shipment-comment').val('');
			listShipmentDirty = true;
			refreshShipmentModal();
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

function listDeleteShipment(shipmentId) {
	if (!confirm('{{ text_confirm_remove_shipment|escape('js') }}')) { return; }
	$.ajax({
		url: 'index.php?route=sale/order_detail/deleteShipment&user_token={{ user_token }}&order_id=' + listShipmentOrderId,
		type: 'post',
		dataType: 'json',
		data: 'shipment_id=' + encodeURIComponent(shipmentId),
		success: function(json) {
			if (json['error']) { $('#shipment-modal-error').text(json['error']).show(); return; }
			$('#shipment-modal-error').hide();
			listShipmentDirty = true;
			refreshShipmentModal();
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
}

$(document).on('hidden.bs.modal', '#modal-order-shipment', function() {
	if (listShipmentDirty) { location.reload(); }
});
