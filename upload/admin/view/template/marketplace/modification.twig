{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn--icon"><i data-lucide="plus" width="16" height="16"></i></a>
            <a href="{{ refresh }}" data-toggle="tooltip" title="{{ button_refresh }}" class="btn btn-info btn--icon"><i data-lucide="refresh-cw" width="16" height="16"></i></a>
            <a href="{{ clear }}" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-warning btn--icon"><i data-lucide="eraser" width="16" height="16"></i></a>
            <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn--icon" onclick="confirm('{{ text_confirm }}') ? $('#form-modification').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i></button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="alert alert-info"><i data-lucide="info" width="16" height="16"></i> {{ text_refresh }}</div>
    <ul class="nav nav-tabs">
      <li class="active"><a href="#tab-general" data-toggle="tab"><i data-lucide="file-text" width="16" height="16" style="vertical-align:middle"></i> {{ tab_general }}</a></li>
      <li><a href="#tab-log" data-toggle="tab"><i data-lucide="file-text" width="16" height="16" style="vertical-align:middle"></i> {{ tab_log }}</a></li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane active" id="tab-general">
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-modification">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-left">{% if sort == 'name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
                  <td class="text-left">{{ column_code }}</td>
                  <td class="text-left">{% if sort == 'author' %}<a href="{{ sort_author }}" class="{{ order|lower }} sortable">{{ column_author }}</a>{% else %}<a href="{{ sort_author }}" class="sortable">{{ column_author }}</a>{% endif %}</td>
                  <td class="text-left">{% if sort == 'version' %}<a href="{{ sort_version }}" class="{{ order|lower }} sortable">{{ column_version }}</a>{% else %}<a href="{{ sort_version }}" class="sortable">{{ column_version }}</a>{% endif %}</td>
                  <td class="text-left">{% if sort == 'status' %}<a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a>{% else %}<a href="{{ sort_status }}" class="sortable">{{ column_status }}</a>{% endif %}</td>
                  <td class="text-left">{% if sort == 'date_added' %}<a href="{{ sort_date_added }}" class="{{ order|lower }} sortable">{{ column_date_added }}</a>{% else %}<a href="{{ sort_date_added }}" class="sortable">{{ column_date_added }}</a>{% endif %}</td>
                  <td class="text-right">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if modifications %}
                {% for modification in modifications %}
                <tr>
                  <td class="text-center">{% if modification.modification_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ modification.modification_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ modification.modification_id }}" />
                    {% endif %}</td>
                  <td class="text-left">{{ modification.name|e('html') }}</td>
                  <td class="text-left">{{ modification.code|e('html') }}</td>
                  <td class="text-left">{{ modification.author|e('html') }}</td>
                  <td class="text-left">{{ modification.version|e('html') }}</td>
                  <td class="text-left">{{ modification.status|e('html') }}</td>
                  <td class="text-left">{{ modification.date_added|e('html') }}</td>
                  <td class="text-right"><a href="{{ modification.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a> <a href="{{ modification.download }}" data-toggle="tooltip" title="{{ button_download }}" class="btn btn-info btn--icon"><i data-lucide="download" width="14" height="14"></i></a> <a href="{{ modification.test }}" data-toggle="tooltip" title="{{ button_test }}" class="btn btn-warning btn--icon"><i data-lucide="flask-conical" width="14" height="14"></i></a> {% if not modification.enabled %}
                    <a href="{{ modification.enable }}" data-toggle="tooltip" title="{{ button_enable }}" class="btn btn-success btn--icon"><i data-lucide="circle-plus" width="14" height="14"></i></a>
                    {% else %}
                    <a href="{{ modification.disable }}" data-toggle="tooltip" title="{{ button_disable }}" class="btn btn-danger btn--icon"><i data-lucide="circle-minus" width="14" height="14"></i></a>
                    {% endif %}</td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="8">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="pagination-wrap">
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
      </div>
      <div class="tab-pane" id="tab-log">
        <p>
          <textarea wrap="off" rows="15" class="form-control">{{ log }}</textarea>
        </p>
        <div class="text-center"><a href="{{ clear_log }}" class="btn btn-danger btn--icon"><i data-lucide="eraser" width="14" height="14"></i> {{ button_clear }}</a></div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
