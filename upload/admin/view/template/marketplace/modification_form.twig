{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-modification" formaction="{{ test_action|e('html_attr') }}" data-toggle="tooltip" title="{{ button_test }}" class="btn btn-warning btn--icon"><i data-lucide="flask-conical" width="16" height="16"></i></button>
            <button type="submit" form="form-modification" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if name %}
                {{ name }}
              {% else %}
                {{ text_form }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-modification">
    <input type="hidden" name="user_token" value="{{ user_token }}" />
    {% if modification_id %}<input type="hidden" name="modification_id" value="{{ modification_id }}" />{% endif %}
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_details_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-name">{{ entry_name }}</label>
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-code">{{ entry_code }}</label>
                  <input type="text" name="code" value="{{ code }}" placeholder="{{ entry_code }}" id="input-code" class="form-control" />
                  {% if error_code %}
                  <div class="text-danger">{{ error_code }}</div>
                  {% endif %}
                  <span class="help-block">{{ help_code }}</span>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-author">{{ entry_author }}</label>
                  <input type="text" name="author" value="{{ author }}" placeholder="{{ entry_author }}" id="input-author" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-version">{{ entry_version }}</label>
                  <input type="text" name="version" value="{{ version }}" placeholder="{{ entry_version }}" id="input-version" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-link">{{ entry_link }}</label>
                  <input type="text" name="link" value="{{ link }}" placeholder="{{ entry_link }}" id="input-link" class="form-control" />
                </div>
              </div>
            </div>
          </div>
          <div class="dcx-panel" style="margin-top: 16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="code" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_xml }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-xml">{{ entry_xml }}</label>
                  <textarea name="xml" rows="25" placeholder="{{ entry_xml }}" id="input-xml" class="form-control" style="font-family: monospace;">{{ xml }}</textarea>
                  {% if error_xml %}
                  <div class="text-danger">{{ error_xml }}</div>
                  {% endif %}
                  <span class="help-block">{{ help_xml }}</span>
                </div>
              </div>
            </div>
          </div>
          {% if test_results %}
          <div class="dcx-panel" style="margin-top: 16px;" id="panel-test-results">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="flask-conical" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_test }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              {% if test_results.status == 'success' %}
              <div class="alert alert-success"><i data-lucide="check-circle" width="16" height="16"></i> {{ text_test_success }}</div>
              {% elseif test_results.status == 'warning' %}
              <div class="alert alert-warning"><i data-lucide="alert-triangle" width="16" height="16"></i> {{ text_test_warning }}</div>
              {% else %}
              <div class="alert alert-danger"><i data-lucide="x-circle" width="16" height="16"></i> {{ text_test_error }}</div>
              {% endif %}

              {% if test_results.messages %}
              <div style="background: var(--dc-bg-subtle, #f8f9fa); border: 1px solid var(--dc-border, #dee2e6); border-radius: 6px; padding: 12px; font-family: monospace; font-size: 12px; max-height: 400px; overflow-y: auto;">
                {% for msg in test_results.messages %}
                <div class="test-msg-{{ msg.type }}">{{ msg.text|e('html') }}</div>
                {% endfor %}
              </div>
              {% endif %}

              {% if test_results.files %}
              <table class="table table-hover" style="margin-top: 16px;">
                <thead>
                  <tr>
                    <td>{{ column_file }}</td>
                    <td>{{ column_status }}</td>
                    <td>{{ column_operations }}</td>
                  </tr>
                </thead>
                <tbody>
                {% for file in test_results.files %}
                  <tr>
                    <td style="font-family: monospace; font-size: 12px;">{{ file.key|e('html') }}</td>
                    <td>
                      {% if file.modified %}
                      <span class="label label-success">{{ text_modified }}</span>
                      {% else %}
                      <span class="label label-default">{{ text_unmodified }}</span>
                      {% endif %}
                    </td>
                    <td>
                      {% for op in file.operations %}
                      <div style="font-family: monospace; font-size: 11px; margin-bottom: 4px;">
                        {% if op.status == 'ok' %}
                        <span class="label label-success">{{ text_ok }}</span>
                        {% elseif op.status == 'skip' %}
                        <span class="label label-warning">{{ text_skipped }}</span>
                        {% elseif op.status == 'break' %}
                        <span class="label label-warning">{{ text_break }}</span>
                        {% elseif op.status == 'abort' %}
                        <span class="label label-danger">{{ text_abort }}</span>
                        {% elseif op.status == 'error' %}
                        <span class="label label-danger">{{ text_error }}</span>
                        {% endif %}
                        <span class="text-muted">&nbsp;{{ op.search|default('')|e('html') }}</span>
                        {% if op.text %}<br/><span class="text-danger">{{ op.text|e('html') }}</span>{% endif %}
                      </div>
                      {% endfor %}
                    </td>
                  </tr>
                {% endfor %}
                </tbody>
              </table>
              {% endif %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="toggle-right" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_status_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
{% if test_results %}
$(document).ready(function() {
  $('html, body').animate({ scrollTop: $('#panel-test-results').offset().top - 50 }, 300);
});
{% endif %}
//--></script>
{{ footer }}