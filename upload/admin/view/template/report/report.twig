{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="dcx-shell">
      <div class="dcx-panel">
        <div class="dcx-panel-head">
          <div class="dcx-panel-head__icon"><i data-lucide="chart-no-axes-column" width="16" height="16"></i></div>
          <div>
            <h3 class="dcx-panel-title">{{ text_type }}</h3>
            <div class="dcx-panel-head__subtitle">{{ text_report_subtitle }}</div>
          </div>
        </div>
        <div class="dcx-panel-body">
          <ul class="dcx-pills dcx-pills--reports">
            {% for report in reports %}
            <li{% if code == report.code %} class="active"{% endif %}><a href="{{ report.href }}"><i data-lucide="{{ report.icon }}" width="14" height="14"></i>{{ report.text }}</a></li>
            {% endfor %}
          </ul>
          <div>{{ report }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
