{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <h1 class="page-header__title">{{ heading_title }}</h1>
          <div class="pull-right">
            <a href="{{ cancel|default('') }}" class="btn btn-default" style="display:none;"><i data-lucide="reply" width="16" height="16"></i> {{ button_cancel|default('') }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default" style="margin:20px 0;">
      <div class="panel-heading">
        <h3 class="panel-title"><i data-lucide="info" width="16" height="16"></i> {{ text_scheduler_status }}</h3>
      </div>
      <div class="panel-body">
        <p class="text-muted"><i data-lucide="clock" width="16" height="16"></i> {{ text_scheduler_running }}</p>
      </div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>{{ column_name }}</th>
              <th>{{ column_key }}</th>
              <th>{{ column_schedule }}</th>
              <th>{{ column_last_run }}</th>
              <th>{{ column_status }}</th>
            </tr>
          </thead>
          <tbody>
            {% if tasks is not empty %}
            {% for task in tasks %}
            <tr>
              <td>
                {{ task.task_name }}
                {% if task.is_system == 0 %}
                <span data-toggle="tooltip" title="{{ help_edit_name }}"><a href="javascript:void(0);" class="scheduler-edit-name" data-task_id="{{ task.task_id }}" data-task_name="{{ task.task_name }}" data-translations="{{ task.translations|json_encode }}"><i data-lucide="pencil" width="14" height="14" class="text-muted"></i></a></span>
                {% endif %}
              </td>
              <td><span class="label label-info">{{ task.task_type }}</span></td>
              <td>
                <select class="form-control scheduler-schedule-select" data-task_id="{{ task.task_id }}" style="width:auto;display:inline-block;">
                  <option value="" {% if task.cron_schedule == '' %}selected{% endif %}>{{ text_cron_disabled }}</option>
                  <option value="every_15m" {% if task.cron_schedule == 'every_15m' %}selected{% endif %}>{{ text_every_15m }}</option>
                  <option value="every_30m" {% if task.cron_schedule == 'every_30m' %}selected{% endif %}>{{ text_every_30m }}</option>
                  <option value="hourly" {% if task.cron_schedule == 'hourly' %}selected{% endif %}>{{ text_hourly }}</option>
                  <option value="every_6h" {% if task.cron_schedule == 'every_6h' %}selected{% endif %}>{{ text_every_6h }}</option>
                  <option value="every_12h" {% if task.cron_schedule == 'every_12h' %}selected{% endif %}>{{ text_every_12h }}</option>
                  <option value="daily" {% if task.cron_schedule == 'daily' %}selected{% endif %}>{{ text_daily }}</option>
                  <option value="weekly" {% if task.cron_schedule == 'weekly' %}selected{% endif %}>{{ text_every_week }}</option>
                  <option value="monthly" {% if task.cron_schedule == 'monthly' %}selected{% endif %}>{{ text_every_month }}</option>
                </select>
              </td>
              <td>{{ task.last_run ? task.last_run : text_never }}</td>
              <td>
                <select class="form-control toggle-scheduler-task" data-task_id="{{ task.task_id }}" style="width:auto;display:inline-block;">
                  <option value="1" {% if task.cron_enabled %}selected{% endif %}>{{ text_enabled }}</option>
                  <option value="0" {% if not task.cron_enabled %}selected{% endif %}>{{ text_disabled }}</option>
                </select>
              </td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td colspan="5" class="text-center">{{ text_no_tasks }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
<div id="scheduler-edit-name-modal" class="modal fade" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">{{ text_edit_name }}</h4>
      </div>
      <div class="modal-body">
        <input type="hidden" id="scheduler-edit-task-id" value="0">
        {% for language in languages %}
        <div class="form-group">
          <label class="control-label" for="scheduler-name-{{ language.language_id }}">{{ language.name }}</label>
          <input type="text" class="form-control scheduler-name-input" id="scheduler-name-{{ language.language_id }}" data-language_id="{{ language.language_id }}" value="">
        </div>
        {% endfor %}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
        <button type="button" class="btn btn-primary" id="scheduler-save-name">{{ button_save }}</button>
      </div>
    </div>
  </div>
</div>
<script>
$('.scheduler-edit-name').on('click', function() {
	var $link = $(this);

	$('#scheduler-edit-task-id').val($link.data('task_id'));

	$('.scheduler-name-input').each(function() {
		var $input = $(this);
		var translations = $link.data('translations') || {};

		$input.val(translations[$input.data('language_id')] || $link.data('task_name') || '');
	});

	$('#scheduler-edit-name-modal').modal('show');
});

$('#scheduler-save-name').on('click', function() {
	var taskId = $('#scheduler-edit-task-id').val();
	var translations = {};

	$('.scheduler-name-input').each(function() {
		translations[$(this).data('language_id')] = $(this).val();
	});

	$.ajax({
		url: 'index.php?route=tool/dockercart_scheduler/updateName&user_token={{ user_token }}',
		type: 'POST',
		dataType: 'json',
		data: {
			task_id: taskId,
			translations: translations
		},
		success: function(json) {
			if (json.success) {
				location.reload();
			} else {
				alert(json.error || 'Update failed');
			}
		},
		error: function() {
			alert('Request failed');
		}
	});
});

$('.toggle-scheduler-task').on('change', function() {
	var $select = $(this);
	$.ajax({
		url: 'index.php?route=tool/dockercart_scheduler/toggleTask&user_token={{ user_token }}',
		type: 'POST',
		dataType: 'json',
		data: {
			task_id: $select.data('task_id'),
			enabled: $select.val()
		},
		success: function(json) {
			if (json.success) {
				location.reload();
			} else {
				alert(json.error || 'Toggle failed');
			}
		},
		error: function() {
			alert('Request failed');
		}
	});
});

$('.scheduler-schedule-select').on('change', function() {
	var $select = $(this);
	$.ajax({
		url: 'index.php?route=tool/dockercart_scheduler/updateSchedule&user_token={{ user_token }}',
		type: 'POST',
		dataType: 'json',
		data: {
			task_id: $select.data('task_id'),
			schedule: $select.val()
		},
		success: function(json) {
			if (json.success) {
				location.reload();
			} else {
				alert(json.error || 'Update failed');
			}
		},
		error: function() {
			alert('Request failed');
		}
	});
});
</script>
{{ footer }}
