{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
          <div class="pull-right">
            <a href="{{ download }}" class="btn btn-primary"><i data-lucide="download" width="16" height="16"></i> {{ button_download }}</a>
            <a onclick="confirm('{{ text_confirm }}') ? location.href='{{ clear }}' : false;" class="btn btn-danger"><i data-lucide="eraser" width="16" height="16"></i> {{ button_clear }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="triangle-alert" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_list }}</div>
                <div class="dcx-panel-subtitle">{{ text_list_subtitle }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <textarea wrap="off" rows="15" readonly class="form-control">{{ log }}</textarea>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
