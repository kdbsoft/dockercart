{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <a href="{{ log }}" class="btn btn-default"><i data-lucide="scroll-text" width="16" height="16"></i> {{ button_log }}</a>
            <a href="{{ api_keys }}" class="btn btn-default"><i data-lucide="key-round" width="16" height="16"></i> {{ button_keys }}</a>
            <a href="{{ docs }}" class="btn btn-default"><i data-lucide="file-code" width="16" height="16"></i> {{ text_docs }}</a>
            {% if can_edit %}<a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>{% endif %}
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if not kill_switch_on %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-warning"><i data-lucide="pause-circle" width="16" height="16"></i> {{ text_kill_switch_off }}</div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
        <div class="dcx-shell">

          <div class="dcx-context-bar">
            <div class="dcx-context-bar__icon"><i data-lucide="webhook" width="20" height="20"></i></div>
            <div class="dcx-context-bar__meta">
              <div class="dcx-context-bar__title">{{ text_subscriptions }}</div>
              <div class="dcx-context-bar__subtitle">
                <span class="dcx-context-bar__meta-item"><i data-lucide="link" width="12" height="12"></i> <code>{{ api_base_url }}/webhooks</code></span>
                <span class="dcx-context-bar__meta-item"><i data-lucide="list" width="12" height="12"></i> {{ text_total }}: {{ total }}</span>
              </div>
            </div>
          </div>

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="filter" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_filter }}</div>
                <div class="dcx-panel-subtitle">{{ text_filter_help }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ filter }}" method="get" id="form-webhook-filter">
                <input type="hidden" name="route" value="setting/webhook" />
                <input type="hidden" name="user_token" value="{{ user_token }}" />
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field" style="flex:1 1 200px;">
                    <label class="dcx-label" for="input-filter-name">{{ column_name }}</label>
                    <input type="text" name="filter_name" value="{{ filter_name }}" id="input-filter-name" class="form-control" />
                  </div>
                  <div class="dcx-field" style="flex:1 1 240px;">
                    <label class="dcx-label" for="input-filter-url">{{ column_url }}</label>
                    <input type="text" name="filter_url" value="{{ filter_url }}" id="input-filter-url" class="form-control" />
                  </div>
                  <div class="dcx-field" style="flex:1 1 200px;">
                    <label class="dcx-label" for="input-filter-event">{{ entry_event }}</label>
                    <input type="text" name="filter_event" value="{{ filter_event }}" id="input-filter-event" class="form-control" placeholder="order.created" />
                  </div>
                  <div class="dcx-field" style="flex:0 0 160px;">
                    <label class="dcx-label" for="input-filter-status">{{ entry_status }}</label>
                    <select name="filter_status" id="input-filter-status" class="form-control">
                      <option value="">{{ text_all }}</option>
                      <option value="1" {% if filter_status == 1 %}selected{% endif %}>{{ text_enabled }}</option>
                      <option value="0" {% if filter_status is same as(0) %}selected{% endif %}>{{ text_disabled }}</option>
                    </select>
                  </div>
                  <div class="dcx-field" style="flex:0 0 auto;align-self:flex-end;">
                    <button type="submit" class="btn btn-primary"><i data-lucide="search" width="16" height="16"></i> {{ button_filter }}</button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="webhook" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_subscriptions }}</div>
                <div class="dcx-panel-subtitle">{{ text_subscriptions_help }}</div>
              </div>
              {% if can_edit %}
              <div class="dcx-panel-head__actions">
                <a href="{{ add }}" class="btn btn-primary btn-sm"><i data-lucide="plus" width="14" height="14"></i> {{ button_add }}</a>
              </div>
              {% endif %}
            </div>
            <div class="dcx-panel-body">
              {% if subscriptions is not empty %}
              <div class="table-responsive">
                <table class="table table-bordered table-hover dcx-table">
                  <thead>
                    <tr>
                      <th>{{ column_name }}</th>
                      <th>{{ column_url }}</th>
                      <th>{{ column_events }}</th>
                      <th>{{ column_status }}</th>
                      <th class="text-right">{{ column_deliveries }}</th>
                      <th>{{ column_last_success }}</th>
                      {% if can_edit %}<th class="text-right">{{ column_action }}</th>{% endif %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for subscription in subscriptions %}
                    <tr>
                      <td>
                        <strong>{{ subscription.name|e }}</strong>
                        {% if subscription.failures %}
                        <div class="small text-danger">
                          <i data-lucide="triangle-alert" width="12" height="12"></i> {{ text_consecutive_failures }}: {{ subscription.failures }}
                        </div>
                        {% endif %}
                      </td>
                      <td><code class="small">{{ subscription.url }}</code></td>
                      <td><span class="small">{{ subscription.events }}</span></td>
                      <td>
                        {% if subscription.status %}
                        <span class="label label-success">{{ subscription.status_text }}</span>
                        {% else %}
                        <span class="label label-default">{{ subscription.status_text }}</span>
                        {% if subscription.disabled_text %}
                        <div class="small text-danger">{{ text_disabled_reason }}: {{ subscription.disabled_text }}</div>
                        {% endif %}
                        {% endif %}
                      </td>
                      <td class="text-right">
                        <span data-toggle="tooltip" title="{{ text_deliveries }}">{{ subscription.pending }} / {{ subscription.failed }}</span>
                      </td>
                      <td class="small">
                        {% if subscription.last_success_at %}{{ subscription.last_success_at }}{% else %}<span class="text-muted">{{ text_never }}</span>{% endif %}
                        {% if subscription.last_failure_at %}<div class="text-danger small">{{ text_last_failure }}: {{ subscription.last_failure_at }}</div>{% endif %}
                      </td>
                      {% if can_edit %}
                      <td class="text-right">
                        <div class="btn-group">
                          <a href="{{ subscription.edit }}" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{ button_edit }}"><i data-lucide="pencil" width="14" height="14"></i></a>
                          <a href="{{ subscription.test }}" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{ button_test }}"><i data-lucide="send" width="14" height="14"></i></a>
                          <a href="{{ subscription.log }}" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{ button_log }}"><i data-lucide="scroll-text" width="14" height="14"></i></a>
                          {% if subscription.status %}
                          <a href="{{ subscription.disable }}" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{ button_disable }}"><i data-lucide="pause" width="14" height="14"></i></a>
                          {% else %}
                          <a href="{{ subscription.enable }}" class="btn btn-default btn-sm" data-toggle="tooltip" title="{{ button_enable }}"><i data-lucide="play" width="14" height="14"></i></a>
                          {% endif %}
                          <a href="{{ subscription.delete }}" class="btn btn-danger btn-sm" data-confirm="{{ text_delete_confirm }}" data-toggle="tooltip" title="{{ button_delete }}"><i data-lucide="trash-2" width="14" height="14"></i></a>
                        </div>
                      </td>
                      {% endif %}
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <div class="row">
                <div class="col-sm-6 text-left">{{ pagination }}</div>
                <div class="col-sm-6 text-right">{{ results }}</div>
              </div>
              {% else %}
              {% include 'common/empty_state.twig' with {
                icon: 'webhook',
                standalone: true,
                title: text_no_subscriptions,
                description: text_no_subscriptions_help,
                action_url: can_edit ? add : '',
                action_text: can_edit ? button_add : ''
              } %}
              {% endif %}
            </div>
          </div>

          {% if can_edit %}
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_settings }}</div>
                <div class="dcx-panel-subtitle">{{ text_settings_help }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <form action="{{ settings_action }}" method="post" id="form-webhook-settings">
                <div class="dcx-fields">
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 100%;min-width:0;">
                      <label class="dcx-label" for="input-webhook-status">{{ entry_webhook_status }}</label>
                      <select name="config_webhook_status" id="input-webhook-status" class="form-control">
                        <option value="1" {% if config_webhook_status %}selected{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not config_webhook_status %}selected{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 200px;">
                      <label class="dcx-label" for="input-webhook-timeout">{{ entry_webhook_timeout }}</label>
                      <input type="number" min="1" max="60" name="config_webhook_timeout" value="{{ config_webhook_timeout }}" id="input-webhook-timeout" class="form-control" />
                      <div class="dcx-field-help">{{ text_timeout_help }}</div>
                    </div>
                    <div class="dcx-field" style="flex:1 1 200px;">
                      <label class="dcx-label" for="input-webhook-attempts">{{ entry_webhook_max_attempts }}</label>
                      <input type="number" min="1" max="20" name="config_webhook_max_attempts" value="{{ config_webhook_max_attempts }}" id="input-webhook-attempts" class="form-control" />
                      <div class="dcx-field-help">{{ text_max_attempts_help }}</div>
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 200px;">
                      <label class="dcx-label" for="input-webhook-disable">{{ entry_webhook_disable_after }}</label>
                      <input type="number" min="1" max="100" name="config_webhook_disable_after" value="{{ config_webhook_disable_after }}" id="input-webhook-disable" class="form-control" />
                      <div class="dcx-field-help">{{ text_disable_after_help }}</div>
                    </div>
                    <div class="dcx-field" style="flex:1 1 200px;">
                      <label class="dcx-label" for="input-webhook-retention">{{ entry_webhook_retention }}</label>
                      <input type="number" min="0" name="config_webhook_log_retention_days" value="{{ config_webhook_log_retention_days }}" id="input-webhook-retention" class="form-control" />
                      <div class="dcx-field-help">{{ text_retention_help }}</div>
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:0 0 auto;">
                      <button type="submit" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_settings }}</button>
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>
          {% endif %}

          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="book-open" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_events }}</div>
                <div class="dcx-panel-subtitle">{{ text_events_help }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="table-responsive">
                <table class="table table-condensed dcx-table">
                  <thead>
                    <tr>
                      <th>{{ entry_event }}</th>
                      <th>{{ text_payload }}</th>
                      <th>{{ column_status }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for event in events %}
                    <tr>
                      <td><code>{{ event.type }}</code></td>
                      <td class="small text-muted">{{ event.description }}</td>
                      <td>
                        {% if event.implemented %}
                        <span class="label label-success">{{ text_implemented }}</span>
                        {% else %}
                        <span class="label label-default">{{ text_planned }}</span>
                        {% endif %}
                      </td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <div class="dcx-field-help">{{ text_wildcard_help }}</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
document.querySelectorAll('[data-confirm]').forEach(function (element) {
	element.addEventListener('click', function (event) {
		if (!confirm(element.getAttribute('data-confirm'))) {
			event.preventDefault();
		}
	});
});
//--></script>
{{ footer }}
