{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            {% if rotate %}<a href="{{ rotate }}" class="btn btn-default" data-confirm="{{ text_rotate_confirm }}"><i data-lucide="refresh-cw" width="16" height="16"></i> {{ button_rotate }}</a>{% endif %}
            <button type="submit" form="form-api-key" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ text_form }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    {% if new_token %}
    <div class="row">
      <div class="col-sm-12 col-lg-12 col-xl-offset-1 col-xl-10">
        <div class="alert alert-warning">
          <h4><i data-lucide="key-round" width="16" height="16"></i> {{ text_token_once }}</h4>
          <p>{{ text_token_help }}</p>
          <div class="input-group" style="max-width: 720px;">
            <input type="text" id="input-new-token" class="form-control" value="{{ new_token }}" readonly="readonly" spellcheck="false" onclick="this.select();" />
            <span class="input-group-btn">
              <button type="button" class="btn btn-default" id="button-copy-token"><i data-lucide="copy" width="14" height="14"></i> {{ button_copy }}</button>
            </span>
          </div>
          <p class="text-muted" style="margin-top:10px;">
            <code>curl -H "Authorization: Bearer {{ new_token }}" {{ api_base_url }}/products</code>
          </p>
        </div>
      </div>
    </div>
    {% endif %}

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-api-key">
    <div class="row">
        <div class="col-md-12 col-sm-12 col-lg-8 col-xl-offset-1 col-xl-7">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="key-round" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_key }}</div>
                  <div class="dcx-panel-subtitle">{{ text_key_help }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <div class="dcx-fields">
                  <div class="dcx-field required">
                    <label class="dcx-label" for="input-name">{{ entry_name }}</label>
                    <input type="text" name="name" value="{{ name }}" id="input-name" class="form-control" maxlength="128" placeholder="{{ entry_name }}" />
                    {% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-comment">{{ entry_comment }}</label>
                    <textarea name="comment" rows="2" id="input-comment" class="form-control" placeholder="{{ entry_comment }}">{{ comment }}</textarea>
                    <div class="dcx-field-help">{{ help_comment }}</div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 280px;">
                      <label class="dcx-label" for="input-owner">{{ entry_owner }}</label>
                      <select name="user_id" id="input-owner" class="form-control">
                        <option value="0">{{ text_shared_key }}</option>
                        {% for user in users %}
                        <option value="{{ user.user_id }}" data-group="{{ user.user_group_id }}" {% if user.user_id == user_id %}selected{% endif %}>{{ user.username }}{% if user.full_name %} — {{ user.full_name }}{% endif %}</option>
                        {% endfor %}
                      </select>
                      <div class="dcx-field-help">{{ help_owner }}</div>
                    </div>
                    <div class="dcx-field" style="flex:1 1 280px;">
                      <label class="dcx-label" for="input-group">{{ entry_group }}</label>
                      <select name="user_group_id" id="input-group" class="form-control">
                        {% for group in groups %}
                        <option value="{{ group.user_group_id }}" {% if group.user_group_id == user_group_id %}selected{% endif %}>{{ group.name }}</option>
                        {% endfor %}
                      </select>
                      <div class="dcx-field-help" id="group-hint">{{ help_group }}</div>
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 220px;">
                      <label class="dcx-label" for="input-status">{{ entry_status }}</label>
                      <select name="status" id="input-status" class="form-control">
                        <option value="1" {% if status %}selected{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not status %}selected{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </div>
                    <div class="dcx-field" style="flex:1 1 220px;">
                      <label class="dcx-label" for="input-expires">{{ entry_expires }}</label>
                      <input type="date" name="expires_at" value="{{ expires_at }}" id="input-expires" class="form-control" />
                      <div class="btn-group btn-group-sm" style="margin-top:6px;" id="expires-presets">
                        <button type="button" class="btn btn-default" data-days="7">7 {{ text_days }}</button>
                        <button type="button" class="btn btn-default" data-days="30">30 {{ text_days }}</button>
                        <button type="button" class="btn btn-default" data-days="90">90 {{ text_days }}</button>
                        <button type="button" class="btn btn-default" data-days="365">365 {{ text_days }}</button>
                        <button type="button" class="btn btn-default" data-days="0">{{ text_never }}</button>
                      </div>
                      <div class="dcx-field-help">{{ help_expires }}</div>
                    </div>
                  </div>
                  <div class="dcx-fields dcx-fields--row">
                    <div class="dcx-field" style="flex:1 1 220px;">
                      <label class="dcx-label" for="input-rate-limit">{{ entry_rate_limit }}</label>
                      <input type="number" min="0" name="rate_limit" value="{{ rate_limit }}" id="input-rate-limit" class="form-control" />
                      <div class="dcx-field-help">{{ help_rate_limit }} {{ default_rate_limit }}/{{ text_minute }}</div>
                    </div>
                    <div class="dcx-field" style="flex:1 1 320px;">
                      <label class="dcx-label" for="input-ip-allowlist">{{ entry_ip_allowlist }}</label>
                      <textarea name="ip_allowlist" rows="3" id="input-ip-allowlist" class="form-control" spellcheck="false" placeholder="203.0.113.10&#10;2001:db8::/32">{{ ip_allowlist }}</textarea>
                      <div class="dcx-field-help">{{ help_ip_allowlist }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
          <div class="dcx-shell">
            <div class="dcx-sidebar-card">
              <div class="dcx-sidebar-card__header">
                <div class="dcx-sidebar-card__header-icon"><i data-lucide="info" width="16" height="16"></i></div>
                <h3 class="dcx-sidebar-card__title">{{ text_info }}</h3>
              </div>
              <div class="dcx-sidebar-card__body">
                <dl class="dl-horizontal" style="margin-bottom:0;">
                  <dt>{{ text_prefix }}</dt><dd>{% if prefix %}<code>{{ prefix }}…</code>{% else %}<span class="text-muted">—</span>{% endif %}</dd>
                  <dt>{{ text_created }}</dt><dd>{{ date_added ? date_added : '—' }}</dd>
                  <dt>{{ text_last_used }}</dt><dd>{{ last_used_at ? last_used_at : text_never }}{% if last_used_ip %} <span class="text-muted">({{ last_used_ip }})</span>{% endif %}</dd>
                  <dt>{{ text_base_url }}</dt><dd><code>{{ api_base_url }}</code></dd>
                </dl>
              </div>
            </div>
            <div class="dcx-sidebar-card">
              <div class="dcx-sidebar-card__header">
                <div class="dcx-sidebar-card__header-icon"><i data-lucide="shield-check" width="16" height="16"></i></div>
                <h3 class="dcx-sidebar-card__title">{{ text_permissions }}</h3>
              </div>
              <div class="dcx-sidebar-card__body">
                <div class="dcx-sidebar-card__help">{{ text_permissions_help }}</div>
                <div class="dcx-sidebar-card__links">
                  <a class="dcx-sidebar-card__link-item" href="{{ docs }}" target="_blank" rel="noopener"><i data-lucide="file-code" width="14" height="14"></i> {{ button_docs }}</a>
                  {% if log %}<a class="dcx-sidebar-card__link-item" href="{{ log }}"><i data-lucide="scroll-text" width="14" height="14"></i> {{ button_log }}</a>{% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div><script type="text/javascript"><!--
(function () {
	var groups = {{ groups|json_encode|raw }};
	var select = document.getElementById('input-group');
	var owner = document.getElementById('input-owner');
	var hint = document.getElementById('group-hint');

	function updateHint() {
		var id = parseInt(select.value, 10);

		for (var i = 0; i < groups.length; i++) {
			if (groups[i].user_group_id === id) {
				if (groups[i].is_superuser) {
					hint.textContent = '{{ text_group_superuser|escape('js') }}';
				} else {
					hint.textContent = '{{ text_group_counts|escape('js') }}'.replace('%s', groups[i].access_count).replace('%s', groups[i].modify_count);
				}

				return;
			}
		}
	}

	// A key owned by a user acts with the group of that user: the group select
	// follows the owner and is locked while an owner is chosen.
	function updateOwner() {
		var option = owner.options[owner.selectedIndex];
		var group_id = option ? option.getAttribute('data-group') : '';

		if (owner.value && group_id) {
			select.value = group_id;
			select.disabled = true;
			hint.textContent = '{{ text_group_from_owner|escape('js') }}';
		} else {
			select.disabled = false;
			updateHint();
		}
	}

	owner.addEventListener('change', updateOwner);
	select.addEventListener('change', updateHint);
	updateOwner();

	var expires = document.getElementById('input-expires');

	document.querySelectorAll('#expires-presets button').forEach(function (button) {
		button.addEventListener('click', function () {
			var days = parseInt(button.getAttribute('data-days'), 10);

			if (days === 0) {
				expires.value = '';

				return;
			}

			var date = new Date();
			date.setDate(date.getDate() + days);

			expires.value = date.toISOString().substring(0, 10);
		});
	});

	var copyButton = document.getElementById('button-copy-token');

	if (copyButton) {
		copyButton.addEventListener('click', function () {
			var input = document.getElementById('input-new-token');
			input.select();
			document.execCommand('copy');
			copyButton.classList.add('btn-success');
		});
	}

	document.querySelectorAll('[data-confirm]').forEach(function (element) {
		element.addEventListener('click', function (event) {
			if (!confirm(element.getAttribute('data-confirm'))) {
				event.preventDefault();
			}
		});
	});
})();
//--></script>
{{ footer }}
