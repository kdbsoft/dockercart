{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-2 col-xl-8">
          <div class="pull-right">
            <button type="submit" id="button-save" form="form-setting" disabled="disabled" class="btn btn-primary dc-btn-disabled"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back"><i data-lucide="arrow-left" width="20" height="20"></i></span>
            <span class="page-header__title">{{ heading_title }}</span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-2 col-xl-8">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
      {% if success %}
      <div class="row">
        <div class="col-sm-12 col-lg-12 col-xl-offset-2 col-xl-8">
          <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-12 col-lg-12 col-xl-offset-2 col-xl-8">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-setting">
          <div class="dcx-shell">
            <div class="dcx-panel">
              <div class="dcx-panel-head">
                <div class="dcx-panel-head__icon"><i data-lucide="settings" width="18" height="18"></i></div>
                <div>
                  <div class="dcx-panel-title">{{ text_configuration }}</div>
                </div>
              </div>
              <div class="dcx-panel-body">
                <ul class="dcx-pills">
                  <li class="active"><a href="#tab-store" data-toggle="tab"><i data-lucide="house" width="14" height="14"></i> {{ tab_store }}</a></li>
                  <li><a href="#tab-seo" data-toggle="tab"><i data-lucide="search" width="14" height="14"></i> {{ tab_seo }}</a></li>
                  <li><a href="#tab-local" data-toggle="tab"><i data-lucide="globe" width="14" height="14"></i> {{ tab_local }}</a></li>
                  <li><a href="#tab-option" data-toggle="tab"><i data-lucide="sliders-vertical" width="14" height="14"></i> {{ tab_option }}</a></li>
                  <li><a href="#tab-image" data-toggle="tab"><i data-lucide="image" width="14" height="14"></i> {{ tab_image }}</a></li>
                  <li><a href="#tab-mail" data-toggle="tab"><i data-lucide="mail" width="14" height="14"></i> {{ tab_mail }}</a></li>
                  <li><a href="#tab-server" data-toggle="tab"><i data-lucide="server" width="14" height="14"></i> {{ tab_server }}</a></li>
                  <li><a href="#tab-invoice" data-toggle="tab"><i data-lucide="receipt" width="14" height="14"></i> {{ tab_invoice }}</a></li>
                </ul>
                <div class="tab-content">
                  <div class="tab-pane active" id="tab-store">
                    <div class="dc-lang-frame">
                    <ul class="nav nav-tabs" id="language">
                      {% for language in languages %}
                      <li><a href="#language-store{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content">
                      {% for language in languages %}
                      <div class="tab-pane" id="language-store{{ language.language_id }}">
                        <div class="dcx-fields">
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                            <input type="text" name="config_name_i18n[{{ language.language_id }}]" value="{{ config_name_i18n[language.language_id] is defined ? config_name_i18n[language.language_id] : '' }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                            {% if error_name[language.language_id] %}
                            <div class="text-danger">{{ error_name[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-owner{{ language.language_id }}">{{ entry_owner }}</label>
                            <input type="text" name="config_owner_i18n[{{ language.language_id }}]" value="{{ config_owner_i18n[language.language_id] is defined ? config_owner_i18n[language.language_id] : '' }}" placeholder="{{ entry_owner }}" id="input-owner{{ language.language_id }}" class="form-control" />
                            {% if error_owner[language.language_id] %}
                            <div class="text-danger">{{ error_owner[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-address{{ language.language_id }}">{{ entry_address }}</label>
                            <textarea name="config_address_i18n[{{ language.language_id }}]" placeholder="{{ entry_address }}" rows="5" id="input-address{{ language.language_id }}" class="form-control">{{ config_address_i18n[language.language_id] is defined ? config_address_i18n[language.language_id] : '' }}</textarea>
                            {% if error_address[language.language_id] %}
                            <div class="text-danger">{{ error_address[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-open{{ language.language_id }}">{{ entry_open }} <span data-toggle="tooltip" title="{{ help_open }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                            <textarea name="config_open_i18n[{{ language.language_id }}]" rows="5" placeholder="{{ entry_open }}" id="input-open{{ language.language_id }}" class="form-control">{{ config_open_i18n[language.language_id] is defined ? config_open_i18n[language.language_id] : '' }}</textarea>
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-comment{{ language.language_id }}">{{ entry_comment }} <span data-toggle="tooltip" title="{{ help_comment }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                            <textarea name="config_comment_i18n[{{ language.language_id }}]" rows="5" placeholder="{{ entry_comment }}" id="input-comment{{ language.language_id }}" class="form-control">{{ config_comment_i18n[language.language_id] is defined ? config_comment_i18n[language.language_id] : '' }}</textarea>
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                    </div>
                    </div>
                    <hr>
                    <div class="dcx-fields">
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-theme">{{ entry_theme }}</label>
                          <select name="config_theme" id="input-theme" class="form-control">
                            {% for theme in themes %}
                            {% if theme.value == config_theme %}
                            <option value="{{ theme.value }}" selected="selected">{{ theme.text }}</option>
                            {% else %}
                            <option value="{{ theme.value }}">{{ theme.text }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-layout">{{ entry_layout }}</label>
                          <select name="config_layout_id" id="input-layout" class="form-control">
                            {% for layout in layouts %}
                            {% if layout.layout_id == config_layout_id %}
                            <option value="{{ layout.layout_id }}" selected="selected">{{ layout.name }}</option>
                            {% else %}
                            <option value="{{ layout.layout_id }}">{{ layout.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="dcx-checkbox-group">
                        <label class="dcx-checkbox-label">
                          <input type="hidden" name="config_contact_form_status" value="0" />
                          <input type="checkbox" name="config_contact_form_status" value="1"{% if config_contact_form_status %} checked="checked"{% endif %}> {{ entry_contact_form_status }}
                          <span data-toggle="tooltip" title="{{ help_contact_form_status }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                        </label>
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label" for="input-geocode">{{ entry_geocode }} <span data-toggle="tooltip" title="{{ help_geocode }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        <input type="text" name="config_geocode" value="{{ config_geocode }}" placeholder="{{ entry_geocode }}" id="input-geocode" class="form-control" />
                      </div>
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field required">
                          <label class="dcx-label" for="input-email">{{ entry_email }}</label>
                          <input type="text" name="config_email" value="{{ config_email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                          {% if error_email %}
                          <div class="text-danger">{{ error_email }}</div>
                          {% endif %}
                        </div>
                        <div class="dcx-field required">
                          <label class="dcx-label" for="input-telephone">{{ entry_telephone }}</label>
                          <input type="text" name="config_telephone" value="{{ config_telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" />
                          {% if error_telephone %}
                          <div class="text-danger">{{ error_telephone }}</div>
                          {% endif %}
                        </div>
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label" for="input-fax">{{ entry_fax }}</label>
                        <input type="text" name="config_fax" value="{{ config_fax }}" placeholder="{{ entry_fax }}" id="input-fax" class="form-control" />
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_images }}</label>
                        <div class="row">
                          {% for i in 0..4 %}
                          <div class="col-sm-2 col-xs-4 text-center" style="margin-bottom: 10px;">
                            <a href="" id="thumb-image-{{ i }}" data-toggle="image" class="img-thumbnail"><img src="{{ config_images_thumb[i] }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                            <input type="hidden" name="config_images[]" value="{{ config_images[i] }}" id="input-image-{{ i }}" />
                            <div class="help-block" style="margin-bottom: 0;">{{ '#' ~ (i + 1) }}</div>
                          </div>
                          {% endfor %}
                        </div>
                        <p class="help-block">{{ help_images }}</p>
                      </div>
                      {% if locations %}
                      <div class="dcx-field">
                        <label class="dcx-label">{{ entry_location }} <span data-toggle="tooltip" title="{{ help_location }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                        {% for location in locations %}
                        <div class="checkbox">
                          <label>
                            {% if location.location_id in config_location %}
                            <input type="checkbox" name="config_location[]" value="{{ location.location_id }}" checked="checked" />
                            {{ location.name }}
                            {% else %}
                            <input type="checkbox" name="config_location[]" value="{{ location.location_id }}" />
                            {{ location.name }}
                            {% endif %}
                          </label>
                        </div>
                        {% endfor %}
                      </div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="tab-pane" id="tab-seo">
                    <div class="dc-lang-frame">
                    <ul class="nav nav-tabs" id="language-seo">
                      {% for language in languages %}
                      <li><a href="#language-seo{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content">
                      {% for language in languages %}
                      <div class="tab-pane" id="language-seo{{ language.language_id }}">
                        <div class="dcx-fields">
                          <div class="dcx-field required">
                            <label class="dcx-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                            <input type="text" name="config_meta_title_i18n[{{ language.language_id }}]" value="{{ config_meta_title_i18n[language.language_id] is defined ? config_meta_title_i18n[language.language_id] : '' }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control" />
                            {% if error_meta_title[language.language_id] %}
                            <div class="text-danger">{{ error_meta_title[language.language_id] }}</div>
                            {% endif %}
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                            <textarea name="config_meta_description_i18n[{{ language.language_id }}]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ config_meta_description_i18n[language.language_id] is defined ? config_meta_description_i18n[language.language_id] : '' }}</textarea>
                          </div>
                          <div class="dcx-field">
                            <label class="dcx-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                            <textarea name="config_meta_keyword_i18n[{{ language.language_id }}]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ config_meta_keyword_i18n[language.language_id] is defined ? config_meta_keyword_i18n[language.language_id] : '' }}</textarea>
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                    </div>
                    </div>
                  </div>
                  <div class="tab-pane" id="tab-local">
                    <div class="dcx-fields">
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-country">{{ entry_country }}</label>
                          <select name="config_country_id" id="input-country" class="form-control">
                            {% for country in countries %}
                            {% if country.country_id == config_country_id %}
                            <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
                            {% else %}
                            <option value="{{ country.country_id }}">{{ country.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-zone">{{ entry_zone }}</label>
                          <select name="config_zone_id" id="input-zone" class="form-control">
                          </select>
                        </div>
                      </div>
                      <div class="dcx-field">
                        <label class="dcx-label" for="input-timezone">{{ entry_timezone }}</label>
                        <select name="config_timezone" id="input-timezone" class="form-control">
                          {% for timezone in timezones %}
                          {% if timezone.value == config_timezone %}
                          <option value="{{ timezone.value }}" selected="selected">{{ timezone.text }}</option>
                          {% else %}
                          <option value="{{ timezone.value }}">{{ timezone.text }}</option>
                          {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-language">{{ entry_language }}</label>
                          <select name="config_language" id="input-language" class="form-control">
                            {% for language in languages %}
                            {% if language.code == config_language %}
                            <option value="{{ language.code }}" selected="selected">{{ language.name }}</option>
                            {% else %}
                            <option value="{{ language.code }}">{{ language.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-admin-language">{{ entry_admin_language }}</label>
                          <select name="config_admin_language" id="input-admin-language" class="form-control">
                            {% for language in languages %}
                            {% if language.code == config_admin_language %}
                            <option value="{{ language.code }}" selected="selected">{{ language.name }}</option>
                            {% else %}
                            <option value="{{ language.code }}">{{ language.name }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-currency">{{ entry_currency }} <span data-toggle="tooltip" title="{{ help_currency }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <select name="config_currency" id="input-currency" class="form-control">
                            {% for currency in currencies %}
                            {% if currency.code == config_currency %}
                            <option value="{{ currency.code }}" selected="selected">{{ currency.title }}</option>
                            {% else %}
                            <option value="{{ currency.code }}">{{ currency.title }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-currency-engine">{{ entry_currency_engine }}</label>
                          <select name="config_currency_engine" id="input-currency-engine" class="form-control">
                            {% if not config_currency_engine %}
                            <option value="" selected>{{ text_none }}</option>
                            {% else %}
                            <option value="">{{ text_none }}</option>
                            {% endif %}
                            {% for currency_engine in currency_engines %}
                            {% if currency_engine.value == config_currency_engine %}
                            <option value="{{ currency_engine.value }}" selected>{{ currency_engine.text }}</option>
                            {% else %}
                            <option value="{{ currency_engine.value }}">{{ currency_engine.text }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="dcx-checkbox-group">
                        <label class="dcx-checkbox-label">
                          <input type="hidden" name="config_currency_auto" value="0" />
                          <input type="checkbox" name="config_currency_auto" value="1"{% if config_currency_auto %} checked="checked"{% endif %}> {{ entry_currency_auto }}
                          <span data-toggle="tooltip" title="{{ help_currency_auto }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                        </label>
                        <label class="dcx-checkbox-label">
                          <input type="hidden" name="config_symbol_left_space" value="0" />
                          <input type="checkbox" name="config_symbol_left_space" value="1"{% if config_symbol_left_space %} checked="checked"{% endif %}> {{ entry_symbol_left_space }}
                          <span data-toggle="tooltip" title="{{ help_symbol_left_space }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                        </label>
                        <label class="dcx-checkbox-label">
                          {% if not config_symbol_right_space %}
                            <input type="hidden" name="config_symbol_right_space" value="1" />
                          {% endif %}
                          <input type="checkbox" name="config_symbol_right_space" value="0"{% if not config_symbol_right_space %} checked="checked"{% endif %}> {{ entry_symbol_right_space }}
                          <span data-toggle="tooltip" title="{{ help_symbol_right_space }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                        </label>
                      </div>
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-length-class">{{ entry_length_class }}</label>
                          <select name="config_length_class_id" id="input-length-class" class="form-control">
                            {% for length_class in length_classes %}
                            {% if length_class.length_class_id == config_length_class_id %}
                            <option value="{{ length_class.length_class_id }}" selected="selected">{{ length_class.title }}</option>
                            {% else %}
                            <option value="{{ length_class.length_class_id }}">{{ length_class.title }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                        <div class="dcx-field">
                          <label class="dcx-label" for="input-weight-class">{{ entry_weight_class }}</label>
                          <select name="config_weight_class_id" id="input-weight-class" class="form-control">
                            {% for weight_class in weight_classes %}
                            {% if weight_class.weight_class_id == config_weight_class_id %}
                            <option value="{{ weight_class.weight_class_id }}" selected="selected">{{ weight_class.title }}</option>
                            {% else %}
                            <option value="{{ weight_class.weight_class_id }}">{{ weight_class.title }}</option>
                            {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="tab-pane" id="tab-option">
                    <div class="dcx-section" style="margin-top:0;padding-top:0;border-top:0;">
                      <div class="dcx-section-header"><h4><i data-lucide="package" width="16" height="16"></i> {{ text_product }}</h4></div>
                      <div class="dcx-fields">
                        <div class="dcx-checkbox-group">
                          <label class="dcx-checkbox-label">
                            <input type="hidden" name="config_product_count" value="0" />
                            <input type="checkbox" name="config_product_count" value="1"{% if config_product_count %} checked="checked"{% endif %}> {{ entry_product_count }}
                            <span data-toggle="tooltip" title="{{ help_product_count }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                          </label>
                        </div>
                        <div class="dcx-field required" style="max-width: 50%;">
                          <label class="dcx-label" for="input-admin-limit">{{ entry_limit_admin }} <span data-toggle="tooltip" title="{{ help_limit_admin }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="config_limit_admin" value="{{ config_limit_admin }}" placeholder="{{ entry_limit_admin }}" id="input-admin-limit" class="form-control" />
                          {% if error_limit_admin %}
                          <div class="text-danger">{{ error_limit_admin }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                    <div class="dcx-section">
                      <div class="dcx-section-header"><h4><i data-lucide="message-square" width="16" height="16"></i> {{ text_review }}</h4></div>
                      <div class="dcx-fields">
                        <div class="dcx-checkbox-group">
                          <label class="dcx-checkbox-label">
                            <input type="hidden" name="config_review_status" value="0" />
                            <input type="checkbox" name="config_review_status" value="1"{% if config_review_status %} checked="checked"{% endif %}> {{ entry_review }}
                            <span data-toggle="tooltip" title="{{ help_review }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                          </label>
                          <label class="dcx-checkbox-label">
                            <input type="hidden" name="config_review_guest" value="0" />
                            <input type="checkbox" name="config_review_guest" value="1"{% if config_review_guest %} checked="checked"{% endif %}> {{ entry_review_guest }}
                            <span data-toggle="tooltip" title="{{ help_review_guest }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                          </label>
                        </div>
                      </div>
                    </div>
                    <div class="dcx-section">
                      <div class="dcx-section-header"><h4><i data-lucide="ticket" width="16" height="16"></i> {{ text_voucher }}</h4></div>
                      <div class="dcx-fields dcx-fields--row">
                        <div class="dcx-field required">
                          <label class="dcx-label" for="input-voucher-min">{{ entry_voucher_min }} <span data-toggle="tooltip" title="{{ help_voucher_min }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span></label>
                          <input type="text" name="config_voucher_min" value="{{ config_voucher_min }}" placeholder="{{ entry_voucher_min }}" id="input-voucher-min" class="form-control" />
                          {% if error_voucher_min %}
                          <div class="text-danger">{{ error_voucher_min }}</div>
