<script type="text/javascript"><!--
var taxNumberRow = {{ tax_number_row }};

function addSellerTaxNumber() {
  var html = '<div class="dc-cgp-row" id="seller-tax-number-row' + taxNumberRow + '">';
  html += '<select name="config_seller_tax_numbers[' + taxNumberRow + '][type]" class="form-control dc-cgp-select">';
  {% for tax_type in seller_tax_types %}
  html += '<option value="{{ tax_type }}">{{ tax_type }}</option>';
  {% endfor %}
  html += '</select>';
  html += '<input type="text" name="config_seller_tax_numbers[' + taxNumberRow + '][value]" value="" placeholder="{{ entry_seller_tax_number_value }}" class="form-control dc-cgp-price"/>';
  html += '<button type="button" onclick="$(\'#seller-tax-number-row' + taxNumberRow + '\').remove();" class="btn btn-link dc-cgp-remove"><i data-lucide="x" width="14" height="14"></i></button>';
  html += '</div>';

  $('#seller-tax-numbers').append(html);
  lucide.createIcons();
  taxNumberRow++;
}

function uploadInvoiceImage(type, input) {
  if (!input.files.length) {
    return;
  }

  var formData = new FormData();
  formData.append('file', input.files[0]);

  $.ajax({
    url: 'index.php?route=setting/invoice_image/upload&user_token={{ user_token }}&name=' + type,
    type: 'post',
    data: formData,
    dataType: 'json',
    cache: false,
    contentType: false,
    processData: false,
    beforeSend: function() {
      $('.alert-dismissible').remove();
    },
    success: function(json) {
      if (json['error']) {
        alert(json['error']);
      }

      if (json['filename']) {
        $('#input-' + type + '-image').val(json['filename']);
        $('#thumb-' + type + '-image img').attr('src', 'index.php?route=setting/invoice_image/image&user_token={{ user_token }}&name=' + type + '&t=' + Date.now());
      }

      input.value = '';
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
}

function removeInvoiceImage(type) {
  if (!confirm('{{ text_confirm }}')) {
    return;
  }

  $.ajax({
    url: 'index.php?route=setting/invoice_image/delete&user_token={{ user_token }}&name=' + type,
    type: 'post',
    dataType: 'json',
    success: function(json) {
      if (json['error']) {
        alert(json['error']);
      }

      if (json['success']) {
        $('#input-' + type + '-image').val('');
        $('#thumb-' + type + '-image img').attr('src', '{{ placeholder }}');
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
}

function toggleOauthFields() {
	if ($('#input-mail-smtp-auth-method').val() === 'oauth') {
		$('#oauth-fields').removeClass('hidden');
	} else {
		$('#oauth-fields').addClass('hidden');
	}
}

$('#input-mail-smtp-auth-method').change(toggleOauthFields).trigger('change');
//--></script>
</div>
