        <div class="dcx-panel">
          <div class="dcx-panel-head">
            <div class="dcx-panel-head__icon"><i data-lucide="triangle-alert" width="18" height="18"></i></div>
            <div>
              <div class="dcx-panel-title">{{ heading_title }}</div>
              <div class="dcx-panel-subtitle">{{ text_not_found_subtitle }}</div>
            </div>
          </div>
          <div class="dcx-panel-body">
            <p class="text-center">{{ text_not_found }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
