  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-12">
        <h1 class="page-header__title">{{ heading_title }}</h1>
      </div>
    </div>
  </div>
</div>
<div class="container-fluid">
  <div class="row">
    <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
