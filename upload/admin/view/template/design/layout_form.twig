  <script type="text/javascript"><!--
function removeModule(elementId) {
  $('#' + elementId).remove();
  updateAllModulePositions();
}

function initializeSortables() {
  var positions = ['column_left', 'content_top', 'content_bottom', 'column_right'];

  positions.forEach(function(position) {
    var element = document.querySelector('.sortable-module-list[data-position="' + position + '"]');
    if (element) {
      Sortable.create(element, {
        group: 'modules',
        animation: 150,
        ghostClass: 'sortable-ghost',
        chosenClass: 'sortable-chosen',
        dragClass: 'sortable-drag',
        handle: '.dc-module-item__handle',
        filter: '.dc-module-column__footer',
        forceFallback: false,
        scroll: true,
        scrollSensitivity: 30,
        scrollSpeed: 30,
        onEnd: function(evt) {
          updateAllModulePositions();
        }
      });
    }
  });
}

function updateAllModulePositions() {
  document.querySelectorAll('.sortable-module-list').forEach(function(list) {
    var position = list.getAttribute('data-position');
    var items = list.querySelectorAll('.dc-module-item');
    var sortOrder = 0;

    items.forEach(function(item) {
      var positionInput = item.querySelector('input[name*="position"]');
      var sortOrderInput = item.querySelector('input[name*="sort_order"]');

      if (positionInput) {
        positionInput.value = position;
      }
      if (sortOrderInput) {
        sortOrderInput.value = sortOrder;
      }
      sortOrder++;
    });
  });
}

$(document).ready(function() {
  var waitForSortable = setInterval(function() {
    if (typeof Sortable !== 'undefined') {
      clearInterval(waitForSortable);
      initializeSortables();
    }
  }, 50);

  setTimeout(function() {
    if (typeof Sortable !== 'undefined') {
      clearInterval(waitForSortable);
      initializeSortables();
    }
  }, 3000);
});

var route_row = {{ route_row }};

function addRoute() {
  var html = '<div class="dc-route-row" id="route-row' + route_row + '">';
  html += '  <div class="dcx-field">';
  html += '    <label class="dcx-label">{{ entry_store }}</label>';
  html += '    <select name="layout_route[' + route_row + '][store_id]" class="form-control">';
  html += '      <option value="0">{{ text_default }}</option>';
  {% for store in stores %}
  html += '      <option value="{{ store.store_id }}">{{ store.name|escape('js') }}</option>';
  {% endfor %}
  html += '    </select>';
  html += '  </div>';
  html += '  <div class="dcx-field">';
  html += '    <label class="dcx-label">{{ entry_route }}</label>';
  html += '    <input type="text" name="layout_route[' + route_row + '][route]" value="" placeholder="{{ entry_route }}" class="form-control" />';
  html += '  </div>';
  html += '  <button type="button" onclick="$(\'#route-row' + route_row + '\').remove();" class="btn btn-link dc-remove-route" title="{{ button_remove }}"><i data-lucide="circle-minus" width="14" height="14"></i></button>';
  html += '</div>';

  $('#routes-container').append(html);
  lucide.createIcons();
  route_row++;
}

var module_row = {{ module_row }};

function decorateModuleSelectLabels(context) {
  var $scope = context ? $(context) : $(document);

  $scope.find('.dc-module-column__list select[name*=\'code\'], .dc-module-column__footer select').each(function() {
    var $select = $(this);

    $select.find('optgroup').each(function() {
      var groupLabel = $(this).attr('label');

      $(this).find('option').each(function() {
        var $option = $(this);
        var original = $option.attr('data-original-label');

        if (!original) {
          original = $option.text().trim();
          $option.attr('data-original-label', original);
        }

        if (groupLabel && original && original.indexOf(groupLabel + ' -> ') !== 0) {
          $option.text(groupLabel + ' -> ' + original);
        }
      });
    });
  });
}

function addModule(type) {
  var html = '<div id="module-row' + module_row + '" class="dc-module-item module-drag-item">';
  html += '  <span class="dc-module-item__handle drag-handle"><i data-lucide="grip-vertical" width="14" height="14"></i></span>';
  html += '  <div class="dc-module-item__body">';
  html += '    <select name="layout_module[' + module_row + '][code]" class="form-control input-sm">';
  {% for extension in extensions %}
  html += '      <optgroup label="{{ extension.name|escape('js') }}">';
  {% if not extension.module %}
  html += '        <option value="{{ extension.code }}">{{ extension.name|escape('js') }}</option>';
  {% else %}
  {% for module in extension.module %}
  html += '        <option value="{{ module.code }}">{{ extension.name|escape('js') }} -> {{ module.name|escape('js') }}</option>';
  {% endfor %}
  {% endif %}
  html += '      </optgroup>';
  {% endfor %}
  html += '    </select>';
  html += '    <input type="hidden" name="layout_module[' + module_row + '][position]" value="' + type.replace('-', '_') + '" />';
  html += '    <input type="hidden" name="layout_module[' + module_row + '][sort_order]" value="" />';
  html += '    <div class="dc-module-item__actions">';
  html += '      <a href="" target="_blank" type="button" title="{{ button_edit }}" class="btn btn-primary btn-sm"><i data-lucide="pencil" width="14" height="14"></i></a>';
  html += '      <button type="button" onclick="removeModule(\'module-row' + module_row + '\');" title="{{ button_remove }}" class="btn btn-danger btn-sm"><i data-lucide="circle-minus" width="14" height="14"></i></button>';
  html += '    </div>';
  html += '  </div>';
  html += '</div>';

  $('#module-' + type + ' .dc-module-column__list').append(html);
  lucide.createIcons();

  $('#module-' + type + ' select[name=\'layout_module[' + module_row + '][code]\']').val($('#module-' + type + ' .dc-module-column__footer select').val());

  $('#module-' + type + ' select[name*=\'code\']').trigger('change');

  decorateModuleSelectLabels($('#module-' + type));

  $('#module-' + type + ' input[name*=\'sort_order\']').each(function(i, element) {
    $(element).val(i);
  });

  if (typeof Sortable !== 'undefined') {
    initializeSortables();
  }

  module_row++;
}

$('.dc-module-column').delegate('select[name*=\'code\']', 'change', function() {
  var part = this.value.split('.');

  if (!part[1]) {
    $(this).closest('.dc-module-item').find('a').attr('href', 'index.php?route=extension/module/' + part[0] + '&user_token={{ user_token }}');
  } else {
    $(this).closest('.dc-module-item').find('a').attr('href', 'index.php?route=extension/module/' + part[0] + '&user_token={{ user_token }}&module_id=' + part[1]);
  }
});

$('.dc-module-column').find('select[name*=\'code\']').trigger('change');
decorateModuleSelectLabels();
//--></script>
</div>
