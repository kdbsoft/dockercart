{{ header }}{{ column_left }}
<link href="view/stylesheet/layout_form.css?v={{ dockercart_version }}" type="text/css" rel="stylesheet" />
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            {% if builder_url %}
            <a href="{{ builder_url }}" class="btn btn-info btn--icon" target="_blank" data-toggle="tooltip" title="{{ text_switch_to_builder }}"><i data-lucide="wand-2" width="16" height="16"></i></a>
            {% endif %}
            <button type="submit" form="form-layout" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary btn--icon"><i data-lucide="save" width="16" height="16"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default btn--icon"><i data-lucide="x" width="16" height="16"></i></a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {{ text_form }}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="alert-circle" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-layout">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ tab_description }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="layout-name-language">
                {% for language in languages %}
                <li {% if loop.first %}class="active"{% endif %}>
                  <a href="#layout-name-{{ language.language_id }}" data-toggle="tab">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}
                  </a>
                </li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane {% if loop.first %}active{% endif %}" id="layout-name-{{ language.language_id }}">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                      <input type="text" name="layout_description[{{ language.language_id }}][name]" value="{{ layout_descriptions[language.language_id].name ?? '' }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                      {% if error_name[language.language_id] is defined %}<div class="text-danger">{{ error_name[language.language_id] }}</div>{% endif %}
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="route" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_routes_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            {% set route_row = 0 %}
            <div id="routes-container">
              {% for layout_route in layout_routes %}
              <div class="dcx-sidebar-card__field dc-route-row" id="route-row{{ route_row }}">
                <div class="dc-route-row__fields">
                  <label class="dcx-sidebar-card__label">{{ entry_store }}</label>
                  <select name="layout_route[{{ route_row }}][store_id]" class="form-control">
                    <option value="0">{{ text_default }}</option>
                    {% for store in stores %}
                    {% if store.store_id == layout_route.store_id %}
                    <option value="{{ store.store_id }}" selected="selected">{{ store.name }}</option>
                    {% else %}
                    <option value="{{ store.store_id }}">{{ store.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                  <label class="dcx-sidebar-card__label">{{ entry_route }}</label>
                  <input type="text" name="layout_route[{{ route_row }}][route]" value="{{ layout_route.route }}" placeholder="{{ entry_route }}" class="form-control" />
                </div>
                <button type="button" onclick="$('#route-row{{ route_row }}').remove();" class="btn btn-link dc-remove-route" title="{{ button_remove }}"><i data-lucide="minus-circle" width="14" height="14"></i></button>
              </div>
              {% set route_row = route_row + 1 %}
              {% endfor %}
            </div>
            <button type="button" onclick="addRoute();" class="btn btn-default btn-sm btn-block"><i data-lucide="plus" width="14" height="14"></i> {{ button_route_add }}</button>
          </div>
        </div>
      </div>
    </div>
