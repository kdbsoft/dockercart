{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">{{ text_form }}</span>
          </a>
          <div class="pull-right">
            <button type="submit" form="form-seo-url" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-seo-url">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="link" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_form }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="dcx-fields">
                <div class="dcx-field required">
                  <label class="dcx-label" for="input-query">{{ entry_query }}</label>
                  <input type="text" name="query" value="{{ query }}" placeholder="{{ entry_query }}" id="input-query" class="form-control" />
                  {% if error_query %}
                  <div class="text-danger">{{ error_query }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-store">{{ entry_store }}</label>
                  <select name="store_id" id="input-store" class="form-control">
                    {% for store in stores %}
                    {% if store.store_id == store_id %}
                    <option value="{{ store.store_id }}" selected="selected">{{ store.name }}</option>
                    {% else %}
                    <option value="{{ store.store_id }}">{{ store.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
                <div class="dcx-field required">
                  <label class="dcx-label">{{ entry_keyword }}</label>
                  {% for language in languages %}
                  <div class="dc-attr-row__value">
                    <span class="lang-code">{{ language.code|split('-')|first|upper }}</span>
                    <input type="text" name="seo_url[{{ store_id }}][{{ language.language_id }}]" value="{% if seo_url[store_id][language.language_id] %}{{ seo_url[store_id][language.language_id] }}{% endif %}" placeholder="{{ entry_keyword }}" class="form-control" />
                  </div>
                  {% if error_keyword[store_id][language.language_id] %}
                  <div class="text-danger">{{ error_keyword[store_id][language.language_id] }}</div>
                  {% endif %}
                  {% endfor %}
                </div>
                <div class="dcx-field">
                  <div class="dcx-seo-preview">
                    <span class="dcx-seo-preview__label">{{ text_seo_preview }}</span>
                    <span class="dcx-seo-preview__url">{{ text_seo_url_base }}</span><span id="seo-url-preview">...</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('input[name^="seo_url"]').on('input', function() {
  var firstVal = $('input[name^="seo_url"]:first').val();
  if (firstVal) {
    $('#seo-url-preview').text(firstVal);
  } else {
    $('#seo-url-preview').text('...');
  }
});
//--></script>
{{ footer }}
