{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ export }}" class="btn btn-default"><i data-lucide="download" width="16" height="16"></i> {{ button_export_csv }}</a>
            <button type="button" class="btn btn-default" onclick="$('#import-modal').modal('show');"><i data-lucide="upload" width="16" height="16"></i> {{ button_import_csv }}</button>
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-url-alias').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {{ user_filter }}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-url-alias">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'query' %}<a href="{{ sort_query }}" class="{{ order|lower }} sortable">{{ column_query }}</a>{% else %}<a href="{{ sort_query }}" class="sortable">{{ column_query }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'store_id' %}<a href="{{ sort_store }}" class="{{ order|lower }} sortable">{{ column_store }}</a>{% else %}<a href="{{ sort_store }}" class="sortable">{{ column_store }}</a>{% endif %}</td>
              <td class="text-left" style="min-width: 240px;">{{ column_keyword }}</td>
            </tr>
          </thead>
          <tbody>
          {% if seo_urls %}
          {% for seo_url in seo_urls %}
          <tr data-href="{{ seo_url.edit }}">
            <td class="text-center">{% if (seo_url.query ~ '|' ~ seo_url.store_id) in selected %}
              <input type="checkbox" name="selected[]" value="{{ seo_url.query }}|{{ seo_url.store_id }}" checked="checked" />
              {% else %}
              <input type="checkbox" name="selected[]" value="{{ seo_url.query }}|{{ seo_url.store_id }}" />
              {% endif %}</td>
            <td class="text-left">{{ seo_url.query }}</td>
            <td class="text-left">{{ seo_url.store }}</td>
            <td class="text-left">
              {% for language in languages %}
              <div class="dc-keyword-row">
                <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> <span class="lang-name">{{ language.name }}</span>
                {% if seo_url.keywords[language.language_id] %}
                <span class="inline-edit" data-query="{{ seo_url.query|e('html_attr') }}" data-store-id="{{ seo_url.store_id }}" data-language-id="{{ language.language_id }}" data-value="{{ seo_url.keywords[language.language_id].keyword|e('html_attr') }}">{{ seo_url.keywords[language.language_id].keyword }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                {% else %}
                <span class="inline-edit dc-keyword-empty" data-query="{{ seo_url.query|e('html_attr') }}" data-store-id="{{ seo_url.store_id }}" data-language-id="{{ language.language_id }}" data-value="">{{ text_none }}<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i></span>
                {% endif %}
              </div>
              {% endfor %}
            </td>
          </tr>
          {% endfor %}
          {% else %}
          <tr>
            <td class="text-center" colspan="4">{{ text_no_results }}</td>
          </tr>
          {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
<style>
.dc-keyword-row { white-space: nowrap; margin-bottom: 3px; }
.dc-keyword-row:last-child { margin-bottom: 0; }
.dc-keyword-row .lang-code {
  display: inline-block; min-width: 26px; font-weight: 700; font-size: 11px;
  color: #7b8ead; margin-right: 6px;
}
.dc-keyword-row .lang-name { margin-right: 6px; }
.dc-keyword-empty { color: #999; font-style: italic; }
.inline-edit { cursor: pointer; }
.inline-edit .inline-edit-icon { margin-left: 4px; color: #a0aec0; }
.inline-edit:hover .inline-edit-icon { color: #2c7be5; }
</style>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = 'index.php?route=design/seo_url&user_token={{ user_token }}';

	var filter_query = $('input[name=\'filter_query\']').val();

	if (filter_query) {
		url += '&filter_query=' + encodeURIComponent(filter_query);
	}

	var filter_keyword = $('input[name=\'filter_keyword\']').val();

	if (filter_keyword) {
		url += '&filter_keyword=' + encodeURIComponent(filter_keyword);
	}

	var filter_store_id = $('select[name=\'filter_store_id\']').val();

	if (filter_store_id) {
		url += '&filter_store_id=' + encodeURIComponent(filter_store_id);
	}

	var filter_language_id = $('select[name=\'filter_language_id\']').val();

	if (filter_language_id) {
		url += '&filter_language_id=' + encodeURIComponent(filter_language_id);
	}

	location = url;
});
//--></script>
<script type="text/javascript"><!--
$('#filter-seo input, #filter-seo select').on('keypress', function(e) {
	if (e.which == 13) {
		$('#button-filter').trigger('click');
	}
});
//--></script>
<script type="text/javascript"><!--
$(document).on('click', '.inline-edit', function(e) {
	if ($(e.target).closest('.inline-edit-icon, input, select').length) return;
	$(this).find('.inline-edit-icon').trigger('click');
});

$(document).on('click', '.inline-edit-icon', function(e) {
	e.stopPropagation();

	var $span = $(this).closest('.inline-edit');
	if ($span.find('input, select').length) return;

	var query = $span.data('query');
	var storeId = $span.data('store-id');
	var languageId = $span.data('language-id');
	var rawValue = $span.data('value') || '';

	$span.addClass('editing');
	$span.data('display', $span.html());

	$span.html('<input type="text" class="form-control input-sm inline-edit-input" value="' + rawValue.replace(/"/g, '&quot;') + '" />');
	var $input = $span.find('input');
	$input.focus().select();

	function revert() {
		$span.removeClass('editing');
		$span.html($span.data('display'));
	}

	function render(value) {
		$span.data('value', value || '');
		$span.removeClass('editing');
		if (value) {
			$span.removeClass('dc-keyword-empty');
			$span.html($('<span>').text(value).html() + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
		} else {
			$span.addClass('dc-keyword-empty');
			$span.html('<span class="text-muted">{{ text_none|e("js") }}</span><i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
		}
		lucide.createIcons({ nodes: [$span[0]] });
	}

	function save() {
		var newValue = $input.val();

		$.ajax({
			url: 'index.php?route=design/seo_url/updateKeyword&user_token={{ user_token }}',
			type: 'post',
			dataType: 'json',
			data: { query: query, store_id: storeId, language_id: languageId, value: newValue },
			success: function(json) {
				if (json['error']) {
					$span.removeClass('editing');
					$span.html($span.data('display') + ' <span class="text-danger inline-edit-error">' + json['error'] + '</span>');
					setTimeout(function() {
						$span.removeClass('editing');
						$span.html($span.data('display'));
					}, 3000);
				} else {
					render(json['value'] || '');
				}
			},
			error: function() {
				revert();
			}
		});
	}

	$input.on('blur', save);
	$input.on('keydown', function(e) {
		if (e.which === 13) { e.preventDefault(); $input.trigger('blur'); }
		if (e.which === 27) { revert(); }
	});
});
//--></script>
<div id="import-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title"><i data-lucide="upload" width="18" height="18"></i> {{ heading_import }}</h4>
      </div>
      <div class="modal-body">
        <form id="form-import" enctype="multipart/form-data">
          <div class="form-group">
            <label class="control-label">{{ text_select_file }}</label>
            <input type="file" name="file" accept=".csv,text/csv" class="form-control" />
          </div>
          <div id="import-error" class="alert alert-danger" style="display:none; margin-bottom:0;"></div>
          <div class="alert alert-info" style="margin-top:12px; margin-bottom:0;">
            <i data-lucide="info" width="16" height="16"></i> {{ text_import_format }}
            <pre style="margin-top:8px; margin-bottom:0;">store_id,language,query,keyword
0,en-gb,product_id=50,laptop</pre>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_cancel }}</button>
        <button type="button" class="btn btn-primary" id="button-import"><i data-lucide="upload" width="14" height="14"></i> {{ button_import }}</button>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#import-modal').on('change', '#form-import input[name=\'file\']', function() {
	$('#import-error').hide();
});

$('#button-import').on('click', function() {
	if (!$('#form-import input[name=\'file\']')[0].files.length) {
		$('#import-error').text('{{ text_select_file|e("js") }}').show();
		return;
	}

	var formData = new FormData($('#form-import')[0]);

	$.ajax({
		url: '{{ import }}',
		type: 'post',
		data: formData,
		dataType: 'json',
		cache: false,
		contentType: false,
		processData: false,
		beforeSend: function() {
			$('#button-import').prop('disabled', true);
		},
		complete: function() {
			$('#button-import').prop('disabled', false);
		},
		success: function(json) {
			$('.alert-dismissible').remove();
			if (json.error) {
				$('#content > .container-fluid').first().prepend('<div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> ' + json.error + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				lucide.createIcons();
			}
			if (json.success) {
				$('#content > .container-fluid').first().prepend('<div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> ' + json.success + '</div>');
				lucide.createIcons();
				$('#import-modal').modal('hide');
				setTimeout(function() { location.reload(); }, 900);
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
{{ footer }}
