{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-banner').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-banner">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width:1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'status' %}<a href="{{ sort_status }}" class="{{ order|lower }} sortable">{{ column_status }}</a>{% else %}<a href="{{ sort_status }}" class="sortable">{{ column_status }}</a>{% endif %}</td>
              <td class="text-right"></td>
            </tr>
          </thead>
          <tbody>
            {% if banners %}
            {% for banner in banners %}
            <tr>
              <td class="text-center">
                <input type="checkbox" name="selected[]" value="{{ banner.banner_id }}" {% if banner.banner_id in selected %}checked="checked"{% endif %} />
              </td>
              <td class="text-left">{{ banner.name }}</td>
              <td class="text-left">
                <span class="inline-edit" data-banner-id="{{ banner.banner_id }}" data-field="status" data-value="{{ banner.status_raw }}">
                  {% if banner.status_raw %}
                  <span class="label label-success">{{ text_enabled }}</span>
                  {% else %}
                  <span class="label label-danger">{{ text_disabled }}</span>
                  {% endif %}
                  <i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>
                </span>
              </td>
              <td class="text-right"><a href="{{ banner.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn--icon"><i data-lucide="pencil" width="14" height="14"></i></a></td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="4">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$(document).on('click', '.inline-edit-icon', function(e) {
  e.stopPropagation();
  var $span = $(this).closest('.inline-edit');
  if ($span.find('select').length) return;

  var bannerId = $span.data('banner-id');
  var currentValue = $span.data('value');

  $span.data('display', $span.html());

  var $select = $('<select class="form-control input-sm" style="width:auto;display:inline-block;">');
  $select.append('<option value="1"' + (currentValue == 1 ? ' selected' : '') + '>{{ text_enabled }}</option>');
  $select.append('<option value="0"' + (currentValue == 0 ? ' selected' : '') + '>{{ text_disabled }}</option>');

  $span.html($select);
  $select.focus();

  var saved = false;

  $select.on('change', function() {
    saved = true;
    var newValue = $(this).val();

    $.ajax({
      url: 'index.php?route=design/banner/updateField&user_token={{ user_token }}',
      type: 'post',
      dataType: 'json',
      data: { banner_id: bannerId, field: 'status', value: newValue },
      success: function(json) {
        if (json['error']) {
          $span.html($span.data('display'));
        }
        if (json['success']) {
          $span.data('value', newValue);
          $span.html(json['value_html'] + '<i data-lucide="pencil" width="13" height="13" class="inline-edit-icon"></i>');
          lucide.createIcons({ nodes: [$span[0]] });
        }
      },
      error: function() {
        $span.html($span.data('display'));
      }
    });
  });

  $select.on('blur', function() {
    if (!saved) {
      $span.html($span.data('display'));
    }
  });
});
//--></script>
{{ footer }}
