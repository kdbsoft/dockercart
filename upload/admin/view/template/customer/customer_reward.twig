<div class="dcx-fragment-meta" data-reward-balance="{{ balance }}" hidden></div>
<div class="dc-record-list">
  {% if rewards %}
  {% for reward in rewards %}
  <div class="dc-record-item">
    <div class="dc-record-item__icon dc-record-item__icon--reward"><i data-lucide="trophy" width="16" height="16"></i></div>
    <div class="dc-record-item__body">
      <div class="dc-record-item__title">{{ reward.description }}</div>
      <div class="dc-record-item__subtitle">{{ reward.date_added }}</div>
    </div>
    <div class="dc-record-item__value {{ reward.positive ? 'dc-record-item__value--positive' : 'dc-record-item__value--negative' }}">{{ reward.points }}</div>
  </div>
  {% endfor %}
  {% else %}
  <div class="dc-record-empty">{{ text_no_results }}</div>
  {% endif %}
</div>
{% if results %}
<div class="row">
  <div class="col-sm-6 text-left">{{ pagination }}</div>
  <div class="col-sm-6 text-right">{{ results }}</div>
</div>
{% endif %}
