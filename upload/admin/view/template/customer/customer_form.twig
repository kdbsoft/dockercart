    (function(row) {
      $('#address-list').on('change keyup', '.dc-address-item[data-row="' + row + '"] :input', function() { buildAddressSummary(row); });
    })(address_row);

    // Sort custom fields inside the new item
    $('.dc-address-item[data-row="' + address_row + '"] .dcx-field[data-sort]').detach().each(function() {
      var $list = $('.dc-address-item[data-row="' + address_row + '"] .dcx-fields');
      var sort = parseInt($(this).attr('data-sort'));
      var $items = $list.children();
      if (sort >= 0 && sort <= $items.length) {
        $items.eq(sort).before(this);
      }
      if (sort > $items.length) {
        $list.append(this);
      }
    });

    address_row++;
  }

