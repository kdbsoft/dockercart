  <script type="text/javascript"><!--
  $('input[name="affiliate"]').on('change', function() {
    if ($(this).val() == '1') {
      $('#tab-affiliate :input').not('input[name="affiliate"]').prop('disabled', false);
    } else {
      $('#tab-affiliate :input').not('input[name="affiliate"]').prop('disabled', true);
    }
  });
  $('input[name=\'affiliate\']:checked').trigger('change');
  //--></script>
  <script type="text/javascript"><!--
  $('select[name=\'customer_group_id\']').on('change', function() {
    $.ajax({
      url: 'index.php?route=customer/customer/customfield&user_token={{ user_token }}&customer_group_id=' + this.value,
      dataType: 'json',
      success: function(json) {
        $('.custom-field').hide();
        $('.custom-field').removeClass('required');
        for (i = 0; i < json.length; i++) {
          custom_field = json[i];
          $('.custom-field' + custom_field['custom_field_id']).show();
          if (custom_field['required']) {
            $('.custom-field' + custom_field['custom_field_id']).addClass('required');
          }
        }
      },
      error: function(xhr, ajaxOptions, thrownError) {
        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
    });
  });
  $('select[name=\'customer_group_id\']').trigger('change');
  //--></script>
  <script type="text/javascript"><!--
  var address_row = {{ address_row }};

  function buildAddressSummary(row) {
    var fn = $('input[name="address[' + row + '][firstname]"]').val();
    var ln = $('input[name="address[' + row + '][lastname]"]').val();
    var co = $('input[name="address[' + row + '][company]"]').val();
    var ci = $('input[name="address[' + row + '][city]"]').val();
    var a1 = $('input[name="address[' + row + '][address_1]"]').val();
    var title = '';
    if (fn || ln) { title = (fn || '') + ' ' + (ln || ''); }
    if (co) { title += (title ? ' \u00b7 ' : '') + co; }
    if (!title) { title = '{{ tab_address|e('js') }} ' + row; }
    var subtitle = '';
    if (ci) { subtitle = ci; }
    var $country = $('select[name="address[' + row + '][country_id]"]');
    if ($country.length) {
      var countryName = $country.find('option:selected').text();
      if (countryName && countryName !== '{{ text_select|e('js') }}') {
        subtitle += (subtitle ? ', ' : '') + countryName;
      }
    }
    if (a1) { subtitle += (subtitle ? ' \u00b7 ' : '') + a1; }
    var $item = $('.dc-address-item[data-row="' + row + '"]');
    $item.find('.dc-address-item__title').text(title);
    $item.find('.dc-address-item__subtitle').text(subtitle);
  }

  function addAddress() {
    html  = '<div class="dc-address-item" data-row="' + address_row + '">';
    html += '  <div class="dc-address-item__head">';
    html += '    <div class="dc-address-item__icon"><i data-lucide="map-pin" width="16" height="16"></i></div>';
    html += '    <div>';
    html += '      <div class="dc-address-item__title">{{ tab_address|e('js') }} ' + address_row + '</div>';
    html += '      <div class="dc-address-item__subtitle"></div>';
    html += '    </div>';
    html += '    <div class="dc-address-item__actions">';
    html += '      <button type="button" class="btn btn-default btn-sm dc-address-item__remove" data-toggle="tooltip" title="{{ button_remove|e('js') }}"><i data-lucide="trash-2" width="14" height="14"></i></button>';
    html += '    </div>';
    html += '  </div>';
    html += '  <div class="dc-address-item__body">';
    html += '    <input type="hidden" name="address[' + address_row + '][address_id]" value="" />';
    html += '    <div class="dcx-fields">';
    html += '        <div class="dcx-fields dcx-fields--row">';
    html += '          <div class="dcx-field required">';
    html += '            <label class="dcx-label" for="input-firstname' + address_row + '">{{ entry_firstname|e('js') }}</label>';
    html += '            <input type="text" name="address[' + address_row + '][firstname]" value="" placeholder="{{ entry_firstname|e('js') }}" id="input-firstname' + address_row + '" class="form-control" />';
    html += '          </div>';
    html += '          <div class="dcx-field required">';
    html += '            <label class="dcx-label" for="input-lastname' + address_row + '">{{ entry_lastname|e('js') }}</label>';
    html += '            <input type="text" name="address[' + address_row + '][lastname]" value="" placeholder="{{ entry_lastname|e('js') }}" id="input-lastname' + address_row + '" class="form-control" />';
    html += '          </div>';
    html += '        </div>';
    html += '        <div class="dcx-field">';
    html += '          <label class="dcx-label" for="input-company' + address_row + '">{{ entry_company|e('js') }}</label>';
    html += '          <input type="text" name="address[' + address_row + '][company]" value="" placeholder="{{ entry_company|e('js') }}" id="input-company' + address_row + '" class="form-control" />';
    html += '        </div>';
    html += '        <div class="dcx-field required">';
    html += '          <label class="dcx-label" for="input-address-1' + address_row + '">{{ entry_address_1|e('js') }}</label>';
    html += '          <input type="text" name="address[' + address_row + '][address_1]" value="" placeholder="{{ entry_address_1|e('js') }}" id="input-address-1' + address_row + '" class="form-control" />';
    html += '        </div>';
    html += '        <div class="dcx-field">';
    html += '          <label class="dcx-label" for="input-address-2' + address_row + '">{{ entry_address_2|e('js') }}</label>';
    html += '          <input type="text" name="address[' + address_row + '][address_2]" value="" placeholder="{{ entry_address_2|e('js') }}" id="input-address-2' + address_row + '" class="form-control" />';
    html += '        </div>';
    html += '        <div class="dcx-fields dcx-fields--row">';
    html += '          <div class="dcx-field required">';
    html += '            <label class="dcx-label" for="input-city' + address_row + '">{{ entry_city|e('js') }}</label>';
    html += '            <input type="text" name="address[' + address_row + '][city]" value="" placeholder="{{ entry_city|e('js') }}" id="input-city' + address_row + '" class="form-control" />';
    html += '          </div>';
    html += '          <div class="dcx-field required">';
    html += '            <label class="dcx-label" for="input-postcode' + address_row + '">{{ entry_postcode|e('js') }}</label>';
    html += '            <input type="text" name="address[' + address_row + '][postcode]" value="" placeholder="{{ entry_postcode|e('js') }}" id="input-postcode' + address_row + '" class="form-control" />';
    html += '          </div>';
    html += '        </div>';
    html += '        <div class="dcx-fields dcx-fields--row">';
    html += '          <div class="dcx-field required">';
    html += '            <label class="dcx-label" for="input-country' + address_row + '">{{ entry_country|e('js') }}</label>';
    html += '            <select name="address[' + address_row + '][country_id]" id="input-country' + address_row + '" onchange="country(this, \'' + address_row + '\', \'0\');" class="form-control">';
    html += '              <option value="">{{ text_select|e('js') }}</option>';
    {% for country in countries %}
    html += '              <option value="{{ country.country_id }}">{{ country.name|e('js') }}</option>';
    {% endfor %}
    html += '            </select>';
    html += '          </div>';
    html += '          <div class="dcx-field required">';
    html += '            <label class="dcx-label" for="input-zone' + address_row + '">{{ entry_zone|e('js') }}</label>';
    html += '            <select name="address[' + address_row + '][zone_id]" id="input-zone' + address_row + '" class="form-control"><option value="">{{ text_none|e('js') }}</option></select>';
    html += '          </div>';
    html += '        </div>';
    {% for custom_field in custom_fields %}
    {% if custom_field.location == 'address' %}
    {% if custom_field.type == 'select' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label" for="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name|e('js') }}</label>';
    html += '          <select name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}]" id="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}" class="form-control">';
    html += '            <option value="">{{ text_select|e('js') }}</option>';
    {% for custom_field_value in custom_field.custom_field_value %}
    html += '            <option value="{{ custom_field_value.custom_field_value_id }}">{{ custom_field_value.name|e('js') }}</option>';
    {% endfor %}
    html += '          </select>';
    html += '        </div>';
    {% endif %}
    {% if custom_field.type == 'radio' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label">{{ custom_field.name|e('js') }}</label>';
    html += '          <div>';
    {% for custom_field_value in custom_field.custom_field_value %}
    html += '            <div class="radio"><label><input type="radio" name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" /> {{ custom_field_value.name|e('js') }}</label></div>';
    {% endfor %}
    html += '          </div>';
    html += '        </div>';
    {% endif %}
    {% if custom_field.type == 'checkbox' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label">{{ custom_field.name|e('js') }}</label>';
    html += '          <div>';
    {% for custom_field_value in custom_field.custom_field_value %}
    html += '            <div class="checkbox"><label><input type="checkbox" name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" /> {{ custom_field_value.name|e('js') }}</label></div>';
    {% endfor %}
    html += '          </div>';
    html += '        </div>';
    {% endif %}
    {% if custom_field.type == 'text' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label" for="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name|e('js') }}</label>';
    html += '          <input type="text" name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}]" value="{{ custom_field.value|e('js') }}" placeholder="{{ custom_field.name|e('js') }}" id="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}" class="form-control" />';
    html += '        </div>';
    {% endif %}
    {% if custom_field.type == 'textarea' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label" for="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name|e('js') }}</label>';
    html += '          <textarea name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}]" rows="5" placeholder="{{ custom_field.name|e('js') }}" id="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}" class="form-control">{{ custom_field.value|e('js') }}</textarea>';
    html += '        </div>';
    {% endif %}
    {% if custom_field.type == 'file' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label">{{ custom_field.name|e('js') }}</label>';
    html += '          <button type="button" id="button-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}" data-loading-text="{{ text_loading|e('js') }}" class="btn btn-default"><i data-lucide="upload" width="14" height="14"></i> {{ button_upload|e('js') }}</button>';
    html += '          <input type="hidden" name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}]" value="" id="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}" />';
    html += '        </div>';
    {% endif %}
    {% if custom_field.type == 'date' %}
    html += '        <div class="dcx-field custom-field custom-field{{ custom_field.custom_field_id }}" data-sort="{{ custom_field.sort_order + 1 }}">';
    html += '          <label class="dcx-label" for="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name|e('js') }}</label>';
    html += '          <div class="input-group date"><input type="text" name="address[' + address_row + '][custom_field][{{ custom_field.custom_field_id }}]" value="{{ custom_field.value|e('js') }}" placeholder="{{ custom_field.name|e('js') }}" data-date-format="YYYY-MM-DD" id="input-address' + address_row + '-custom-field{{ custom_field.custom_field_id }}" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div>';
    html += '        </div>';
