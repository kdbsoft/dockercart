<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <td class="text-left">{{ column_name }}</td>
        <td class="text-left">{{ column_email }}</td>
        <td class="text-left">{{ column_customer_group }}</td>
        <td class="text-left">{{ column_type }}</td>
        <td class="text-left">{{ column_date_added }}</td>
      </tr>
    </thead>
    <tbody>
    {% if customer_approvals %}
    {% for customer_approval in customer_approvals %}
    <tr data-href="{{ customer_approval.edit }}">
      <td class="text-left"><a href="{{ customer_approval.edit }}" class="row-title-link">{{ customer_approval.name }}</a></td>
      <td class="text-left">{{ customer_approval.email }}</td>
      <td class="text-left">{{ customer_approval.customer_group }}</td>
      <td class="text-left">{{ customer_approval.type }}</td>
      <td class="text-left">{{ customer_approval.date_added }}</td>
      <td class="text-right" style="white-space:nowrap;"><a href="{{ customer_approval.approve }}" class="btn btn-success btn--icon" data-toggle="tooltip" title="{{ button_approve }}"><i data-lucide="thumbs-up" width="14" height="14"></i></a> <a href="{{ customer_approval.deny }}" class="btn btn-danger btn--icon" data-toggle="tooltip" title="{{ button_deny }}"><i data-lucide="thumbs-down" width="14" height="14"></i></a></td>
    </tr>
    {% endfor %}
    {% else %}
    <tr>
      <td class="text-center" colspan="5">{{ text_no_results }}</td>
    </tr>
    {% endif %}
    </tbody>
  </table>
</div>
<div class="pagination-wrap">
  <div class="row">
    <div class="col-sm-6 text-left">{{ pagination }}</div>
    <div class="col-sm-6 text-right">{{ results }}</div>
  </div>
</div>
