{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="pull-right">
            <button type="submit" form="form-customer-group" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if customer_group_id %}
                {{ customer_group_name }}
              {% else %}
                {{ text_add }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-customer-group">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-2 col-lg-8 col-xl-offset-3 col-xl-6">
        <div class="dcx-shell">
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="file-text" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_description_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                      <input type="text" name="customer_group_description[{{ language.language_id }}][name]" value="{{ customer_group_description[language.language_id] ? customer_group_description[language.language_id].name }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                      {% if error_name[language.language_id] %}
                      <div class="text-danger">{{ error_name[language.language_id] }}</div>
                      {% endif %}
                    </div>
                    <div class="dcx-field">
                      <label class="dcx-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                      <textarea name="customer_group_description[{{ language.language_id }}][description]" rows="3" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" class="form-control">{{ customer_group_description[language.language_id] ? customer_group_description[language.language_id].description }}</textarea>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
              <div class="dcx-fields">
                <div class="dcx-field">
                  <label class="dcx-label">{{ entry_approval }}</label>
                  <div class="dcx-checkbox-group">
                    <label class="dcx-checkbox-label">
                      <input type="hidden" name="approval" value="0" />
                      <input type="checkbox" name="approval" value="1"{% if approval %} checked{% endif %} /> {{ entry_approval }}
                      <span data-toggle="tooltip" title="{{ help_approval }}"><i data-lucide="circle-question-mark" width="14" height="14" class="text-muted"></i></span>
                    </label>
                  </div>
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-sort-order">{{ entry_sort_order }}</label>
                  <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-discount-percent">{{ entry_discount_percent }}</label>
                  <div class="input-group">
                    <input type="number" name="discount_percent" value="{{ discount_percent }}" placeholder="{{ entry_discount_percent }}" id="input-discount-percent" class="form-control" min="0" max="100" step="0.01" />
                    <span class="input-group-addon">%</span>
                  </div>
                  {% if error_discount_percent %}
                  <div class="text-danger">{{ error_discount_percent }}</div>
                  {% endif %}
                </div>
                <div class="dcx-field">
                  <label class="dcx-label" for="input-markup-percent">{{ entry_markup_percent }}</label>
                  <div class="input-group">
                    <input type="number" name="markup_percent" value="{{ markup_percent }}" placeholder="{{ entry_markup_percent }}" id="input-markup-percent" class="form-control" min="0" max="100" step="0.01" />
                    <span class="input-group-addon">%</span>
                  </div>
                  {% if error_markup_percent %}
                  <div class="text-danger">{{ error_markup_percent }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('#language a:first').tab('show');
//--></script>
{{ footer }}
