{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="pull-right">
            <button type="submit" form="form-custom-field" class="btn btn-primary"><i data-lucide="save" width="16" height="16"></i> {{ button_save }}</button>
            <a href="{{ cancel }}" class="btn btn-default"><i data-lucide="x" width="16" height="16"></i> {{ button_cancel }}</a>
          </div>
          <a href="{{ cancel }}" class="page-header__link">
            <span class="page-header__back">
              <i data-lucide="arrow-left" width="20" height="20"></i>
            </span>
            <span class="page-header__title">
              {% if custom_field_id %}
                {{ custom_field_name }}
              {% else %}
                {{ text_add }}
              {% endif %}
            </span>
          </a>
        </div>
      </div>
      {% if error_warning %}
      <div class="row">
        <div class="col-sm-12 col-lg-offset-1 col-lg-11 col-xl-offset-1 col-xl-10">
          <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-custom-field">
    <div class="row">
      <div class="col-md-12 col-sm-12 col-lg-offset-1 col-lg-7 col-xl-offset-1 col-xl-7">
        <div class="dcx-shell">
          {# ── CUSTOM FIELD PANEL ── #}
          <div class="dcx-panel">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="sliders-horizontal" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_custom_field_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li><a href="#language{{ language.language_id }}" data-toggle="tab"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <div class="dcx-fields">
                    <div class="dcx-field required">
                      <label class="dcx-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                      <input type="text" name="custom_field_description[{{ language.language_id }}][name]" value="{{ custom_field_description[language.language_id] ? custom_field_description[language.language_id].name }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                      {% if error_name[language.language_id] %}
                      <div class="text-danger">{{ error_name[language.language_id] }}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
              <div class="dcx-fields" style="margin-top:16px;">
                <div class="dcx-fields dcx-fields--row">
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-location">{{ entry_location }}</label>
                    <select name="location" id="input-location" class="form-control">
                      {% if location == 'account' %}
                      <option value="account" selected="selected">{{ text_account }}</option>
                      {% else %}
                      <option value="account">{{ text_account }}</option>
                      {% endif %}
                      {% if location == 'address' %}
                      <option value="address" selected="selected">{{ text_address }}</option>
                      {% else %}
                      <option value="address">{{ text_address }}</option>
                      {% endif %}
                      {% if location == 'affiliate' %}
                      <option value="affiliate" selected="selected">{{ text_affiliate }}</option>
                      {% else %}
                      <option value="affiliate">{{ text_affiliate }}</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="dcx-field">
                    <label class="dcx-label" for="input-type">{{ entry_type }}</label>
                    <select name="type" id="input-type" class="form-control">
                      <optgroup label="{{ text_choose }}">
                      {% if type == 'select' %}
                      <option value="select" selected="selected">{{ text_select }}</option>
                      {% else %}
                      <option value="select">{{ text_select }}</option>
                      {% endif %}
                      {% if type == 'radio' %}
                      <option value="radio" selected="selected">{{ text_radio }}</option>
                      {% else %}
                      <option value="radio">{{ text_radio }}</option>
                      {% endif %}
                      {% if type == 'checkbox' %}
                      <option value="checkbox" selected="selected">{{ text_checkbox }}</option>
                      {% else %}
                      <option value="checkbox">{{ text_checkbox }}</option>
                      {% endif %}
                      </optgroup>
                      <optgroup label="{{ text_input }}">
                      {% if type == 'text' %}
                      <option value="text" selected="selected">{{ text_text }}</option>
                      {% else %}
                      <option value="text">{{ text_text }}</option>
                      {% endif %}
                      {% if type == 'textarea' %}
                      <option value="textarea" selected="selected">{{ text_textarea }}</option>
                      {% else %}
                      <option value="textarea">{{ text_textarea }}</option>
                      {% endif %}
                      </optgroup>
                      <optgroup label="{{ text_file }}">
                      {% if type == 'file' %}
                      <option value="file" selected="selected">{{ text_file }}</option>
                      {% else %}
                      <option value="file">{{ text_file }}</option>
                      {% endif %}
                      </optgroup>
                      <optgroup label="{{ text_date }}">
                      {% if type == 'date' %}
                      <option value="date" selected="selected">{{ text_date }}</option>
                      {% else %}
                      <option value="date">{{ text_date }}</option>
                      {% endif %}
                      {% if type == 'time' %}
                      <option value="time" selected="selected">{{ text_time }}</option>
                      {% else %}
                      <option value="time">{{ text_time }}</option>
                      {% endif %}
                      {% if type == 'datetime' %}
                      <option value="datetime" selected="selected">{{ text_datetime }}</option>
                      {% else %}
                      <option value="datetime">{{ text_datetime }}</option>
                      {% endif %}
                      </optgroup>
                    </select>
                  </div>
                </div>
                <div class="dcx-field" id="display-value">
                  <label class="dcx-label" for="input-value">{{ entry_value }}</label>
                  <input type="text" name="value" value="{{ value }}" placeholder="{{ entry_value }}" id="input-value" class="form-control" />
                </div>
                <div class="dcx-field" id="display-validation">
                  <label class="dcx-label" for="input-validation">
                    <span data-toggle="tooltip" title="{{ help_regex }}">{{ entry_validation }}</span>
                  </label>
                  <input type="text" name="validation" id="input-validation" value="{{ validation }}" placeholder="{{ text_regex }}" class="form-control" />
                </div>
              </div>
            </div>
          </div>
          {# ── VALUES PANEL (for select/radio/checkbox) ── #}
          <div id="custom-field-value" class="dcx-panel" style="margin-top:16px;">
            <div class="dcx-panel-head">
              <div class="dcx-panel-head__icon"><i data-lucide="list" width="18" height="18"></i></div>
              <div>
                <div class="dcx-panel-title">{{ text_values_card }}</div>
              </div>
            </div>
            <div class="dcx-panel-body">
              <div class="custom-field-values-list">
                {% set custom_field_value_row = 0 %}
                {% for custom_field_value in custom_field_values %}
                <div class="custom-field-value-entry" id="custom-field-value-row{{ custom_field_value_row }}">
                  <div class="custom-field-value-entry__header">
                    <span class="custom-field-value-entry__icon">
                      <i data-lucide="hash" width="14" height="14"></i>
                    </span>
                    <span class="custom-field-value-entry__title">
                      {% for language in languages %}
                      <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ custom_field_value.custom_field_value_description[language.language_id] ? custom_field_value.custom_field_value_description[language.language_id].name : '' }}{% if not loop.last %} {% endif %}
                      {% endfor %}
                    </span>
                    <div class="custom-field-value-entry__actions">
                      <input type="text" name="custom_field_value[{{ custom_field_value_row }}][sort_order]" value="{{ custom_field_value.sort_order }}" placeholder="{{ entry_sort_order }}" class="form-control input-sm" style="width:70px;display:inline-block;" />
                      <button type="button" onclick="$('#custom-field-value-row{{ custom_field_value_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon"><i data-lucide="circle-minus" width="14" height="14"></i></button>
                    </div>
                  </div>
                  <div class="custom-field-value-entry__body">
                    <input type="hidden" name="custom_field_value[{{ custom_field_value_row }}][custom_field_value_id]" value="{{ custom_field_value.custom_field_value_id }}" />
                    {% for language in languages %}
                    <div class="custom-field-value-entry__field">
                      <label class="custom-field-value-entry__label">
                        <span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}
                      </label>
                      <input type="text" name="custom_field_value[{{ custom_field_value_row }}][custom_field_value_description][{{ language.language_id }}][name]" value="{{ custom_field_value.custom_field_value_description[language.language_id] ? custom_field_value.custom_field_value_description[language.language_id].name }}" placeholder="{{ entry_custom_value }}" class="form-control" />
                      {% if error_custom_field_value[custom_field_value_row][language.language_id] %}
                      <div class="text-danger">{{ error_custom_field_value[custom_field_value_row][language.language_id] }}</div>
                      {% endif %}
                    </div>
                    {% endfor %}
                  </div>
                </div>
                {% set custom_field_value_row = custom_field_value_row + 1 %}
                {% endfor %}
              </div>
              <div class="text-right" style="margin-top:12px;">
                <button type="button" onclick="addCustomFieldValue();" data-toggle="tooltip" title="{{ button_custom_field_value_add }}" class="btn btn-primary btn--icon"><i data-lucide="circle-plus" width="14" height="14"></i></button>
              </div>
            </div>
          </div>
        </div>
      </div>
      {# ── SIDEBAR ── #}
      <div class="col-md-12 col-sm-12 col-lg-4 col-xl-3">
        <div class="dcx-sidebar-card">
          <div class="dcx-sidebar-card__header">
            <div class="dcx-sidebar-card__header-icon"><i data-lucide="cog" width="16" height="16"></i></div>
            <h3 class="dcx-sidebar-card__title">{{ text_settings_card }}</h3>
          </div>
          <div class="dcx-sidebar-card__body">
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_customer_group }}</label>
              {% set customer_group_row = 0 %}
              {% for customer_group in customer_groups %}
              <label class="dcx-sidebar-card__checkbox">
                <input type="checkbox" name="custom_field_customer_group[{{ customer_group_row }}][customer_group_id]" value="{{ customer_group.customer_group_id }}" {% if customer_group.customer_group_id in custom_field_customer_group %}checked="checked"{% endif %} />
                <span>{{ customer_group.name }}</span>
              </label>
              {% set customer_group_row = customer_group_row + 1 %}
              {% endfor %}
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label">{{ entry_required }}</label>
              {% set customer_group_row = 0 %}
              {% for customer_group in customer_groups %}
              <label class="dcx-sidebar-card__checkbox">
                <input type="checkbox" name="custom_field_customer_group[{{ customer_group_row }}][required]" value="{{ customer_group.customer_group_id }}" {% if customer_group.customer_group_id in custom_field_required %}checked="checked"{% endif %} />
                <span>{{ customer_group.name }}</span>
              </label>
              {% set customer_group_row = customer_group_row + 1 %}
              {% endfor %}
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-status">{{ entry_status }}</label>
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
            <div class="dcx-sidebar-card__field">
              <label class="dcx-sidebar-card__label" for="input-sort-order">
                <span data-toggle="tooltip" title="{{ help_sort_order }}">{{ entry_sort_order }}</span>
              </label>
              <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </div>
      </div>
    </div>
    </form>
  </div>
  <script type="text/javascript"><!--
$('#language a:first').tab('show');

$('select[name=\'type\']').on('change', function() {
  if (this.value == 'select' || this.value == 'radio' || this.value == 'checkbox') {
    $('#custom-field-value').show();
    $('#display-value, #display-validation').hide();
  } else {
    $('#custom-field-value').hide();
    $('#display-value, #display-validation').show();
  }

  if (this.value == 'date') {
    $('#display-value > div, #display-value > input').replaceWith('<div class="input-group date"><input type="text" name="value" value="' + ($('#input-value').val() || '') + '" placeholder="{{ entry_value }}" data-date-format="YYYY-MM-DD" id="input-value" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div>');
  } else if (this.value == 'time') {
    $('#display-value > div, #display-value > input').replaceWith('<div class="input-group time"><input type="text" name="value" value="' + ($('#input-value').val() || '') + '" placeholder="{{ entry_value }}" data-date-format="HH:mm" id="input-value" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div>');
  } else if (this.value == 'datetime') {
    $('#display-value > div, #display-value > input').replaceWith('<div class="input-group datetime"><input type="text" name="value" value="' + ($('#input-value').val() || '') + '" placeholder="{{ entry_value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-value" class="form-control" /><span class="input-group-btn"><button type="button" class="btn btn-default"><i data-lucide="calendar" width="14" height="14"></i></button></span></div>');
  } else if (this.value == 'textarea') {
    $('#display-value > div, #display-value > input').replaceWith('<textarea name="value" placeholder="{{ entry_value }}" id="input-value" class="form-control">' + ($('#input-value').val() || '') + '</textarea>');
  } else {
    $('#display-value > div, #display-value > input').replaceWith('<input type="text" name="value" value="' + ($('#input-value').val() || '') + '" placeholder="{{ entry_value }}" id="input-value" class="form-control" />');
  }

  lucide.createIcons();

  $('.date').datetimepicker({ language: '{{ datepicker }}', pickTime: false });
  $('.time').datetimepicker({ language: '{{ datepicker }}', pickDate: false });
  $('.datetime').datetimepicker({ language: '{{ datepicker }}', pickDate: true, pickTime: true });
});

$('select[name=\'type\']').trigger('change');

var custom_field_value_row = {{ custom_field_value_row }};

function addCustomFieldValue() {
  html  = '<div class="custom-field-value-entry" id="custom-field-value-row' + custom_field_value_row + '">';
  html += '  <div class="custom-field-value-entry__header">';
  html += '    <span class="custom-field-value-entry__icon"><i data-lucide="hash" width="14" height="14"></i></span>';
  html += '    <span class="custom-field-value-entry__title">{{ text_add }}</span>';
  html += '    <div class="custom-field-value-entry__actions">';
  html += '      <input type="text" name="custom_field_value[' + custom_field_value_row + '][sort_order]" value="" placeholder="{{ entry_sort_order }}" class="form-control input-sm" style="width:70px;display:inline-block;" />';
  html += '      <button type="button" onclick="$(\'#custom-field-value-row' + custom_field_value_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn--icon"><i data-lucide="circle-minus" width="14" height="14"></i></button>';
  html += '    </div>';
  html += '  </div>';
  html += '  <div class="custom-field-value-entry__body">';
  html += '    <input type="hidden" name="custom_field_value[' + custom_field_value_row + '][custom_field_value_id]" value="" />';
  {% for language in languages %}
  html += '    <div class="custom-field-value-entry__field">';
  html += '      <label class="custom-field-value-entry__label"><span class="lang-code">{{ language.code|split('-')|first|upper }}</span> {{ language.name }}</label>';
  html += '      <input type="text" name="custom_field_value[' + custom_field_value_row + '][custom_field_value_description][{{ language.language_id }}][name]" value="" placeholder="{{ entry_custom_value }}" class="form-control" />';
  html += '    </div>';
  {% endfor %}
  html += '  </div>';
  html += '</div>';

  $('.custom-field-values-list').append(html);
  lucide.createIcons();
  custom_field_value_row++;
}
//--></script>
</div>
{{ footer }}
