<div class="dcx-fragment-meta" data-balance="{{ balance|e('html_attr') }}" hidden></div>
<div class="dc-record-list">
  {% if transactions %}
  {% for transaction in transactions %}
  <div class="dc-record-item">
    <div class="dc-record-item__icon dc-record-item__icon--money"><i data-lucide="wallet" width="16" height="16"></i></div>
    <div class="dc-record-item__body">
      <div class="dc-record-item__title">{{ transaction.description }}</div>
      <div class="dc-record-item__subtitle">{{ transaction.date_added }}</div>
    </div>
    <div class="dc-record-item__value {{ transaction.positive ? 'dc-record-item__value--positive' : 'dc-record-item__value--negative' }}">{{ transaction.amount }}</div>
  </div>
  {% endfor %}
  {% else %}
  <div class="dc-record-empty">{{ text_no_results }}</div>
  {% endif %}
</div>
{% if results %}
<div class="row">
  <div class="col-sm-6 text-left">{{ pagination }}</div>
  <div class="col-sm-6 text-right">{{ results }}</div>
</div>
{% endif %}
