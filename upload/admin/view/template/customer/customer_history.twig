<div class="dcx-fragment-meta" data-history-total="{{ history_total }}" hidden></div>
<div class="dc-record-list">
  {% if histories %}
  {% for history in histories %}
  <div class="dc-record-item">
    <div class="dc-record-item__icon dc-record-item__icon--note"><i data-lucide="sticky-note" width="16" height="16"></i></div>
    <div class="dc-record-item__body">
      <div class="dc-record-item__title">{{ history.date_added }}</div>
      <div class="dc-record-item__subtitle dc-record-item__subtitle--multiline">{{ history.comment }}</div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="dc-record-empty">{{ text_no_results }}</div>
  {% endif %}
</div>
{% if results %}
<div class="row">
  <div class="col-sm-6 text-left">{{ pagination }}</div>
  <div class="col-sm-6 text-right">{{ results }}</div>
</div>
{% endif %}
