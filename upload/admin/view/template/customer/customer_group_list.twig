{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-customer-group').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if customer_groups %}

    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-customer-group">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'cgd.name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'cg.discount_percent' %}<a href="{{ sort_discount_percent }}" class="{{ order|lower }} sortable">{{ column_discount_percent }}</a>{% else %}<a href="{{ sort_discount_percent }}" class="sortable">{{ column_discount_percent }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'cg.markup_percent' %}<a href="{{ sort_markup_percent }}" class="{{ order|lower }} sortable">{{ column_markup_percent }}</a>{% else %}<a href="{{ sort_markup_percent }}" class="sortable">{{ column_markup_percent }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'cg.sort_order' %}<a href="{{ sort_sort_order }}" class="{{ order|lower }} sortable">{{ column_sort_order }}</a>{% else %}<a href="{{ sort_sort_order }}" class="sortable">{{ column_sort_order }}</a>{% endif %}</td>
            </tr>
          </thead>
          <tbody>
            {% if customer_groups %}
            {% for customer_group in customer_groups %}
            <tr data-href="{{ customer_group.edit }}">
              <td class="text-center">{% if customer_group.customer_group_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ customer_group.customer_group_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ customer_group.customer_group_id }}" />
                {% endif %}</td>
              <td class="text-left"><a href="{{ customer_group.edit }}" class="row-title-link">{{ customer_group.name }}</a></td>
              <td class="text-right">{{ customer_group.discount_percent }}%</td>
              <td class="text-right">{{ customer_group.markup_percent }}%</td>
              <td class="text-right">{{ customer_group.sort_order }}</td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="5">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>

    {% else %}

        {% include 'common/empty_state.twig' with {

          icon: 'customer_group',

          standalone: true,

          title: text_empty_title,

          description: text_empty_description,

          action_url: add,

          action_text: button_add

        } %}

    {% endif %}
  </div>
</div>
{{ footer }}
