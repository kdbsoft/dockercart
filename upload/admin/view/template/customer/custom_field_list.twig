{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-12">
          <div class="pull-right">
            <a href="{{ add }}" class="btn btn-primary"><i data-lucide="plus" width="16" height="16"></i> {{ button_add }}</a>
            <button type="button" class="btn btn-danger dc-btn-selection" onclick="confirm('{{ text_confirm }}') ? $('#form-custom-field').submit() : false;"><i data-lucide="trash-2" width="16" height="16"></i> {{ button_delete }}</button>
          </div>
          <h1 class="page-header__title">{{ heading_title }}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i data-lucide="circle-alert" width="16" height="16"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i data-lucide="circle-check" width="16" height="16"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-custom-field">
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
              <td class="text-left">{% if sort == 'cfd.name' %}<a href="{{ sort_name }}" class="{{ order|lower }} sortable">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}" class="sortable">{{ column_name }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'cf.location' %}<a href="{{ sort_location }}" class="{{ order|lower }} sortable">{{ column_location }}</a>{% else %}<a href="{{ sort_location }}" class="sortable">{{ column_location }}</a>{% endif %}</td>
              <td class="text-left">{% if sort == 'cf.type' %}<a href="{{ sort_type }}" class="{{ order|lower }} sortable">{{ column_type }}</a>{% else %}<a href="{{ sort_type }}" class="sortable">{{ column_type }}</a>{% endif %}</td>
              <td class="text-right">{% if sort == 'cf.sort_order' %}<a href="{{ sort_sort_order }}" class="{{ order|lower }} sortable">{{ column_sort_order }}</a>{% else %}<a href="{{ sort_sort_order }}" class="sortable">{{ column_sort_order }}</a>{% endif %}</td>
            </tr>
          </thead>
          <tbody>
            {% if custom_fields %}
            {% for custom_field in custom_fields %}
            <tr data-href="{{ custom_field.edit }}">
              <td class="text-center">{% if custom_field.custom_field_id in selected %}
                <input type="checkbox" name="selected[]" value="{{ custom_field.custom_field_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="selected[]" value="{{ custom_field.custom_field_id }}" />
                {% endif %}</td>
              <td class="text-left"><a href="{{ custom_field.edit }}" class="row-title-link">{{ custom_field.name }}</a></td>
              <td class="text-left">{{ custom_field.location }}</td>
              <td class="text-left">{{ custom_field.type }}</td>
              <td class="text-right">{{ custom_field.sort_order }}</td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
              <td class="text-center" colspan="5">{{ text_no_results }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </form>
    <div class="pagination-wrap">
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
