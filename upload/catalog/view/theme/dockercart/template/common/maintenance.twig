{{ header }}
<div id="common-maintenance" class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="text-center bg-white rounded-3 shadow-sm p-5 border border-light">
        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mb-4" style="width:88px;height:88px;">
          <i data-lucide="wrench" width="40" height="40"></i>
        </div>
        <h1 class="fw-bold mb-3">{{ heading_title }}</h1>
        <p class="text-muted fs-5 mb-4">{{ message }}</p>
        <div class="d-inline-flex align-items-center gap-2 text-muted small">
          <span class="spinner-border spinner-border-sm text-warning" role="status" aria-hidden="true"></span>
          {{ text_status }}
        </div>
        {% if contact %}
        <div class="mt-4 pt-3 border-top">
          <a href="mailto:{{ contact }}" class="link-secondary text-decoration-none">{{ text_contact }}</a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
