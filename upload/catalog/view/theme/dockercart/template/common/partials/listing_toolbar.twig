{% set toolbar_id = toolbar_id|default('listing') %}

<div class="bg-white border border-gray-100 rounded-3xl p-4 sm:p-5 mb-5 shadow-sm">
  <div class="hidden lg:flex min-w-0 flex-wrap items-center justify-between gap-3">
    <span class="shrink-0 text-sm font-semibold text-gray-500">{{ listing_count }}</span>

    <div class="flex min-w-0 flex-wrap items-center justify-end gap-2">
      {% if sorts is defined and sorts %}
      <div class="flex h-9 min-w-0 items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-2.5 transition focus-within:border-gray-400 focus-within:bg-white">
        <i data-lucide="arrow-down-up" class="h-4 w-4 shrink-0 text-gray-400" aria-hidden="true"></i>
        <label for="{{ toolbar_id }}-desktop-sort" class="shrink-0 text-[11px] font-semibold text-gray-500">{{ text_sort }}</label>
        <div class="relative min-w-0 w-44">
          <select id="{{ toolbar_id }}-desktop-sort" onchange="location = this.value;" class="dc-toolbar-select h-9 w-full appearance-none border-0 bg-transparent py-1 pl-0 pr-7 text-sm font-semibold text-gray-800 focus:outline-none focus:ring-0">
            {% for sort_item in sorts %}
            <option value="{{ sort_item.href }}" {% if sort_item.value == '%s-%s'|format(sort, order) %}selected{% endif %}>{{ sort_item.text }}</option>
            {% endfor %}
          </select>
          <i data-lucide="chevron-down" class="pointer-events-none absolute right-0 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
        </div>
      </div>
      {% endif %}
      {% if limits is defined and limits %}
      <div class="flex h-9 min-w-0 items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-2.5 transition focus-within:border-gray-400 focus-within:bg-white">
        <i data-lucide="list-filter" class="h-4 w-4 shrink-0 text-gray-400" aria-hidden="true"></i>
        <label for="{{ toolbar_id }}-desktop-limit" class="shrink-0 text-[11px] font-semibold text-gray-500">{{ text_limit }}</label>
        <div class="relative w-20">
          <select id="{{ toolbar_id }}-desktop-limit" onchange="location = this.value;" class="dc-toolbar-select h-9 w-full appearance-none border-0 bg-transparent py-1 pl-0 pr-6 text-sm font-semibold text-gray-800 focus:outline-none focus:ring-0">
            {% for limit_item in limits %}
            <option value="{{ limit_item.href }}" {% if limit_item.value == limit %}selected{% endif %}>{{ limit_item.text }}</option>
            {% endfor %}
          </select>
          <i data-lucide="chevron-down" class="pointer-events-none absolute right-0 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
        </div>
      </div>
      {% endif %}
      {% if limits is defined and limits %}
      <div class="flex h-9 shrink-0 items-center rounded-xl border border-gray-200 bg-gray-50 p-0.5" role="group" aria-label="{{ text_view_grid|default('Grid') }}">
        <div class="dc-view-toggle items-center gap-0.5 border-0 p-0">
          <button class="dc-view-btn{% if view_mode == 'grid' %} is-active{% endif %}" data-view="grid" title="{{ text_view_grid|default('Grid') }}" aria-pressed="{{ view_mode == 'grid' ? 'true' : 'false' }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </button>
          <button class="dc-view-btn{% if view_mode == 'list' %} is-active{% endif %}" data-view="list" title="{{ text_view_list|default('List') }}" aria-pressed="{{ view_mode == 'list' ? 'true' : 'false' }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
          <button class="dc-view-btn{% if view_mode == 'table' %} is-active{% endif %}" data-view="table" title="{{ text_view_table|default('Table') }}" aria-pressed="{{ view_mode == 'table' ? 'true' : 'false' }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
          </button>
        </div>
      </div>
      {% endif %}
    </div>
  </div>

  <div class="lg:hidden">
    <div class="mb-3 flex items-center justify-between gap-3">
      <span class="text-sm font-semibold text-gray-500">{{ listing_count }}</span>
    </div>

    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {% if sorts is defined and sorts %}
      <label for="{{ toolbar_id }}-sort" class="flex h-[42px] min-w-0 items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-2.5 transition focus-within:border-gray-400 focus-within:bg-white">
        <i data-lucide="arrow-down-up" class="h-4 w-4 shrink-0 text-gray-400" aria-hidden="true"></i>
        <span class="shrink-0 text-[11px] font-semibold text-gray-500">{{ text_sort }}</span>
        <div class="relative min-w-0 flex-1">
          <select id="{{ toolbar_id }}-sort" onchange="location = this.value;" class="dc-toolbar-select h-[42px] w-full appearance-none border-0 bg-transparent px-0 py-2 pr-7 text-base font-semibold text-gray-800 {% if toolbar_variant == 'teal' %}focus:border-teal-400{% else %}focus:border-blue-400{% endif %} focus:outline-none focus:ring-0">
            {% for sort_item in sorts %}
            <option value="{{ sort_item.href }}" {% if sort_item.value == '%s-%s'|format(sort, order) %}selected{% endif %}>{{ sort_item.text }}</option>
            {% endfor %}
          </select>
          <i data-lucide="chevron-down" class="pointer-events-none absolute right-0 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
        </div>
      </label>
      {% endif %}
      {% if limits is defined and limits %}
      <label for="{{ toolbar_id }}-limit" class="flex h-[42px] min-w-0 items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 px-2.5 transition focus-within:border-gray-400 focus-within:bg-white">
        <i data-lucide="list-filter" class="h-4 w-4 shrink-0 text-gray-400" aria-hidden="true"></i>
        <span class="shrink-0 text-[11px] font-semibold text-gray-500">{{ text_limit }}</span>
        <div class="relative min-w-0 flex-1">
          <select id="{{ toolbar_id }}-limit" onchange="location = this.value;" class="dc-toolbar-select h-[42px] w-full appearance-none border-0 bg-transparent px-0 py-2 pr-7 text-base font-semibold text-gray-800 {% if toolbar_variant == 'teal' %}focus:border-teal-400{% else %}focus:border-blue-400{% endif %} focus:outline-none focus:ring-0">
            {% for limit_item in limits %}
            <option value="{{ limit_item.href }}" {% if limit_item.value == limit %}selected{% endif %}>{{ limit_item.text }}</option>
            {% endfor %}
          </select>
          <i data-lucide="chevron-down" class="pointer-events-none absolute right-0 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
        </div>
      </label>
      {% endif %}
    </div>
  </div>
</div>
