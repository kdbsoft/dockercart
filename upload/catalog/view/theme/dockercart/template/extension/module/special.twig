{# Special module for dockercart theme #}
{% if products|length %}
<section id="special" class="py-16 bg-white px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <p class="inline-flex items-center gap-2 text-red-500 text-sm font-semibold uppercase tracking-widest mb-1"><span class="w-4 h-px bg-red-300"></span>{{ heading_title }}</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">{{ text_special }}</h2>
        </div>
        <div class="hidden sm:block">
          <a href="{{ section_href }}" class="text-sm font-semibold text-blue-600 hover:underline">{{ text_view_all }}</a>
        </div>
      </div>
    </div>

    <div class="dc-carousel">
      <button type="button" class="dc-carousel-btn dc-carousel-prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div id="special-grid" class="dc-carousel-track">
        {% for product in products %}
          {% include 'dockercart/template/product/product_card_widget.twig' with {
            product: product,
            accent_color: 'red-600',
            btn_cart_classes: 'bg-red-600 text-white hover:bg-red-700',
            btn_quick_hover: 'hover:bg-red-600',
            card_extra: 'border-0'
          } %}
        {% endfor %}
      </div>
      <button type="button" class="dc-carousel-btn dc-carousel-next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>
{% endif %}

{# Quick View modal is created dynamically by quick-view.js #}
