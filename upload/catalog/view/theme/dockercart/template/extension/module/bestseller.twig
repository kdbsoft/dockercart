{# Bestseller module for dockercart theme #}
{% if products|length %}
<section id="bestseller" class="py-16 bg-white px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-8">
      {% if section_small is defined and section_small and (section_title is defined ? section_title : heading_title) != section_small %}
        <p class="text-rose-500 text-sm font-semibold uppercase tracking-widest mb-1">{{ section_small }}</p>
      {% endif %}
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">{{ section_title is defined ? section_title : heading_title }}</h2>
    </div>

    {% if category_filter %}
    <div class="dc-category-filter mb-6 flex flex-wrap justify-center gap-2" data-module="bestseller">
      <button type="button" class="dc-cat-btn px-4 py-2 text-sm font-medium rounded-full border border-rose-600 bg-rose-600 text-white transition-all duration-200" data-category-id="all">
        {{ text_all_categories }}
      </button>
      {% for cat in categories %}
      <button type="button" class="dc-cat-btn px-4 py-2 text-sm font-medium rounded-full border border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-rose-500 transition-all duration-200" data-category-id="{{ cat.category_id }}">
        {{ cat.name }}
      </button>
      {% endfor %}
    </div>
    {% endif %}

    <div id="bestseller-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for product in products %}
      <div class="dc-product-item" data-category-id="{{ product.category_id }}">
        {% include 'dockercart/template/product/product_card_widget.twig' with {
          product: product,
          accent_color: 'rose-600',
          btn_cart_classes: 'bg-rose-600 text-white hover:bg-rose-700',
          btn_quick_hover: 'hover:bg-rose-600'
        } %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if category_filter %}
<style>
.dc-cat-btn.bg-rose-600 {
  border-color: rgb(225 29 72);
}
.dc-cat-btn.bg-rose-600:hover {
  background-color: rgb(190 18 60);
  border-color: rgb(190 18 60);
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterContainer = document.querySelector('.dc-category-filter[data-module="bestseller"]');
  if (!filterContainer) return;

  const buttons = filterContainer.querySelectorAll('.dc-cat-btn');
  const productItems = document.querySelectorAll('#bestseller .dc-product-item');

  function activate(btn) {
    buttons.forEach(b => {
      b.classList.remove('bg-rose-600', 'text-white', 'border-rose-600');
      b.classList.add('border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
    });

    btn.classList.remove('border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
    btn.classList.add('bg-rose-600', 'text-white', 'border-rose-600');

    const catId = btn.dataset.categoryId;

    productItems.forEach(item => {
      if (catId === 'all' || item.dataset.categoryId === catId) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', function() {
      activate(this);
    });
  });
});
</script>
{% endif %}

{# Quick View modal is created dynamically by quick-view.js #}
