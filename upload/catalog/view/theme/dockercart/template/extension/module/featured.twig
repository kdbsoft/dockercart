{# Featured module for dockercart theme #}
{% if products|length %}
<section id="featured" class="py-16 bg-white px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-8">
      <p class="inline-flex items-center gap-2 text-blue-600 text-sm font-semibold uppercase tracking-widest mb-1"><span class="w-4 h-px bg-blue-300"></span>{{ heading_title }}</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">{{ text_section_small }}</h2>
    </div>

    {% if category_filter %}
    <div class="dc-category-filter mb-6 flex flex-wrap justify-center gap-2" data-module="featured">
      <button type="button" class="dc-cat-btn px-4 py-2 text-sm font-medium rounded-full border border-blue-600 bg-blue-600 text-white transition-all duration-200" data-category-id="all">
        {{ text_all_categories }}
      </button>
      {% for cat in categories %}
      <button type="button" class="dc-cat-btn px-4 py-2 text-sm font-medium rounded-full border border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-blue-500 transition-all duration-200" data-category-id="{{ cat.category_id }}">
        {{ cat.name }}
      </button>
      {% endfor %}
    </div>
    {% endif %}

    <div class="dc-carousel">
      <button type="button" class="dc-carousel-btn dc-carousel-prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div id="products-grid" class="dc-carousel-track">
        {% for product in products %}
        <div class="dc-product-item" data-category-id="{{ product.category_id }}">
          {% include 'dockercart/template/product/product_card_widget.twig' with {
            product: product,
            accent_color: 'blue-600',
            btn_cart_classes: 'bg-blue-600 text-white hover:bg-blue-700',
            btn_quick_hover: 'hover:bg-blue-600'
          } %}
        </div>
        {% endfor %}
      </div>
      <button type="button" class="dc-carousel-btn dc-carousel-next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>
{% endif %}

{% if category_filter %}
<style>
.dc-cat-btn.bg-blue-600 {
  border-color: rgb(37 99 235);
}
.dc-cat-btn.bg-blue-600:hover {
  background-color: rgb(29 78 216);
  border-color: rgb(29 78 216);
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterContainer = document.querySelector('.dc-category-filter[data-module="featured"]');
  if (!filterContainer) return;

  const buttons = filterContainer.querySelectorAll('.dc-cat-btn');
  const productItems = document.querySelectorAll('#featured .dc-product-item');

  function activate(btn) {
    buttons.forEach(b => {
      b.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
      b.classList.add('border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
    });

    btn.classList.remove('border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
    btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600');

    const catId = btn.dataset.categoryId;

    productItems.forEach(item => {
      if (catId === 'all' || item.dataset.categoryId === catId) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', function() {
      activate(this);
    });
  });
});
</script>
{% endif %}

{# Quick View modal is created dynamically by quick-view.js #}
