<section id="benefits" class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-100">
  <div class="max-w-7xl mx-auto">
    {% if section_title or section_subtitle %}
    <div class="mb-12">
      {% if section_title %}
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-blue-500 mb-3"><span class="w-4 h-px bg-blue-300"></span>{{ section_title }}</span>
      {% endif %}
      {% if section_subtitle %}
      <p class="text-gray-500 max-w-2xl">{{ section_subtitle }}</p>
      {% endif %}
    </div>
    {% endif %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for feature in features %}
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm group hover:shadow-md transition">
          <div class="w-14 h-14 rounded-2xl bg-gray-100 flex items-center justify-center mb-4 group-hover:bg-blue-600 transition">
            <i data-lucide="{{ feature.icon }}" class="w-7 h-7 text-gray-500 group-hover:text-white transition"></i>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">{{ feature.title }}</h3>
          <p class="text-gray-500 text-sm">{{ feature.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function() {
  if (window.lucide && typeof window.lucide.createIcons === 'function') {
    window.lucide.createIcons();
  }
})();
</script>
