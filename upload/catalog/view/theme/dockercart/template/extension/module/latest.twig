{# Latest module for dockercart theme #}
{% if products|length %}
<section id="latest" class="py-16 bg-white px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <p class="inline-flex items-center gap-2 text-teal-500 text-sm font-semibold uppercase tracking-widest mb-1"><span class="w-4 h-px bg-teal-300"></span>{{ section_title }}</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">{{ section_small }}</h2>
        </div>
        <div class="hidden sm:block">
          <a href="{{ section_href }}" class="text-sm font-semibold dc-view-all-link">{{ text_view_all }}</a>
        </div>
      </div>
    </div>

    {% if category_filter %}
    <div class="dc-category-filter mb-6 flex flex-wrap gap-2" data-module="latest">
      <button type="button" class="dc-cat-btn px-4 py-2 text-sm font-medium rounded-full border border-teal-600 bg-teal-600 text-white transition-all duration-200" data-category-id="all">
        {{ text_all_categories }}
      </button>
      {% for cat in categories %}
      <button type="button" class="dc-cat-btn px-4 py-2 text-sm font-medium rounded-full border border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-teal-500 transition-all duration-200" data-category-id="{{ cat.category_id }}">
        {{ cat.name }}
      </button>
      {% endfor %}
    </div>
    {% endif %}

    <div class="dc-carousel">
      <button type="button" class="dc-carousel-btn dc-carousel-prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div id="latest-grid" class="dc-carousel-track">
        {% for product in products %}
        <div class="dc-product-item" data-category-id="{{ product.category_id }}">
          {% include 'dockercart/template/product/product_card_widget.twig' with {
            product: product,
            accent_color: 'teal-600',
            btn_cart_classes: 'bg-teal-600 text-white hover:bg-teal-700',
            btn_quick_hover: 'hover:bg-teal-600',
            show_new_arrival: true
          } %}
        </div>
        {% endfor %}
      </div>
      <button type="button" class="dc-carousel-btn dc-carousel-next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>
{% endif %}

{% if category_filter %}
<style>
.dc-cat-btn.bg-teal-600 {
  border-color: rgb(13 148 136);
}
.dc-cat-btn.bg-teal-600:hover {
  background-color: rgb(15 118 110);
  border-color: rgb(15 118 110);
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterContainer = document.querySelector('.dc-category-filter[data-module="latest"]');
  if (!filterContainer) return;

  const buttons = filterContainer.querySelectorAll('.dc-cat-btn');
  const productItems = document.querySelectorAll('#latest .dc-product-item');

  function activate(btn) {
    buttons.forEach(b => {
      b.classList.remove('bg-teal-600', 'text-white', 'border-teal-600');
      b.classList.add('border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
    });

    btn.classList.remove('border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
    btn.classList.add('bg-teal-600', 'text-white', 'border-teal-600');

    const catId = btn.dataset.categoryId;

    productItems.forEach(item => {
      if (catId === 'all' || item.dataset.categoryId === catId) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', function() {
      activate(this);
    });
  });
});
</script>
{% endif %}

{# Quick View modal is created dynamically by quick-view.js #}
