{% if categories|length %}
<div>
	{% if content.heading or content.subheading %}
	<div class="mb-6">
		{% if content.subheading %}<p class="text-xs font-semibold uppercase tracking-widest text-blue-600 mb-1">{{ content.subheading }}</p>{% endif %}
		{% if content.heading %}<h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">{{ content.heading }}</h2>{% endif %}
	</div>
	{% endif %}

	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 {{ columns_class }}">
		{% for category in categories %}
		<a href="{{ category.href }}" class="group relative overflow-hidden rounded-2xl {{ image_height_class }} bg-gray-100 block">
			{% if category.image %}
			<img src="{{ category.image }}" alt="{{ category.name }}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
			{% endif %}
			<div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/20 to-transparent"></div>
			<div class="absolute inset-x-0 bottom-0 p-4">
				<h3 class="text-base sm:text-lg font-bold text-white">{{ category.name }}</h3>
			</div>
		</a>
		{% endfor %}
	</div>
</div>
{% endif %}
