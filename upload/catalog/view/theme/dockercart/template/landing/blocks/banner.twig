{% if slides|length %}
{% set height_class = {'sm': 'min-h-[280px]', 'md': 'min-h-[420px]', 'lg': 'min-h-[560px]'}[settings.height]|default('min-h-[420px]') %}
<div class="lp-banner relative overflow-hidden rounded-3xl bg-gray-900 {{ height_class }}" data-lp-banner data-autoplay="{{ autoplay }}">
	{% for slide in slides %}
	<div class="lp-banner-slide absolute inset-0 transition-opacity duration-500 {{ loop.first ? 'opacity-100' : 'opacity-0 pointer-events-none' }}" data-lp-slide>
		{% if slide.video_url %}
			{% if slide.video_type == 'youtube' %}
			<iframe src="{{ slide.video_url }}" class="absolute inset-0 w-full h-full" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
			{% else %}
			<video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline><source src="{{ slide.video_url }}" /></video>
			{% endif %}
		{% elseif slide.image %}
		<img src="{{ slide.image }}" alt="{{ slide.title }}" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
		{% endif %}
		<div class="absolute inset-0 bg-gradient-to-r from-gray-900/80 via-gray-900/40 to-transparent"></div>
		<div class="relative h-full flex flex-col justify-center px-6 sm:px-12 py-10 max-w-2xl
			{% if slide.content_position == 'center' %}mx-auto items-center text-center{% elseif slide.content_position == 'right' %}ml-auto items-end text-right{% endif %}">
			{% if slide.title %}
			<h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-3">{{ slide.title }}</h2>
			{% endif %}
			{% if slide.subtitle %}
			<p class="text-sm sm:text-base text-white/85 mb-5">{{ slide.subtitle }}</p>
			{% endif %}
			{% if slide.primary_btn_text and slide.link %}
			<a href="{{ slide.link }}" class="inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-bold"
				style="background-color: {{ slide.primary_btn_color }};color: {{ slide.btn_text_color }}">{{ slide.primary_btn_text }}</a>
			{% endif %}
		</div>
	</div>
	{% endfor %}

	{% if slides|length > 1 %}
	{% if show_arrows %}
	<button type="button" class="absolute left-3 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-white/85 hover:bg-white flex items-center justify-center text-gray-800" data-lp-banner-prev aria-label="{{ texts.text_previous|default('Previous') }}"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
	<button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-white/85 hover:bg-white flex items-center justify-center text-gray-800" data-lp-banner-next aria-label="{{ texts.text_next|default('Next') }}"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
	{% endif %}
	<div class="absolute bottom-3 inset-x-0 z-10 flex justify-center gap-1.5">
		{% for slide in slides %}
		<button type="button" class="w-2 h-2 rounded-full {{ loop.first ? 'bg-white' : 'bg-white/40' }}" data-lp-banner-dot="{{ loop.index0 }}" aria-label="{{ loop.index }}"></button>
		{% endfor %}
	</div>
	{% endif %}
</div>
{% endif %}
