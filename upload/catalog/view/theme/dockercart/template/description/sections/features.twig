{# Advanced Description: highlight cards with icons (features). #}
{% set cols = section.settings.columns == '4' ? 'lg:grid-cols-4' : (section.settings.columns == '3' ? 'lg:grid-cols-3' : '') %}
{% if section.content.heading %}
<h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 leading-tight mb-6">{{ section.content.heading|escape }}</h2>
{% endif %}
<div class="grid grid-cols-1 sm:grid-cols-2 {{ cols }} gap-4">
	{% for row in section.rows %}
	{% if row.title or row.text %}
	<div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
		<span class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 inline-flex items-center justify-center mb-3">
			<i data-lucide="{{ row.icon }}" class="w-5 h-5"></i>
		</span>
		{% if row.title %}
		<h3 class="text-sm font-bold text-gray-900 mb-1">{{ row.title|escape }}</h3>
		{% endif %}
		{% if row.text %}
		<p class="text-sm text-gray-600 leading-relaxed">{{ row.text|escape|nl2br }}</p>
		{% endif %}
	</div>
	{% endif %}
	{% endfor %}
</div>
