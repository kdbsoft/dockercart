{# Advanced Description: image tiles (gallery / lookbook). #}
{% set cols = section.settings.columns == '4' ? 'lg:grid-cols-4' : (section.settings.columns == '2' ? '' : 'lg:grid-cols-3') %}
<div class="grid grid-cols-1 sm:grid-cols-2 {{ cols }} gap-4">
	{% for row in section.rows %}
	{% if row.image %}
	<figure class="overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-sm">
		<img src="{{ row.image_url }}" alt="{{ row.caption|escape }}" loading="lazy" class="w-full aspect-square object-cover" />
		{% if row.caption %}
		<figcaption class="px-4 py-3 text-xs font-semibold text-gray-500">{{ row.caption|escape }}</figcaption>
		{% endif %}
	</figure>
	{% endif %}
	{% endfor %}
</div>
