{# Advanced Description: value/label number cards (stats). #}
{% set cols = section.settings.columns == '4' ? 'lg:grid-cols-4' : (section.settings.columns == '2' ? '' : 'lg:grid-cols-3') %}
<div class="grid grid-cols-1 sm:grid-cols-2 {{ cols }} gap-4">
	{% for row in section.rows %}
	{% if row.value or row.label %}
	<div class="rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-sm">
		{% if row.value %}
		<p class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-none">{{ row.value|escape }}</p>
		{% endif %}
		{% if row.label %}
		<p class="mt-2 text-xs font-bold uppercase tracking-widest text-gray-400">{{ row.label|escape }}</p>
		{% endif %}
	</div>
	{% endif %}
	{% endfor %}
</div>
