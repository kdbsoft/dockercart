{% include 'dockercart/template/mail/partials/_head.twig' %}
{% include 'dockercart/template/mail/partials/_header.twig' %}
        <tr>
          <td class="ec-px" style="padding: 8px 32px 24px;">
            <p style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">A new comment has been posted on your blog post:</p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
              <tbody>
                {% if post_name %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">Post:</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ post_name }}</td>
                </tr>
                {% endif %}
                {% if author %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">Author:</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ author }}</td>
                </tr>
                {% endif %}
                {% if author_email %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">Email:</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ author_email }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
            {% if comment_text %}
            <br>
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="border-left: 3px solid #4f46e5; padding: 2px 0 2px 16px;">
                  <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">Comment</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ comment_text }}</p>
                </td>
              </tr>
            </table>
            {% endif %}
          </td>
        </tr>
        {% if post_url %}
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            {% include 'dockercart/template/mail/partials/_button.twig' with {href: post_url, label: 'View post'} %}
          </td>
        </tr>
        {% endif %}
{% include 'dockercart/template/mail/partials/_footer.twig' %}
