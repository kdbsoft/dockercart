{% include 'dockercart/template/mail/partials/_head.twig' %}
{% include 'dockercart/template/mail/partials/_header.twig' %}
        <tr>
          <td class="ec-px" style="padding: 8px 32px 8px;">
            <h1 class="ec-h1" style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 22px; line-height: 30px; font-weight: 700; color: #111827;">{{ text_order_detail }} #{{ order_id }}</h1>
            <p style="margin: 0 0 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">{{ text_greeting }}</p>
            {% if customer_id %}
            {% include 'dockercart/template/mail/partials/_button.twig' with {href: link, label: text_button_order|default(text_link)} %}
            <p style="margin: 0 0 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #9ca3af;"><a href="{{ link }}" style="color: #4f46e5; text-decoration: none;">{{ link }}</a></p>
            {% endif %}
            {% if download %}
            <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">{{ text_download }}</p>
            {% include 'dockercart/template/mail/partials/_button.twig' with {href: download, label: text_button_download|default(text_download)} %}
            {% endif %}
          </td>
        </tr>
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: separate; border-spacing: 0; background-color: #f9fafb; border-radius: 6px;">
              <tr>
                <td class="ec-px ec-stack" width="50%" style="padding: 16px 20px; vertical-align: top;">
                  <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_order_id }}</span> {{ order_id }}</p>
                  <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_date_added }}</span> {{ date_added }}</p>
                  <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_payment_method }}</span> {{ payment_method }}</p>
                  {% if shipping_method %}
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_shipping_method }}</span> {{ shipping_method }}</p>
                  {% endif %}
                </td>
                <td class="ec-px ec-stack" width="50%" style="padding: 16px 20px; vertical-align: top;">
                  <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_email }}</span> {{ email }}</p>
                  {% if telephone %}
                  <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_telephone }}</span> {{ telephone }}</p>
                  {% endif %}
                  <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_ip }}</span> {{ ip }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_order_status }}</span> <span style="display: inline-block; padding: 2px 10px; background-color: #eef2ff; border-radius: 999px; font-size: 12px; line-height: 18px; font-weight: 600; color: #4338ca;">{{ order_status }}</span></p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% if comment %}
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="border-left: 3px solid #4f46e5; padding: 2px 0 2px 16px;">
                  <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">{{ text_instruction }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ comment }}</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td class="ec-stack" width="50%" style="padding: 0 12px 0 0; vertical-align: top;">
                  <p style="margin: 0 0 8px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">{{ text_payment_address }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ payment_address }}</p>
                </td>
                {% if shipping_address %}
                <td class="ec-stack" width="50%" style="padding: 0 0 0 12px; vertical-align: top;">
                  <p style="margin: 0 0 8px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">{{ text_shipping_address }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ shipping_address }}</p>
                </td>
                {% endif %}
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr>
                  <th align="left" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: left;">{{ text_product }}</th>
                  <th align="left" class="ec-hide-sm" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: left;">{{ text_model }}</th>
                  <th align="right" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: right;">{{ text_quantity }}</th>
                  <th align="right" class="ec-hide-sm" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: right;">{{ text_price }}</th>
                  <th align="left" class="ec-hide-sm" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: left;">{{ text_pickup_warehouse }}</th>
                  <th align="right" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: right;">{{ text_total }}</th>
                </tr>
              </thead>
              <tbody>
                {% for product in products %}
                <tr>
                  <td style="padding: 14px 8px 14px 0; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">{{ product.name }}
                    {% for option in product.option %}
                    <br><span style="font-size: 12px; line-height: 18px; color: #6b7280;">{{ option.name }}: {{ option.value }}</span>
                    {% endfor %}
                  </td>
                  <td class="ec-hide-sm" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280;">{{ product.model }}</td>
                  <td align="right" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #374151; text-align: right;">{{ product.quantity }}</td>
                  <td align="right" class="ec-hide-sm" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #374151; text-align: right;">{{ product.price }}</td>
                  <td class="ec-hide-sm" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280;">{% if product.warehouse %}{{ product.warehouse }}<br>{% endif %}{% if product.estimate_date %}<span style="font-size: 12px; line-height: 18px; color: #9ca3af;">{{ text_estimate }} {{ product.estimate_date }}</span>{% endif %}</td>
                  <td align="right" style="padding: 14px 0 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827; text-align: right;">{{ product.total }}</td>
                </tr>
                {% endfor %}
                {% for voucher in vouchers %}
                <tr>
                  <td style="padding: 14px 8px 14px 0; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">{{ voucher.description }}</td>
                  <td class="ec-hide-sm" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb;"></td>
                  <td align="right" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #374151; text-align: right;">1</td>
                  <td align="right" class="ec-hide-sm" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #374151; text-align: right;">{{ voucher.amount }}</td>
                  <td class="ec-hide-sm" style="padding: 14px 8px; border-bottom: 1px solid #e5e7eb;"></td>
                  <td align="right" style="padding: 14px 0 14px 8px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827; text-align: right;">{{ voucher.amount }}</td>
                </tr>
                {% endfor %}
              </tbody>
              <tfoot>
                {% for total in totals %}
                <tr>
                  <td colspan="5" align="right" style="padding: 8px 0; border-bottom: {% if loop.last %}none{% else %}1px solid #f3f4f6{% endif %}; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: {% if loop.last %}15px{% else %}14px{% endif %}; line-height: 22px; {% if loop.last %}font-weight: 700; color: #111827;{% else %}color: #6b7280;{% endif %} text-align: right;">{{ total.title }}</td>
                  <td align="right" style="padding: 8px 0; border-bottom: {% if loop.last %}none{% else %}1px solid #f3f4f6{% endif %}; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: {% if loop.last %}15px{% else %}14px{% endif %}; line-height: 22px; {% if loop.last %}font-weight: 700; color: #111827;{% else %}color: #374151;{% endif %} text-align: right;">{{ total.text }}</td>
                </tr>
                {% endfor %}
              </tfoot>
            </table>
          </td>
        </tr>
        <tr>
          <td class="ec-px" style="padding: 0 32px 8px;">
            <p style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #6b7280;">{{ text_footer }}</p>
          </td>
        </tr>
{% include 'dockercart/template/mail/partials/_footer.twig' %}
