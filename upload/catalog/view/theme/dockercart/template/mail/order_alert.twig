{% include 'dockercart/template/mail/partials/_head.twig' %}
{% include 'dockercart/template/mail/partials/_header.twig' %}
        <tr>
          <td class="ec-px" style="padding: 8px 32px 24px;">
            <p style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">{{ text_received }}</p>
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: separate; border-spacing: 0; background-color: #f9fafb; border-radius: 6px;">
              <tr>
                <td style="padding: 14px 20px;">
                  <p style="margin: 0 0 8px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_order_id }}</span> {{ order_id }} &nbsp;&middot;&nbsp; <span style="color: #6b7280;">{{ text_date_added }}</span> {{ date_added }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #374151;"><span style="color: #6b7280;">{{ text_order_status }}</span> <span style="display: inline-block; padding: 2px 10px; background-color: #eef2ff; border-radius: 999px; font-size: 12px; line-height: 18px; font-weight: 600; color: #4338ca;">{{ order_status }}</span></p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr>
                  <th align="left" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: left;">{{ text_product }}</th>
                  <th align="right" style="padding: 0 0 10px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; text-align: right;">{{ text_total }}</th>
                </tr>
              </thead>
              <tbody>
                {% for product in products %}
                <tr>
                  <td style="padding: 12px 8px 12px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">{{ product.quantity }} &times; {{ product.name }}
                    {% if product.option %}
                    {% for option in product.option %}
                    <br><span style="font-size: 12px; line-height: 18px; color: #6b7280;">{{ option.name }}: {{ option.value }}</span>
                    {% endfor %}
                    {% endif %}
                  </td>
                  <td align="right" style="padding: 12px 0 12px 8px; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827; text-align: right;">{{ product.total }}</td>
                </tr>
                {% endfor %}
                {% for voucher in vouchers %}
                <tr>
                  <td style="padding: 12px 8px 12px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">1 &times; {{ voucher.description }}</td>
                  <td align="right" style="padding: 12px 0 12px 8px; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827; text-align: right;">{{ voucher.amount }}</td>
                </tr>
                {% endfor %}
              </tbody>
              <tfoot>
                {% for total in totals %}
                <tr>
                  <td align="right" style="padding: 6px 8px 6px 0; border-bottom: {% if loop.last %}none{% else %}1px solid #f3f4f6{% endif %}; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: {% if loop.last %}15px{% else %}14px{% endif %}; line-height: 22px; {% if loop.last %}font-weight: 700; color: #111827;{% else %}color: #6b7280;{% endif %} text-align: right;">{{ total.title }}</td>
                  <td align="right" style="padding: 6px 0 6px 8px; border-bottom: {% if loop.last %}none{% else %}1px solid #f3f4f6{% endif %}; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: {% if loop.last %}15px{% else %}14px{% endif %}; line-height: 22px; {% if loop.last %}font-weight: 700; color: #111827;{% else %}color: #374151;{% endif %} text-align: right;">{{ total.value }}</td>
                </tr>
                {% endfor %}
              </tfoot>
            </table>
          </td>
        </tr>
        {% if comment %}
        <tr>
          <td class="ec-px" style="padding: 0 32px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="border-left: 3px solid #4f46e5; padding: 2px 0 2px 16px;">
                  <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">{{ text_comment }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ comment }}</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}
{% include 'dockercart/template/mail/partials/_footer.twig' %}
