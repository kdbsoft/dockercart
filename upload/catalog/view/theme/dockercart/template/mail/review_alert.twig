{% include 'dockercart/template/mail/partials/_head.twig' %}
{% include 'dockercart/template/mail/partials/_header.twig' %}
        <tr>
          <td class="ec-px" style="padding: 8px 32px 24px;">
            <p style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">{{ text_waiting }}</p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
              <tbody>
                {% if product_name %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">{{ product_line }}</td>
                </tr>
                {% endif %}
                {% if reviewer_line %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">{{ reviewer_line }}</td>
                </tr>
                {% endif %}
                {% if rating_line %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 21px; color: #111827;">{{ rating_line }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
            {% if review_text %}
            <br>
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="border-left: 3px solid #4f46e5; padding: 2px 0 2px 16px;">
                  <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">{{ text_review }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ review_text }}</p>
                </td>
              </tr>
            </table>
            {% endif %}
          </td>
        </tr>
{% include 'dockercart/template/mail/partials/_footer.twig' %}
