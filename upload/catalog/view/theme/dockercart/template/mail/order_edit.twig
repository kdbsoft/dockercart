{% include 'dockercart/template/mail/partials/_head.twig' %}
{% include 'dockercart/template/mail/partials/_header.twig' %}
        <tr>
          <td class="ec-px" style="padding: 8px 32px 24px;">
            <h1 class="ec-h1" style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 22px; line-height: 30px; font-weight: 700; color: #111827;">{{ text_order_id }} {{ order_id }}</h1>
            <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #9ca3af;">{{ text_date_added }} {{ date_added }}</p>
            <p style="margin: 0 0 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">{{ text_order_status }}</p>
            <p style="margin: 0 0 20px;"><span style="display: inline-block; padding: 4px 14px; background-color: #eef2ff; border-radius: 999px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; font-weight: 600; color: #4338ca;">{{ order_status }}</span></p>
            {% if link %}
            {% include 'dockercart/template/mail/partials/_button.twig' with {href: link, label: text_button_order|default(text_link)} %}
            {% endif %}
            {% if comment %}
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="border-left: 3px solid #4f46e5; padding: 2px 0 2px 16px;">
                  <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b7280;">{{ text_comment }}</p>
                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #374151;">{{ comment }}</p>
                </td>
              </tr>
            </table>
            {% endif %}
          </td>
        </tr>
{% include 'dockercart/template/mail/partials/_footer.twig' %}
