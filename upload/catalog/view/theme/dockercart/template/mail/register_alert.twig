{% include 'dockercart/template/mail/partials/_head.twig' %}
{% include 'dockercart/template/mail/partials/_header.twig' %}
        <tr>
          <td class="ec-px" style="padding: 8px 32px 24px;">
            <p style="margin: 0 0 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 24px; color: #374151;">{{ text_signup }}</p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; border-collapse: collapse;">
              <tbody>
                {% if firstname %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_firstname }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ firstname }}</td>
                </tr>
                {% endif %}
                {% if lastname %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_lastname }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ lastname }}</td>
                </tr>
                {% endif %}
                {% if customer_group %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_customer_group }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ customer_group }}</td>
                </tr>
                {% endif %}
                {% if website %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_website|default('') }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ website }}</td>
                </tr>
                {% endif %}
                {% if company %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_company|default('') }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ company }}</td>
                </tr>
                {% endif %}
                {% if email %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_email }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ email }}</td>
                </tr>
                {% endif %}
                {% if telephone %}
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 13px; line-height: 20px; color: #6b7280; white-space: nowrap;">{{ text_telephone }}</td>
                  <td align="right" style="padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; line-height: 20px; color: #111827; text-align: right;">{{ telephone }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </td>
        </tr>
{% include 'dockercart/template/mail/partials/_footer.twig' %}
