{{ header }}
<main class="bg-gray-50 min-h-screen">

  <section class="bg-gradient-to-br from-gray-900 via-gray-800 to-blue-950 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {% include 'dockercart/template/common/partials/breadcrumbs.twig' with {
        breadcrumbs_class: 'flex flex-wrap items-center gap-2 text-xs text-gray-300 mb-3',
        breadcrumbs_link_class: 'hover:text-white transition',
        breadcrumbs_last_class: 'text-white font-semibold'
      } %}
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">{{ heading_title }}</h1>
    </div>
  </section>

  <section class="py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {{ content_top }}

      {% if success %}
      <div class="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-2xl px-5 py-4 text-sm flex items-center gap-3">
        <i data-lucide="circle-check" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ success }}</span>
      </div>
      {% endif %}

      {% if error_warning %}
      <div class="mb-6 bg-red-50 border border-red-200 text-red-700 rounded-2xl px-5 py-4 text-sm flex items-center gap-3">
        <i data-lucide="circle-alert" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ error_warning }}</span>
      </div>
      {% endif %}

      <div class="flex flex-col lg:flex-row gap-6 items-start">
        <aside class="lg:w-72 flex-shrink-0">
          {{ account_menu }}
        </aside>
        <div class="flex-1 min-w-0">

      <div class="bg-white rounded-3xl border border-gray-100 p-6 sm:p-8 shadow-sm mb-6">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-blue-500">{{ text_api }}</p>
            <p class="text-sm text-gray-500 mt-1">{{ text_api_help }}</p>
          </div>
          <a href="{{ docs }}" class="inline-flex items-center gap-2 border border-gray-200 hover:border-gray-300 bg-white text-gray-700 font-medium px-4 py-2 rounded-xl transition-colors text-sm">
            <i data-lucide="book-open" class="w-4 h-4"></i>
            {{ button_docs }}
          </a>
        </div>

        {% if new_token %}
        <div class="mb-6 bg-amber-50 border border-amber-200 rounded-2xl px-5 py-4">
          <p class="font-semibold text-amber-800 mb-1 flex items-center gap-2"><i data-lucide="key-round" class="w-4 h-4"></i> {{ text_token_once }}</p>
          <p class="text-sm text-amber-700 mb-3">{{ text_token_help }}</p>
          <div class="flex items-center gap-2">
            <input type="text" id="input-new-token" class="flex-1 min-w-0 font-mono text-xs border border-amber-200 rounded-xl px-3 py-2 bg-white" value="{{ new_token }}" readonly="readonly" spellcheck="false" onclick="this.select();" />
            <button type="button" id="button-copy-token" class="border border-gray-200 hover:border-gray-300 bg-white text-gray-700 font-medium px-4 py-2 rounded-xl transition-colors text-sm">{{ button_copy }}</button>
          </div>
          <p class="text-xs text-amber-700 mt-3 font-mono break-all">curl -H "Authorization: Bearer {{ new_token }}" {{ api_base_url }}/orders</p>
        </div>
        {% endif %}

        {% if api_can_add %}
        <form action="{{ action }}" method="post" class="border-t border-gray-100 pt-6">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1" for="input-api-name">{{ entry_name }}</label>
              <input type="text" name="name" id="input-api-name" maxlength="128" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:border-blue-400 focus:ring-0" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1" for="input-api-comment">{{ entry_comment }}</label>
              <input type="text" name="comment" id="input-api-comment" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:border-blue-400 focus:ring-0" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1" for="input-api-expires">{{ entry_expires }}</label>
              <input type="date" name="expires_at" id="input-api-expires" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:border-blue-400 focus:ring-0" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1" for="input-api-ip">{{ entry_ip_allowlist }}</label>
              <input type="text" name="ip_allowlist" id="input-api-ip" placeholder="203.0.113.10" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:border-blue-400 focus:ring-0" />
            </div>
          </div>
          {% if customer_scopes is not empty %}
          <div class="mb-4">
            <label class="block text-xs font-semibold text-gray-600 mb-2">{{ entry_scopes }}</label>
            <div class="flex flex-wrap gap-4">
              {% for scope, label in customer_scopes %}
              <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                <input type="checkbox" name="scopes[]" value="{{ scope }}" class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                {{ label }}
              </label>
              {% endfor %}
            </div>
            <p class="text-xs text-gray-400 mt-2">{{ help_scopes }}</p>
          </div>
          {% endif %}
          <div class="flex justify-end">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm">{{ button_add }}</button>
          </div>
        </form>
        {% else %}
        <div class="border-t border-gray-100 pt-6 text-sm text-gray-500">{{ text_key_limit|replace({'%s': api_max_keys}) }}</div>
        {% endif %}
      </div>

      <div class="bg-white rounded-3xl border border-gray-100 p-6 sm:p-8 shadow-sm">
        {% if api_keys %}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wider text-gray-400 border-b border-gray-100">
                <th class="py-3 pr-4">{{ column_name }}</th>
                <th class="py-3 pr-4">{{ column_prefix }}</th>
                <th class="py-3 pr-4">{{ column_scopes }}</th>
                <th class="py-3 pr-4">{{ column_status }}</th>
                <th class="py-3 pr-4">{{ column_expires }}</th>
                <th class="py-3 pr-4">{{ column_last_used }}</th>
                <th class="py-3 text-right">{{ column_action }}</th>
              </tr>
            </thead>
            <tbody>
              {% for key in api_keys %}
              <tr class="border-b border-gray-50 align-top">
                <td class="py-3 pr-4">
                  <span class="font-semibold text-gray-900">{{ key.name }}</span>
                  {% if key.comment %}<div class="text-xs text-gray-400">{{ key.comment }}</div>{% endif %}
                </td>
                <td class="py-3 pr-4 font-mono text-xs text-gray-500">{{ key.prefix }}…</td>
                <td class="py-3 pr-4 text-xs text-gray-500">
                  {% if key.scopes %}{{ key.scopes|join(', ') }}{% else %}—{% endif %}
                </td>
                <td class="py-3 pr-4">
                  {% if key.status_value and not key.is_expired %}
                  <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">{{ key.status }}</span>
                  {% else %}
                  <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">{{ key.status }}</span>
                  {% endif %}
                  {% if key.is_expired %}<span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700 ml-1">{{ text_expired }}</span>{% endif %}
                </td>
                <td class="py-3 pr-4 text-xs text-gray-500">{{ key.expires_at ? key.expires_at : text_never }}</td>
                <td class="py-3 pr-4 text-xs text-gray-500">{{ key.last_used_at ? key.last_used_at : text_never }}</td>
                <td class="py-3 text-right whitespace-nowrap">
                  <form action="{{ rotate_action }}" method="post" class="inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                    <input type="hidden" name="api_key_id" value="{{ key.api_key_id }}" />
                    <button type="submit" class="text-blue-600 hover:text-blue-700 text-xs font-medium mr-3" data-confirm="{{ text_rotate_confirm }}">{{ button_rotate }}</button>
                  </form>
                  <form action="{{ status_action }}" method="post" class="inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                    <input type="hidden" name="api_key_id" value="{{ key.api_key_id }}" />
                    <input type="hidden" name="status" value="{{ key.status_value ? 0 : 1 }}" />
                    {% if key.status_value %}
                    <button type="submit" class="text-amber-600 hover:text-amber-700 text-xs font-medium mr-3">{{ button_revoke }}</button>
                    {% else %}
                    <button type="submit" class="text-green-600 hover:text-green-700 text-xs font-medium mr-3">{{ button_enable }}</button>
                    {% endif %}
                  </form>
                  <form action="{{ delete_action }}" method="post" class="inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                    <input type="hidden" name="api_key_id" value="{{ key.api_key_id }}" />
                    <button type="submit" class="text-red-600 hover:text-red-700 text-xs font-medium" data-confirm="{{ text_delete_confirm }}">{{ button_delete }}</button>
                  </form>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <p class="text-sm text-gray-500">{{ text_no_keys }}</p>
        {% endif %}
      </div>

        </div>
      </div>

      {{ content_bottom }}
    </div>
  </section>

</main>
<script type="text/javascript"><!--
document.getElementById('button-copy-token')?.addEventListener('click', function () {
	var input = document.getElementById('input-new-token');

	if (input) {
		input.select();
		document.execCommand('copy');
		this.classList.add('border-green-300', 'text-green-700');
	}
});

document.querySelectorAll('[data-confirm]').forEach(function (element) {
	element.addEventListener('click', function (event) {
		if (!confirm(element.getAttribute('data-confirm'))) {
			event.preventDefault();
		}
	});
});
//--></script>
{{ footer }}
