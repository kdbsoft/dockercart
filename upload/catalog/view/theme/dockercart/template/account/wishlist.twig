{{ header }}
<main class="bg-gray-50 min-h-screen">

  <section class="bg-gradient-to-br from-gray-900 via-gray-800 to-blue-950 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {% include 'dockercart/template/common/partials/breadcrumbs.twig' with {
        breadcrumbs_class: 'flex flex-wrap items-center gap-2 text-xs text-gray-300 mb-3',
        breadcrumbs_link_class: 'hover:text-white transition',
        breadcrumbs_last_class: 'text-white font-semibold'
      } %}
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">{{ heading_title }}</h1>
    </div>
  </section>

  <section class="py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {{ content_top }}

      {% if success %}
      <div class="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-2xl px-5 py-4 text-sm flex items-center gap-3">
        <i data-lucide="circle-check" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ success }}</span>
      </div>
      {% endif %}

      <div class="flex flex-col lg:flex-row gap-6 items-start">
        <aside class="lg:w-72 flex-shrink-0">
          {{ account_menu }}
        </aside>
        <div class="flex-1 min-w-0">

      {% if products %}
      <style>
        .dc-star { position: relative; display: inline-block; color: #e5e7eb; line-height: 1; }
        .dc-star.active { color: #f59e0b; }
        .dc-star.dc-star-partial { color: #e5e7eb; }
        .dc-star.dc-star-partial::after { content: '★'; position: absolute; inset: 0; color: #f59e0b; clip-path: inset(0 calc(100% - var(--pct)) 0 0); }
        .dc-rating-number { color: #111827; letter-spacing: -.06em; }
      </style>
      <div class="flex flex-col gap-4 mb-6">
        {% for product in products %}
        <div class="product-card group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-row relative hover:z-30 overflow-visible"
          data-id="{{ product.product_id }}" data-href="{{ product.href }}"
          data-description="{{ product.description }}" data-model="{{ product.model|default('') }}"
          data-in-wishlist="1" data-rating="{{ product.rating|default(0) }}"
          data-stock="{{ product.stock|e('html_attr') }}" data-is-in-stock="{{ product.is_in_stock ? 1 : 0 }}"
          data-minimum="{{ product.minimum|default(1) }}" data-call-for-price="0">
          <div class="relative w-40 sm:w-48 flex-shrink-0 bg-gray-50 overflow-hidden">
            <a href="{{ product.href }}" class="block w-full h-full">
              {% if product.thumb %}
              <img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              {% else %}
              <div class="w-full h-full min-h-[10rem] flex items-center justify-center">
                <i data-lucide="image" class="w-10 h-10 text-gray-300"></i>
              </div>
              {% endif %}
            </a>
            {% if product.has_gift %}
            <span class="absolute top-2 left-2 bg-amber-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md flex items-center gap-1"><i data-lucide="gift" class="w-3 h-3"></i> {{ text_gift_badge|default('GIFT') }}</span>
            {% elseif product.special %}
              {% if product.discount and product.discount > 0 %}
              <span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">-{{ product.discount }}%</span>
              {% else %}
              <span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">{{ text_sale|default('SALE') }}</span>
              {% endif %}
            {% endif %}
            <div class="absolute top-2 right-2">
              <button class="wishlist-btn w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center bg-rose-50 hover:bg-rose-100 transition"
                onclick="dcAddToWishlist('{{ product.product_id }}', this, '{{ product.variant_id|default(0) }}'); event.stopPropagation();"
                aria-label="{{ text_remove_wishlist }}" data-in-wishlist="1">
                <i data-lucide="heart" class="w-3.5 h-3.5 text-rose-500 fill-rose-400"></i>
              </button>
            </div>
            <button class="quick-view-btn absolute bottom-0 left-0 right-0 py-2.5 bg-gray-900/85 hover:bg-blue-600 text-white text-[11px] font-bold uppercase tracking-widest backdrop-blur-sm transition-colors duration-200" onclick="openQuickView && openQuickView({{ product.product_id }}); event.stopPropagation();" aria-label="{{ text_quick_view }}">
              {{ text_quick_view }}
            </button>
          </div>
          <div class="flex-1 p-4 sm:p-5 flex flex-col min-w-0">
            <h3 class="text-sm sm:text-base font-bold text-gray-900 leading-snug mb-1">
              <a href="{{ product.href }}" class="hover:text-blue-600 transition">{{ product.name }}</a>
            </h3>
            {% if product.variant_name %}
            <div class="mb-2 mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">{{ product.variant_name }}</span>
            </div>
            {% endif %}
            {% if product.rating %}
            <div class="flex items-center mb-2">
              <div class="flex items-center">
                {% for i in 1..5 %}
                  {% set diff = product.rating - (i - 1) %}
                  {% if diff >= 1 %}
                    <span class="dc-star active text-xs">★</span>
                  {% elseif diff > 0 %}
                    <span class="dc-star dc-star-partial text-xs" style="--pct: {{ (diff * 100) | round }}%">★</span>
                  {% else %}
                    <span class="dc-star text-xs">★</span>
                  {% endif %}
                {% endfor %}
              </div>
              <span class="text-[10px] text-gray-400 ml-1">{{ review_count_label(product.reviews|default(0)) }}</span>
            </div>
            {% endif %}
            {% if product.description %}
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed mb-3 line-clamp-2">{{ product.description }}</p>
            {% endif %}
            <div class="mt-auto pt-3 flex flex-wrap items-end justify-between gap-3">
              <div class="flex items-baseline gap-1 flex-wrap">
                {% if product.special %}
                <span class="text-lg sm:text-xl font-extrabold text-red-600">{{ product.special }}</span>
                <span class="text-xs text-gray-400 line-through">{{ product.price }}</span>
                {% elseif product.price %}
                <span class="text-lg sm:text-xl font-extrabold text-gray-900">{{ product.price }}</span>
                {% endif %}
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                {% if product.stock %}
                <div class="text-[11px] font-medium {% if product.is_preorder %}text-amber-600{% elseif product.is_in_stock %}text-emerald-600{% else %}text-red-500{% endif %} flex items-center gap-1">
                  {% if product.is_in_stock %}
                  <i data-lucide="check" class="w-3.5 h-3.5"></i>
                  {% endif %}
                  <span>{{ product.stock }}</span>
                </div>
                {% endif %}
                {% if product.is_in_stock %}
                <button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum|default(1) }}', '{{ product.variant_id|default(0) }}');"
                  class="flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition"
                  aria-label="{{ button_cart }}">
                  <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                  {{ button_cart }}
                </button>
                {% endif %}
                <a href="{{ product.remove }}" title="{{ text_remove_wishlist }}"
                  class="flex items-center justify-center w-10 h-10 border border-red-200 hover:border-red-300 text-red-400 hover:text-red-600 rounded-xl transition flex-shrink-0"
                  aria-label="{{ text_remove_wishlist }}">
                  <i data-lucide="x" class="w-4 h-4"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 text-center text-gray-400 text-sm mb-6">
        <i data-lucide="heart" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>
        <p>{{ text_empty }}</p>
      </div>
      {% endif %}

      <div class="flex justify-end">
        <a href="{{ continue }}" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm">
          {{ button_continue }}
        </a>
      </div>

        </div>
      </div>

      {{ content_bottom }}
    </div>
  </section>

</main>
{{ footer }}
