{{ header }}
<main class="bg-gray-50 min-h-screen">

  <section class="bg-gradient-to-br from-gray-900 via-gray-800 to-blue-950 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {% include 'dockercart/template/common/partials/breadcrumbs.twig' with {
        breadcrumbs_class: 'flex flex-wrap items-center gap-2 text-xs text-gray-300 mb-3',
        breadcrumbs_link_class: 'hover:text-white transition',
        breadcrumbs_last_class: 'text-white font-semibold'
      } %}
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">{{ heading_title }}</h1>
    </div>
  </section>

  <section class="py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {{ content_top }}

      <div class="flex flex-col lg:flex-row gap-6 items-start">
        <aside class="lg:w-72 flex-shrink-0">
          {{ account_menu }}
        </aside>
        <div class="flex-1 min-w-0">

      {% if products %}
      <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-4 sm:p-6 mb-6 min-w-0">
        <div class="flex flex-col gap-3 min-w-0">
          {% for product in products %}
          <div class="product-card group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-blue-200 transition-all duration-300 flex items-stretch overflow-hidden cursor-pointer min-w-0"
               data-id="{{ product.product_id }}" data-href="{{ product.href }}"
               onclick="window.location.href = '{{ product.href|e('js') }}';">
            <a href="{{ product.href }}" class="w-[100px] flex-shrink-0 bg-gray-50 overflow-hidden block" aria-label="{{ product.name }}" onclick="event.stopPropagation();">
              <img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </a>
            <div class="flex-1 min-w-0 p-3 sm:p-4 flex flex-col justify-center">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-gray-400 min-w-0">
                  <i data-lucide="clock" class="w-3.5 h-3.5 flex-shrink-0"></i>
                  <span class="break-words">{{ text_viewed_on }} {{ product.date_viewed }}</span>
                </span>
                {% if product.special and product.discount > 0 %}
                <span class="bg-red-500 text-white px-1.5 py-0.5 rounded-lg text-[10px] font-bold flex-shrink-0">-{{ product.discount }}%</span>
                {% endif %}
              </div>
              <h3 class="text-sm font-bold text-gray-900 leading-snug mb-1 break-words">
                <a href="{{ product.href }}" class="hover:text-blue-600 transition" onclick="event.stopPropagation();">{{ product.name }}</a>
              </h3>
              {% if product.rating %}
              <div class="flex items-center gap-1 mb-1">
                <div class="flex text-xs">
                  {% for i in 1..5 %}
                    {% if product.rating >= i %}
                    <span class="text-amber-400">★</span>
                    {% else %}
                    <span class="text-gray-300">★</span>
                    {% endif %}
                  {% endfor %}
                </div>
                {% if product.reviews %}<span class="text-[10px] text-gray-400 ml-1">{{ review_count_label(product.reviews) }}</span>{% endif %}
              </div>
              {% endif %}
              <div class="flex flex-wrap items-center justify-between gap-2">
                {% set cfp = (product.call_for_price is defined and product.call_for_price) or ((call_for_price_status is defined and call_for_price_status) and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) %}
                <div class="flex items-baseline gap-1 flex-wrap">
                  {% if cfp %}
                  {% if call_for_price_mode is defined and call_for_price_mode == 'call' %}
                  <a href="tel:{{ call_for_price_phone }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 transition shadow-sm" onclick="event.stopPropagation();">
                    <i data-lucide="phone" class="w-3.5 h-3.5"></i>
                    {{ text_call_for_price|default('Contact for price') }}
                  </a>
                  {% else %}
                  <button type="button" class="dc-cfp-request-btn inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 transition shadow-sm" data-dc-cfp-request data-product-id="{{ product.product_id }}">
                    <i data-lucide="message-circle-question" class="w-3.5 h-3.5"></i>
                    {{ text_call_for_price_request|default('Request price') }}
                  </button>
                  {% endif %}
                  {% elseif product.price %}
                  {% if product.special %}
                  <span class="text-base font-extrabold text-gray-900">{{ product.special }}</span>
                  <span class="text-xs text-red-400 line-through ml-1">{{ product.price }}</span>
                  {% else %}
                  <span class="text-base font-extrabold text-gray-900">{{ product.price }}</span>
                  {% endif %}
                  {% endif %}
                </div>
                {% if product.stock %}
                <div class="text-[11px] font-medium {% if product.is_preorder %}text-amber-600{% elseif product.is_in_stock %}text-emerald-600{% else %}text-red-500{% endif %} flex items-center gap-1">
                  {% if product.is_in_stock %}<i data-lucide="check" class="w-3.5 h-3.5"></i>{% endif %}
                  <span>{{ product.stock }}</span>
                </div>
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 text-center text-gray-400 text-sm mb-6">
        <i data-lucide="rotate-ccw-clock" class="w-8 h-8 mx-auto mb-2 opacity-30"></i>
        <p>{{ text_empty }}</p>
      </div>
      {% endif %}

      <div class="flex justify-end">
        <a href="{{ continue }}" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm">
          {{ button_continue }}
        </a>
      </div>

        </div>
      </div>

      {{ content_bottom }}
    </div>
  </section>

</main>
{{ footer }}
