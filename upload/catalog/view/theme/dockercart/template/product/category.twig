{{ header }}

<main class="bg-white min-h-screen">

    <section class="relative">
      <div class="absolute inset-0 {% if background_image %}bg-cover bg-center{% else %}bg-gradient-to-br from-gray-900 via-gray-800 to-blue-950{% endif %}"{% if background_image %} style="background-image: url('{{ background_image }}');"{% endif %}></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-black/15"></div>
      <div class="relative z-10 py-12 sm:py-14 px-4 sm:px-6 lg:px-8 flex items-center">
        <div class="max-w-7xl mx-auto w-full">
          {% include 'dockercart/template/common/partials/breadcrumbs.twig' with {
            breadcrumbs_class: 'flex flex-wrap items-center gap-2 text-xs text-gray-300 mb-3',
            breadcrumbs_link_class: 'hover:text-white transition',
            breadcrumbs_last_class: 'text-white font-semibold'
          } %}
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">{{ heading_title }}</h1>
        </div>
      </div>
    </section>

  {% if categories and show_refine %}
  <section class="pt-8 pb-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="bg-white border border-gray-100 rounded-3xl p-5 sm:p-6 shadow-sm">
        {% set last_breadcrumb = breadcrumbs|last %}
            <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
          <div>
            <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-blue-500"><span class="w-4 h-px bg-blue-300"></span>{{ text_refine }}</p>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 mt-1">{{ text_subcategories }}</h2>
            {% if parent_href %}
            <a href="{{ parent_href }}" class="inline-flex items-center gap-1 text-sm text-blue-600 hover:underline mt-1">
              <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> {{ text_back_to|format(parent_category_name) }}
            </a>
            {% endif %}
          </div>
          {% if show_shop_all %}<a href="{{ shop_all_href }}" class="text-sm font-semibold text-blue-600 hover:underline">{{ text_shop_all|format(original_category_name) }}</a>{% endif %}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
          {% for category in categories %}
          <a href="{{ category.href }}" class="group subcategory-card rounded-2xl p-4 bg-white border border-gray-200 hover:border-blue-200 hover:shadow-md transition">
            <div class="flex items-center gap-3">
              <div class="w-14 h-14 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                {% if category.thumb %}
                <img src="{{ category.thumb }}" alt="{{ category.name }}" class="w-10 h-10 object-cover rounded-md" loading="lazy" />
                {% else %}
                <i data-lucide="layers" class="w-6 h-6 text-blue-500"></i>
                {% endif %}
              </div>
              <div class="flex-1 min-w-0">
                <span class="block text-sm font-semibold text-gray-900 leading-tight break-words">{{ category.name }}</span>
                {% if category.total is defined and category.total > 0 %}
                <span class="text-xs text-gray-500">{{ category.product_label }}</span>
                {% endif %}
              </div>
              <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            </div>
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% elseif parent_href %}
  <div class="px-4 sm:px-6 lg:px-8 pt-8 pb-2">
    <div class="max-w-7xl mx-auto">
      <a href="{{ parent_href }}" class="inline-flex items-center gap-1.5 text-sm text-blue-600 hover:text-blue-800 font-medium">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> {{ text_back_to|format(parent_category_name) }}
      </a>
    </div>
  </div>
  {% endif %}

  {% if related_categories %}
  <section class="pt-8 pb-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="bg-white border border-gray-100 rounded-3xl p-5 sm:p-6 shadow-sm">
        <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-blue-500 mb-1"><span class="w-4 h-px bg-blue-300"></span>{{ text_related_categories }}</p>
        <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 mt-1 mb-4">{{ text_you_may_also_like }}</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {% for related in related_categories %}
          <a href="{{ related.href }}" class="group flex flex-col items-center text-center p-3 rounded-2xl hover:bg-gray-50 transition">
            <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-2 overflow-hidden">
              {% if related.thumb %}
                <img src="{{ related.thumb }}" alt="{{ related.name }}" class="w-full h-full object-cover" loading="lazy" />
              {% else %}
                <i data-lucide="folder" class="w-6 h-6 text-gray-400"></i>
              {% endif %}
            </div>
            <span class="text-xs font-semibold text-gray-700 group-hover:text-blue-600 transition">{{ related.name }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <section id="catalog" class="py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      {{ content_top }}

      <div class="{% if column_left and column_right %}grid grid-cols-1 lg:grid-cols-[280px,1fr,280px] gap-6{% elseif column_left or column_right %}grid grid-cols-1 lg:grid-cols-[280px,1fr] gap-6{% endif %}">
        {% if column_left %}
        <aside class="hidden lg:block">
          {{ column_left }}
        </aside>
        {% endif %}

        <div>
          {% if products %}
          {% include 'dockercart/template/common/partials/listing_toolbar.twig' with {
            toolbar_id: 'category-toolbar',
            toolbar_variant: 'gray',
            listing_count: text_products,
            text_sort: text_sort,
            text_limit: text_limit,
            sorts: sorts,
            limits: limits,
            sort: sort,
            order: order,
            limit: limit,
            view_mode: view_mode,
            text_view_grid: text_view_grid,
            text_view_list: text_view_list,
            text_view_table: text_view_table
          } %}

          <div id="dc-product-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 mb-8 dc-view-{{ view_mode|default('grid') }}">
            {% for product in products %}
            {% include 'dockercart/template/product/product_card.twig' with {
              product: product,
              view_mode: view_mode|default('grid'),
              text_quick_view: text_quick_view,
              text_reviews: text_reviews,
              text_sale: text_sale|default(''),
              text_gift_badge: text_gift_badge|default('GIFT'),
              text_price_from: text_price_from|default(''),
              button_cart: button_cart,
              btn_quick_hover: 'hover:bg-blue-600',
              link_hover: 'hover:text-blue-600 transition',
              btn_cart_classes: 'bg-blue-600 text-white hover:bg-blue-700',
              show_distribution: show_distribution|default(0),
              text_all_reviews: text_all_reviews|default('')
            } %}
            {% if category_banner and banner_position == loop.index %}
            <div class="category-banner category-banner--{{ category_banner.content_position|default('left') }} category-banner__stretched" style="--category-banner-accent: {{ category_banner.accent_color|default('transparent')|e('html_attr') }}; --category-banner-button-text: {{ category_banner.badge_text_color|default('#ffffff')|e('html_attr') }};">
              <div class="category-banner__media">
                {% if category_banner.image_portrait %}
                <picture>
                  <source media="(orientation: portrait)" srcset="{{ category_banner.image_portrait }}" />
                  <img src="{{ category_banner.image }}" alt="{{ category_banner.title|e('html_attr') }}" loading="lazy" />
                </picture>
                {% elseif category_banner.image %}
                <img src="{{ category_banner.image }}" alt="{{ category_banner.title|e('html_attr') }}" loading="lazy" />
                {% endif %}
                {% if category_banner.title_html or category_banner.subtitle or category_banner.accent_text or category_banner.primary_btn_text %}
                <div class="category-banner__overlay category-banner__overlay--{{ category_banner.content_position|default('left') }}">
                  <div class="category-banner__content">
                    {% if category_banner.accent_text %}
                    <span class="category-banner__badge"{% if category_banner.accent_color or category_banner.accent_bg %} style="{% if category_banner.accent_color %}background-color: {{ category_banner.accent_color }};{% endif %}{% if category_banner.accent_bg %} --accent-bg: {{ category_banner.accent_bg }};{% endif %} color: {{ category_banner.badge_text_color }};"{% endif %}>{{ category_banner.accent_text }}</span>
                    {% endif %}
                    {% if category_banner.title_html %}
                    <h2 class="category-banner__title">{{ category_banner.title_html|raw }}</h2>
                    {% endif %}
                    {% if category_banner.subtitle %}
                    <p class="category-banner__subtitle">{{ category_banner.subtitle }}</p>
                    {% endif %}
                    {% if category_banner.primary_btn_text %}
                    {% set banner_btn_style = category_banner.accent_color ? ' style="--category-banner-accent: ' ~ category_banner.accent_color ~ '; color: ' ~ category_banner.badge_text_color ~ ';"' : '' %}
                    {% if category_banner.link %}<a href="{{ category_banner.link }}" class="category-banner__btn category-banner__btn--primary"{{ banner_btn_style|raw }}>{{ category_banner.primary_btn_text }}</a>{% else %}<span class="category-banner__btn category-banner__btn--primary"{{ banner_btn_style|raw }}>{{ category_banner.primary_btn_text }}</span>{% endif %}
                    {% endif %}
                  </div>
                </div>
                {% endif %}
              </div>
              {% if category_banner.link %}<a href="{{ category_banner.link }}" class="category-banner__stretched-link" aria-label="{{ category_banner.title|default('')|e('html_attr') }}"></a>{% endif %}
            </div>
            {% endif %}
            {% endfor %}
          </div>

          {% if has_more %}
          <div class="dc-load-more-wrap mt-6 flex flex-col items-center gap-2">
            <button class="dc-load-more-btn inline-flex items-center gap-2 px-7 py-3 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow transition"
              data-url="{{ load_more_url }}"
              data-page="{{ page + 1 }}"
              data-total="{{ product_total }}"
              data-loaded="{{ products_loaded }}">
              <i data-lucide="chevron-down" class="w-4 h-4"></i>
              {{ text_load_more }}
              <span class="dc-lm-count text-xs font-normal opacity-70">({{ products_loaded }} / {{ product_total }})</span>
            </button>
          </div>
          {% endif %}

          {% if pagination %}
          <div class="mt-8 flex items-center justify-center">
            <div class="dc-pagination">{{ pagination }}</div>
          </div>
          {% endif %}

          {% else %}
          <div class="flex flex-col items-center justify-center py-24 text-center">
            <i data-lucide="search-x" class="w-16 h-16 text-gray-200 mb-4"></i>
            <p class="text-lg font-semibold text-gray-500">{{ text_empty }}</p>
            <a href="{{ continue }}" class="mt-6 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl transition">
              {{ button_continue }}
            </a>
          </div>
          {% endif %}

          {% if description %}
          <div class="mt-10 bg-gray-50 border border-gray-100 rounded-3xl p-6 sm:p-8">
            <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-gray-400 mb-2"><span class="w-4 h-px bg-gray-300"></span>{{ text_category_description }}</p>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 leading-tight mb-4">{{ heading_title }}</h2>
            <div class="prose prose-lg sm:prose-lg max-w-none
              prose-headings:font-extrabold prose-headings:text-gray-900
              prose-p:text-gray-600 prose-p:leading-relaxed
              prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
              prose-img:rounded-2xl prose-img:border prose-img:border-gray-100">
              {{ description }}
            </div>

            {% if category_features %}
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-{{ category_features|length > 1 ? '2' : '1' }} lg:grid-cols-{{ category_features|length > 2 ? '3' : (category_features|length > 1 ? '2' : '1') }} gap-3">
              {% for feature in category_features %}
              <div class="rounded-2xl border border-gray-200 bg-white p-4">
                <p class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-1 flex items-center gap-1.5">
                  <i data-lucide="{{ feature.icon|default('truck') }}" class="w-3.5 h-3.5"></i>
                  {{ feature.title }}
                </p>
                {% if feature.text %}
                <p class="text-sm font-semibold text-gray-900">{{ feature.text }}</p>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endif %}
        </div>

        {% if column_right %}
        <aside class="hidden lg:block">
          <div class="bg-white border border-gray-100 rounded-3xl p-5 h-fit shadow-sm">
            {{ column_right }}
          </div>
        </aside>
        {% endif %}
      </div>

      {{ content_bottom }}
    </div>
  </section>

</main>

<style>
  .category-banner { position: relative; min-width: 0; overflow: hidden; border-radius: 24px; background: #111827; }
  .category-banner__media, .category-banner__link, .category-banner__media picture { position: relative; display: block; width: 100%; height: 100%; }
  .category-banner__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .category-banner__stretched-link { position: absolute; inset: 0; z-index: 2; display: block; text-decoration: none; }
  .category-banner__btn { position: relative; z-index: 3; }
  .category-banner__link { color: inherit; text-decoration: none; }
  .category-banner__overlay { position: absolute !important; inset: 0 !important; display: flex !important; align-items: center; pointer-events: none; background: linear-gradient(to right, rgba(0,0,0,.82) 0%, rgba(0,0,0,.46) 38%, rgba(0,0,0,.12) 72%, transparent 100%) !important; }
  .category-banner__overlay--left { justify-content: flex-start; }
  .category-banner__overlay--center { justify-content: center; background: linear-gradient(to right, rgba(0,0,0,.18), rgba(0,0,0,.52), rgba(0,0,0,.18)); }
  .category-banner__overlay--right { justify-content: flex-end; background: linear-gradient(to left, rgba(0,0,0,.82) 0%, rgba(0,0,0,.46) 38%, rgba(0,0,0,.12) 72%, transparent 100%); }
  .category-banner__content { width: 100%; padding: 1.25rem 1rem; box-sizing: border-box; color: #fff; text-align: left; pointer-events: auto; }
  .category-banner__overlay--center .category-banner__content { text-align: center; }
  .category-banner__overlay--right .category-banner__content { text-align: right; }
  .category-banner__badge { display: inline-block; margin-bottom: .625rem; padding: .25rem .5rem; border-radius: .5rem; font-size: .6875rem; font-weight: 700; }
  .category-banner__title { margin: 0 0 .5rem; color: #fff !important; font-size: 1.25rem; font-weight: 800; line-height: 1.2; }
  .category-banner__subtitle { margin: 0 0 .75rem; color: #fff !important; font-size: .875rem; line-height: 1.45; opacity: .95; }
  .category-banner__btn { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--category-banner-accent, transparent) !important; border-radius: .75rem; padding: .5rem .85rem; background: var(--category-banner-accent, transparent) !important; color: var(--category-banner-button-text, #fff) !important; font-size: .8125rem; font-weight: 700; line-height: 1.2; }
  .category-banner__link:focus-visible { outline: 3px solid color-mix(in srgb, var(--category-banner-accent, transparent) 55%, #fff); outline-offset: -3px; }
  .wishlist-btn { opacity: 0; transform: translateY(-4px) scale(.92); transition: opacity .18s ease, transform .18s ease, box-shadow .18s ease; }
  .product-card:hover .wishlist-btn { opacity: 1; transform: translateY(0) scale(1); }
  .wishlist-btn:focus-visible, .wishlist-btn.bg-rose-50 { opacity: 1; transform: translateY(0) scale(1); }

  .product-card:hover .quick-view-btn { opacity: 1 !important; transform: translateY(0) !important; }
  .quick-view-btn { opacity: 0; transform: translateY(100%); transition: opacity 0.25s ease, transform 0.25s ease; }

  .dc-pagination ul { display:flex; gap:.5rem; list-style:none; padding:0; margin:0; flex-wrap:wrap; justify-content:center; }
  .dc-pagination ul li a,
  .dc-pagination ul li span {
    display:inline-flex; align-items:center; justify-content:center;
    width:2.25rem; height:2.25rem; padding:0;
    border-radius:.75rem; border:1px solid #e5e7eb;
    font-size:.875rem; font-weight:500; color:#6b7280;
    background:#fff; text-decoration:none; transition:all .15s ease;
  }
  .dc-pagination ul li a:hover { border-color:#93c5fd; color:#2563eb; }
  .dc-pagination ul li.active span,
  .dc-pagination ul li.active a { background:#2563eb; border-color:#2563eb; color:#fff; }

  /* Subcategory card visuals */
  .subcategory-card { overflow: hidden; }
  .subcategory-card img { transition: transform .35s ease; }
  .subcategory-card:hover img { transform: scale(1.07) translateY(-2px); }
  .subcategory-card:hover { box-shadow: 0 10px 30px rgba(2,6,23,0.08); }
</style>

{% include 'dockercart/template/common/partials/schema_item_list.twig' %}

{{ footer }}
