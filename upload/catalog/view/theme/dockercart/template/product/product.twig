<script src="catalog/view/javascript/glightbox/glightbox.min.js"></script>

<script type="text/javascript">
/* ── Qty stepper ───────────────────────────────────────── */
var dcMinQty = {{ minimum is defined ? minimum : 1 }};
var dcStepQty = {{ quantity_step is defined ? quantity_step : 1 }};

if (!dcMinQty || dcMinQty <= 0) dcMinQty = 1;
if (!dcStepQty || dcStepQty <= 0) dcStepQty = 1;

function dcFormatQty(value) {
  var fixed = (Math.round(value * 100) / 100).toFixed(2);
  return fixed.replace(/\.00$/, '').replace(/(\.\d*[1-9])0$/, '$1');
}

function dcNormalizeQty(rawValue, fallback) {
  var normalized = String(rawValue).replace(',', '.').trim();
  var parsed = parseFloat(normalized);

  if (isNaN(parsed)) {
    parsed = (typeof fallback === 'number') ? fallback : dcMinQty;
  }

  if (parsed < dcMinQty) {
    parsed = dcMinQty;
  }

  var stepUnits = Math.round((parsed * 100) / Math.round(dcStepQty * 100));
  var snapped = stepUnits * dcStepQty;

  if (snapped < dcMinQty) {
    snapped = dcMinQty;
  }

  return Math.round(snapped * 100) / 100;
}

function dcChangeQty(delta) {
  var inp = document.getElementById('input-quantity');
  if (!inp) return;

  var current = dcNormalizeQty(inp.value, dcMinQty);
  var next = current + ((delta < 0 ? -1 : 1) * dcStepQty);

  if (next < dcMinQty) {
    next = dcMinQty;
  }

  inp.value = dcFormatQty(dcNormalizeQty(next, dcMinQty));
  dcUpdateSubtotal();
}

function dcDetectCurrencySymbol(txt) {
  return (txt || '').replace(/[\d\s.,]+/g, '').trim();
}

function dcFormatMoney(value) {
  var number = (typeof value === 'number' && !isNaN(value)) ? value : 0;
  var decimals = {{ currency_decimal_place|default(2) }};
  var formatted = number.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals });

  // Server-provided symbols (may be empty strings)
  var left = {{ currency_symbol_left ? '"' ~ currency_symbol_left|e('js') ~ '"' : '""' }};
  var right = {{ currency_symbol_right ? '"' ~ currency_symbol_right|e('js') ~ '"' : '""' }};
  // config_symbol_right_space is stored inverted in the DB: 0 = space, 1 = no space
  var leftSpace = {{ config_symbol_left_space ? 'true' : 'false' }};
  var rightSpace = {{ config_symbol_right_space ? 'false' : 'true' }};

  if (left) {
    return left + (leftSpace ? ' ' : '') + formatted;
  }

  if (right) {
    return formatted + (rightSpace ? ' ' : '') + right;
  }

  return formatted;
}

function dcRecalcOptionPrice() {
  var priceEl = document.getElementById('dc-unit-price');
  if (!priceEl) return;

  // basePrice is the full price, salePrice is the price the customer actually
  // pays (sale price when on sale). Option adjustments are applied on top of
  // the actual price so the sale discount is not lost. currentPrice always
  // holds the last computed total, so the base is taken from salePrice
  // (or basePrice) — never from currentPrice — to stay idempotent.
  var basePrice = parseFloat(priceEl.dataset.basePrice || '0');
  var salePrice = parseFloat(priceEl.dataset.salePrice || '0');
  var base = basePrice;

  if (salePrice > 0 && salePrice < basePrice) {
    base = salePrice;
  }

  if (!base) {
    dcUpdateSubtotal();
    return;
  }

  var adjustment = 0;

  document.querySelectorAll('#product input.dc-option-radio:checked, #product input.dc-option-checkbox:checked').forEach(function(input) {
    var val = parseFloat(input.dataset.optionPrice || '0');
    var prefix = (input.dataset.optionPrefix || '+').trim();
    if (!val) return;
    adjustment += (prefix === '-') ? -val : val;
  });

  document.querySelectorAll('#product select[name^="option["]').forEach(function(select) {
    if (!select.value) return;
    var selected = select.options[select.selectedIndex];
    if (!selected) return;
    var val = parseFloat(selected.dataset.optionPrice || '0');
    var prefix = (selected.dataset.optionPrefix || '+').trim();
    if (!val) return;
    adjustment += (prefix === '-') ? -val : val;
  });

  var current = Math.max(0, base + adjustment);
  priceEl.dataset.currentPrice = String(current);

  var symbol = priceEl.dataset.currencySymbol || dcDetectCurrencySymbol(priceEl.textContent);
  priceEl.dataset.currencySymbol = symbol;

  // Update whichever price element is actually visible: the static sale price
  // span when the special container is shown, otherwise the base price span.
  var specialContainer = document.getElementById('dc-price-special');
  var priceSpecialEl = document.getElementById('dc-unit-price-special');
  var priceStrikethroughEl = document.getElementById('dc-unit-price-strikethrough');

  if (specialContainer && !specialContainer.classList.contains('hidden') && priceSpecialEl) {
    priceSpecialEl.textContent = dcFormatMoney(current, symbol);
    if (priceStrikethroughEl && basePrice > 0 && base > 0 && base < basePrice) {
      priceStrikethroughEl.textContent = dcFormatMoney(basePrice + adjustment, symbol);
    }
  } else {
    priceEl.textContent = dcFormatMoney(current, symbol);
  }

  dcUpdateSubtotal();
}

/* ── Product attributes show more ──────────────────────── */
function initProductAttributes() {
  var toggle = document.getElementById('product-attributes-toggle');
  var items = Array.from(document.querySelectorAll('.product-attribute-item'));
  if (!toggle) return;

  var label = toggle.querySelector('[data-show-more-label]');
  var icon = toggle.querySelector('[data-lucide]');
  var expanded = false;

  toggle.addEventListener('click', function() {
    expanded = !expanded;
    items.forEach(function(item) {
      var column = parseInt(item.getAttribute('data-attribute-column') || '0', 10);
      var position = parseInt(item.getAttribute('data-attribute-position') || '0', 10);
      item.classList.toggle('hidden', !expanded && (column > 2 || position > 6));
    });
    document.querySelectorAll('.product-attribute-group').forEach(function(group) {
      var column = parseInt(group.getAttribute('data-attribute-column') || '0', 10);
      group.classList.toggle('hidden', !expanded && column > 2);
    });
    toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    if (label) label.textContent = expanded ? '{{ text_attributes_show_less|e('js') }}' : '{{ text_attributes_show_more|e('js') }}';
    if (icon) icon.classList.toggle('rotate-180', expanded);
  });
}

/* ── Price × qty subtotal ──────────────────────────────── */
function dcUpdateSubtotal() {
  var priceEl = document.getElementById('dc-unit-price');
  var subEl   = document.getElementById('dc-subtotal');
  var qtyEl   = document.getElementById('input-quantity');
  if (!priceEl || !subEl || !qtyEl) return;
  var qty = dcNormalizeQty(qtyEl.value, dcMinQty);
  qtyEl.value = dcFormatQty(qty);
  var unit = parseFloat(priceEl.dataset.currentPrice || priceEl.dataset.basePrice || '0');
  if (isNaN(unit)) { subEl.classList.add('hidden'); return; }

  // Option adjustments sit on top of the base/sale price: currentPrice =
  // base + options. The tiered quantity discount applies to the base price
  // only (mirrors the cart), options are added afterwards.
  var base = parseFloat(priceEl.dataset.salePrice || priceEl.dataset.basePrice || '0');
  var optionAdjustment = 0;
  if (base > 0) optionAdjustment = unit - base;

  // Apply the current variant's tiered quantity discount (mirrors the cart):
  // pick the best tier whose quantity threshold is met and that beats the
  // current unit price.
  var variant = window.dcCurrentVariant || null;
  if (variant && Array.isArray(variant.discounts)) {
    var best = null;
    variant.discounts.forEach(function(d) {
      var dv = parseFloat(d.price_value);
      if (!isNaN(dv) && d.quantity <= qty && (best === null || d.quantity > best.quantity)) {
        best = { quantity: d.quantity, price: dv };
      }
    });
    if (best && best.price < base) unit = best.price + optionAdjustment;
  }

  var total = dcFormatMoney(unit * qty);
  subEl.textContent = '{{ text_total }}' + ' ' + total;
  subEl.classList.remove('hidden');
}

/* ── Rating stars with hover fill ─────────────────────── */
function initRatingStars() {
  var row = document.getElementById('dc-stars-row');
  if (!row) return;
  var stars = Array.from(row.querySelectorAll('.dc-star'));
  var selected = 0;
  function light(n) { stars.forEach(function(s) { s.classList.toggle('lit', +s.dataset.val <= n); }); }
  row.addEventListener('mouseover', function(e) { if (e.target.classList.contains('dc-star')) light(+e.target.dataset.val); });
  row.addEventListener('mouseleave', function() { light(selected); });
  row.addEventListener('click', function(e) {
    if (!e.target.classList.contains('dc-star')) return;
    selected = +e.target.dataset.val;
    light(selected);
    var r = document.getElementById('dc-rating-' + selected);
    if (r) r.checked = true;
  });
  stars.forEach(function(s) {
    s.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selected = +s.dataset.val;
        light(selected);
        var r = document.getElementById('dc-rating-' + selected);
        if (r) r.checked = true;
      }
    });
  });
}

/* ── Option buttons (radio / checkbox) ────────────────── */
function initOptionButtons() {
  document.querySelectorAll('.dc-option-radio').forEach(function(radio) {
    var group = radio.closest('[id^="input-option"]');
    var optional = group && group.getAttribute('data-required') === '0';
    var label = radio.closest('label');
    if (!label) return;

    // Clicking an already selected optional radio clears the selection
    label.addEventListener('click', function(e) {
      e.preventDefault();

      if (optional && radio.checked) {
        radio.checked = false;
        if (radio.nextElementSibling) radio.nextElementSibling.classList.remove('active');
        radio.dispatchEvent(new Event('change', { bubbles: true }));
        dcRecalcOptionPrice();
        return;
      }

      document.querySelectorAll('input[name="' + radio.name + '"]').forEach(function(r) {
        r.checked = false;
        if (r.nextElementSibling) r.nextElementSibling.classList.remove('active');
      });
      radio.checked = true;
      if (radio.nextElementSibling) radio.nextElementSibling.classList.add('active');

      var radioGroup = document.getElementById('input-option' + radio.name.replace(/[^0-9]/g, ''));
      if (radioGroup) radioGroup.classList.remove('dc-option-required-error');

      radio.dispatchEvent(new Event('change', { bubbles: true }));
      dcRecalcOptionPrice();
    });
  });
  document.querySelectorAll('.dc-option-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
      if (cb.nextElementSibling) cb.nextElementSibling.classList.toggle('active', cb.checked);

      var checkGroup = document.getElementById('input-option' + cb.name.replace(/[^0-9]/g, ''));
      if (checkGroup) checkGroup.classList.remove('dc-option-required-error');

      dcRecalcOptionPrice();
    });
  });

  document.querySelectorAll('#product select[name^="option["]').forEach(function(select) {
    select.addEventListener('change', function() {
      select.classList.remove('dc-option-required-error');
      dcRecalcOptionPrice();
    });
  });
}

/* ── Gallery + GLightbox ───────────────────────────────── */
let dcActiveImageThumb = null;
const initGallery = () => {
  const mainImg = document.getElementById('dc-main-img');
  const thumbs  = [...document.querySelectorAll('.dc-thumb:not(.dc-thumb-media)')];
  const zoomBtn = document.getElementById('dc-zoom-btn');
  const videoOverlay = document.getElementById('dc-video-overlay');
  const syncVideoOverlay = () => {
    if (!videoOverlay) return;
    const isMain = !thumbs.length || dcActiveImageThumb === thumbs[0];
    videoOverlay.style.display = isMain ? '' : 'none';
  };
  if (!zoomBtn) return;

  const aspectMap = {
    portrait:  'aspect-[3/4]',
    square:    'aspect-square',
    landscape: 'aspect-[4/3]'
  };

  const items = thumbs.length
    ? thumbs.map(b => ({ href: b.dataset.popup || b.dataset.img, type: 'image' }))
    : (mainImg ? [{ href: mainImg.dataset?.popup || mainImg.src, type: 'image' }] : []);

  const lb = (items.length && typeof GLightbox === 'function')
    ? GLightbox({ elements: items, loop: true, touchNavigation: true, zoomable: true, openEffect: 'zoom', closeEffect: 'fade' })
    : null;

  let activeIdx = 0;

  dcActiveImageThumb = thumbs.find(t => t.classList.contains('active')) || thumbs[0] || null;

  thumbs.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      thumbs.forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.dc-thumb-media').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      dcActiveImageThumb = btn;
      if (mainImg) {
        const newOrient = btn.dataset.orientation || 'landscape';
        Object.values(aspectMap).forEach(cls => mainImg.classList.remove(cls));
        mainImg.classList.add(aspectMap[newOrient]);

        mainImg.src = btn.dataset.display || btn.dataset.popup;
        if (btn.dataset.popup) mainImg.dataset.popup = btn.dataset.popup;
      }

      // Сховати відео-плеєр при перемиканні на зображення
      const videoPlayer = document.getElementById('dc-video-player');
      if (videoPlayer) videoPlayer.style.display = 'none';
      if (mainImg) mainImg.style.display = '';
      if (zoomBtn) zoomBtn.style.display = '';

      const mp4Video = document.getElementById('dc-mp4-video');
      if (mp4Video) mp4Video.pause();

      syncVideoOverlay();
      activeIdx = idx;
    });
  });

  if (lb) zoomBtn.addEventListener('click', () => lb.openAt(activeIdx));

  syncVideoOverlay();
};

document.addEventListener('DOMContentLoaded', function() {
  initGallery();
  initOptionButtons();
  initRatingStars();
  initProductAttributes();
  dcUpdateSubtotal();

  document.querySelectorAll('section').forEach(function(section) {
    var track = section.querySelector('.dc-carousel-track');
    var viewAll = section.querySelector('.flex a[href="#"]');
    if (!track || !viewAll) return;
    viewAll.addEventListener('click', function(e) {
      e.preventDefault();
      track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
    });
  });

  if (typeof lucide !== 'undefined') lucide.createIcons();
});

/* ── Sticky section tabs (scrollspy) ───────────────────── */
(function() {
  var tabsNav = document.getElementById('dc-product-tabs');
  if (!tabsNav) return;

  var tabs = Array.prototype.slice.call(tabsNav.querySelectorAll('.dc-product-tab'));
  if (tabs.length < 2) return;

  var sections = tabs.map(function(tab) {
    return document.querySelector(tab.getAttribute('data-target'));
  }).filter(Boolean);

  if (!sections.length) return;

  var header = document.getElementById('navbar');

  // On mobile the fixed header collapses/expands, so measure its real height
  // and pin the sticky bar right below it. On lg+ the CSS top-[132px] wins.
  function headerHeight() {
    if (!header) return 0;
    var r = header.getBoundingClientRect();
    return Math.max(0, Math.min(r.height, r.bottom));
  }

  function tabOffset() {
    var h = tabsNav.offsetHeight || 0;
    h += headerHeight();
    return h + 8;
  }

  function applyStickyTop() {
    if (window.matchMedia('(min-width: 1024px)').matches) return; // CSS handles it
    tabsNav.style.top = headerHeight() + 'px';
  }

  applyStickyTop();
  window.addEventListener('resize', applyStickyTop);
  window.addEventListener('scroll', applyStickyTop, { passive: true });

  // When the page is opened with a section hash (e.g. #product-attributes),
  // scroll precisely so the section sits below header + sticky tabs.
  var pinnedTab = null; // set while a programmatic scroll is in flight

  function scrollToHashSection() {
    var hash = window.location.hash;
    if (!hash) return;
    var section = document.querySelector(hash);
    if (!section || sections.indexOf(section) === -1) return;
    var idx = sections.indexOf(section);
    pinnedTab = tabs[idx];
    setActive(tabs[idx]);
    var top = section.getBoundingClientRect().top + window.pageYOffset - tabOffset();
    window.scrollTo(0, Math.max(0, top));
    // Keep the tab pinned until the user scrolls on their own; the hash
    // target can rest below the scrollspy offset (scroll-margin-top), which
    // would otherwise flip the active tab back to the first one.
    window.setTimeout(function() { pinnedTab = null; }, 600);
  }

  if (window.location.hash) {
    window.setTimeout(scrollToHashSection, 0);
    // Images shift layout after first paint, so re-sync once everything is loaded.
    window.addEventListener('load', function() {
      window.setTimeout(scrollToHashSection, 0);
    });
  }

  function setActive(tab) {
    tabs.forEach(function(t) {
      var on = t === tab;
      t.classList.toggle('text-blue-600', on);
      t.classList.toggle('text-gray-500', !on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');

      var indicator = t.querySelector('.dc-product-tab-indicator');
      if (indicator) {
        indicator.classList.toggle('invisible', !on);
        indicator.classList.toggle('opacity-0', !on);
      }
    });
  }

  function onScroll() {
    if (pinnedTab) return; // programmatic scroll in flight — keep hash/click choice
    var offset = tabOffset();
    var last = sections[sections.length - 1];
    // Past the last section — no tab is active.
    if (last && last.getBoundingClientRect().bottom < offset) {
      setActive(null);
      return;
    }
    var current = null;
    sections.forEach(function(section, i) {
      if (section.getBoundingClientRect().top <= offset) current = section;
    });
    var idx = current ? sections.indexOf(current) : -1;
    setActive(idx >= 0 ? tabs[idx] : null);
  }

  tabs.forEach(function(tab, i) {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      var section = sections[i];
      if (!section) return;
      var top = section.getBoundingClientRect().top + window.pageYOffset - tabOffset();
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      // Keep the full path: with <base href> in OpenCart 3, a bare "#hash" URL
      // would resolve against the store root and lose the product page path.
      history.replaceState(null, '', window.location.pathname + window.location.search + '#' + section.id);
      pinnedTab = tab;
      setActive(tab);
      window.setTimeout(function() { pinnedTab = null; }, 600);
    });
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  onScroll();
})();

function toggleProductVideo() {
  var player = document.getElementById('dc-video-player');
  var mainImg = document.getElementById('dc-main-img');
  var zoomBtn = document.getElementById('dc-zoom-btn');

  if (!player) return;

  if (player.style.display === 'none') {
    player.style.display = 'block';
    if (mainImg) mainImg.style.display = 'none';
    if (zoomBtn) zoomBtn.style.display = 'none';

    var youtubeIframe = document.getElementById('dc-youtube-iframe');
    if (youtubeIframe && !youtubeIframe.src) {
      youtubeIframe.src = youtubeIframe.dataset.src;
    }

    var mp4Video = document.getElementById('dc-mp4-video');
    if (mp4Video) {
      mp4Video.currentTime = 0;
      mp4Video.play().catch(function() {});
    }
  } else {
    player.style.display = 'none';
    if (mainImg) mainImg.style.display = '';
    if (zoomBtn) zoomBtn.style.display = '';

    var mp4Video = document.getElementById('dc-mp4-video');
    if (mp4Video) mp4Video.pause();

    var restoreThumb = dcActiveImageThumb || document.querySelector('.dc-thumb');
    document.querySelectorAll('.dc-thumb').forEach(function(t) { t.classList.remove('active'); });
    if (restoreThumb) restoreThumb.classList.add('active');

    var videoOverlay = document.getElementById('dc-video-overlay');
    if (videoOverlay) {
      var allThumbs = [...document.querySelectorAll('.dc-thumb:not(.dc-thumb-media)')];
      var isMain = !allThumbs.length || dcActiveImageThumb === allThumbs[0];
      videoOverlay.style.display = isMain ? '' : 'none';
    }
  }
}

function open3DViewer(btn) {
