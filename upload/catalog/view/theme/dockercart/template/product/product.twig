{{ header }}

<!-- GLightbox -->
<link rel="stylesheet" href="catalog/view/javascript/glightbox/glightbox.min.css" />

<style>
  /* Offset anchor targets below the fixed header + sticky tabs */
  #product-description, #product-attributes, #product-reviews {
    scroll-margin-top: 140px;
  }
  .dc-thumb.active { border-color: #2563eb !important; box-shadow: 0 0 0 2px #dbeafe inset; }
  .option-btn { transition: border-color .15s, background .15s, color .15s; }
  .option-btn:hover { border-color: #93c5fd; background: #f0f7ff; color: #1e3a8a; }
  .option-btn.active { border-color: #2563eb; background: #eff6ff; color: #1e3a8a; }
  .zoom-hint { opacity: 0; transform: translateY(6px); transition: all .25s ease; }
  .zoom-target:hover .zoom-hint { opacity: 1; transform: translateY(0); }


  /* ── Rating stars ─────────────────────────────────────── */
  .dc-stars-row { display: inline-flex; gap: 0; cursor: pointer; user-select: none; }
  .dc-stars-row .dc-star { font-size: 1.75rem; line-height: 1; color: #d1d5db; transition: color .1s, transform .1s; }
  .dc-stars-row .dc-star.lit { color: #f59e0b; }
  .dc-stars-row .dc-star:hover { transform: scale(1.2); }
  /* Review list stars (non-interactive) */
  .dc-stars { display: inline-flex; gap: 0; }
  .dc-stars .dc-star { font-size: 1rem; color: #e5e7eb; }
  .dc-stars .dc-star.active { color: #f59e0b; }
  .dc-option-required-error { border-color: #fca5a5 !important; box-shadow: 0 0 0 3px rgba(239,68,68,.12) !important; border-radius: 0.75rem; }
  .dc-color-swatch { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #e5e7eb; flex-shrink: 0; position: relative; }
  .dc-color-swatch--hit { border-color: #f9a825; box-shadow: 0 0 0 2px rgba(249,168,37,0.3); }
  .dc-color-hit { position: absolute; top: -4px; right: -4px; width: 14px; height: 14px; background: #f9a825; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; line-height: 1; }
  .dc-color-option { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 8px 12px; min-height: 88px; border-radius: 12px; border: 1px solid #e5e7eb; cursor: pointer; transition: border-color .15s, background .15s; }
  .dc-color-option:hover { border-color: #93c5fd; background: #f0f7ff; }
  .dc-color-option.active { border-color: #2563eb; background: #eff6ff; }
  .dc-color-option.oos { cursor: not-allowed; border-color: #f3f4f6; opacity: 0.5; }
  label.oos .option-btn:hover,
  label.oos .dc-color-option:hover { border-color: #e5e7eb; background: transparent; }
  /* Out-of-stock option values: struck through with a cross over the whole
     label, not clickable */
  label.oos {
    position: relative;
    display: inline-block;
  }
  label.oos .option-btn,
  label.oos .dc-color-option {
    text-decoration: none;
    opacity: 0.55;
  }
  label.oos::before,
  label.oos::after {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 50%;
    width: 1px;
    background: #9ca3af;
    pointer-events: none;
    z-index: 1;
  }
  label.oos::before {
    transform: rotate(45deg);
  }
  label.oos::after {
    transform: rotate(-45deg);
  }

  /* ── 3D Modal (vanilla, no Bootstrap) ──────────────── */
  .dc-modal-overlay { position: fixed; inset: 0; z-index: 1050; background: rgba(0,0,0,0.5); }
  .dc-modal-overlay.dc-hidden { display: none; }
  #model-3d-modal { position: fixed; z-index: 1060; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90vw; display: none; }
  #model-3d-modal.dc-open { display: block; }
  #model-3d-modal .modal-dialog { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 90vw; margin: 0 auto; }
  #model-3d-modal .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #e5e7eb; }
  #model-3d-modal .modal-header .close { background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280; padding: 0; line-height: 1; }
  #model-3d-modal .modal-header .close:hover { color: #111827; }
  #model-3d-modal .modal-title { margin: 0; font-size: 16px; font-weight: 600; }
  #model-3d-modal .modal-body { padding: 0; }

  /* ── 360° Viewer (vanilla, no Bootstrap) ─────────────── */
  #image-360-modal { position: fixed; z-index: 1060; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90vw; display: none; }
  #image-360-modal.dc-open { display: block; }
  #image-360-modal .modal-dialog { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 90vw; margin: 0 auto; }
  #image-360-modal .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #e5e7eb; }
  #image-360-modal .modal-header .close { background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280; padding: 0; line-height: 1; }
  #image-360-modal .modal-header .close:hover { color: #111827; }
  #image-360-modal .modal-title { margin: 0; font-size: 16px; font-weight: 600; }
  #image-360-modal .modal-body { padding: 0; }
  .dc-360-stage { position: relative; width: min(90vw, 70vh); height: min(90vw, 70vh); max-width: 100%; max-height: 70vh; margin: 0 auto; overflow: hidden; background: #fff; user-select: none; touch-action: pan-y; cursor: grab; }
  .dc-360-stage.dc-360-dragging { cursor: grabbing; }
  .dc-360-stage img { display: block; max-width: none; }
  .dc-360-hint { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 7px; background: rgba(17,24,39,0.86); color: #fff; font-size: 12px; font-weight: 600; padding: 7px 13px; border-radius: 9999px; backdrop-filter: blur(4px); pointer-events: none; white-space: nowrap; }
  .dc-360-hint__badge { display: inline-flex; align-items: center; justify-content: center; min-width: 28px; height: 20px; padding: 0 5px; border: 1px solid rgba(255,255,255,0.55); border-radius: 9999px; font-size: 10px; font-weight: 800; letter-spacing: .02em; }

</style>

{% include 'dockercart/template/product/review_css.twig' %}

<main class="py-20 sm:py-2 lg:py-4 px-4 sm:px-6 lg:px-8 bg-white">
  <!-- ─── BREADCRUMBS ─── -->
  <div class="max-w-7xl mx-auto mb-6">
    {% include 'dockercart/template/common/partials/breadcrumbs.twig' with {
      breadcrumbs_class: 'flex flex-wrap items-center gap-2 text-xs text-gray-500',
      breadcrumbs_link_class: 'hover:text-gray-900 transition',
      breadcrumbs_last_class: 'text-gray-700 font-semibold'
    } %}
  </div>
  <div class="max-w-7xl mx-auto">
    {{ content_top }}

    <!-- ─── PRODUCT ─── -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">

      <!-- Gallery -->
      <div class="lg:sticky lg:top-24 lg:z-10 self-start">
        <div class="rounded-3xl border border-gray-100 bg-gray-50 overflow-hidden">
          <button id="dc-zoom-btn" type="button" class="zoom-target group relative block w-full text-left" aria-label="{{ heading_title }}">
            <img id="dc-main-img" src="{{ display is not empty ? display : 'image/no_image.png' }}" data-popup="{{ popup is not empty ? popup : 'image/no_image.png' }}" alt="{{ heading_title }}" class="w-full {{ image_orientation == 'portrait' ? 'aspect-[3/4]' : (image_orientation == 'square' ? 'aspect-square' : 'aspect-[4/3]') }} object-cover cursor-zoom-in" />
            <span class="zoom-hint absolute bottom-3 right-3 inline-flex items-center gap-1.5 bg-gray-900/80 text-white text-[11px] font-semibold px-2.5 py-1.5 rounded-lg backdrop-blur-sm">
              <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i> {{ text_zoom }}
            </span>
            {% if video_type and video_url %}
            <span id="dc-video-overlay" role="button" tabindex="0" onclick="event.stopPropagation(); toggleProductVideo()" onkeydown="if(event.key==='Enter'){event.stopPropagation(); toggleProductVideo()}" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 flex items-center justify-center rounded-full bg-gray-900/60 hover:bg-gray-900/80 text-white backdrop-blur-sm cursor-pointer transition-transform duration-200 hover:scale-110 hover:shadow-xl" aria-label="{{ text_video }}">
              <i data-lucide="play" class="w-12 h-12"></i>
            </span>
            {% endif %}
          </button>
        </div>
        {% if video_type and video_url %}
        <div id="dc-video-player" class="rounded-3xl border border-gray-100 bg-gray-50 overflow-hidden" style="display:none;">
          {% if video_type == 'youtube' %}
          <iframe src="" id="dc-youtube-iframe" data-src="{{ video_url }}" class="w-full aspect-video" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
          {% elseif video_type == 'mp4' %}
          <video id="dc-mp4-video" class="w-full aspect-video" controls playsinline preload="metadata">
            <source src="{{ video_url }}" type="video/mp4">
          </video>
          {% endif %}
        </div>
        {% endif %}
        {% if images or model_3d or (video_type and video_url) or (image_360_enabled and image_360_url) %}
        <div class="grid grid-cols-4 gap-3 mt-3">
          <button class="dc-thumb active relative rounded-2xl border-2 overflow-hidden" data-img="{{ display is not empty ? display : 'image/no_image.png' }}" data-display="{{ display is not empty ? display : 'image/no_image.png' }}" data-popup="{{ popup is not empty ? popup : 'image/no_image.png' }}" data-orientation="{{ image_orientation }}">
            <img src="{{ thumb is not empty ? thumb : 'image/no_image.png' }}" alt="{{ heading_title }}" class="w-full h-20 object-cover" />
            {% if video_type and video_url %}
            <span class="pointer-events-none absolute bottom-1 right-1 inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-900/80 text-white">
              <i data-lucide="play" class="w-3.5 h-3.5"></i>
            </span>
            {% endif %}
          </button>
          {% for image in images %}
          <button class="dc-thumb rounded-2xl border-2 border-gray-200 overflow-hidden" data-img="{{ image.display is not empty ? image.display : 'image/no_image.png' }}" data-display="{{ image.display is not empty ? image.display : 'image/no_image.png' }}" data-popup="{{ image.popup is not empty ? image.popup : 'image/no_image.png' }}" data-orientation="{{ image.orientation }}">
            <img src="{{ image.thumb is not empty ? image.thumb : 'image/no_image.png' }}" alt="{{ heading_title }}" class="w-full h-20 object-cover" />
          </button>
          {% endfor %}
          {% if model_3d %}
          <button type="button" class="dc-thumb dc-thumb-media rounded-2xl border-2 border-gray-200 overflow-hidden flex flex-col items-center justify-center bg-gray-900 h-20" onclick="open3DViewer(this)">
            <i data-lucide="box" class="w-8 h-8 text-white mb-1"></i>
            <span class="text-white text-[10px]">3D</span>
          </button>
          {% endif %}
          {% if image_360_enabled and image_360_url %}
          <button type="button" class="dc-thumb dc-thumb-media rounded-2xl border-2 border-gray-200 overflow-hidden flex flex-col items-center justify-center bg-gray-900 h-20" onclick="open360Viewer(this)">
            <i data-lucide="rotate-3d" class="w-8 h-8 text-white mb-1"></i>
            <span class="text-white text-[10px]">360°</span>
          </button>
          {% endif %}
        </div>
        {% endif %}
      </div>

      <!-- 3D Model Modal -->
      {% if model_3d %}
      <div id="model-3d-modal">
        <div class="modal-dialog">
          <div class="modal-header">
            <h4 class="modal-title">{{ heading_title }} — 3D</h4>
            <button type="button" class="close" onclick="closeModal3d()" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          </div>
          <div class="modal-body">
            <model-viewer id="dc-model-viewer" src="{{ model_3d_url }}" alt="{{ heading_title }}" auto-rotate camera-controls ar ar-modes="webxr scene-viewer quick-look" style="width:100%;height:70vh;"></model-viewer>
          </div>
        </div>
      </div>
      <script type="importmap">
      {
        "imports": {
          "@google/model-viewer": "https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"
        }
      }
      </script>
      <script type="module">
        import '@google/model-viewer';
      </script>
      {% endif %}

      <!-- 360° Image Modal -->
      {% if image_360_enabled and image_360_url %}
      <div id="image-360-modal">
        <div class="modal-dialog">
          <div class="modal-header">
            <h4 class="modal-title">{{ heading_title }} — 360°</h4>
            <button type="button" class="close" onclick="close360Viewer()" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          </div>
          <div class="modal-body">
            <div id="dc-360-stage" class="dc-360-stage" data-url="{{ image_360_url }}">
              <img id="dc-360-img" src="{{ image_360_url }}" alt="{{ heading_title }}" draggable="false" />
              <div class="dc-360-hint"><i data-lucide="move-horizontal" class="w-4 h-4"></i><span class="dc-360-hint__badge">360°</span><span id="dc-360-hint-text">{{ text_360_hint }}</span></div>
            </div>
          </div>
        </div>
      </div>
      {% endif %}

      <!-- Info -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span id="dc-stock-badge" data-stock-display="{{ config_stock_display ? '1' : '0' }}" data-text-instock="{{ text_instock }}" data-stock-instock="{{ stock_status_instock }}" data-text-preorder="{{ text_preorder }}" data-text-out-of-stock="{{ text_out_of_stock }}" class="inline-flex items-center gap-1.5 text-sm font-semibold {% if is_preorder is defined and is_preorder %}text-amber-600{% elseif is_in_stock %}text-emerald-600{% else %}text-red-500{% endif %}">
            <i data-lucide="check" class="dc-stock-icon w-4 h-4 {% if not is_in_stock and not (is_preorder is defined and is_preorder) %}hidden{% endif %}"></i><span class="dc-stock-text">{{ stock }}</span>
          </span>
          {% if is_discontinued is defined and is_discontinued %}
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-gray-200 text-gray-600 text-[13px] font-bold">
            <i data-lucide="ban" class="w-4 h-4"></i>{{ text_discontinued }}
          </span>
          {% endif %}
        </div>

        <h1 id="dc-product-name" data-base-name="{{ base_product_name }}" data-base-meta-title="{{ base_meta_title }}" class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight">{{ heading_title }}</h1>

        {% if review_status %}
        {% include 'dockercart/template/product/review_summary.twig' %}
        {% else %}
        <p class="text-sm text-gray-500 mt-3">{{ text_model }} <span id="dc-variant-model" data-base-model="{{ model }}">{{ is_configurable and variant_model is defined and variant_model ? variant_model : model }}</span></p>
        {% endif %}

        {% set show_call_for_price = (call_for_price is defined and call_for_price) or ((call_for_price_status is defined and call_for_price_status) and call_for_price_phone is defined and call_for_price_phone and dc_base_price_value is defined and dc_base_price_value <= 0) %}

        {% if price %}
        <div class="dc-price-block mt-5">
          {% if show_call_for_price %}
          {% else %}
          <div class="dc-price-main flex flex-wrap items-center gap-x-4 gap-y-2">
            <div class="flex items-baseline gap-2 sm:gap-3 flex-wrap{% if special %} hidden{% endif %}" id="dc-price-regular">
              <span id="dc-unit-price" data-base-price="{{ dc_full_price_value|default(dc_base_price_value|default(0)) }}" data-sale-price="{{ dc_base_price_value|default(0) }}" data-current-price="{{ dc_base_price_value|default(0) }}" class="text-2xl sm:text-3xl font-extrabold text-gray-900">{{ price }}</span>
              {% if tax %}<span class="text-xs text-gray-400" id="dc-unit-tax">{{ text_tax }} {{ tax }}</span>{% endif %}
            </div>
            <div class="dc-price-special flex flex-wrap items-center gap-2 sm:gap-3{% if not special %} hidden{% endif %}" id="dc-price-special">
              <span class="dc-sale-badge text-xs font-bold bg-red-500 text-white px-2 py-0.5 rounded-lg" id="dc-sale-badge">{% if discount_percent is defined and discount_percent > 0 %}-{{ discount_percent }}%{% else %}{{ text_sale }}{% endif %}</span>
              <span id="dc-unit-price-special" class="text-2xl sm:text-3xl font-extrabold text-red-600">{{ special }}</span>
              <span id="dc-unit-price-strikethrough" class="text-sm sm:text-lg text-gray-400 line-through">{{ price }}</span>
              {% if tax %}<span class="text-xs text-gray-400" id="dc-unit-tax">{{ text_tax }} {{ tax }}</span>{% endif %}
            </div>
          </div>
          {% if not show_call_for_price %}
          {% endif %}
          {% endif %}
        {% if not show_call_for_price and (you_save_amount or is_configurable) %}
        <div class="mt-1.5{% if not you_save_amount %} hidden{% endif %}" id="dc-you-save">
          <span class="text-md font-semibold text-green-600">{{ text_you_save }}: <span id="dc-you-save-amount">{{ you_save_amount }}</span></span>
        </div>
        {% endif %}
        </div>
        {% if points %}
        <div class="mt-2 flex items-center gap-2 text-xs font-semibold text-blue-700 bg-blue-50 rounded-xl px-3 py-2">
          <i data-lucide="coins" class="w-4 h-4 text-blue-500"></i> {{ text_points }} {{ points }}
        </div>
        {% endif %}
        {% if discounts %}
        <div class="mt-2 grid grid-cols-[auto_auto_1fr] gap-x-2 gap-y-1.5 text-sm items-baseline">
          {% for discount in discounts %}
            <span class="text-gray-600 whitespace-nowrap">{{ discount.quantity }}{{ text_discount }}</span>
            <span class="text-gray-400">&mdash;</span>
            <span class="font-semibold text-emerald-600 whitespace-nowrap">{{ discount.price }}</span>
          {% endfor %}
        </div>
        {% endif %}
        {% if is_configurable %}
        <div id="dc-variant-discounts" class="mt-2 hidden grid grid-cols-[auto_auto_1fr] gap-x-2 gap-y-1.5 text-sm items-baseline"></div>
        {% endif %}
        {% if gifts %}
        <div class="mt-4 p-4 rounded-2xl bg-gradient-to-b from-amber-50 via-white to-orange-50 border border-amber-200 shadow-sm shadow-amber-100">
          <div class="flex items-center justify-between gap-2 mb-3">
            <h3 class="text-sm font-bold text-amber-900 flex items-center gap-1.5 min-w-0">
              <span class="w-7 h-7 rounded-lg bg-amber-500 text-white flex items-center justify-center flex-shrink-0">
                <i data-lucide="gift" class="w-4 h-4"></i>
              </span>
              <span class="truncate">{{ text_gift }}</span>
            </h3>
            <span class="flex-shrink-0 text-[10px] font-bold text-amber-700 bg-amber-100 border border-amber-200 px-2 py-0.5 rounded-full">{{ text_free }}</span>
          </div>
          <div class="space-y-3">
          {% for gift in gifts %}
          <div class="flex items-center gap-3 p-2 -m-2 rounded-xl hover:bg-amber-50/70 transition">
            <img src="{{ gift.image }}" alt="{{ gift.name }}" class="w-16 h-16 rounded-lg object-cover border border-amber-100"/>
            <div class="flex-1 min-w-0">
              <a href="{{ gift.href }}" class="text-sm font-medium text-gray-800 hover:text-amber-600 transition line-clamp-2">{{ gift.name }}</a>
              <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
                <span class="text-xs text-gray-400 line-through">{{ gift.price }}</span>
                <span class="text-sm font-extrabold text-amber-700">{{ gift.price_zero }}</span>
              </div>
              {% if gift.minimum_quantity > 1 %}
              <p class="text-xs text-gray-500 mt-0.5">{{ text_gift_minimum }}: {{ gift.minimum_quantity }}</p>
              {% endif %}
            </div>
          </div>
          {% endfor %}
          </div>
        </div>
        {% endif %}
        {% if bxgy_rules %}
        <div class="mt-4 p-4 rounded-2xl bg-gradient-to-b from-violet-50 via-white to-fuchsia-50 border border-violet-200 shadow-sm shadow-violet-100">
          <div class="flex items-center justify-between gap-2 mb-3">
            <h3 class="text-sm font-bold text-violet-900 flex items-center gap-1.5 min-w-0">
              <span class="w-7 h-7 rounded-lg bg-violet-600 text-white flex items-center justify-center flex-shrink-0">
                <i data-lucide="zap" class="w-4 h-4"></i>
              </span>
              <span class="truncate">{{ text_bxgy }}</span>
            </h3>
            <span class="flex-shrink-0 text-[10px] font-bold text-violet-700 bg-violet-100 border border-violet-200 px-2 py-0.5 rounded-full">{{ text_bxgy_discount }}</span>
          </div>
          <div class="space-y-3">
          {% for rule in bxgy_rules %}
          <div class="flex items-center gap-3 p-2 -m-2 rounded-xl hover:bg-violet-50/70 transition">
            <a href="{{ rule.href }}" class="flex-shrink-0">
              <img src="{{ rule.image }}" alt="{{ rule.name }}" class="w-16 h-16 rounded-lg object-cover border border-violet-100"/>
            </a>
            <div class="flex-1 min-w-0">
              <a href="{{ rule.href }}" class="text-sm font-medium text-gray-800 hover:text-violet-600 transition line-clamp-2">{{ rule.name }}</a>
              <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
                <span class="text-xs text-gray-400 line-through">{{ rule.original_price }}</span>
                <span class="text-sm font-extrabold text-violet-700">{{ rule.discounted_price }}</span>
                <span class="text-[10px] text-white font-bold bg-violet-600 px-1.5 py-0.5 rounded">{{ rule.discount_text }}</span>
              </div>
              <span class="inline-flex items-center gap-1 mt-1 text-[10px] font-bold text-violet-700 bg-violet-100 border border-violet-200 px-1.5 py-0.5 rounded-full">
                <i data-lucide="percent" class="w-3 h-3"></i>
                <span class="text-violet-900 text-sm font-extrabold leading-none">{{ rule.trigger_quantity }}</span>
                <span class="font-semibold">{{ text_bxgy_trigger_pcs|default('шт.') }}</span>
              </span>
            </div>
            <button type="button" onclick="cart.add('{{ rule.reward_product_id }}', 1);" class="flex-shrink-0 w-9 h-9 rounded-xl flex items-center justify-center transition bg-transparent hover:bg-violet-600 active:bg-violet-700 text-violet-600 hover:text-white" title="{{ button_cart }}">
              <i data-lucide="shopping-cart" class="w-4 h-4 pointer-events-none"></i>
            </button>
          </div>
          {% endfor %}
          </div>
        </div>
        {% endif %}
        {% endif %}

        <!-- Options + Cart form -->
        <div id="product">

          {% if options %}{% for option in options %}
          <div class="mt-5">
            <p class="text-sm font-semibold text-gray-800 mb-2">{{ option.name }}{% if option.required %} <span class="text-red-500">*</span>{% endif %}</p>

            {% if option.type == 'color' %}
            <div class="flex flex-wrap gap-2" id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              {% set is_hidden = is_configurable and option.is_configurable_axis and dc_axis_hidden_pov_ids is defined and option_value.product_option_value_id in dc_axis_hidden_pov_ids %}
              {% set is_oos = is_configurable and option.is_configurable_axis and dc_axis_oos_pov_ids is defined and option_value.product_option_value_id in dc_axis_oos_pov_ids %}
              <label class="cursor-pointer{% if is_hidden %} hidden{% endif %}{% if is_oos %} oos{% endif %}">
                <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" data-option-price="{{ option.is_configurable_axis ? 0 : option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}" class="sr-only dc-option-radio"{{ is_selected ? ' checked' : '' }}{% if is_hidden or is_oos %} disabled{% endif %} />
                <span class="dc-color-option{{ is_selected ? ' active' : '' }}">
                  <span class="dc-color-swatch{% if option_value.is_hit %} dc-color-swatch--hit{% endif %}" style="background-color: {{ option_value.color_code }}">
                    {% if option_value.is_hit %}<span class="dc-color-hit" title="Hit">&#9733;</span>{% endif %}
                  </span>
                  <span class="text-xs font-semibold">{{ option_value.name }}</span>
                  {% if not option.is_configurable_axis and option.show_option_price and option_value.price and option_value.price_value != 0 %}<span class="text-[10px] text-gray-500">({{ option_value.price_prefix }}{{ option_value.price }})</span>{% endif %}
                </span>
              </label>
              {% endfor %}
            </div>

            {% elseif option.type == 'radio' %}
            <div class="flex flex-wrap gap-2" id="input-option{{ option.product_option_id }}" data-required="{{ option.required ? '1' : '0' }}">
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              {% set is_hidden = is_configurable and option.is_configurable_axis and dc_axis_hidden_pov_ids is defined and option_value.product_option_value_id in dc_axis_hidden_pov_ids %}
              {% set is_oos = is_configurable and option.is_configurable_axis and dc_axis_oos_pov_ids is defined and option_value.product_option_value_id in dc_axis_oos_pov_ids %}
              <label class="cursor-pointer{% if is_hidden %} hidden{% endif %}{% if is_oos %} oos{% endif %}">
                <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" data-option-price="{{ option.is_configurable_axis ? 0 : option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}" class="sr-only dc-option-radio"{{ is_selected ? ' checked' : '' }}{% if is_hidden or is_oos %} disabled{% endif %} />
                <span class="option-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-sm font-semibold select-none border-gray-200{{ is_selected ? ' active' : '' }}">
                  {{ option_value.name }}{% if not option.is_configurable_axis and option.show_option_price and option_value.price and option_value.price_value != 0 %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                </span>
              </label>
              {% endfor %}
            </div>

            {% elseif option.type == 'select' %}
            <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm bg-white focus:outline-none focus:border-blue-400 transition appearance-none">
              <option value="">{{ text_select }}</option>
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              {% set is_hidden = is_configurable and option.is_configurable_axis and dc_axis_hidden_pov_ids is defined and option_value.product_option_value_id in dc_axis_hidden_pov_ids %}
              {% set is_oos = is_configurable and option.is_configurable_axis and dc_axis_oos_pov_ids is defined and option_value.product_option_value_id in dc_axis_oos_pov_ids %}
              <option value="{{ option_value.product_option_value_id }}" data-option-price="{{ option.is_configurable_axis ? 0 : option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}"{{ is_selected ? ' selected' : '' }}{% if is_hidden or is_oos %} disabled{% endif %}>{{ option_value.name }}{% if not option.is_configurable_axis and option.show_option_price and option_value.price and option_value.price_value != 0 %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>
              {% endfor %}
            </select>

            {% elseif option.type == 'checkbox' %}
            <div class="flex flex-wrap gap-2" id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              <label class="cursor-pointer">
                <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" data-option-price="{{ option.is_configurable_axis ? 0 : option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}" class="sr-only dc-option-checkbox"{{ is_selected ? ' checked' : '' }} />
                <span class="option-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-sm font-semibold select-none border-gray-200{{ is_selected ? ' active' : '' }}">
                  {{ option_value.name }}{% if not option.is_configurable_axis and option.show_option_price and option_value.price and option_value.price_value != 0 %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                </span>
              </label>
              {% endfor %}
            </div>

            {% elseif option.type == 'text' %}
            <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition" />

            {% elseif option.type == 'textarea' %}
            <textarea name="option[{{ option.product_option_id }}]" rows="4" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition resize-none">{{ option.value }}</textarea>

            {% elseif option.type == 'file' %}
            <button type="button" id="button-upload{{ option.product_option_id }}" data-loading-text="{{ text_loading }}" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold hover:bg-gray-50 transition">
              <i data-lucide="upload" class="w-4 h-4"></i> {{ button_upload }}
            </button>
            <input type="hidden" name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" />

            {% elseif option.type == 'date' %}
            <div class="date"><input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition" /></div>

            {% elseif option.type == 'datetime' %}
            <div class="datetime"><input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition" /></div>

            {% elseif option.type == 'time' %}
            <div class="time"><input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="HH:mm" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition" /></div>
            {% endif %}

          </div>
          {% endfor %}{% endif %}

          {% if minimum > 1 or (quantity_step is defined and quantity_step != 1) %}
          <div class="mt-4 flex items-center gap-2 text-xs text-blue-600 bg-blue-50 rounded-xl px-3 py-2">
            <i data-lucide="info" class="w-3.5 h-3.5 flex-shrink-0"></i>
            <span>
              {{ text_minimum }}
              {% if quantity_step is defined and quantity_step != 1 %}
              · {{ text_quantity_step }}
              {% endif %}
            </span>
          </div>
          {% endif %}

          <input type="hidden" name="product_id" value="{{ product_id }}" />
          <input type="hidden" name="option[variant_id]" value="{{ is_configurable and variant_id is defined ? variant_id : '' }}" id="dc-variant-id" />

          {% if not show_call_for_price %}
          <p id="dc-subtotal" class="text-lg text-blue-700 font-bold mt-6"></p>
          {% endif %}

          <!-- Qty + Cart + Wishlist -->
          <div class="mt-3 flex flex-wrap items-center gap-3">
            {% if show_call_for_price %}
            <div class="flex-1 min-w-0 flex flex-wrap items-center gap-3">
              {% if call_for_price_mode is defined and call_for_price_mode == 'call' %}
              <a href="tel:{{ call_for_price_phone }}" class="flex-1 min-w-0 py-3 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold rounded-xl transition text-sm shadow-md shadow-blue-200 whitespace-nowrap inline-flex items-center justify-center gap-2">
                <i data-lucide="phone" class="w-5 h-5"></i>
                {{ text_call_for_price|default('Contact for price') }}
              </a>
              {% else %}
              <div id="dc-qty-wrap" class="inline-flex items-center border border-gray-200 rounded-xl overflow-hidden flex-shrink-0{% if not is_in_stock %} hidden{% endif %}">
                <button type="button" class="w-10 h-10 text-lg font-bold text-gray-500 hover:bg-gray-50 transition" onclick="dcChangeQty(-1)">−</button>
                <input type="number" name="quantity" value="{{ minimum }}" id="input-quantity" min="{{ minimum }}" step="{{ quantity_step|default(1) }}" oninput="dcUpdateSubtotal()" class="w-16 text-center text-sm font-semibold border-0 outline-none py-2 bg-transparent" />
                <button type="button" class="w-10 h-10 text-lg font-bold text-gray-500 hover:bg-gray-50 transition" onclick="dcChangeQty(1)">+</button>
              </div>
              <button type="button" class="dc-cfp-request-btn flex-1 min-w-0 py-3 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold rounded-xl transition text-sm shadow-md shadow-blue-200 whitespace-nowrap inline-flex items-center justify-center gap-2" data-dc-cfp-request data-product-id="{{ product_id }}" data-dc-cfp-qty-source="#input-quantity">
                <i data-lucide="message-circle-question" class="w-5 h-5"></i>
                {{ text_call_for_price_request|default('Request price') }}
              </button>
              {% endif %}
            </div>
            {% else %}
            <div id="dc-qty-wrap" class="inline-flex items-center border border-gray-200 rounded-xl overflow-hidden flex-shrink-0{% if not is_in_stock %} hidden{% endif %}">
              <button type="button" class="w-10 h-10 text-lg font-bold text-gray-500 hover:bg-gray-50 transition" onclick="dcChangeQty(-1)">−</button>
              <input type="number" name="quantity" value="{{ minimum }}" id="input-quantity" min="{{ minimum }}" step="{{ quantity_step|default(1) }}" oninput="dcUpdateSubtotal()" class="w-16 text-center text-sm font-semibold border-0 outline-none py-2 bg-transparent" />
              <button type="button" class="w-10 h-10 text-lg font-bold text-gray-500 hover:bg-gray-50 transition" onclick="dcChangeQty(1)">+</button>
            </div>

            <button type="button" id="button-cart" data-loading-text="{{ text_loading }}" data-out-of-stock="{{ text_out_of_stock }}"
              class="flex-1 min-w-0 py-3 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold rounded-xl transition text-sm shadow-md shadow-blue-200 whitespace-nowrap flex items-center justify-center gap-2{% if not is_in_stock %} hidden{% endif %}">
              <i data-lucide="shopping-cart" class="w-5 h-5"></i>{{ button_cart }}
            </button>

            <span id="dc-out-of-stock" class="inline-flex items-center gap-2 px-4 py-3 bg-gray-100 text-gray-500 font-semibold rounded-xl text-sm{% if is_in_stock %} hidden{% endif %}">
              <i data-lucide="circle-x" class="w-5 h-5"></i>{{ text_out_of_stock }}
            </span>
            {% endif %}

            <div class="flex items-center gap-3 w-full sm:w-auto sm:flex-shrink-0">
              <button type="button" id="dc-wishlist-btn" data-product-id="{{ product_id }}" data-variant-id="0" data-in-wishlist="{{ in_wishlist|default(0) }}" title="{{ button_wishlist }}"
                class="flex-1 sm:flex-none rounded-xl border {% if in_wishlist|default(0) %}border-rose-300 bg-rose-50{% else %}border-gray-200 hover:border-rose-300 hover:bg-rose-50{% endif %} flex items-center justify-center gap-2 transition flex-shrink-0 px-3 py-2.5">
                <i data-lucide="heart" class="w-5 h-5 pointer-events-none {% if in_wishlist|default(0) %}text-rose-500 fill-rose-400{% else %}text-gray-500{% endif %}"></i>
                <span class="inline sm:hidden text-sm font-semibold text-gray-600">{{ button_wishlist }}</span>
              </button>

              <button type="button" id="dc-compare-btn" data-product-id="{{ product_id }}" data-variant-id="0" data-in-compare="{{ in_compare|default(0) }}" title="{{ button_compare }}"
                class="flex-1 sm:flex-none rounded-xl border {% if in_compare|default(0) %}border-blue-300 bg-blue-50{% else %}border-gray-200 hover:border-blue-200 hover:bg-blue-50{% endif %} flex items-center justify-center gap-2 transition flex-shrink-0 px-3 py-2.5">
                <i data-lucide="chart-no-axes-column" class="w-5 h-5 {% if in_compare|default(0) %}text-blue-500 fill-blue-400{% else %}text-gray-500{% endif %}"></i>
                <span class="inline sm:hidden text-sm font-semibold text-gray-600">{{ button_compare }}</span>
              </button>
            </div>
          </div>

          {% if reward %}
          <div class="mt-4 flex items-center gap-2">
            <i data-lucide="coins" class="w-4 h-4 text-teal-600 flex-shrink-0"></i>
            <span class="text-sm font-semibold text-teal-700">{{ text_earn_reward|replace({'%s': reward}) }}</span>
          </div>
          {% endif %}

        </div>{# end #product #}

        {% if messenger_links and messenger_fab_status %}
        <div class="mt-6">
          <p class="text-sm font-bold text-gray-900 mb-3">{{ text_we_are_in_messengers }}</p>
          <div class="flex flex-wrap items-center gap-2">
          {% for messenger in messenger_links %}
            {% if messenger.link %}
            <a href="{{ messenger.link }}" target="_blank" rel="noopener nofollow" title="{{ text_write_in_messenger }} {{ messenger.name }}"
               class="flex items-center justify-center w-11 h-11 rounded-full border border-gray-200 bg-white text-gray-600 hover:text-white hover:border-transparent transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5">
              <img src="{{ messenger.image }}" alt="{{ messenger.name }}" class="w-6 h-6 object-contain" />
            </a>
            {% endif %}
          {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if product_features %}
        <!-- Badges row -->
        <div class="grid grid-cols-1 sm:grid-cols-{{ product_features|length > 1 ? '2' : '1' }} lg:grid-cols-{{ product_features|length > 2 ? '3' : (product_features|length > 1 ? '2' : '1') }} gap-3 mt-6">
          {% for feature in product_features %}
          <div class="rounded-2xl border border-gray-100 p-3 bg-gray-50">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1 flex items-center gap-1">
              <i data-lucide="{{ feature.icon|default('truck') }}" class="w-3.5 h-3.5"></i>
              {{ feature.title }}
            </p>
            {% if feature.text %}
            <p class="text-sm font-semibold text-gray-800">{{ feature.text }}</p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </section>

    {% set _desc_text = description|striptags|trim %}

    {% set _tabs = [] %}
    {% if _desc_text is not empty %}
      {% set _tabs = _tabs|merge([{ key: 'description', label: tab_description, target: 'product-description' }]) %}
    {% endif %}
    {% if attribute_groups %}
      {% set _tabs = _tabs|merge([{ key: 'attributes', label: tab_attribute, target: 'product-attributes' }]) %}
    {% endif %}
    {% if review_status %}
      {% set _tabs = _tabs|merge([{ key: 'reviews', label: tab_review, target: 'product-reviews' }]) %}
    {% endif %}

    {% if _tabs|length > 1 %}
    <!-- Sticky product section tabs (scrollspy) -->
    <nav id="dc-product-tabs" class="sticky top-0 lg:top-[132px] z-30 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mt-12 bg-white/95 backdrop-blur-md shadow-sm" aria-label="{{ heading_title }}">
      <div class="dc-hnav-scroll max-w-7xl mx-auto flex overflow-x-auto gap-1">
        {% for tab in _tabs %}
        <button type="button" class="dc-product-tab shrink-0 relative px-4 py-3 text-sm font-semibold whitespace-nowrap transition-colors {% if loop.first %}text-blue-600{% else %}text-gray-500 hover:text-gray-800{% endif %}" data-target="#{{ tab.target }}" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" aria-controls="{{ tab.target }}" id="dc-tab-{{ tab.key }}">
          {{ tab.label }}
          <span class="dc-product-tab-indicator absolute inset-x-4 -bottom-px h-0.5 rounded-full bg-blue-600 transition-opacity duration-200{% if not loop.first %} invisible opacity-0{% endif %}"></span>
        </button>
        {% endfor %}
      </div>
    </nav>
    <script>
    // Set the active tab immediately from the URL hash, before first paint,
    // so the highlighted tab matches the section the page opens on.
    (function() {
      var hash = window.location.hash;
      if (!hash) return;
      var nav = document.getElementById('dc-product-tabs');
      if (!nav) return;
      var tab = nav.querySelector('.dc-product-tab[data-target="' + hash + '"]');
      if (!tab) return;
      nav.querySelectorAll('.dc-product-tab').forEach(function(t) {
        var on = t === tab;
        t.classList.toggle('text-blue-600', on);
        t.classList.toggle('text-gray-500', !on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        var indicator = t.querySelector('.dc-product-tab-indicator');
        if (indicator) {
          indicator.classList.toggle('invisible', !on);
          indicator.classList.toggle('opacity-0', !on);
        }
      });
    })();
    </script>
    {% endif %}

    <section id="product-description" class="mt-8" aria-labelledby="product-description-heading">
      <div class="mb-3">
        <h2 id="product-description-heading" class="text-xl sm:text-2xl font-bold text-gray-900">{{ tab_description }}</h2>
      </div>
      <div class="prose prose-sm max-w-none
        prose-headings:font-extrabold prose-headings:text-gray-900
        prose-p:text-gray-600 prose-p:leading-relaxed
        prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-2xl prose-img:border prose-img:border-gray-100">
        {{ _desc_text is not empty ? description : heading_title }}
      </div>
    </section>

    {% if fbt_products %}
    <section class="mt-12" aria-labelledby="fbt-heading">
      <div class="flex items-end justify-between mb-6">
        <div>
          <h2 id="fbt-heading" class="text-xl sm:text-2xl font-bold text-gray-900">{{ text_fbt }}</h2>
        </div>
      </div>
      <div class="dc-carousel">
        <button type="button" class="dc-carousel-btn dc-carousel-prev" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div id="dc-fbt-grid" class="dc-carousel-track">
          {% for product in fbt_products %}
          {% include 'dockercart/template/product/product_card_widget.twig' with {
            product: product,
            accent_color: 'blue-600',
            btn_cart_classes: 'bg-blue-600 text-white hover:bg-blue-700',
            btn_quick_hover: 'hover:bg-blue-600'
          } %}
          {% endfor %}
        </div>
        <button type="button" class="dc-carousel-btn dc-carousel-next" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </section>
    {% endif %}

    {% if attribute_groups %}
    {% set _attribute_hidden_items = 0 %}
    <section id="product-attributes" class="mt-8 border-t border-gray-200 pt-6" aria-labelledby="product-attributes-heading">
      <div class="mb-4">
        <h2 id="product-attributes-heading" class="text-xl sm:text-2xl font-bold text-gray-900">{{ tab_attribute }}</h2>
      </div>
      <div id="product-attributes-list" class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        {% for attribute_group in attribute_groups %}
        {% set _group_index = loop.index %}
        {% set _group_visible_count = min(attribute_group.attribute|length, 6) %}
        {% set _group_is_visible = loop.index <= 2 and _group_visible_count > 0 %}
        {% set _group_hidden_count = loop.index > 2 ? attribute_group.attribute|length : (attribute_group.attribute|length > 6 ? attribute_group.attribute|length - 6 : 0) %}
        {% set _attribute_hidden_items = _attribute_hidden_items + _group_hidden_count %}
        <div class="product-attribute-group{% if not _group_is_visible %} hidden{% endif %}" data-attribute-column="{{ loop.index }}">
          <h3 class="text-sm font-bold text-gray-900 mb-3">{{ attribute_group.name }}</h3>
          <div class="space-y-2.5">
            {% for attribute in attribute_group.attribute %}
            <div class="product-attribute-item grid grid-cols-[minmax(0,140px)_minmax(0,1fr)] gap-x-4 text-sm leading-6{% if not _group_is_visible or loop.index > 6 %} hidden{% endif %}" data-attribute-column="{{ _group_index }}" data-attribute-position="{{ loop.index }}">
              <span class="text-gray-500">{{ attribute.name }}</span>
              <span class="text-gray-900">{{ attribute.text }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% if _attribute_hidden_items > 0 %}
      <button id="product-attributes-toggle" type="button" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:text-blue-700" aria-expanded="false" aria-controls="product-attributes-list">
        <span data-show-more-label>{{ text_attributes_show_more }}</span>
        <i data-lucide="chevron-down" class="w-4 h-4" aria-hidden="true"></i>
      </button>
      {% endif %}

      {% include 'dockercart/template/product/brand_block.twig' with {
        manufacturer: manufacturer,
        manufacturers: manufacturers,
        manufacturer_image: manufacturer_image,
        text_brand: text_brand,
        text_all_brand_products: text_all_brand_products
      } %}
    </section>
    {% endif %}

    {% if review_status %}
    <section id="product-reviews" class="mt-8 border-t border-gray-200 pt-6" aria-labelledby="product-reviews-heading">
      <div class="mb-4">
        <h2 id="product-reviews-heading" class="text-xl sm:text-2xl font-bold text-gray-900 inline-flex items-center gap-2">
          {{ tab_review }}
          {% if review_count %}
