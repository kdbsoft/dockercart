/* ── 360° Viewer ───────────────────────────────────────── */
var dc360 = {
  modal: null,
  stage: null,
  img: null,
  frames: 36,
  frame: 0,
  frameW: 1,
  scale: 1,
  dragging: false,
  lastX: 0,
  dragDistance: 0,
  dragPixelsPerFrame: 1,
  interval: null
};

function open360Viewer(btn) {
  dc360.modal = document.getElementById('image-360-modal');
  if (!dc360.modal) return;

  document.querySelectorAll('.dc-thumb').forEach(function(t) { t.classList.remove('active'); });
  if (btn) btn.classList.add('active');

  var backdrop = document.getElementById('dc-modal-backdrop');
  if (!backdrop) {
    backdrop = document.createElement('div');
    backdrop.id = 'dc-modal-backdrop';
    backdrop.className = 'dc-modal-overlay dc-hidden';
    backdrop.addEventListener('click', function(e) {
      if (e.target === backdrop) close360Viewer();
    });
    document.body.appendChild(backdrop);
  }
  backdrop.classList.remove('dc-hidden');

  dc360.modal.classList.add('dc-open');
  document.body.style.overflow = 'hidden';

  dc360.stage = document.getElementById('dc-360-stage');
  dc360.img = document.getElementById('dc-360-img');
  dc360.frame = 0;

  if (dc360.img.complete && dc360.img.naturalWidth > 0) {
    dc360Init();
  } else {
    dc360.img.addEventListener('load', function() { dc360Init(); }, { once: true });
  }
}

function dc360Init() {
  var w = dc360.img.naturalWidth;
  var h = dc360.img.naturalHeight;
  if (w > 0 && h > 0) {
    dc360.frames = Math.max(2, Math.round(w / h));
    dc360.frameW = w / dc360.frames;
  } else {
    dc360.frames = 36;
    dc360.frameW = 1;
    h = 1;
  }
  // Scale the sprite so exactly one frame fits the square stage.
  var stageW = dc360.stage.clientWidth || Math.floor(window.innerWidth * 0.8);
  var stageH = dc360.stage.clientHeight || stageW;
  dc360.scale = Math.min(stageW / dc360.frameW, stageH / h);
  dc360.dragPixelsPerFrame = Math.max(8, stageW / dc360.frames);
  dc360.frame = 0;
  dc360Render();
}

function dc360Render() {
  if (!dc360.img) return;
  var n = dc360.frames;
  dc360.frame = ((dc360.frame % n) + n) % n;
  var fw = dc360.frameW;
  dc360.img.style.width = (dc360.scale * n * fw) + 'px';
  dc360.img.style.height = 'auto';
  dc360.img.style.transform = 'translateX(' + (-dc360.frame * fw * dc360.scale) + 'px)';
  dc360.img.style.opacity = '1';
}

function dc360Show(f) {
  dc360.frame = f;
  dc360Render();
}
function dc360StartAuto() {
  dc360StopAuto();
  dc360.interval = setInterval(function() {
    dc360.frame++;
    dc360Render();
  }, 90);
}

function dc360StopAuto() {
  if (dc360.interval) {
    clearInterval(dc360.interval);
    dc360.interval = null;
  }
}

function close360Viewer() {
  dc360StopAuto();
  var modal = document.getElementById('image-360-modal');
  var backdrop = document.getElementById('dc-modal-backdrop');
  if (modal) modal.classList.remove('dc-open');
  if (backdrop) backdrop.classList.add('dc-hidden');
  document.body.style.overflow = '';
  dc360.dragging = false;
  dc360.stage = null;
  dc360.img = null;
  dc360.modal = null;
  var restoreThumb = dcActiveImageThumb || document.querySelector('.dc-thumb:not(.dc-thumb-media)');
  document.querySelectorAll('.dc-thumb').forEach(function(t) { t.classList.remove('active'); });
  if (restoreThumb) restoreThumb.classList.add('active');
}

document.addEventListener('DOMContentLoaded', function() {
  var stage = document.getElementById('dc-360-stage');
  if (!stage) return;

  stage.addEventListener('pointerdown', function(e) {
    dc360StopAuto();
    dc360.dragging = true;
    dc360.lastX = e.clientX;
    dc360.dragDistance = 0;
    stage.classList.add('dc-360-dragging');
    stage.setPointerCapture(e.pointerId);
  });

  stage.addEventListener('pointermove', function(e) {
    if (!dc360.dragging) return;
    dc360.dragDistance += e.clientX - dc360.lastX;
    dc360.lastX = e.clientX;

    var frameDelta = Math.trunc(dc360.dragDistance / dc360.dragPixelsPerFrame);
    if (frameDelta !== 0) {
      dc360.frame -= frameDelta;
      dc360.dragDistance -= frameDelta * dc360.dragPixelsPerFrame;
      dc360Render();
    }
  });

  stage.addEventListener('pointerup', function() {
    dc360.dragging = false;
    stage.classList.remove('dc-360-dragging');
  });

  stage.addEventListener('pointercancel', function() {
    dc360.dragging = false;
    stage.classList.remove('dc-360-dragging');
  });

  stage.addEventListener('wheel', function(e) {
    e.preventDefault();
    dc360StopAuto();
    dc360.frame += (e.deltaY > 0 ? 1 : -1);
    dc360Render();
  }, { passive: false });

  stage.addEventListener('dblclick', function() {
    if (dc360.interval) {
      dc360StopAuto();
    } else {
      dc360StartAuto();
    }
  });
});
</script>

<script type="text/javascript">
(function() {
  function clearNodes(selector) {
    document.querySelectorAll(selector).forEach(function(node) { node.remove(); });
  }

  window.compare = {
    _request: function(action, product_id, variant_id) {
      var body = 'product_id=' + encodeURIComponent(product_id) + '&csrf_token=' + encodeURIComponent(window.dcCsrfToken || '');

      if (variant_id && parseInt(variant_id, 10) > 0) {
        body += '&variant_id=' + encodeURIComponent(variant_id);
      }

      return fetch('index.php?route=product/compare/' + action, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: body
      }).then(function(response) { return response.json(); });
    },
    _setActive: function(product_id, active) {
      var compareBtn = document.getElementById('dc-compare-btn');
      if (!compareBtn) {
        return;
      }

      compareBtn.dataset.inCompare = active ? '1' : '0';

      if (active) {
        compareBtn.classList.remove('border-gray-200', 'hover:border-blue-200', 'hover:bg-blue-50');
        compareBtn.classList.add('border-blue-300', 'bg-blue-50');
      } else {
        compareBtn.classList.remove('border-blue-300', 'bg-blue-50');
        compareBtn.classList.add('border-gray-200', 'hover:border-blue-200', 'hover:bg-blue-50');
      }

      var icon = compareBtn.querySelector('i[data-lucide="chart-no-axes-column"]');
      if (icon) {
        if (active) {
          icon.classList.remove('text-gray-500');
          icon.classList.add('text-blue-500', 'fill-blue-400');
        } else {
          icon.classList.remove('text-blue-500', 'fill-blue-400');
          icon.classList.add('text-gray-500');
        }
      }
    },
    add: function(product_id, variant_id) {
      this._request('add', product_id, variant_id)
      .then(function(json) {
        if (json.success) {
          if (typeof dcShowToast === 'function') dcShowToast(json.success);

          var compareTotal = document.querySelector('#compare-total span');
          if (compareTotal && json.total !== undefined) {
            compareTotal.textContent = json.total;
            compareTotal.classList.toggle('hidden', json.total <= 0);
          }

          window.compare._setActive(product_id, true);
        }
      })
      .catch(function(error) {
        console.error('Compare add error:', error);
      });
    },
    remove: function(product_id, variant_id) {
      this._request('remove', product_id, variant_id)
      .then(function(json) {
        if (json.success) {
          if (typeof dcShowToast === 'function') dcShowToast(json.success);

          var compareTotal = document.querySelector('#compare-total span');
          if (compareTotal && json.total !== undefined) {
            compareTotal.textContent = json.total;
            compareTotal.classList.toggle('hidden', json.total <= 0);
          }

          window.compare._setActive(product_id, false);
        }
      })
      .catch(function(error) {
        console.error('Compare remove error:', error);
      });
    }
  };

  function clearOptionErrorState() {
    document.querySelectorAll('#product .dc-option-required-error').forEach(function(el) {
      el.classList.remove('dc-option-required-error');
    });
  }

  function markOptionErrorByKey(key) {
    if (!key) return null;
    var normalizedKey = String(key).replace('_', '-');
    var target = document.getElementById('input-option' + normalizedKey);

    if (!target) {
      target = document.querySelector('[name="option[' + key + ']"]') || document.querySelector('[name="option[' + key + '][]"]');
    }

    if (target) {
      target.classList.add('dc-option-required-error');
    }

    return target;
  }

  function serializeProductForm() {
    var formScope = document.getElementById('product');
    // Include number inputs so quantity is submitted (supports fractional quantities)
    var fields = formScope ? formScope.querySelectorAll('input[type="text"], input[type="hidden"], input[type="number"], input[type="radio"]:checked, input[type="checkbox"]:checked, select, textarea') : [];
    var params = new URLSearchParams();

    fields.forEach(function(field) {
      if (!field.name) {
        return;
      }
      params.append(field.name, field.value || '');
    });

    return params;
  }

  function setInputNativeType(selector, type) {
    document.querySelectorAll(selector).forEach(function(input) {
      input.setAttribute('type', type);
      if (type === 'date') {
        input.setAttribute('placeholder', 'YYYY-MM-DD');
      }
      if (type === 'datetime-local') {
        input.setAttribute('placeholder', 'YYYY-MM-DDTHH:mm');
      }
      if (type === 'time') {
        input.setAttribute('placeholder', 'HH:mm');
      }
    });
  }

  function setWishlistButtonState(btn, active) {
    if (!btn) return;

    var icon = btn.querySelector('[data-lucide="heart"]');

    btn.classList.toggle('bg-rose-50', !!active);
    btn.classList.toggle('border-rose-300', !!active);
    btn.classList.toggle('border-gray-200', !active);
    btn.setAttribute('data-in-wishlist', active ? '1' : '0');

    if (icon) {
      icon.classList.toggle('text-rose-500', !!active);
      icon.classList.toggle('fill-rose-400', !!active);
      icon.classList.toggle('text-gray-500', !active);
    }
  }

  if (typeof window.dcAddToWishlist !== 'function') {
    window.dcAddToWishlist = function(productId, clickedBtn, variantId) {
      var button = clickedBtn || document.getElementById('dc-wishlist-btn');
      var active = button && button.getAttribute('data-in-wishlist') === '1';

      var body = 'product_id=' + encodeURIComponent(productId) + '&csrf_token=' + encodeURIComponent(window.dcCsrfToken || '');

      if (variantId && parseInt(variantId, 10) > 0) {
        body += '&variant_id=' + encodeURIComponent(variantId);
      }

      if (active) {
        fetch('index.php?route=account/wishlist/remove', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: body
        })
        .then(function() {
          setWishlistButtonState(button, false);
          if (typeof dcShowToast === 'function') {
            dcShowToast('Removed from wishlist');
          }
        });

        return;
      }

      if (window.wishlist && typeof window.wishlist.add === 'function') {
        window.wishlist.add(productId, variantId || 0);
      }

      setWishlistButtonState(button, true);
    };
  }

  document.addEventListener('DOMContentLoaded', function() {
    var quantityInput = document.getElementById('input-quantity');
    var cartButton = document.getElementById('button-cart');
    var wishlistButton = document.getElementById('dc-wishlist-btn');
    var compareButton = document.getElementById('dc-compare-btn');

    if (wishlistButton) {
      wishlistButton.addEventListener('click', function(e) {
        e.preventDefault();
        var productId = wishlistButton.getAttribute('data-product-id');
        if (!productId) return;
        var variantId = window.dcCurrentVariant ? window.dcCurrentVariant.variant_id : 0;
        window.dcAddToWishlist(productId, wishlistButton, variantId);
      });
    }

    if (compareButton) {
      compareButton.addEventListener('click', function(e) {
        e.preventDefault();
        var productId = compareButton.getAttribute('data-product-id');
        if (!productId) return;
        var variantId = window.dcCurrentVariant ? window.dcCurrentVariant.variant_id : 0;
        window.dcToggleCompare(productId, compareButton, variantId);
      });
    }

    if (cartButton) {
      cartButton.addEventListener('click', function() {
        if (cartButton.disabled) return;
        var originalHTML = cartButton.innerHTML;
        var loadingText = cartButton.getAttribute('data-loading-text') || '...';

        cartButton.disabled = true;
        cartButton.textContent = loadingText;

        fetch('index.php?route=checkout/cart/add', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: serializeProductForm().toString()
        })
        .then(function(response) { return response.json(); })
        .then(function(json) {
          clearNodes('.dc-field-error');
          clearOptionErrorState();

          if (json.error) {
            if (json.error.option) {
              var firstErrorTarget = null;

              Object.keys(json.error.option).forEach(function(key) {
                var element = markOptionErrorByKey(key);
                if (!element) return;

                if (!firstErrorTarget) {
                  firstErrorTarget = element;
                }

                var errorNode = document.createElement('div');
                errorNode.className = 'dc-field-error text-xs text-red-500 mt-1';
                errorNode.textContent = json.error.option[key];
                element.insertAdjacentElement('afterend', errorNode);
              });

              if (firstErrorTarget && typeof firstErrorTarget.scrollIntoView === 'function') {
                firstErrorTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
            }

            if (json.error.variant && typeof dcShowToast === 'function') {
              dcShowToast(json.error.variant);
            }

            if (json.error.quantity && typeof dcShowToast === 'function') {
              dcShowToast(json.error.quantity);
            } else if (typeof json.error === 'string' && typeof dcShowToast === 'function') {
              dcShowToast(json.error);
            }
          }

          if (json.success) {
            if (typeof dcRefreshCart === 'function') dcRefreshCart(true);
            if (typeof dcShowToast === 'function') dcShowToast(json.success);
          }
        })
        .catch(function(error) {
          console.error('Add to cart error:', error);
        })
        .finally(function() {
          cartButton.disabled = false;
          cartButton.innerHTML = originalHTML;
          if (window.lucide) lucide.createIcons({ nodes: [cartButton] });
        });
      });
    }

    document.addEventListener('click', function(e) {
      var uploadButton = e.target.closest('button[id^="button-upload"]');
      if (!uploadButton) return;

      e.preventDefault();
      clearNodes('#form-upload');

      var form = document.createElement('form');
      form.enctype = 'multipart/form-data';
      form.id = 'form-upload';
      form.style.display = 'none';

      var fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.name = 'file';

      form.appendChild(fileInput);

      var csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'csrf_token';
      csrfInput.value = window.dcCsrfToken || '';

      form.appendChild(csrfInput);
      document.body.appendChild(form);

      fileInput.addEventListener('change', function() {
        if (!fileInput.files || !fileInput.files.length) return;

        var originalText = uploadButton.textContent;
        var loadingText = uploadButton.getAttribute('data-loading-text') || '...';

        uploadButton.disabled = true;
        uploadButton.textContent = loadingText;

        fetch('index.php?route=tool/upload', {
          method: 'POST',
          credentials: 'same-origin',
          body: new FormData(form)
        })
        .then(function(response) { return response.json(); })
        .then(function(json) {
          clearNodes('.dc-field-error');

          var targetInput = uploadButton.parentElement ? uploadButton.parentElement.querySelector('input[type="hidden"], input[type="text"]') : null;

          if (json.error && targetInput) {
            var err = document.createElement('div');
            err.className = 'dc-field-error text-xs text-red-500 mt-1';
            err.textContent = json.error;
            targetInput.insertAdjacentElement('afterend', err);
          }

          if (json.success) {
            alert(json.success);
            if (targetInput && json.code !== undefined) {
              targetInput.value = json.code;
            }
          }
        })
        .catch(function(error) {
          console.error('Upload error:', error);
        })
        .finally(function() {
          uploadButton.disabled = false;
          uploadButton.textContent = originalText;
        });
      }, { once: true });

      fileInput.click();
    });

    setInputNativeType('.date input', 'date');
    setInputNativeType('.datetime input', 'datetime-local');
    setInputNativeType('.time input', 'time');

    var productBlock = document.getElementById('product');
    if (productBlock) {
      productBlock.addEventListener('input', function(e) {
        if (e.target && e.target.name && e.target.name.indexOf('option[') === 0) {
          e.target.classList.remove('dc-option-required-error');
        }
      });

      productBlock.addEventListener('change', function(e) {
        if (e.target && e.target.name && e.target.name.indexOf('option[') === 0) {
          e.target.classList.remove('dc-option-required-error');
        }
      });
    }

  });
})();
</script>

