{{ header }}

<!-- GLightbox -->
<link rel="stylesheet" href="catalog/view/javascript/glightbox/glightbox.min.css" />

<style>
  .dc-thumb.active { border-color: #2563eb !important; box-shadow: 0 0 0 2px #dbeafe inset; }
  .option-btn { transition: border-color .15s, background .15s, color .15s; }
  .option-btn.active { border-color: #2563eb; background: #eff6ff; color: #1e3a8a; }
  .tab-btn { color: #6b7280; transition: color .15s, background .15s, border-color .15s; }
  .tab-btn.active { color: #2563eb; border-color: #2563eb !important; background: #eff6ff; }
  .zoom-hint { opacity: 0; transform: translateY(6px); transition: all .25s ease; }
  .zoom-target:hover .zoom-hint { opacity: 1; transform: translateY(0); }


  /* ── Rating stars ─────────────────────────────────────── */
  .dc-stars-row { display: inline-flex; gap: 3px; cursor: pointer; user-select: none; }
  .dc-stars-row .dc-star { font-size: 1.75rem; line-height: 1; color: #d1d5db; transition: color .1s, transform .1s; }
  .dc-stars-row .dc-star.lit { color: #f59e0b; }
  .dc-stars-row .dc-star:hover { transform: scale(1.2); }
  /* Review list stars (non-interactive) */
  .dc-stars { display: inline-flex; gap: 3px; }
  .dc-stars .dc-star { font-size: 1rem; color: #d1d5db; }
  .dc-stars .dc-star.active { color: #f59e0b; }
  .dc-option-required-error { border-color: #fca5a5 !important; box-shadow: 0 0 0 3px rgba(239,68,68,.12) !important; border-radius: 0.75rem; }
  .dc-color-swatch { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #e5e7eb; flex-shrink: 0; position: relative; }
  .dc-color-swatch--hit { border-color: #f9a825; box-shadow: 0 0 0 2px rgba(249,168,37,0.3); }
  .dc-color-hit { position: absolute; top: -4px; right: -4px; width: 14px; height: 14px; background: #f9a825; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; line-height: 1; }
  .dc-color-option { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 8px 12px; min-height: 88px; border-radius: 12px; border: 1px solid #e5e7eb; cursor: pointer; transition: border-color .15s, background .15s; }
  .dc-color-option.active { border-color: #2563eb; background: #eff6ff; }
  .dc-color-option.oos { cursor: not-allowed; border-color: #f3f4f6; opacity: 0.5; }

  /* ── 3D Modal (vanilla, no Bootstrap) ──────────────── */
  .dc-modal-overlay { position: fixed; inset: 0; z-index: 1050; background: rgba(0,0,0,0.5); }
  .dc-modal-overlay.dc-hidden { display: none; }
  #model-3d-modal { position: fixed; z-index: 1060; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90vw; display: none; }
  #model-3d-modal.dc-open { display: block; }
  #model-3d-modal .modal-dialog { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 90vw; margin: 0 auto; }
  #model-3d-modal .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #e5e7eb; }
  #model-3d-modal .modal-header .close { background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280; padding: 0; line-height: 1; }
  #model-3d-modal .modal-header .close:hover { color: #111827; }
  #model-3d-modal .modal-title { margin: 0; font-size: 16px; font-weight: 600; }
  #model-3d-modal .modal-body { padding: 0; }

</style>

<main class="py-20 sm:py-2 lg:py-4 px-4 sm:px-6 lg:px-8 bg-white">
  <!-- ─── BREADCRUMBS ─── -->
  <div class="max-w-7xl mx-auto mb-6">
    {% include 'dockercart/template/common/partials/breadcrumbs.twig' with {
      breadcrumbs_class: 'flex flex-wrap items-center gap-2 text-xs text-gray-500',
      breadcrumbs_link_class: 'hover:text-gray-900 transition',
      breadcrumbs_last_class: 'text-gray-700 font-semibold'
    } %}
  </div>
  <div class="max-w-7xl mx-auto">
    {{ content_top }}

    <!-- ─── PRODUCT ─── -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">

      <!-- Gallery -->
      <div class="lg:sticky lg:top-24 lg:z-10 self-start">
        <div class="rounded-3xl border border-gray-100 bg-gray-50 overflow-hidden">
          <button id="dc-zoom-btn" type="button" class="zoom-target group relative block w-full text-left" aria-label="{{ heading_title }}">
            <img id="dc-main-img" src="{{ display is not empty ? display : 'image/no_image.png' }}" data-popup="{{ popup is not empty ? popup : 'image/no_image.png' }}" alt="{{ heading_title }}" class="w-full {{ image_orientation == 'portrait' ? 'aspect-[3/4]' : (image_orientation == 'square' ? 'aspect-square' : 'aspect-[4/3]') }} object-cover cursor-zoom-in" />
            <span class="zoom-hint absolute bottom-3 right-3 inline-flex items-center gap-1.5 bg-gray-900/80 text-white text-[11px] font-semibold px-2.5 py-1.5 rounded-lg backdrop-blur-sm">
              <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i> {{ text_zoom }}
            </span>
            {% if video_type and video_url %}
            <span id="dc-video-overlay" role="button" tabindex="0" onclick="event.stopPropagation(); toggleProductVideo()" onkeydown="if(event.key==='Enter'){event.stopPropagation(); toggleProductVideo()}" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 flex items-center justify-center rounded-full bg-gray-900/60 hover:bg-gray-900/80 text-white backdrop-blur-sm cursor-pointer transition-transform duration-200 hover:scale-110 hover:shadow-xl" aria-label="{{ text_video }}">
              <i data-lucide="play" class="w-12 h-12"></i>
            </span>
            {% endif %}
          </button>
        </div>
        {% if video_type and video_url %}
        <div id="dc-video-player" class="rounded-3xl border border-gray-100 bg-gray-50 overflow-hidden" style="display:none;">
          {% if video_type == 'youtube' %}
          <iframe src="" id="dc-youtube-iframe" data-src="{{ video_url }}" class="w-full aspect-video" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
          {% elseif video_type == 'mp4' %}
          <video id="dc-mp4-video" class="w-full aspect-video" controls playsinline preload="metadata">
            <source src="{{ video_url }}" type="video/mp4">
          </video>
          {% endif %}
        </div>
        {% endif %}
        {% if images or model_3d or (video_type and video_url) %}
        <div class="grid grid-cols-4 gap-3 mt-3">
          <button class="dc-thumb active relative rounded-2xl border-2 overflow-hidden" data-img="{{ display is not empty ? display : 'image/no_image.png' }}" data-display="{{ display is not empty ? display : 'image/no_image.png' }}" data-popup="{{ popup is not empty ? popup : 'image/no_image.png' }}" data-orientation="{{ image_orientation }}">
            <img src="{{ thumb is not empty ? thumb : 'image/no_image.png' }}" alt="{{ heading_title }}" class="w-full h-20 object-cover" />
            {% if video_type and video_url %}
            <span class="pointer-events-none absolute bottom-1 right-1 inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-900/80 text-white">
              <i data-lucide="play" class="w-3.5 h-3.5"></i>
            </span>
            {% endif %}
          </button>
          {% for image in images %}
          <button class="dc-thumb rounded-2xl border-2 border-gray-200 overflow-hidden" data-img="{{ image.display is not empty ? image.display : 'image/no_image.png' }}" data-display="{{ image.display is not empty ? image.display : 'image/no_image.png' }}" data-popup="{{ image.popup is not empty ? image.popup : 'image/no_image.png' }}" data-orientation="{{ image.orientation }}">
            <img src="{{ image.thumb is not empty ? image.thumb : 'image/no_image.png' }}" alt="{{ heading_title }}" class="w-full h-20 object-cover" />
          </button>
          {% endfor %}
          {% if model_3d %}
          <button type="button" class="dc-thumb dc-thumb-media rounded-2xl border-2 border-gray-200 overflow-hidden flex flex-col items-center justify-center bg-gray-900 h-20" onclick="open3DViewer(this)">
            <i data-lucide="box" class="w-8 h-8 text-white mb-1"></i>
            <span class="text-white text-[10px]">3D</span>
          </button>
          {% endif %}
        </div>
        {% endif %}
      </div>

      <!-- 3D Model Modal -->
      {% if model_3d %}
      <div id="model-3d-modal">
        <div class="modal-dialog">
          <div class="modal-header">
            <h4 class="modal-title">{{ heading_title }} — 3D</h4>
            <button type="button" class="close" onclick="closeModal3d()" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          </div>
          <div class="modal-body">
            <model-viewer id="dc-model-viewer" src="{{ model_3d_url }}" alt="{{ heading_title }}" auto-rotate camera-controls ar ar-modes="webxr scene-viewer quick-look" style="width:100%;height:70vh;"></model-viewer>
          </div>
        </div>
      </div>
      <script type="importmap">
      {
        "imports": {
          "@google/model-viewer": "https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"
        }
      }
      </script>
      <script type="module">
        import '@google/model-viewer';
      </script>
      {% endif %}

      <!-- Info -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          {% if manufacturer %}<span class="text-xs font-bold uppercase tracking-widest text-blue-600">{{ manufacturer }}</span>{% endif %}
          <span id="dc-stock-badge" data-stock-display="{{ config_stock_display ? '1' : '0' }}" data-text-instock="{{ text_instock }}" data-text-preorder="{{ text_preorder }}" data-text-out-of-stock="{{ text_out_of_stock }}" class="px-2 py-0.5 rounded-full text-[10px] font-bold {% if is_preorder is defined and is_preorder %}bg-amber-100 text-amber-700{% elseif is_in_stock %}bg-emerald-100 text-emerald-700{% else %}bg-red-100 text-red-600{% endif %}">{{ stock }}</span>
        </div>

        <h1 id="dc-product-name" data-base-name="{{ base_product_name }}" data-base-meta-title="{{ base_meta_title }}" class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight">{{ heading_title }}</h1>

        {% if review_status %}
        <div class="flex flex-wrap items-center gap-3 mt-3">
          <div class="flex text-sm text-amber-400 gap-0.5">{% for i in 1..5 %}{% if rating >= i %}★{% else %}<span class="text-gray-300">★</span>{% endif %}{% endfor %}</div>
          <a href="#" onclick="document.querySelector('.tab-btn[data-tab=\'review\']').click();return false;" class="text-sm text-gray-500 hover:text-blue-600 transition">{{ reviews }}</a>
          <span class="text-sm text-gray-300">|</span>
          <span class="text-sm text-gray-500">{{ text_model }} <span id="dc-variant-sku" data-base-sku="{{ model }}">{{ is_configurable and variant_sku is defined and variant_sku ? variant_sku : model }}</span></span>
        </div>
        {% else %}
        <p class="text-sm text-gray-500 mt-3">{{ text_model }} <span id="dc-variant-sku" data-base-sku="{{ model }}">{{ is_configurable and variant_sku is defined and variant_sku ? variant_sku : model }}</span></p>
        {% endif %}

        {% set show_call_for_price = (call_for_price is defined and call_for_price) or ((call_for_price_status is defined and call_for_price_status) and call_for_price_phone is defined and call_for_price_phone and dc_base_price_value is defined and dc_base_price_value <= 0) %}

        {% if price %}
        <div class="mt-5">
          {% if show_call_for_price %}
            <a href="tel:{{ call_for_price_phone }}" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-base font-bold rounded-xl hover:bg-blue-700 active:bg-blue-800 transition shadow-sm shadow-blue-200">
              <i data-lucide="phone" class="w-5 h-5"></i>
              {{ text_call_for_price|default('Contact for price') }}
            </a>
          {% elseif not special %}
            <div class="flex items-baseline gap-3 flex-wrap" id="dc-price-regular">
              <span id="dc-unit-price" data-base-price="{{ dc_base_price_value|default(0) }}" data-current-price="{{ dc_base_price_value|default(0) }}" class="text-2xl sm:text-3xl font-extrabold text-gray-900">{{ price }}</span>
              {% if tax %}<span class="text-xs text-gray-400" id="dc-unit-tax">{{ text_tax }} {{ tax }}</span>{% endif %}
            </div>
            <div class="flex flex-col gap-1 hidden" id="dc-price-special">
              <span class="text-xs font-bold bg-red-500 text-white px-2 py-0.5 rounded-lg self-start" id="dc-sale-badge">{{ text_sale }}</span>
              <div class="flex items-baseline gap-2 sm:gap-3 flex-wrap">
                <span id="dc-unit-price-special" class="text-2xl sm:text-3xl font-extrabold text-gray-900"></span>
                <span id="dc-unit-price-strikethrough" class="text-sm sm:text-lg text-red-400 line-through"></span>
                {% if tax %}<span class="text-xs text-gray-400" id="dc-unit-tax">{{ text_tax }} {{ tax }}</span>{% endif %}
              </div>
            </div>
          {% else %}
            <div class="flex flex-col gap-1">
              <span class="text-xs font-bold bg-red-500 text-white px-2 py-0.5 rounded-lg self-start">{{ text_sale }}</span>
              <div class="flex items-baseline gap-2 sm:gap-3 flex-wrap">
                <span id="dc-unit-price" data-base-price="{{ dc_base_price_value|default(0) }}" data-current-price="{{ dc_base_price_value|default(0) }}" class="text-2xl sm:text-3xl font-extrabold text-gray-900">{{ special }}</span>
                <span class="text-sm sm:text-lg text-red-400 line-through">{{ price }}</span>
                {% if tax %}<span class="text-xs text-gray-400" id="dc-unit-tax">{{ text_tax }} {{ tax }}</span>{% endif %}
              </div>
        </div>
        {% if you_save_amount %}
        <div class="mt-1.5">
          <span class="text-sm font-semibold text-green-600">{{ text_you_save }}: {{ you_save_amount }}</span>
        </div>
        {% endif %}
        {% endif %}
      </div>
        {% if points %}<p class="text-xs text-blue-600 mt-1">{{ text_points }} {{ points }}</p>{% endif %}
        {% if discounts %}
        <div class="mt-2 space-y-0.5">{% for discount in discounts %}<p class="text-xs text-gray-500">{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</p>{% endfor %}</div>
        {% endif %}
        {% if gifts %}
        <div class="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-2xl">
          <h3 class="text-sm font-bold text-amber-800 flex items-center gap-1.5 mb-3">
            <i data-lucide="gift" class="w-4 h-4"></i> {{ text_gift }}
          </h3>
          <div class="space-y-3">
          {% for gift in gifts %}
          <div class="flex items-center gap-3">
            <img src="{{ gift.image }}" alt="{{ gift.name }}" class="w-16 h-16 rounded-lg object-cover border border-amber-100"/>
            <div class="flex-1 min-w-0">
              <a href="{{ gift.href }}" class="text-sm font-medium text-gray-800 hover:text-amber-600 transition line-clamp-2">{{ gift.name }}</a>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="text-xs text-red-400 line-through">{{ gift.price }}</span>
                <span class="text-xs text-emerald-600 font-bold">{{ text_free }}</span>
              </div>
              {% if gift.minimum_quantity > 1 %}
              <p class="text-xs text-gray-500 mt-0.5">{{ text_gift_minimum }}: {{ gift.minimum_quantity }}</p>
              {% endif %}
            </div>
          </div>
          {% endfor %}
          </div>
        </div>
        {% endif %}
        {% if bxgy_rules %}
        <div class="mt-4 p-4 bg-violet-50 border border-violet-200 rounded-2xl">
          <h3 class="text-sm font-bold text-violet-800 flex items-center gap-1.5 mb-3">
            <i data-lucide="zap" class="w-4 h-4"></i> {{ text_bxgy }}
          </h3>
          <div class="space-y-3">
          {% for rule in bxgy_rules %}
          <div class="flex items-center gap-3">
            <img src="{{ rule.image }}" alt="{{ rule.name }}" class="w-16 h-16 rounded-lg object-cover border border-violet-100"/>
            <div class="flex-1 min-w-0">
              <a href="{{ rule.href }}" class="text-sm font-medium text-gray-800 hover:text-violet-600 transition line-clamp-2">{{ rule.name }}</a>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="text-xs text-red-400 line-through">{{ rule.original_price }}</span>
                <span class="text-xs text-emerald-600 font-bold">{{ rule.discounted_price }}</span>
                <span class="text-[10px] text-violet-500 font-semibold bg-violet-100 px-1.5 py-0.5 rounded">{{ rule.discount_text }}</span>
              </div>
              <p class="text-xs text-gray-500 mt-0.5">{{ text_bxgy_discount }} &middot; {{ rule.trigger_quantity }}x</p>
            </div>
            <button type="button" onclick="cart.add('{{ rule.reward_product_id }}', 1);" class="flex-shrink-0 p-2 rounded-xl bg-violet-100 hover:bg-violet-200 text-violet-700 hover:text-violet-800 transition" title="{{ button_cart }}">
              <i data-lucide="shopping-cart" class="w-4 h-4"></i>
            </button>
          </div>
          {% endfor %}
          </div>
        </div>
        {% endif %}
        <p id="dc-subtotal" class="{% if minimum is defined and minimum > 1 %}text-lg text-blue-700 font-bold mt-2{% else %}hidden text-lg text-blue-700 font-bold mt-2{% endif %}"></p>
        {% endif %}

        {% if reward %}<p class="text-xs text-gray-500 mt-2">{{ text_reward }} {{ reward }}</p>{% endif %}

        <!-- Options + Cart form -->
        <div id="product">

          {% if options %}{% for option in options %}
          <div class="mt-5">
            <p class="text-sm font-semibold text-gray-800 mb-2">{{ option.name }}{% if option.required %} <span class="text-red-500">*</span>{% endif %}</p>

            {% if option.type == 'color' %}
            <div class="flex flex-wrap gap-2" id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              <label class="cursor-pointer">
                <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" data-option-price="{{ option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}" class="sr-only dc-option-radio"{{ is_selected ? ' checked' : '' }} />
                <span class="dc-color-option{{ is_selected ? ' active' : '' }}">
                  <span class="dc-color-swatch{% if option_value.is_hit %} dc-color-swatch--hit{% endif %}" style="background-color: {{ option_value.color_code }}">
                    {% if option_value.is_hit %}<span class="dc-color-hit" title="Hit">&#9733;</span>{% endif %}
                  </span>
                  <span class="text-xs font-semibold">{{ option_value.name }}</span>
                  {% if option_value.price and option_value.price_value != 0 %}<span class="text-[10px] text-gray-500">({{ option_value.price_prefix }}{{ option_value.price }})</span>{% endif %}
                </span>
              </label>
              {% endfor %}
            </div>

            {% elseif option.type == 'radio' %}
            <div class="flex flex-wrap gap-2" id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              <label class="cursor-pointer">
                <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" data-option-price="{{ option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}" class="sr-only dc-option-radio"{{ is_selected ? ' checked' : '' }} />
                <span class="option-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-sm font-semibold select-none border-gray-200{{ is_selected ? ' active' : '' }}">
                  {{ option_value.name }}{% if option_value.price and option_value.price_value != 0 %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                </span>
              </label>
              {% endfor %}
            </div>

            {% elseif option.type == 'select' %}
            <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm bg-white focus:outline-none focus:border-blue-400 transition appearance-none">
              <option value="">{{ text_select }}</option>
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              <option value="{{ option_value.product_option_value_id }}" data-option-price="{{ option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}"{{ is_selected ? ' selected' : '' }}>{{ option_value.name }}{% if option_value.price and option_value.price_value != 0 %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>
              {% endfor %}
            </select>

            {% elseif option.type == 'checkbox' %}
            <div class="flex flex-wrap gap-2" id="input-option{{ option.product_option_id }}">
              {% for option_value in option.product_option_value %}
              {% set is_selected = is_configurable and variant_selected is defined and option_value.product_option_value_id in variant_selected %}
              <label class="cursor-pointer">
                <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" data-option-price="{{ option_value.price_value|default(0) }}" data-option-prefix="{{ option_value.price_prefix|default('+') }}" class="sr-only dc-option-checkbox"{{ is_selected ? ' checked' : '' }} />
                <span class="option-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-sm font-semibold select-none border-gray-200{{ is_selected ? ' active' : '' }}">
                  {{ option_value.name }}{% if option_value.price and option_value.price_value != 0 %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                </span>
              </label>
              {% endfor %}
            </div>

            {% elseif option.type == 'text' %}
            <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition" />

            {% elseif option.type == 'textarea' %}
            <textarea name="option[{{ option.product_option_id }}]" rows="4" id="input-option{{ option.product_option_id }}" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-blue-400 transition resize-none">{{ option.value }}</textarea>

            {% elseif option.type == 'file' %}
            <button type="button" id="button-upload{{ option.product_option_id }}" data-loading-text="{{ text_loading }}" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold hover:bg-gray-50 transition">
              <i data-lucide="upload" class="w-4 h-4"></i> {{ button_upload }}
            </button>
            <input type="hidden" name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" />

            {% elseif option.type == 'date' %}
