<script>
(function () {
  function loadReview(url) {
    var review = document.getElementById('review');
    if (!review) return;

    review.style.opacity = '0.35';

    fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (response) { return response.text(); })
      .then(function (html) {
        review.innerHTML = html;
        review.style.opacity = '1';
        if (typeof window.lucide !== 'undefined' && typeof window.lucide.createIcons === 'function') {
          window.lucide.createIcons();
        }
      })
      .catch(function (error) {
        review.style.opacity = '1';
        console.error('Review load error:', error);
      });
  }

  function initReviewStars(container) {
    if (!container) return;
    container.querySelectorAll('.dc-stars-input').forEach(function (row) {
      var isCriteria = row.hasAttribute('data-criteria-input');
      if (isCriteria) {
        var field = row.closest('.dc-criteria-field');
        var hidden = field ? field.querySelector('input[type="hidden"]') : null;
        row.addEventListener('click', function (e) {
          var star = e.target.closest('.dc-star');
          if (!star) return;
          var val = parseInt(star.getAttribute('data-val'), 10);
          row.querySelectorAll('.dc-star').forEach(function (s) {
            s.classList.toggle('lit', parseInt(s.getAttribute('data-val'), 10) <= val);
          });
          if (hidden) hidden.value = val;
        });
      } else {
        var radios = row.parentElement.querySelectorAll('input[name="rating"]');
        row.addEventListener('click', function (e) {
          var star = e.target.closest('.dc-star');
          if (!star) return;
          var val = parseInt(star.getAttribute('data-val'), 10);
          row.querySelectorAll('.dc-star').forEach(function (s) {
            s.classList.toggle('lit', parseInt(s.getAttribute('data-val'), 10) <= val);
          });
          radios.forEach(function (r) { r.checked = String(r.value) === String(val); });
        });
      }
    });
  }

  function clearReviewForm(form) {
    if (!form) return;
    form.querySelectorAll('input[name="name"]').forEach(function (i) { i.value = ''; });
    form.querySelectorAll('textarea').forEach(function (i) { i.value = ''; });
    form.querySelectorAll('input[name="rating"]').forEach(function (r) { r.checked = false; });
    form.querySelectorAll('input[type="hidden"][name^="criteria["]').forEach(function (i) { i.value = ''; });
    form.querySelectorAll('.dc-stars-input .dc-star').forEach(function (s) { s.classList.remove('lit'); });
    var hp = form.querySelector('input[name="website"]');
    if (hp) hp.value = '';
    var img = form.querySelector('input[type="file"][name="images[]"]');
    if (img) img.value = '';
    var vidUrl = form.querySelector('input[name="video_url"]');
    if (vidUrl) vidUrl.value = '';
    var vidFile = form.querySelector('input[name="video_file"]');
    if (vidFile) vidFile.value = '';
    var previews = form.querySelector('#dc-review-upload-previews');
    if (previews) previews.innerHTML = '';
  }

  function initReviewUploads(form) {
    var fileInput = form.querySelector('#input-review-images');
    var previews = form.querySelector('#dc-review-upload-previews');
    if (!fileInput || !previews) return;

    fileInput.addEventListener('change', function () {
      previews.innerHTML = '';
      var files = Array.prototype.slice.call(fileInput.files || []);
      var max = parseInt(fileInput.getAttribute('data-max'), 10) || 3;
      files.slice(0, max).forEach(function (file, index) {
        if (!file.type || file.type.indexOf('image/') !== 0) return;
        var reader = new FileReader();
        reader.onload = function (e) {
          var item = document.createElement('div');
          item.className = 'item';
          var img = document.createElement('img');
          img.src = e.target.result;
          img.alt = 'preview';
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'remove';
          btn.textContent = '×';
          btn.addEventListener('click', function () {
            var dt = new DataTransfer();
            Array.prototype.slice.call(fileInput.files || []).forEach(function (f, i) {
              if (i !== index) dt.items.add(f);
            });
            fileInput.files = dt.files;
            item.remove();
          });
          item.appendChild(img);
          item.appendChild(btn);
          previews.appendChild(item);
        };
        reader.readAsDataURL(file);
      });
    });
  }

  function initReviewLightbox() {
    if (typeof window.GLightbox === 'function') return;
    document.addEventListener('click', function (e) {
      var opener = e.target.closest('.dc-review-thumb');
      if (!opener) return;
      var popup = opener.getAttribute('data-popup') || opener.getAttribute('href');
      if (!popup) return;
      e.preventDefault();
      var box = document.createElement('div');
      box.className = 'dc-lightbox';
      var img = document.createElement('img');
      img.src = popup;
      img.alt = '';
      var close = document.createElement('button');
      close.type = 'button';
      close.className = 'dc-lightbox-close';
      close.textContent = '×';
      close.addEventListener('click', function () { box.remove(); });
      box.addEventListener('click', function (ev) { if (ev.target === box) box.remove(); });
      box.appendChild(img);
      box.appendChild(close);
      document.body.appendChild(box);
    });
    document.addEventListener('click', function (e) {
      if (e.target.classList && e.target.classList.contains('dc-lightbox-close')) {
        e.target.parentElement.remove();
      }
    });
  }

  function initReviewModal() {
    var modal = document.getElementById('dc-review-modal');
    if (!modal) return;
    var lastTrigger = null;
    function openModal(trigger) {
      lastTrigger = trigger || document.activeElement;
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      var focusEl = modal.querySelector('input[name="name"], textarea[name="text"]');
      if (focusEl) focusEl.focus();
      if (typeof window.lucide !== 'undefined' && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        try { lastTrigger.focus(); } catch (e) {}
      }
    }
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-review-modal-open]');
      if (trigger) {
        e.preventDefault();
        openModal(trigger);
        return;
      }
      if (e.target.closest('[data-review-modal-close]')) {
        closeModal();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    var form = modal.querySelector('#form-review');
    if (form) {
      var observer = new MutationObserver(function () {
        var success = form.querySelector('.dc-review-alert');
        if (success && success.textContent.indexOf('Спасибо') !== -1) {
          setTimeout(closeModal, 1800);
        }
      });
      observer.observe(form, { childList: true, subtree: true });
    }
  }

  function initReviewAlerts(form) {
    form.addEventListener('click', function (e) {
      if (e.target.closest('.dc-review-alert .close')) {
        e.target.closest('.dc-review-alert').remove();
      }
    });
  }

  function bindReviewSubmit(form) {
    var button = form.querySelector('#button-review');
    if (!button) return;
    var productId = form.getAttribute('data-product-id');
    var action = form.getAttribute('data-write-url') || ('index.php?route=product/product/write&product_id=' + encodeURIComponent(productId));

    button.addEventListener('click', function () {
      var params = new FormData(form);
      button.disabled = true;

      fetch(action, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: params
      })
      .then(function (response) { return response.json(); })
      .then(function (json) {
        form.querySelectorAll('.dc-review-alert').forEach(function (el) { el.remove(); });

        if (json.error) {
          form.insertAdjacentHTML('afterbegin', '<div class="dc-review-alert flex items-start justify-between gap-3 text-sm text-red-600 bg-red-50 border border-red-200 rounded-xl p-3 mb-3"><span class="flex-1 min-w-0">' + json.error + '</span><button type="button" class="close shrink-0">×</button></div>');
        }

        if (json.success) {
          form.insertAdjacentHTML('afterbegin', '<div class="dc-review-alert flex items-start justify-between gap-3 text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl p-3 mb-3"><span class="flex-1 min-w-0">' + json.success + '</span><button type="button" class="close shrink-0">×</button></div>');
          clearReviewForm(form);

          var review = document.getElementById('review');
          if (review && review.getAttribute('data-ajax-load') === '1') {
            var ajaxUrl = review.getAttribute('data-ajax-url');
            if (ajaxUrl) loadReview(ajaxUrl);
          }
        }
      })
      .catch(function (error) {
        console.error('Review submit error:', error);
      })
      .finally(function () {
        button.disabled = false;
      });
    });
  }

  function initReviewShowMore() {
    document.addEventListener('click', function (e) {
      var showMore = e.target.closest('#dc-review-show-more');
      if (!showMore) return;

      e.preventDefault();
      e.stopPropagation();

      var ajaxBase = showMore.getAttribute('data-ajax-url');
      if (!ajaxBase) return;

      var url = new URL(ajaxBase, window.location.href);
      url.searchParams.set('page', showMore.getAttribute('data-next-page'));
      var sort = showMore.getAttribute('data-sort');
      if (sort) url.searchParams.set('sort', sort);

      var review = document.getElementById('review');
      if (!review) return;

      var originalHTML = showMore.innerHTML;
      showMore.disabled = true;
      showMore.textContent = '...';

      fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (response) { return response.text(); })
        .then(function (html) {
          var wrapper = document.createElement('div');
          wrapper.innerHTML = html;

          // Append new review cards (skip the header/sort block)
          wrapper.querySelectorAll('.dc-review-card').forEach(function (card) {
            review.appendChild(card);
          });

          // Replace the show-more button with the next one, if any
          var oldWrap = showMore.closest('.dc-review-show-more-wrap');
          if (oldWrap) oldWrap.remove();
          var next = wrapper.querySelector('#dc-review-show-more');
          if (next) {
            review.appendChild(next.closest('.dc-review-show-more-wrap'));
          }

          if (typeof window.lucide !== 'undefined' && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
          }
        })
        .catch(function (error) {
          console.error('Review load error:', error);
          showMore.disabled = false;
          showMore.innerHTML = originalHTML;
          if (typeof window.lucide !== 'undefined' && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
          }
        });
    });
  }

  function initReviewFragment() {
    var review = document.getElementById('review');
    if (!review || review.getAttribute('data-ajax-load') !== '1') return;
    var ajaxBase = review.getAttribute('data-ajax-url');
    if (!ajaxBase) return;

    document.addEventListener('click', function (e) {
      var link = e.target.closest('#review a');
      if (!link) return;
      if (link.classList.contains('dc-review-empty-write')) {
        return;
      }
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();

      var url = new URL(ajaxBase, window.location.href);
      var params = new URL(link.href, window.location.href).searchParams;

      ['sort', 'page'].forEach(function (key) {
        if (params.has(key)) {
          url.searchParams.set(key, params.get(key));
        }
      });

      loadReview(url.toString());
    });
  }

  function initReviewVotes() {
    document.addEventListener('click', function (e) {
      var button = e.target.closest('.dc-vote-btn');
      if (!button) return;

      var container = button.closest('.dc-review-votes');
      if (!container) return;

      var voteUrl = container.getAttribute('data-vote-url');
      if (!voteUrl) return;

      var reviewId = container.getAttribute('data-review-id');
      var vote = button.getAttribute('data-vote');

      // The server toggles: same vote again removes it, the other vote
      // switches. No need to send 'none'.

      button.disabled = true;

      fetch(voteUrl, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest' },
        body: 'review_id=' + encodeURIComponent(reviewId) + '&vote=' + encodeURIComponent(vote)
      })
      .then(function (response) { return response.json(); })
      .then(function (json) {
        if (json.error === 'login' && json.login_url) {
          window.location.href = json.login_url;
          return;
        }

        if (json.error) {
          if (typeof dcShowToast === 'function') dcShowToast(json.error);
          return;
        }

        if (json.success) {
          var likeBtn = container.querySelector('.dc-vote-like');
          var dislikeBtn = container.querySelector('.dc-vote-dislike');
          var likeCount = likeBtn.querySelector('.dc-vote-count');
          var dislikeCount = dislikeBtn.querySelector('.dc-vote-count');

          if (likeCount) likeCount.textContent = json.likes;
          if (dislikeCount) dislikeCount.textContent = json.dislikes;

          [likeBtn, dislikeBtn].forEach(function (btn) {
            var active = btn.getAttribute('data-vote') === json.my_vote;
            btn.classList.toggle('active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        }
      })
      .catch(function (error) {
        console.error('Review vote error:', error);
      })
      .finally(function () {
        button.disabled = false;
      });
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('form-review');
    var review = document.getElementById('review');

    if (form) {
      initReviewStars(form);
      initReviewUploads(form);
      initReviewAlerts(form);
      bindReviewSubmit(form);
    }

    // The guest form now lives on the dedicated reviews page, so loading the
    // product tab must not depend on a form being present in the DOM.
    if (review && review.getAttribute('data-ajax-load') === '1' && !review.childElementCount) {
      var ajaxUrl = review.getAttribute('data-ajax-url');
      if (ajaxUrl) {
        loadReview(ajaxUrl);
      }
    }

    initReviewShowMore();
    initReviewFragment();
    initReviewLightbox();
    initReviewVotes();
    initReviewModal();
    if (typeof window.GLightbox === 'function') {
      window.GLightbox({ touchNavigation: true, loop: false });
    }
    if (typeof window.lucide !== 'undefined' && typeof window.lucide.createIcons === 'function') {
      window.lucide.createIcons();
    }
  });
})();
</script>
