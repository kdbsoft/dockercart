<style>
  /* ── Review system ─────────────────────────────────────────── */
  /* Fractional / partial stars */
  .dc-star { position: relative; display: inline-block; color: #d1d5db; line-height: 1; }
  .dc-star.active { color: #f59e0b; }
  .dc-star.dc-star-partial { color: #d1d5db; }
  .dc-star.dc-star-partial::after { content: '★'; position: absolute; inset: 0; color: #f59e0b; clip-path: inset(0 calc(100% - var(--pct)) 0 0); }
  .dc-stars { display: inline-flex; gap: 3px; }
  .dc-stars .dc-star { font-size: 1rem; }
  .dc-stars-sm .dc-star { font-size: 0.85rem; }

  /* Interactive rating input rows (criteria + overall) */
  .dc-stars-input { display: inline-flex; gap: 3px; cursor: pointer; user-select: none; }
  .dc-stars-input .dc-star { font-size: 1.5rem; transition: color .1s, transform .1s; }
  .dc-stars-input .dc-star.lit { color: #f59e0b; }
  .dc-stars-input .dc-star:hover { transform: scale(1.15); }

  /* Rating distribution bars */
  .dc-dist-bar { height: 6px; border-radius: 9999px; background: #f3f4f6; overflow: hidden; }
  .dc-dist-bar > span { display: block; height: 100%; border-radius: 9999px; background: #f59e0b; }

  /* Review image gallery thumbnails */
  .dc-review-thumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .dc-review-thumb { width: 76px; height: 76px; border-radius: 10px; overflow: hidden; border: 1px solid #e5e7eb; cursor: pointer; background: #f9fafb; }
  .dc-review-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Lightbox */
  .dc-lightbox { position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,.88); display: flex; align-items: center; justify-content: center; padding: 24px; }
  .dc-lightbox.dc-hidden { display: none; }
  .dc-lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 12px; }
  .dc-lightbox-close { position: absolute; top: 18px; right: 22px; background: rgba(255,255,255,.12); border: none; color: #fff; width: 42px; height: 42px; border-radius: 9999px; font-size: 22px; cursor: pointer; }

  /* Upload previews in the write form */
  .dc-review-upload-preview { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .dc-review-upload-preview .item { position: relative; width: 76px; height: 76px; border-radius: 10px; overflow: hidden; border: 1px solid #e5e7eb; }
  .dc-review-upload-preview .item img { width: 100%; height: 100%; object-fit: cover; }
  .dc-review-upload-preview .item .remove { position: absolute; top: 2px; right: 2px; width: 20px; height: 20px; border-radius: 9999px; background: rgba(0,0,0,.55); color: #fff; border: none; font-size: 12px; line-height: 1; cursor: pointer; }

  /* Pagination (review list) */
  .pagination { display: inline-flex; flex-wrap: wrap; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .pagination li a, .pagination li span { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 12px; color: #4b5563; text-decoration: none; transition: border-color .15s, color .15s; }
  .pagination li.active span { background: #eff6ff; border-color: #93c5fd; color: #2563eb; font-weight: 600; }
  .pagination li a:hover { border-color: #93c5fd; color: #2563eb; }
  .pagination li { margin: 0; }
</style>
