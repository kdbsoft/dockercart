<style>
  .dc-star { position: relative; display: inline-block; color: #e5e7eb; line-height: 1; }
  .dc-star.active { color: #f59e0b; }
  .dc-star.dc-star-partial { color: #e5e7eb; }
  .dc-star.dc-star-partial::after { content: '★'; position: absolute; inset: 0; color: #f59e0b; clip-path: inset(0 calc(100% - var(--pct)) 0 0); }
  .dc-stars { display: inline-flex; gap: 0; }
  .dc-stars .dc-star { font-size: 16px; }
  .dc-stars-sm .dc-star { font-size: 13px; }
  .dc-stars-hero .dc-star { font-size: 20px; }
  .dc-stars-summary .dc-star { font-size: 14px; }

  .dc-stars-input { display: inline-flex; gap: 4px; cursor: pointer; user-select: none; }
  .dc-stars-input .dc-star { font-size: 1.65rem; transition: color .15s, transform .15s; }
  .dc-stars-input .dc-star.lit { color: #f59e0b; }
  .dc-stars-input .dc-star:hover { transform: translateY(-2px) scale(1.1); }

  .dc-avatar {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .dc-review-hero { background: #f9fafb; border: 1px solid #f3f4f6; border-radius: 1rem; }
  .dc-review-overview { background: #f9fafb; border: 1px solid #f3f4f6; border-radius: 1rem; }
  .dc-review-overview-compact { background: #f9fafb; border: 1px solid #f3f4f6; border-radius: 1rem; }
  .dc-rating-number { color: #111827; letter-spacing: -.06em; }
  .dc-dist-bar { height: 8px; border-radius: 9999px; background: #f3f4f6; overflow: hidden; }
  .dc-dist-bar > span { display: block; height: 100%; border-radius: 9999px; background: #f59e0b; }
  .dc-rating-popover { opacity: 0; pointer-events: none; transition: opacity .15s ease; }
  .dc-rating-hover:hover .dc-rating-popover { opacity: 1; pointer-events: auto; }
  .dc-rating-popover, .dc-rating-popover * { cursor: auto; }
  .dc-rating-popover a { cursor: pointer; }

  .dc-review-card { position: relative; transition: border-color .2s; }
  .dc-review-card-divider { height: 1px; background: #f3f4f6; }

  .dc-review-thumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .dc-review-thumb { width: 64px; height: 64px; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb; cursor: pointer; background: #f9fafb; transition: border-color .2s, box-shadow .2s; }
  .dc-review-thumb:hover { border-color: #93c5fd; box-shadow: 0 0 0 3px #dbeafe; }
  .dc-review-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .dc-lightbox { position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,.88); display: flex; align-items: center; justify-content: center; padding: 24px; }
  .dc-lightbox.dc-hidden { display: none; }
  .dc-lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 12px; }
  .dc-lightbox-close { position: absolute; top: 18px; right: 22px; background: rgba(255,255,255,.12); border: none; color: #fff; width: 42px; height: 42px; border-radius: 9999px; font-size: 22px; cursor: pointer; }

  .dc-review-upload-preview { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .dc-review-upload-preview .item { position: relative; width: 76px; height: 76px; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb; }
  .dc-review-upload-preview .item img { width: 100%; height: 100%; object-fit: cover; }
  .dc-review-upload-preview .item .remove { position: absolute; top: 2px; right: 2px; width: 20px; height: 20px; border-radius: 9999px; background: rgba(0,0,0,.55); color: #fff; border: none; font-size: 12px; line-height: 1; cursor: pointer; }

  .dc-review-sort { display: inline-flex; gap: 4px; padding: 3px; background: #f3f4f6; border-radius: 9999px; }
  .dc-review-sort a { padding: 6px 14px; border-radius: 9999px; font-size: 13px; font-weight: 700; color: #6b7280; text-decoration: none; transition: background .15s, color .15s, box-shadow .15s; }
