  .dc-review-sort a:hover:not(.active) { color: #374151; }

  .dc-review-show-more-btn { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 20px; background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; font-size: 14px; font-weight: 700; color: #374151; cursor: pointer; transition: border-color .15s, background .15s; }
  .dc-review-show-more-btn:hover { border-color: #93c5fd; background: #eff6ff; color: #1d4ed8; }
  .dc-review-show-more-btn:disabled { opacity: .6; cursor: wait; }

  .dc-review-modal { position: fixed; inset: 0; z-index: 100; display: flex; overflow-y: auto; padding: 16px; }
  .dc-review-modal.hidden { display: none; }
  .dc-review-modal-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.5); backdrop-filter: blur(4px); }
  .dc-review-modal-card { position: relative; margin: auto; width: 100%; max-width: 640px; background: #fff; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
  .dc-review-modal-head { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 22px 28px 18px; background: #fff; border-bottom: 1px solid #f3f4f6; border-radius: 16px 16px 0 0; }
  .dc-review-modal-body { padding: 24px 28px 28px; }
  .dc-review-modal-body #form-review > div:not(.dc-review-alert) { display: flex; flex-direction: column; gap: 24px; }
  .dc-review-modal-body #form-review > div > * { margin-top: 0 !important; }
  .dc-review-modal-body #form-review > div > .grid { display: grid !important; }

  .pagination { display: inline-flex; flex-wrap: wrap; gap: 5px; list-style: none; margin: 0; padding: 0; }
  .pagination li a, .pagination li span { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0 9px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 12px; color: #4b5563; text-decoration: none; transition: border-color .15s, color .15s, background .15s; }
  .pagination li.active span { background: #2563eb; border-color: #2563eb; color: #fff; font-weight: 700; }
  .pagination li a:hover { border-color: #93c5fd; color: #2563eb; background: #eff6ff; }
  .pagination li { margin: 0; }

  @media (max-width: 639px) {
    .dc-review-thumb { width: 56px; height: 56px; }
    .dc-review-modal { padding: 12px; }
    .dc-review-modal-card { border-radius: 16px 16px 0 0; }
    .dc-review-sort { width: 100%; overflow-x: auto; }
  }
</style>
