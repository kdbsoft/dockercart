{#
  sale_timer.twig
  Countdown timer for the product page — shown for products with an active
  special price (sale). Displays the remaining time as four labelled units
  (days, hours, minutes, seconds) in a single row. The days unit is hidden
  once it hits 0.

  The element is always rendered when the timer feature is enabled (even with
  special_date_end = 0) so the variant-switching JS can reveal it dynamically
  for variants that carry their own special. When no sale is active it is
  hidden via the `hidden` class and carries data-countdown-until="0".

  Required variables:
    special_date_end  — unix timestamp of the special's end date (0 = none)

  Optional variables:
    sale_timer_status          — 1 show (default) / 0 hide
    timer_label                — localized label, e.g. "Sale ends in"
    timer_label_days           — localized "days" label (falls back to "days")
    timer_label_hours          — localized "hours" label (falls back to "hrs")
    timer_label_minutes        — localized "minutes" label (falls back to "min")
    timer_label_seconds        — localized "seconds" label (falls back to "sec")
    timer_class                — extra classes appended to the wrapper

  The countdown is driven by sale-timer.js via [data-countdown-until]. Each
  unit cell is addressed by [data-timer-cell] / [data-timer-unit].
#}
{% if sale_timer_status is not defined or sale_timer_status == 1 %}
<div class="dc-sale-timer mt-3 self-start inline-flex flex-col items-start gap-2 bg-red-50 border border-red-200 rounded-xl px-3 py-2 {{ timer_class|default('') }}{% if not (special_date_end is defined and special_date_end) %} hidden{% endif %}" data-countdown-until="{{ special_date_end|default(0) }}" role="timer">
  <span class="flex items-center gap-1.5 shrink-0">
    <i data-lucide="timer" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
    {% if timer_label is defined and timer_label %}<span class="text-[11px] font-bold text-red-500 uppercase tracking-wider whitespace-nowrap">{{ timer_label }}</span>{% endif %}
  </span>
  <div class="flex items-center gap-1.5">
    <div data-timer-cell="days" class="flex flex-col items-center bg-white border border-red-100 rounded-lg px-2 py-1 shadow-sm">
      <div data-timer-unit="days" class="text-base font-extrabold text-gray-900 leading-none tabular-nums">--</div>
      <div class="mt-0.5 text-[9px] font-semibold text-red-400 uppercase tracking-wide">{{ timer_label_days|default('days') }}</div>
    </div>
    <div data-timer-cell="hours" class="flex flex-col items-center bg-white border border-red-100 rounded-lg px-2 py-1 shadow-sm">
      <div data-timer-unit="hours" class="text-base font-extrabold text-gray-900 leading-none tabular-nums">--</div>
      <div class="mt-0.5 text-[9px] font-semibold text-red-400 uppercase tracking-wide">{{ timer_label_hours|default('hrs') }}</div>
    </div>
    <div data-timer-cell="minutes" class="flex flex-col items-center bg-white border border-red-100 rounded-lg px-2 py-1 shadow-sm">
      <div data-timer-unit="minutes" class="text-base font-extrabold text-gray-900 leading-none tabular-nums">--</div>
      <div class="mt-0.5 text-[9px] font-semibold text-red-400 uppercase tracking-wide">{{ timer_label_minutes|default('min') }}</div>
    </div>
    <div data-timer-cell="seconds" class="flex flex-col items-center bg-white border border-red-100 rounded-lg px-2 py-1 shadow-sm">
      <div data-timer-unit="seconds" class="text-base font-extrabold text-gray-900 leading-none tabular-nums">--</div>
      <div class="mt-0.5 text-[9px] font-semibold text-red-400 uppercase tracking-wide">{{ timer_label_seconds|default('sec') }}</div>
    </div>
    <i data-lucide="flame" class="w-3.5 h-3.5 text-red-400 flex-shrink-0"></i>
  </div>
</div>
{% endif %}
