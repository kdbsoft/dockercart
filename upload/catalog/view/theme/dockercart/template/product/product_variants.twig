{% if is_configurable and dc_variant_json %}
<script type="text/javascript"><!--
(function() {
	var matrix = {{ dc_variant_json|raw }};
	if (!matrix.axes || !matrix.axes.length) return;

	var productEl = document.getElementById('product');
	if (!productEl) return;

	var variantMap = {};
	var compatMap = {};

	function variantInStock(v) {
		if (matrix.preorder) return true;
		var qty = parseFloat(v.quantity);
		return (!isNaN(qty) && qty > 0);
	}

	function variantHasValues(v, pairs) {
		var vpairs = {};
		(v.values || []).forEach(function(vv) {
			vpairs[vv.option_id] = vv.option_value_id;
		});

		for (var i = 0; i < pairs.length; i++) {
			var parts = pairs[i].split(':');
			if (vpairs[parts[0]] != parts[1]) return false;
		}
		return true;
	}

	matrix.variants.forEach(function(v) {
		var key = (v.values || []).map(function(vv) {
			return vv.option_id + ':' + vv.option_value_id;
		}).sort().join('|');
		variantMap[key] = v;

		(v.values || []).forEach(function(vv) {
			if (!compatMap[vv.option_id]) compatMap[vv.option_id] = {};
			if (!compatMap[vv.option_id][vv.option_value_id]) compatMap[vv.option_id][vv.option_value_id] = {};

			(v.values || []).forEach(function(other) {
				if (other.option_id === vv.option_id && other.option_value_id === vv.option_value_id) return;
				compatMap[vv.option_id][vv.option_value_id][other.option_id + ':' + other.option_value_id] = true;
			});
		});
	});

	var variantInput = document.getElementById('dc-variant-id');
	var priceEl = document.getElementById('dc-unit-price');
	var priceSpecialEl = document.getElementById('dc-unit-price-special');
	var priceStrikethroughEl = document.getElementById('dc-unit-price-strikethrough');
	var priceRegularContainer = document.getElementById('dc-price-regular');
	var priceSpecialContainer = document.getElementById('dc-price-special');
	var mainImgEl = productEl.querySelector('img#dc-main-img');
	var cartBtn = document.getElementById('button-cart');
	var outOfStockEl = document.getElementById('dc-out-of-stock');
	var qtyWrapEl = document.getElementById('dc-qty-wrap');
	var productNameEl = document.getElementById('dc-product-name');
	var baseProductName = productNameEl ? (productNameEl.dataset.baseName || productNameEl.textContent.trim()) : '';
	var baseMetaTitle = productNameEl ? (productNameEl.dataset.baseMetaTitle || document.title) : document.title;
	var baseMetaDescEl = document.querySelector('meta[name="description"]');
	var baseMetaDesc = baseMetaDescEl ? baseMetaDescEl.getAttribute('content') : '';
	var stockBadgeEl = document.getElementById('dc-stock-badge');
	var defaultImgSrc = mainImgEl ? mainImgEl.src : '';
	var originalBasePrice = priceEl ? parseFloat(priceEl.dataset.basePrice || '0') : 0;
	var skuEl = document.getElementById('dc-variant-model');
	var originalSku = skuEl ? (skuEl.dataset.baseModel || skuEl.textContent) : '';
	var isInitPhase = true;
	var taxEls = document.querySelectorAll('[id^="dc-unit-tax"]');
	var discountsEl = document.getElementById('dc-variant-discounts');
	var discountText = '{{ text_discount|e('js') }}';
	var youSaveEl = document.getElementById('dc-you-save');
	var youSaveAmountEl = document.getElementById('dc-you-save-amount');
	var saleTimerEl = document.querySelector('.dc-sale-timer');

	function getOvIdForPov(axis, povId) {
		if (!axis.pov_map) return null;
		for (var ovId in axis.pov_map) {
			if (axis.pov_map[ovId] == povId) return parseInt(ovId);
		}
		return null;
	}

	function isValueAvailable(axis, ovId, currentSelection) {
		if (!compatMap[axis.option_id] || !compatMap[axis.option_id][ovId]) return false;
		var compat = compatMap[axis.option_id][ovId];

		for (var selOid in currentSelection) {
			if (selOid == axis.option_id) continue;
			var pair = selOid + ':' + currentSelection[selOid];
			if (!compat[pair]) return false;
		}
		return true;
	}

	function isValueInStock(axis, ovId, currentSelection) {
		var pairs = [axis.option_id + ':' + ovId];

		for (var selOid in currentSelection) {
			if (selOid == axis.option_id) continue;
			pairs.push(selOid + ':' + currentSelection[selOid]);
		}

		// There must be a single variant combining the current selection with
		// this value that is actually in stock.
		for (var i = 0; i < matrix.variants.length; i++) {
			var v = matrix.variants[i];
			if (variantInStock(v) && variantHasValues(v, pairs)) return true;
		}
		return false;
	}

	function updateAvailableOptions() {
		var currentSelection = {};

		matrix.axes.forEach(function(axis) {
			if (!axis.po_id) return;
			var input = productEl.querySelector('input[name="option[' + axis.po_id + ']"]:checked');
			if (!input) input = productEl.querySelector('select[name="option[' + axis.po_id + ']"]');
			if (input && input.value) {
				var ovId = getOvIdForPov(axis, input.value);
				if (ovId) currentSelection[axis.option_id] = ovId;
			}
		});

		matrix.axes.forEach(function(axis) {
			if (!axis.po_id) return;

			var inputs = productEl.querySelectorAll('input[name="option[' + axis.po_id + ']"]');
			if (!inputs.length) {
				var sel = productEl.querySelector('select[name="option[' + axis.po_id + ']"]');
				inputs = sel ? sel.options : [];
			}

			inputs.forEach(function(inp) {
				var val = inp.value;
				if (inp.tagName === 'INPUT') val = inp.value;
				if (!val) return;

				var ovId = getOvIdForPov(axis, val);
				if (!ovId) return;

				var available = Object.keys(currentSelection).length === 0 || isValueAvailable(axis, ovId, currentSelection);
				var inStock = isValueInStock(axis, ovId, currentSelection);
				var selectable = available && inStock;

				if (inp.tagName === 'OPTION') {
					inp.disabled = !selectable;
				} else {
					inp.disabled = !selectable;
					var label = inp.closest('label');
					if (label) {
						// Values that do not resolve to an enabled, in-stock
						// variant under the current selection are hidden
						// entirely instead of being greyed out (disabled
						// variants are not shown at all, like disabled products).
						label.classList.toggle('hidden', !selectable);
						label.classList.toggle('oos', available && !inStock);
					}
				}
			});
		});
	}

	function getSelectedAxes() {
		var allSet = true;

		for (var a = 0; a < matrix.axes.length; a++) {
			var axis = matrix.axes[a];
			if (!axis.po_id) continue;

			var input = productEl.querySelector('input[name="option[' + axis.po_id + ']"]:checked');
			if (!input) input = productEl.querySelector('select[name="option[' + axis.po_id + ']"]');

			if (input && input.value) {
				var ovId = getOvIdForPov(axis, input.value);
				if (!ovId) { allSet = false; break; }
				axis._selected = { po_id: axis.po_id, pov_id: input.value, ov_id: ovId };
			} else {
				axis._selected = null;
				allSet = false;
			}
		}
		return allSet ? matrix.axes : null;
	}

	function resolveVariant(axes) {
		if (!axes) return null;
		var pairs = [];
		axes.forEach(function(axis) {
			if (axis._selected) {
				pairs.push(axis.option_id + ':' + axis._selected.ov_id);
			}
		});
		pairs.sort();
		return variantMap[pairs.join('|')] || null;
	}

	function updateYouSave(variant, hasSpecial) {
		if (!youSaveEl || !youSaveAmountEl) return;

		// Never show savings when the price is on request (call for price)
		var isCfp = {{ show_call_for_price is defined and show_call_for_price ? 'true' : 'false' }};
		if (isCfp) {
			youSaveEl.classList.add('hidden');
			return;
		}

		var save = 0;

		if (hasSpecial && variant) {
			var full = parseFloat(variant.special_from);
			var actual = parseFloat(variant.special);
			if (!isNaN(full) && !isNaN(actual)) {
				save = full - actual;
			}
		}

		if (save > 0) {
			if (typeof dcFormatMoney === 'function') {
				youSaveAmountEl.textContent = dcFormatMoney(save);
			}
			youSaveEl.classList.remove('hidden');
		} else {
			youSaveEl.classList.add('hidden');
		}
	}

	function updateVariantUI(variant, preservePrice) {
		// Expose the current variant so dcUpdateSubtotal can apply tiered
		// quantity discounts to the subtotal (mirrors the cart).
		window.dcCurrentVariant = variant;
		if (variantInput) variantInput.value = variant ? variant.variant_id : '';

		var hasSpecial = variant && variant.special !== undefined && variant.special !== null && variant.special_from !== undefined && variant.special < variant.special_from;

		var hasPriceContainers = !!(priceEl && priceRegularContainer && priceSpecialContainer);

		if (hasPriceContainers && !preservePrice) {
			if (hasSpecial) {
				priceRegularContainer.classList.add('hidden');
				priceSpecialContainer.classList.remove('hidden');
				if (saleTimerEl) saleTimerEl.classList.remove('hidden');

				var specialPrice = parseFloat(variant.special);
				var regularPrice = parseFloat(variant.special_from);

				if (!isNaN(specialPrice)) {
					priceEl.dataset.salePrice = String(specialPrice);
				}

				if (typeof dcFormatMoney === 'function') {
					var symbol = priceEl.dataset.currencySymbol || '';
					if (priceSpecialEl) priceSpecialEl.textContent = dcFormatMoney(specialPrice, symbol);
					if (priceStrikethroughEl) priceStrikethroughEl.textContent = dcFormatMoney(regularPrice, symbol);
				}
			} else {
				priceSpecialContainer.classList.add('hidden');
				priceRegularContainer.classList.remove('hidden');
				if (saleTimerEl) saleTimerEl.classList.add('hidden');

				var price = (variant && variant.price !== null && variant.price !== undefined && parseFloat(variant.price) > 0) ? parseFloat(variant.price) : originalBasePrice;
				if (isNaN(price)) price = originalBasePrice;
				priceEl.dataset.salePrice = String(price);
				if (typeof dcFormatMoney === 'function') {
					var symbol = priceEl.dataset.currencySymbol || '';
					priceEl.textContent = dcFormatMoney(price, symbol);
				}
			}

			updateYouSave(variant, hasSpecial);
		}

		if (skuEl) {
			skuEl.textContent = (variant && (variant.model || variant.sku)) ? (variant.model || variant.sku) : originalSku;
		}

		// Tax (update every price container — regular and special variants of
		// the block both carry a #dc-unit-tax element)
		var taxText = (variant && variant.tax_text) ? '{{ text_tax|e('js') }} ' + variant.tax_text : '';
		if (taxEls) {
			taxEls.forEach(function(el) { el.textContent = taxText; });
		}

		// Quantity discounts
		if (discountsEl) {
			var vd = (variant && Array.isArray(variant.discounts)) ? variant.discounts : [];
			var vdList = document.getElementById('dc-variant-discounts-list');
			if (vdList) vdList.innerHTML = '';
			vd.forEach(function(d) {
				var label = document.createElement('span');
				label.className = 'text-gray-600 whitespace-nowrap';
				label.textContent = d.quantity + (discountText || ' ');
				var dash = document.createElement('span');
				dash.className = 'text-gray-400';
				dash.textContent = '\u2014';
				var price = document.createElement('span');
				price.className = 'font-semibold text-emerald-600 whitespace-nowrap';
				price.textContent = d.price;
				discountsEl.appendChild(label);
				discountsEl.appendChild(dash);
				discountsEl.appendChild(price);
			});
			discountsEl.classList.toggle('hidden', vd.length === 0);
		}

		// Sync price data for dcRecalcOptionPrice: basePrice is the full variant
		// price, salePrice is the price the customer actually pays (the sale
		// price when the variant is on sale).
		if (variant && variant.price !== null && variant.price !== undefined && parseFloat(variant.price) > 0) {
			var vFullPrice = parseFloat(variant.price);
			var vPrice = null;
			var hasOwnSpecial = variant.special !== undefined && variant.special !== null && parseFloat(variant.special) > 0
				&& variant.special_from !== undefined && parseFloat(variant.special) < vFullPrice;

			if (hasOwnSpecial) {
				vPrice = parseFloat(variant.special);
			} else if (preservePrice || (hasPriceContainers && !priceSpecialContainer.classList.contains('hidden'))) {
				// Server-rendered price is authoritative on init (the default
				// variant may be on a product-level sale): keep salePrice as is.
				vPrice = null;
			} else {
				// No own special and no server-rendered product special visible:
				// the customer pays the full variant price.
				vPrice = vFullPrice;
			}

			if (priceEl) {
				priceEl.dataset.basePrice = String(vFullPrice);
				if (vPrice !== null) {
					priceEl.dataset.salePrice = String(vPrice);
				}
			}
		} else {
			if (priceEl && originalBasePrice > 0) {
				priceEl.dataset.basePrice = String(originalBasePrice);
			}
		}

		if (!preservePrice && typeof dcRecalcOptionPrice === 'function') dcRecalcOptionPrice(); else if (!preservePrice && typeof dcUpdateSubtotal === 'function') dcUpdateSubtotal();

		if (variant && variant.image && mainImgEl) {
			mainImgEl.src = variant.image;
		} else if (mainImgEl && defaultImgSrc) {
			mainImgEl.src = defaultImgSrc;
		}

		var noVariant = !variant;

		// When the selected axis combination does not resolve to a variant
		// (e.g. all variants are disabled), treat it as out of stock instead
		// of falling into the in-stock branch.
		if (noVariant) {
			var isPreorder = !!matrix.preorder;

			if (cartBtn) cartBtn.classList.toggle('hidden', !isPreorder);
			if (qtyWrapEl) qtyWrapEl.classList.toggle('hidden', !isPreorder);
			if (outOfStockEl) outOfStockEl.classList.toggle('hidden', isPreorder);

			if (stockBadgeEl) {
				var stockText = stockBadgeEl.querySelector('.dc-stock-text');
				var stockIcon = stockBadgeEl.querySelector('.dc-stock-icon');
				if (isPreorder) {
					if (stockText) stockText.textContent = stockBadgeEl.dataset.textPreorder || '';
					stockBadgeEl.className = 'inline-flex items-center gap-1.5 text-sm font-semibold text-amber-600';
					if (stockIcon) stockIcon.classList.remove('hidden');
				} else {
					if (stockText) stockText.textContent = stockBadgeEl.dataset.textOutOfStock || '';
					stockBadgeEl.className = 'inline-flex items-center gap-1.5 text-sm font-semibold text-red-500';
					if (stockIcon) stockIcon.classList.add('hidden');
				}
			}
		} else if (variant && variant.quantity <= 0) {
			var isPreorder = !!matrix.preorder;

			if (cartBtn) cartBtn.classList.toggle('hidden', !isPreorder);
			if (qtyWrapEl) qtyWrapEl.classList.toggle('hidden', !isPreorder);
			if (outOfStockEl) outOfStockEl.classList.toggle('hidden', isPreorder);

			// Update stock badge
			if (stockBadgeEl) {
				var stockText = stockBadgeEl.querySelector('.dc-stock-text');
				var stockIcon = stockBadgeEl.querySelector('.dc-stock-icon');
				if (isPreorder) {
					if (stockText) stockText.textContent = stockBadgeEl.dataset.textPreorder || '';
					stockBadgeEl.className = 'inline-flex items-center gap-1.5 text-sm font-semibold text-amber-600';
					if (stockIcon) stockIcon.classList.remove('hidden');
				} else {
					if (stockText) stockText.textContent = stockBadgeEl.dataset.textOutOfStock || '';
					stockBadgeEl.className = 'inline-flex items-center gap-1.5 text-sm font-semibold text-red-500';
					if (stockIcon) stockIcon.classList.add('hidden');
				}
			}
		} else {
			if (cartBtn) cartBtn.classList.remove('hidden');
			if (qtyWrapEl) qtyWrapEl.classList.remove('hidden');
			if (outOfStockEl) outOfStockEl.classList.add('hidden');

			// Update stock badge
			if (stockBadgeEl) {
				var qty = variant ? parseFloat(variant.quantity) : 0;
				var showQty = stockBadgeEl.dataset.stockDisplay === '1' && qty > 0;
				var stockText = stockBadgeEl.querySelector('.dc-stock-text');
				var stockIcon = stockBadgeEl.querySelector('.dc-stock-icon');
				var instockLabel = stockBadgeEl.dataset.stockInstock || stockBadgeEl.dataset.textInstock || '';
				if (stockText) stockText.textContent = showQty ? String(Math.floor(qty)) : instockLabel;
				stockBadgeEl.className = 'inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600';
				if (stockIcon) stockIcon.classList.remove('hidden');
			}
		}

		// Update product name and meta title
		if (productNameEl && baseProductName) {
			if (variant && variant.values && variant.values.length) {
				var suffix = variant.values.map(function(v) { return v.name; }).join(' / ');
				productNameEl.textContent = baseProductName + ' — ' + suffix;
				document.title = baseMetaTitle + ' — ' + suffix;
			} else {
				productNameEl.textContent = baseProductName;
				document.title = baseMetaTitle;
			}
		}

		// Update meta description
		if (baseMetaDescEl && baseMetaDesc) {
			var newDesc = (variant && variant.values && variant.values.length)
				? baseMetaDesc + ' — ' + variant.values.map(function(v) { return v.name; }).join(' / ')
				: baseMetaDesc;
			baseMetaDescEl.setAttribute('content', newDesc);
			var ogDesc = document.querySelector('meta[property="og:description"]');
			if (ogDesc) ogDesc.setAttribute('content', newDesc);
			var twDesc = document.querySelector('meta[name="twitter:description"]');
			if (twDesc) twDesc.setAttribute('content', newDesc);
			var ogTitle = document.querySelector('meta[property="og:title"]');
			if (ogTitle) {
				ogTitle.setAttribute('content',
					(variant && variant.values && variant.values.length)
						? baseMetaTitle + ' — ' + variant.values.map(function(v) { return v.name; }).join(' / ')
						: baseMetaTitle
				);
			}
		}

		updateAvailableOptions();
	}

	/* ── URL sync: update /variant-N in pathname ── */
	function updateVariantUrl(variantId) {
		if (!window.history || !window.history.replaceState) return;
		var path = window.location.pathname;
		// Remove any existing /variant-N suffix
		path = path.replace(/\/variant-\d+$/, '');
		// Don't add suffix for default variant
		if (variantId && variantId != matrix.default_variant_id) {
			path += '/variant-' + variantId;
		}
		var newUrl = path + window.location.search + window.location.hash;
		if (newUrl !== window.location.pathname + window.location.search + window.location.hash) {
			window.history.replaceState({}, '', newUrl);
		}
	}

	/* ── Set axes from a variant (silent, no events) ── */
	function applyVariantAxes(variant) {
		if (!variant || !variant.values || !Array.isArray(variant.values)) return;
		variant.values.forEach(function(vv) {
			var axis = null;
			for (var a = 0; a < matrix.axes.length; a++) {
				if (matrix.axes[a].option_id == vv.option_id) { axis = matrix.axes[a]; break; }
			}
			if (!axis || !axis.po_id) return;
			var povId = axis.pov_map ? axis.pov_map[vv.option_value_id] : null;
			if (!povId) return;

			var inputs = productEl.querySelectorAll('input[name="option[' + axis.po_id + ']"]');
			if (inputs.length) {
				for (var ii = 0; ii < inputs.length; ii++) {
					inputs[ii].checked = (inputs[ii].value == povId);
				}
			} else {
				var sel = productEl.querySelector('select[name="option[' + axis.po_id + ']"]');
				if (sel) {
					for (var i = 0; i < sel.options.length; i++) {
						if (sel.options[i].value == povId) {
							sel.value = povId;
							break;
						}
					}
				}
			}
		});
	}

	/* ── Sync .active class on axis radio labels ── */
	function syncAxisActiveClasses() {
		matrix.axes.forEach(function(axis) {
			if (!axis.po_id) return;
			productEl.querySelectorAll('input[name="option[' + axis.po_id + ']"]').forEach(function(r) {
				if (r.nextElementSibling) {
					r.nextElementSibling.classList.toggle('active', r.checked);
				}
			});
		});
	}

	/* ── Resolve variant from current inputs ── */
	function getCurrentVariant() {
		var axes = getSelectedAxes();
		return axes ? resolveVariant(axes) : null;
	}

	/* ── Current selection as {option_id: option_value_id} ── */
	function getCurrentSelectionMap() {
		var map = {};

		matrix.axes.forEach(function(axis) {
			if (!axis.po_id) return;
			var input = productEl.querySelector('input[name="option[' + axis.po_id + ']"]:checked');
			if (!input) input = productEl.querySelector('select[name="option[' + axis.po_id + ']"]');
			if (input && input.value) {
				var ovId = getOvIdForPov(axis, input.value);
				if (ovId) map[axis.option_id] = ovId;
			}
		});

		return map;
	}

	/* ── Nearest in-stock variant containing the clicked value ──
	   Maximises how many axes match the current selection; on ties keeps
	   the first variant in matrix order (server sorts by sort_order ASC,
	   variant_id ASC). */
	function findNearestAvailableVariant(clickedOvId) {
		var sel = getCurrentSelectionMap();
		var best = null;
		var bestScore = -1;

		matrix.variants.forEach(function(v) {
			if (!variantInStock(v)) return;

			var contains = false;
			var score = 0;

			(v.values || []).forEach(function(vv) {
				if (vv.option_value_id == clickedOvId) contains = true;
				if (sel[vv.option_id] !== undefined && sel[vv.option_id] == vv.option_value_id) score++;
			});

			if (!contains || score <= bestScore) return;
			bestScore = score;
			best = v;
		});

		return best;
	}

	document.addEventListener('change', function(e) {
		var target = e.target;
		var name = target.name || '';
		var matches = name.match(/option\[(\d+)\]/);
		if (!matches) return;
		var poId = parseInt(matches[1]);

		var isAxis = false;
		for (var a = 0; a < matrix.axes.length; a++) {
			if (matrix.axes[a].po_id === poId) { isAxis = true; break; }
		}
		if (!isAxis) return;

		var variant = getCurrentVariant();

		// Click on an unavailable value (struck through / out of stock, or an
		// incomplete selection): instead of falling into "out of stock" and
		// dropping the variant from the URL, switch to the nearest in-stock
		// combination containing the clicked value.
		var clickedOvId = null;
		for (var a = 0; a < matrix.axes.length; a++) {
			if (matrix.axes[a].po_id === poId) {
				clickedOvId = getOvIdForPov(matrix.axes[a], target.value);
				break;
			}
		}

		if ((!variant || !variantInStock(variant)) && clickedOvId) {
			var nearest = findNearestAvailableVariant(clickedOvId);
			if (nearest) {
				applyVariantAxes(nearest);
				variant = getCurrentVariant();
			}
		}

		updateVariantUI(variant);
		syncAxisActiveClasses();
		if (!isInitPhase) {
			updateVariantUrl(variant ? variant.variant_id : null);
		}
	});

	if (document.readyState !== 'loading') { init(); }
	else { document.addEventListener('DOMContentLoaded', init); }

	function init() {
		// Server already rendered the correct price/SKU/checked state for the
		// selected variant. Just initialise the compatibility matrix.
		updateAvailableOptions();

		// Apply button state for the current (default) variant on page load,
		// but keep the server-rendered price to avoid a visible price "flash".
		var variant = getCurrentVariant();
		if (variant) {
			updateVariantUI(variant, true);
			updateYouSave(variant, variant.special !== undefined && variant.special !== null && variant.special_from !== undefined && variant.special < variant.special_from);
		} else if (Object.keys(variantMap).length === 0) {
			// No enabled variants at all (e.g. all disabled): keep the server
			// state (out of stock) and make sure no axis can be selected.
			updateVariantUI(null, true);
		}

		isInitPhase = false;
	}
})();
//--></script>
{% endif %}
