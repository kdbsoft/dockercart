{#
  product_card.twig
  Shared product card partial for all listing views (grid / list / table).

  Required variables:
    product          — product data array
    view_mode        — 'grid' | 'list' | 'table'
    text_quick_view  — localised "Quick View" string
    text_reviews     — localised "reviews" word
    text_sale        — localised "SALE" badge text
    button_cart      — localised "Add to Cart" text

  Optional style variables:
    btn_quick_hover  — e.g. "hover:bg-blue-600"
    link_hover       — e.g. "hover:text-blue-600 transition"
    btn_cart_classes — e.g. "bg-blue-600 text-white hover:bg-blue-700"
#}
<style>
  .dc-star { position: relative; display: inline-block; color: #e5e7eb; line-height: 1; }
  .dc-star.active { color: #f59e0b; }
  .dc-star.dc-star-partial { color: #e5e7eb; }
  .dc-star.dc-star-partial::after { content: '★'; position: absolute; inset: 0; color: #f59e0b; clip-path: inset(0 calc(100% - var(--pct)) 0 0); }
  .dc-rating-number { color: #111827; letter-spacing: -.06em; }
  .dc-dist-bar { height: 8px; border-radius: 9999px; background: #f3f4f6; overflow: hidden; }
  .dc-dist-bar > span { display: block; height: 100%; border-radius: 9999px; background: #f59e0b; }
  .dc-rating-popover { opacity: 0; pointer-events: none; transition: opacity .15s ease; }
  .dc-rating-hover:hover .dc-rating-popover { opacity: 1; pointer-events: auto; }
  .dc-rating-popover, .dc-rating-popover * { cursor: auto; }
  .dc-rating-popover a { cursor: pointer; }
</style>
{% if view_mode == 'table' %}
{% set dc_card_href = product.matched_variant_id is defined and product.matched_variant_id ? product.href|split('?')|first ~ '/variant-' ~ product.matched_variant_id ~ (product.href|split('?')|length > 1 ? '?' ~ product.href|split('?')|last : '') : product.href %}
<div class="product-card dc-table-row" data-id="{{ product.product_id }}" data-href="{{ dc_card_href }}" data-description="{{ product.description }}" data-model="{{ product.model|default('') }}" data-in-wishlist="{{ product.in_wishlist|default(0) }}" data-rating="{{ product.rating|default(0) }}" data-stock="{{ (product.stock is defined ? product.stock : '')|e('html_attr') }}" data-is-in-stock="{{ product.is_in_stock ? 1 : 0 }}" data-minimum="{{ product.minimum|default(1) }}" data-call-for-price="{{ (product.call_for_price is defined and product.call_for_price) or (call_for_price_status is defined and call_for_price_status and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) ? 1 : 0 }}">
  <div class="w-[50px] h-[50px] rounded-lg overflow-hidden bg-gray-50 flex-shrink-0">
    <a href="{{ dc_card_href }}">
      <img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-full h-full object-cover" loading="lazy" />
    </a>
  </div>
  <div class="min-w-0">
    {% if product.category is defined and product.category %}
      <p class="text-[10px] text-gray-400 uppercase tracking-widest truncate">{{ product.category }}</p>
    {% endif %}
    <h3 class="text-sm font-semibold text-gray-900 leading-snug truncate">
      <a href="{{ dc_card_href }}" class="{{ link_hover|default('hover:text-blue-600 transition') }}">{{ product.name }}</a>
    </h3>
  </div>
  <div class="flex items-baseline gap-1 whitespace-nowrap">
    {% set cfp = (product.call_for_price is defined and product.call_for_price) or ((call_for_price_status is defined and call_for_price_status) and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) %}
    {% if cfp %}
      {% if call_for_price_mode is defined and call_for_price_mode == 'call' %}
      <a href="tel:{{ call_for_price_phone }}" class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-600 text-white text-[11px] font-bold rounded-lg hover:bg-blue-700 transition">
        <i data-lucide="phone" class="w-3 h-3"></i>
        {{ text_call_for_price|default('Contact for price') }}
      </a>
      {% else %}
      <button type="button" class="dc-cfp-request-btn inline-flex items-center gap-1 px-2.5 py-1 bg-blue-600 text-white text-[11px] font-bold rounded-lg hover:bg-blue-700 transition" data-dc-cfp-request data-product-id="{{ product.product_id }}">
        <i data-lucide="message-circle-question" class="w-3 h-3"></i>
        {{ text_call_for_price_request|default('Request price') }}
      </button>
      {% endif %}
    {% elseif product.special %}
      <span class="text-sm font-extrabold text-red-600">{{ product.special }}</span>
      <span class="text-[11px] text-gray-400 line-through">{{ product.price }}</span>
    {% elseif product.price %}
      <span class="text-sm font-extrabold text-gray-900">{{ product.price }}</span>
    {% endif %}
  </div>
  <div class="flex items-center gap-0.5">
    {% if product.rating %}
    <div class="dc-rating-hover relative cursor-pointer">
      <div class="flex items-center">
        {% for i in 1..5 %}
          {% set diff = product.rating - (i - 1) %}
          {% if diff >= 1 %}
            <span class="dc-star active text-[11px]">★</span>
          {% elseif diff > 0 %}
            <span class="dc-star dc-star-partial text-[11px]" style="--pct: {{ (diff * 100) | round }}%">★</span>
          {% else %}
            <span class="dc-star text-[11px]">★</span>
          {% endif %}
        {% endfor %}
      </div>
      {% if show_distribution is defined and show_distribution and product.rating_distribution is defined and product.rating_distribution is not empty and product.reviews is defined and product.reviews %}
      <div class="dc-rating-popover absolute left-1/2 -translate-x-1/2 top-full z-50 cursor-auto">
        <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/70 ring-1 ring-gray-100 p-4 w-60 cursor-auto">
          <div class="flex items-baseline gap-1.5 mb-3">
            <span class="dc-rating-number text-xl font-extrabold leading-none">{{ product.rating_value is defined and product.rating_value ? product.rating_value : product.rating }}</span>
            <span class="text-xs text-gray-400">/ 5</span>
            <span class="text-xs font-semibold text-gray-500 ml-auto">{{ review_count_label(product.reviews) }}</span>
          </div>
          <div>
            {% for i in 5..1 %}
              {% set count = product.rating_distribution[i] is defined ? product.rating_distribution[i] : 0 %}
              {% set pct = product.reviews > 0 ? (count * 100 / product.reviews) : 0 %}
              <div class="flex items-center gap-2 text-xs text-gray-500 py-0.5">
                <span class="w-4 flex-shrink-0 tabular-nums">{{ i }}</span>
                <span class="text-[10px] text-amber-500 leading-none">★</span>
                <div class="dc-dist-bar flex-1"><span style="width: {{ pct | round }}%"></span></div>
                <span class="w-6 text-right tabular-nums text-gray-400">{{ count }}</span>
              </div>
            {% endfor %}
          </div>
          <a href="{{ product.reviews_url is defined and product.reviews_url ? product.reviews_url : product.href }}" class="w-full inline-flex items-center justify-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 mt-3">{{ text_all_reviews|default('') }}<i data-lucide="chevron-right" width="14" height="14"></i></a>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  <div class="text-[11px] font-medium {% if product.is_preorder is defined and product.is_preorder %}text-amber-600{% elseif product.is_in_stock %}text-emerald-600{% else %}text-red-500{% endif %} whitespace-nowrap">
    {% if product.is_in_stock %}
      <i data-lucide="check" class="w-3 h-3 inline-block"></i>
    {% endif %}
    <span>{{ product.stock is defined and product.stock ? product.stock : '' }}</span>
  </div>
  {% if not cfp and product.is_in_stock %}
  <div class="flex items-center gap-1">
    <input type="number" class="dc-qty-input w-12 text-[11px] text-center font-semibold border border-gray-200 rounded-lg py-1.5 px-1 focus:outline-none focus:border-blue-400" value="{{ product.minimum|default(1) }}" min="{{ product.minimum|default(1) }}" step="1" aria-label="{{ text_quantity|default('Qty:') }}" />
  </div>
  <div>
    <button class="text-blue-600 hover:bg-blue-50 hover:text-blue-700 p-1.5 rounded-lg transition" onclick="cart.add('{{ product.product_id }}', this.closest('.dc-table-row').querySelector('.dc-qty-input').value || '{{ product.minimum|default(1) }}');" aria-label="{{ button_cart }}">
      <i data-lucide="shopping-cart" class="w-5 h-5"></i>
    </button>
  </div>
  {% endif %}
</div>

{% elseif view_mode == 'list' %}
{% set dc_card_href = product.matched_variant_id is defined and product.matched_variant_id ? product.href|split('?')|first ~ '/variant-' ~ product.matched_variant_id ~ (product.href|split('?')|length > 1 ? '?' ~ product.href|split('?')|last : '') : product.href %}
<div class="product-card dc-list-card group bg-white rounded-2xl overflow-visible border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-row" data-id="{{ product.product_id }}" data-href="{{ dc_card_href }}" data-description="{{ product.description }}" data-model="{{ product.model|default('') }}" data-in-wishlist="{{ product.in_wishlist|default(0) }}" data-rating="{{ product.rating|default(0) }}" data-stock="{{ (product.stock is defined ? product.stock : '')|e('html_attr') }}" data-is-in-stock="{{ product.is_in_stock ? 1 : 0 }}" data-minimum="{{ product.minimum|default(1) }}" data-call-for-price="{{ (product.call_for_price is defined and product.call_for_price) or (call_for_price_status is defined and call_for_price_status and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) ? 1 : 0 }}">
  <div class="relative w-40 sm:w-48 flex-shrink-0 bg-gray-50 overflow-hidden">
    <a href="{{ dc_card_href }}" class="block w-full h-full">
      <img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    </a>
    {% if product.new_arrival_badge is defined and product.new_arrival_badge %}
      <span class="absolute top-2 left-2 bg-gradient-to-r {{ product.new_arrival_badge_class }} text-white text-[10px] font-bold px-2 py-0.5 rounded-md">{{ product.new_arrival_badge }}</span>
    {% elseif product.has_gift is defined and product.has_gift %}
      <span class="absolute top-2 left-2 bg-amber-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md flex items-center gap-1"><i data-lucide="gift" class="w-3 h-3"></i> {{ text_gift_badge|default('GIFT') }}</span>
    {% elseif product.special %}
      {% set discount_pct = product.discount is defined ? product.discount : 0 %}
      {% if discount_pct > 0 %}
      <span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">-{{ discount_pct }}%</span>
      {% else %}
      <span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">{{ text_sale|default('SALE') }}</span>
      {% endif %}
    {% endif %}
    <div class="absolute top-2 right-2">
      <button class="wishlist-btn w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-rose-50 transition {% if product.in_wishlist %}bg-rose-50{% endif %}" onclick="dcAddToWishlist('{{ product.product_id }}', this); event.stopPropagation();" aria-label="Add to wishlist">
        <i data-lucide="heart" class="w-3.5 h-3.5 {% if product.in_wishlist %}text-rose-500 fill-rose-400{% else %}text-gray-400{% endif %}"></i>
      </button>
    </div>
  </div>
  <div class="flex-1 p-4 sm:p-5 flex flex-col min-w-0">
    {% if product.category is defined and product.category %}
      <p class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-widest mb-1 font-medium">{{ product.category }}</p>
    {% endif %}
    <h3 class="text-sm sm:text-base font-bold text-gray-900 leading-snug mb-1">
      <a href="{{ dc_card_href }}" class="{{ link_hover|default('hover:text-blue-600 transition') }}">{{ product.name }}</a>
    </h3>
    {% if product.rating %}
      <div class="flex items-center mb-2">
        <div class="dc-rating-hover relative cursor-pointer">
          <div class="flex items-center">
            {% for i in 1..5 %}
              {% set diff = product.rating - (i - 1) %}
              {% if diff >= 1 %}
                <span class="dc-star active text-xs">★</span>
              {% elseif diff > 0 %}
                <span class="dc-star dc-star-partial text-xs" style="--pct: {{ (diff * 100) | round }}%">★</span>
              {% else %}
                <span class="dc-star text-xs">★</span>
              {% endif %}
            {% endfor %}
          </div>
          {% if show_distribution is defined and show_distribution and product.rating_distribution is defined and product.rating_distribution is not empty and product.reviews is defined and product.reviews %}
          <div class="dc-rating-popover absolute left-1/2 -translate-x-1/2 top-full z-50 cursor-auto">
            <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/70 ring-1 ring-gray-100 p-4 w-60 cursor-auto">
              <div class="flex items-baseline gap-1.5 mb-3">
                <span class="dc-rating-number text-xl font-extrabold leading-none">{{ product.rating_value is defined and product.rating_value ? product.rating_value : product.rating }}</span>
                <span class="text-xs text-gray-400">/ 5</span>
                <span class="text-xs font-semibold text-gray-500 ml-auto">{{ review_count_label(product.reviews) }}</span>
              </div>
              <div>
                {% for i in 5..1 %}
                  {% set count = product.rating_distribution[i] is defined ? product.rating_distribution[i] : 0 %}
                  {% set pct = product.reviews > 0 ? (count * 100 / product.reviews) : 0 %}
                  <div class="flex items-center gap-2 text-xs text-gray-500 py-0.5">
                    <span class="w-4 flex-shrink-0 tabular-nums">{{ i }}</span>
                    <span class="text-[10px] text-amber-500 leading-none">★</span>
                    <div class="dc-dist-bar flex-1"><span style="width: {{ pct | round }}%"></span></div>
                    <span class="w-6 text-right tabular-nums text-gray-400">{{ count }}</span>
                  </div>
                {% endfor %}
              </div>
              <a href="{{ product.reviews_url is defined and product.reviews_url ? product.reviews_url : product.href }}" class="w-full inline-flex items-center justify-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 mt-3">{{ text_all_reviews|default('') }}<i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
          </div>
          {% endif %}
        </div>
        <span class="text-[10px] text-gray-400 ml-1">{{ review_count_label(product.reviews|default(0)) }}</span>
      </div>
    {% endif %}
    {% if product.description is defined and product.description %}
      <p class="text-xs sm:text-sm text-gray-500 leading-relaxed mb-3 line-clamp-2">{{ product.description }}</p>
    {% endif %}
    {% if product.is_configurable and product.variant_swatches is defined and product.variant_swatches %}
    {% set dc_base_url = product.href|split('?')|first %}
    {% set dc_query_part = product.href|split('?')|length > 1 ? '?' ~ product.href|split('?')|last : '' %}
    <div class="dc-card-swatches dc-card-swatches--list">
      {% for axis in product.variant_swatches %}
      <div class="dc-card-swatches__axis">
        <p class="dc-card-swatches__label">{{ axis.name }}</p>
        {% if axis.type == 'color' %}
        <div class="dc-card-swatches__pills">
          {% for val in axis.values|slice(0, 8) %}
          {% if val.color_code is defined and val.color_code %}
          <a href="{{ dc_base_url }}/variant-{{ val.variant_id }}{{ dc_query_part }}" title="{{ val.name }}" class="dc-card-swatches__color-dot{% if val.option_value_id in product.default_option_value_ids %} dc-card-swatches__color-dot--active{% endif %}">
            <span class="dc-card-swatches__color-dot-inner" style="background-color: {{ val.color_code }}"></span>
          </a>
          {% else %}
          <a href="{{ dc_base_url }}/variant-{{ val.variant_id }}{{ dc_query_part }}" class="dc-card-swatches__pill{% if val.option_value_id in product.default_option_value_ids %} dc-card-swatches__pill--active{% endif %}">{{ val.name }}</a>
          {% endif %}
          {% endfor %}
        </div>
        {% else %}
        <div class="dc-card-swatches__pills">
          {% for val in axis.values|slice(0, 8) %}
          <a href="{{ dc_base_url }}/variant-{{ val.variant_id }}{{ dc_query_part }}" class="dc-card-swatches__pill{% if val.option_value_id in product.default_option_value_ids %} dc-card-swatches__pill--active{% endif %}">{{ val.name }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
      <div class="mt-auto pt-3 flex flex-wrap items-end justify-between gap-3">
        <div class="flex items-baseline gap-1 flex-wrap">
          {% set cfp = (product.call_for_price is defined and product.call_for_price) or ((call_for_price_status is defined and call_for_price_status) and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) %}
          {% if cfp %}
            {% if call_for_price_mode is defined and call_for_price_mode == 'call' %}
            <a href="tel:{{ call_for_price_phone }}" class="inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 transition shadow-sm">
              <i data-lucide="phone" class="w-4 h-4"></i>
              {{ text_call_for_price|default('Contact for price') }}
            </a>
            {% else %}
            <button type="button" class="dc-cfp-request-btn inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 transition shadow-sm" data-dc-cfp-request data-product-id="{{ product.product_id }}">
              <i data-lucide="message-circle-question" class="w-4 h-4"></i>
              {{ text_call_for_price_request|default('Request price') }}
            </button>
            {% endif %}
          {% elseif product.special %}
            <span class="text-lg sm:text-xl font-extrabold text-red-600">{{ product.special }}</span>
            <span class="text-xs text-gray-400 line-through">{{ product.price }}</span>
          {% elseif product.price %}
            <span class="text-lg sm:text-xl font-extrabold text-gray-900">{{ product.price }}</span>
          {% endif %}
        </div>
      <div class="flex items-center gap-2">
        {% if product.stock is defined and product.stock %}
          <div class="text-[11px] font-medium {% if product.is_preorder is defined and product.is_preorder %}text-amber-600{% elseif product.is_in_stock %}text-emerald-600{% else %}text-red-500{% endif %} flex items-center gap-1">
            {% if product.is_in_stock %}
              <i data-lucide="check" class="w-3.5 h-3.5"></i>
            {% endif %}
            <span>{{ product.stock }}</span>
          </div>
        {% endif %}
        {% if not cfp and product.is_in_stock %}
        <button class="text-blue-600 hover:bg-blue-50 hover:text-blue-700 p-1.5 rounded-lg transition flex-shrink-0" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum|default(1) }}');" aria-label="{{ button_cart }}">
          <i data-lucide="shopping-cart" class="w-5 h-5"></i>
        </button>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% else %}

{# --- grid view (default) --- #}
{% set dc_card_href = product.matched_variant_id is defined and product.matched_variant_id ? product.href|split('?')|first ~ '/variant-' ~ product.matched_variant_id ~ (product.href|split('?')|length > 1 ? '?' ~ product.href|split('?')|last : '') : product.href %}
<div class="product-card group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col relative hover:z-30 overflow-visible" data-id="{{ product.product_id }}" data-href="{{ dc_card_href }}" data-description="{{ product.description }}" data-model="{{ product.model|default('') }}" data-in-wishlist="{{ product.in_wishlist|default(0) }}" data-rating="{{ product.rating|default(0) }}" data-stock="{{ (product.stock is defined ? product.stock : '')|e('html_attr') }}" data-is-in-stock="{{ product.is_in_stock ? 1 : 0 }}" data-minimum="{{ product.minimum|default(1) }}" data-call-for-price="{{ (product.call_for_price is defined and product.call_for_price) or (call_for_price_status is defined and call_for_price_status and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) ? 1 : 0 }}">
  <div class="relative overflow-hidden aspect-square bg-gray-50 rounded-t-2xl">
    <a href="{{ dc_card_href }}">
      <img src="{{ product.thumb }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    </a>
    {% if product.new_arrival_badge is defined and product.new_arrival_badge %}
      <span class="absolute top-2 left-2 bg-gradient-to-r {{ product.new_arrival_badge_class }} text-white text-[10px] font-bold px-2 py-0.5 rounded-md">{{ product.new_arrival_badge }}</span>
    {% elseif product.has_gift is defined and product.has_gift %}
      <span class="absolute top-2 left-2 bg-amber-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md flex items-center gap-1"><i data-lucide="gift" class="w-3 h-3"></i> {{ text_gift_badge|default('GIFT') }}</span>
    {% elseif product.special %}
      {% set discount_pct = product.discount is defined ? product.discount : 0 %}
      {% if discount_pct > 0 %}
      <span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">-{{ discount_pct }}%</span>
      {% else %}
      <span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-md">{{ text_sale|default('SALE') }}</span>
      {% endif %}
    {% endif %}
    <div class="absolute top-2 right-2">
      <button class="wishlist-btn w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-rose-50 transition {% if product.in_wishlist %}bg-rose-50{% endif %}" onclick="dcAddToWishlist('{{ product.product_id }}', this); event.stopPropagation();" aria-label="Add to wishlist">
        <i data-lucide="heart" class="w-3.5 h-3.5 {% if product.in_wishlist %}text-rose-500 fill-rose-400{% else %}text-gray-400{% endif %}"></i>
      </button>
    </div>
    <button class="quick-view-btn absolute bottom-0 left-0 right-0 py-2.5 bg-gray-900/85 {{ btn_quick_hover|default('hover:bg-blue-600') }} text-white text-[11px] font-bold uppercase tracking-widest backdrop-blur-sm transition-colors duration-200" onclick="openQuickView && openQuickView({{ product.product_id }}); event.stopPropagation();" aria-label="{{ text_quick_view }}">
      {{ text_quick_view }}
    </button>
  </div>
  <div class="p-3 sm:p-4 flex flex-col flex-1">
    {% if product.category is defined and product.category %}
      <p class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-widest mb-1 font-medium">{{ product.category }}</p>
    {% endif %}
    <h3 class="text-xs sm:text-sm font-semibold text-gray-900 leading-snug mb-2 flex-1 line-clamp-2">
      <a href="{{ dc_card_href }}" class="{{ link_hover|default('hover:text-blue-600 transition') }}">{{ product.name }}</a>
    </h3>
    {% if product.rating %}
      <div class="flex items-center mb-2">
        <div class="dc-rating-hover relative cursor-pointer">
          <div class="flex items-center">
            {% for i in 1..5 %}
              {% set diff = product.rating - (i - 1) %}
              {% if diff >= 1 %}
                <span class="dc-star active text-xs">★</span>
              {% elseif diff > 0 %}
                <span class="dc-star dc-star-partial text-xs" style="--pct: {{ (diff * 100) | round }}%">★</span>
              {% else %}
                <span class="dc-star text-xs">★</span>
              {% endif %}
            {% endfor %}
          </div>
          {% if show_distribution is defined and show_distribution and product.rating_distribution is defined and product.rating_distribution is not empty and product.reviews is defined and product.reviews %}
          <div class="dc-rating-popover absolute left-1/2 -translate-x-1/2 top-full z-50 cursor-auto">
            <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/70 ring-1 ring-gray-100 p-4 w-60 cursor-auto">
              <div class="flex items-baseline gap-1.5 mb-3">
                <span class="dc-rating-number text-xl font-extrabold leading-none">{{ product.rating_value is defined and product.rating_value ? product.rating_value : product.rating }}</span>
                <span class="text-xs text-gray-400">/ 5</span>
                <span class="text-xs font-semibold text-gray-500 ml-auto">{{ review_count_label(product.reviews) }}</span>
              </div>
              <div>
                {% for i in 5..1 %}
                  {% set count = product.rating_distribution[i] is defined ? product.rating_distribution[i] : 0 %}
                  {% set pct = product.reviews > 0 ? (count * 100 / product.reviews) : 0 %}
                  <div class="flex items-center gap-2 text-xs text-gray-500 py-0.5">
                    <span class="w-4 flex-shrink-0 tabular-nums">{{ i }}</span>
                    <span class="text-[10px] text-amber-500 leading-none">★</span>
                    <div class="dc-dist-bar flex-1"><span style="width: {{ pct | round }}%"></span></div>
                    <span class="w-6 text-right tabular-nums text-gray-400">{{ count }}</span>
                  </div>
                {% endfor %}
              </div>
              <a href="{{ product.reviews_url is defined and product.reviews_url ? product.reviews_url : product.href }}" class="w-full inline-flex items-center justify-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 mt-3">{{ text_all_reviews|default('') }}<i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
          </div>
          {% endif %}
        </div>
        <span class="text-[10px] text-gray-400 ml-1">{{ review_count_label(product.reviews|default(0)) }}</span>
      </div>
    {% endif %}
    {% if product.stock is defined and product.stock %}
      <div class="mb-2 text-[11px] font-medium {% if product.is_preorder is defined and product.is_preorder %}text-amber-600{% elseif product.is_in_stock %}text-emerald-600{% else %}text-red-500{% endif %} flex items-center gap-1">
        {% if product.is_in_stock %}
          <i data-lucide="check" class="w-3.5 h-3.5"></i>
        {% endif %}
        <span>{{ product.stock }}</span>
      </div>
    {% endif %}
    <div class="flex items-end justify-between gap-2">
      <div class="flex items-baseline gap-1 flex-wrap">
        {% set cfp = (product.call_for_price is defined and product.call_for_price) or ((call_for_price_status is defined and call_for_price_status) and call_for_price_phone is defined and call_for_price_phone and product.price_raw is defined and product.price_raw <= 0) %}
        {% if cfp %}
          {% if call_for_price_mode is defined and call_for_price_mode == 'call' %}
          <a href="tel:{{ call_for_price_phone }}" class="inline-flex items-center gap-1 px-3 py-1.5 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 transition shadow-sm">
            <i data-lucide="phone" class="w-3.5 h-3.5"></i>
            {{ text_call_for_price|default('Contact for price') }}
          </a>
          {% else %}
          <button type="button" class="dc-cfp-request-btn inline-flex items-center gap-1 px-3 py-1.5 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 transition shadow-sm" data-dc-cfp-request data-product-id="{{ product.product_id }}">
            <i data-lucide="message-circle-question" class="w-3.5 h-3.5"></i>
            {{ text_call_for_price_request|default('Request price') }}
          </button>
          {% endif %}
        {% elseif product.special %}
          <span class="text-base sm:text-lg font-extrabold text-red-600">{{ product.special }}</span>
          <span class="text-xs text-gray-400 line-through ml-1">{{ product.price }}</span>
        {% elseif product.price %}
          <span class="text-base sm:text-lg font-extrabold text-gray-900">{{ product.price }}</span>
        {% endif %}
      </div>
      {% if not cfp and product.is_in_stock %}
      <button class="add-to-cart-btn flex-shrink-0 text-blue-600 hover:bg-blue-50 hover:text-blue-700 p-1.5 rounded-lg transition" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum|default(1) }}');" aria-label="{{ button_cart }}">
        <i data-lucide="shopping-cart" class="w-5 h-5"></i>
      </button>
      {% endif %}
    </div>
  </div>
  {% if product.is_configurable and product.variant_swatches is defined and product.variant_swatches %}
    {% set dc_base_url = product.href|split('?')|first %}
    {% set dc_query_part = product.href|split('?')|length > 1 ? '?' ~ product.href|split('?')|last : '' %}
    <div class="dc-card-swatches">
      {% for axis in product.variant_swatches %}
      <div class="dc-card-swatches__axis">
        <p class="dc-card-swatches__label">{{ axis.name }}</p>
        {% if axis.type == 'color' %}
        <div class="dc-card-swatches__pills">
          {% for val in axis.values|slice(0, 8) %}
          {% if val.color_code is defined and val.color_code %}
          <a href="{{ dc_base_url }}/variant-{{ val.variant_id }}{{ dc_query_part }}" title="{{ val.name }}" class="dc-card-swatches__color-dot{% if val.option_value_id in product.default_option_value_ids %} dc-card-swatches__color-dot--active{% endif %}">
            <span class="dc-card-swatches__color-dot-inner" style="background-color: {{ val.color_code }}"></span>
          </a>
          {% else %}
          <a href="{{ dc_base_url }}/variant-{{ val.variant_id }}{{ dc_query_part }}" class="dc-card-swatches__pill{% if val.option_value_id in product.default_option_value_ids %} dc-card-swatches__pill--active{% endif %}">{{ val.name }}</a>
          {% endif %}
          {% endfor %}
        </div>
        {% else %}
        <div class="dc-card-swatches__pills">
          {% for val in axis.values|slice(0, 8) %}
          <a href="{{ dc_base_url }}/variant-{{ val.variant_id }}{{ dc_query_part }}" class="dc-card-swatches__pill{% if val.option_value_id in product.default_option_value_ids %} dc-card-swatches__pill--active{% endif %}">{{ val.name }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
</div>

{% endif %}
