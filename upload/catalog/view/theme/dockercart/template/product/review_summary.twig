{% if review_status %}
<div class="flex flex-wrap items-center gap-3 mt-4">
  <div class="inline-flex self-center items-center gap-2 rounded-2xl bg-amber-50/60 leading-none">
    {% if rating > 0 %}
    <span class="text-sm font-bold tracking-tight text-slate-950 leading-none">{{ rating_value }}</span>
    {% endif %}
    <div class="flex justify-center gap-2">
      <div class="dc-stars leading-none" aria-hidden="true">
        {% for i in 1..5 %}
          {% set diff = rating - (i - 1) %}
          {% if diff >= 1 %}
            <span class="dc-star active">★</span>
          {% elseif diff >= 0.1 %}
            <span class="dc-star dc-star-partial" style="--pct: {{ (diff * 100) | round }}%">★</span>
          {% else %}
            <span class="dc-star">★</span>
          {% endif %}
        {% endfor %}
      </div>
      <a href="{{ reviews_url }}" class="inline-flex items-center gap-1 text-xs font-bold leading-none text-slate-600 hover:text-blue-600 transition">{{ reviews }}<i data-lucide="arrow-up-right" width="12" height="12"></i></a>
    </div>
  </div>

  {% if show_model|default(true) %}
  <span class="text-sm text-slate-300 hidden sm:inline">/</span>
  <span class="text-sm text-slate-500">{{ text_model }} <span id="dc-variant-model" data-base-model="{{ model }}">{{ is_configurable and variant_model is defined and variant_model ? variant_model : model }}</span></span>
  {% endif %}
</div>
{% elseif not review_status is defined or not review_status %}
{% if show_model|default(true) %}
<p class="text-sm text-gray-500 mt-3">{{ text_model }} <span id="dc-variant-model" data-base-model="{{ model }}">{{ is_configurable and variant_model is defined and variant_model ? variant_model : model }}</span></p>
{% endif %}
{% endif %}
