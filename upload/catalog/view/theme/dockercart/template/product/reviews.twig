{{ header }}

{% include 'dockercart/template/product/review_css.twig' %}

<main class="py-20 sm:py-2 lg:py-4 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto">
    {% include 'dockercart/template/common/partials/breadcrumbs.twig' %}

    <div class="flex flex-wrap items-end justify-between gap-5 mt-5 mb-8">
      <div>
        <p class="inline-flex items-center gap-2 text-blue-600 text-xs font-bold uppercase tracking-[0.18em] mb-2"><span class="w-4 h-px bg-blue-300"></span>{{ text_reviews_section }}</p>
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-gray-900">{{ heading_reviews }}</h1>
        <a href="{{ product_href }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-900 hover:text-blue-600 transition mt-3">
          <i data-lucide="arrow-left" width="15" height="15"></i>{{ text_view_product }}
        </a>
      </div>
      {% if review_guest %}
      <button type="button" data-review-modal-open class="inline-flex items-center gap-2 px-5 py-3 border border-blue-600 text-blue-600 text-sm font-bold rounded-xl hover:bg-blue-50 transition">
        <i data-lucide="message-square-plus" width="16" height="16"></i>{{ text_leave_review|default('Leave a review') }}
      </button>
      {% endif %}
    </div>

    {% if review_count %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <aside class="lg:col-span-1 lg:sticky lg:top-24">
        <div class="dc-review-overview-compact p-5 sm:p-6">
          <div class="flex items-center gap-4">
            {% if rating > 0 %}
            <span class="dc-rating-number text-4xl font-extrabold leading-none">{{ rating_value }}<span class="text-base font-normal text-gray-400"> / 5</span></span>
            {% endif %}
            <div>
              <div class="dc-stars dc-stars-hero" aria-hidden="true">
                {% for i in 1..5 %}
                  {% set diff = rating - (i - 1) %}
                  {% if diff >= 1 %}
                    <span class="dc-star active">★</span>
                  {% elseif diff >= 0.1 %}
                    <span class="dc-star dc-star-partial" style="--pct: {{ (diff * 100) | round }}%">★</span>
                  {% else %}
                    <span class="dc-star">★</span>
                  {% endif %}
                {% endfor %}
              </div>
              {% if review_count %}
              <div class="text-sm font-medium text-gray-500 mt-1">{{ reviews }}</div>
              {% endif %}
            </div>
          </div>

          {% if show_distribution and rating_distribution is not empty %}
          <div class="mt-5">
            {% for i in 5..1 %}
              {% set count = rating_distribution[i] is defined ? rating_distribution[i] : 0 %}
              {% set pct = review_count > 0 ? (count * 100 / review_count) : 0 %}
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-1.5">
                <span class="w-7 flex-shrink-0 flex items-center gap-1 tabular-nums">{{ i }}<span class="text-[10px] text-amber-500">★</span></span>
                <div class="dc-dist-bar flex-1"><span style="width: {{ pct | round }}%"></span></div>
                <span class="w-8 text-right tabular-nums text-gray-400">{{ count }}</span>
              </div>
            {% endfor %}
          </div>
          {% endif %}

          {% if review_guest %}
          <div class="mt-5 pt-4 border-t border-gray-100">
            <button type="button" data-review-modal-open class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-xl transition shadow-sm shadow-blue-200">
              <i data-lucide="square-pen" width="14" height="14"></i>{{ text_write }}
            </button>
          </div>
          {% else %}
          <div class="mt-5 pt-4 border-t border-gray-100">
            <p class="text-xs text-gray-400">{{ text_login }}</p>
          </div>
          {% endif %}
        </div>
      </aside>

      <section class="lg:col-span-2 min-w-0">
        <div id="review">
          {% include 'dockercart/template/product/review.twig' with {
            reviews: reviews_list,
            total: review_total,
            total_label: review_total_label,
            sort_urls: sort_urls,
            has_more: has_more,
            next_page: next_page,
            sort: sort,
            show_more_label: show_more_label,
            review_ajax_url: review_ajax_url,
            text_no_reviews: text_no_reviews,
            text_be_first: text_be_first,
            text_be_first_hint: text_be_first_hint,
            text_leave_review: text_leave_review,
            reviews_url: reviews_url,
            vote_url: vote_url
          } %}
        </div>
      </section>
    </div>
    {% else %}
    <div id="review">
      {% include 'dockercart/template/product/review.twig' with {
        reviews: reviews_list,
        total: review_total,
        total_label: review_total_label,
        sort_urls: sort_urls,
        has_more: has_more,
        next_page: next_page,
        sort: sort,
        show_more_label: show_more_label,
        review_ajax_url: review_ajax_url,
        text_no_reviews: text_no_reviews,
        text_be_first: text_be_first,
        text_be_first_hint: text_be_first_hint,
        text_leave_review: text_leave_review,
        reviews_url: reviews_url,
        vote_url: vote_url
      } %}
    </div>
    {% endif %}
  </div>
</main>

{% if review_status %}
{% include 'dockercart/template/product/review_modal.twig' with {
  review_guest: review_guest,
  customer_name: customer_name,
  customer_logged: customer_logged,
  criteria: criteria,
  has_rating_criteria: has_rating_criteria,
  review_images_enabled: review_images_enabled,
  review_max_images: review_max_images,
  review_video_enabled: review_video_enabled,
  captcha: captcha,
  product_id: product_id,
  review_write_url: review_write_url
} %}
{% endif %}

{% include 'dockercart/template/common/partials/schema_reviews.twig' %}
{% include 'dockercart/template/product/review_js.twig' %}

{{ footer }}
