{{ header }}

{% include 'dockercart/template/product/review_css.twig' %}

<main class="py-20 sm:py-2 lg:py-4 px-4 sm:px-6 lg:px-8 bg-slate-50/70">
  <div class="max-w-7xl mx-auto">
    {% include 'dockercart/template/common/partials/breadcrumbs.twig' %}

    <div class="flex flex-wrap items-end justify-between gap-5 mt-5 mb-8">
      <div>
        <p class="inline-flex items-center gap-2 text-blue-600 text-xs font-bold uppercase tracking-[0.18em] mb-2"><span class="w-7 h-px bg-blue-300"></span>{{ text_reviews_section }}</p>
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-950">{{ heading_reviews }}</h1>
        <a href="{{ product_href }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-blue-600 transition mt-3">
          <i data-lucide="arrow-left" width="15" height="15"></i>{{ text_view_product }}
        </a>
      </div>
      {% if review_guest %}
      <a href="{{ reviews_url }}#form-review" class="inline-flex items-center gap-2 px-5 py-3 bg-slate-950 hover:bg-blue-700 text-white text-sm font-bold rounded-2xl transition shadow-lg shadow-slate-900/10">
        <i data-lucide="square-pen" width="16" height="16" class="inline-block mr-1.5 -mt-0.5"></i>{{ text_write }}
      </a>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <aside class="lg:col-span-1 lg:sticky lg:top-24 self-start">
        <div class="dc-review-overview p-6 sm:p-7">
          {% if review_count %}
          <div class="flex items-center gap-4">
            {% if rating > 0 %}
            <span class="dc-rating-number text-6xl font-extrabold leading-none">{{ rating_value }}</span>
            {% endif %}
            <div>
              <div class="dc-stars" aria-hidden="true">
                {% for i in 1..5 %}
                  {% set diff = rating - (i - 1) %}
                  {% if diff >= 1 %}
                    <span class="dc-star active">★</span>
                  {% elseif diff >= 0.1 %}
                    <span class="dc-star dc-star-partial" style="--pct: {{ (diff * 100) | round }}%">★</span>
                  {% else %}
                    <span class="dc-star">★</span>
                  {% endif %}
                {% endfor %}
              </div>
              <div class="text-sm font-medium text-slate-500 mt-1">{{ reviews }}</div>
            </div>
          </div>

          {% if show_distribution and rating_distribution is not empty %}
          <div class="mt-5">
            {% for i in 5..1 %}
              {% set count = rating_distribution[i] is defined ? rating_distribution[i] : 0 %}
              {% set pct = review_count > 0 ? (count * 100 / review_count) : 0 %}
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-1.5">
                <span class="w-7 flex-shrink-0 flex items-center gap-1 tabular-nums">{{ i }}<span class="text-[10px] text-amber-400">★</span></span>
                <div class="dc-dist-bar flex-1"><span style="width: {{ pct | round }}%"></span></div>
                <span class="w-8 text-right tabular-nums text-gray-400">{{ count }}</span>
              </div>
            {% endfor %}
          </div>
          {% endif %}

          <div class="mt-6 pt-5 border-t border-blue-100">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">{{ text_reviews_section }}</p>
            <p class="text-sm text-slate-600 mt-1">{{ text_be_first_hint }}</p>
          </div>
          {% else %}
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl bg-white text-amber-500 shadow-sm ring-1 ring-blue-100">
              <i data-lucide="star" width="21" height="21" aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-sm font-extrabold text-slate-950">{{ text_no_reviews }}</p>
              <p class="text-xs text-slate-500 mt-1">{{ text_be_first_hint }}</p>
            </div>
          </div>
          {% endif %}
        </div>
      </aside>

      <section class="lg:col-span-2 min-w-0">
        <div id="review">
          {% include 'dockercart/template/product/review.twig' with {
            reviews: reviews_list,
            total: review_total,
            total_label: review_total_label,
            sort_urls: sort_urls,
            has_more: has_more,
            next_page: next_page,
            sort: sort,
            show_more_label: show_more_label,
            review_ajax_url: review_ajax_url,
            text_no_reviews: text_no_reviews,
            text_be_first: text_be_first,
            text_be_first_hint: text_be_first_hint,
            text_leave_review: text_leave_review,
            reviews_url: reviews_url
          } %}
        </div>

        {% if review_status %}
        <div class="mt-12 pt-8 border-t border-slate-200">
          <h2 class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-950 mb-5">
            <i data-lucide="square-pen" width="18" height="18" class="text-blue-600"></i>{{ text_write }}
          </h2>
          <div class="dc-review-form-shell w-full max-w-3xl p-5 sm:p-7 shadow-sm">
            {% include 'dockercart/template/product/review_form.twig' with {
              review_guest: review_guest,
              customer_name: customer_name,
              customer_logged: customer_logged,
              criteria: criteria,
              has_rating_criteria: has_rating_criteria,
              review_images_enabled: review_images_enabled,
              review_max_images: review_max_images,
              review_video_enabled: review_video_enabled,
              captcha: captcha
            } %}
          </div>
        </div>
        {% endif %}
      </section>
    </div>
  </div>
</main>

{% include 'dockercart/template/common/partials/schema_reviews.twig' %}
{% include 'dockercart/template/product/review_js.twig' %}

{{ footer }}
