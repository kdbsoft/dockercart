<article class="dc-review-card bg-white border border-gray-100 rounded-2xl p-5 sm:p-6 mb-4">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-start gap-3 min-w-0">
      <div class="dc-avatar flex-shrink-0" style="background: hsl({{ review.avatar_hue|default(210) }}, 65%, 45%);" aria-hidden="true">{{ review.author_initials|default('?') }}</div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <strong class="text-[15px] font-bold text-gray-900 truncate">{{ review.author }}</strong>
          {% if review.verified %}
          <span class="inline-flex items-center gap-1 text-[10px] font-bold tracking-wide text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2 py-0.5" title="{{ text_verified }}">
            <i data-lucide="badge-check" width="12" height="12"></i>{{ text_verified }}
          </span>
          {% endif %}
        </div>
        <div class="dc-stars mt-1" aria-hidden="true">
          {% for i in 1..5 %}
            {% set diff = review.rating - (i - 1) %}
            {% if diff >= 1 %}
              <span class="dc-star active">★</span>
            {% elseif diff >= 0.1 %}
              <span class="dc-star dc-star-partial" style="--pct: {{ (diff * 100) | round }}%">★</span>
            {% else %}
              <span class="dc-star">★</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    <span class="flex-shrink-0 inline-flex items-center gap-1 text-xs text-gray-400 tabular-nums whitespace-nowrap">
      <i data-lucide="calendar" width="12" height="12"></i>{{ review.date_added }}
    </span>
  </div>

  <div class="dc-review-card-divider mt-4"></div>

  {% if review.criteria %}
    {% if review.criteria|filter(c => c.type == 'rating')|length > 0 %}
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
      {% for item in review.criteria %}
        {% if item.type == 'rating' %}
        <div>
          <div class="flex items-center justify-between gap-3 mb-1">
            <span class="text-xs font-semibold text-gray-600">{{ item.name }}</span>
            <span class="text-xs font-bold text-gray-800 tabular-nums">{{ item.rating }}/5</span>
          </div>
          <div class="dc-stars dc-stars-sm" aria-hidden="true">
            {% for i in 1..5 %}
              {% set diff = item.value - (i - 1) %}
              {% if diff >= 1 %}
                <span class="dc-star active">★</span>
              {% elseif diff >= 0.1 %}
                <span class="dc-star dc-star-partial" style="--pct: {{ (diff * 100) | round }}%">★</span>
              {% else %}
                <span class="dc-star">★</span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  {% endif %}

  {% if review.pros or review.cons %}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
    {% if review.pros %}
    <div class="rounded-xl bg-gray-50 border border-gray-100 p-3">
      <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-600 mb-1">
        <i data-lucide="thumbs-up" width="13" height="13"></i>{{ text_pros }}
      </div>
      <div class="text-sm text-gray-700 leading-relaxed">{{ review.pros }}</div>
    </div>
    {% endif %}
    {% if review.cons %}
    <div class="rounded-xl bg-gray-50 border border-gray-100 p-3">
      <div class="flex items-center gap-1.5 text-xs font-bold text-red-500 mb-1">
        <i data-lucide="thumbs-down" width="13" height="13"></i>{{ text_cons }}
      </div>
      <div class="text-sm text-gray-700 leading-relaxed">{{ review.cons }}</div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="text-[15px] text-gray-700 leading-7 mt-4">{{ review.text }}</div>

  {% if reply_enabled|default(false) %}
  <div class="dc-review-replies mt-4 rounded-xl bg-gray-50/70 border border-gray-100 p-4">
    {% if review.replies|default([])|length > 0 %}
    <div class="flex items-center gap-1.5 text-xs font-bold text-gray-500 mb-3">
      <i data-lucide="message-square" width="13" height="13"></i>
      {{ review.replies|length }} {{ review.replies|length == 1 ? text_reply_count|default('reply') : text_replies_count|default('replies') }}
    </div>
    <div class="space-y-3">
      {% for reply in review.replies %}
      <div class="dc-review-reply bg-white border border-gray-100 rounded-xl p-3">
        <div class="flex flex-wrap items-center gap-2">
          <strong class="text-sm font-bold text-gray-900">{{ reply.author }}</strong>
          {% if reply.author_is_admin %}
          <span class="inline-flex items-center gap-1 text-[10px] font-bold tracking-wide text-blue-700 bg-blue-50 border border-blue-200 rounded-full px-2 py-0.5">
            <i data-lucide="store" width="12" height="12"></i>{{ text_reply_admin_badge|default('Store') }}
          </span>
          {% endif %}
          <span class="text-xs text-gray-400 tabular-nums ml-auto">{{ reply.date_added }}</span>
        </div>
        <div class="text-sm text-gray-700 leading-6 mt-2">{{ reply.text }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if customer_logged|default(false) %}
    <form class="dc-review-reply-form mt-3" data-review-id="{{ review.review_id }}" data-reply-url="{{ reply_url|default('') }}" data-min-length="{{ reply_min_length|default(2) }}" data-max-length="{{ reply_max_length|default(1000) }}">
      <div class="dc-review-reply-alert hidden"></div>
      <textarea name="text" rows="2" maxlength="{{ reply_max_length|default(1000) }}" placeholder="{{ text_reply_placeholder|default('Write a reply...') }}"
        class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white resize-y"></textarea>
      <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="dc-hp" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
      <div class="flex justify-end mt-2">
        <button type="submit" class="dc-review-reply-submit inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
          <i data-lucide="send" width="13" height="13"></i>{{ text_reply_submit|default('Send reply') }}
        </button>
      </div>
    </form>
    {% elseif not customer_logged|default(false) %}
    <p class="text-xs text-gray-400">
      <a href="{{ login_url|default('index.php?route=account/login') }}" class="dc-review-login-link inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 font-semibold"><i data-lucide="log-in" width="12" height="12"></i>{{ text_reply_login_hint|default('Log in or register to reply to reviews') }}</a>
    </p>
    {% endif %}
  </div>
  {% endif %}

  <div class="dc-review-votes flex items-center gap-2 mt-4" data-review-id="{{ review.review_id }}" data-vote-url="{{ vote_url|default('') }}">
    <button type="button" class="dc-vote-btn dc-vote-like inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-bold transition {% if review.my_vote == 'like' %}border-emerald-200 text-emerald-700 bg-emerald-50{% else %}border-gray-200 text-gray-500 bg-gray-50 hover:border-emerald-200 hover:text-emerald-600 hover:bg-emerald-50{% endif %}" data-vote="like" aria-pressed="{% if review.my_vote == 'like' %}true{% else %}false{% endif %}">
      <i data-lucide="thumbs-up" width="14" height="14"></i><span class="dc-vote-count tabular-nums">{{ review.votes.likes }}</span>
    </button>
    <button type="button" class="dc-vote-btn dc-vote-dislike inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-bold transition {% if review.my_vote == 'dislike' %}border-red-200 text-red-600 bg-red-50{% else %}border-gray-200 text-gray-500 bg-gray-50 hover:border-red-200 hover:text-red-500 hover:bg-red-50{% endif %}" data-vote="dislike" aria-pressed="{% if review.my_vote == 'dislike' %}true{% else %}false{% endif %}">
      <i data-lucide="thumbs-down" width="14" height="14"></i><span class="dc-vote-count tabular-nums">{{ review.votes.dislikes }}</span>
    </button>
  </div>

  {% if review.images %}
    <div class="dc-review-thumbs">
      {% for image in review.images %}
        <a href="{{ image.popup }}" class="dc-review-thumb glightbox" data-gallery="review-{{ review.review_id }}" aria-label="{{ text_view_image }}">
          <img src="{{ image.thumb }}" alt="{{ review.author }}" loading="lazy" />
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {% if review.video %}
    <div class="mt-3">
      {% if review.video.type == 'youtube' %}
        <div class="aspect-video max-w-md rounded-xl overflow-hidden bg-black">
          <iframe src="{{ review.video.embed }}" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
      {% else %}
        <video class="max-w-md w-full rounded-xl bg-black" controls preload="metadata">
          <source src="{{ review.video.src }}" type="video/mp4">
        </video>
      {% endif %}
    </div>
  {% endif %}
</article>
