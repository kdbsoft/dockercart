<div class="mb-4">
  <div class="flex items-center gap-2 text-sm">
    <span class="text-gray-400">{{ text_sort }}</span>
    {% for option in sort_urls %}
      <a href="{{ option.href }}" class="px-3 py-1 rounded-full border text-xs font-medium transition {% if option.active %}border-blue-300 text-blue-600 bg-blue-50{% else %}border-gray-200 text-gray-500 hover:border-blue-300 hover:text-blue-600{% endif %}">{{ option.label }}</a>
    {% endfor %}
  </div>
</div>

{% if reviews %}
  {% for review in reviews %}
    {% include 'dockercart/template/product/review_card.twig' with { review: review } %}
  {% endfor %}

  <div class="flex flex-wrap items-center justify-between gap-3 mt-2">
    <div class="text-xs text-gray-400">{{ text_pagination }}</div>
    {% if pagination %}<div class="pagination-wrap">{{ pagination }}</div>{% endif %}
  </div>
{% else %}
  <p class="text-sm text-gray-500 py-4">{{ text_no_reviews }}</p>
{% endif %}
