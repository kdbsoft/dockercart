{% if total is defined and total > 0 %}
<div class="flex flex-wrap items-center justify-between gap-3 mb-5">
  <span class="text-base font-extrabold tracking-tight text-gray-900">{{ total_label|default(total ~ ' ' ~ text_reviews_word|default('reviews')) }}</span>
  {% if total > 1 %}
  <nav class="dc-review-sort" aria-label="{{ text_sort }}">
    {% for option in sort_urls %}
      <a href="{{ option.href }}" class="{% if option.active %}active{% endif %}">{{ option.label }}</a>
    {% endfor %}
  </nav>
  {% endif %}
</div>
{% endif %}

{% if reviews %}
  {% for review in reviews %}
    {% include 'dockercart/template/product/review_card.twig' with { review: review, vote_url: vote_url|default('') } %}
  {% endfor %}

  {% if has_more|default(false) %}
  <div class="dc-review-show-more-wrap mt-6">
    <button type="button" id="dc-review-show-more" data-next-page="{{ next_page|default(2) }}" data-sort="{{ sort|default('newest') }}" data-ajax-url="{{ review_ajax_url|default('') }}"
      class="dc-review-show-more-btn">
      <i data-lucide="chevron-down" width="16" height="16"></i>{{ show_more_label|default(text_show_more) }}
    </button>
  </div>
  {% endif %}
{% else %}
  <div class="text-center py-12 px-6">
    <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-50 text-amber-500 ring-1 ring-amber-100">
      <i data-lucide="star" width="28" height="28" aria-hidden="true"></i>
    </div>
    <p class="text-lg font-extrabold tracking-tight text-gray-900">{{ text_be_first|default(text_no_reviews) }}</p>
    {% if text_be_first_hint is defined and text_be_first_hint %}
    <p class="mt-2 text-sm text-gray-500">{{ text_be_first_hint }}</p>
    {% endif %}
    <button type="button" data-review-modal-open class="mt-7 inline-flex items-center gap-2 px-5 py-3 border border-blue-600 text-blue-600 text-sm font-bold rounded-xl hover:bg-blue-50 transition">
      <i data-lucide="message-square-plus" width="16" height="16"></i>{{ text_leave_review|default(text_write) }}
    </button>
  </div>
{% endif %}
