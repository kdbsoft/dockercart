# DockerCart Docker Environment Configuration
# Copy to .env and customize as needed

# Database Configuration
DB_HOSTNAME=mariadb
DB_USERNAME=dockercart
DB_PASSWORD=dockercart_password
DB_DATABASE=dockercart
DB_PORT=3306
DB_PREFIX=oc_

# MariaDB Root Password (for initial setup)
MARIADB_ROOT_PASSWORD=root_password

# MariaDB Database Settings
# NOTE: keep .env flat — no nested ${VAR} references. docker compose expands
# them recursively, but podman-compose does not, which breaks the mariadb
# healthcheck (empty user => unhealthy => startup hangs on service_healthy).
# If you change DB_USERNAME/DB_DATABASE/DB_PASSWORD, mirror the value here.
MARIADB_DATABASE=dockercart
MARIADB_USER=dockercart
MARIADB_PASSWORD=dockercart_password
# Optional: expose MariaDB to host on this port. Leave unset to keep DB isolated.
# MARIADB_EXTERNAL_PORT=3306

# MariaDB config size: s (4GB RAM), m (8GB RAM), l (12GB RAM)
MARIADB_CONFIG_SIZE=s

# Container Names
# These now default from COMPOSE_PROJECT_NAME (see below); set them only to
# override a specific container name for this instance.
# NGINX_CONTAINER_NAME=dockercart_nginx
# APACHE_CONTAINER_NAME=dockercart_apache
# MARIADB_CONTAINER_NAME=dockercart_mariadb
# MANTICORE_CONTAINER_NAME=dockercart_manticore
# REDIS_CONTAINER_NAME=dockercart_redis
# FTP_CONTAINER_NAME=dockercart_ftp
# CERTBOT_CONTAINER_NAME=dockercart_certbot
# SCHEDULER_CONTAINER_NAME=dockercart_scheduler

# Project name (Compose) — namespaces container names, network and volumes.
# Defaults to the directory basename ("dockercart" for this checkout). A clone
# in a differently-named folder gets isolated names automatically; the setup
# wizard writes this for you. Change only to run multiple instances on one host.
COMPOSE_PROJECT_NAME=dockercart

# Cache Configuration
CACHE_ENGINE=redis
# Sessions: file (default) keeps sessions in ./storage/session (persistent
# bind mount). Redis is cache-only and loses all data on restart — do not put
# sessions there on a live store.
SESSION_ENGINE=file
CACHE_PREFIX=oc_
# Redis
REDIS_HOSTNAME=redis
REDIS_PORT=6379
# Leave empty to let the setup wizard generate a random password; the container
# falls back to REDIS_PASSWORD=dockercart_redis_pass when unset.
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# Traefik Router Name — must be unique per instance when sharing one Traefik.
# Defaults to COMPOSE_PROJECT_NAME (set above). Override only to share a project
# name but split routers. Leave commented to use the project-derived default.
# DOCKERCART_ROUTER_NAME=dockercart

# Network name — must be unique per instance. Defaults to
# ${COMPOSE_PROJECT_NAME}-network (e.g. dc2-network for a clone named "dc2").
# Leave commented so the project-derived default applies for new clones; a set
# value here would collide with another instance's network.
# DOCKERCART_NETWORK=dockercart-network

# Restart Policy
RESTART_POLICY=unless-stopped

# Application Configuration
# DOCKERCART_URL / DOCKERCART_HTTPS_URL are DERIVED from DOCKERCART_DOMAIN +
# DOCKERCART_HTTP_PORT / DOCKERCART_HTTPS_PORT by start.sh on every run.
# Port 80/443 are omitted from the URL. You normally do NOT need to edit these —
# set the domain and ports below instead.
DOCKERCART_URL=http://dockercart.local
# HTTPS counterpart; uses https:// plus DOCKERCART_HTTPS_PORT (443 omitted).
DOCKERCART_HTTPS_URL=https://dockercart.local
DOCKERCART_SSL_ENABLED=false
DOCKERCART_DOMAIN=dockercart.local
# Disallow search engine indexing of the entire store (YES to block all crawlers)
DISALLOW_INDEXING=NO
# Secret key for custom XML orders export endpoint:
# /index.php?route=extension/module/dockercart_custom_orders_xml&secret=...
DOCKERCART_CUSTOM_ORDERS_XML_SECRET=secret_key_here

# Default admin account (used on first database initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=type_password_here
ADMIN_EMAIL=admin@example.com

# Seed mode on first install (when no database volume exists yet):
#   demo  - install with demo catalogue content (default)
#   clean - install an empty store (no demo products/categories/blog/orders)
# If unset, defaults to "demo". Edit here for a clean store.
DOCKERCART_SEED_MODE=demo

# Standalone HTTP listen port (host side; docker-compose.yml maps this to :80).
# Set to e.g. 8080 when 80 is unavailable, or when only a non-privileged port is
# allowed. start.sh appends it to DOCKERCART_URL automatically (80 = default,
# omitted from the URL), keeping all internal links consistent.
DOCKERCART_HTTP_PORT=80
# Standalone HTTPS listen port (docker-compose.ssl.yml / docker-compose.le.yml)
DOCKERCART_HTTPS_PORT=443
TZ=UTC
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=100M
PHP_MAX_EXECUTION_TIME=300

# Built-in scheduler for periodic tasks
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=60
SCHEDULER_MEM_LIMIT=512M
SCHEDULER_CPUS=1.0
SCHEDULER_WORKER_TIMEOUT=3600

# Token for healthcheck.php access via X-Healthcheck-Token header (empty = disabled)
HEALTHCHECK_TOKEN=

# ============================================================================
# Backup to S3 (optional, off by default)
# ============================================================================
# When enabled, the backup worker dumps the database (mariadb-dump) and tars
# ./upload/image + ./storage/download + ./storage/modification into a single
# .tar.gz, uploads it to S3 via rclone, then deletes local staging files.
# Old S3 objects older than BACKUP_S3_RETENTION_DAYS are deleted automatically.
#
# Runs as a one-shot container triggered by host cron (NOT the scheduler
# daemon — keeps heavy dump/tar/upload work isolated from business workers):
#   sudo ./install-backup-cron.sh     # writes /etc/cron.d/dockercart-backup
#   make backup-s3                    # manual one-shot run
# Credentials stay here in .env (never written to the database).
BACKUP_S3_ENABLED=false
# Cron schedule (5-field) used by install-backup-cron.sh
BACKUP_S3_SCHEDULE="0 2 * * *"
# System user the cron job runs as (must have docker access)
BACKUP_S3_CRON_USER=root
# rclone S3 provider: AWS, Ceph, Minio, Cloudflare, Other, etc.
# (see https://rclone.org/s3/#standard-options)
BACKUP_S3_PROVIDER=
# For S3-compatible storage: https://s3.example.com (leave empty for AWS)
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Object key prefix inside the bucket
BACKUP_S3_PATH=dockercart/backups
# Delete S3 objects older than N days (retention policy)
BACKUP_S3_RETENTION_DAYS=7
# Set true only for self-signed / internal CAs (skips TLS verification)
BACKUP_S3_INSECURE=false

# Image optimisation: uploaded images with a longer side > this value (px) will be
# proportionally resized and recompressed.  In-addition, JPEG/PNG/WebP files will
# always be re-saved with optimised encoder settings (JPEG 95, PNG level 9, WebP 95).
# Set 0 to disable completely.  Can be overridden in admin Settings → Image tab.
IMAGE_MAX_DIMENSION=2560

# Optional FTP server (profile: ftp). Access is limited to ./upload/image.
# WARNING: FTP is plaintext — only enable on trusted networks or via VPN.
# Leave FTP_PASS empty to let the first-run setup generate a random password.
FTP_PORT=21
FTP_USER=images
FTP_PASS=
# FTP root will be /home/vsftpd/${FTP_USER} -> host ./upload/image
# Extended privileges inside /upload/image (write/delete/rename)
FTP_WRITE_ENABLE=YES
FTP_ALLOW_WRITEABLE_CHROOT=YES
FTP_LOCAL_UMASK=000
FTP_FILE_OPEN_MODE=0777
# IMPORTANT: must be reachable by FTP client (public IP or domain), never 127.0.0.1
FTP_PASV_ADDRESS=dockercart.docker.localhost
FTP_PASV_ADDR_RESOLVE=YES
FTP_PASV_MIN_PORT=21100
FTP_PASV_MAX_PORT=21110

# ============================================================================
# SSL / Let's Encrypt (optional, for production)
# ============================================================================
# Used by standalone LE mode and Traefik LE mode.
# Standalone LE requires inbound ports 80 and 443 and a real public DNS record.
SSL_DOMAIN=example.com
SSL_EMAIL=admin@example.com

# Persist Let's Encrypt ACME account/certificate state between rebuilds/deploys.
# For CI or ephemeral deploys, point these to a stable host path outside the repo.
LETSENCRYPT_DATA_DIR=./docker/letsencrypt
LETSENCRYPT_WEBROOT_DIR=./docker/letsencrypt/www

# Standalone certbot renewal check cadence (renews only when certificate is due).
CERTBOT_RENEW_INTERVAL=24h
